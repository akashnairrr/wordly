{"id":"vojti","lemma":"войти","pos":"verb","rank":746,"glosses":["to enter, to go in(to) (by foot), to get in(to)","to penetrate into","to be included in"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/31/Ru-%D0%B2%D0%BE%D0%B9%D1%82%D0%B8.ogg/Ru-%D0%B2%D0%BE%D0%B9%D1%82%D0%B8.ogg.mp3","conjugation":{"indicative":{"future":{"1s":"войду","2s":"войдёшь","3s":"войдёт","1p":"войдём","2p":"войдёте","3p":"войдут"}},"imperative":{"affirmative":{"2s":"войди","2p":"войдите"}}},"past":{"m":"вошёл","p":"вошли","f":"вошла","n":"вошло"},"aspect":"perfective","aspectPartner":"входить","examples":[{"text":"Могу я войти туда сейчас?","en":"Can I go in there now?","words":[{"g":"can, be able to","l":"мочь"},{"g":"I"},null,{"g":"there"},{"g":"now"}]},{"text":"Как они сюда вошли?","en":"How did they get in here?","audio":"https://tatoeba.org/en/audio/download/1283341","words":[{"g":"how / like"},{"g":"they"},{"g":"here, hither"},null]},{"text":"Когда ты вошла?","en":"When did you come in?","words":[{"g":"when"},{"g":"you"},null]},{"text":"Я был здесь, когда ты вошёл.","en":"I was here when you came in.","words":[{"g":"I"},{"g":"was","l":"быть"},{"g":"here"},{"g":"when"},{"g":"you"},null]},{"text":"Теперь ты можешь войти.","en":"You can come in now.","words":[{"g":"now, at present"},{"g":"you"},{"g":"can, be able to","l":"мочь"},null]}]}