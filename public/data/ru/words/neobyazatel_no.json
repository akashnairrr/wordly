{"id":"neobyazatel_no","lemma":"необязательно","pos":"adv","rank":2032,"glosses":["optionally","unnecessarily","unobligingly"],"examples":[{"text":"Тебе необязательно делать это сейчас.","en":"You don't have to do it now.","words":[{"g":"(to) you","l":"ты"},null,{"g":"to make, to do"},{"g":"this / it is"},{"g":"now"}]},{"text":"Вам необязательно это для меня делать.","en":"You don't have to do this for me.","words":[{"g":"(to) you","l":"вы"},null,{"g":"this / it is"},{"g":"for"},{"g":"me","l":"я"},{"g":"to make, to do"}]},{"text":"Вам необязательно ждать до конца.","en":"You don't have to wait until the end.","words":[{"g":"(to) you","l":"вы"},null,{"g":"to wait for"},{"g":"until / before"},{"g":"end","l":"конец"}]},{"text":"Тебе необязательно туда идти.","en":"You don't have to go there.","words":[{"g":"(to) you","l":"ты"},null,{"g":"there"},{"g":"to go"}]},{"text":"Необязательно говорить об этом здесь.","en":"We don't have to talk about this here.","words":[null,{"g":"to speak, to talk"},{"g":"about"},null,{"g":"here"}]}]}