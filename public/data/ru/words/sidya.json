{"id":"sidya","lemma":"сидя","pos":"adv","rank":2893,"glosses":["sitting"],"examples":[{"text":"Мы спали сидя.","en":"We slept sitting up.","words":[{"g":"we"},{"g":"to sleep","l":"спать"},null]},{"text":"Том спит сидя на стуле.","en":"Tom is asleep in his chair.","words":[{"g":"that one, those ones","l":"тот"},{"g":"to sleep","l":"спать"},null,{"g":"on / at"},{"g":"chair, seat","l":"стул"}]},{"text":"Том дремал, сидя на солнце на своей веранде.","en":"Tom dozed off sitting in the sun on his front porch.","words":[{"g":"that one, those ones","l":"тот"},null,null,{"g":"on / at"},{"g":"sun"},{"g":"on / at"},{"g":"one's own","l":"свой"},null]},{"text":"Том обедал, сидя за столом на кухне.","en":"Tom sat at the kitchen table eating dinner.","words":[{"g":"that one, those ones","l":"тот"},{"g":"to eat lunch","l":"обедать"},null,{"g":"behind / for"},{"g":"table","l":"стол"},{"g":"on / at"},null]},{"text":"Том уснул сидя на стуле.","en":"Tom fell asleep sitting up in the chair.","words":[{"g":"that one, those ones","l":"тот"},{"g":"to fall asleep","l":"уснуть"},null,{"g":"on / at"},{"g":"chair, seat","l":"стул"}]}]}