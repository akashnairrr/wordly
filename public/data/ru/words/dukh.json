{"id":"dukh","lemma":"дух","pos":"noun","rank":959,"glosses":["spirit","mind","courage"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/08/Ru-%D0%B4%D1%83%D1%85.ogg/Ru-%D0%B4%D1%83%D1%85.ogg.mp3","gender":"m","forms":{"genitive":"духа","plural":"духи"},"examples":[{"text":"Я люблю \"пищу духа\".","en":"I love soul food.","words":[{"g":"I"},{"g":"to love","l":"любить"},null,null]},{"text":"Это дух захватывает.","en":"It's breathtaking.","words":[{"g":"this / it is"},null,null]},{"text":"Где твой дух искателя приключений?","en":"Where's your spirit of adventure?","words":[{"g":"where"},{"g":"your"},null,null,null]},{"text":"Он был в прекрасном расположении духа.","en":"He was in good spirits.","words":[{"g":"he / it"},{"g":"was","l":"быть"},{"g":"in"},null,null,null]},{"text":"Они нас на дух не переносят.","en":"They hate our guts.","words":[{"g":"they"},{"g":"us","l":"мы"},{"g":"on / at"},null,{"g":"not"},null]}]}