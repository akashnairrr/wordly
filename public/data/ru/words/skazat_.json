{"id":"skazat_","lemma":"сказать","pos":"verb","rank":91,"glosses":["to say, to tell"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d1/Ru-%D1%81%D0%BA%D0%B0%D0%B7%D0%B0%D1%82%D1%8C.ogg/Ru-%D1%81%D0%BA%D0%B0%D0%B7%D0%B0%D1%82%D1%8C.ogg.mp3","conjugation":{"indicative":{"future":{"1s":"скажу","2s":"скажешь","3s":"скажет","1p":"скажем","2p":"скажете","3p":"скажут"}},"imperative":{"affirmative":{"2s":"скажи","2p":"скажите"}}},"past":{"m":"сказал","p":"сказали","f":"сказала","n":"сказало"},"aspect":"perfective","aspectPartner":"говорить","examples":[{"text":"Кто это сказал?","en":"Who said it?","audio":"https://tatoeba.org/en/audio/download/679197","words":[{"g":"who"},{"g":"this / it is"},null]},{"text":"Что ты можешь сказать?","en":"What can you say?","words":[{"g":"what / that"},{"g":"you"},{"g":"can, be able to","l":"мочь"},null]},{"text":"Просто скажи мне, что это.","en":"Just tell me what it is.","audio":"https://tatoeba.org/en/audio/download/1283268","words":[{"g":"simply, plainly, just"},null,{"g":"(to) me","l":"я"},null,null],"phrases":[[3,5,"why"]]},{"text":"Она сказала это?","en":"Did she say it?","words":[{"g":"she / it"},null,{"g":"this / it is"}]},{"text":"Я сказал им об этом вчера.","en":"I told them about that yesterday.","audio":"https://tatoeba.org/en/audio/download/1283170","words":[{"g":"I"},null,{"g":"(to) them","l":"он"},{"g":"about"},null,{"g":"yesterday"}]}]}