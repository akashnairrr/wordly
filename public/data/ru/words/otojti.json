{"id":"otojti","lemma":"отойти","pos":"verb","rank":2414,"glosses":["to go away, to go aside, to move away, to move aside","to withdraw, to fall back","to be out for a while, to go away temporarily (with the intention to come back soon)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3a/Ru-%D0%BE%D1%82%D0%BE%D0%B9%D1%82%D0%B8.ogg/Ru-%D0%BE%D1%82%D0%BE%D0%B9%D1%82%D0%B8.ogg.mp3","conjugation":{"indicative":{"future":{"1s":"отойду","2s":"отойдёшь","3s":"отойдёт","1p":"отойдём","2p":"отойдёте","3p":"отойдут"}},"imperative":{"affirmative":{"2s":"отойди","2p":"отойдите"}}},"past":{"m":"отошёл","p":"отошли","f":"отошла","n":"отошло"},"aspect":"perfective","aspectPartner":"отходить","examples":[{"text":"Отойди от машины.","en":"Step away from the car.","words":[null,{"g":"from"},{"g":"car, motor vehicle","l":"машина"}]},{"text":"Отойдите от двери, пожалуйста.","en":"Please move away from the door.","words":[null,{"g":"from"},{"g":"door","l":"дверь"},{"g":"please"}]},{"text":"Тебе лучше отойти.","en":"You'd better back off.","words":[{"g":"(to) you","l":"ты"},{"g":"rather, would better )"},null]},{"text":"Отойди назад, пожалуйста.","en":"Please move back.","words":[null,{"g":"back"},{"g":"please"}]},{"text":"Простите, я отойду на минутку?","en":"May I please be excused for a minute?","words":[{"g":"to excuse","l":"простить"},{"g":"I"},null,{"g":"on / at"},null]}]}