{"id":"vrasplokh","lemma":"врасплох","pos":"adv","rank":3124,"glosses":["unawares, unexpectedly, by surprise"],"examples":[{"text":"Я поймал его врасплох.","en":"I caught him by surprise.","words":[{"g":"I"},{"g":"to catch, to take","l":"поймать"},{"g":"him / his"},null]},{"text":"Я застал тебя врасплох?","en":"Did I surprise you?","words":[{"g":"I"},null,{"g":"you","l":"ты"},null]},{"text":"Его смерть застала всех нас врасплох.","en":"His death surprised us all.","words":[{"g":"him / his"},{"g":"death"},null,{"g":"all","l":"весь"},{"g":"us","l":"мы"},null]},{"text":"Твой вопрос застал меня врасплох.","en":"Your question caught me off guard.","words":[{"g":"your"},{"g":"question"},null,{"g":"me","l":"я"},null]},{"text":"Я был застигнут врасплох.","en":"I was caught off guard.","words":[{"g":"I"},{"g":"was","l":"быть"},null,null]}]}