{"id":"sprava","lemma":"справа","pos":"adv","rank":1549,"glosses":["on the right, to the right","from the right"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/75/Ru-%D1%81%D0%BF%D1%80%D0%B0%D0%B2%D0%B0.ogg/Ru-%D1%81%D0%BF%D1%80%D0%B0%D0%B2%D0%B0.ogg.mp3","examples":[{"text":"Мой дом - третий дом справа.","en":"My house is the third house on the right.","words":[{"g":"my"},{"g":"house, building"},{"g":"third"},{"g":"house, building"},null]},{"text":"Я справа.","en":"I am on the right.","words":[{"g":"I"},null]},{"text":"Туалет справа.","en":"The toilet is on the right.","words":[{"g":"toilet"},null]},{"text":"Ненормально иметь сердце справа.","en":"It is abnormal to have the heart on the right side.","words":[{"g":"abnormally"},{"g":"to have, to possess"},{"g":"heart"},null]},{"text":"Том справа от меня.","en":"Tom is on my right.","words":[{"g":"that one, those ones","l":"тот"},null,{"g":"from"},{"g":"me","l":"я"}]}]}