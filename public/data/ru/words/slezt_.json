{"id":"slezt_","lemma":"слезть","pos":"verb","rank":3183,"glosses":["to come down, to get down (from), to dismount (from)","to come down","(from a train, bus etc) to get out (of), to get off"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/81/Ru-%D1%81%D0%BB%D0%B5%D0%B7%D1%82%D1%8C.ogg/Ru-%D1%81%D0%BB%D0%B5%D0%B7%D1%82%D1%8C.ogg.mp3","conjugation":{"indicative":{"future":{"1s":"слезу","2s":"слезешь","3s":"слезет","1p":"слезем","2p":"слезете","3p":"слезут"}},"imperative":{"affirmative":{"2s":"слезь","2p":"слезьте"}}},"past":{"m":"слез","p":"слезли","f":"слезла","n":"слезло"},"examples":[{"text":"Он слез с дерева.","en":"He climbed down from the tree.","words":[{"g":"he / it"},null,{"g":"with / from"},{"g":"tree","l":"дерево"}]},{"text":"Она слезла с крыши.","en":"She climbed down from the roof.","words":[{"g":"she / it"},null,{"g":"with / from"},{"g":"roof","l":"крыша"}]},{"text":"Том слез.","en":"Tom climbed down.","words":[{"g":"that one, those ones","l":"тот"},null]},{"text":"Эй, слезь с моего велосипеда.","en":"Hey, get off my bike.","words":[{"g":"hey!"},null,{"g":"with / from"},{"g":"my, mine","l":"мой"},{"g":"bicycle, bike","l":"велосипед"}]},{"text":"Том не может слезть с дерева.","en":"Tom can't climb down from the tree.","words":[{"g":"that one, those ones","l":"тот"},{"g":"not"},{"g":"can, be able to","l":"мочь"},null,{"g":"with / from"},{"g":"tree","l":"дерево"}]}]}