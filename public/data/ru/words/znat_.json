{"id":"znat_","lemma":"знать","pos":"verb","rank":40,"glosses":["to know: to be familiar with or accustomed to a person, place, or thing","to know: to be in possession of a specific fact or datum"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9e/Ru-%D0%B7%D0%BD%D0%B0%D1%82%D1%8C.ogg/Ru-%D0%B7%D0%BD%D0%B0%D1%82%D1%8C.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"знаю","2s":"знаешь","3s":"знает","1p":"знаем","2p":"знаете","3p":"знают"},"future":{"1s":"буду знать","2s":"будешь знать","3s":"будет знать","1p":"будем знать","2p":"будете знать","3p":"будут знать"}},"imperative":{"affirmative":{"2s":"знай","2p":"знайте"}}},"past":{"m":"знал","p":"знали","f":"знала","n":"знало"},"examples":[{"text":"Я его знаю?","en":"Do I know him?","audio":"https://tatoeba.org/en/audio/download/42059","words":[{"g":"I"},{"g":"him / his"},null]},{"text":"Вы знаете его отца?","en":"Do you know his father?","audio":"https://tatoeba.org/en/audio/download/1283400","words":[{"g":"you (pl. / formal)"},null,{"g":"him / his"},{"g":"father","l":"отец"}]},{"text":"Знаешь, почему я этого не сделал?","en":"Do you know why I didn't do that?","audio":"https://tatoeba.org/en/audio/download/1267662","words":[null,{"g":"why"},{"g":"I"},null,{"g":"not"},{"g":"to make, to do","l":"сделать"}]},{"text":"Я знаю, что я думаю.","en":"I know what I think.","audio":"https://tatoeba.org/en/audio/download/1274760","words":[{"g":"I"},null,{"g":"what / that"},{"g":"I"},{"g":"to think","l":"думать"}]},{"text":"Мы знаем твоего брата.","en":"We know your brother.","audio":"https://tatoeba.org/en/audio/download/1278988","words":[{"g":"we"},null,{"g":"your","l":"твой"},{"g":"brother","l":"брат"}]}]}