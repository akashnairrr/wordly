{"id":"doekhat_","lemma":"доехать","pos":"verb","rank":4991,"glosses":["to reach, to arrive (by horse or vehicle)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5b/Ru-%D0%B4%D0%BE%D0%B5%D1%85%D0%B0%D1%82%D1%8C.ogg/Ru-%D0%B4%D0%BE%D0%B5%D1%85%D0%B0%D1%82%D1%8C.ogg.mp3","conjugation":{"indicative":{"future":{"1s":"доеду","2s":"доедешь","3s":"доедет","1p":"доедем","2p":"доедете","3p":"доедут"}},"imperative":{"affirmative":{"2s":"доезжай","2p":"доезжайте"}}},"past":{"m":"доехал","p":"доехали","f":"доехала","n":"доехало"},"aspect":"perfective","aspectPartner":"доезжать","examples":[{"text":"Том знает, как туда доехать?","en":"Does Tom know how to get there?","words":[{"g":"that one, those ones","l":"тот"},{"g":"to know: to be familiar…","l":"знать"},{"g":"how / like"},{"g":"there"},null]},{"text":"Мы почти доехали.","en":"We're almost there.","words":[{"g":"we"},{"g":"almost, nearly"},null]},{"text":"Когда мы доедем?","en":"When will we get there?","words":[{"g":"when"},{"g":"we"},null]},{"text":"Я ещё не доехал.","en":"I'm not there yet.","words":[{"g":"I"},null,null,null],"phrases":[[1,3,"not yet"]]},{"text":"Я позвоню тебе, когда доеду.","en":"I'll call you when I get there.","words":[{"g":"I"},{"g":"to call","l":"позвонить"},{"g":"(to) you","l":"ты"},{"g":"when"},null]}]}