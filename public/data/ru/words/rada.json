{"id":"rada","lemma":"рада","pos":"noun","rank":340,"glosses":["rada, Rada (a parliamentary body in a number of Slavic countries)"],"gender":"f","forms":{"genitive":"рады","plural":"рады"},"examples":[{"text":"Мы рады помочь.","en":"We're glad to help.","words":[{"g":"we"},null,{"g":"to help"}]},{"text":"Ты, похоже, не рада.","en":"You don't seem happy.","audio":"https://tatoeba.org/en/audio/download/1283359","words":[{"g":"you"},{"g":"it seems"},{"g":"not"},null]},{"text":"Мы рады видеть тебя.","en":"We're glad to see you.","words":[{"g":"we"},null,{"g":"to see"},{"g":"you","l":"ты"}]},{"text":"Я была рада его видеть.","en":"I was happy to see him.","words":[{"g":"I"},{"g":"was","l":"быть"},null,{"g":"him / his"},{"g":"to see"}]},{"text":"Они будут очень рады.","en":"They will be very glad.","words":[{"g":"they"},{"g":"to be","l":"быть"},{"g":"very"},null]}]}