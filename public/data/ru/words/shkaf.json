{"id":"shkaf","lemma":"шкаф","pos":"noun","rank":1899,"glosses":["cupboard","wardrobe, closet","locker, cabinet"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e1/Ru-%D1%88%D0%BA%D0%B0%D1%84.ogg/Ru-%D1%88%D0%BA%D0%B0%D1%84.ogg.mp3","gender":"m","forms":{"genitive":"шкафа","plural":"шкафы"},"examples":[{"text":"В твоей комнате есть шкаф?","en":"Does your room have a closet?","words":[{"g":"in"},{"g":"your","l":"твой"},null,{"g":"there is / to eat"},null]},{"text":"Положи её в шкаф.","en":"Put it in the closet.","words":[{"g":"to put","l":"положить"},{"g":"her"},{"g":"in"},null]},{"text":"Мне нужен новый шкаф.","en":"I need a new wardrobe.","words":[{"g":"(to) me","l":"я"},null,{"g":"new"},null]},{"text":"У меня в спальне нет шкафа.","en":"I don't have a closet in my bedroom.","words":[{"g":"at / by"},{"g":"me","l":"я"},{"g":"in"},null,{"g":"no / there isn't"},null]},{"text":"Убери его в шкаф.","en":"Put it in the cupboard.","words":[{"g":"to remove","l":"убрать"},{"g":"him / his"},{"g":"in"},null]}]}