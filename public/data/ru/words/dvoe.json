{"id":"dvoe","lemma":"двое","pos":"num","rank":379,"glosses":["two (in a group together), two of them"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1c/Ru-%D0%B4%D0%B2%D0%BE%D0%B5.ogg/Ru-%D0%B4%D0%B2%D0%BE%D0%B5.ogg.mp3","examples":[{"text":"Вы двое друзья?","en":"Are you two friends?","words":[{"g":"you (pl. / formal)"},null,{"g":"close friend","l":"друг"}]},{"text":"Где те двое?","en":"Where are those two?","words":[{"g":"where"},{"g":"that one, those ones","l":"тот"},null]},{"text":"О чём вы двое говорили?","en":"What did you two talk about?","words":[{"g":"about"},{"g":"what","l":"что"},{"g":"you (pl. / formal)"},null,{"g":"to speak, to talk","l":"говорить"}]},{"text":"Вы двое — хорошая пара.","en":"You two make a nice couple.","words":[{"g":"you (pl. / formal)"},null,{"g":"good, nice, fine","l":"хороший"},{"g":"pair, couple"}]},{"text":"Думаю, вы двое знакомы.","en":"I think you two know each other.","words":[{"g":"to think","l":"думать"},{"g":"you (pl. / formal)"},null,null]}]}