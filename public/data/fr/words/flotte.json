{"id":"flotte","lemma":"flotte","pos":"noun","rank":2169,"glosses":["water","rain"],"ipa":"/flɔt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/83/Fr-flotte.ogg/Fr-flotte.ogg.mp3","gender":"f","forms":{"plural":"flottes"},"formAudio":{"flottes":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q150_%28fra%29-Poslovitch-flottes.wav"},"examples":[{"text":"Une pierre ne flotte pas.","en":"A stone does not float.","words":[{"g":"a"},{"g":"stone"},{"g":"not"},null,{"g":"not"}]},{"text":"Pourquoi la glace flotte ?","en":"Why does ice float?","words":[{"g":"why"},{"g":"the / her"},{"g":"ice"},null]},{"text":"Le bois flotte, mais le fer coule.","en":"Wood floats, but iron sinks.","words":[{"g":"the / it"},{"g":"wood"},null,{"g":"but"},{"g":"the / it"},{"g":"iron"},{"g":"to sink","l":"couler"}]},{"text":"La compagnie aérienne a immobilisé sa flotte.","en":"The airline has grounded its fleet.","words":[{"g":"the / her"},null,null,{"g":"has","l":"avoir"},{"g":"to immobilize","l":"immobiliser"},{"g":"his"},null],"phrases":[[1,3,"airline"]]},{"text":"Ne savais-tu pas que le pétrole flotte sur l'eau ?","en":"Didn't you know oil floats on water?","words":[{"g":"not"},{"g":"to know","l":"savoir"},{"g":"you"},null,null,{"g":"the / it"},{"g":"petroleum"},null,{"g":"on"},{"g":"the / it"},{"g":"water"}],"phrases":[[3,5,"not that"]]}]}