{"id":"silencieux","lemma":"silencieux","pos":"adj","rank":2759,"glosses":["silent (without sound)","quiet (not speaking)","quiet (with little sound)"],"ipa":"/si.lɑ̃.sjø/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4c/Fr-silencieux.ogg/Fr-silencieux.ogg.mp3","forms":{"feminine":"silencieuse","masculinePlural":"silencieux","femininePlural":"silencieuses"},"formAudio":{"silencieuse":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q150_%28fra%29-Sagnamadr-silencieuse.wav"},"examples":[{"text":"Pourrais-tu être silencieux ?","en":"Could you please be quiet?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to be"},null]},{"text":"Pourquoi est-elle si silencieuse ?","en":"Why is she so silent?","words":[{"g":"why"},{"g":"is","l":"être"},{"g":"she / it"},{"g":"if, whether"},null]},{"text":"Tout était silencieux dans la maison.","en":"All was silent in the house.","words":[{"g":"all"},{"g":"to be","l":"être"},null,{"g":"in"},{"g":"the / her"},{"g":"house, home"}]},{"text":"Je veux que vous soyez silencieuses.","en":"I want you to be quiet.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"that / what"},{"g":"you"},{"g":"to be","l":"être"},null]},{"text":"La maison est très silencieuse.","en":"The house is very quiet.","words":[{"g":"the / her"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"very"},null]}]}