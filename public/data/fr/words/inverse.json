{"id":"inverse","lemma":"inverse","pos":"adj","rank":3135,"glosses":["inverse, the other way round"],"ipa":"/ɛ̃.vɛʁs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/Fr-inverse.ogg/Fr-inverse.ogg.mp3","forms":{"plural":"inverses"},"examples":[{"text":"Nous avons le problème inverse.","en":"We have the opposite problem.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"the / it"},{"g":"problem"},null]},{"text":"L'inverse semble vrai.","en":"The reverse seems true.","words":[{"g":"the / it"},null,{"g":"to seem","l":"sembler"},{"g":"true"}]},{"text":"Il a fait l'inverse.","en":"He did the opposite.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to do","l":"faire"},{"g":"the / it"},null]},{"text":"N'est-ce pas l'inverse ?","en":"Isn't it the other way around?","words":[{"g":"not"},{"g":"is","l":"être"},{"g":"this / it"},{"g":"not"},{"g":"the / it"},null]},{"text":"Il a fait l'inverse de ce que j'ai demandé.","en":"He did the reverse of what I asked.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to do","l":"faire"},{"g":"the / it"},null,{"g":"of / from"},null,null,{"g":"I"},{"g":"have","l":"avoir"},{"g":"to ask","l":"demander"}],"phrases":[[6,8,"what"]]}]}