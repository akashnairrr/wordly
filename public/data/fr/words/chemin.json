{"id":"chemin","lemma":"chemin","pos":"noun","rank":443,"glosses":["path, way, road"],"ipa":"/ʃə.mɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/aa/Fr-chemin.ogg/Fr-chemin.ogg.mp3","gender":"m","forms":{"plural":"chemins"},"formAudio":{"chemins":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q150_%28fra%29-Lepticed7-chemins.wav"},"examples":[{"text":"Je connais le chemin.","en":"I know the way.","audio":"https://tatoeba.org/en/audio/download/1093650","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"the / it"},null]},{"text":"Tu es sur mon chemin.","en":"You are in my way.","audio":"https://tatoeba.org/en/audio/download/29735","words":[{"g":"you"},{"g":"are","l":"être"},{"g":"on"},{"g":"my"},null]},{"text":"Hors de mon chemin, gamin.","en":"Out of my way, boy.","audio":"https://tatoeba.org/en/audio/download/28632","words":[null,null,{"g":"my"},null,{"g":"kid"}],"phrases":[[0,2,"out of, outside"]]},{"text":"Connaissez-vous le chemin ?","en":"Do you know the way?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"the / it"},null]},{"text":"Peux-tu me montrer le chemin ?","en":"Can you show me the way?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"me"},{"g":"to show"},{"g":"the / it"},null]}]}