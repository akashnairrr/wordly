{"id":"de_sert","lemma":"désert","pos":"adj","rank":1625,"glosses":["deserted"],"ipa":"/de.zɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e5/Fr-d%C3%A9sert.ogg/Fr-d%C3%A9sert.ogg.mp3","forms":{"feminine":"déserte","masculinePlural":"déserts","femininePlural":"désertes"},"formAudio":{"déserte":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q150_%28fra%29-Pamputt-d%C3%A9serte.wav","déserts":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q150_%28fra%29-Pamputt-d%C3%A9serts.wav","désertes":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q150_%28fra%29-LightD31-d%C3%A9sertes.wav"},"examples":[{"text":"Je déteste le désert.","en":"I hate the desert.","audio":"https://tatoeba.org/en/audio/download/1097985","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"the / it"},null]},{"text":"La ville était déserte.","en":"The town was deserted.","words":[{"g":"the / her"},{"g":"town, city"},{"g":"to be","l":"être"},null]},{"text":"L'endroit est presque désert.","en":"The place is almost deserted.","words":[{"g":"the / it"},{"g":"place, spot"},{"g":"is","l":"être"},{"g":"almost"},null]},{"text":"Les pièces sont désertes.","en":"The rooms are deserted.","words":[{"g":"the / them","l":"le"},{"g":"room in a house, etc.","l":"pièce"},{"g":"to be","l":"être"},null]},{"text":"La plage est déserte.","en":"The beach is empty.","words":[{"g":"the / her"},{"g":"beach"},{"g":"is","l":"être"},null]}]}