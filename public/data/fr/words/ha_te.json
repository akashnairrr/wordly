{"id":"ha_te","lemma":"hâte","pos":"noun","rank":1324,"glosses":["haste; impatience"],"ipa":"/at/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fb/Fr-h%C3%A2te.ogg/Fr-h%C3%A2te.ogg.mp3","gender":"f","forms":{"plural":"hâtes"},"formAudio":{"hâtes":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-h%C3%A2tes.wav"},"examples":[{"text":"Il a hâte de vous parler.","en":"He's eager to speak to you.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"of / from"},{"g":"you"},{"g":"to speak, talk"}]},{"text":"J'ai hâte de faire ça.","en":"I'm eager to do that.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"of / from"},{"g":"to do"},{"g":"that"}]},{"text":"Il est parti à la hâte.","en":"He went away in a hurry.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"to go away","l":"partir"},null,null,null],"phrases":[[3,5,"a la"]]},{"text":"J'avais hâte de vous rencontrer.","en":"I've been looking forward to meeting you.","words":[{"g":"I"},{"g":"to have","l":"avoir"},null,{"g":"of / from"},{"g":"you"},{"g":"to meet"}]},{"text":"Elle a hâte de le revoir.","en":"She is looking forward to seeing him again.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"of / from"},{"g":"the / it"},{"g":"to see again"}]}]}