{"id":"sauf","lemma":"sauf","pos":"prep","rank":421,"glosses":["except, save","excluding, barring"],"ipa":"/sof/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/63/Fr-sauf.ogg/Fr-sauf.ogg.mp3","examples":[{"text":"Il est tout sauf mort.","en":"He is all but dead.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"all"},null,{"g":"dead"}]},{"text":"Tu es sauf.","en":"You're safe.","audio":"https://tatoeba.org/en/audio/download/474713","words":[{"g":"you"},{"g":"are","l":"être"},null]},{"text":"Vous êtes sauf.","en":"You're safe.","audio":"https://tatoeba.org/en/audio/download/474715","words":[{"g":"you"},{"g":"to be","l":"être"},null]},{"text":"Personne ne le sait, sauf moi.","en":"Nobody knows it but me.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"the / it"},{"g":"to know","l":"savoir"},null,{"g":"me"}]},{"text":"Mon anglais est tout sauf bon.","en":"My English is not good at all.","words":[{"g":"my"},{"g":"English"},{"g":"is","l":"être"},{"g":"all"},null,{"g":"good"}]}]}