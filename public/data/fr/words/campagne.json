{"id":"campagne","lemma":"campagne","pos":"noun","rank":1093,"glosses":["country (the country, rural area, as opposed to the town or city), countryside"],"ipa":"/kɑ̃.paɲ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/Fr-campagne.ogg/Fr-campagne.ogg.mp3","gender":"f","forms":{"plural":"campagnes"},"formAudio":{"campagnes":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q150_%28fra%29-Eihel-campagnes.wav"},"examples":[{"text":"Je veux voir la campagne.","en":"I want to see the countryside.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to see"},{"g":"the / her"},null]},{"text":"Aimes-tu vivre à la campagne ?","en":"Do you like to live in the country?","words":[{"g":"to love","l":"aimer"},{"g":"you"},{"g":"to live"},null,null,null],"phrases":[[3,5,"a la"]]},{"text":"Mes parents vivent à la campagne.","en":"My parents live in the country.","words":[{"g":"my"},{"g":"relative","l":"parent"},{"g":"to live","l":"vivre"},null,null,null],"phrases":[[3,5,"a la"]]},{"text":"Je suis un garçon de la campagne.","en":"I'm a country boy.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"a"},{"g":"boy"},null,null,null],"phrases":[[4,6,"of the"]]},{"text":"Il habite cette maison de campagne.","en":"He lives on his country estate.","words":[{"g":"he / it"},{"g":"to live in, to occupy","l":"habiter"},{"g":"it, this, that","l":"ce"},{"g":"house, home"},{"g":"of / from"},null]}]}