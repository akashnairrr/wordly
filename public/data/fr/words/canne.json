{"id":"canne","lemma":"canne","pos":"noun","rank":3922,"glosses":["peg; leg","rod; fishing rod"],"ipa":"/kan/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/51/Fr-canne.ogg/Fr-canne.ogg.mp3","gender":"f","forms":{"plural":"cannes"},"formAudio":{"cannes":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q150_%28fra%29-Poslovitch-cannes.wav"},"examples":[{"text":"Apporte-moi ma canne.","en":"Bring me my cane.","words":[{"g":"to bring","l":"apporter"},{"g":"me"},{"g":"my","l":"mon"},null]},{"text":"Il portait une canne.","en":"He carried a cane.","words":[{"g":"he / it"},{"g":"to carry","l":"porter"},{"g":"a"},null]},{"text":"Il s'appuie sur une canne.","en":"He's leaning on a cane.","words":[{"g":"he / it"},{"g":"oneself / if"},{"g":"to press, push","l":"appuyer"},{"g":"on"},{"g":"a"},null]},{"text":"Le vieil homme marchait avec une canne.","en":"The old man walked with a stick.","words":[{"g":"the / it"},null,{"g":"man"},{"g":"to walk","l":"marcher"},{"g":"with"},{"g":"a"},null]},{"text":"Mon grand-père ne peut pas marcher sans canne.","en":"My grandfather can't walk without a walking stick.","words":[{"g":"my"},{"g":"big"},{"g":"father"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"not"},{"g":"to walk"},{"g":"without"},null]}]}