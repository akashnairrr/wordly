{"id":"huit","lemma":"huit","pos":"num","rank":832,"glosses":["eight"],"ipa":"/ɥit/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/07/Fr-huit.ogg/Fr-huit.ogg.mp3","examples":[{"text":"Il a huit ans.","en":"He is eight.","audio":"https://tatoeba.org/en/audio/download/334180","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"year","l":"an"}]},{"text":"La pièce est à huit heures.","en":"The play is at eight o'clock.","words":[{"g":"the / her"},{"g":"room in a house, etc."},{"g":"is","l":"être"},{"g":"to / at"},null,{"g":"hour, time","l":"heure"}]},{"text":"Il est huit heures du matin.","en":"It's eight o'clock in the morning.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"hour, time","l":"heure"},{"g":"of the / some"},{"g":"morning"}]},{"text":"J'ai dix-huit ans.","en":"I'm eighteen.","audio":"https://tatoeba.org/en/audio/download/334179","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"ten"},null,{"g":"year","l":"an"}]},{"text":"Huit et deux font dix.","en":"Eight plus two is ten.","words":[null,{"g":"and"},{"g":"two"},{"g":"to do","l":"faire"},{"g":"ten"}]}]}