{"id":"librairie","lemma":"librairie","pos":"noun","rank":4661,"glosses":["bookshop, bookstore (shop that sells books)","tobacconist's (shop that sells books, newspapers, cigarettes, snacks and other various items)","library (collection of software routines)"],"ipa":"/li.bʁɛ.ʁi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/Fr-librairie.ogg/Fr-librairie.ogg.mp3","gender":"f","forms":{"plural":"librairies"},"formAudio":{"librairies":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q150_%28fra%29-0x010C-librairies.wav"},"examples":[{"text":"Je cherche une librairie.","en":"I'm looking for a book store.","words":[{"g":"I"},{"g":"to look for, to seek","l":"chercher"},{"g":"a"},null]},{"text":"La librairie est ouverte.","en":"The bookshop is open.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"open","l":"ouvert"}]},{"text":"La poste est près de la librairie.","en":"The post office is near the bookstore.","words":[{"g":"the / her"},{"g":"job, post"},{"g":"is","l":"être"},null,null,{"g":"the / her"},null],"phrases":[[3,5,"close to, near."]]},{"text":"Allons à pied à la librairie.","en":"Let's walk to the bookstore.","words":[{"g":"to go","l":"aller"},null,null,null,null,null],"phrases":[[1,3,"on foot"],[3,5,"a la"]]},{"text":"Il y a devant la faculté quelques librairies.","en":"In front of the university, there are some bookstores.","words":[null,null,null,{"g":"in front of"},{"g":"the / her"},{"g":"capacity"},{"g":"some","l":"quelque"},null],"phrases":[[0,3,"ago"]]}]}