{"id":"oui","lemma":"oui","pos":"adv","rank":40,"glosses":["yes"],"ipa":"/wi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/51/Fr-oui.ogg/Fr-oui.ogg.mp3","examples":[{"text":"Il me dit quand dire oui.","en":"He told me when to say yes.","audio":"https://tatoeba.org/en/audio/download/26382","words":[{"g":"he / it"},{"g":"me"},{"g":"to say, to tell","l":"dire"},{"g":"when"},{"g":"to say, to tell"},null]},{"text":"Oui, je le sais.","en":"Yes, I know it.","words":[null,{"g":"I"},{"g":"the / it"},{"g":"to know","l":"savoir"}]},{"text":"Oui, nous pouvons partir.","en":"Yes, we can go.","words":[null,{"g":"we / us"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to go away"}]},{"text":"As-tu dit oui ou non ?","en":"Did you say yes or no?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to say, to tell","l":"dire"},null,{"g":"or"},{"g":"no"}]},{"text":"Oui, je vous comprends.","en":"Yes, I understand you.","words":[null,{"g":"I"},{"g":"you"},{"g":"to understand","l":"comprendre"}]}]}