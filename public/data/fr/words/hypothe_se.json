{"id":"hypothe_se","lemma":"hypothèse","pos":"noun","rank":3793,"glosses":["hypothesis"],"ipa":"/i.pɔ.tɛz/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/66/Fr-hypoth%C3%A8se.ogg/Fr-hypoth%C3%A8se.ogg.mp3","gender":"f","forms":{"plural":"hypothèses"},"formAudio":{"hypothèses":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q150_%28fra%29-Eihel-hypoth%C3%A8ses.wav"},"examples":[{"text":"Votre hypothèse est erronée.","en":"Your guess is wrong.","audio":"https://tatoeba.org/en/audio/download/39078","words":[{"g":"your, belonging to you"},null,{"g":"is","l":"être"},{"g":"wrong","l":"erroné"}]},{"text":"C'est ma meilleure hypothèse.","en":"That's my best guess.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"my","l":"mon"},{"g":"best, better","l":"meilleur"},null]},{"text":"Sur quoi se fondent vos hypothèses ?","en":"What are your assumptions based on?","words":[{"g":"on"},{"g":"what"},{"g":"oneself"},{"g":"to melt","l":"fondre"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Cette hypothèse est fausse.","en":"That assumption is wrong.","words":[{"g":"it, this, that","l":"ce"},null,{"g":"is","l":"être"},{"g":"false","l":"faux"}]},{"text":"Ton hypothèse est complètement irréaliste.","en":"Your hypothesis is completely unrealistic.","words":[{"g":"your"},null,{"g":"is","l":"être"},{"g":"completely"},{"g":"unrealistic"}]}]}