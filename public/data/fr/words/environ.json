{"id":"environ","lemma":"environ","pos":"adv","rank":777,"glosses":["about, close to, around"],"ipa":"/ɑ̃.vi.ʁɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/26/Fr-environ.ogg/Fr-environ.ogg.mp3","examples":[{"text":"Est-il environ dix heures ?","en":"Is it about ten o'clock?","words":[{"g":"is","l":"être"},{"g":"he / it"},null,{"g":"ten"},{"g":"hour, time","l":"heure"}]},{"text":"Il a environ mon âge.","en":"He is about my age.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"my"},{"g":"age"}]},{"text":"Combien as-tu d'argent environ ?","en":"About how much money do you have?","words":[{"g":"how much"},{"g":"have","l":"avoir"},{"g":"you"},{"g":"of / from"},{"g":"money"},null]},{"text":"Je fais ça depuis environ trois ans.","en":"I've been doing that for about three years.","words":[{"g":"I"},{"g":"to do","l":"faire"},{"g":"that"},{"g":"since"},null,{"g":"three"},{"g":"year","l":"an"}]},{"text":"Ça vaut environ trois mille dollars.","en":"This is worth about three thousand dollars.","words":[{"g":"that"},{"g":"to be worth","l":"valoir"},null,{"g":"three"},{"g":"mile"},{"g":"dollar","l":"dollar"}]}]}