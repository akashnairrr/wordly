{"id":"porte","lemma":"porte","pos":"noun","rank":206,"glosses":["door","gate (to a city, at airport)","gateway, means, door"],"ipa":"/pɔʁt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/66/Fr-porte.ogg/Fr-porte.ogg.mp3","gender":"f","forms":{"plural":"portes"},"formAudio":{"portes":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q150_%28fra%29-Poslovitch-portes.wav"},"examples":[{"text":"Peux-tu fermer la porte ?","en":"Can you close the door?","audio":"https://tatoeba.org/en/audio/download/28636","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to shut"},{"g":"the / her"},null]},{"text":"Pouvez-vous ouvrir cette porte ?","en":"Can you open this door?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to open"},{"g":"it, this, that","l":"ce"},null]},{"text":"Qui est à la porte ?","en":"Who's at the door?","words":[{"g":"who"},{"g":"is","l":"être"},null,null,null],"phrases":[[2,4,"a la"]]},{"text":"Elle a ouvert la porte.","en":"She opened the door.","audio":"https://tatoeba.org/en/audio/download/12246","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"open"},{"g":"the / her"},null]},{"text":"Va ouvrir la porte.","en":"Go and open the door.","words":[{"g":"to go","l":"aller"},{"g":"to open"},{"g":"the / her"},null]}]}