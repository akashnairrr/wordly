{"id":"effectivement","lemma":"effectivement","pos":"adv","rank":2495,"glosses":["indeed"],"ipa":"/e.fɛk.tiv.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4a/LL-Q150_%28fra%29-WikiLucas00-effectivement.wav/LL-Q150_%28fra%29-WikiLucas00-effectivement.wav.mp3","examples":[{"text":"Vous aviez effectivement dit cela.","en":"You did say that.","audio":"https://tatoeba.org/en/audio/download/214467","words":[{"g":"you"},{"g":"to have","l":"avoir"},null,{"g":"to say, to tell","l":"dire"},{"g":"that"}]},{"text":"Elles ont effectivement gagné.","en":"They really did win.","words":[{"g":"they"},{"g":"to have","l":"avoir"},null,{"g":"to win","l":"gagner"}]},{"text":"J'ai effectivement une question.","en":"I do have one question.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"a"},{"g":"question"}]},{"text":"Le travail est effectivement achevé.","en":"The work is actually finished.","words":[{"g":"the / it"},{"g":"work"},{"g":"is","l":"être"},null,{"g":"to finish, to complete","l":"achever"}]},{"text":"Viendra-t-il effectivement ?","en":"Is he really coming?","words":[{"g":"to come","l":"venir"},{"g":"you"},{"g":"he / it"},null]}]}