{"id":"directement","lemma":"directement","pos":"adv","rank":1193,"glosses":["directly"],"ipa":"/di.ʁɛk.tə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/36/Fr-directement.ogg/Fr-directement.ogg.mp3","examples":[{"text":"Pourquoi ne pas lui en parler directement ?","en":"Why not talk to her about it directly?","words":[{"g":"why"},{"g":"not"},{"g":"not"},{"g":"him, he, it"},{"g":"in / of it"},{"g":"to speak, talk"},null]},{"text":"Puis-je faire le numéro directement ?","en":"Can I dial direct?","words":[{"g":"then"},{"g":"I"},{"g":"to do"},{"g":"the / it"},{"g":"number"},null]},{"text":"Je suis allé directement au lit.","en":"I went straight to bed.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"to go","l":"aller"},null,null,null],"phrases":[[4,6,"to bed! off to bed!…"]]},{"text":"Il but directement à la bouteille.","en":"He drank straight from the bottle.","words":[{"g":"he / it"},{"g":"aim"},null,null,null,{"g":"bottle"}],"phrases":[[3,5,"a la"]]},{"text":"Il vous contactera directement.","en":"He will be contacting you directly.","words":[{"g":"he / it"},{"g":"you"},{"g":"to contact","l":"contacter"},null]}]}