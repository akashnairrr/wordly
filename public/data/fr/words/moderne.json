{"id":"moderne","lemma":"moderne","pos":"adj","rank":2454,"glosses":["modern"],"ipa":"/mɔ.dɛʁn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/48/Fr-moderne.ogg/Fr-moderne.ogg.mp3","forms":{"plural":"modernes"},"formAudio":{"modernes":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q150_%28fra%29-WikiLucas00-modernes.wav"},"examples":[{"text":"Votre maison est très moderne.","en":"Your house is very modern.","words":[{"g":"your, belonging to you"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"very"},null]},{"text":"Il ne comprend pas la technologie moderne.","en":"He does not understand modern technology.","words":[{"g":"he / it"},{"g":"not"},{"g":"to understand","l":"comprendre"},{"g":"not"},{"g":"the / her"},{"g":"technology"},null]},{"text":"Je lis beaucoup d'auteurs modernes.","en":"I read a lot of modern authors.","words":[{"g":"I"},{"g":"lily"},{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"author","l":"auteur"},null]},{"text":"Ta maison est très moderne.","en":"Your house is very modern.","words":[{"g":"your"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"very"},null]},{"text":"J'ai appris beaucoup des auteurs modernes.","en":"I've learned a lot about modern authors.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to learn","l":"apprendre"},{"g":"much, very much, a lot"},{"g":"some / of the","l":"un"},{"g":"author","l":"auteur"},null]}]}