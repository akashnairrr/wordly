{"id":"e_galement","lemma":"également","pos":"adv","rank":1156,"glosses":["equally","too; also"],"ipa":"/e.ɡal.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fc/Fr-%C3%A9galement.ogg/Fr-%C3%A9galement.ogg.mp3","examples":[{"text":"Entends-tu également cela ?","en":"Do you hear that, too?","words":[{"g":"to hear","l":"entendre"},{"g":"you"},null,{"g":"that"}]},{"text":"Il parle également français.","en":"He also speaks French.","audio":"https://tatoeba.org/en/audio/download/472095","words":[{"g":"he / it"},{"g":"to speak, talk","l":"parler"},null,{"g":"French"}]},{"text":"Puis-je en avoir un également ?","en":"Can I have one, too?","audio":"https://tatoeba.org/en/audio/download/653708","words":[{"g":"then"},{"g":"I"},{"g":"in / of it"},{"g":"to have"},{"g":"a"},null]},{"text":"Je veux également jouer.","en":"I want to play, too.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,{"g":"to play"}]},{"text":"Entendez-vous également cela ?","en":"Do you hear that, too?","words":[{"g":"to hear","l":"entendre"},{"g":"you"},null,{"g":"that"}]}]}