{"id":"froid","lemma":"froid","pos":"adj","rank":636,"glosses":["cold (temperature)","distant, unfriendly"],"ipa":"/fʁwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/Fr-froid.ogg/Fr-froid.ogg.mp3","forms":{"feminine":"froide","masculinePlural":"froids","femininePlural":"froides"},"formAudio":{"froide":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q150_%28fra%29-Sartus85-froide.wav","froids":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q150_%28fra%29-WikiLucas00-froids.wav","froides":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q150_%28fra%29-Taousert-froides.wav"},"examples":[{"text":"Vous avez froid ?","en":"Are you cold?","audio":"https://tatoeba.org/en/audio/download/1092946","words":[{"g":"you"},{"g":"to have","l":"avoir"},null]},{"text":"Cette pièce est froide.","en":"This room is cold.","words":[{"g":"it, this, that","l":"ce"},{"g":"room in a house, etc."},{"g":"is","l":"être"},null]},{"text":"Il fait très froid maintenant.","en":"It's very cold now.","audio":"https://tatoeba.org/en/audio/download/2270","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"very"},null,{"g":"now, currently"}]},{"text":"Mes mains sont froides.","en":"My hands are cold.","words":[{"g":"my"},{"g":"hand","l":"main"},{"g":"to be","l":"être"},null]},{"text":"Il faisait très froid hier matin.","en":"It was very cold yesterday morning.","audio":"https://tatoeba.org/en/audio/download/2254","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"very"},null,{"g":"yesterday"},{"g":"morning"}]}]}