{"id":"brise","lemma":"brise","pos":"noun","rank":2571,"glosses":["breeze"],"ipa":"/bʁiz/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/Fr-brise.ogg/Fr-brise.ogg.mp3","gender":"f","forms":{"plural":"brises"},"formAudio":{"brises":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q150_%28fra%29-DenisdeShawi-brises.wav"},"examples":[{"text":"Ça me brise le cœur.","en":"It breaks my heart.","words":[{"g":"that"},{"g":"me"},null,{"g":"the / it"},{"g":"heart"}]},{"text":"Il souffle une douce brise.","en":"A gentle wind is blowing.","words":[{"g":"he / it"},{"g":"blowing"},{"g":"a"},{"g":"sweet","l":"doux"},null]},{"text":"Ça me brise vraiment le cœur.","en":"It really breaks my heart.","words":[{"g":"that"},{"g":"me"},null,{"g":"truly"},{"g":"the / it"},{"g":"heart"}]},{"text":"Cela me brise le cœur de vous voir pleurer.","en":"It breaks my heart to see you crying.","words":[{"g":"that"},{"g":"me"},null,{"g":"the / it"},{"g":"heart"},{"g":"of / from"},{"g":"you"},{"g":"to see"},{"g":"to cry, to weep"}]},{"text":"J'espère que cela ne brise pas notre amitié.","en":"I hope this doesn't ruin our friendship.","words":[{"g":"I"},{"g":"to hope","l":"espérer"},{"g":"that / what"},{"g":"that"},{"g":"not"},null,{"g":"not"},{"g":"our"},{"g":"friendship, amity"}]}]}