{"id":"proposition","lemma":"proposition","pos":"noun","rank":1915,"glosses":["proposition, suggestion","proposition","clause"],"ipa":"/pʁɔ.po.zi.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/Fr-proposition.ogg/Fr-proposition.ogg.mp3","gender":"f","forms":{"plural":"propositions"},"formAudio":{"propositions":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q150_%28fra%29-Lyoko%C3%AF-propositions.wav"},"examples":[{"text":"Sa proposition est hors de question.","en":"His proposal is out of the question.","words":[{"g":"his"},null,{"g":"is","l":"être"},null,null,null],"phrases":[[3,6,"out of the question!"]]},{"text":"Que penses-tu de sa proposition ?","en":"What do you think of his suggestion?","words":[{"g":"that / what"},{"g":"to think","l":"penser"},{"g":"you"},{"g":"of / from"},{"g":"his"},null]},{"text":"Es-tu pour ou contre la proposition ?","en":"Are you for or against the proposal?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"for"},{"g":"or"},{"g":"against"},{"g":"the / her"},null]},{"text":"Je suis ouvert aux propositions.","en":"I'm open to suggestions.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"open"},{"g":"to the"},null]},{"text":"J'ai une proposition.","en":"I have a proposal.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"a"},null]}]}