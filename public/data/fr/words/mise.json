{"id":"mise","lemma":"mise","pos":"noun","rank":772,"glosses":["placement; (act of) putting","bet; wager, ante","appearance; dress"],"ipa":"/miz/","gender":"f","forms":{"plural":"mises"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q150_%28fra%29-Sartus85-mise.wav","formAudio":{"mises":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q150_%28fra%29-Lyoko%C3%AF-mises.wav"},"examples":[{"text":"Combien mises-tu ?","en":"How much do you bet?","words":[{"g":"how much"},null,{"g":"you"}]},{"text":"Elle s'est mise à chanter.","en":"She began to sing.","audio":"https://tatoeba.org/en/audio/download/103956","words":[{"g":"she / it"},{"g":"oneself / if"},{"g":"is","l":"être"},null,{"g":"to / at"},{"g":"to sing"}]},{"text":"Je l'ai mise quelque part ici.","en":"I put it here somewhere.","audio":"https://tatoeba.org/en/audio/download/653699","words":[{"g":"I"},{"g":"the / it"},{"g":"have","l":"avoir"},null,null,null,{"g":"here"}],"phrases":[[4,6,"somewhere"]]},{"text":"Nous nous sommes toutes mises debout.","en":"All of us stood up.","words":[{"g":"we / us"},{"g":"we / us"},{"g":"to be","l":"être"},{"g":"all","l":"tout"},null,{"g":"standing"}]},{"text":"Merci pour les mises à jour.","en":"Thanks for the updates.","words":[{"g":"thank you"},{"g":"for"},{"g":"the / them","l":"le"},null,null,null],"phrases":[[4,6,"up-to-date, current"]]}]}