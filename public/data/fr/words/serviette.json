{"id":"serviette","lemma":"serviette","pos":"noun","rank":2381,"glosses":["towel (cloth used for wiping)","napkin","briefcase"],"ipa":"/sɛʁ.vjɛt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/08/Fr-serviette.ogg/Fr-serviette.ogg.mp3","gender":"f","forms":{"plural":"serviettes"},"formAudio":{"serviettes":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q150_%28fra%29-WikiLucas00-serviettes.wav"},"examples":[{"text":"Donne-moi une serviette.","en":"Give me a towel.","audio":"https://tatoeba.org/en/audio/download/351805","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null]},{"text":"Il lui faut une serviette.","en":"He needs a towel.","words":[{"g":"he / it"},{"g":"him, he, it"},{"g":"to need","l":"falloir"},{"g":"a"},null]},{"text":"Avez-vous compté les serviettes ?","en":"Have you counted the towels?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to count","l":"compter"},{"g":"the / them","l":"le"},null]},{"text":"As-tu apporté une serviette ?","en":"Did you bring a towel?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to bring","l":"apporter"},{"g":"a"},null]},{"text":"Je pliai les serviettes.","en":"I folded the towels.","words":[{"g":"I"},{"g":"to fold over","l":"plier"},{"g":"the / them","l":"le"},null]}]}