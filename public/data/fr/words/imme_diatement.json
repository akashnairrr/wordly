{"id":"imme_diatement","lemma":"immédiatement","pos":"adv","rank":919,"glosses":["immediately"],"ipa":"/i.me.djat.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/Fr-imm%C3%A9diatement.ogg/Fr-imm%C3%A9diatement.ogg.mp3","examples":[{"text":"Voulez-vous le faire immédiatement ?","en":"Do you want to do it right now?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"the / it"},{"g":"to do"},null]},{"text":"Je vais faire ça immédiatement.","en":"I'll do that immediately.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to do"},{"g":"that"},null]},{"text":"Monte dans la voiture immédiatement.","en":"Get in the car immediately.","words":[{"g":"to go up, to climb","l":"monter"},{"g":"in"},{"g":"the / her"},{"g":"car"},null]},{"text":"Quitte la pièce immédiatement.","en":"Leave the room immediately.","words":[{"g":"to leave, to quit","l":"quitter"},{"g":"the / her"},{"g":"room in a house, etc."},null]},{"text":"Pourquoi devons-nous faire ceci immédiatement ?","en":"Why do we have to do this right now?","words":[{"g":"why"},{"g":"must","l":"devoir"},{"g":"we / us"},{"g":"to do"},{"g":"this"},null]}]}