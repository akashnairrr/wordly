{"id":"re_fle_chi","lemma":"réfléchi","pos":"adj","rank":1354,"glosses":["reflexive","thoughtful"],"ipa":"/ʁe.fle.ʃi/","forms":{"feminine":"réfléchie","masculinePlural":"réfléchis","femininePlural":"réfléchies"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/de/LL-Q150_%28fra%29-VictorDtmtc-r%C3%A9fl%C3%A9chi.wav","examples":[{"text":"J'ai réfléchi au problème.","en":"I reflected on the problem.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"to the"},{"g":"problem"}]},{"text":"Avez-vous réfléchi à notre offre ?","en":"Did you think about our offer?","words":[{"g":"to have","l":"avoir"},{"g":"you"},null,{"g":"to / at"},{"g":"our"},{"g":"offer"}]},{"text":"As-tu réfléchi à tout ?","en":"Have you thought everything through?","words":[{"g":"have","l":"avoir"},{"g":"you"},null,{"g":"to / at"},{"g":"all"}]},{"text":"Nous y avons beaucoup réfléchi.","en":"We've given it a great deal of thought.","words":[{"g":"we / us"},{"g":"there"},{"g":"to have","l":"avoir"},{"g":"much, very much, a lot"},null]},{"text":"J'ai beaucoup réfléchi à ça.","en":"I've thought about that a lot.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"much, very much, a lot"},null,{"g":"to / at"},{"g":"that"}]}]}