{"id":"front","lemma":"front","pos":"noun","rank":1644,"glosses":["forehead","front, frontline"],"ipa":"/fʁɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1e/Fr-front.ogg/Fr-front.ogg.mp3","gender":"m","forms":{"plural":"fronts"},"formAudio":{"fronts":"https://upload.wikimedia.org/wikipedia/commons/9/9c/LL-Q150_%28fra%29-Roptat-fronts.wav"},"examples":[{"text":"Il a été trois mois au front.","en":"He was at the front for three months.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"summer"},{"g":"three"},{"g":"month"},{"g":"to the"},null]},{"text":"Il embrassa sa fille sur le front.","en":"He kissed his daughter on the forehead.","words":[{"g":"he / it"},{"g":"to kiss","l":"embrasser"},{"g":"his"},{"g":"girl"},{"g":"on"},{"g":"the / it"},null]},{"text":"Tu saignes du front.","en":"Your forehead's bleeding.","words":[{"g":"you"},{"g":"to bleed","l":"saigner"},{"g":"of the / some"},null]},{"text":"Il m'a embrassé sur le front.","en":"He kissed me on the forehead.","words":[{"g":"he / it"},{"g":"me"},{"g":"has","l":"avoir"},{"g":"\"embraced\" on the…"},{"g":"on"},{"g":"the / it"},null]},{"text":"Il porta la main à son front.","en":"He put his hand to his forehead.","words":[{"g":"he / it"},{"g":"to carry","l":"porter"},{"g":"the / her"},{"g":"hand"},{"g":"to / at"},{"g":"his, her, its"},null]}]}