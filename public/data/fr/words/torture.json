{"id":"torture","lemma":"torture","pos":"noun","rank":2435,"glosses":["torture"],"ipa":"/tɔʁ.tyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c9/Fr-torture.ogg/Fr-torture.ogg.mp3","gender":"f","forms":{"plural":"tortures"},"formAudio":{"tortures":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q150_%28fra%29-Eihel-tortures.wav"},"examples":[{"text":"Mes pieds me sont une torture.","en":"My feet are killing me.","words":[{"g":"my"},{"g":"foot","l":"pied"},{"g":"me"},{"g":"to be","l":"être"},{"g":"a"},null]},{"text":"Ne te torture pas !","en":"Don't beat yourself up.","words":[{"g":"not"},{"g":"you"},null,{"g":"not"}]},{"text":"Pourquoi me tortures-tu ?","en":"Why are you torturing me?","words":[{"g":"why"},{"g":"me"},null,{"g":"you"}]},{"text":"Il ne divulgua pas l'information, pas même sous la torture.","en":"He didn't divulge the information, not even under pain of torture.","words":[{"g":"he / it"},{"g":"not"},null,{"g":"not"},{"g":"the / it"},{"g":"piece of information]"},{"g":"not"},{"g":"same"},{"g":"below, under"},{"g":"the / her"},null]},{"text":"Les confessions obtenues par la torture sont en général sans valeur.","en":"Confessions obtained by torture are generally worthless.","words":[{"g":"the / them","l":"le"},{"g":"confession","l":"confession"},null,{"g":"through"},{"g":"the / her"},null,{"g":"to be","l":"être"},null,null,{"g":"without"},{"g":"value, worth"}],"phrases":[[7,9,"in general"]]}]}