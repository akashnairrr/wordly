{"id":"biento_t","lemma":"bientôt","pos":"adv","rank":348,"glosses":["soon"],"ipa":"/bjɛ̃.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d3/Fr-bient%C3%B4t.ogg/Fr-bient%C3%B4t.ogg.mp3","examples":[{"text":"Nous serons bientôt probablement tous morts.","en":"We'll probably all be dead soon.","audio":"https://tatoeba.org/en/audio/download/334427","words":[{"g":"we / us"},{"g":"to be","l":"être"},null,{"g":"probably"},{"g":"all"},{"g":"dead","l":"mort"}]},{"text":"Il sera bientôt là.","en":"He'll be here soon.","audio":"https://tatoeba.org/en/audio/download/2688","words":[{"g":"he / it"},{"g":"to be","l":"être"},null,{"g":"there"}]},{"text":"Ils vont bientôt revenir.","en":"They'll be back soon.","audio":"https://tatoeba.org/en/audio/download/213737","words":[{"g":"they"},{"g":"to go","l":"aller"},null,{"g":"to come back"}]},{"text":"Je reviens bientôt.","en":"I'll return soon.","audio":"https://tatoeba.org/en/audio/download/2181","words":[{"g":"I"},{"g":"to come back","l":"revenir"},null]},{"text":"Noël arrive bientôt.","en":"Christmas is soon.","audio":"https://tatoeba.org/en/audio/download/2687","words":[{"g":"Christmas"},{"g":"to arrive","l":"arriver"},null]}]}