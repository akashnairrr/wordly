{"id":"manie_re","lemma":"manière","pos":"noun","rank":676,"glosses":["manner, way"],"ipa":"/ma.njɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8d/Fr-mani%C3%A8re.ogg/Fr-mani%C3%A8re.ogg.mp3","gender":"f","forms":{"plural":"manières"},"formAudio":{"manières":"https://upload.wikimedia.org/wikipedia/commons/2/28/LL-Q150_%28fra%29-Lyoko%C3%AF-mani%C3%A8res.wav"},"examples":[{"text":"Fais-le de cette manière.","en":"Do it this way.","words":[{"g":"to do","l":"faire"},{"g":"the / it"},{"g":"of / from"},{"g":"it, this, that","l":"ce"},null]},{"text":"Je le ferai à ma manière.","en":"I'll do it my way.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},{"g":"to / at"},{"g":"my","l":"mon"},null]},{"text":"Il fait attention à ses manières.","en":"He is careful about his manners.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"attention"},{"g":"to / at"},{"g":"his"},null]},{"text":"Elle n'a aucune manière.","en":"She has no manners.","words":[{"g":"she / it"},{"g":"not"},{"g":"has","l":"avoir"},{"g":"none, no-one","l":"aucun"},null]},{"text":"J'ai oublié les bonnes manières.","en":"I forgot my manners.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to forget","l":"oublier"},{"g":"the / them","l":"le"},{"g":"good","l":"bon"},null]}]}