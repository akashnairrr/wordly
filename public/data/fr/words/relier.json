{"id":"relier","lemma":"relier","pos":"verb","rank":4507,"glosses":["to connect, link, join, relate to","to bind (as a book)","to hoop together (as a barrel)"],"ipa":"/ʁə.lje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f5/Fr-relier.ogg/Fr-relier.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"relie","2s":"relies","3s":"relie","1p":"relions","2p":"reliez","3p":"relient"},"imperfect":{"1s":"reliais","2s":"reliais","3s":"reliait","1p":"reliions","2p":"reliiez","3p":"reliaient"},"preterite":{"1s":"reliai","2s":"relias","3s":"relia","1p":"reliâmes","2p":"reliâtes","3p":"relièrent"},"future":{"1s":"relierai","2s":"relieras","3s":"reliera","1p":"relierons","2p":"relierez","3p":"relieront"},"conditional":{"1s":"relierais","2s":"relierais","3s":"relierait","1p":"relierions","2p":"relieriez","3p":"relieraient"},"perfect":{"1s":"ai relié","2s":"as relié","3s":"a relié","1p":"avons relié","2p":"avez relié","3p":"ont relié"}},"subjunctive":{"present":{"1s":"relie","2s":"relies","3s":"relie","1p":"reliions","2p":"reliiez","3p":"relient"},"imperfect":{"1s":"reliasse","2s":"reliasses","3s":"reliât","1p":"reliassions","2p":"reliassiez","3p":"reliassent"}},"imperative":{"affirmative":{"2s":"relie","1p":"relions","2p":"reliez"}}},"nonFinite":{"gerund":"reliant","participle":"relié"},"formAudio":{"relié":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q150_%28fra%29-VictorDtmtc-reli%C3%A9.wav","relie":"https://upload.wikimedia.org/wikipedia/commons/9/92/LL-Q150_%28fra%29-WikiLucas00-relie.wav","relies":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q150_%28fra%29-Lyoko%C3%AF-relies.wav"},"examples":[{"text":"Il sait comment relier les livres.","en":"He knows how to bind books.","words":[{"g":"he / it"},{"g":"to know","l":"savoir"},{"g":"how"},null,{"g":"the / them","l":"le"},{"g":"book","l":"livre"}]},{"text":"Ce téléphone est relié au fax.","en":"This telephone is connected to the fax machine.","words":[{"g":"this / it"},{"g":"telephone"},{"g":"is","l":"être"},null,{"g":"to the"},{"g":"fax"}]},{"text":"Il a relié deux idées en une.","en":"He combined two ideas into one.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"two"},{"g":"idea","l":"idée"},{"g":"in / of it"},{"g":"a"}]},{"text":"Le village est relié à notre ville par un pont.","en":"The village is connected with our town by a bridge.","words":[{"g":"the / it"},{"g":"village"},{"g":"is","l":"être"},null,{"g":"to / at"},{"g":"our"},{"g":"town, city"},{"g":"through"},{"g":"a"},{"g":"bridge"}]},{"text":"Un très vieux pont de pierre relie les deux rives.","en":"A very old stone bridge connects the two riverbanks.","words":[{"g":"a"},{"g":"very"},{"g":"old"},{"g":"bridge"},{"g":"of / from"},{"g":"stone"},null,{"g":"the / them","l":"le"},{"g":"two"},{"g":"to drive/set a rivet","l":"river"}]}]}