{"id":"argument","lemma":"argument","pos":"noun","rank":4267,"glosses":["argument","argument of a verb, phrase syntactically connected to a verb (object and subject)"],"ipa":"/aʁ.ɡy.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ee/Fr-argument.ogg/Fr-argument.ogg.mp3","gender":"m","forms":{"plural":"arguments"},"formAudio":{"arguments":"https://upload.wikimedia.org/wikipedia/commons/e/e4/LL-Q150_%28fra%29-Lyoko%C3%AF-arguments.wav"},"examples":[{"text":"Vous tenez là un argument.","en":"You have a point there.","words":[{"g":"you"},{"g":"to have","l":"tenir"},{"g":"there"},{"g":"a"},null]},{"text":"Son argument était logique.","en":"His argument was logical.","words":[{"g":"his, her, its"},null,{"g":"to be","l":"être"},{"g":"logical"}]},{"text":"Je trouve tes arguments illogiques.","en":"I find your arguments illogical.","words":[{"g":"I"},{"g":"to find","l":"trouver"},{"g":"your"},null,null]},{"text":"Elle a un argument.","en":"She's got a point.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"a"},null]},{"text":"Ses arguments ne me convainquent pas.","en":"His arguments don't convince me.","words":[{"g":"his"},null,{"g":"not"},{"g":"me"},{"g":"to convince","l":"convaincre"},{"g":"not"}]}]}