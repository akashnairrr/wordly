{"id":"le_ge_rement","lemma":"légèrement","pos":"adv","rank":3491,"glosses":["lightly","slightly"],"ipa":"/le.ʒɛʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f8/Fr-l%C3%A9g%C3%A8rement.ogg/Fr-l%C3%A9g%C3%A8rement.ogg.mp3","examples":[{"text":"J'ai légèrement faim.","en":"I'm sort of hungry.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"hunger"}]},{"text":"Cette route tourne légèrement vers la droite.","en":"This road curves gently to the right.","words":[{"g":"it, this, that","l":"ce"},{"g":"road"},{"g":"to turn","l":"tourner"},null,{"g":"towards"},{"g":"the / her"},{"g":"right"}]},{"text":"Penses-tu pouvoir faire légèrement moins de bruit ?","en":"Do you think you could make a little less noise?","words":[{"g":"to think","l":"penser"},{"g":"you"},{"g":"can, to be able to"},{"g":"to do"},null,{"g":"less"},{"g":"of / from"},{"g":"a noise"}]},{"text":"Elle zézaie légèrement.","en":"She has a slight lisp.","words":[{"g":"she / it"},null,null]},{"text":"Mon opinion est légèrement différente de la vôtre.","en":"My opinion is a little different from yours.","words":[{"g":"my"},{"g":"opinion"},{"g":"is","l":"être"},null,{"g":"different","l":"différent"},null,null,null],"phrases":[[5,7,"of the"]]}]}