{"id":"chinois","lemma":"chinois","pos":"noun","rank":1304,"glosses":["Chinese (language)","Greek (something difficult to understand)","a chinois, fine-meshed strainer"],"ipa":"/ʃi.nwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d3/Fr-chinois-fr.ogg/Fr-chinois-fr.ogg.mp3","gender":"m","examples":[{"text":"Elle parle chinois.","en":"She speaks Chinese.","words":[{"g":"she / it"},{"g":"to speak, talk","l":"parler"},null]},{"text":"Il parle un peu chinois.","en":"He can speak Chinese a little.","words":[{"g":"he / it"},{"g":"to speak, talk","l":"parler"},null,null,null],"phrases":[[2,4,"a little, a bit"]]},{"text":"Allons à un restaurant chinois.","en":"Let's go to a Chinese restaurant.","words":[{"g":"to go","l":"aller"},{"g":"to / at"},{"g":"a"},{"g":"restaurant"},null]},{"text":"Sont-ils japonais ou chinois ?","en":"Are they Japanese or Chinese?","words":[{"g":"to be","l":"être"},{"g":"they"},{"g":"Japanese"},{"g":"or"},null]},{"text":"Je peux parler chinois, mais pas le lire.","en":"I can speak Chinese, but I can't read it.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to speak, talk"},null,{"g":"but"},{"g":"not"},{"g":"the / it"},{"g":"to read"}]}]}