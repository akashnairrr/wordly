{"id":"te_le_vision","lemma":"télévision","pos":"noun","rank":1918,"glosses":["television"],"ipa":"/te.le.vi.zjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ab/Fr-t%C3%A9l%C3%A9vision.ogg/Fr-t%C3%A9l%C3%A9vision.ogg.mp3","gender":"f","forms":{"plural":"télévisions"},"formAudio":{"télévisions":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q150_%28fra%29-0x010C-t%C3%A9l%C3%A9visions.wav"},"examples":[{"text":"Pourrais-je regarder la télévision maintenant ?","en":"May I watch TV now?","audio":"https://tatoeba.org/en/audio/download/2271","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"I"},{"g":"to look at"},{"g":"the / her"},null,{"g":"now, currently"}]},{"text":"Je regarde la télévision le soir.","en":"I watch television in the evening.","words":[{"g":"I"},{"g":"to look at","l":"regarder"},{"g":"the / her"},null,{"g":"the / it"},{"g":"evening"}]},{"text":"Vous regardez beaucoup la télévision ?","en":"Do you watch much television?","words":[{"g":"you"},{"g":"to look at","l":"regarder"},{"g":"much, very much, a lot"},{"g":"the / her"},null]},{"text":"La télévision ne fonctionne plus.","en":"The television's not working.","words":[{"g":"the / her"},null,{"g":"not"},{"g":"to function, to work","l":"fonctionner"},{"g":"more / no longer"}]},{"text":"As-tu éteint la télévision ?","en":"Have you turned off the television?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to turn off","l":"éteindre"},{"g":"the / her"},null]}]}