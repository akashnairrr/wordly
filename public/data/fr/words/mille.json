{"id":"mille","lemma":"mille","pos":"noun","rank":983,"glosses":["mile (abbreviation mi)","bullseye"],"ipa":"/mil/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7c/Fr-mille.ogg/Fr-mille.ogg.mp3","gender":"m","forms":{"plural":"milles"},"examples":[{"text":"Une image vaut mille mots.","en":"A picture is worth a thousand words.","words":[{"g":"a"},{"g":"picture, image"},{"g":"to be worth","l":"valoir"},null,{"g":"word","l":"mot"}]},{"text":"Je peux marcher au moins deux milles.","en":"I can walk at least two miles.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to walk"},null,null,{"g":"two"},null],"phrases":[[3,5,"at least, at a minimum"]]},{"text":"Ça vaut environ trois mille dollars.","en":"This is worth about three thousand dollars.","words":[{"g":"that"},{"g":"to be worth","l":"valoir"},{"g":"about"},{"g":"three"},null,{"g":"dollar","l":"dollar"}]},{"text":"Elle a deux mille livres.","en":"She has 2,000 books.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"two"},null,{"g":"book","l":"livre"}]},{"text":"Ma maison est seulement à un mille d'ici.","en":"My house is only a mile from here.","audio":"https://tatoeba.org/en/audio/download/2708","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"only"},{"g":"to / at"},{"g":"a"},null,{"g":"of / from"},{"g":"here"}]}]}