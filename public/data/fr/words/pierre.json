{"id":"pierre","lemma":"pierre","pos":"noun","rank":903,"glosses":["stone (substance)","stone (rock, a pebble)","real estate"],"ipa":"/pjɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/af/Fr-pierre.ogg/Fr-pierre.ogg.mp3","gender":"f","forms":{"plural":"pierres"},"formAudio":{"pierres":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q150_%28fra%29-Poslovitch-pierres.wav"},"examples":[{"text":"La maison est en pierre.","en":"The house is made of stone.","words":[{"g":"the / her"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"in / of it"},null]},{"text":"Quel genre de pierre est-ce ?","en":"What kind of stone is this?","words":[{"g":"which"},{"g":"kind"},{"g":"of / from"},null,{"g":"is","l":"être"},{"g":"this / it"}]},{"text":"Ce pont est fait de pierres.","en":"That bridge is made of stone.","words":[{"g":"this / it"},{"g":"bridge"},{"g":"is","l":"être"},{"g":"to do","l":"faire"},{"g":"of / from"},null]},{"text":"Le garçon a jeté une pierre.","en":"The boy threw a stone.","words":[{"g":"the / it"},{"g":"boy"},{"g":"has","l":"avoir"},{"g":"jete"},{"g":"a"},null]},{"text":"Ne jette pas de pierres.","en":"Don't throw stones.","words":[{"g":"not"},{"g":"to throw","l":"jeter"},{"g":"not"},{"g":"of / from"},null]}]}