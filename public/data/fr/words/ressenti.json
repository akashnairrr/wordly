{"id":"ressenti","lemma":"ressenti","pos":"noun","rank":2288,"glosses":["impressions, feelings, opinions (one's collective subjective (non-physical) senses)"],"ipa":"/ʁə.sɑ̃.ti/","gender":"m","forms":{"plural":"ressentis"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q150_%28fra%29-VictorDtmtc-ressenti.wav","examples":[{"text":"J'ai ressenti de la peur.","en":"I felt fear.","audio":"https://tatoeba.org/en/audio/download/473915","words":[{"g":"I"},{"g":"have","l":"avoir"},null,null,null,{"g":"fear"}],"phrases":[[3,5,"of the"]]},{"text":"J'ai ressenti exactement la même chose.","en":"I felt exactly the same way.","audio":"https://tatoeba.org/en/audio/download/653702","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"exactly, quite"},{"g":"the / her"},{"g":"same"},{"g":"thing"}]},{"text":"Je comprends ce que vous avez ressenti.","en":"I understand how you felt.","words":[{"g":"I"},{"g":"to understand","l":"comprendre"},null,null,{"g":"you"},{"g":"to have","l":"avoir"},null],"phrases":[[2,4,"what"]]},{"text":"Qu'as-tu ressenti ?","en":"How did it feel?","words":[{"g":"that / what"},{"g":"have","l":"avoir"},{"g":"you"},null]},{"text":"Je n'ai rien ressenti.","en":"I didn't feel a thing.","words":[{"g":"I"},{"g":"not"},{"g":"have","l":"avoir"},{"g":"nothing"},null]}]}