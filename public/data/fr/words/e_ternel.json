{"id":"e_ternel","lemma":"éternel","pos":"adj","rank":3212,"glosses":["eternal (ever-lasting)"],"ipa":"/e.tɛʁ.nɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f6/Fr-%C3%A9ternel.ogg/Fr-%C3%A9ternel.ogg.mp3","forms":{"feminine":"éternelle","masculinePlural":"éternels","femininePlural":"éternelles"},"formAudio":{"éternelle":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-%C3%A9ternelle.wav"},"examples":[{"text":"Je suis un éternel romantique.","en":"I'm a hopeless romantic.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"a"},null,{"g":"romantic"}]},{"text":"Rien n'est éternel.","en":"Nothing is permanent.","words":[{"g":"nothing"},{"g":"not"},{"g":"is","l":"être"},null]},{"text":"Je remercie l'Éternel chaque jour.","en":"I thank the Lord every day.","words":[{"g":"I"},{"g":"to thank","l":"remercier"},{"g":"the / it"},null,{"g":"each"},{"g":"day"}]},{"text":"Les diamants sont éternels.","en":"Diamonds are forever.","words":[{"g":"the / them","l":"le"},{"g":"diamond","l":"diamant"},{"g":"to be","l":"être"},null]},{"text":"Personne n'est éternel.","en":"Nobody lives forever.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"is","l":"être"},null]}]}