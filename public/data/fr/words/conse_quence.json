{"id":"conse_quence","lemma":"conséquence","pos":"noun","rank":1966,"glosses":["general senses","consequence"],"ipa":"/kɔ̃.se.kɑ̃s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/Fr-cons%C3%A9quence.ogg/Fr-cons%C3%A9quence.ogg.mp3","gender":"f","forms":{"plural":"conséquences"},"formAudio":{"conséquences":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q150_%28fra%29-Poslovitch-cons%C3%A9quences.wav"},"examples":[{"text":"Je connais les conséquences.","en":"I know the consequences.","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"the / them","l":"le"},null]},{"text":"Ils sont sans conséquence.","en":"They're of no consequence.","words":[{"g":"they"},{"g":"to be","l":"être"},{"g":"without"},null]},{"text":"Toute action a ses conséquences.","en":"Every action has its consequence.","words":[{"g":"all","l":"tout"},{"g":"action, act, deed"},{"g":"has","l":"avoir"},{"g":"his"},null]},{"text":"C'est sans conséquence.","en":"It's of no consequence.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"without"},null]},{"text":"Je me fiche des conséquences.","en":"I don't care what the consequences are.","words":[{"g":"I"},{"g":"me"},{"g":"to plug in","l":"ficher"},{"g":"some / of the","l":"un"},null]}]}