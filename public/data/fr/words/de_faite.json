{"id":"de_faite","lemma":"défaite","pos":"noun","rank":3469,"glosses":["defeat, loss"],"ipa":"/de.fɛt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ae/LL-Q150_%28fra%29-Poslovitch-d%C3%A9faite.wav/LL-Q150_%28fra%29-Poslovitch-d%C3%A9faite.wav.mp3","gender":"f","forms":{"plural":"défaites"},"examples":[{"text":"Il admit sa défaite.","en":"He admitted his defeat.","words":[{"g":"he / it"},{"g":"to admit","l":"admettre"},{"g":"his"},null]},{"text":"Vous ne pouvez pas admettre votre défaite.","en":"You can't give up.","words":[{"g":"you"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"not"},{"g":"to admit"},{"g":"your, belonging to you"},null]},{"text":"Je ne peux pas admettre ma défaite.","en":"I can't give up.","words":[{"g":"I"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"not"},{"g":"to admit"},{"g":"my","l":"mon"},null]},{"text":"Je crains d'être un peu défaite.","en":"I'm afraid I'm a bit out of shape.","words":[{"g":"I"},{"g":"to fear","l":"craindre"},{"g":"of / from"},{"g":"to be"},null,null,null],"phrases":[[4,6,"a little, a bit"]]},{"text":"Il a admis sa défaite.","en":"He admitted his defeat.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to admit","l":"admettre"},{"g":"his"},null]}]}