{"id":"navire","lemma":"navire","pos":"noun","rank":1664,"glosses":["ship"],"ipa":"/na.viʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9e/Fr-navire.ogg/Fr-navire.ogg.mp3","gender":"m","forms":{"plural":"navires"},"formAudio":{"navires":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q150_%28fra%29-Eihel-navires.wav"},"examples":[{"text":"Le capitaine contrôle tout le navire.","en":"The captain controls the whole ship.","words":[{"g":"the / it"},{"g":"captain, leader"},{"g":"control"},{"g":"all"},{"g":"the / it"},null]},{"text":"Le navire est en mer.","en":"The ship is at sea.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"in / of it"},{"g":"sea"}]},{"text":"Le navire a quitté le port.","en":"The ship left port.","audio":"https://tatoeba.org/en/audio/download/1098055","words":[{"g":"the / it"},null,{"g":"has","l":"avoir"},{"g":"to leave, to quit","l":"quitter"},{"g":"the / it"},{"g":"port, harbour"}]},{"text":"Ils coulèrent dix navires ennemis.","en":"They sank ten enemy ships.","words":[{"g":"they"},{"g":"to sink","l":"couler"},{"g":"ten"},null,{"g":"enemy","l":"ennemi"}]},{"text":"Ils ont abandonné le navire.","en":"They abandoned the ship.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"given up, abandoned"},{"g":"the / it"},null]}]}