{"id":"outre","lemma":"outre","pos":"prep","rank":3742,"glosses":["as well as, besides, on top of","across, beyond"],"ipa":"/utʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c4/LL-Q150_%28fra%29-LoquaxFR-outre.wav/LL-Q150_%28fra%29-LoquaxFR-outre.wav.mp3","examples":[{"text":"Cela ne m'inquiète pas outre mesure.","en":"I'm not unduly worried by it.","words":[{"g":"that"},{"g":"not"},{"g":"me"},{"g":"worried","l":"inquiet"},{"g":"not"},null,{"g":"measure"}]},{"text":"Prévois-tu de te rendre outre-mer ?","en":"Do you plan to go overseas?","words":[{"g":"to anticipate","l":"prévoir"},{"g":"you"},{"g":"of / from"},{"g":"you"},{"g":"to return"},null,{"g":"sea"}]},{"text":"Ça ne m'inquiète pas outre mesure.","en":"I'm not too concerned about it.","words":[{"g":"that"},{"g":"not"},{"g":"me"},{"g":"worried","l":"inquiet"},{"g":"not"},null,{"g":"measure"}]},{"text":"Prévoyez-vous de vous rendre outre-mer ?","en":"Do you plan to go overseas?","words":[{"g":"to anticipate","l":"prévoir"},{"g":"you"},{"g":"of / from"},{"g":"you"},{"g":"to return"},null,{"g":"sea"}]},{"text":"Elle ne voulait pas qu'il se rende outre-mer.","en":"She didn't want him to go overseas.","words":[{"g":"she / it"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"not"},{"g":"that / what"},{"g":"he / it"},{"g":"oneself"},{"g":"to return","l":"rendre"},null,{"g":"sea"}]}]}