{"id":"totalement","lemma":"totalement","pos":"adv","rank":1008,"glosses":["totally"],"ipa":"/tɔ.tal.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/Fr-totalement.ogg/Fr-totalement.ogg.mp3","examples":[{"text":"Je vous crois totalement.","en":"I totally believe you.","words":[{"g":"I"},{"g":"you"},{"g":"to believe","l":"croire"},null]},{"text":"Je suis totalement d'accord.","en":"I totally agree.","audio":"https://tatoeba.org/en/audio/download/48480","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"of / from"},{"g":"agreement"}]},{"text":"Ce contrat est totalement ridicule.","en":"This contract is totally ridiculous.","words":[{"g":"this / it"},{"g":"contract"},{"g":"is","l":"être"},null,{"g":"ridiculous"}]},{"text":"Elle a totalement changé son personnage.","en":"She has totally changed her character.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"to exchange","l":"changer"},{"g":"his, her, its"},{"g":"character"}]},{"text":"C'est totalement normal.","en":"It's totally normal.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"normal"}]}]}