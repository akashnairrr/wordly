{"id":"suivant","lemma":"suivant","pos":"adj","rank":1188,"glosses":["next, following"],"ipa":"/sɥi.vɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2d/Fr-suivant.ogg/Fr-suivant.ogg.mp3","forms":{"feminine":"suivante","masculinePlural":"suivants","femininePlural":"suivantes"},"formAudio":{"suivante":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q150_%28fra%29-Sartus85-suivante.wav"},"examples":[{"text":"Qui sera le suivant ?","en":"Who's going to be next?","words":[{"g":"who"},{"g":"to be","l":"être"},{"g":"the / it"},null]},{"text":"Es-tu prêt pour le problème suivant ?","en":"Are you ready for the next problem?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"ready"},{"g":"for"},{"g":"the / it"},{"g":"problem"},null]},{"text":"Tourne à gauche au coin suivant.","en":"Turn left at the next corner.","words":[{"g":"to turn","l":"tourner"},null,null,null,null,null],"phrases":[[1,3,"on the left"],[3,5,"on the naughty step"]]},{"text":"Qui est le suivant sur la liste ?","en":"Who's next on the list?","words":[{"g":"who"},{"g":"is","l":"être"},{"g":"the / it"},null,{"g":"on"},{"g":"the / her"},{"g":"list"}]},{"text":"Il est mort le jour suivant.","en":"He died the next day.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"dead"},{"g":"the / it"},{"g":"day"},null]}]}