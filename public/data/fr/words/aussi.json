{"id":"aussi","lemma":"aussi","pos":"adv","rank":73,"glosses":["too, also, as well","as (used for equal comparisons)"],"ipa":"/o.si/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/63/Fr-aussi.ogg/Fr-aussi.ogg.mp3","examples":[{"text":"Peut-on venir aussi ?","en":"Can we come, too?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"we / one"},{"g":"to come"},null]},{"text":"Je peux venir avec toi aussi ?","en":"Can I come with you, too?","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to come"},{"g":"with"},{"g":"you"},null]},{"text":"Je le pense aussi.","en":"I think so, too.","audio":"https://tatoeba.org/en/audio/download/12280","words":[{"g":"I"},{"g":"the / it"},{"g":"to think","l":"penser"},null]},{"text":"Je dois manger, aussi.","en":"I have to eat, too.","audio":"https://tatoeba.org/en/audio/download/12323","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"to eat"},null]},{"text":"Cela est vrai aussi.","en":"That's true as well.","audio":"https://tatoeba.org/en/audio/download/1092976","words":[{"g":"that"},{"g":"is","l":"être"},{"g":"true"},null]}]}