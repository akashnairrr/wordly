{"id":"onze","lemma":"onze","pos":"num","rank":3414,"glosses":["eleven"],"ipa":"/ɔ̃z/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6c/Fr-onze.ogg/Fr-onze.ogg.mp3","examples":[{"text":"Il est déjà onze heures.","en":"It's already 11.","audio":"https://tatoeba.org/en/audio/download/79163","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"already, before"},null,{"g":"hour, time","l":"heure"}]},{"text":"Onze est un nombre premier.","en":"Eleven is a prime number.","words":[null,{"g":"is","l":"être"},{"g":"a"},null,null],"phrases":[[3,5,"prime number"]]},{"text":"Cette maison compte onze pièces.","en":"This house has eleven rooms.","words":[{"g":"it, this, that","l":"ce"},{"g":"house, home"},{"g":"account"},null,{"g":"room in a house, etc.","l":"pièce"}]},{"text":"Je suis un garçon de onze ans.","en":"I'm an eleven-year-old boy.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"a"},{"g":"boy"},{"g":"of / from"},null,{"g":"year","l":"an"}]},{"text":"Il y a onze pièces dans cette maison.","en":"There are eleven rooms in this house.","words":[null,null,null,null,{"g":"room in a house, etc.","l":"pièce"},{"g":"in"},{"g":"it, this, that","l":"ce"},{"g":"house, home"}],"phrases":[[0,3,"ago"]]}]}