{"id":"remarque","lemma":"remarque","pos":"noun","rank":2367,"glosses":["remark (comment, something said)"],"ipa":"/ʁə.maʁk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/78/Fr-remarque.ogg/Fr-remarque.ogg.mp3","gender":"f","forms":{"plural":"remarques"},"formAudio":{"remarques":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q150_%28fra%29-Lyoko%C3%AF-remarques.wav"},"examples":[{"text":"Ta remarque est hors-sujet.","en":"Your remark is irrelevant.","words":[{"g":"your"},null,{"g":"is","l":"être"},null,null],"phrases":[[3,5,"off-topic"]]},{"text":"Sa remarque était vraiment hors de propos.","en":"His remark was really out of line.","words":[{"g":"his"},null,{"g":"to be","l":"être"},{"g":"truly"},null,null,null],"phrases":[[4,7,"beside the point"]]},{"text":"C'est une bonne remarque.","en":"That's a good point.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},{"g":"good","l":"bon"},null]},{"text":"Puis-je faire une remarque ?","en":"Can I make one observation?","words":[{"g":"then"},{"g":"I"},{"g":"to do"},{"g":"a"},null]},{"text":"Je ne remarque aucune différence.","en":"I don't notice any difference.","words":[{"g":"I"},{"g":"not"},null,{"g":"none, no-one","l":"aucun"},{"g":"difference"}]}]}