{"id":"parfois","lemma":"parfois","pos":"adv","rank":368,"glosses":["sometimes"],"ipa":"/paʁ.fwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/Fr-parfois.ogg/Fr-parfois.ogg.mp3","examples":[{"text":"Ils font ça parfois.","en":"They do that sometimes.","words":[{"g":"they"},{"g":"to do","l":"faire"},{"g":"that"},null]},{"text":"Je rêve parfois de ma mère.","en":"I sometimes dream of my mother.","words":[{"g":"I"},{"g":"dream"},null,{"g":"of / from"},{"g":"my","l":"mon"},{"g":"mother"}]},{"text":"Je déteste mon boulot, parfois.","en":"I hate my job sometimes.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"my"},{"g":"work"},null]},{"text":"Je parle parfois français.","en":"I speak French sometimes.","words":[{"g":"I"},{"g":"to speak, talk","l":"parler"},null,{"g":"French"}]},{"text":"La vie peut parfois être difficile.","en":"Life can sometimes be difficult.","words":[{"g":"the / her"},{"g":"life"},{"g":"can, to be able to","l":"pouvoir"},null,{"g":"to be"},{"g":"difficult"}]}]}