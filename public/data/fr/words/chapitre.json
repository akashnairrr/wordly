{"id":"chapitre","lemma":"chapitre","pos":"noun","rank":2550,"glosses":["chapter","subject, issue"],"ipa":"/ʃa.pitʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2a/Fr-chapitre.ogg/Fr-chapitre.ogg.mp3","gender":"m","forms":{"plural":"chapitres"},"formAudio":{"chapitres":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q150_%28fra%29-0x010C-chapitres.wav"},"examples":[{"text":"Commençons par le premier chapitre.","en":"Let's begin with the first chapter.","words":[{"g":"to begin, commence","l":"commencer"},{"g":"through"},{"g":"the / it"},{"g":"first"},null]},{"text":"Lisez le chapitre trois.","en":"Read chapter three.","words":[{"g":"to read","l":"lire"},{"g":"the / it"},null,{"g":"three"}]},{"text":"Je ne lis que les trois premiers chapitres.","en":"I only read the first three chapters.","words":[{"g":"I"},{"g":"not"},{"g":"lily"},{"g":"that / what"},{"g":"the / them","l":"le"},{"g":"three"},{"g":"first","l":"premier"},null]},{"text":"Je vais traiter le problème dans ce chapitre.","en":"I'm going to deal with the problem in this chapter.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to treat"},{"g":"the / it"},{"g":"problem"},{"g":"in"},{"g":"this / it"},null]},{"text":"Saute les chapitres ennuyeux.","en":"Skip the boring chapters.","words":[{"g":"to jump, leap","l":"sauter"},{"g":"the / them","l":"le"},null,{"g":"dull"}]}]}