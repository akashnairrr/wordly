{"id":"balance","lemma":"balance","pos":"noun","rank":1960,"glosses":["scales","balance","drop-net"],"ipa":"/ba.lɑ̃s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/Fr-balance.ogg/Fr-balance.ogg.mp3","gender":"f","forms":{"plural":"balances"},"formAudio":{"balances":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q150_%28fra%29-DenisdeShawi-balances.wav"},"examples":[{"text":"Je suis pas une balance.","en":"I'm not a snitch.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"not"},{"g":"a"},null]},{"text":"Montez sur la balance.","en":"Step on the scale.","words":[{"g":"to go up, to climb","l":"monter"},{"g":"on"},{"g":"the / her"},null]},{"text":"On s’en balance.","en":"We don't care.","words":[{"g":"we / one"},{"g":"oneself / if"},{"g":"in / of it"},null]},{"text":"Balance ton bras d'avant en arrière.","en":"Swing your arm back and forth.","words":[null,{"g":"your"},{"g":"arm"},{"g":"of / from"},{"g":"before"},null,null],"phrases":[[5,7,"backward"]]},{"text":"Pouvez-vous vous mettre sur la balance, s'il vous plaît ?","en":"Can you stand on the scale, please?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"you"},{"g":"to put"},{"g":"on"},{"g":"the / her"},null,{"g":"oneself / if"},{"g":"he / it"},{"g":"you"},{"g":"to please","l":"plaire"}]}]}