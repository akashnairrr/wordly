{"id":"dix","lemma":"dix","pos":"num","rank":514,"glosses":["ten"],"ipa":"/dis/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/99/Fr-dix.ogg/Fr-dix.ogg.mp3","examples":[{"text":"Elle a dix enfants.","en":"She has ten children.","audio":"https://tatoeba.org/en/audio/download/28832","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"child","l":"enfant"}]},{"text":"Je reviens à dix heures.","en":"I'll be back at ten.","audio":"https://tatoeba.org/en/audio/download/25331","words":[{"g":"I"},{"g":"to come back","l":"revenir"},{"g":"to / at"},null,{"g":"hour, time","l":"heure"}]},{"text":"Peux-tu attendre dix minutes ?","en":"Can you wait ten minutes?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to wait for, to await"},null,{"g":"minute","l":"minute"}]},{"text":"Donne-moi dix minutes.","en":"Give me ten minutes.","words":[{"g":"to give","l":"donner"},{"g":"me"},null,{"g":"minute","l":"minute"}]},{"text":"Je serai prête dans dix minutes.","en":"I'll be ready in ten minutes.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"ready","l":"prêt"},{"g":"in"},null,{"g":"minute","l":"minute"}]}]}