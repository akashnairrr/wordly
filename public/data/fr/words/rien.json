{"id":"rien","lemma":"rien","pos":"pron","rank":57,"glosses":["nothing"],"ipa":"/ʁjɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/Fr-rien.ogg/Fr-rien.ogg.mp3","examples":[{"text":"Je ne peux rien faire.","en":"I can't do anything.","audio":"https://tatoeba.org/en/audio/download/33775","words":[{"g":"I"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},null,{"g":"to do"}]},{"text":"Sans toi je ne suis rien.","en":"Without you, I am nothing.","words":[{"g":"without"},{"g":"you"},{"g":"I"},{"g":"not"},{"g":"am","l":"être"},null]},{"text":"Ne pouvez-vous rien nous dire ?","en":"Can't you tell us anything?","words":[{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},null,{"g":"we / us"},{"g":"to say, to tell"}]},{"text":"Je ne leur ai rien donné.","en":"I didn't give them anything.","audio":"https://tatoeba.org/en/audio/download/334574","words":[{"g":"I"},{"g":"not"},{"g":"them"},{"g":"have","l":"avoir"},null,{"g":"to give","l":"donner"}]},{"text":"Tu peux l'avoir pour rien.","en":"You can have it for nothing.","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"the / it"},{"g":"to have"},{"g":"for"},null]}]}