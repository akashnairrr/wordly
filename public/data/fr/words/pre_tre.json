{"id":"pre_tre","lemma":"prêtre","pos":"noun","rank":1594,"glosses":["priest"],"ipa":"/pʁɛtʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b1/Fr-pr%C3%AAtre.ogg/Fr-pr%C3%AAtre.ogg.mp3","gender":"m","forms":{"plural":"prêtres","feminine":"prêtresse"},"formAudio":{"prêtres":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q150_%28fra%29-Eihel-pr%C3%AAtres.wav","prêtresse":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-pr%C3%AAtresse.wav"},"examples":[{"text":"Mon frère est devenu prêtre.","en":"My brother has become a priest.","words":[{"g":"my"},{"g":"brother"},{"g":"is","l":"être"},{"g":"to become","l":"devenir"},null]},{"text":"Je suis prêtre.","en":"I'm a priest.","words":[{"g":"I"},{"g":"am","l":"être"},null]},{"text":"Le prêtre les déclara mari et femme.","en":"The priest pronounced them man and wife.","words":[{"g":"the / it"},null,{"g":"the / them","l":"le"},{"g":"to declare","l":"déclarer"},{"g":"husband"},{"g":"and"},{"g":"woman"}]},{"text":"Les prêtres n'ont pas d'épouses.","en":"Priests don't have wives.","words":[{"g":"the / them","l":"le"},null,{"g":"not"},{"g":"to have","l":"avoir"},{"g":"not"},{"g":"of / from"},{"g":"female spouse, wife","l":"épouse"}]},{"text":"Le prêtre qui parle français sera là la semaine prochaine.","en":"The priest who speaks French will be here next week.","words":[{"g":"the / it"},null,null,null,{"g":"French"},{"g":"to be","l":"être"},{"g":"there"},{"g":"the / her"},{"g":"week"},{"g":"upcoming","l":"prochain"}],"phrases":[[2,4,"look who's talking!…"]]}]}