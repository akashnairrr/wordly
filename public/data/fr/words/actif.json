{"id":"actif","lemma":"actif","pos":"noun","rank":3754,"glosses":["asset","active","top"],"ipa":"/ak.tif/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b2/Fr-actif.ogg/Fr-actif.ogg.mp3","gender":"m","forms":{"plural":"actifs"},"formAudio":{"actifs":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q150_%28fra%29-Pamputt-actifs.wav"},"examples":[{"text":"Nous sommes un groupe actif.","en":"We're an active group.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"a"},{"g":"group"},null]},{"text":"Nous sommes toujours actifs.","en":"We're still active.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"always"},null]},{"text":"Il est actif et en forme.","en":"He's active and fit.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"and"},null,null],"phrases":[[4,6,"in form, on form"]]},{"text":"Certains animaux sont très actifs de nuit.","en":"Some animals are very active at night.","words":[{"g":"certain, guaranteed","l":"certain"},{"g":"animal","l":"animal"},{"g":"to be","l":"être"},{"g":"very"},null,null,null],"phrases":[[5,7,"at night"]]},{"text":"Il est actif dans l'enseignement.","en":"He is engaged in teaching.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"in"},{"g":"the / it"},{"g":"education, teaching"}]}]}