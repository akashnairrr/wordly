{"id":"exactement","lemma":"exactement","pos":"adv","rank":328,"glosses":["exactly, quite"],"ipa":"/ɛɡ.zak.tə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/86/Fr-exactement.ogg/Fr-exactement.ogg.mp3","examples":[{"text":"Où es-tu, exactement ?","en":"Where exactly are you?","words":[{"g":"where"},{"g":"are","l":"être"},{"g":"you"},null]},{"text":"Que savez-vous exactement ?","en":"What exactly do you know?","words":[{"g":"that / what"},{"g":"to know","l":"savoir"},{"g":"you"},null]},{"text":"Pourquoi fais-tu ça exactement ?","en":"Why exactly do you do that?","words":[{"g":"why"},{"g":"to do","l":"faire"},{"g":"you"},{"g":"that"},null]},{"text":"Je sais exactement quoi faire.","en":"I know just what to do.","words":[{"g":"I"},{"g":"to know","l":"savoir"},null,{"g":"what"},{"g":"to do"}]},{"text":"Tu feras exactement comme je dis.","en":"You'll do exactly as I say.","words":[{"g":"you"},{"g":"to do","l":"faire"},null,{"g":"as"},{"g":"I"},{"g":"to say, to tell","l":"dire"}]}]}