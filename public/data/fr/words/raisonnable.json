{"id":"raisonnable","lemma":"raisonnable","pos":"adj","rank":1965,"glosses":["reasonable, just, fair, consistent, sensible","possessed of reason","resigned"],"ipa":"/ʁɛ.zɔ.nabl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/78/Fr-raisonnable.ogg/Fr-raisonnable.ogg.mp3","forms":{"plural":"raisonnables"},"examples":[{"text":"Je suis raisonnable.","en":"I'm reasonable.","audio":"https://tatoeba.org/en/audio/download/214203","words":[{"g":"I"},{"g":"am","l":"être"},null]},{"text":"Maintenant, sois raisonnable.","en":"Now be sensible.","audio":"https://tatoeba.org/en/audio/download/1095558","words":[{"g":"now, currently"},{"g":"to be","l":"être"},null]},{"text":"Vous êtes raisonnables.","en":"You're wise.","audio":"https://tatoeba.org/en/audio/download/474824","words":[{"g":"you"},{"g":"to be","l":"être"},null]},{"text":"Ici, les prix sont très raisonnables.","en":"The prices here are very reasonable.","words":[{"g":"here"},{"g":"the / them","l":"le"},{"g":"prize"},{"g":"to be","l":"être"},{"g":"very"},null]},{"text":"Tu devrais être plus raisonnable.","en":"You should be more reasonable.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to be"},{"g":"more / no longer"},null]}]}