":"never"}]},{"text":"Ne me refais jamais ça.","en":"Don't ever do that to me again.","words":[{"g":"not"},{"g":"me"},null,{"g":"never"},{"g":"that"}]},{"text":"Vous devez refaire ça.","en":"You must do that again.","words":[{"g":"you"},{"g":"must","l":"devoir"},null,{"g":"that"}]}]}