{"id":"fore_t","lemma":"forêt","pos":"noun","rank":1399,"glosses":["forest"],"ipa":"/fɔ.ʁɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fa/Fr-for%C3%AAt.ogg/Fr-for%C3%AAt.ogg.mp3","gender":"f","forms":{"plural":"forêts"},"formAudio":{"forêts":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q150_%28fra%29-WikiLucas00-for%C3%AAts.wav"},"examples":[{"text":"Nous sommes dans la forêt.","en":"We're in the forest.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"in"},{"g":"the / her"},null]},{"text":"Je me suis perdu dans la forêt.","en":"I got lost in the forest.","words":[{"g":"I"},{"g":"me"},{"g":"am","l":"être"},{"g":"lost"},{"g":"in"},{"g":"the / her"},null]},{"text":"La forêt est très épaisse.","en":"The forest is very thick.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"very"},{"g":"thickly","l":"épais"}]},{"text":"Il a vécu seul dans la forêt.","en":"He lived alone in the forest.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"experience"},{"g":"alone"},{"g":"in"},{"g":"the / her"},null]},{"text":"Je marche dans la forêt tous les jours.","en":"I walk in the forest every day.","words":[{"g":"I"},{"g":"to walk","l":"marcher"},{"g":"in"},{"g":"the / her"},null,null,null,null],"phrases":[[5,8,"daily"]]}]}