{"id":"pourquoi","lemma":"pourquoi","pos":"adv","rank":54,"glosses":["why"],"ipa":"/puʁ.kwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/Fr-Pourquoi.ogg/Fr-Pourquoi.ogg.mp3","examples":[{"text":"Sais-tu pourquoi ?","en":"Do you know why?","audio":"https://tatoeba.org/en/audio/download/351711","words":[{"g":"to know","l":"savoir"},{"g":"you"},null]},{"text":"Savez-vous pourquoi ?","en":"Do you know why?","audio":"https://tatoeba.org/en/audio/download/351712","words":[{"g":"to know","l":"savoir"},{"g":"you"},null]},{"text":"Pourquoi es-tu seul ?","en":"Why are you alone?","audio":"https://tatoeba.org/en/audio/download/36888","words":[null,{"g":"are","l":"être"},{"g":"you"},{"g":"alone"}]},{"text":"Dieu sait pourquoi.","en":"God knows why.","words":[null,null,null],"phrases":[[0,2,"God knows …"]]},{"text":"Maintenant, je sais pourquoi.","en":"I now know why.","words":[{"g":"now, currently"},{"g":"I"},{"g":"to know","l":"savoir"},null]}]}