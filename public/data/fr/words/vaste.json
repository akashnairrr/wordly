{"id":"vaste","lemma":"vaste","pos":"adj","rank":3908,"glosses":["vast"],"ipa":"/vast/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9b/Fr-vaste.ogg/Fr-vaste.ogg.mp3","forms":{"plural":"vastes"},"formAudio":{"vastes":"https://upload.wikimedia.org/wikipedia/commons/c/c3/LL-Q150_%28fra%29-Lyoko%C3%AF-vastes.wav"},"examples":[{"text":"La chambre est vaste et claire.","en":"The room is spacious and light.","words":[{"g":"the / her"},{"g":"a room."},{"g":"is","l":"être"},null,{"g":"and"},{"g":"clear","l":"clair"}]},{"text":"Un vaste désert s'étendait devant nous.","en":"A vast desert lay before us.","words":[{"g":"a"},null,{"g":"deserted"},{"g":"oneself / if"},{"g":"to spread","l":"étendre"},{"g":"in front of"},{"g":"we / us"}]},{"text":"Une vaste étude clinique est en cours.","en":"A large clinical study is underway.","words":[{"g":"a"},null,{"g":"study"},{"g":"clinical"},{"g":"is","l":"être"},null,null],"phrases":[[5,7,"in progress"]]},{"text":"L'Amérique est très vaste.","en":"America is very big.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"very"},null]},{"text":"Les États-Unis sont un vaste pays.","en":"The United States is a large country.","words":[{"g":"the / them","l":"le"},{"g":"state, condition","l":"état"},{"g":"to unite, join","l":"unir"},{"g":"to be","l":"être"},{"g":"a"},null,{"g":"land"}]}]}