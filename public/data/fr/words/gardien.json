{"id":"gardien","lemma":"gardien","pos":"noun","rank":1515,"glosses":["guard (someone who keeps guard of something)","guardian, warden (protector)","guardian (someone who looks after something else)"],"ipa":"/ɡaʁ.djɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/80/Fr-gardien.ogg/Fr-gardien.ogg.mp3","gender":"m","forms":{"plural":"gardiens","feminine":"gardienne"},"formAudio":{"gardienne":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q150_%28fra%29-DenisdeShawi-gardienne.wav"},"examples":[{"text":"Je suis ton ange gardien.","en":"I'm your guardian angel.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"your"},{"g":"angel"},null]},{"text":"Crois-tu aux anges gardiens ?","en":"Do you believe in guardian angels?","words":[{"g":"to believe","l":"croire"},{"g":"you"},{"g":"to the"},{"g":"angel","l":"ange"},null]},{"text":"Suis-je le gardien de mon frère ?","en":"Am I my brother's keeper?","words":[{"g":"am","l":"être"},{"g":"I"},{"g":"the / it"},null,{"g":"of / from"},{"g":"my"},{"g":"brother"}]},{"text":"Je travaille comme gardien de musée.","en":"I work as a museum attendant.","words":[{"g":"I"},{"g":"to work","l":"travailler"},{"g":"as"},null,{"g":"of / from"},{"g":"museum"}]},{"text":"Les gardiens de nuit boivent beaucoup de café.","en":"Night watchmen drink a lot of coffee.","words":[{"g":"the / them","l":"le"},null,null,null,{"g":"to drink","l":"boire"},{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"coffee"}],"phrases":[[2,4,"at night"]]}]}