{"id":"souhait","lemma":"souhait","pos":"noun","rank":3837,"glosses":["wish (desire; aspiration)"],"ipa":"/swɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c6/Fr-souhait.ogg/Fr-souhait.ogg.mp3","gender":"m","forms":{"plural":"souhaits"},"formAudio":{"souhaits":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q150_%28fra%29-Eihel-souhaits.wav"},"examples":[{"text":"Fais un souhait !","en":"Make a wish.","audio":"https://tatoeba.org/en/audio/download/474662","words":[{"g":"to do","l":"faire"},{"g":"a"},null]},{"text":"Quel est votre souhait ?","en":"What's your wish?","words":[{"g":"which"},{"g":"is","l":"être"},{"g":"your, belonging to you"},null]},{"text":"À tes souhaits !","en":"Bless you.","audio":"https://tatoeba.org/en/audio/download/472690","words":[{"g":"to / at"},{"g":"your"},null]},{"text":"Mon souhait s'est enfin réalisé.","en":"My wish has finally come true.","words":[{"g":"my"},null,{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"finally"},{"g":"to direct","l":"réaliser"}]},{"text":"J'espère que vos souhaits se réaliseront.","en":"I hope your wishes will come true.","words":[{"g":"I"},{"g":"to hope","l":"espérer"},{"g":"that / what"},{"g":"your, belonging to you","l":"votre"},null,{"g":"oneself"},{"g":"to direct","l":"réaliser"}]}]}