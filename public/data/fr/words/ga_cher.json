{"id":"ga_cher","lemma":"gâcher","pos":"verb","rank":1799,"glosses":["to ruin, spoil, mar, wreck, waste","to mess up, botch, bungle"],"ipa":"/ɡa.ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/19/Fr-g%C3%A2cher.ogg/Fr-g%C3%A2cher.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"gâche","2s":"gâches","3s":"gâche","1p":"gâchons","2p":"gâchez","3p":"gâchent"},"imperfect":{"1s":"gâchais","2s":"gâchais","3s":"gâchait","1p":"gâchions","2p":"gâchiez","3p":"gâchaient"},"preterite":{"1s":"gâchai","2s":"gâchas","3s":"gâcha","1p":"gâchâmes","2p":"gâchâtes","3p":"gâchèrent"},"future":{"1s":"gâcherai","2s":"gâcheras","3s":"gâchera","1p":"gâcherons","2p":"gâcherez","3p":"gâcheront"},"conditional":{"1s":"gâcherais","2s":"gâcherais","3s":"gâcherait","1p":"gâcherions","2p":"gâcheriez","3p":"gâcheraient"},"perfect":{"1s":"ai gâché","2s":"as gâché","3s":"a gâché","1p":"avons gâché","2p":"avez gâché","3p":"ont gâché"}},"subjunctive":{"present":{"1s":"gâche","2s":"gâches","3s":"gâche","1p":"gâchions","2p":"gâchiez","3p":"gâchent"},"imperfect":{"1s":"gâchasse","2s":"gâchasses","3s":"gâchât","1p":"gâchassions","2p":"gâchassiez","3p":"gâchassent"}},"imperative":{"affirmative":{"2s":"gâche","1p":"gâchons","2p":"gâchez"}}},"nonFinite":{"gerund":"gâchant","participle":"gâché"},"formAudio":{"gâche":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q150_%28fra%29-WikiLucas00-g%C3%A2che.wav"},"examples":[{"text":"Ça serait gâcher son talent.","en":"That would be a waste of her talent.","words":[{"g":"that"},{"g":"to be","l":"être"},null,{"g":"his, her, its"},{"g":"a talent"}]},{"text":"Nous gâchons beaucoup de temps.","en":"We waste a lot of time.","words":[{"g":"we / us"},null,{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"time"}]},{"text":"Tu vas tout gâcher.","en":"You'll ruin everything.","words":[{"g":"you"},{"g":"to go","l":"aller"},{"g":"all"},null]},{"text":"Je ne voulais pas le gâcher.","en":"I didn't want to waste it.","words":[{"g":"I"},{"g