{"id":"car","lemma":"car","pos":"conj","rank":233,"glosses":["as, since, because, for"],"ipa":"/kaʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ea/Fr-car.ogg/Fr-car.ogg.mp3","examples":[{"text":"Je voulais louer un car.","en":"I wanted to rent a bus.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to rent"},{"g":"a"},null]},{"text":"Nous affrétâmes un car.","en":"We chartered a bus.","words":[{"g":"we / us"},null,{"g":"a"},null]},{"text":"Y vas-tu en car ou en voiture ?","en":"Are you going by bus or car?","words":[{"g":"there"},{"g":"to go","l":"aller"},{"g":"you"},{"g":"in / of it"},null,{"g":"or"},{"g":"in / of it"},{"g":"car"}]},{"text":"Ce car s'arrête devant chez moi.","en":"That bus stops in front of my house.","words":[{"g":"this / it"},null,{"g":"oneself / if"},{"g":"to stop","l":"arrêter"},{"g":"in front of"},{"g":"to"},{"g":"me"}]},{"text":"Je le fais car j'en ai envie.","en":"I do it because I want to.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},null,{"g":"I"},{"g":"in / of it"},{"g":"have","l":"avoir"},{"g":"desire, urge"}]}]}