{"id":"parcouru","lemma":"parcouru","pos":"adj","rank":4474,"glosses":["browsed, skimmed"],"ipa":"/paʁ.ku.ʁy/","forms":{"feminine":"parcourue","masculinePlural":"parcourus","femininePlural":"parcourues"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q150_%28fra%29-Sartus85-parcouru.wav","examples":[{"text":"J'ai parcouru le rapport.","en":"I skimmed the report.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"the / it"},{"g":"report"}]},{"text":"Quelle distance avons-nous parcourue ?","en":"How much distance have we covered?","words":[{"g":"which?"},{"g":"distance"},{"g":"to have","l":"avoir"},{"g":"we / us"},null]},{"text":"Il a parcouru mon rapport.","en":"He looked over my report.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"my"},{"g":"report"}]},{"text":"On a parcouru un sacré chemin.","en":"We've come a long way.","words":[{"g":"we / one"},{"g":"has","l":"avoir"},null,{"g":"a"},{"g":"sacred, holy"},{"g":"path, way, road"}]},{"text":"J'ai parcouru un long chemin pour vous voir.","en":"I've come a long way to see you.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"a"},{"g":"long"},{"g":"path, way, road"},{"g":"for"},{"g":"you"},{"g":"to see"}]}]}