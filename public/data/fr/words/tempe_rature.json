{"id":"tempe_rature","lemma":"température","pos":"noun","rank":2100,"glosses":["temperature"],"ipa":"/tɑ̃.pe.ʁa.tyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ae/Fr-temp%C3%A9rature.ogg/Fr-temp%C3%A9rature.ogg.mp3","gender":"f","forms":{"plural":"températures"},"formAudio":{"températures":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q150_%28fra%29-Lyoko%C3%AF-temp%C3%A9ratures.wav"},"examples":[{"text":"As-tu pris ta température ?","en":"Have you taken your temperature?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to take","l":"prendre"},{"g":"your"},null]},{"text":"Je peux vérifier votre température ?","en":"Can I check your temperature?","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to check, to verify"},{"g":"your, belonging to you"},null]},{"text":"Laisse-moi prendre ta température.","en":"Let me take your temperature.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},{"g":"to take"},{"g":"your"},null]},{"text":"Avez-vous de la température ?","en":"Do you have a temperature?","words":[{"g":"to have","l":"avoir"},{"g":"you"},null,null,null],"phrases":[[2,4,"of the"]]},{"text":"Il me faut prendre ta température.","en":"I need to take your temperature.","words":[{"g":"he / it"},{"g":"me"},{"g":"to need","l":"falloir"},{"g":"to take"},{"g":"your"},null]}]}