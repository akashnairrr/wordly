{"id":"gentiment","lemma":"gentiment","pos":"adv","rank":3036,"glosses":["friendly, kindly (in a friendly or kind manner)"],"ipa":"/ʒɑ̃.ti.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/20/Fr-gentiment.ogg/Fr-gentiment.ogg.mp3","examples":[{"text":"Il a gentiment répondu aux questions.","en":"He kindly answered questions.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"to reply, to answer","l":"répondre"},{"g":"to the"},{"g":"question","l":"question"}]},{"text":"Il a gentiment répondu à la question.","en":"He kindly answered the question.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"to reply, to answer","l":"répondre"},null,null,{"g":"question"}],"phrases":[[4,6,"a la"]]},{"text":"La fille traitait son cheval gentiment.","en":"The girl treated her horse kindly.","words":[{"g":"the / her"},{"g":"girl"},{"g":"to treat","l":"traiter"},{"g":"his, her, its"},{"g":"horse"},null]},{"text":"Il me poussa gentiment.","en":"He pushed me gently.","words":[{"g":"he / it"},{"g":"me"},{"g":"to push","l":"pousser"},null]},{"text":"Elle a gentiment écouté ma requête.","en":"She kindly listened to my request.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"to listen","l":"écouter"},{"g":"my","l":"mon"},{"g":"request"}]}]}