{"id":"renfort","lemma":"renfort","pos":"noun","rank":2285,"glosses":["reinforcement","backup, help"],"ipa":"/ʁɑ̃.fɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/Fr-Paris--renfort.ogg/Fr-Paris--renfort.ogg.mp3","gender":"m","forms":{"plural":"renforts"},"examples":[{"text":"Envoie des renforts !","en":"Send reinforcements.","words":[{"g":"to send","l":"envoyer"},{"g":"some / of the","l":"un"},null]},{"text":"Je vais avoir besoin de renfort.","en":"I'm going to need some backup.","words":[{"g":"I"},{"g":"to go","l":"aller"},null,null,null,null],"phrases":[[2,5,"to need"]]},{"text":"Ils ont demandé des renforts.","en":"They called for reinforcements.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"to ask","l":"demander"},{"g":"some / of the","l":"un"},null]},{"text":"Le policier a demandé du renfort.","en":"The police officer called for backup.","words":[{"g":"the / it"},{"g":"policeman"},{"g":"has","l":"avoir"},{"g":"to ask","l":"demander"},{"g":"of the / some"},null]},{"text":"J'ai apporté des renforts.","en":"I brought reinforcements.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to bring","l":"apporter"},{"g":"some / of the","l":"un"},null]}]}