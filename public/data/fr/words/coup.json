{"id":"coup","lemma":"coup","pos":"noun","rank":211,"glosses":["blow, hit","go, shot (un coup de …)"],"ipa":"/ku/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e3/Fr-coup.ogg/Fr-coup.ogg.mp3","gender":"m","forms":{"plural":"coups"},"formAudio":{"coups":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q150_%28fra%29-Mecanautes-coups.wav"},"examples":[{"text":"Passe-moi un coup de main.","en":"Lend me a hand.","audio":"https://tatoeba.org/en/audio/download/249646","words":[{"g":"to pass","l":"passer"},{"g":"me"},{"g":"a"},null,{"g":"of / from"},{"g":"hand"}]},{"text":"Je vais tenter le coup.","en":"I'll give it a go.","audio":"https://tatoeba.org/en/audio/download/240401","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to attempt"},{"g":"the / it"},null]},{"text":"J'ai entendu des coups de feu.","en":"I heard some shots.","audio":"https://tatoeba.org/en/audio/download/1097937","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to hear","l":"entendre"},{"g":"some / of the","l":"un"},null,{"g":"of / from"},{"g":"fire"}]},{"text":"Veux-tu boire un coup avec nous ?","en":"Do you want to have a drink with us?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to drink"},{"g":"a"},null,{"g":"with"},{"g":"we / us"}]},{"text":"C'est un coup bas.","en":"That's a low blow.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null,{"g":"low"}]}]}