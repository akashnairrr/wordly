{"id":"contre","lemma":"contre","pos":"prep","rank":210,"glosses":["against (in physical contact with)","against (not in favor of)","against (having as an opponent)"],"ipa":"/kɔ̃tʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/40/Fr-contre.ogg/Fr-contre.ogg.mp3","examples":[{"text":"Êtes-vous pour ou contre ?","en":"Are you for or against it?","words":[{"g":"to be","l":"être"},{"g":"you"},{"g":"for"},{"g":"or"},null]},{"text":"Le meurtre est contre la loi.","en":"Murder is against the law.","words":[{"g":"the / it"},{"g":"murder"},{"g":"is","l":"être"},null,{"g":"the / her"},{"g":"law"}]},{"text":"Je parie contre lui.","en":"I bid against him.","audio":"https://tatoeba.org/en/audio/download/2744","words":[{"g":"I"},{"g":"to bet","l":"parier"},null,{"g":"him, he, it"}]},{"text":"Es-tu avec nous ou contre nous ?","en":"Are you with us or against us?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"with"},{"g":"we / us"},{"g":"or"},null,{"g":"we / us"}]},{"text":"Es-tu pour ou contre la guerre ?","en":"Are you for or against the war?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"for"},{"g":"or"},null,{"g":"the / her"},{"g":"war"}]}]}