{"id":"surtout","lemma":"surtout","pos":"adv","rank":452,"glosses":["above all","especially"],"ipa":"/syʁ.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/Fr-surtout.ogg/Fr-surtout.ogg.mp3","examples":[{"text":"Surtout, soyez patient.","en":"Above all, be patient.","words":[null,{"g":"to be","l":"être"},{"g":"patient"}]},{"text":"J'aime la musique, surtout classique.","en":"I love music, particularly classical.","words":[{"g":"I"},{"g":"to love","l":"aimer"},{"g":"the / her"},{"g":"music"},null,{"g":"classic"}]},{"text":"Je déteste surtout les maths.","en":"I hate math most of all.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},null,{"g":"the / them","l":"le"},{"g":"math or maths (study of…"}]},{"text":"Surtout, il faut vous entraider.","en":"Above all, you must help each other.","words":[null,{"g":"he / it"},{"g":"to need","l":"falloir"},{"g":"you"},{"g":"to help one another"}]},{"text":"Surtout, n'oublie pas de m'écrire.","en":"Above all, don't forget to write me.","words":[null,{"g":"not"},{"g":"to forget","l":"oublier"},{"g":"not"},{"g":"of / from"},{"g":"me"},{"g":"to write"}]}]}