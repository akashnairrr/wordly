{"id":"pouls","lemma":"pouls","pos":"noun","rank":2108,"glosses":["pulse (regular beat caused by the heart)"],"ipa":"/pu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/Fr-pouls.ogg/Fr-pouls.ogg.mp3","gender":"m","examples":[{"text":"Ton pouls est normal.","en":"Your pulse is normal.","audio":"https://tatoeba.org/en/audio/download/33788","words":[{"g":"your"},null,{"g":"is","l":"être"},{"g":"normal"}]},{"text":"Mon pouls est rapide.","en":"My pulse is fast.","words":[{"g":"my"},null,{"g":"is","l":"être"},{"g":"fast, quick"}]},{"text":"Votre pouls est un peu rapide.","en":"Your pulse is a little fast.","words":[{"g":"your, belonging to you"},null,{"g":"is","l":"être"},null,null,{"g":"fast, quick"}],"phrases":[[3,5,"a little, a bit"]]},{"text":"Je dois vous prendre le pouls.","en":"I need to take your pulse.","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"you"},{"g":"to take"},{"g":"the / it"},null]},{"text":"Le médecin a pris mon pouls.","en":"The doctor checked my pulse.","words":[{"g":"the / it"},{"g":"physician"},{"g":"has","l":"avoir"},{"g":"to take","l":"prendre"},{"g":"my"},null]}]}