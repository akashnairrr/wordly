{"id":"village","lemma":"village","pos":"noun","rank":880,"glosses":["village"],"ipa":"/vi.laʒ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0d/Fr-village.ogg/Fr-village.ogg.mp3","gender":"m","forms":{"plural":"villages"},"formAudio":{"villages":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q150_%28fra%29-Poslovitch-villages.wav"},"examples":[{"text":"Il habite dans un village.","en":"He lives in a village.","words":[{"g":"he / it"},{"g":"to live in, to occupy","l":"habiter"},{"g":"in"},{"g":"a"},null]},{"text":"Ils viennent du même village.","en":"They come from the same village.","words":[{"g":"they"},{"g":"to come","l":"venir"},{"g":"of the / some"},{"g":"same"},null]},{"text":"Je vis dans un petit village.","en":"I live in a small village.","words":[{"g":"I"},{"g":"to see","l":"voir"},{"g":"in"},{"g":"a"},{"g":"small, little"},null]},{"text":"Les gens vivaient dans des villages.","en":"People lived in villages.","words":[{"g":"the / them","l":"le"},{"g":"people"},{"g":"to live","l":"vivre"},{"g":"in"},{"g":"some / of the","l":"un"},null]},{"text":"Il a dû quitter le village.","en":"He had to leave the village.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"must","l":"devoir"},{"g":"to leave, to quit"},{"g":"the / it"},null]}]}