{"id":"ivre","lemma":"ivre","pos":"adj","rank":2134,"glosses":["drunk, inebriated (by alcohol)","drunk, intoxicated, overwhelmed"],"ipa":"/ivʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/50/Fr-ivre.ogg/Fr-ivre.ogg.mp3","forms":{"plural":"ivres"},"formAudio":{"ivres":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q150_%28fra%29-WikiLucas00-ivres.wav"},"examples":[{"text":"Je suis ivre.","en":"I'm drunk.","audio":"https://tatoeba.org/en/audio/download/472697","words":[{"g":"I"},{"g":"am","l":"être"},null]},{"text":"J'étais un peu ivre.","en":"I was a little drunk.","audio":"https://tatoeba.org/en/audio/download/1103037","words":[{"g":"I"},{"g":"to be","l":"être"},null,null,null],"phrases":[[2,4,"a little, a bit"]]},{"text":"Je pense que vous êtes ivres.","en":"I think you're drunk.","words":[{"g":"I"},{"g":"to think","l":"penser"},{"g":"that / what"},{"g":"you"},{"g":"to be","l":"être"},null]},{"text":"Vous étiez ivres, pas vrai ?","en":"You were drunk, weren't you?","words":[{"g":"you"},{"g":"to be","l":"être"},null,{"g":"not"},{"g":"true"}]},{"text":"Il est trop ivre.","en":"He's too drunk.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"too"},null]}]}