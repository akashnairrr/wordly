{"id":"beaucoup","lemma":"beaucoup","pos":"adv","rank":126,"glosses":["much, very much, a lot"],"ipa":"/bo.ku/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/81/Fr-beaucoup.ogg/Fr-beaucoup.ogg.mp3","examples":[{"text":"Elle parle beaucoup.","en":"She talks a lot.","audio":"https://tatoeba.org/en/audio/download/12415","words":[{"g":"she / it"},{"g":"to speak, talk","l":"parler"},null]},{"text":"Cela aide beaucoup.","en":"That helps a lot.","audio":"https://tatoeba.org/en/audio/download/222289","words":[{"g":"that"},{"g":"help, support"},null]},{"text":"Je mange beaucoup.","en":"I eat a lot.","audio":"https://tatoeba.org/en/audio/download/473959","words":[{"g":"I"},{"g":"to eat","l":"manger"},null]},{"text":"As-tu beaucoup de temps ?","en":"Do you have a lot of time?","words":[{"g":"have","l":"avoir"},{"g":"you"},null,{"g":"of / from"},{"g":"time"}]},{"text":"Avez-vous beaucoup de temps libre ?","en":"Do you have a lot of free time?","words":[{"g":"to have","l":"avoir"},{"g":"you"},null,{"g":"of / from"},null,null],"phrases":[[4,6,"free time"]]}]}