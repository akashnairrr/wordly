{"id":"lundi","lemma":"lundi","pos":"noun","rank":1383,"glosses":["Monday"],"ipa":"/lœ̃.di/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/Fr-lundi-fr-ouest.ogg/Fr-lundi-fr-ouest.ogg.mp3","gender":"m","forms":{"plural":"lundis"},"formAudio":{"lundis":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q150_%28fra%29-0x010C-lundis.wav"},"examples":[{"text":"Travaillez-vous lundi ?","en":"Do you work on Monday?","audio":"https://tatoeba.org/en/audio/download/334703","words":[{"g":"to work","l":"travailler"},{"g":"you"},null]},{"text":"Pouvons-nous plutôt le faire lundi ?","en":"Can we do it on Monday instead?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"we / us"},{"g":"rather, instead"},{"g":"the / it"},{"g":"to do"},null]},{"text":"Je déteste les lundis.","en":"I hate Mondays.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"the / them","l":"le"},null]},{"text":"Je travaille le lundi.","en":"I work on Monday.","audio":"https://tatoeba.org/en/audio/download/1092979","words":[{"g":"I"},{"g":"to work","l":"travailler"},{"g":"the / it"},null]},{"text":"Nous faisons ceci tous les lundis.","en":"We do this every Monday.","words":[{"g":"we / us"},{"g":"to do","l":"faire"},{"g":"this"},{"g":"all"},{"g":"the / them","l":"le"},null]}]}