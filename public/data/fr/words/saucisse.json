{"id":"saucisse","lemma":"saucisse","pos":"noun","rank":4021,"glosses":["sausage (hot dog style)"],"ipa":"/so.sis/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/56/Fr-saucisse.ogg/Fr-saucisse.ogg.mp3","gender":"f","forms":{"plural":"saucisses"},"formAudio":{"saucisses":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q150_%28fra%29-WikiLucas00-saucisses.wav"},"examples":[{"text":"J'aime les saucisses.","en":"I like sausage.","words":[{"g":"I"},{"g":"to love","l":"aimer"},{"g":"the / them","l":"le"},null]},{"text":"Il a laissé la saucisse tomber par terre.","en":"He dropped the sausage on the ground.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to leave","l":"laisser"},{"g":"the / her"},null,{"g":"to fall"},null,null],"phrases":[[6,8,"on the ground"]]},{"text":"Ce sont de vieilles saucisses.","en":"This is old news.","words":[{"g":"this / it"},{"g":"to be","l":"être"},{"g":"of / from"},{"g":"old","l":"vieux"},null]},{"text":"Ils ne mangent ni saucisse ni jambon.","en":"They don't eat sausage or ham.","words":[{"g":"they"},{"g":"not"},{"g":"to eat","l":"manger"},{"g":"neither"},null,{"g":"neither"},{"g":"ham"}]},{"text":"Les Allemands adorent la bière et les saucisses.","en":"Germans love beer and sausages.","words":[{"g":"the / them","l":"le"},{"g":"German","l":"allemand"},{"g":"to love, to adore","l":"adorer"},{"g":"the / her"},{"g":"beer"},{"g":"and"},{"g":"the / them","l":"le"},null]}]}