{"id":"toujours","lemma":"toujours","pos":"adv","rank":88,"glosses":["always","still"],"ipa":"/tu.ʒuʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cd/Fr-toujours.ogg/Fr-toujours.ogg.mp3","examples":[{"text":"Je marche toujours.","en":"I always walk.","audio":"https://tatoeba.org/en/audio/download/194617","words":[{"g":"I"},{"g":"to walk","l":"marcher"},null]},{"text":"On peut toujours essayer.","en":"We can always try.","audio":"https://tatoeba.org/en/audio/download/1093018","words":[{"g":"we / one"},{"g":"can, to be able to","l":"pouvoir"},null,{"g":"to test, to try on"}]},{"text":"Es-tu toujours heureuse ?","en":"Are you still happy?","audio":"https://tatoeba.org/en/audio/download/169514","words":[{"g":"are","l":"être"},{"g":"you"},null,{"g":"happy","l":"heureux"}]},{"text":"Est-ce toujours ainsi ?","en":"Is it always like this?","words":[{"g":"is","l":"être"},{"g":"this / it"},null,{"g":"in this way, thus"}]},{"text":"Comment le faites-vous toujours ?","en":"How do you always do it?","words":[{"g":"how"},{"g":"the / it"},{"g":"to do","l":"faire"},{"g":"you"},null]}]}