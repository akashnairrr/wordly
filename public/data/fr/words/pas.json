{"id":"pas","lemma":"pas","pos":"adv","rank":4,"glosses":["not (in ne … pas)","step (as a noun)"],"ipa":"/pa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e5/Fr-pas.ogg/Fr-pas.ogg.mp3","examples":[{"text":"Tu ne dois pas manger trop.","en":"You must not eat too much.","audio":"https://tatoeba.org/en/audio/download/27831","words":[{"g":"you"},{"g":"not"},{"g":"must","l":"devoir"},null,{"g":"to eat"},{"g":"too"}]},{"text":"Je n'espère pas.","en":"I hope not.","audio":"https://tatoeba.org/en/audio/download/2551","words":[{"g":"I"},{"g":"not"},{"g":"to hope","l":"espérer"},null]},{"text":"Je ne suis pas gros.","en":"I'm not fat.","audio":"https://tatoeba.org/en/audio/download/474809","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},null,{"g":"big, thick, fat"}]},{"text":"Il n'ira pas.","en":"He will not go.","audio":"https://tatoeba.org/en/audio/download/12629","words":[{"g":"he / it"},{"g":"not"},{"g":"to go","l":"aller"},null]},{"text":"Si pas maintenant, quand ?","en":"If not now, when?","words":[{"g":"if, whether"},null,{"g":"now, currently"},{"g":"when"}]}]}