{"id":"raison","lemma":"raison","pos":"noun","rank":151,"glosses":["reason (cause)","reason (mental faculties)","common difference (of an arithmetic series)"],"ipa":"/ʁɛ.zɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f0/Fr-raison.ogg/Fr-raison.ogg.mp3","gender":"f","forms":{"plural":"raisons"},"formAudio":{"raisons":"https://upload.wikimedia.org/wikipedia/commons/9/9b/LL-Q150_%28fra%29-Eihel-raisons.wav"},"examples":[{"text":"Connaissez-vous la raison ?","en":"Do you know the reason?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"the / her"},null]},{"text":"Je comprends vos raisons.","en":"I understand your reasons.","words":[{"g":"I"},{"g":"to understand","l":"comprendre"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Connais-tu la raison ?","en":"Do you know the reason?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"the / her"},null]},{"text":"Je veux juste entendre tes raisons.","en":"I just want to hear your reasons.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"fair, just"},{"g":"to hear"},{"g":"your"},null]},{"text":"Donne-moi une raison.","en":"Give me a reason.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null]}]}