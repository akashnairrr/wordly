{"id":"jouet","lemma":"jouet","pos":"noun","rank":2487,"glosses":["toy; plaything"],"ipa":"/ʒwɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/34/Fr-jouet.ogg/Fr-jouet.ogg.mp3","gender":"m","forms":{"plural":"jouets"},"formAudio":{"jouets":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q150_%28fra%29-Eihel-jouets.wav"},"examples":[{"text":"Ce jouet est fait en bois.","en":"That toy is made of wood.","audio":"https://tatoeba.org/en/audio/download/27994","words":[{"g":"this / it"},null,{"g":"is","l":"être"},{"g":"to do","l":"faire"},{"g":"in / of it"},{"g":"wood"}]},{"text":"Le bébé joue avec des jouets.","en":"The baby is playing with some toys.","words":[{"g":"the / it"},{"g":"baby"},{"g":"to play","l":"jouer"},{"g":"with"},{"g":"some / of the","l":"un"},null]},{"text":"Il adore les jouets.","en":"He loves toys.","words":[{"g":"he / it"},{"g":"to love, to adore","l":"adorer"},{"g":"the / them","l":"le"},null]},{"text":"Ce jouet est pour les garçons.","en":"This toy is for boys.","words":[{"g":"this / it"},null,{"g":"is","l":"être"},{"g":"for"},{"g":"the / them","l":"le"},{"g":"boy","l":"garçon"}]},{"text":"Merci de réparer mon jouet.","en":"Please fix my toy.","words":[{"g":"thank you"},{"g":"of / from"},{"g":"to repair, fix, mend"},{"g":"my"},null]}]}