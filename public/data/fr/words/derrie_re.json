{"id":"derrie_re","lemma":"derrière","pos":"prep","rank":332,"glosses":["behind","at the bottom of, behind (covertly responsible for)"],"ipa":"/dɛ.ʁjɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/Fr-derri%C3%A8re.ogg/Fr-derri%C3%A8re.ogg.mp3","examples":[{"text":"Restez derrière moi.","en":"Stay behind me.","words":[{"g":"to stay","l":"rester"},null,{"g":"me"}]},{"text":"Le pire est derrière nous.","en":"The worst is behind us.","words":[{"g":"the / it"},{"g":"worse, worst"},{"g":"is","l":"être"},null,{"g":"we / us"}]},{"text":"Ferme la porte derrière toi.","en":"Shut the door behind you.","words":[{"g":"to shut","l":"fermer"},{"g":"the / her"},{"g":"door"},null,{"g":"you"}]},{"text":"Êtes-vous derrière tout ceci ?","en":"Are you behind all of this?","words":[{"g":"to be","l":"être"},{"g":"you"},null,{"g":"all"},{"g":"this"}]},{"text":"Il était juste derrière moi.","en":"He was just behind me.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"fair, just"},null,{"g":"me"}]}]}