{"id":"vivant","lemma":"vivant","pos":"adj","rank":651,"glosses":["alive, living"],"ipa":"/vi.vɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/01/Fr-vivant.ogg/Fr-vivant.ogg.mp3","forms":{"feminine":"vivante","masculinePlural":"vivants","femininePlural":"vivantes"},"formAudio":{"vivante":"https://upload.wikimedia.org/wikipedia/commons/0/08/LL-Q150_%28fra%29-Poslovitch-vivante.wav","vivants":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q150_%28fra%29-WikiLucas00-vivants.wav"},"examples":[{"text":"Je suis vivant.","en":"I'm alive.","audio":"https://tatoeba.org/en/audio/download/473026","words":[{"g":"I"},{"g":"am","l":"être"},null]},{"text":"Je les veux vivants.","en":"I want them alive.","words":[{"g":"I"},{"g":"the / them","l":"le"},{"g":"to want, wish, desire","l":"vouloir"},null]},{"text":"Il est encore vivant.","en":"He is still alive.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"still"},null]},{"text":"Elle était seulement à moitié vivante.","en":"She was only half alive.","words":[{"g":"she / it"},{"g":"to be","l":"être"},{"g":"only"},null,null,null],"phrases":[[3,5,"half"]]},{"text":"Vous êtes toujours vivantes.","en":"You're still alive.","words":[{"g":"you"},{"g":"to be","l":"être"},{"g":"always"},null]}]}