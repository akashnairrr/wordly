{"id":"cour","lemma":"cour","pos":"noun","rank":822,"glosses":["courtyard,","court (of law)","court"],"ipa":"/kuʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8d/Fr-cour.ogg/Fr-cour.ogg.mp3","gender":"f","forms":{"plural":"cours"},"formAudio":{"cours":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q150_%28fra%29-WikiLucas00-cours.wav"},"examples":[{"text":"Ma maison a une petite cour.","en":"My house has a small yard.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"has","l":"avoir"},{"g":"a"},{"g":"small, little","l":"petit"},null]},{"text":"Bienvenue dans la cour des grands.","en":"Welcome to the big leagues.","words":[{"g":"welcome"},{"g":"in"},{"g":"the / her"},null,{"g":"some / of the","l":"un"},{"g":"big","l":"grand"}]},{"text":"Je veux vous faire la cour.","en":"I want to make it up to you.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to do"},{"g":"the / her"},null]},{"text":"Les toilettes étaient dehors dans la cour.","en":"The toilet was outside, in the yard.","words":[{"g":"the / them","l":"le"},{"g":"toilet, lavatory"},{"g":"to be","l":"être"},{"g":"outside"},{"g":"in"},{"g":"the / her"},null]},{"text":"C'était à peine une cour.","en":"It wasn't much of a yard.","words":[{"g":"it / that"},{"g":"to be","l":"être"},null,null,{"g":"a"},null],"phrases":[[2,4,"barely"]]}]}