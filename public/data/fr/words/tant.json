{"id":"tant","lemma":"tant","pos":"adv","rank":201,"glosses":["so much","so many","both ... and"],"ipa":"/tɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7a/Fr-tant.ogg/Fr-tant.ogg.mp3","examples":[{"text":"Ai-je tant changé ?","en":"Have I changed that much?","words":[{"g":"have","l":"avoir"},{"g":"I"},null,{"g":"to exchange","l":"changer"}]},{"text":"Nous avons tant à faire.","en":"We have so much to do.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"to / at"},{"g":"to do"}]},{"text":"J'ai tant changé que ça ?","en":"Have I changed that much?","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"to exchange","l":"changer"},{"g":"that / what"},{"g":"that"}]},{"text":"Je vous dois tant.","en":"I owe you so much.","words":[{"g":"I"},{"g":"you"},{"g":"must","l":"devoir"},null]},{"text":"J'ai tant à te montrer.","en":"I have so much to show you.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"to / at"},{"g":"you"},{"g":"to show"}]}]}