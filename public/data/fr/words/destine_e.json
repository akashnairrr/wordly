{"id":"destine_e","lemma":"destinée","pos":"noun","rank":2809,"glosses":["destiny, fate"],"ipa":"/dɛs.ti.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/Fr-destin%C3%A9e.ogg/Fr-destin%C3%A9e.ogg.mp3","gender":"f","forms":{"plural":"destinées"},"formAudio":{"destinées":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q150_%28fra%29-Sagnamadr-destin%C3%A9es.wav"},"examples":[{"text":"C'est ma destinée.","en":"This is my fate.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"my","l":"mon"},null]},{"text":"La lettre m'était destinée.","en":"The letter was addressed to me.","words":[{"g":"the / her"},{"g":"letter"},{"g":"me"},{"g":"to be","l":"être"},null]},{"text":"Nous étions destinées à nous rencontrer un jour.","en":"We were destined to meet one day.","words":[{"g":"we / us"},{"g":"to be","l":"être"},null,{"g":"to / at"},{"g":"we / us"},{"g":"to meet"},null,null],"phrases":[[6,8,"one day, someday"]]},{"text":"Tu contrôles ta destinée.","en":"You control your destiny.","words":[{"g":"you"},{"g":"control","l":"contrôle"},{"g":"your"},null]},{"text":"Mes remarques ne vous étaient pas destinées.","en":"My remarks were not aimed at you.","words":[{"g":"my"},{"g":"remark","l":"remarque"},{"g":"not"},{"g":"you"},{"g":"to be","l":"être"},{"g":"not"},null]}]}