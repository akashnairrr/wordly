{"id":"dette","lemma":"dette","pos":"noun","rank":2241,"glosses":["debt"],"ipa":"/dɛt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2b/Fr-dette.ogg/Fr-dette.ogg.mp3","gender":"f","forms":{"plural":"dettes"},"formAudio":{"dettes":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q150_%28fra%29-0x010C-dettes.wav"},"examples":[{"text":"Vous devriez payer vos dettes.","en":"You should pay your debts.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to pay"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"J'ai une dette à payer.","en":"I have a debt to pay.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"a"},null,{"g":"to / at"},{"g":"to pay"}]},{"text":"À combien se monte ma dette ?","en":"How much does my debt amount to?","words":[{"g":"to / at"},{"g":"how much"},{"g":"oneself"},{"g":"to go up, to climb","l":"monter"},{"g":"my","l":"mon"},null]},{"text":"Je voulais régler mes dettes.","en":"I wanted to pay off my debts.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to sort out, to settle"},{"g":"my"},null]},{"text":"Ma famille avait beaucoup de dettes.","en":"My family had many debts.","words":[{"g":"my","l":"mon"},{"g":"family"},{"g":"to have","l":"avoir"},{"g":"much, very much, a lot"},{"g":"of / from"},null]}]}