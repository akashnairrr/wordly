{"id":"proche","lemma":"proche","pos":"adj","rank":848,"glosses":["close, near, closeby, nearby (to a place)","close, near (a time)"],"ipa":"/pʁɔʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/ba/Fr-proche.ogg/Fr-proche.ogg.mp3","forms":{"plural":"proches"},"examples":[{"text":"Es-tu proche de ta famille ?","en":"Are you close to your family?","words":[{"g":"are","l":"être"},{"g":"you"},null,{"g":"of / from"},{"g":"your"},{"g":"family"}]},{"text":"Nous sommes des amis proches.","en":"We're close friends.","audio":"https://tatoeba.org/en/audio/download/215663","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"some / of the","l":"un"},{"g":"friend","l":"ami"},null]},{"text":"Il est proche du président.","en":"He is close to the president.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"of the / some"},{"g":"president"}]},{"text":"Êtes-vous proches de votre famille ?","en":"Are you close to your family?","words":[{"g":"to be","l":"être"},{"g":"you"},null,{"g":"of / from"},{"g":"your, belonging to you"},{"g":"family"}]},{"text":"Combien d'amis proches avez-vous ?","en":"How many close friends do you have?","words":[{"g":"how much"},{"g":"of / from"},{"g":"friend","l":"ami"},null,{"g":"to have","l":"avoir"},{"g":"you"}]}]}