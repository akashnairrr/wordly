{"id":"partage_","lemma":"partagé","pos":"adj","rank":3297,"glosses":["conflicted, undecided, unsure","shared, joint"],"ipa":"/paʁ.ta.ʒe/","forms":{"feminine":"partagée","masculinePlural":"partagés","femininePlural":"partagées"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q150_%28fra%29-VictorDtmtc-partag%C3%A9.wav","formAudio":{"partagée":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q150_%28fra%29-WikiLucas00-partag%C3%A9e.wav","partagés":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q150_%28fra%29-WikiLucas00-partag%C3%A9s.wav","partagées":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q150_%28fra%29-WikiLucas00-partag%C3%A9es.wav"},"examples":[{"text":"Ils ont partagé l'argent.","en":"They shared the money.","words":[{"g":"they"},{"g":"to have","l":"avoir"},null,{"g":"the / it"},{"g":"money"}]},{"text":"Il a partagé sa soupe avec moi.","en":"He shared his soup with me.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"his"},{"g":"soup"},{"g":"with"},{"g":"me"}]},{"text":"L'opinion est partagée sur cette question.","en":"Opinion is divided on this point.","words":[{"g":"the / it"},{"g":"opinion"},{"g":"is","l":"être"},null,{"g":"on"},{"g":"it, this, that","l":"ce"},{"g":"question"}]},{"text":"Nous avons partagé l'argent entre nous.","en":"We divided the money between us.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"the / it"},{"g":"money"},null,null],"phrases":[[5,7,"between ourselves"]]},{"text":"Nous avons partagé le prix du repas.","en":"We shared the cost of the meal.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"the / it"},{"g":"prize"},{"g":"of the / some"},{"g":"meal, repast"}]}]}