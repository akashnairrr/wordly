{"id":"bref","lemma":"bref","pos":"adv","rank":1086,"glosses":["in short, in brief, briefly"],"ipa":"/bʁɛf/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6b/Fr-bref.ogg/Fr-bref.ogg.mp3","examples":[{"text":"Je serai bref.","en":"I'll be brief.","words":[{"g":"I"},{"g":"to be","l":"être"},null]},{"text":"Je vais essayer de rester bref.","en":"I'll try to keep this brief.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to test, to try on"},{"g":"of / from"},{"g":"to stay"},null]},{"text":"Soyez bref.","en":"Be brief.","words":[{"g":"to be","l":"être"},null]},{"text":"Sois bref.","en":"Be brief.","words":[{"g":"to be","l":"être"},null]},{"text":"En bref, il a été viré.","en":"To make a long story short, he was fired.","words":[{"g":"in / of it"},null,{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"summer"},{"g":"to bear, veer","l":"virer"}]}]}