{"id":"te_le_phonique","lemma":"téléphonique","pos":"adj","rank":3577,"glosses":["telephone"],"ipa":"/te.le.fɔ.nik/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/26/Fr-t%C3%A9l%C3%A9phonique.ogg/Fr-t%C3%A9l%C3%A9phonique.ogg.mp3","forms":{"plural":"téléphoniques"},"formAudio":{"téléphoniques":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q150_%28fra%29-Mathieu_Kappler-t%C3%A9l%C3%A9phoniques.wav"},"examples":[{"text":"J'attends un appel téléphonique.","en":"I'm waiting for a telephone call.","words":[{"g":"I"},{"g":"to wait for, to await","l":"attendre"},{"g":"a"},{"g":"call"},null]},{"text":"Je vais passer un appel téléphonique.","en":"I'll make a phone call.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to pass"},{"g":"a"},{"g":"call"},null]},{"text":"J'ai eu un appel téléphonique de sa part.","en":"I had a phone call from him.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"call"},null,{"g":"of / from"},{"g":"his"},{"g":"share"}]},{"text":"Je suis sur le point de passer un appel téléphonique très important.","en":"I'm about to make a very important phone call.","words":[{"g":"I"},{"g":"am","l":"être"},null,null,null,null,{"g":"to pass"},{"g":"a"},{"g":"call"},null,{"g":"very"},{"g":"important"}],"phrases":[[2,6,"on the brink of"]]},{"text":"Ils mirent sur écoute les lignes téléphoniques des terroristes.","en":"They tapped the terrorists' phone lines.","words":[{"g":"they"},{"g":"to put","l":"mettre"},null,null,{"g":"the / them","l":"le"},{"g":"line","l":"ligne"},null,{"g":"some / of the","l":"un"},{"g":"terroristic","l":"terroriste"}],"phrases":[[2,4,"tapped, bugged"]]}]}