{"id":"adversaire","lemma":"adversaire","pos":"noun","rank":2944,"glosses":["adversary, opponent, opposition, antagonist"],"ipa":"/ad.vɛʁ.sɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/Fr-adversaire.ogg/Fr-adversaire.ogg.mp3","gender":"mf","forms":{"plural":"adversaires"},"formAudio":{"adversaires":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q150_%28fra%29-Poslovitch-adversaires.wav"},"examples":[{"text":"Il n'a aucune chance contre son adversaire.","en":"He doesn't stand a chance against his opponent.","words":[{"g":"he / it"},{"g":"not"},{"g":"has","l":"avoir"},{"g":"none, no-one","l":"aucun"},{"g":"chance"},{"g":"against"},{"g":"his, her, its"},null]},{"text":"Ne sous-estimez pas vos adversaires.","en":"Don't underestimate your opponents.","words":[{"g":"not"},{"g":"below, under"},{"g":"to estimate","l":"estimer"},{"g":"not"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Ne sous-estime pas ton adversaire.","en":"Don't underestimate your opponent.","words":[{"g":"not"},{"g":"below, under"},{"g":"esteem"},{"g":"not"},{"g":"your"},null]},{"text":"C'est un adversaire redoutable.","en":"He is a formidable opponent.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null,{"g":"frightening"}]},{"text":"Je suis dépourvu d'adversaires.","en":"I have no opponents.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"without"},{"g":"of / from"},null]}]}