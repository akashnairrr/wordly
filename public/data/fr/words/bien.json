{"id":"bien","lemma":"bien","pos":"adv","rank":28,"glosses":["well","indeed; so","a lot (of)"],"ipa":"/bjɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/69/Fr-bien.ogg/Fr-bien.ogg.mp3","examples":[{"text":"Je le connais très bien.","en":"I know it very well.","audio":"https://tatoeba.org/en/audio/download/33860","words":[{"g":"I"},{"g":"the / it"},{"g":"to know","l":"connaître"},{"g":"very"},null]},{"text":"Il nous connaît très bien.","en":"He knows us very well.","audio":"https://tatoeba.org/en/audio/download/12372","words":[{"g":"he / it"},{"g":"we / us"},{"g":"to know","l":"connaître"},{"g":"very"},null]},{"text":"Parlez-vous bien le français ?","en":"Do you speak French well?","audio":"https://tatoeba.org/en/audio/download/472130","words":[{"g":"to speak, talk","l":"parler"},{"g":"you"},null,{"g":"the / it"},{"g":"French"}]},{"text":"Connaissez-vous bien cet endroit ?","en":"Do you know this place well?","words":[{"g":"to know","l":"connaître"},{"g":"you"},null,{"g":"this"},{"g":"place, spot"}]},{"text":"Vous ai-je bien entendu ?","en":"Did I hear you right?","audio":"https://tatoeba.org/en/audio/download/240846","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"I"},null,{"g":"to hear","l":"entendre"}]}]}