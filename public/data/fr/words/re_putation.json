{"id":"re_putation","lemma":"réputation","pos":"noun","rank":1560,"glosses":["reputation"],"ipa":"/ʁe.py.ta.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/37/Fr-r%C3%A9putation.ogg/Fr-r%C3%A9putation.ogg.mp3","gender":"f","forms":{"plural":"réputations"},"formAudio":{"réputations":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q150_%28fra%29-Eihel-r%C3%A9putations.wav"},"examples":[{"text":"Il a une bonne réputation.","en":"He has a good reputation.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"a"},{"g":"good","l":"bon"},null]},{"text":"Cet homme a mauvaise réputation.","en":"That man has a bad reputation.","words":[{"g":"this"},{"g":"man"},{"g":"has","l":"avoir"},{"g":"bad","l":"mauvais"},null]},{"text":"Tu as une sacrée réputation.","en":"You have something of a reputation.","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"a"},{"g":"sacred, holy","l":"sacré"},null]},{"text":"Ma réputation est en jeu.","en":"My reputation is at stake.","words":[{"g":"my","l":"mon"},null,{"g":"is","l":"être"},null,null],"phrases":[[3,5,"at stake, on the line"]]},{"text":"Notre réputation sera entachée.","en":"Our reputation will be sullied.","words":[{"g":"our"},null,{"g":"to be","l":"être"},null]}]}