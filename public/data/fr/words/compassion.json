{"id":"compassion","lemma":"compassion","pos":"noun","rank":3022,"glosses":["compassion, pity"],"ipa":"/kɔ̃.pa.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0f/Fr-compassion.ogg/Fr-compassion.ogg.mp3","gender":"f","forms":{"plural":"compassions"},"formAudio":{"compassions":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q150_%28fra%29-Lyoko%C3%AF-compassions.wav"},"examples":[{"text":"Je voulais de la compassion.","en":"I wanted sympathy.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,null,null],"phrases":[[2,4,"of the"]]},{"text":"Je ne veux pas de votre compassion.","en":"I don't want your sympathy.","words":[{"g":"I"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"not"},{"g":"of / from"},{"g":"your, belonging to you"},null]},{"text":"J'espérais un peu de compassion.","en":"I was hoping for a little sympathy.","words":[{"g":"I"},{"g":"to hope","l":"espérer"},null,null,{"g":"of / from"},null],"phrases":[[2,4,"a little, a bit"]]},{"text":"Un peu de compassion serait la bienvenue.","en":"I could use a little sympathy.","words":[null,null,{"g":"of / from"},null,{"g":"to be","l":"être"},{"g":"the / her"},{"g":"welcome"}],"phrases":[[0,2,"a little, a bit"]]},{"text":"Je ne veux pas de ta compassion.","en":"I don't want your sympathy.","words":[{"g":"I"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"not"},{"g":"of / from"},{"g":"your"},null]}]}