{"id":"e_norme_ment","lemma":"énormément","pos":"det","rank":2404,"glosses":["enormously many, very much, a great deal"],"ipa":"/e.nɔʁ.me.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9b/Fr-%C3%A9norm%C3%A9ment.ogg/Fr-%C3%A9norm%C3%A9ment.ogg.mp3","examples":[{"text":"Nous avons énormément de temps ce soir.","en":"We have plenty of time tonight.","audio":"https://tatoeba.org/en/audio/download/27679","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"of / from"},{"g":"time"},{"g":"this / it"},{"g":"evening"}]},{"text":"Tu as énormément de travail devant toi.","en":"You've got a lot of work ahead of you.","words":[{"g":"you"},{"g":"have","l":"avoir"},null,{"g":"of / from"},{"g":"work"},{"g":"in front of"},{"g":"you"}]},{"text":"Elle aime énormément la musique.","en":"She likes music very much.","words":[{"g":"she / it"},{"g":"to love","l":"aimer"},null,{"g":"the / her"},{"g":"music"}]},{"text":"Il lit énormément.","en":"He reads a great deal.","words":[{"g":"he / it"},{"g":"bed"},null]},{"text":"Tu me manques énormément.","en":"I miss you badly.","words":[null,null,null,null],"phrases":[[0,3,"I miss you"]]}]}