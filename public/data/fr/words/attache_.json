{"id":"attache_","lemma":"attaché","pos":"adj","rank":2306,"glosses":["attached, attached to, bound, committed, connected, devoted, fastened, fixed, joined-up, secured, strapped, tethered, tie-on, tied, wired"],"ipa":"/a.ta.ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/Fr-attach%C3%A9.ogg/Fr-attach%C3%A9.ogg.mp3","forms":{"feminine":"attachée","masculinePlural":"attachés","femininePlural":"attachées"},"formAudio":{"attachée":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q150_%28fra%29-Lyoko%C3%AF-attach%C3%A9e.wav","attachés":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q150_%28fra%29-WikiLucas00-attach%C3%A9s.wav"},"examples":[{"text":"Il lui est très attaché.","en":"He is deeply attached to her.","words":[{"g":"he / it"},{"g":"him, he, it"},{"g":"is","l":"être"},{"g":"very"},null]},{"text":"Une carte était attachée au cadeau.","en":"A card was attached to the gift.","words":[{"g":"a"},{"g":"card"},{"g":"to be","l":"être"},null,{"g":"to the"},{"g":"present, gift"}]},{"text":"Le chien devrait être attaché.","en":"The dog should be on a chain.","words":[{"g":"the / it"},{"g":"dog"},{"g":"must","l":"devoir"},{"g":"to be"},null]},{"text":"Cette corde est mal attachée.","en":"This rope is poorly attached.","words":[{"g":"it, this, that","l":"ce"},{"g":"rope"},{"g":"is","l":"être"},{"g":"harm, pain, evil"},null]},{"text":"Je suis toujours attaché à ce vélo.","en":"I am still attached to this bicycle.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"always"},null,{"g":"to / at"},{"g":"this / it"},{"g":"bike, bicycle, cycle"}]}]}