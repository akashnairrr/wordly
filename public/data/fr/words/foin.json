{"id":"foin","lemma":"foin","pos":"noun","rank":4664,"glosses":["hay"],"ipa":"/fwɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/ca/Fr-foin.ogg/Fr-foin.ogg.mp3","gender":"m","forms":{"plural":"foins"},"formAudio":{"foins":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q150_%28fra%29-Eihel-foins.wav"},"examples":[{"text":"Le foin est pour les chevaux.","en":"Hay is for horses.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"for"},{"g":"the / them","l":"le"},{"g":"horse","l":"cheval"}]},{"text":"La grange est pleine de foin.","en":"The barn is full of hay.","words":[null,null,{"g":"is","l":"être"},{"g":"full, full up","l":"plein"},{"g":"of / from"},null],"phrases":[[0,2,"a surname from locations"]]},{"text":"J'ai le rhume des foins.","en":"I have hay fever.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"the / it"},{"g":"cold"},{"g":"some / of the","l":"un"},null]},{"text":"Nous stockâmes le foin dans la grange.","en":"We stored the hay in the barn.","words":[{"g":"we / us"},null,{"g":"the / it"},null,{"g":"in"},null,null],"phrases":[[5,7,"a surname from locations"]]},{"text":"Je ne comprends pas pourquoi on fait tout ce foin.","en":"I don't understand what all of the fuss is about.","words":[null,null,null,null,{"g":"why"},{"g":"we / one"},{"g":"to do","l":"faire"},{"g":"all"},{"g":"this / it"},null],"phrases":[[0,4,"I don't understand"]]}]}