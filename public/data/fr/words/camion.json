{"id":"camion","lemma":"camion","pos":"noun","rank":877,"glosses":["lorry (UK); truck (US)"],"ipa":"/ka.mjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/Fr-camion.ogg/Fr-camion.ogg.mp3","gender":"m","forms":{"plural":"camions"},"formAudio":{"camions":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q150_%28fra%29-Lyoko%C3%AF-camions.wav"},"examples":[{"text":"Il a un gros camion.","en":"He has a big truck.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"a"},{"g":"big, thick, fat"},null]},{"text":"Je serai dans le camion.","en":"I'll be in the truck.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"in"},{"g":"the / it"},null]},{"text":"À qui est ce camion ?","en":"Who owns this truck?","words":[{"g":"to / at"},{"g":"who"},{"g":"is","l":"être"},{"g":"this / it"},null]},{"text":"La rue est trop étroite pour les camions.","en":"The street is too narrow for trucks.","words":[{"g":"the / her"},{"g":"street, road"},{"g":"is","l":"être"},{"g":"too"},{"g":"narrow","l":"étroit"},{"g":"for"},{"g":"the / them","l":"le"},null]},{"text":"Le camion est parti.","en":"The truck is gone.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"to go away","l":"partir"}]}]}