{"id":"roi","lemma":"roi","pos":"noun","rank":451,"glosses":["king"],"ipa":"/ʁwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2a/Fr-roi.ogg/Fr-roi.ogg.mp3","gender":"m","forms":{"plural":"rois","feminine":"reine"},"formAudio":{"rois":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q150_%28fra%29-0x010C-rois.wav","reine":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-reine.wav"},"examples":[{"text":"Il était un bon roi.","en":"He was a good king.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"a"},{"g":"good"},null]},{"text":"Nous voulons voir le roi.","en":"We want to see the king.","words":[{"g":"we / us"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to see"},{"g":"the / it"},null]},{"text":"Le client est roi.","en":"The customer is always right.","words":[{"g":"the / it"},{"g":"customer, client"},{"g":"is","l":"être"},null]},{"text":"Nous vivrons comme des rois.","en":"We'll live like kings.","words":[{"g":"we / us"},{"g":"to live","l":"vivre"},{"g":"as"},{"g":"some / of the","l":"un"},null]},{"text":"Pour moi, il est comme un roi.","en":"To me, he is like a king.","words":[{"g":"for"},{"g":"me"},{"g":"he / it"},{"g":"is","l":"être"},{"g":"as"},{"g":"a"},null]}]}