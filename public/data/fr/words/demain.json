{"id":"demain","lemma":"demain","pos":"adv","rank":196,"glosses":["tomorrow"],"ipa":"/də.mɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9c/Fr-demain.ogg/Fr-demain.ogg.mp3","examples":[{"text":"Es-tu libre demain ?","en":"Are you free tomorrow?","audio":"https://tatoeba.org/en/audio/download/2433","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"free, at liberty"},null]},{"text":"Où voulez-vous aller demain ?","en":"Where do you want to go tomorrow?","audio":"https://tatoeba.org/en/audio/download/334504","words":[{"g":"where"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to go"},null]},{"text":"Venez demain matin.","en":"Come tomorrow morning.","audio":"https://tatoeba.org/en/audio/download/12459","words":[{"g":"to come","l":"venir"},null,{"g":"morning"}]},{"text":"Pouvez-vous venir demain ?","en":"Can you come tomorrow?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to come"},null]},{"text":"Demande-moi demain.","en":"Ask me tomorrow.","words":[{"g":"to ask","l":"demander"},{"g":"me"},null]}]}