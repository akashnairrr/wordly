{"id":"pre_gs","lemma":"près","pos":"adv","rank":314,"glosses":["near, close (près de)"],"ipa":"/pʁɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/81/Fr-pr%C3%A8s.ogg/Fr-pr%C3%A8s.ogg.mp3","examples":[{"text":"Viens un peu plus près.","en":"Come a little closer.","audio":"https://tatoeba.org/en/audio/download/1103093","words":[{"g":"to come","l":"venir"},null,null,{"g":"more / no longer"},null],"phrases":[[1,3,"a little, a bit"]]},{"text":"Restez près.","en":"Stay close.","audio":"https://tatoeba.org/en/audio/download/473966","words":[{"g":"to stay","l":"rester"},null]},{"text":"Peux-tu venir plus près ?","en":"Can you come closer?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to come"},{"g":"more / no longer"},null]},{"text":"Je veux être près de toi.","en":"I want to be near you.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to be"},null,{"g":"of / from"},{"g":"you"}]},{"text":"Ma maison est près du parc.","en":"My house is close to the park.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},null,{"g":"of the / some"},{"g":"park"}]}]}