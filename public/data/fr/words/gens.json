{"id":"gens","lemma":"gens","pos":"noun","rank":132,"glosses":["people"],"ipa":"/ʒɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ec/Fr-gens.ogg/Fr-gens.ogg.mp3","gender":"m","examples":[{"text":"Vous connaissez les gens.","en":"You know people.","audio":"https://tatoeba.org/en/audio/download/177036","words":[{"g":"you"},{"g":"to know","l":"connaître"},{"g":"the / them","l":"le"},null]},{"text":"Beaucoup de gens disent ça.","en":"A lot of people say that.","words":[{"g":"much, very much, a lot"},{"g":"of / from"},null,{"g":"to say, to tell","l":"dire"},{"g":"that"}]},{"text":"Connais-tu tous ces gens ?","en":"Do you know all these people?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"all"},{"g":"it, this, that","l":"ce"},null]},{"text":"Nous sommes des gens sérieux.","en":"We're serious people.","audio":"https://tatoeba.org/en/audio/download/1102963","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"some / of the","l":"un"},null,{"g":"serious"}]},{"text":"Pourquoi les gens font-ils ceci ?","en":"Why do people do this?","words":[{"g":"why"},{"g":"the / them","l":"le"},null,{"g":"to do","l":"faire"},{"g":"they"},{"g":"this"}]}]}