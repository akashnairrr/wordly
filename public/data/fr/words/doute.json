{"id":"doute","lemma":"doute","pos":"noun","rank":418,"glosses":["doubt"],"ipa":"/dut/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6c/Fr-doute.ogg/Fr-doute.ogg.mp3","gender":"m","forms":{"plural":"doutes"},"formAudio":{"doutes":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q150_%28fra%29-Eihel-doutes.wav"},"examples":[{"text":"J'en doute.","en":"I doubt it.","audio":"https://tatoeba.org/en/audio/download/77277","words":[{"g":"I"},{"g":"in / of it"},null]},{"text":"Je doute que cela fonctionne.","en":"I doubt that'll work.","words":[{"g":"I"},null,{"g":"that / what"},{"g":"that"},{"g":"to function, to work","l":"fonctionner"}]},{"text":"Je doute qu'il vienne.","en":"I doubt if he will come.","audio":"https://tatoeba.org/en/audio/download/27002","words":[{"g":"I"},null,{"g":"that / what"},{"g":"he / it"},{"g":"to come","l":"venir"}]},{"text":"Je n'en doute pas.","en":"I don't doubt it.","audio":"https://tatoeba.org/en/audio/download/1097729","words":[{"g":"I"},{"g":"not"},{"g":"in / of it"},null,{"g":"not"}]},{"text":"Aucun doute là-dessus.","en":"There's no doubt about it.","words":[{"g":"none, no-one"},null,{"g":"there"},{"g":"on"}]}]}