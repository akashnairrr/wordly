{"id":"passager","lemma":"passager","pos":"adj","rank":2584,"glosses":["whose presence in a location is only temporary; passing","of a short duration; temporary; transitory, fleeting, flighty","busy"],"ipa":"/pa.sa.ʒe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/70/Fr-passager.ogg/Fr-passager.ogg.mp3","forms":{"feminine":"passagère","masculinePlural":"passagers","femininePlural":"passagères"},"formAudio":{"passagère":"https://upload.wikimedia.org/wikipedia/commons/6/6f/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-passag%C3%A8re.wav"},"examples":[{"text":"L'amour est passager.","en":"Love is transient.","audio":"https://tatoeba.org/en/audio/download/1098081","words":[{"g":"the / it"},{"g":"love"},{"g":"is","l":"être"},null]},{"text":"Combien de passagers sont à bord ?","en":"How many passengers are on board?","words":[{"g":"how much"},{"g":"of / from"},null,{"g":"to be","l":"être"},null,null],"phrases":[[4,6,"aboard, on board"]]},{"text":"J'étais passagère.","en":"I was a passenger.","words":[{"g":"I"},{"g":"to be","l":"être"},null]},{"text":"Le taxi a pris deux passagers.","en":"The taxi picked up two passengers.","words":[{"g":"the / it"},{"g":"taxi"},{"g":"has","l":"avoir"},{"g":"to take","l":"prendre"},{"g":"two"},null]},{"text":"Ce n'est que passager.","en":"It's only temporary.","words":[{"g":"this / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"that / what"},null]}]}