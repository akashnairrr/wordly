{"id":"monnaie","lemma":"monnaie","pos":"noun","rank":1814,"glosses":["change (money back after a transaction)","currency","cash, change (coins, as opposed to notes)"],"ipa":"/mɔ.nɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fc/Fr-monnaie.ogg/Fr-monnaie.ogg.mp3","gender":"f","forms":{"plural":"monnaies"},"examples":[{"text":"Voici votre monnaie.","en":"Here is your change.","audio":"https://tatoeba.org/en/audio/download/1678","words":[{"g":"here is"},{"g":"your, belonging to you"},null]},{"text":"Vous pouvez garder la monnaie.","en":"You can keep the change.","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to keep"},{"g":"the / her"},null]},{"text":"Pourquoi as-tu besoin de monnaie ?","en":"Why do you need change?","words":[{"g":"why"},{"g":"have","l":"avoir"},{"g":"you"},{"g":"need"},{"g":"of / from"},null]},{"text":"Avez-vous de la petite monnaie ?","en":"Do you have small change?","words":[{"g":"to have","l":"avoir"},{"g":"you"},null,null,{"g":"small, little","l":"petit"},null],"phrases":[[2,4,"of the"]]},{"text":"Est-ce ton porte-monnaie ?","en":"Is this your wallet?","words":[{"g":"is","l":"être"},{"g":"this / it"},{"g":"your"},{"g":"door"},null]}]}