{"id":"halte","lemma":"halte","pos":"noun","rank":3383,"glosses":["halt, pause, break","halting place","flag stop, way station"],"ipa":"/alt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/72/Fr-halte.ogg/Fr-halte.ogg.mp3","gender":"f","forms":{"plural":"haltes"},"examples":[{"text":"Halte au feu !","en":"Hold fire.","audio":"https://tatoeba.org/en/audio/download/90928","words":[null,null,null],"phrases":[[1,3,"fire!"]]},{"text":"Le train fit une brève halte.","en":"The train made a brief stop.","words":[{"g":"the / it"},{"g":"train"},{"g":"to do","l":"faire"},{"g":"a"},{"g":"in short","l":"bref"},null]},{"text":"Faisons une halte à la prochaine aire de repos.","en":"Let's stop at the next rest stop.","words":[{"g":"to do","l":"faire"},{"g":"a"},null,null,null,{"g":"upcoming","l":"prochain"},null,null,null],"phrases":[[3,5,"a la"],[6,9,"rest area, truck stop"]]},{"text":"En route pour Tokyo, j'ai fait une halte à Osaka.","en":"I stopped off at Osaka on my way to Tokyo.","words":[null,null,{"g":"for"},null,{"g":"I"},{"g":"have","l":"avoir"},{"g":"to do","l":"faire"},{"g":"a"},null,{"g":"to / at"},null],"phrases":[[0,2,"let's go"]]}]}