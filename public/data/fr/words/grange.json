{"id":"grange","lemma":"grange","pos":"noun","rank":3265,"glosses":["a barn"],"ipa":"/ɡʁɑ̃ʒ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4c/Fr-grange.ogg/Fr-grange.ogg.mp3","gender":"f","forms":{"plural":"granges"},"formAudio":{"granges":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q150_%28fra%29-Lepticed7-granges.wav"},"examples":[{"text":"La grange est vide.","en":"The barn is empty.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"empty"}]},{"text":"Regardez, la grange est en feu !","en":"Look, the barn is on fire!","words":[{"g":"to look at","l":"regarder"},{"g":"the / her"},null,{"g":"is","l":"être"},null,null],"phrases":[[4,6,"on fire, ablaze"]]},{"text":"Ils ont dormi dans une grange.","en":"They slept in a barn.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"to sleep","l":"dormir"},{"g":"in"},{"g":"a"},null]},{"text":"Les granges sont pleines de grains.","en":"The barns are full of grain.","words":[{"g":"the / them","l":"le"},null,{"g":"to be","l":"être"},{"g":"full, full up","l":"plein"},{"g":"of / from"},{"g":"grain","l":"grain"}]},{"text":"La grange est pleine de foin.","en":"The barn is full of hay.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"full, full up","l":"plein"},{"g":"of / from"},{"g":"hay"}]}]}