{"id":"bec","lemma":"bec","pos":"noun","rank":4238,"glosses":["beak, bill (of a bird)","mouthpiece; fipple","mouth"],"ipa":"/bɛk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/Fr-bec.ogg/Fr-bec.ogg.mp3","gender":"m","forms":{"plural":"becs"},"formAudio":{"becs":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q150_%28fra%29-0x010C-becs.wav"},"examples":[{"text":"Les oiseaux ont un bec.","en":"Birds have beaks.","words":[{"g":"the / them","l":"le"},{"g":"bird","l":"oiseau"},{"g":"to have","l":"avoir"},{"g":"a"},null]},{"text":"Tu ne veux pas me donner un bec ?","en":"Don't you want to kiss me?","words":[{"g":"you"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"not"},{"g":"me"},{"g":"to give"},{"g":"a"},null]},{"text":"Les pélicans ont de grands becs.","en":"Pelicans have large beaks.","words":[{"g":"the / them","l":"le"},null,{"g":"to have","l":"avoir"},{"g":"of / from"},{"g":"big","l":"grand"},null]},{"text":"Je suis bec sucré.","en":"I have a sweet tooth.","audio":"https://tatoeba.org/en/audio/download/41935","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"sugared"}]},{"text":"Ils ont eu une prise de bec, hier.","en":"They had a spat yesterday.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"socket"},{"g":"of / from"},null,{"g":"yesterday"}]}]}