{"id":"tiens","lemma":"tiens","pos":"intj","rank":265,"glosses":["used to show uncertainty; like, you know","used to show surprise","used to show emphasis"],"ipa":"/tjɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/be/LL-Q150_%28fra%29-Pamputt-tiens.wav/LL-Q150_%28fra%29-Pamputt-tiens.wav.mp3","examples":[{"text":"Tiens, prends-le.","en":"Here, take it.","audio":"https://tatoeba.org/en/audio/download/1093617","words":[null,{"g":"to take","l":"prendre"},{"g":"the / it"}]},{"text":"Pourquoi te tiens-tu là ?","en":"Why are you standing there?","words":[{"g":"why"},{"g":"you"},null,{"g":"you"},{"g":"there"}]},{"text":"Tu te tiens sur mon pied.","en":"You're standing on my foot.","words":[{"g":"you"},{"g":"you"},null,{"g":"on"},{"g":"my"},{"g":"foot"}]},{"text":"De qui tiens-tu cela ?","en":"Who did you learn it from?","words":[{"g":"of / from"},{"g":"who"},null,{"g":"you"},{"g":"that"}]},{"text":"Tiens ma main.","en":"Hold my hand.","words":[null,{"g":"my","l":"mon"},{"g":"hand"}]}]}