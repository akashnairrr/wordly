{"id":"limite","lemma":"limite","pos":"adj","rank":1730,"glosses":["edgy, borderline, almost objectionable"],"ipa":"/li.mit/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f3/Fr-limite.ogg/Fr-limite.ogg.mp3","forms":{"plural":"limites"},"formAudio":{"limites":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q150_%28fra%29-WikiLucas00-limites.wav"},"examples":[{"text":"Je connais mes limites.","en":"I know my limitations.","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"my"},null]},{"text":"C'est la limite.","en":"That's the limit.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"the / her"},null]},{"text":"Elle connaît ses limites.","en":"She knows her limitations.","words":[{"g":"she / it"},{"g":"to know","l":"connaître"},{"g":"his"},null]},{"text":"Quelle est la limite de vitesse, ici ?","en":"What is the speed limit here?","words":[{"g":"which?"},{"g":"is","l":"être"},{"g":"the / her"},null,{"g":"of / from"},{"g":"speed"},{"g":"here"}]},{"text":"L'univers est sans limite.","en":"The universe is endless.","words":[{"g":"the / it"},{"g":"universe"},{"g":"is","l":"être"},{"g":"without"},null]}]}