{"id":"couloir","lemma":"couloir","pos":"noun","rank":1607,"glosses":["corridor, hallway","aisle (in an airliner)","slipstream"],"ipa":"/ku.lwaʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/34/Fr-couloir.ogg/Fr-couloir.ogg.mp3","gender":"m","forms":{"plural":"couloirs"},"formAudio":{"couloirs":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q150_%28fra%29-Poslovitch-couloirs.wav"},"examples":[{"text":"Cette piscine compte six couloirs.","en":"This swimming pool has six lanes.","words":[{"g":"it, this, that","l":"ce"},{"g":"swimming pool"},{"g":"account"},{"g":"six"},null]},{"text":"Accroche ton manteau dans le couloir.","en":"Hang your coat in the hallway.","words":[{"g":"lead-in"},{"g":"your"},{"g":"coat"},{"g":"in"},{"g":"the / it"},null]},{"text":"La salle de bain est au bout du couloir.","en":"The bathroom is at the end of the hall.","words":[{"g":"the / her"},null,null,null,{"g":"is","l":"être"},{"g":"to the"},{"g":"end, extremity, tip"},{"g":"of the / some"},null],"phrases":[[1,4,"bathroom"]]},{"text":"Le sol du couloir est carrelé.","en":"The corridor floor is tiled.","words":[{"g":"the / it"},{"g":"soil, earth"},{"g":"of the / some"},null,{"g":"is","l":"être"},null]},{"text":"Je vis de l'autre côté du couloir.","en":"I live across the hall.","words":[{"g":"I"},{"g":"to see","l":"voir"},{"g":"of / from"},{"g":"the / it"},{"g":"other"},{"g":"side"},{"g":"of the / some"},null]}]}