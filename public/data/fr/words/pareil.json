{"id":"pareil","lemma":"pareil","pos":"adj","rank":601,"glosses":["such","like, alike, same"],"ipa":"/pa.ʁɛj/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/27/Fr-pareil.ogg/Fr-pareil.ogg.mp3","forms":{"feminine":"pareille","masculinePlural":"pareils","femininePlural":"pareilles"},"formAudio":{"pareille":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q150_%28fra%29-Lyoko%C3%AF-pareille.wav"},"examples":[{"text":"Qui ferait une chose pareille ?","en":"Who would do such a thing?","words":[{"g":"who"},{"g":"to do","l":"faire"},{"g":"a"},{"g":"thing"},null]},{"text":"Je ferais pareil.","en":"I would do the same.","words":[{"g":"I"},{"g":"to do","l":"faire"},null]},{"text":"Avez-vous déjà entendu pareille histoire ?","en":"Have you ever heard such a story?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"already, before"},{"g":"to hear","l":"entendre"},null,{"g":"story"}]},{"text":"Que faites-vous dans un endroit pareil ?","en":"What are you doing in a place like this?","words":[{"g":"that / what"},{"g":"to do","l":"faire"},{"g":"you"},{"g":"in"},{"g":"a"},{"g":"place, spot"},null]},{"text":"Vous êtes tous pareils.","en":"You're all the same.","words":[{"g":"you"},{"g":"to be","l":"être"},{"g":"all"},null]}]}