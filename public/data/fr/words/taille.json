{"id":"taille","lemma":"taille","pos":"noun","rank":956,"glosses":["the act of cutting, pruning, trimming","size","waist"],"ipa":"/taj/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/Fr-taille.ogg/Fr-taille.ogg.mp3","gender":"f","forms":{"plural":"tailles"},"formAudio":{"tailles":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q150_%28fra%29-Lyoko%C3%AF-tailles.wav"},"examples":[{"text":"Tu fais quelle taille maintenant ?","en":"How tall are you now?","audio":"https://tatoeba.org/en/audio/download/1102861","words":[{"g":"you"},{"g":"to do","l":"faire"},{"g":"which?"},null,{"g":"now, currently"}]},{"text":"Connaissez-vous votre taille ?","en":"Do you know your size?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"your, belonging to you"},null]},{"text":"Ce n'est pas ma taille.","en":"It's not my size.","audio":"https://tatoeba.org/en/audio/download/1095692","words":[{"g":"this / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"not"},{"g":"my","l":"mon"},null]},{"text":"De quelle taille est le soleil ?","en":"How big is the sun?","words":[{"g":"of / from"},{"g":"which?"},null,{"g":"is","l":"être"},{"g":"the / it"},{"g":"sun"}]},{"text":"Nous avons la même taille.","en":"We're the same size.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"the / her"},{"g":"same"},null]}]}