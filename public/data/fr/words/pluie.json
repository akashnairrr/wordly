{"id":"pluie","lemma":"pluie","pos":"noun","rank":1339,"glosses":["rain","loads of things"],"ipa":"/plɥi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/40/Fr-pluie.ogg/Fr-pluie.ogg.mp3","gender":"f","forms":{"plural":"pluies"},"formAudio":{"pluies":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q150_%28fra%29-Poslovitch-pluies.wav"},"examples":[{"text":"J'aime la pluie.","en":"I love the rain.","words":[{"g":"I"},{"g":"to love","l":"aimer"},{"g":"the / her"},null]},{"text":"La saison des pluies a commencé.","en":"The rainy season has set in.","words":[{"g":"the / her"},{"g":"season"},{"g":"some / of the","l":"un"},null,{"g":"has","l":"avoir"},{"g":"to begin, commence","l":"commencer"}]},{"text":"Je déteste les jours de pluie.","en":"I hate rainy days.","audio":"https://tatoeba.org/en/audio/download/1097766","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"the / them","l":"le"},{"g":"day","l":"jour"},{"g":"of / from"},null]},{"text":"Mon fils joue sous la pluie.","en":"My son is playing in the rain.","words":[{"g":"my"},{"g":"son"},{"g":"to play","l":"jouer"},{"g":"below, under"},{"g":"the / her"},null]},{"text":"Il nous faut de la pluie.","en":"We need the rain.","words":[{"g":"he / it"},{"g":"we / us"},{"g":"to need","l":"falloir"},null,null,null],"phrases":[[3,5,"of the"]]}]}