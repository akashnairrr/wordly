{"id":"pie_ce","lemma":"pièce","pos":"noun","rank":471,"glosses":["room in a house, etc.","patch","piece"],"ipa":"/pjɛs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/Fr-pi%C3%A8ce.ogg/Fr-pi%C3%A8ce.ogg.mp3","gender":"f","forms":{"plural":"pièces"},"formAudio":{"pièces":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q150_%28fra%29-Le_Commissaire-pi%C3%A8ces.wav"},"examples":[{"text":"Cette maison a six pièces.","en":"This house has six rooms.","audio":"https://tatoeba.org/en/audio/download/28234","words":[{"g":"it, this, that","l":"ce"},{"g":"house, home"},{"g":"has","l":"avoir"},{"g":"six"},null]},{"text":"Qui est dans cette pièce ?","en":"Who is in this room?","words":[{"g":"who"},{"g":"is","l":"être"},{"g":"in"},{"g":"it, this, that","l":"ce"},null]},{"text":"Tu peux quitter la pièce, maintenant.","en":"You can leave the room now.","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to leave, to quit"},{"g":"the / her"},null,{"g":"now, currently"}]},{"text":"Je ne suis pas aux pièces.","en":"I'm not in a rush.","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},{"g":"not"},{"g":"to the"},null]},{"text":"La pièce est sombre.","en":"The room is dark.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"dark"}]}]}