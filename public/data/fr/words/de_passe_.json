{"id":"de_passe_","lemma":"dépassé","pos":"adj","rank":2321,"glosses":["outdated"],"forms":{"feminine":"dépassée","masculinePlural":"dépassés","femininePlural":"dépassées"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q150_%28fra%29-Sartus85-d%C3%A9pass%C3%A9.wav","examples":[{"text":"Nous avons dépassé cela.","en":"We're past that.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"that"}]},{"text":"Tes idées sont toutes dépassées.","en":"Your ideas are all out of date.","audio":"https://tatoeba.org/en/audio/download/27995","words":[{"g":"your"},{"g":"idea","l":"idée"},{"g":"to be","l":"être"},{"g":"all","l":"tout"},null]},{"text":"Cette machine est désormais dépassée.","en":"This machine is now out of date.","words":[{"g":"it, this, that","l":"ce"},{"g":"machine, device"},{"g":"is","l":"être"},{"g":"henceforth"},null]},{"text":"Il m'a dépassé.","en":"He got ahead of me.","words":[{"g":"he / it"},{"g":"me"},{"g":"has","l":"avoir"},null]},{"text":"Franchement, ta manière de penser est dépassée.","en":"Frankly speaking, your way of thinking is out of date.","words":[{"g":"frankly"},{"g":"your"},{"g":"manner, way"},{"g":"of / from"},{"g":"to think"},{"g":"is","l":"être"},null]}]}