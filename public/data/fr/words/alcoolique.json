{"id":"alcoolique","lemma":"alcoolique","pos":"adj","rank":3348,"glosses":["alcohol; alcoholic","addicted to alcohol"],"ipa":"/al.kɔ.lik/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/Fr-alcoolique.ogg/Fr-alcoolique.ogg.mp3","forms":{"plural":"alcooliques"},"formAudio":{"alcooliques":"https://upload.wikimedia.org/wikipedia/commons/4/48/LL-Q150_%28fra%29-Lyoko%C3%AF-alcooliques.wav"},"examples":[{"text":"Je ne suis pas alcoolique.","en":"I'm not an alcoholic.","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},{"g":"not"},null]},{"text":"Ma mère était alcoolique.","en":"My mother was an alcoholic.","words":[{"g":"my","l":"mon"},{"g":"mother"},{"g":"to be","l":"être"},null]},{"text":"Il est un peu alcoolique.","en":"He's a bit of a drunkard.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,null,null],"phrases":[[2,4,"a little, a bit"]]},{"text":"C'est une alcoolique.","en":"She's an alcoholic.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null]},{"text":"Je suis alcoolique.","en":"I'm an alcoholic.","words":[{"g":"I"},{"g":"am","l":"être"},null]}]}