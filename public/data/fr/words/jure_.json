{"id":"jure_","lemma":"juré","pos":"noun","rank":1675,"glosses":["juror (a member of a jury)"],"ipa":"/ʒy.ʁe/","gender":"m","forms":{"plural":"jurés","feminine":"jurée"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-Jur%C3%A9.wav","formAudio":{"jurée":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q150_%28fra%29-Guilhelma-jur%C3%A9e.wav"},"examples":[{"text":"J’ai juré.","en":"I swore.","words":[{"g":"I"},{"g":"have","l":"avoir"},null]},{"text":"Les jurés ont délibéré pendant trois jours.","en":"The jurors deliberated for three days.","words":[{"g":"the / them","l":"le"},null,{"g":"to have","l":"avoir"},{"g":"deliberate"},{"g":"during"},{"g":"three"},{"g":"day","l":"jour"}]},{"text":"J'ai juré de dire toute la vérité.","en":"I swore to tell the whole truth.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"of / from"},{"g":"to say, to tell"},{"g":"all","l":"tout"},{"g":"the / her"},{"g":"truth"}]},{"text":"Voulez-vous dire aux jurés ce qui s'est passé ?","en":"Do you want to tell the jury what happened?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to say, to tell"},{"g":"to the"},null,null,null,{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"past"}],"phrases":[[5,7,"what (that which"]]},{"text":"J'ai juré que je ne ferais jamais ça.","en":"I swore I'd never do that.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"that / what"},{"g":"I"},{"g":"not"},{"g":"to do","l":"faire"},{"g":"never"},{"g":"that"}]}]}