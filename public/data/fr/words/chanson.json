{"id":"chanson","lemma":"chanson","pos":"noun","rank":671,"glosses":["song"],"ipa":"/ʃɑ̃.sɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f5/Fr-chanson.ogg/Fr-chanson.ogg.mp3","gender":"f","forms":{"plural":"chansons"},"formAudio":{"chansons":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q150_%28fra%29-WikiLucas00-chansons.wav"},"examples":[{"text":"Tu connais cette chanson ?","en":"Do you know this song?","audio":"https://tatoeba.org/en/audio/download/238778","words":[{"g":"you"},{"g":"to know","l":"connaître"},{"g":"it, this, that","l":"ce"},null]},{"text":"Tu peux chanter une chanson.","en":"You can sing a song.","audio":"https://tatoeba.org/en/audio/download/29462","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to sing"},{"g":"a"},null]},{"text":"Aimes-tu ses chansons ?","en":"Do you like her songs?","words":[{"g":"to love","l":"aimer"},{"g":"you"},{"g":"his"},null]},{"text":"Tu as déjà entendu cette chanson ?","en":"Have you heard this song before?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"already, before"},{"g":"to hear","l":"entendre"},{"g":"it, this, that","l":"ce"},null]},{"text":"Je voulais juste écrire des chansons.","en":"I just wanted to write songs.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"fair, just"},{"g":"to write"},{"g":"some / of the","l":"un"},null]}]}