{"id":"ombre","lemma":"ombre","pos":"noun","rank":1341,"glosses":["shade, shadow","darkness","ghost"],"ipa":"/ɔ̃bʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/Fr-ombre.ogg/Fr-ombre.ogg.mp3","gender":"f","forms":{"plural":"ombres"},"formAudio":{"ombres":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q150_%28fra%29-WikiLucas00-ombres.wav"},"examples":[{"text":"Il a peur de son ombre.","en":"He is afraid of his own shadow.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"fear"},{"g":"of / from"},{"g":"his, her, its"},null]},{"text":"C'est une ombre.","en":"That's a shadow.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null]},{"text":"La fille avait peur de son ombre.","en":"The girl was afraid of her own shadow.","words":[{"g":"the / her"},{"g":"girl"},{"g":"to have","l":"avoir"},{"g":"fear"},{"g":"of / from"},{"g":"his, her, its"},null]},{"text":"Allons nous asseoir à l'ombre.","en":"Let's go sit in the shade.","words":[{"g":"to go","l":"aller"},{"g":"we / us"},{"g":"to sit down"},{"g":"to / at"},{"g":"the / it"},null]},{"text":"Gare la voiture à l'ombre.","en":"Park the car in the shade.","words":[{"g":"railway station"},{"g":"the / her"},{"g":"car"},{"g":"to / at"},{"g":"the / it"},null]}]}