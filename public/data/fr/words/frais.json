{"id":"frais","lemma":"frais","pos":"adj","rank":1025,"glosses":["fresh (recently produced, unspoiled)","fresh (well-rested)","fresh, cool (of temperature, wind, etc.)"],"ipa":"/fʁɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/Fr-frais.ogg/Fr-frais.ogg.mp3","forms":{"feminine":"fraîche","masculinePlural":"frais","femininePlural":"fraîches"},"formAudio":{"fraîche":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q150_%28fra%29-LoquaxFR-fra%C3%AEche.wav"},"examples":[{"text":"Il fait frais dehors.","en":"It's cool outside.","audio":"https://tatoeba.org/en/audio/download/1097775","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"outside"}]},{"text":"Veux-tu une bière fraîche?","en":"Do you want a cold beer?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"a"},{"g":"beer"},null]},{"text":"Il fait frais ce matin, non ?","en":"It's cool this morning, isn't?","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"this / it"},{"g":"morning"},{"g":"no"}]},{"text":"La nuit était fraîche.","en":"The night was cool.","words":[{"g":"the / her"},{"g":"night"},{"g":"to be","l":"être"},null]},{"text":"Le matin, l'air est frais.","en":"In the morning, the air is cool.","words":[{"g":"the / it"},{"g":"morning"},{"g":"the / it"},{"g":"air"},{"g":"is","l":"être"},null]}]}