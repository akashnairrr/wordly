{"id":"essence","lemma":"essence","pos":"noun","rank":1502,"glosses":["essence","petrol, gasoline","essence, essential oil"],"ipa":"/e.sɑ̃s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d1/Fr-essence.ogg/Fr-essence.ogg.mp3","gender":"f","forms":{"plural":"essences"},"formAudio":{"essences":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q150_%28fra%29-Eihel-essences.wav"},"examples":[{"text":"Qui va payer l'essence ?","en":"Who's paying for the gas?","words":[{"g":"who"},{"g":"to go","l":"aller"},{"g":"to pay"},{"g":"the / it"},null]},{"text":"Je suis à court d'essence.","en":"I'm out of gas.","words":[{"g":"I"},{"g":"am","l":"être"},null,null,{"g":"of / from"},null],"phrases":[[2,4,"out of, short of"]]},{"text":"Nous n'avons plus d'essence.","en":"We've run out of gas.","words":[{"g":"we / us"},{"g":"not"},{"g":"to have","l":"avoir"},{"g":"more / no longer"},{"g":"of / from"},null]},{"text":"L'amour est l'essence de la vie.","en":"Loving is the essence of life.","words":[{"g":"the / it"},{"g":"love"},{"g":"is","l":"être"},{"g":"the / it"},null,null,null,{"g":"life"}],"phrases":[[5,7,"of the"]]},{"text":"Ma voiture était à court d'essence.","en":"My car ran out of gas.","words":[{"g":"my","l":"mon"},{"g":"car"},{"g":"to be","l":"être"},null,null,{"g":"of / from"},null],"phrases":[[3,5,"out of, short of"]]}]}