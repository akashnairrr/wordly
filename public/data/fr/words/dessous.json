{"id":"dessous","lemma":"dessous","pos":"noun","rank":1458,"glosses":["underside; bottom","disadvantage","(women's) underwear"],"ipa":"/də.su/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7e/Fr-dessous.ogg/Fr-dessous.ogg.mp3","gender":"m","examples":[{"text":"Ma chambre est juste au-dessous.","en":"My room is just below.","words":[{"g":"my","l":"mon"},{"g":"a room."},{"g":"is","l":"être"},{"g":"fair, just"},{"g":"to the"},null]},{"text":"Ma maison est sens dessus dessous.","en":"My house is in disarray.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"meaning, sense"},{"g":"on"},null]},{"text":"Qui vit dans la chambre du dessous ?","en":"Who lives in the room below?","words":[{"g":"who"},{"g":"to see","l":"voir"},{"g":"in"},{"g":"the / her"},{"g":"a room."},{"g":"of the / some"},null]},{"text":"Je déteste avoir le dessous.","en":"I hate losing.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"to have"},{"g":"the / it"},null]},{"text":"Ils vivent en-dessous.","en":"They live downstairs.","words":[{"g":"they"},{"g":"to live","l":"vivre"},{"g":"in / of it"},null]}]}