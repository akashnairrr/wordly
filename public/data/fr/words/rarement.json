{"id":"rarement","lemma":"rarement","pos":"adv","rank":2580,"glosses":["rarely, seldom"],"ipa":"/ʁaʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/Fr-rarement.ogg/Fr-rarement.ogg.mp3","examples":[{"text":"Je le vois rarement.","en":"I seldom see him.","audio":"https://tatoeba.org/en/audio/download/1653","words":[{"g":"I"},{"g":"the / it"},{"g":"to see","l":"voir"},null]},{"text":"Je fais rarement cela.","en":"I rarely do that.","words":[{"g":"I"},{"g":"to do","l":"faire"},null,{"g":"that"}]},{"text":"Je suis rarement à la maison.","en":"I'm seldom at home.","audio":"https://tatoeba.org/en/audio/download/1097999","words":[{"g":"I"},{"g":"am","l":"être"},null,null,null,null],"phrases":[[3,6,"at home"]]},{"text":"Il vient rarement me voir.","en":"He seldom comes to see me.","words":[{"g":"he / it"},{"g":"to come","l":"venir"},null,{"g":"me"},{"g":"to see"}]},{"text":"Mes enfants vont rarement dehors.","en":"My children rarely go outside.","words":[{"g":"my"},{"g":"child","l":"enfant"},{"g":"to go","l":"aller"},null,{"g":"outside"}]}]}