{"id":"matin","lemma":"matin","pos":"noun","rank":267,"glosses":["morning"],"ipa":"/ma.tɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e1/Fr-matin.ogg/Fr-matin.ogg.mp3","gender":"m","forms":{"plural":"matins"},"formAudio":{"matins":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q150_%28fra%29-Eihel-matins.wav"},"examples":[{"text":"Venez demain matin.","en":"Come tomorrow morning.","audio":"https://tatoeba.org/en/audio/download/12459","words":[{"g":"to come","l":"venir"},{"g":"tomorrow"},null]},{"text":"Il faisait très froid hier matin.","en":"It was very cold yesterday morning.","audio":"https://tatoeba.org/en/audio/download/2254","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"very"},{"g":"cold"},{"g":"yesterday"},null]},{"text":"Je vais marcher tous les matins.","en":"I go for a walk every morning.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to walk"},{"g":"all"},{"g":"the / them","l":"le"},null]},{"text":"Je travaille le matin.","en":"I work in the morning.","words":[{"g":"I"},{"g":"to work","l":"travailler"},{"g":"the / it"},null]},{"text":"Où étiez-vous ce matin ?","en":"Where were you this morning?","words":[{"g":"where"},{"g":"to be","l":"être"},{"g":"you"},{"g":"this / it"},null]}]}