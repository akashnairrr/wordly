{"id":"rhume","lemma":"rhume","pos":"noun","rank":3881,"glosses":["cold (illness)"],"ipa":"/ʁym/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d5/Fr-rhume.ogg/Fr-rhume.ogg.mp3","gender":"m","forms":{"plural":"rhumes"},"formAudio":{"rhumes":"https://upload.wikimedia.org/wikipedia/commons/6/6f/LL-Q150_%28fra%29-Eihel-rhumes.wav"},"examples":[{"text":"J'ai un mauvais rhume.","en":"I have a bad cold.","audio":"https://tatoeba.org/en/audio/download/2152","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"a"},{"g":"bad"},null]},{"text":"Comment va votre rhume ?","en":"How's your cold?","words":[{"g":"how"},{"g":"to go","l":"aller"},{"g":"your, belonging to you"},null]},{"text":"Je souffre d'un mauvais rhume.","en":"I'm suffering from a bad cold.","words":[{"g":"I"},{"g":"to suffer","l":"souffrir"},{"g":"of / from"},{"g":"a"},{"g":"bad"},null]},{"text":"J'attrape souvent des rhumes en hiver.","en":"I often catch colds in the winter.","words":[{"g":"I"},{"g":"to trap","l":"attraper"},{"g":"often"},{"g":"some / of the","l":"un"},null,{"g":"in / of it"},{"g":"winter"}]},{"text":"Mon rhume empire.","en":"My cold is getting worse.","words":[{"g":"my"},null,{"g":"empire"}]}]}