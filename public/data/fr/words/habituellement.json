{"id":"habituellement","lemma":"habituellement","pos":"adv","rank":4005,"glosses":["usually, habitually"],"ipa":"/a.bi.tɥɛl.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/Fr-habituellement.ogg/Fr-habituellement.ogg.mp3","examples":[{"text":"Quel jour es-tu libre habituellement ?","en":"What day are you usually free?","words":[{"g":"which"},{"g":"day"},{"g":"are","l":"être"},{"g":"you"},{"g":"free, at liberty"},null]},{"text":"Que faites-vous habituellement ?","en":"What do you normally do?","words":[{"g":"that / what"},{"g":"to do","l":"faire"},{"g":"you"},null]},{"text":"Je rentre habituellement à quatre heures.","en":"I usually go home at four.","words":[{"g":"I"},{"g":"to go back","l":"rentrer"},null,{"g":"to / at"},{"g":"four"},{"g":"hour, time","l":"heure"}]},{"text":"On dort habituellement dans cette chambre.","en":"We usually sleep in this room.","words":[{"g":"we / one"},{"g":"to sleep","l":"dormir"},null,{"g":"in"},{"g":"it, this, that","l":"ce"},{"g":"a room."}]},{"text":"Où vas-tu habituellement pêcher ?","en":"Where do you usually go fishing?","audio":"https://tatoeba.org/en/audio/download/334603","words":[{"g":"where"},{"g":"to go","l":"aller"},{"g":"you"},null,{"g":"to fish"}]}]}