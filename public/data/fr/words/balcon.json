{"id":"balcon","lemma":"balcon","pos":"noun","rank":3813,"glosses":["balcony"],"ipa":"/bal.kɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c1/Fr-balcon.ogg/Fr-balcon.ogg.mp3","gender":"m","forms":{"plural":"balcons"},"formAudio":{"balcons":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q150_%28fra%29-Poslovitch-balcons.wav"},"examples":[{"text":"Je suis sur le balcon.","en":"I'm on the balcony.","audio":"https://tatoeba.org/en/audio/download/12608","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"on"},{"g":"the / it"},null]},{"text":"J'adore la vue de mon balcon.","en":"I love the view from my balcony.","words":[{"g":"I"},{"g":"to love, to adore","l":"adorer"},{"g":"the / her"},{"g":"sight"},{"g":"of / from"},{"g":"my"},null]},{"text":"Le balcon déborde sur la rue.","en":"The balcony juts out over the street.","words":[{"g":"the / it"},null,{"g":"to overflow","l":"déborder"},{"g":"on"},{"g":"the / her"},{"g":"street, road"}]},{"text":"La famille prend le petit-déjeuner sur le balcon.","en":"The family is eating breakfast on the balcony.","words":[{"g":"the / her"},{"g":"family"},{"g":"to take","l":"prendre"},{"g":"the / it"},null,null,{"g":"on"},{"g":"the / it"},null],"phrases":[[4,6,"breakfast"]]},{"text":"Thomas était au balcon.","en":"Tom was on the balcony.","words":[null,{"g":"to be","l":"être"},{"g":"to the"},null]}]}