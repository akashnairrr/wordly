{"id":"mare_e","lemma":"marée","pos":"noun","rank":4703,"glosses":["tide","catch (of fish)","wave (anything that forms a great crowd)"],"ipa":"/ma.ʁe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/dc/Fr-mar%C3%A9e.ogg/Fr-mar%C3%A9e.ogg.mp3","gender":"f","forms":{"plural":"marées"},"formAudio":{"marées":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q150_%28fra%29-Amqui-Commission_scolaire_des_Monts-et-Mar%C3%A9es.wav"},"examples":[{"text":"La marée monte.","en":"The tide is coming in.","words":[{"g":"the / her"},null,{"g":"to go up, to climb","l":"monter"}]},{"text":"La marée monte vite.","en":"The tide is rising fast.","words":[{"g":"the / her"},null,{"g":"to go up, to climb","l":"monter"},{"g":"quickly"}]},{"text":"C'est marée basse.","en":"You're out of booze.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"bass"}]},{"text":"Il essaya de nager contre la marée.","en":"He tried to swim against the tide.","words":[{"g":"he / it"},{"g":"to test, to try on","l":"essayer"},{"g":"of / from"},{"g":"to swim"},{"g":"against"},{"g":"the / her"},null]},{"text":"Les marées sont dues à la gravitation de la lune.","en":"Tides are caused by the moon's gravity.","words":[{"g":"the / them","l":"le"},null,{"g":"to be","l":"être"},{"g":"what is owed","l":"dû"},null,null,{"g":"gravitation"},null,null,{"g":"the Moon"}],"phrases":[[4,6,"a la"],[7,9,"of the"]]}]}