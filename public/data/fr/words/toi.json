{"id":"toi","lemma":"toi","pos":"pron","rank":50,"glosses":["you (informal second-person singular personal pronoun, disjunctive)","yourself (reflexive object pronoun of imperative verbs)"],"ipa":"/twa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/Fr-toi.ogg/Fr-toi.ogg.mp3","examples":[{"text":"Est-ce toi ?","en":"Is it you?","audio":"https://tatoeba.org/en/audio/download/68419","words":[{"g":"is","l":"être"},{"g":"this / it"},null]},{"text":"Tu les vois, toi ?","en":"Do you see them?","audio":"https://tatoeba.org/en/audio/download/1093540","words":[{"g":"you"},{"g":"the / them","l":"le"},{"g":"to see","l":"voir"},null]},{"text":"On peut venir avec toi ?","en":"Can we come with you?","audio":"https://tatoeba.org/en/audio/download/1102929","words":[{"g":"we / one"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to come"},{"g":"with"},null]},{"text":"Je crois en toi.","en":"I believe in you.","audio":"https://tatoeba.org/en/audio/download/34596","words":[{"g":"I"},{"g":"to believe","l":"croire"},{"g":"in / of it"},null]},{"text":"Arrête-toi où tu es.","en":"Stop where you are.","audio":"https://tatoeba.org/en/audio/download/209758","words":[{"g":"to stop","l":"arrêter"},null,{"g":"where"},{"g":"you"},{"g":"are","l":"être"}]}]}