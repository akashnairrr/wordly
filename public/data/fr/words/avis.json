{"id":"avis","lemma":"avis","pos":"noun","rank":424,"glosses":["opinion","piece of advice","notice"],"ipa":"/a.vi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/Fr-avis.ogg/Fr-avis.ogg.mp3","gender":"m","examples":[{"text":"Je veux ton avis.","en":"I want your opinion.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"your"},null]},{"text":"C’est ton avis.","en":"That's your opinion.","audio":"https://tatoeba.org/en/audio/download/119060","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"your"},null]},{"text":"Quel est votre avis là-dessus ?","en":"What's your opinion on this?","words":[{"g":"which"},{"g":"is","l":"être"},{"g":"your, belonging to you"},null,{"g":"there"},{"g":"on"}]},{"text":"Personne ne veut entendre mon avis.","en":"No one wants to listen to my opinions.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to hear"},{"g":"my"},null]},{"text":"Peux-tu donner ton avis ?","en":"Can you chip in?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to give"},{"g":"your"},null]}]}