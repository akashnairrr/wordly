{"id":"incapable","lemma":"incapable","pos":"adj","rank":2012,"glosses":["unable, incapable"],"ipa":"/ɛ̃.ka.pabl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/LL-Q150_%28fra%29-Lepticed7-incapable.wav/LL-Q150_%28fra%29-Lepticed7-incapable.wav.mp3","forms":{"plural":"incapables"},"formAudio":{"incapables":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q150_%28fra%29-WikiLucas00-incapables.wav"},"examples":[{"text":"Il est incapable de le faire.","en":"He can't do it.","audio":"https://tatoeba.org/en/audio/download/12329","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"of / from"},{"g":"the / it"},{"g":"to do"}]},{"text":"Je suis incapable de faire ça.","en":"I'm unable to do that.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"of / from"},{"g":"to do"},{"g":"that"}]},{"text":"Nous étions incapables de suivre sa logique.","en":"We were unable to follow his logic.","words":[{"g":"we / us"},{"g":"to be","l":"être"},null,{"g":"of / from"},{"g":"to follow"},{"g":"his"},{"g":"logical"}]},{"text":"Elle était incapable de lui parler.","en":"She wasn't able to talk to him.","words":[{"g":"she / it"},{"g":"to be","l":"être"},null,{"g":"of / from"},{"g":"him, he, it"},{"g":"to speak, talk"}]},{"text":"Il est incapable d'acheter une voiture.","en":"He is unable to buy a car.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"of / from"},{"g":"to purchase"},{"g":"a"},{"g":"car"}]}]}