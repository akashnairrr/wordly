{"id":"estomac","lemma":"estomac","pos":"noun","rank":1687,"glosses":["stomach"],"ipa":"/ɛs.tɔ.ma/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ef/Fr-estomac.ogg/Fr-estomac.ogg.mp3","gender":"m","forms":{"plural":"estomacs"},"examples":[{"text":"Le cancer a gagné son estomac.","en":"The cancer has spread to her stomach.","words":[{"g":"the / it"},{"g":"cancer"},{"g":"has","l":"avoir"},{"g":"to win","l":"gagner"},{"g":"his, her, its"},null]},{"text":"Mon estomac me fait mal.","en":"My stomach hurts.","words":[{"g":"my"},null,{"g":"me"},{"g":"to do","l":"faire"},{"g":"harm, pain, evil"}]},{"text":"J'ai l'estomac plein.","en":"My stomach's full.","audio":"https://tatoeba.org/en/audio/download/85697","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"the / it"},null,{"g":"full, full up"}]},{"text":"Nous avons tous mal à l'estomac.","en":"We all have stomachaches.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"all"},{"g":"harm, pain, evil"},{"g":"to / at"},{"g":"the / it"},null]},{"text":"La douleur à mon estomac est partie.","en":"The pain in my stomach has gone.","words":[{"g":"the / her"},{"g":"pain"},{"g":"to / at"},{"g":"my"},null,{"g":"is","l":"être"},{"g":"part"}]}]}