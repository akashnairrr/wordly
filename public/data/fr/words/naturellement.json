{"id":"naturellement","lemma":"naturellement","pos":"adv","rank":2204,"glosses":["naturally"],"ipa":"/na.ty.ʁɛl.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/32/Fr-naturellement.ogg/Fr-naturellement.ogg.mp3","examples":[{"text":"Cela s'est fait naturellement.","en":"It happened naturally.","words":[{"g":"that"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"to do","l":"faire"},null]},{"text":"Mes cheveux sont naturellement bouclés.","en":"My hair is naturally curly.","words":[{"g":"my"},{"g":"a headhair","l":"cheveu"},{"g":"to be","l":"être"},null,{"g":"curly","l":"bouclé"}]},{"text":"Certaines filles sont naturellement jolies.","en":"Some girls are naturally pretty.","words":[{"g":"certain, guaranteed","l":"certain"},{"g":"girl","l":"fille"},{"g":"to be","l":"être"},null,{"g":"pretty","l":"joli"}]},{"text":"Ses cheveux sont-il naturellement roux ?","en":"Is her hair naturally red?","words":[{"g":"his"},{"g":"a headhair","l":"cheveu"},{"g":"to be","l":"être"},{"g":"he / it"},null,{"g":"russet"}]},{"text":"Le feu s'est éteint naturellement.","en":"The fire went out by itself.","words":[{"g":"the / it"},{"g":"fire"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"to turn off","l":"éteindre"},null]}]}