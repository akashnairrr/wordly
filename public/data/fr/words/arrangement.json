{"id":"arrangement","lemma":"arrangement","pos":"noun","rank":2686,"glosses":["arrangement"],"ipa":"/a.ʁɑ̃ʒ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a0/Fr-arrangement.ogg/Fr-arrangement.ogg.mp3","gender":"m","forms":{"plural":"arrangements"},"formAudio":{"arrangements":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q150_%28fra%29-Eihel-arrangements.wav"},"examples":[{"text":"Je voudrais apprendre comment faire des arrangements floraux.","en":"I'd like to learn how to arrange flowers.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to learn"},{"g":"how"},{"g":"to do"},{"g":"some / of the","l":"un"},null,null]},{"text":"Ma mère enseigne l'arrangement floral.","en":"My mother teaches flower arranging.","words":[{"g":"my","l":"mon"},{"g":"mother"},{"g":"shop sign"},{"g":"the / it"},null,{"g":"floral"}]},{"text":"Elle aime composer des arrangements floraux.","en":"She likes to arrange flowers.","words":[{"g":"she / it"},{"g":"to love","l":"aimer"},{"g":"to compose"},{"g":"some / of the","l":"un"},null,null]},{"text":"Cet arrangement s'est avéré très rentable.","en":"The arrangement proved highly profitable.","words":[{"g":"this"},null,{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"recognized, known"},{"g":"very"},{"g":"profitable"}]},{"text":"L'art japonais de l'arrangement floral est appelé Ikebana.","en":"The Japanese art of flower arrangement is called ikebana.","words":[{"g":"the / it"},{"g":"art"},{"g":"Japanese"},{"g":"of / from"},{"g":"the / it"},null,{"g":"floral"},{"g":"is","l":"être"},{"g":"to call","l":"appeler"},null]}]}