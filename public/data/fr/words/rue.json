{"id":"rue","lemma":"rue","pos":"noun","rank":505,"glosses":["street, road"],"ipa":"/ʁy/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7c/Fr-rue.ogg/Fr-rue.ogg.mp3","gender":"f","forms":{"plural":"rues"},"formAudio":{"rues":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q150_%28fra%29-0x010C-rues.wav"},"examples":[{"text":"Où mène cette rue ?","en":"Where does that road lead?","words":[{"g":"where"},{"g":"to lead, to take","l":"mener"},{"g":"it, this, that","l":"ce"},null]},{"text":"Jouer dans la rue est dangereux.","en":"Playing in the street is dangerous.","words":[{"g":"to play"},{"g":"in"},{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"dangerous"}]},{"text":"Ma maison est à cinq rues.","en":"My house is five blocks away.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"to / at"},{"g":"five"},null]},{"text":"Prends la rue à droite.","en":"Take the street on the right.","words":[{"g":"to take","l":"prendre"},{"g":"the / her"},null,null,null],"phrases":[[3,5,"on the right"]]},{"text":"Les rues sont propres.","en":"The streets are clean.","words":[{"g":"the / them","l":"le"},null,{"g":"to be","l":"être"},{"g":"own","l":"propre"}]}]}