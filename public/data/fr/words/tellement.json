{"id":"tellement","lemma":"tellement","pos":"adv","rank":263,"glosses":["so; so much; very","so much (singular); so many (plural)","so much (gives a reason for the preceding statement)"],"ipa":"/tɛl.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e9/Fr-tellement.ogg/Fr-tellement.ogg.mp3","examples":[{"text":"Je suis tellement malade.","en":"I am so sick.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"ill, sick"}]},{"text":"Je déteste tellement ça.","en":"I hate that so much.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},null,{"g":"that"}]},{"text":"Nous pouvons faire tellement plus.","en":"We can do so much more.","words":[{"g":"we / us"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},null,{"g":"more / no longer"}]},{"text":"On peut faire tellement mieux.","en":"We can do so much better.","words":[{"g":"we / one"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},null,{"g":"better"}]},{"text":"Est-ce tellement mauvais ?","en":"Is that so bad?","words":[{"g":"is","l":"être"},{"g":"this / it"},null,{"g":"bad"}]}]}