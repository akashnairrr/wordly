{"id":"tranquille","lemma":"tranquille","pos":"adj","rank":637,"glosses":["calm, quiet, tranquil, still, peaceful, serene"],"ipa":"/tʁɑ̃.kil/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/01/Fr-tranquille.ogg/Fr-tranquille.ogg.mp3","forms":{"plural":"tranquilles"},"examples":[{"text":"Peux-tu me laisser tranquille ?","en":"Can you leave me alone?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"me"},{"g":"to leave"},null]},{"text":"Laisse mes trucs tranquilles.","en":"Leave my stuff alone.","words":[{"g":"to leave","l":"laisser"},{"g":"my"},{"g":"thing, stuff","l":"truc"},null]},{"text":"Il était un homme tranquille.","en":"He used to be a quiet man.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"a"},{"g":"man"},null]},{"text":"Laisse-moi tranquille maintenant.","en":"Leave me alone now.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},null,{"g":"now, currently"}]},{"text":"Ils sont tranquilles.","en":"They're quiet.","words":[{"g":"they"},{"g":"to be","l":"être"},null]}]}