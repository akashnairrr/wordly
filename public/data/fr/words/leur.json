{"id":"leur","lemma":"leur","pos":"pron","rank":116,"glosses":["(to) them"],"ipa":"/lœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b6/Fr-leur.ogg/Fr-leur.ogg.mp3","examples":[{"text":"Donne-leur mon numéro.","en":"Give them my number.","audio":"https://tatoeba.org/en/audio/download/1097984","words":[{"g":"to give","l":"donner"},null,{"g":"my"},{"g":"number"}]},{"text":"Nous leur avons parlé hier.","en":"We talked to them yesterday.","audio":"https://tatoeba.org/en/audio/download/653752","words":[{"g":"we / us"},null,{"g":"to have","l":"avoir"},{"g":"to speak, talk","l":"parler"},{"g":"yesterday"}]},{"text":"Demande-leur.","en":"Ask them.","audio":"https://tatoeba.org/en/audio/download/473163","words":[{"g":"to ask","l":"demander"},null]},{"text":"Dites-leur qui je suis.","en":"Tell them who I am.","words":[{"g":"to say, to tell","l":"dire"},null,{"g":"who"},{"g":"I"},{"g":"am","l":"être"}]},{"text":"Dis-leur qui tu es.","en":"Tell them who you are.","words":[{"g":"to say, to tell","l":"dire"},null,{"g":"who"},{"g":"you"},{"g":"are","l":"être"}]}]}