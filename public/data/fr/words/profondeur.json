{"id":"profondeur","lemma":"profondeur","pos":"noun","rank":3593,"glosses":["depth"],"ipa":"/pʁɔ.fɔ̃.dœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a5/Fr-profondeur.ogg/Fr-profondeur.ogg.mp3","gender":"f","forms":{"plural":"profondeurs"},"formAudio":{"profondeurs":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q150_%28fra%29-Eihel-profondeurs.wav"},"examples":[{"text":"Quelle est la profondeur du lac ?","en":"How deep is the lake?","audio":"https://tatoeba.org/en/audio/download/37020","words":[{"g":"which?"},{"g":"is","l":"être"},{"g":"the / her"},null,{"g":"of the / some"},{"g":"lake"}]},{"text":"Quelle est la profondeur de cette rivière ?","en":"How deep is this river?","words":[{"g":"which?"},{"g":"is","l":"être"},{"g":"the / her"},null,{"g":"of / from"},{"g":"it, this, that","l":"ce"},{"g":"a river"}]},{"text":"Ça manque vraiment de profondeur.","en":"That's a really shallow thing to say.","words":[{"g":"that"},{"g":"lack, absence"},{"g":"truly"},{"g":"of / from"},null]},{"text":"Comment savez-vous quelle profondeur a le lac ?","en":"How do you know how deep the lake is?","words":[{"g":"how"},{"g":"to know","l":"savoir"},{"g":"you"},{"g":"which?"},null,{"g":"has","l":"avoir"},{"g":"the / it"},{"g":"lake"}]},{"text":"Le lac est ici à sa plus grande profondeur.","en":"The lake is deepest here.","words":[{"g":"the / it"},{"g":"lake"},{"g":"is","l":"être"},{"g":"here"},{"g":"to / at"},{"g":"his"},{"g":"more / no longer"},{"g":"big","l":"grand"},null]}]}