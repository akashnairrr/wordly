{"id":"horloge","lemma":"horloge","pos":"noun","rank":2953,"glosses":["clock"],"ipa":"/ɔʁ.lɔʒ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a7/Fr-horloge.ogg/Fr-horloge.ogg.mp3","gender":"f","forms":{"plural":"horloges"},"formAudio":{"horloges":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q150_%28fra%29-Poslovitch-horloges.wav"},"examples":[{"text":"Regarde l'horloge.","en":"Look at the clock.","words":[{"g":"to look at","l":"regarder"},{"g":"the / it"},null]},{"text":"Cette horloge est mienne.","en":"This clock is mine.","words":[{"g":"it, this, that","l":"ce"},null,{"g":"is","l":"être"},null]},{"text":"Cette horloge fonctionne-t-elle ?","en":"Is this clock working?","words":[{"g":"it, this, that","l":"ce"},null,{"g":"to function, to work","l":"fonctionner"},{"g":"you"},{"g":"she / it"}]},{"text":"Je n'aime aucune des deux horloges.","en":"I don't like either watch.","words":[{"g":"I"},{"g":"not"},{"g":"to love","l":"aimer"},{"g":"none, no-one","l":"aucun"},{"g":"some / of the","l":"un"},{"g":"two"},null]},{"text":"Cette horloge perd trois minutes par jour.","en":"This clock loses three minutes a day.","words":[{"g":"it, this, that","l":"ce"},null,{"g":"to lose","l":"perdre"},{"g":"three"},{"g":"minute","l":"minute"},{"g":"through"},{"g":"day"}]}]}