{"id":"constamment","lemma":"constamment","pos":"adv","rank":2970,"glosses":["constantly"],"ipa":"/kɔ̃s.ta.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/56/Fr-constamment.ogg/Fr-constamment.ogg.mp3","examples":[{"text":"Nous en parlons constamment.","en":"We talk about it all the time.","audio":"https://tatoeba.org/en/audio/download/653737","words":[{"g":"we / us"},{"g":"in / of it"},{"g":"to speak, talk","l":"parler"},null]},{"text":"Il fait constamment la même erreur.","en":"He keeps making the same mistake.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"the / her"},{"g":"same"},{"g":"error"}]},{"text":"Je danse constamment dans mon salon.","en":"I dance in my living room all the time.","words":[{"g":"I"},{"g":"dance"},null,{"g":"in"},{"g":"my"},{"g":"living room"}]},{"text":"Elle écrit constamment des lettres.","en":"She is constantly writing letters.","words":[{"g":"she / it"},{"g":"to write","l":"écrire"},null,{"g":"some / of the","l":"un"},{"g":"humanities/arts"}]},{"text":"Tu es constamment en retard au travail.","en":"You are consistently late to work.","words":[{"g":"you"},{"g":"are","l":"être"},null,null,null,null,null],"phrases":[[3,5,"late, overdue"],[5,7,"get to work! let's get…"]]}]}