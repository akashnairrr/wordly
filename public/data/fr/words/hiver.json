{"id":"hiver","lemma":"hiver","pos":"noun","rank":1617,"glosses":["winter"],"ipa":"/i.vɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d6/Fr-hiver-fr_FR-Paris.ogg/Fr-hiver-fr_FR-Paris.ogg.mp3","gender":"m","forms":{"plural":"hivers"},"formAudio":{"hivers":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q150_%28fra%29-Poslovitch-hivers.wav"},"examples":[{"text":"Ce sera bientôt l'hiver.","en":"It'll be winter soon.","words":[{"g":"this / it"},{"g":"to be","l":"être"},{"g":"soon"},{"g":"the / it"},null]},{"text":"Il fait froid l'hiver.","en":"It's cold in the winter.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"cold"},{"g":"the / it"},null]},{"text":"Il est né en hiver.","en":"He was born in the winter.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"to be born","l":"naître"},{"g":"in / of it"},null]},{"text":"Nous avons eu un hiver difficile.","en":"We had a difficult winter.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"to have","l":"avoir"},{"g":"a"},null,{"g":"difficult"}]},{"text":"Les hivers étaient très rudes.","en":"The winters were bitterly cold.","words":[{"g":"the / them","l":"le"},null,{"g":"to be","l":"être"},{"g":"very"},{"g":"rough, harsh","l":"rude"}]}]}