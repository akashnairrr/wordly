{"id":"joie","lemma":"joie","pos":"noun","rank":1107,"glosses":["joy (feeling of happiness or elation)"],"ipa":"/ʒwa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/14/Fr-joie.ogg/Fr-joie.ogg.mp3","gender":"f","forms":{"plural":"joies"},"formAudio":{"joies":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q150_%28fra%29-Lyoko%C3%AF-joies.wav"},"examples":[{"text":"Mon cœur était rempli de joie.","en":"My heart was filled with joy.","words":[{"g":"my"},{"g":"heart"},{"g":"to be","l":"être"},{"g":"filled"},{"g":"of / from"},null]},{"text":"Elle dansa avec joie.","en":"She danced with joy.","words":[{"g":"she / it"},{"g":"to dance","l":"danser"},{"g":"with"},null]},{"text":"Cela me cause une grande joie.","en":"It brings me great joy.","words":[{"g":"that"},{"g":"me"},{"g":"cause"},{"g":"a"},{"g":"big","l":"grand"},null]},{"text":"C'est une joie de te revoir.","en":"It is nice to see you again.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null,{"g":"of / from"},{"g":"you"},{"g":"to see again"}]},{"text":"J'ai sauté de joie.","en":"I jumped for joy.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"sauté"},{"g":"of / from"},null]}]}