{"id":"malgre_","lemma":"malgré","pos":"prep","rank":1113,"glosses":["despite, in spite of","against (one's) will, despite (one's) protest"],"ipa":"/mal.ɡʁe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d5/Fr-malgr%C3%A9.ogg/Fr-malgr%C3%A9.ogg.mp3","examples":[{"text":"Je le fais malgré vous.","en":"I'm doing it in spite of you.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},null,{"g":"you"}]},{"text":"Je suis sorti malgré la pluie.","en":"I went out in spite of the rain.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"to exit","l":"sortir"},null,{"g":"the / her"},{"g":"rain"}]},{"text":"Il est sorti malgré la tempête.","en":"He went out in spite of the storm.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"to exit","l":"sortir"},null,{"g":"the / her"},{"g":"storm, tempest"}]},{"text":"Je riais malgré moi.","en":"I laughed in spite of myself.","words":[{"g":"I"},{"g":"to laugh","l":"rire"},null,{"g":"me"}]},{"text":"Je le fais malgré toi.","en":"I'm doing it in spite of you.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},null,{"g":"you"}]}]}