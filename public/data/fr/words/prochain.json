{"id":"prochain","lemma":"prochain","pos":"adj","rank":447,"glosses":["upcoming","nearby","next"],"ipa":"/pʁɔ.ʃɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5b/Fr-prochain.ogg/Fr-prochain.ogg.mp3","forms":{"feminine":"prochaine","masculinePlural":"prochains","femininePlural":"prochaines"},"formAudio":{"prochaine":"https://upload.wikimedia.org/wikipedia/commons/f/f3/LL-Q150_%28fra%29-Poslovitch-prochaine.wav","prochains":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q150_%28fra%29-Lyoko%C3%AF-prochains.wav","prochaines":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q150_%28fra%29-WikiLucas00-prochaines.wav"},"examples":[{"text":"La prochaine question est pour toi.","en":"The next question is for you.","words":[{"g":"the / her"},null,{"g":"question"},{"g":"is","l":"être"},{"g":"for"},{"g":"you"}]},{"text":"Je pourrais être le prochain.","en":"I could be next.","audio":"https://tatoeba.org/en/audio/download/351681","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to be"},{"g":"the / it"},null]},{"text":"Où est le prochain garage ?","en":"Where is the nearest garage?","words":[{"g":"where"},{"g":"is","l":"être"},{"g":"the / it"},null,{"g":"garage"}]},{"text":"Attends l'année prochaine.","en":"Wait till next year.","audio":"https://tatoeba.org/en/audio/download/1103007","words":[{"g":"to wait for, to await","l":"attendre"},{"g":"the / it"},{"g":"year"},null]},{"text":"Je le ferai la semaine prochaine.","en":"I'll do it next week.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},{"g":"the / her"},{"g":"week"},null]}]}