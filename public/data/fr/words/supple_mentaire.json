{"id":"supple_mentaire","lemma":"supplémentaire","pos":"adj","rank":3895,"glosses":["extra","supplementary"],"ipa":"/sy.ple.mɑ̃.tɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/Fr-suppl%C3%A9mentaire.ogg/Fr-suppl%C3%A9mentaire.ogg.mp3","forms":{"plural":"supplémentaires"},"formAudio":{"supplémentaires":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q150_%28fra%29-Lyoko%C3%AF-suppl%C3%A9mentaires.wav"},"examples":[{"text":"Avez-vous une clé supplémentaire ?","en":"Do you have an extra key?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"a"},{"g":"key"},null]},{"text":"Je veux quelques minutes supplémentaires.","en":"I want a few more minutes.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"some","l":"quelque"},{"g":"minute","l":"minute"},null]},{"text":"Je veux te poser quelques questions supplémentaires.","en":"I want to ask you some more questions.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to stop carrying"},{"g":"some","l":"quelque"},{"g":"question","l":"question"},null]},{"text":"Je vais te donner une chance supplémentaire.","en":"I'll give you one more chance.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"you"},{"g":"to give"},{"g":"a"},{"g":"chance"},null]},{"text":"Il nous faut seulement quelques minutes supplémentaires.","en":"We need only a few more minutes.","words":[{"g":"he / it"},{"g":"we / us"},{"g":"to need","l":"falloir"},{"g":"only"},{"g":"some","l":"quelque"},{"g":"minute","l":"minute"},null]}]}