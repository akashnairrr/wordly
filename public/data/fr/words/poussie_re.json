{"id":"poussie_re","lemma":"poussière","pos":"noun","rank":1930,"glosses":["dust","speck of dust","very little; next to nothing"],"ipa":"/pu.sjɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c7/Fr-poussi%C3%A8re.ogg/Fr-poussi%C3%A8re.ogg.mp3","gender":"f","forms":{"plural":"poussières"},"formAudio":{"poussières":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q150_%28fra%29-Eihel-poussi%C3%A8res.wav"},"examples":[{"text":"Tout est couvert de poussière.","en":"Everything is covered with dust.","words":[{"g":"all"},{"g":"is","l":"être"},{"g":"covered"},{"g":"of / from"},null]},{"text":"Il y a tellement de poussière ici.","en":"There's so much dust here.","words":[null,null,null,{"g":"so"},{"g":"of / from"},null,{"g":"here"}],"phrases":[[0,3,"ago"]]},{"text":"Le bureau était couvert de poussière.","en":"The desk was covered in dust.","words":[{"g":"the / it"},{"g":"office"},{"g":"to be","l":"être"},{"g":"covered"},{"g":"of / from"},null]},{"text":"J'ai des poussières dans les yeux.","en":"My eyes feel gritty.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"some / of the","l":"un"},null,{"g":"in"},{"g":"the / them","l":"le"},{"g":"eye","l":"œil"}]},{"text":"Une tempête de poussière s'approche.","en":"A dust storm is coming.","words":[{"g":"a"},{"g":"storm, tempest"},{"g":"of / from"},null,{"g":"oneself / if"},{"g":"approach"}]}]}