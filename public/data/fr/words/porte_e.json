{"id":"porte_e","lemma":"portée","pos":"noun","rank":1757,"glosses":["reach, range, scope","range (of a weapon)","litter (animals born in one birth)"],"ipa":"/pɔʁ.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f6/Fr-port%C3%A9e.ogg/Fr-port%C3%A9e.ogg.mp3","gender":"f","forms":{"plural":"portées"},"formAudio":{"portées":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q150_%28fra%29-Lyoko%C3%AF-port%C3%A9es.wav"},"examples":[{"text":"C'était hors de sa portée.","en":"It was out of his reach.","words":[{"g":"it / that"},{"g":"to be","l":"être"},null,null,{"g":"his"},null],"phrases":[[2,4,"out of, outside"]]},{"text":"Veuillez rester à portée de voix.","en":"Please stay within earshot.","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"to stay"},{"g":"to / at"},null,{"g":"of / from"},{"g":"voice"}]},{"text":"Mettez-le hors de portée des enfants.","en":"Put it where children can't get at it.","words":[{"g":"to put","l":"mettre"},{"g":"the / it"},null,null,null,{"g":"some / of the","l":"un"},{"g":"child","l":"enfant"}],"phrases":[[2,4,"out of, outside"]]},{"text":"Garde ton arme à portée de main !","en":"Keep your gun handy.","words":[{"g":"a watch, guard"},{"g":"your"},{"g":"weapon"},{"g":"to / at"},null,{"g":"of / from"},{"g":"hand"}]},{"text":"Je me suis portée volontaire.","en":"I volunteered.","words":[{"g":"I"},{"g":"me"},{"g":"am","l":"être"},null,{"g":"voluntary, deliberate"}]}]}