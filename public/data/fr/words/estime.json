{"id":"estime","lemma":"estime","pos":"noun","rank":2757,"glosses":["esteem","estimation"],"ipa":"/ɛs.tim/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9d/Fr-estime.ogg/Fr-estime.ogg.mp3","gender":"f","forms":{"plural":"estimes"},"formAudio":{"estimes":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q150_%28fra%29-Lyoko%C3%AF-estimes.wav"},"examples":[{"text":"Tu te sous-estimes.","en":"You underestimate yourself.","words":[{"g":"you"},{"g":"you"},{"g":"below, under"},null]},{"text":"Ne me sous-estime pas.","en":"Don't underestimate me.","words":[{"g":"not"},{"g":"me"},{"g":"below, under"},null,{"g":"not"}]},{"text":"Fais ce que tu estimes juste.","en":"Do what you think is right.","words":[{"g":"to do","l":"faire"},null,null,{"g":"you"},null,{"g":"fair, just"}],"phrases":[[1,3,"what"]]},{"text":"Tu as notre plus grande estime.","en":"We think the world of you.","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"our"},{"g":"more / no longer"},{"g":"big","l":"grand"},null]},{"text":"Ne sous-estime jamais ton auditoire.","en":"Never underestimate your audience.","words":[{"g":"not"},{"g":"below, under"},null,{"g":"never"},{"g":"your"},{"g":"audience, auditory"}]}]}