{"id":"tremblement","lemma":"tremblement","pos":"noun","rank":4608,"glosses":["shake, tremble"],"ipa":"/tʁɑ̃.blə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b1/Fr-tremblement.ogg/Fr-tremblement.ogg.mp3","gender":"m","forms":{"plural":"tremblements"},"examples":[{"text":"J'ai peur des tremblements de terre.","en":"I'm afraid of earthquakes.","audio":"https://tatoeba.org/en/audio/download/27017","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"fear"},{"g":"some / of the","l":"un"},null,{"g":"of / from"},{"g":"earth"}]},{"text":"J'ai senti un tremblement de terre.","en":"I felt the earth shake.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to smell","l":"sentir"},{"g":"a"},null,{"g":"of / from"},{"g":"earth"}]},{"text":"Il a été tué dans le tremblement de terre.","en":"He was killed in the earthquake.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"summer"},{"g":"to kill","l":"tuer"},{"g":"in"},{"g":"the / it"},null,{"g":"of / from"},{"g":"earth"}]},{"text":"As-tu senti le tremblement de terre ce matin ?","en":"Did you feel the earthquake this morning?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to smell","l":"sentir"},{"g":"the / it"},null,{"g":"of / from"},{"g":"earth"},{"g":"this / it"},{"g":"morning"}]},{"text":"En cas de tremblement de terre, ferme le gaz.","en":"In case of an earthquake, turn off the gas.","words":[null,null,null,null,{"g":"of / from"},null,null,{"g":"the / it"},{"g":"gas"}],"phrases":[[0,3,"in case of"],[5,7,"terra firma"]]}]}