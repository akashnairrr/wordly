{"id":"autant","lemma":"autant","pos":"adv","rank":356,"glosses":["so much","just as well, might as well/may as well","the same, as much"],"ipa":"/o.tɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b9/Fr-autant.ogg/Fr-autant.ogg.mp3","examples":[{"text":"Pourquoi devrais-je payer autant ?","en":"Why should I pay that much?","words":[{"g":"why"},{"g":"must","l":"devoir"},{"g":"I"},{"g":"to pay"},null]},{"text":"Je vais pas manger autant.","en":"I'm not going to eat that much.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"not"},{"g":"to eat"},null]},{"text":"Pourquoi m'en veux-tu autant ?","en":"Why are you so angry with me?","words":[{"g":"why"},{"g":"me"},{"g":"in / of it"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},null]},{"text":"Je ne veux pas payer autant.","en":"I don't want to pay that much.","words":[{"g":"I"},{"g":"not"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"not"},{"g":"to pay"},null]},{"text":"Pourquoi aimes-tu autant le sport?","en":"Why do you like sports so much?","words":[{"g":"why"},{"g":"to love","l":"aimer"},{"g":"you"},null,{"g":"the / it"},{"g":"sport"}]}]}