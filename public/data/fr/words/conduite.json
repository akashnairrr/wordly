{"id":"conduite","lemma":"conduite","pos":"noun","rank":1868,"glosses":["behavior, conduct","duct","drive, driving"],"ipa":"/kɔ̃.dɥit/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/88/Fr-conduite.ogg/Fr-conduite.ogg.mp3","gender":"f","forms":{"plural":"conduites"},"formAudio":{"conduites":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q150_%28fra%29-DenisdeShawi-conduites.wav"},"examples":[{"text":"Je suis responsable de ma conduite.","en":"I'm responsible for my conduct.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"responsible"},{"g":"of / from"},{"g":"my","l":"mon"},null]},{"text":"Comment pouvez-vous justifier votre conduite ?","en":"How can you justify your behavior?","words":[{"g":"how"},{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to justify"},{"g":"your, belonging to you"},null]},{"text":"Je vais à une école de conduite.","en":"I go to a driving school.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to / at"},{"g":"a"},{"g":"school"},{"g":"of / from"},null]},{"text":"J'ai honte de ta conduite.","en":"I am ashamed of your conduct.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"shame"},{"g":"of / from"},{"g":"your"},null]},{"text":"Les conduites dangereuses devraient être punies.","en":"Dangerous driving should be punished.","audio":"https://tatoeba.org/en/audio/download/27368","words":[{"g":"the / them","l":"le"},null,{"g":"dangerous","l":"dangereux"},{"g":"must","l":"devoir"},{"g":"to be"},null]}]}