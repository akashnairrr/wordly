{"id":"ailleurs","lemma":"ailleurs","pos":"adv","rank":523,"glosses":["elsewhere; somewhere else"],"ipa":"/a.jœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/Fr-ailleurs.ogg/Fr-ailleurs.ogg.mp3","examples":[{"text":"Tu veux aller ailleurs ?","en":"Do you want to go someplace else?","words":[{"g":"you"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to go"},null]},{"text":"Fais-le ailleurs.","en":"Do it somewhere else.","words":[{"g":"to do","l":"faire"},{"g":"the / it"},null]},{"text":"Pourrais-tu mettre ce sac ailleurs ?","en":"Could you put this bag somewhere else?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to put"},{"g":"this / it"},{"g":"bag, sack"},null]},{"text":"Peut-on parler de ça ailleurs ?","en":"Can we talk about this somewhere else?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"we / one"},{"g":"to speak, talk"},{"g":"of / from"},{"g":"that"},null]},{"text":"On peut aller ailleurs si tu veux.","en":"We can go somewhere else if you want.","words":[{"g":"we / one"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to go"},null,{"g":"if, whether"},{"g":"you"},{"g":"to want, wish, desire","l":"vouloir"}]}]}