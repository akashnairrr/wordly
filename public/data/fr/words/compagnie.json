{"id":"compagnie","lemma":"compagnie","pos":"noun","rank":678,"glosses":["company"],"ipa":"/kɔ̃.pa.ɲi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/Fr-compagnie.ogg/Fr-compagnie.ogg.mp3","gender":"f","forms":{"plural":"compagnies"},"formAudio":{"compagnies":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q150_%28fra%29-0x010C-compagnies.wav"},"examples":[{"text":"Voudrais-tu un peu de compagnie ?","en":"Would you like a little company?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},null,null,{"g":"of / from"},null],"phrases":[[2,4,"a little, a bit"]]},{"text":"Avez-vous un animal de compagnie ?","en":"Do you have a pet?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"a"},{"g":"animal"},{"g":"of / from"},null]},{"text":"J'apprécie beaucoup votre compagnie.","en":"I really appreciate your company.","words":[{"g":"I"},{"g":"to appreciate","l":"apprécier"},{"g":"much, very much, a lot"},{"g":"your, belonging to you"},null]},{"text":"Nous avons de la compagnie.","en":"We've got company.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,null,null],"phrases":[[2,4,"of the"]]},{"text":"J'adore être en votre compagnie.","en":"I love being with you.","words":[{"g":"I"},{"g":"to love, to adore","l":"adorer"},{"g":"to be"},{"g":"in / of it"},{"g":"your, belonging to you"},null]}]}