{"id":"ni","lemma":"ni","pos":"conj","rank":246,"glosses":["neither; nor"],"ipa":"/ni/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b8/Fr-ni.ogg/Fr-ni.ogg.mp3","examples":[{"text":"C'est ni bon ni mauvais.","en":"It's neither good nor bad.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"good"},null,{"g":"bad"}]},{"text":"Personne ne peut entrer ni sortir.","en":"No one can get in or out.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to enter"},null,{"g":"to exit"}]},{"text":"Nous ne pouvons vivre sans air ni eau.","en":"We can't live without air and water.","words":[{"g":"we / us"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to live"},{"g":"without"},{"g":"air"},null,{"g":"water"}]},{"text":"Je ne parle ni français ni anglais.","en":"I can speak neither French nor English.","words":[{"g":"I"},{"g":"not"},{"g":"to speak, talk","l":"parler"},null,{"g":"French"},null,{"g":"English"}]},{"text":"Il ne voit ni n'entend.","en":"He can't see nor hear.","words":[{"g":"he / it"},{"g":"not"},{"g":"to see","l":"voir"},null,{"g":"not"},{"g":"to hear","l":"entendre"}]}]}