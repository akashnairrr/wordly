{"id":"e_gal","lemma":"égal","pos":"adj","rank":1907,"glosses":["equal","indifferent, of no importance to"],"ipa":"/e.ɡal/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f7/Fr-%C3%A9gal.ogg/Fr-%C3%A9gal.ogg.mp3","forms":{"feminine":"égale","masculinePlural":"égaux","femininePlural":"égales"},"formAudio":{"égale":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q150_%28fra%29-Lyoko%C3%AF-%C3%A9gale.wav","égaux":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q150_%28fra%29-WikiLucas00-%C3%89gaux.wav","égales":"https://upload.wikimedia.org/wikipedia/commons/4/4f/LL-Q150_%28fra%29-Lyoko%C3%AF-%C3%A9gales.wav"},"examples":[{"text":"Nous sommes tous égaux ici.","en":"We're all equal here.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"all"},null,{"g":"here"}]},{"text":"Sept moins deux égal cinq.","en":"Seven minus two is five.","words":[{"g":"seven"},{"g":"less"},{"g":"two"},null,{"g":"five"}]},{"text":"Huit et deux égale dix.","en":"Eight plus two is ten.","words":[{"g":"eight"},{"g":"and"},{"g":"two"},null,{"g":"ten"}]},{"text":"Personne ne l'égale en force.","en":"Nobody equals him in strength.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"the / it"},null,null,null],"phrases":[[4,6,"in force"]]},{"text":"Ça m'est égal.","en":"I don't care.","audio":"https://tatoeba.org/en/audio/download/1669","words":[{"g":"that"},{"g":"me"},{"g":"is","l":"être"},null]}]}