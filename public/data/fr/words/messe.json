{"id":"messe","lemma":"messe","pos":"noun","rank":3662,"glosses":["Mass (church service)"],"ipa":"/mɛs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/73/Fr-messe.ogg/Fr-messe.ogg.mp3","gender":"f","forms":{"plural":"messes"},"examples":[{"text":"On ne va jamais à la messe.","en":"We never go to church.","words":[{"g":"we / one"},{"g":"not"},{"g":"to go","l":"aller"},{"g":"never"},null,null,null],"phrases":[[4,6,"a la"]]},{"text":"La messe est dite.","en":"The mass is over.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"Indicating a surname…","l":"dit"}]},{"text":"Vous devriez aller à la messe plus souvent.","en":"You should go to mass more often.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to go"},null,null,null,{"g":"more / no longer"},{"g":"often"}],"phrases":[[3,5,"a la"]]},{"text":"Nous allons à la messe tous les dimanches.","en":"We go to mass every Sunday.","words":[{"g":"we / us"},{"g":"to go","l":"aller"},null,null,null,{"g":"all"},{"g":"the / them","l":"le"},{"g":"Sunday","l":"dimanche"}],"phrases":[[2,4,"a la"]]},{"text":"La messe terminée, le prêtre bénit l'assemblée.","en":"The priest blessed the congregation at the end of the mass.","words":[{"g":"the / her"},null,null,{"g":"the / it"},{"g":"priest"},{"g":"to bless","l":"bénir"},{"g":"the / it"},{"g":"assembly"}]}]}