{"id":"attentivement","lemma":"attentivement","pos":"adv","rank":3394,"glosses":["attentively"],"ipa":"/a.tɑ̃.tiv.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/ca/Fr-attentivement.ogg/Fr-attentivement.ogg.mp3","examples":[{"text":"Écoutez-vous attentivement ?","en":"Are you listening closely?","words":[{"g":"to listen","l":"écouter"},{"g":"you"},null]},{"text":"Écoutez attentivement ce que je dis.","en":"Listen attentively to what I say.","words":[{"g":"to listen","l":"écouter"},null,null,null,{"g":"I"},{"g":"to say, to tell","l":"dire"}],"phrases":[[2,4,"what"]]},{"text":"Maintenant, écoutez-moi attentivement.","en":"Now listen to me closely.","words":[{"g":"now, currently"},{"g":"to listen","l":"écouter"},{"g":"me"},null]},{"text":"Regarde ce problème plus attentivement.","en":"Look into the matter more carefully.","audio":"https://tatoeba.org/en/audio/download/27993","words":[{"g":"to look at","l":"regarder"},{"g":"this / it"},{"g":"problem"},{"g":"more / no longer"},null]},{"text":"Écoutes-tu attentivement ?","en":"Are you listening closely?","words":[{"g":"to listen","l":"écouter"},{"g":"you"},null]}]}