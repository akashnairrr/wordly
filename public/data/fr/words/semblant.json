{"id":"semblant","lemma":"semblant","pos":"noun","rank":1272,"glosses":["a semblance (of something)"],"ipa":"/sɑ̃.blɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/de/LL-Q150_%28fra%29-Pamputt-semblant.wav/LL-Q150_%28fra%29-Pamputt-semblant.wav.mp3","gender":"m","forms":{"plural":"semblants"},"examples":[{"text":"Elle fait juste semblant.","en":"She's just putting up a front.","words":[{"g":"she / it"},{"g":"to do","l":"faire"},{"g":"fair, just"},null]},{"text":"Il faisait semblant de dormir.","en":"He pretended to be sleeping.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"of / from"},{"g":"to sleep"}]},{"text":"Je ne peux plus faire semblant.","en":"I can't pretend anymore.","words":[{"g":"I"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"more / no longer"},{"g":"to do"},null]},{"text":"Il faisait semblant de ne pas écouter.","en":"He pretended not to be listening.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"of / from"},{"g":"not"},{"g":"not"},{"g":"to listen"}]},{"text":"J'ai fait semblant de travailler.","en":"I pretended to work.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to do","l":"faire"},null,{"g":"of / from"},{"g":"to work"}]}]}