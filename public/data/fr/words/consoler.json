ipedia/commons/6/63/LL-Q150_%28fra%29-Lyoko%C3%AF-consola.wav"},"examples":[{"text":"Je peux la consoler.","en":"I can comfort her.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"the / her"},null]},{"text":"Je joue à un jeu sur console.","en":"I'm playing a TV game.","words":[{"g":"I"},{"g":"to play","l":"jouer"},{"g":"to / at"},{"g":"a"},{"g":"game"},{"g":"on"},null]},{"text":"Je ne sais pas quoi dire pour te consoler.","en":"I don't know what to say to make you feel better.","words":[null,null,null,null,{"g":"what"},{"g":"to say, to tell"},{"g":"for"},{"g":"you"},null],"phrases":[[0,4,"I don't know"]]},{"text":"Cela ne me console pas pour autant.","en":"It doesn't make me feel any better.","words":[{"g":"that"},{"g":"not"},{"g":"me"},null,{"g":"not"},null,null],"phrases":[[5,7,"even so"]]},{"text":"Personne ne m'a consolé quand j'étais triste.","en":"No one comforted me when I was sad.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"me"},{"g":"has","l":"avoir"},null,{"g":"when"},{"g":"I"},{"g":"to be","l":"être"},{"g":"sad"}]}]}