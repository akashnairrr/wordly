{"id":"planning","lemma":"planning","pos":"noun","rank":3951,"glosses":["schedule, work plan"],"ipa":"/pla.niŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/LL-Q150_%28fra%29-Poslovitch-planning.wav/LL-Q150_%28fra%29-Poslovitch-planning.wav.mp3","gender":"m","forms":{"plural":"plannings"},"examples":[{"text":"Laisse-moi vérifier dans mon planning.","en":"Let me check my schedule.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},{"g":"to check, to verify"},{"g":"in"},{"g":"my"},null]},{"text":"Je vous enverrai le planning.","en":"I'll send you the schedule.","words":[{"g":"I"},{"g":"you"},{"g":"to send","l":"envoyer"},{"g":"the / it"},null]},{"text":"Son planning a été modifié.","en":"His schedule has been changed.","words":[{"g":"his, her, its"},null,{"g":"has","l":"avoir"},{"g":"summer"},{"g":"to change, modify","l":"modifier"}]},{"text":"Je suis un peu en retard sur mon planning.","en":"I'm a little behind schedule.","words":[{"g":"I"},{"g":"am","l":"être"},null,null,null,null,{"g":"on"},{"g":"my"},null],"phrases":[[2,4,"a little, a bit"],[4,6,"late, overdue"]]},{"text":"Ils ont trente minutes de retard sur le planning.","en":"They're 30 minutes behind schedule.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"thirty"},{"g":"minute","l":"minute"},{"g":"of / from"},{"g":"delay"},{"g":"on"},{"g":"the / it"},null]}]}