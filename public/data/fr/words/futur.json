{"id":"futur","lemma":"futur","pos":"noun","rank":926,"glosses":["future (what will happen)","future, future tense"],"ipa":"/fy.tyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/74/Fr-futur.ogg/Fr-futur.ogg.mp3","gender":"m","forms":{"plural":"futurs"},"formAudio":{"futurs":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q150_%28fra%29-LightD31-futurs.wav"},"examples":[{"text":"Pense à ton futur.","en":"Think of your future.","audio":"https://tatoeba.org/en/audio/download/194236","words":[{"g":"to think","l":"penser"},{"g":"to / at"},{"g":"your"},null]},{"text":"Je prie pour un meilleur futur.","en":"I pray for a better future.","words":[{"g":"I"},{"g":"to pray","l":"prier"},{"g":"for"},{"g":"a"},{"g":"best, better"},null]},{"text":"Pouvez-vous vraiment voir le futur ?","en":"Can you really see the future?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"truly"},{"g":"to see"},{"g":"the / it"},null]},{"text":"Je veux parler du futur.","en":"I want to talk about the future.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to speak, talk"},{"g":"of the / some"},null]},{"text":"Personne ne connaît le futur.","en":"No one knows the future.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"to know","l":"connaître"},{"g":"the / it"},null]}]}