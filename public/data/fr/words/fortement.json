{"id":"fortement","lemma":"fortement","pos":"adv","rank":4286,"glosses":["strongly (fulfilling a stricter set of criteria)","highly, extremely, sorely","seriously, greatly"],"ipa":"/fɔʁ.tə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ab/Fr-fortement.ogg/Fr-fortement.ogg.mp3","examples":[{"text":"J'en doute fortement.","en":"I highly doubt that.","words":[{"g":"I"},{"g":"in / of it"},{"g":"doubt"},null]},{"text":"Elle ressemble fortement à sa grand-mère.","en":"She strongly resembles her grandmother.","words":[{"g":"she / it"},{"g":"to resemble","l":"ressembler"},null,{"g":"to / at"},{"g":"his"},{"g":"big"},{"g":"mother"}]},{"text":"Ceci est fortement recommandé.","en":"This is highly recommended.","words":[{"g":"this"},{"g":"is","l":"être"},null,{"g":"recommended"}]},{"text":"Le palais était fortement gardé.","en":"The palace was heavily guarded.","words":[{"g":"the / it"},{"g":"palace"},{"g":"to be","l":"être"},null,{"g":"to keep","l":"garder"}]},{"text":"Il pleut fortement.","en":"It's raining hard.","words":[{"g":"he / it"},{"g":"to rain","l":"pleuvoir"},null]}]}