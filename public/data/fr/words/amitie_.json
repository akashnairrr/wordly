{"id":"amitie_","lemma":"amitié","pos":"noun","rank":1422,"glosses":["friendship, amity"],"ipa":"/a.mi.tje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/37/Fr-amiti%C3%A9.ogg/Fr-amiti%C3%A9.ogg.mp3","gender":"f","forms":{"plural":"amitiés"},"formAudio":{"amitiés":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q150_%28fra%29-Pamputt-amiti%C3%A9s.wav"},"examples":[{"text":"Ton amitié signifie beaucoup pour moi.","en":"Your friendship means a lot to me.","audio":"https://tatoeba.org/en/audio/download/29367","words":[{"g":"your"},null,{"g":"to signify, mean","l":"signifier"},{"g":"much, very much, a lot"},{"g":"for"},{"g":"me"}]},{"text":"Mon frère vous envoie ses amitiés.","en":"My brother sends you his regards.","words":[{"g":"my"},{"g":"brother"},{"g":"you"},{"g":"to send","l":"envoyer"},{"g":"his"},null]},{"text":"Je crois en l'amitié.","en":"I believe in friendship.","words":[{"g":"I"},{"g":"to believe","l":"croire"},{"g":"in / of it"},{"g":"the / it"},null]},{"text":"Quoi de mieux que l'amitié ?","en":"What is better than friendship?","words":[{"g":"what"},{"g":"of / from"},{"g":"better"},{"g":"that / what"},{"g":"the / it"},null]},{"text":"Notre amitié m'est très importante.","en":"Our friendship is very important to me.","words":[{"g":"our"},null,{"g":"me"},{"g":"is","l":"être"},{"g":"very"},{"g":"important","l":"important"}]}]}