{"id":"soudain","lemma":"soudain","pos":"adv","rank":1681,"glosses":["suddenly, all of a sudden"],"ipa":"/su.dɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/Fr-soudain.ogg/Fr-soudain.ogg.mp3","examples":[{"text":"Le temps a soudain changé.","en":"The weather changed suddenly.","words":[{"g":"the / it"},{"g":"time"},{"g":"has","l":"avoir"},null,{"g":"to exchange","l":"changer"}]},{"text":"Son départ soudain nous a tous surpris.","en":"Her sudden departure surprised us all.","words":[{"g":"his, her, its"},{"g":"departure, start"},null,{"g":"we / us"},{"g":"has","l":"avoir"},{"g":"all"},{"g":"surprised"}]},{"text":"La porte s'ouvrit soudain.","en":"The door opened suddenly.","words":[{"g":"the / her"},{"g":"door"},{"g":"oneself / if"},{"g":"to open","l":"ouvrir"},null]},{"text":"Un chien me sauta soudain dessus.","en":"A dog suddenly jumped at me.","words":[{"g":"a"},{"g":"dog"},{"g":"me"},{"g":"to jump, leap","l":"sauter"},null,{"g":"on"}]},{"text":"La lumière est soudain apparue.","en":"The light came on suddenly.","words":[{"g":"the / her"},{"g":"light"},{"g":"is","l":"être"},null,null]}]}