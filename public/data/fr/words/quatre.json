{"id":"quatre","lemma":"quatre","pos":"num","rank":365,"glosses":["four"],"ipa":"/katʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f2/Fr-quatre.ogg/Fr-quatre.ogg.mp3","examples":[{"text":"Nous avons quatre cours le matin.","en":"We have four classes in the morning.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"class, lesson"},{"g":"the / it"},{"g":"morning"}]},{"text":"Deux et deux font quatre.","en":"Two and two is four.","words":[{"g":"two"},{"g":"and"},{"g":"two"},{"g":"to do","l":"faire"},null]},{"text":"Une table a quatre pieds.","en":"A table has four legs.","words":[{"g":"a"},{"g":"table"},{"g":"has","l":"avoir"},null,{"g":"foot","l":"pied"}]},{"text":"Nous sommes une famille de quatre.","en":"We are a family of four.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"a"},{"g":"family"},{"g":"of / from"},null]},{"text":"Un jour compte vingt-quatre heures.","en":"A day has twenty-four hours.","words":[null,null,{"g":"account"},{"g":"twenty"},null,{"g":"hour, time","l":"heure"}],"phrases":[[0,2,"one day, someday"]]}]}