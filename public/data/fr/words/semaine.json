{"id":"semaine","lemma":"semaine","pos":"noun","rank":308,"glosses":["week"],"ipa":"/sə.mɛn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ef/Fr-semaine.ogg/Fr-semaine.ogg.mp3","gender":"f","forms":{"plural":"semaines"},"formAudio":{"semaines":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q150_%28fra%29-Le_Commissaire-semaines.wav"},"examples":[{"text":"Qu'avez-vous fait cette semaine ?","en":"What have you done this week?","audio":"https://tatoeba.org/en/audio/download/334224","words":[{"g":"that / what"},{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to do","l":"faire"},{"g":"it, this, that","l":"ce"},null]},{"text":"Nous avons trois semaines.","en":"We have three weeks.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"three"},null]},{"text":"Donne-moi une semaine.","en":"Give me a week.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null]},{"text":"Tu peux attendre quelques semaines ?","en":"Can you wait a few weeks?","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to wait for, to await"},{"g":"some","l":"quelque"},null]},{"text":"Elles le font chaque semaine.","en":"They do it each week.","words":[{"g":"they"},{"g":"the / it"},{"g":"to do","l":"faire"},{"g":"each"},null]}]}