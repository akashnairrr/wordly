{"id":"botte","lemma":"botte","pos":"noun","rank":2184,"glosses":["bunch, bundle (of flowers, vegetables)","bundle, sheaf (of grain)","bale (bundle of compressed wool or hay)"],"ipa":"/bɔt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/de/Fr-botte.ogg/Fr-botte.ogg.mp3","gender":"f","forms":{"plural":"bottes"},"formAudio":{"bottes":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q150_%28fra%29-Aemines1-bottes.wav"},"examples":[{"text":"Donnez-moi une botte de persil.","en":"Give me a bunch of parsley.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null,{"g":"of / from"},{"g":"parsley"}]},{"text":"Ça me botte.","en":"I enjoy it.","words":[{"g":"that"},{"g":"me"},null]},{"text":"Le chien a rongé ma botte.","en":"The dog chewed up my boot.","words":[{"g":"the / it"},{"g":"dog"},{"g":"has","l":"avoir"},{"g":"to gnaw","l":"ronger"},{"g":"my","l":"mon"},null]},{"text":"Je voudrais acheter quelques bottes.","en":"I would like to purchase some boots.","audio":"https://tatoeba.org/en/audio/download/27889","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to purchase"},{"g":"some","l":"quelque"},null]},{"text":"Je mets des bottes.","en":"I'm putting boots on.","audio":"https://tatoeba.org/en/audio/download/1093036","words":[{"g":"I"},{"g":"to put","l":"mettre"},{"g":"some / of the","l":"un"},null]}]}