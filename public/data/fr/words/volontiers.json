{"id":"volontiers","lemma":"volontiers","pos":"adv","rank":2980,"glosses":["willingly; gladly; with pleasure"],"ipa":"/vɔ.lɔ̃.tje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7a/Fr-volontiers.ogg/Fr-volontiers.ogg.mp3","examples":[{"text":"Il l'a fait volontiers.","en":"He did it willingly.","words":[{"g":"he / it"},{"g":"the / it"},{"g":"has","l":"avoir"},{"g":"to do","l":"faire"},null]},{"text":"Je vous payerais volontiers.","en":"I'd be willing to pay you.","words":[{"g":"I"},{"g":"you"},{"g":"to pay","l":"payer"},null]},{"text":"Il lit volontiers des livres.","en":"He likes to read books.","words":[{"g":"he / it"},{"g":"bed"},null,{"g":"some / of the","l":"un"},{"g":"book","l":"livre"}]},{"text":"Je t'aiderai volontiers.","en":"I will gladly help you.","words":[{"g":"I"},{"g":"you"},{"g":"to help","l":"aider"},null]},{"text":"Nous acceptons volontiers ton offre.","en":"We gladly accept your offer.","words":[{"g":"we / us"},{"g":"to accept","l":"accepter"},null,{"g":"your"},{"g":"offer"}]}]}