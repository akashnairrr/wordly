{"id":"maternel","lemma":"maternel","pos":"adj","rank":4243,"glosses":["maternal","native"],"ipa":"/ma.tɛʁ.nɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/02/Fr-maternel.ogg/Fr-maternel.ogg.mp3","forms":{"feminine":"maternelle","masculinePlural":"maternels","femininePlural":"maternelles"},"formAudio":{"maternelle":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q150_%28fra%29-WikiLucas00-maternelle.wav","maternelles":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q150_%28fra%29-WikiLucas00-maternelles.wav"},"examples":[{"text":"Ma langue maternelle est le français.","en":"My native language is French.","words":[{"g":"my","l":"mon"},{"g":"tongue"},null,{"g":"is","l":"être"},{"g":"the / it"},{"g":"French"}]},{"text":"Il a deux tantes du côté maternel.","en":"He has two aunts on his mother's side.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"two"},{"g":"aunt","l":"tante"},{"g":"of the / some"},{"g":"side"},null]},{"text":"Es-tu de langue maternelle française ?","en":"Are you a native French speaker?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"of / from"},{"g":"tongue"},null,{"g":"French","l":"français"}]},{"text":"Ma petite sœur va à l'école maternelle.","en":"My little sister goes to nursery school.","words":[{"g":"my","l":"mon"},null,null,{"g":"to go","l":"aller"},{"g":"to / at"},{"g":"the / it"},{"g":"school"},null],"phrases":[[1,3,"little sister"]]},{"text":"Mon grand-père maternel fête son soixantième anniversaire demain.","en":"My grandfather on my mother's side is celebrating his 60th birthday tomorrow.","words":[{"g":"my"},{"g":"big"},{"g":"father"},null,{"g":"party, celebration"},{"g":"his, her, its"},null,{"g":"birthday"},{"g":"tomorrow"}]}]}