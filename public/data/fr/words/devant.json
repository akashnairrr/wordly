{"id":"devant","lemma":"devant","pos":"prep","rank":273,"glosses":["in front of"],"ipa":"/də.vɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/58/Fr-devant.ogg/Fr-devant.ogg.mp3","examples":[{"text":"Marche devant moi.","en":"Walk ahead of me.","audio":"https://tatoeba.org/en/audio/download/38749","words":[{"g":"to walk","l":"marcher"},null,{"g":"me"}]},{"text":"Nous avons un long voyage devant nous.","en":"We have a long trip ahead of us.","audio":"https://tatoeba.org/en/audio/download/653740","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"long"},{"g":"trip, journey, voyage"},null,{"g":"we / us"}]},{"text":"Il est devant la porte.","en":"He is in front of the door.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"the / her"},{"g":"door"}]},{"text":"Tu peux parler devant moi.","en":"You can talk in front of me.","words":[null,null,null,null,{"g":"me"}],"phrases":[[0,3,"look who's talking!…"]]},{"text":"Regarde devant toi !","en":"Look in front of you.","words":[{"g":"to look at","l":"regarder"},null,{"g":"you"}]}]}