{"id":"rapidement","lemma":"rapidement","pos":"adv","rank":1085,"glosses":["speedily; quickly"],"ipa":"/ʁa.pid.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fc/Fr-rapidement.ogg/Fr-rapidement.ogg.mp3","examples":[{"text":"Peux-tu le faire plus rapidement ?","en":"Can you do it faster?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"the / it"},{"g":"to do"},{"g":"more / no longer"},null]},{"text":"Je veux quitter rapidement cet endroit.","en":"I want to leave this place quickly.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to leave, to quit"},null,{"g":"this"},{"g":"place, spot"}]},{"text":"Il marche rapidement.","en":"He walks fast.","words":[{"g":"he / it"},{"g":"to walk","l":"marcher"},null]},{"text":"Viens ici rapidement.","en":"Come here quickly.","words":[{"g":"to come","l":"venir"},{"g":"here"},null]},{"text":"Fais-le rapidement s'il te plaît.","en":"Please do it quickly.","audio":"https://tatoeba.org/en/audio/download/47938","words":[{"g":"to do","l":"faire"},{"g":"the / it"},null,{"g":"oneself / if"},{"g":"he / it"},{"g":"you"},{"g":"to please","l":"plaire"}]}]}