{"id":"quatrie_me","lemma":"quatrième","pos":"adj","rank":2312,"glosses":["fourth"],"ipa":"/ka.tʁi.jɛm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c9/Fr-quatri%C3%A8me.ogg/Fr-quatri%C3%A8me.ogg.mp3","forms":{"plural":"quatrièmes"},"examples":[{"text":"Je suis en classe de quatrième.","en":"I'm in the eighth grade.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"in / of it"},{"g":"class, type, group"},{"g":"of / from"},null]},{"text":"Répétons la quatrième scène.","en":"Let's rehearse the fourth scene.","words":[{"g":"to repeat","l":"répéter"},{"g":"the / her"},null,{"g":"stage"}]},{"text":"Mon appartement se situe au quatrième étage.","en":"My apartment is on the fourth floor.","words":[{"g":"my"},{"g":"apartment, flat"},{"g":"oneself"},{"g":"to locate","l":"situer"},{"g":"to the"},null,{"g":"floor, storey"}]},{"text":"Je suis en quatrième.","en":"I'm an eighth grader.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"in / of it"},null]},{"text":"J'ai pris l'ascenseur jusqu'au quatrième étage.","en":"I took the elevator to the fourth floor.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to take","l":"prendre"},{"g":"the / it"},{"g":"lift, elevator"},null,{"g":"to the"},null,{"g":"floor, storey"}]}]}