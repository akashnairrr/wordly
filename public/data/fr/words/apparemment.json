{"id":"apparemment","lemma":"apparemment","pos":"adv","rank":783,"glosses":["apparently (seemingly)"],"ipa":"/a.pa.ʁa.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/47/Fr-apparemment.ogg/Fr-apparemment.ogg.mp3","examples":[{"text":"L'endroit est apparemment désert.","en":"The place is apparently deserted.","words":[{"g":"the / it"},{"g":"place, spot"},{"g":"is","l":"être"},null,{"g":"deserted"}]},{"text":"Elle est apparemment une honnête femme.","en":"She is apparently an honest woman.","words":[{"g":"she / it"},{"g":"is","l":"être"},null,{"g":"a"},{"g":"honest"},{"g":"woman"}]},{"text":"Apparemment le bus est en retard.","en":"Apparently, the bus is late.","words":[null,{"g":"the / it"},{"g":"bus"},{"g":"is","l":"être"},null,null],"phrases":[[4,6,"late, overdue"]]},{"text":"Apparemment, ce n'est pas exact.","en":"Apparently, that's not correct.","words":[null,{"g":"this / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"not"},{"g":"exact"}]},{"text":"Apparemment, je suis adopté.","en":"Apparently I'm adopted.","words":[null,{"g":"I"},{"g":"am","l":"être"},{"g":"male adoptee"}]}]}