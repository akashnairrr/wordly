{"id":"puissance","lemma":"puissance","pos":"noun","rank":1370,"glosses":["power (physical or figuratively)","dominion (state within the British Empire)"],"ipa":"/pɥi.sɑ̃s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f7/Fr-puissance.ogg/Fr-puissance.ogg.mp3","gender":"f","forms":{"plural":"puissances"},"formAudio":{"puissances":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q150_%28fra%29-Eihel-puissances.wav"},"examples":[{"text":"La troisième puissance de 3 est 27.","en":"3 to the third power is 27.","audio":"https://tatoeba.org/en/audio/download/26304","words":[{"g":"the / her"},{"g":"third"},null,{"g":"of / from"},{"g":"is","l":"être"}]},{"text":"La puissance fait le droit.","en":"Might makes right.","words":[{"g":"the / her"},null,{"g":"to do","l":"faire"},{"g":"the / it"},{"g":"right"}]},{"text":"Ne sous-estime pas ma puissance.","en":"Don't underestimate my power.","words":[{"g":"not"},{"g":"below, under"},{"g":"esteem"},{"g":"not"},{"g":"my","l":"mon"},null]},{"text":"Ma voiture n'a pas assez de puissance.","en":"My car isn't powerful enough.","words":[{"g":"my","l":"mon"},{"g":"car"},{"g":"not"},{"g":"has","l":"avoir"},{"g":"not"},{"g":"to a sufficient or…"},{"g":"of / from"},null]},{"text":"Personne ne l'égale en puissance.","en":"Nobody equals him in strength.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"the / it"},{"g":"equal","l":"égal"},{"g":"in / of it"},null]}]}