{"id":"panier","lemma":"panier","pos":"noun","rank":2777,"glosses":["basket","goal","hoop"],"ipa":"/pa.nje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/87/Fr-panier.ogg/Fr-panier.ogg.mp3","gender":"m","forms":{"plural":"paniers"},"formAudio":{"paniers":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q150_%28fra%29-WikiLucas00-paniers.wav"},"examples":[{"text":"Le chat est dans son panier.","en":"The cat is in its basket.","words":[{"g":"the / it"},{"g":"cat"},{"g":"is","l":"être"},{"g":"in"},{"g":"his, her, its"},null]},{"text":"Mettez tout dans mon panier.","en":"Put everything in my basket.","words":[{"g":"to put","l":"mettre"},{"g":"all"},{"g":"in"},{"g":"my"},null]},{"text":"Le panier était vide.","en":"The basket was empty.","words":[{"g":"the / it"},null,{"g":"to be","l":"être"},{"g":"empty"}]},{"text":"Allons au gymnase et faisons quelques paniers.","en":"Let's go to the gym and shoot some hoops.","words":[{"g":"to go","l":"aller"},{"g":"to the"},{"g":"gym, sports hall"},{"g":"and"},{"g":"to do","l":"faire"},{"g":"some","l":"quelque"},null]},{"text":"Les fruits sont dans le panier.","en":"The fruit is in the basket.","words":[{"g":"the / them","l":"le"},{"g":"fruit","l":"fruit"},{"g":"to be","l":"être"},{"g":"in"},{"g":"the / it"},null]}]}