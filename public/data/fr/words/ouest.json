{"id":"ouest","lemma":"ouest","pos":"noun","rank":1190,"glosses":["west"],"ipa":"/wɛst/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d8/Fr-ouest.ogg/Fr-ouest.ogg.mp3","gender":"m","examples":[{"text":"Le vent souffle de l'ouest.","en":"The wind is blowing from the west.","words":[{"g":"the / it"},{"g":"wind"},{"g":"blowing"},{"g":"of / from"},{"g":"the / it"},null]},{"text":"Nous allons vers l'ouest.","en":"We're going west.","words":[{"g":"we / us"},{"g":"to go","l":"aller"},{"g":"towards"},{"g":"the / it"},null]},{"text":"Le soleil se couche à l'ouest.","en":"The sun sets in the west.","words":[{"g":"the / it"},{"g":"sun"},{"g":"oneself"},{"g":"layer"},{"g":"to / at"},{"g":"the / it"},null]},{"text":"Ma maison est sur le côté ouest de la rue.","en":"My house is on the west side of the street.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"on"},{"g":"the / it"},{"g":"side"},null,null,null,{"g":"street, road"}],"phrases":[[7,9,"of the"]]},{"text":"Il vit à l'ouest de la ville.","en":"He lives in the western part of town.","words":[{"g":"he / it"},{"g":"to see","l":"voir"},{"g":"to / at"},{"g":"the / it"},null,null,null,{"g":"town, city"}],"phrases":[[5,7,"of the"]]}]}