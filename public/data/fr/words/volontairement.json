{"id":"volontairement","lemma":"volontairement","pos":"adv","rank":4643,"glosses":["intentionally, voluntarily"],"ipa":"/vɔ.lɔ̃.tɛʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/40/LL-Q150_%28fra%29-Poslovitch-volontairement.wav/LL-Q150_%28fra%29-Poslovitch-volontairement.wav.mp3","examples":[{"text":"Nous avons volontairement passé son tour.","en":"We skipped his turn on purpose.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},null,{"g":"past"},{"g":"his, her, its"},{"g":"turn, circumference"}]},{"text":"J'ai fait ça volontairement.","en":"I did that voluntarily.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to do","l":"faire"},{"g":"that"},null]},{"text":"J'ai volontairement cassé le vase.","en":"I broke the vase on purpose.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"broken"},{"g":"the / it"},{"g":"silt, mud"}]},{"text":"Je l'ai fait volontairement.","en":"I did that voluntarily.","words":[{"g":"I"},{"g":"the / it"},{"g":"have","l":"avoir"},{"g":"to do","l":"faire"},null]},{"text":"Tom a volontairement laissé la dernière page blanche.","en":"Tom purposely left the last page blank.","words":[null,{"g":"has","l":"avoir"},null,{"g":"to leave","l":"laisser"},{"g":"the / her"},{"g":"last","l":"dernier"},{"g":"page"},{"g":"minim, half note"}]}]}