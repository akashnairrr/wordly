{"id":"envie","lemma":"envie","pos":"noun","rank":341,"glosses":["desire, urge (avoir envie de = to want)","envy"],"ipa":"/ɑ̃.vi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/88/Fr-envie.ogg/Fr-envie.ogg.mp3","gender":"f","forms":{"plural":"envies"},"formAudio":{"envies":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q150_%28fra%29-Lyoko%C3%AF-envies.wav"},"examples":[{"text":"Je vous envie.","en":"I envy you.","audio":"https://tatoeba.org/en/audio/download/472845","words":[{"g":"I"},{"g":"you"},null]},{"text":"Je vous envie votre bonne santé.","en":"I envy your good health.","words":[{"g":"I"},{"g":"you"},null,{"g":"your, belonging to you"},{"g":"good","l":"bon"},{"g":"health"}]},{"text":"J'ai envie de toi.","en":"I want you.","audio":"https://tatoeba.org/en/audio/download/44373","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"of / from"},{"g":"you"}]},{"text":"De quoi avais-tu envie ?","en":"What did you crave?","words":[null,null,{"g":"to have","l":"avoir"},{"g":"you"},null],"phrases":[[0,2,"what was that"]]},{"text":"Je t'envie ta beauté.","en":"I envy you your beauty.","words":[{"g":"I"},{"g":"you"},null,{"g":"your"},{"g":"beauty"}]}]}