{"id":"valable","lemma":"valable","pos":"adj","rank":3730,"glosses":["valid, acceptable"],"ipa":"/va.labl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fc/Fr-valable.ogg/Fr-valable.ogg.mp3","forms":{"plural":"valables"},"formAudio":{"valables":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q150_%28fra%29-WikiLucas00-valables.wav"},"examples":[{"text":"Cette offre est valable cinq jours.","en":"This offer is good for five days.","words":[{"g":"it, this, that","l":"ce"},{"g":"offer"},{"g":"is","l":"être"},null,{"g":"five"},{"g":"day","l":"jour"}]},{"text":"C'est valable aussi pour lui.","en":"That applies to him too.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"too, also, as well"},{"g":"for"},{"g":"him, he, it"}]},{"text":"Les règles sont valables pour tous.","en":"Rules apply to everyone.","words":[{"g":"the / them","l":"le"},{"g":"rule, regulation","l":"règle"},{"g":"to be","l":"être"},null,{"g":"for"},{"g":"all"}]},{"text":"Ce ticket est valable pendant trois mois.","en":"This ticket is valid for three months.","audio":"https://tatoeba.org/en/audio/download/26776","words":[{"g":"this / it"},{"g":"ticket"},{"g":"is","l":"être"},null,{"g":"during"},{"g":"three"},{"g":"month"}]},{"text":"Ce billet est valable pendant deux semaines.","en":"This ticket is good for two weeks.","words":[{"g":"this / it"},{"g":"note, a brief message"},{"g":"is","l":"être"},null,{"g":"during"},{"g":"two"},{"g":"week","l":"semaine"}]}]}