{"id":"invitation","lemma":"invitation","pos":"noun","rank":2054,"glosses":["invitation"],"ipa":"/ɛ̃.vi.ta.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/Fr-invitation.ogg/Fr-invitation.ogg.mp3","gender":"f","forms":{"plural":"invitations"},"examples":[{"text":"Merci beaucoup pour ton invitation.","en":"Thank you very much for your invitation.","words":[null,null,{"g":"for"},{"g":"your"},null],"phrases":[[0,2,"thank you very much"]]},{"text":"Nous avons envoyé les invitations hier.","en":"We sent out the invitations yesterday.","audio":"https://tatoeba.org/en/audio/download/27466","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"to send","l":"envoyer"},{"g":"the / them","l":"le"},null,{"g":"yesterday"}]},{"text":"As-tu accepté son invitation ?","en":"Did you accept his invitation?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to accept","l":"accepter"},{"g":"his, her, its"},null]},{"text":"Avez-vous reçu une invitation ?","en":"Did you receive an invitation?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to receive","l":"recevoir"},{"g":"a"},null]},{"text":"Elle déclina son invitation.","en":"She turned down his invitation.","audio":"https://tatoeba.org/en/audio/download/28214","words":[{"g":"she / it"},null,{"g":"his, her, its"},null]}]}