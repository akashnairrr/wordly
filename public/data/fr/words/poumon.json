{"id":"poumon","lemma":"poumon","pos":"noun","rank":2446,"glosses":["lung"],"ipa":"/pu.mɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/Fr-poumon.ogg/Fr-poumon.ogg.mp3","gender":"m","forms":{"plural":"poumons"},"formAudio":{"poumons":"https://upload.wikimedia.org/wikipedia/commons/8/8b/LL-Q150_%28fra%29-Lyoko%C3%AF-poumons.wav"},"examples":[{"text":"Vous avez un cancer du poumon.","en":"You have lung cancer.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"cancer"},{"g":"of the / some"},null]},{"text":"Il a le cancer des poumons.","en":"He's got lung cancer.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"the / it"},{"g":"cancer"},{"g":"some / of the","l":"un"},null]},{"text":"J'ai mal aux poumons.","en":"My lungs hurt.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"harm, pain, evil"},{"g":"to the"},null]},{"text":"Il est mort d'un cancer du poumon.","en":"He died of lung cancer.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"dead"},{"g":"of / from"},{"g":"a"},{"g":"cancer"},{"g":"of the / some"},null]},{"text":"La petite fille hurla à pleins poumons.","en":"The little girl screamed at the top of her lungs.","words":[{"g":"the / her"},null,null,{"g":"to shout, to yell","l":"hurler"},{"g":"to / at"},{"g":"full, full up","l":"plein"},null],"phrases":[[1,3,"little girl"]]}]}