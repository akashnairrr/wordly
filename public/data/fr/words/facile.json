{"id":"facile","lemma":"facile","pos":"adj","rank":372,"glosses":["easy, simple","easy, promiscuous (consenting readily to sex)"],"ipa":"/fa.sil/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/58/Fr-facile.ogg/Fr-facile.ogg.mp3","forms":{"plural":"faciles"},"formAudio":{"faciles":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q150_%28fra%29-Poslovitch-faciles.wav"},"examples":[{"text":"Ça serait trop facile.","en":"It would be too easy.","audio":"https://tatoeba.org/en/audio/download/240780","words":[{"g":"that"},{"g":"to be","l":"être"},{"g":"too"},null]},{"text":"Ce n'est pas facile.","en":"It's not easy.","audio":"https://tatoeba.org/en/audio/download/251805","words":[{"g":"this / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"not"},null]},{"text":"On commence avec les choses faciles.","en":"Let's start with the easy stuff.","words":[{"g":"we / one"},{"g":"to begin, commence","l":"commencer"},{"g":"with"},{"g":"the / them","l":"le"},{"g":"thing","l":"chose"},null]},{"text":"C'est facile pour moi.","en":"It's easy for me.","audio":"https://tatoeba.org/en/audio/download/1102840","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"for"},{"g":"me"}]},{"text":"Le livre est facile.","en":"The book is easy.","words":[{"g":"the / it"},{"g":"book"},{"g":"is","l":"être"},null]}]}