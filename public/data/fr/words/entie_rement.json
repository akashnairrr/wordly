{"id":"entie_rement","lemma":"entièrement","pos":"adv","rank":1807,"glosses":["entirely"],"ipa":"/ɑ̃.tjɛʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/Fr-enti%C3%A8rement.ogg/Fr-enti%C3%A8rement.ogg.mp3","examples":[{"text":"Je ne suis pas entièrement sûr.","en":"I'm not entirely sure.","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},{"g":"not"},null,{"g":"sure, certain"}]},{"text":"Est-ce entièrement mal ?","en":"Is it all wrong?","words":[{"g":"is","l":"être"},{"g":"this / it"},null,{"g":"harm, pain, evil"}]},{"text":"C'est entièrement possible.","en":"That's entirely possible.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"possible"}]},{"text":"Ce n'est pas entièrement mauvais.","en":"It's not all bad.","words":[{"g":"this / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"not"},null,{"g":"bad"}]},{"text":"Je lui fais entièrement confiance.","en":"I trust him completely.","words":[{"g":"I"},{"g":"him, he, it"},{"g":"to do","l":"faire"},null,{"g":"confidence"}]}]}