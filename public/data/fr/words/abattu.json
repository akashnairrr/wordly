{"id":"abattu","lemma":"abattu","pos":"adj","rank":2409,"glosses":["dejected, dispirited, demoralized"],"ipa":"/a.ba.ty/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/66/LL-Q150_%28fra%29-Kiminou1-abattu.wav/LL-Q150_%28fra%29-Kiminou1-abattu.wav.mp3","forms":{"feminine":"abattue","masculinePlural":"abattus","femininePlural":"abattues"},"formAudio":{"abattue":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q150_%28fra%29-Poslovitch-abattue.wav","abattus":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q150_%28fra%29-Lyoko%C3%AF-abattus.wav","abattues":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q150_%28fra%29-Lepticed7-abattues.wav"},"examples":[{"text":"La tempête a abattu un arbre.","en":"The storm blew down a tree.","words":[{"g":"the / her"},{"g":"storm, tempest"},{"g":"has","l":"avoir"},null,{"g":"a"},{"g":"tree"}]},{"text":"Je me sens abattue.","en":"I'm feeling low.","words":[{"g":"I"},{"g":"me"},{"g":"meaning, sense"},null]},{"text":"Les deux hommes ont été abattus.","en":"Both men were shot.","words":[{"g":"the / them","l":"le"},{"g":"two"},{"g":"man","l":"homme"},{"g":"to have","l":"avoir"},{"g":"summer"},null]},{"text":"L'arbre s'est abattu.","en":"The tree fell down.","words":[{"g":"the / it"},{"g":"tree"},{"g":"oneself / if"},{"g":"is","l":"être"},null]},{"text":"Beaucoup d'arbres ont été abattus.","en":"Many trees were cut down.","words":[{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"tree","l":"arbre"},{"g":"to have","l":"avoir"},{"g":"summer"},null]}]}