{"id":"ordre","lemma":"ordre","pos":"noun","rank":517,"glosses":["order (way in which things are arranged)","order (group)","order (calm)"],"ipa":"/ɔʁdʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a7/Fr-ordre.ogg/Fr-ordre.ogg.mp3","gender":"m","forms":{"plural":"ordres"},"formAudio":{"ordres":"https://upload.wikimedia.org/wikipedia/commons/c/cc/LL-Q150_%28fra%29-WikiLucas00-ordres.wav"},"examples":[{"text":"Mets ta chambre en ordre.","en":"Put your room in order.","words":[{"g":"to put","l":"mettre"},{"g":"your"},{"g":"a room."},{"g":"in / of it"},null]},{"text":"Nous avons tous nos ordres.","en":"We all have our orders.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"all"},{"g":"our","l":"notre"},null]},{"text":"Tout semble être en ordre.","en":"Everything seems to be in order.","words":[{"g":"all"},{"g":"to seem","l":"sembler"},{"g":"to be"},{"g":"in / of it"},null]},{"text":"J'ai des ordres.","en":"I have orders.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"some / of the","l":"un"},null]},{"text":"Est-ce un ordre ?","en":"Is that an order?","words":[{"g":"is","l":"être"},{"g":"this / it"},{"g":"a"},null]}]}