{"id":"proce_s","lemma":"procès","pos":"noun","rank":803,"glosses":["lawsuit","trial"],"ipa":"/pʁɔ.sɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/47/Fr-proc%C3%A8s.ogg/Fr-proc%C3%A8s.ogg.mp3","gender":"m","examples":[{"text":"Je te ferai un procès.","en":"I'll sue you.","words":[{"g":"I"},{"g":"you"},{"g":"to do","l":"faire"},{"g":"a"},null]},{"text":"Elle lui a fait un procès.","en":"She sued him.","words":[{"g":"she / it"},{"g":"him, he, it"},{"g":"has","l":"avoir"},{"g":"to do","l":"faire"},{"g":"a"},null]},{"text":"Il y a eu un procès.","en":"There was a trial.","words":[null,null,null,{"g":"to have","l":"avoir"},{"g":"a"},null],"phrases":[[0,3,"ago"]]},{"text":"Qui est le plaignant dans ce procès ?","en":"Who is the plaintiff in this trial?","words":[{"g":"who"},{"g":"is","l":"être"},{"g":"the / it"},{"g":"to pity","l":"plaindre"},{"g":"in"},{"g":"this / it"},null]},{"text":"Cet homme a son procès la semaine prochaine.","en":"That man is going on trial next week.","words":[{"g":"this"},{"g":"man"},{"g":"has","l":"avoir"},{"g":"his, her, its"},null,{"g":"the / her"},{"g":"week"},{"g":"upcoming","l":"prochain"}]}]}