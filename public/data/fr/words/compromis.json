{"id":"compromis","lemma":"compromis","pos":"noun","rank":2780,"glosses":["compromise, trade-off"],"ipa":"/kɔ̃.pʁɔ.mi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/da/Fr-compromis.ogg/Fr-compromis.ogg.mp3","gender":"m","examples":[{"text":"Nous avons dû faire des compromis.","en":"We had to compromise.","audio":"https://tatoeba.org/en/audio/download/1102737","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"must","l":"devoir"},{"g":"to do"},{"g":"some / of the","l":"un"},null]},{"text":"Faisons un compromis.","en":"Let's compromise.","audio":"https://tatoeba.org/en/audio/download/269868","words":[{"g":"to do","l":"faire"},{"g":"a"},null]},{"text":"Un compromis a été trouvé.","en":"A compromise was reached.","words":[{"g":"a"},null,{"g":"has","l":"avoir"},{"g":"summer"},{"g":"to find","l":"trouver"}]},{"text":"Je ne fais pas de compromis.","en":"I don't compromise.","words":[{"g":"I"},{"g":"not"},{"g":"to do","l":"faire"},{"g":"not"},{"g":"of / from"},null]},{"text":"Il n'y aura aucun compromis.","en":"There will be no compromise.","words":[{"g":"he / it"},{"g":"not"},{"g":"there"},{"g":"to have","l":"avoir"},{"g":"none, no-one"},null]}]}