{"id":"soit","lemma":"soit","pos":"verb","rank":138,"glosses":["let be"],"ipa":"/swa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/21/Fr-soit.ogg/Fr-soit.ogg.mp3","examples":[{"text":"Ainsi soit-il.","en":"Let it be.","audio":"https://tatoeba.org/en/audio/download/472668","words":[{"g":"in this way, thus"},null,{"g":"he / it"}]},{"text":"Que penses-tu que ce soit ?","en":"What do you think this is?","words":[{"g":"that / what"},{"g":"to think","l":"penser"},{"g":"you"},{"g":"that / what"},{"g":"this / it"},null]},{"text":"Que veux-tu que le message soit ?","en":"What do you want the message to be?","words":[{"g":"that / what"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"that / what"},{"g":"the / it"},{"g":"message"},null]},{"text":"Espérons que cela soit vrai.","en":"Let's hope that's true.","words":[{"g":"to hope","l":"espérer"},{"g":"that / what"},{"g":"that"},null,{"g":"true"}]},{"text":"Je veux que ce soit parfait.","en":"I want it to be perfect.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"that / what"},{"g":"this / it"},null,{"g":"perfect"}]}]}