{"id":"dispute","lemma":"dispute","pos":"noun","rank":1839,"glosses":["dispute"],"ipa":"/dis.pyt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9c/Fr-dispute.ogg/Fr-dispute.ogg.mp3","gender":"f","forms":{"plural":"disputes"},"formAudio":{"disputes":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q150_%28fra%29-WikiLucas00-disputes.wav"},"examples":[{"text":"On a eu une énorme dispute.","en":"We had a huge fight.","audio":"https://tatoeba.org/en/audio/download/230605","words":[{"g":"we / one"},{"g":"has","l":"avoir"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"enormous, huge"},null]},{"text":"On se dispute tout le temps.","en":"We fight all the time.","words":[{"g":"we / one"},{"g":"oneself"},null,null,null,null],"phrases":[[3,6,"all the time"]]},{"text":"Je ne me dispute pas.","en":"I'm not arguing.","words":[{"g":"I"},{"g":"not"},{"g":"me"},null,{"g":"not"}]},{"text":"Elle a arrêté notre dispute.","en":"She stopped our fighting.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"to stop","l":"arrêter"},{"g":"our"},null]},{"text":"J'ai été impliqué dans la dispute.","en":"I was involved in the quarrel.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"summer"},{"g":"to implicate","l":"impliquer"},{"g":"in"},{"g":"the / her"},null]}]}