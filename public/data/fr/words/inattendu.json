{"id":"inattendu","lemma":"inattendu","pos":"adj","rank":4766,"glosses":["unexpected"],"ipa":"/i.na.tɑ̃.dy/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/Fr-inattendu.ogg/Fr-inattendu.ogg.mp3","forms":{"feminine":"inattendue","masculinePlural":"inattendus","femininePlural":"inattendues"},"examples":[{"text":"Ce n'était pas inattendu.","en":"It was not unexpected.","words":[{"g":"this / it"},{"g":"not"},{"g":"to be","l":"être"},{"g":"not"},null]},{"text":"Il y avait quelques questions inattendues.","en":"There were some unexpected questions.","words":[{"g":"he / it"},{"g":"there"},{"g":"to have","l":"avoir"},{"g":"some","l":"quelque"},{"g":"question","l":"question"},null]},{"text":"C'est assez inattendu.","en":"That is rather unexpected.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"to a sufficient or…"},null]},{"text":"Ce fut une opportunité inattendue.","en":"It was an unexpected opportunity.","words":[{"g":"this / it"},{"g":"bole","l":"fût"},{"g":"a"},{"g":"a state of opportuneness"},null]},{"text":"L'inattendu arrive toujours.","en":"The unexpected always happens.","words":[{"g":"the / it"},null,{"g":"to arrive","l":"arriver"},{"g":"always"}]}]}