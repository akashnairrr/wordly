{"id":"soudainement","lemma":"soudainement","pos":"adv","rank":2804,"glosses":["suddenly"],"ipa":"/su.dɛn.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5c/Fr-soudainement.ogg/Fr-soudainement.ogg.mp3","examples":[{"text":"Notre train s'est arrêté soudainement.","en":"Our train stopped suddenly.","words":[{"g":"our"},{"g":"train"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"to stop","l":"arrêter"},null]},{"text":"Je suis soudainement fatigué.","en":"I'm suddenly tired.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"tired"}]},{"text":"Je me sens soudainement vieux.","en":"I suddenly feel old.","words":[{"g":"I"},{"g":"me"},{"g":"meaning, sense"},null,{"g":"old"}]},{"text":"Elle est soudainement devenue célèbre.","en":"She suddenly became famous.","words":[{"g":"she / it"},{"g":"is","l":"être"},null,null,{"g":"famous"}]},{"text":"Il est mort assez soudainement.","en":"He passed away quite suddenly.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"dead"},{"g":"to a sufficient or…"},null]}]}