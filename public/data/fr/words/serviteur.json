{"id":"serviteur","lemma":"serviteur","pos":"noun","rank":3513,"glosses":["servant"],"ipa":"/sɛʁ.vi.tœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/da/Fr-serviteur.ogg/Fr-serviteur.ogg.mp3","gender":"m","forms":{"plural":"serviteurs","feminine":"serviteure"},"formAudio":{"serviteurs":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q150_%28fra%29-DenisdeShawi-serviteurs.wav"},"examples":[{"text":"Je ne suis pas ton serviteur.","en":"I'm not your servant.","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},{"g":"not"},{"g":"your"},null]},{"text":"Même ses serviteurs le méprisaient.","en":"Even his servants despised him.","words":[{"g":"same"},{"g":"his"},null,{"g":"the / it"},null]},{"text":"Le serviteur a balayé le sol.","en":"The servant swept the floor.","words":[{"g":"the / it"},null,{"g":"has","l":"avoir"},{"g":"to sweep","l":"balayer"},{"g":"the / it"},{"g":"soil, earth"}]},{"text":"Même ses serviteurs le détestaient.","en":"Even his servants despised him.","words":[{"g":"same"},{"g":"his"},null,{"g":"the / it"},{"g":"to hate, to detest","l":"détester"}]},{"text":"Il n'a qu'un seul serviteur à son service.","en":"He has only one servant to attend on him.","words":[{"g":"he / it"},{"g":"not"},{"g":"has","l":"avoir"},{"g":"that / what"},{"g":"a"},{"g":"alone"},null,{"g":"to / at"},{"g":"his, her, its"},{"g":"service"}]}]}