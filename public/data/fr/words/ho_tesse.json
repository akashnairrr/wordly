{"id":"ho_tesse","lemma":"hôtesse","pos":"noun","rank":4444,"glosses":["hostess"],"ipa":"/o.tɛs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6e/Fr-h%C3%B4tesse.ogg/Fr-h%C3%B4tesse.ogg.mp3","gender":"f","forms":{"plural":"hôtesses","masculine":"hôte"},"formAudio":{"hôte":"https://upload.wikimedia.org/wikipedia/commons/8/8b/LL-Q150_%28fra%29-LoquaxFR-h%C3%B4te.wav"},"examples":[{"text":"J'ai besoin d'une hôtesse.","en":"I need an escort.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"need"},{"g":"of / from"},{"g":"a"},null]},{"text":"Il a épousé une hôtesse.","en":"He married a stewardess.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to marry, to wed","l":"épouser"},{"g":"a"},null]},{"text":"Vous aurez besoin d'une hôtesse armée.","en":"You will need an armed escort.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"need"},{"g":"of / from"},{"g":"a"},null,{"g":"army"}]},{"text":"Buvons à notre charmante hôtesse !","en":"Let's drink to our charming hostess!","words":[{"g":"to drink","l":"boire"},{"g":"to / at"},{"g":"our"},{"g":"charming","l":"charmant"},null]},{"text":"Une hôtesse a été sauvée des débris.","en":"A stewardess was rescued from the wreck.","words":[{"g":"a"},null,{"g":"has","l":"avoir"},{"g":"summer"},null,{"g":"some / of the","l":"un"},{"g":"debris"}]}]}