{"id":"raccourci","lemma":"raccourci","pos":"noun","rank":4841,"glosses":["shortcut (a path between two locations that is shorter than more conventional routes)","foreshortening","shortcut (a file that points to the location of another file and serves as a quick way to access it)"],"ipa":"/ʁa.kuʁ.si/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/35/LL-Q150_%28fra%29-Lepticed7-raccourci.wav/LL-Q150_%28fra%29-Lepticed7-raccourci.wav.mp3","gender":"m","forms":{"plural":"raccourcis"},"formAudio":{"raccourcis":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q150_%28fra%29-WikiLucas00-raccourcis.wav"},"examples":[{"text":"Je connais un raccourci.","en":"I know a shortcut.","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"a"},null]},{"text":"Je raccourcis mon voyage.","en":"I'm cutting my trip short.","words":[{"g":"I"},null,{"g":"my"},{"g":"trip, journey, voyage"}]},{"text":"C'est un raccourci.","en":"It's a shortcut.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},null]},{"text":"Raccourcis un peu cette phrase.","en":"Make this sentence a little shorter.","words":[null,null,null,{"g":"it, this, that","l":"ce"},{"g":"sentence"}],"phrases":[[1,3,"a little, a bit"]]},{"text":"J'ai pris un raccourci.","en":"I took a shortcut.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to take","l":"prendre"},{"g":"a"},null]}]}