{"id":"parmi","lemma":"parmi","pos":"prep","rank":976,"glosses":["among, amongst","amid, amidst"],"ipa":"/paʁ.mi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/Fr-parmi.ogg/Fr-parmi.ogg.mp3","examples":[{"text":"Le tueur est parmi nous.","en":"The killer is among us.","words":[{"g":"the / it"},{"g":"killer"},{"g":"is","l":"être"},null,{"g":"we / us"}]},{"text":"Je serai toujours parmi vous.","en":"I will always be with you.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"always"},null,{"g":"you"}]},{"text":"Il compte parmi mes amis.","en":"He is included among my friends.","words":[{"g":"he / it"},{"g":"account"},null,{"g":"my"},{"g":"friend","l":"ami"}]},{"text":"Parmi eux certains sont mes amis.","en":"Some of them are my friends.","words":[null,{"g":"they","l":"ils"},{"g":"certain, guaranteed","l":"certain"},{"g":"to be","l":"être"},{"g":"my"},{"g":"friend","l":"ami"}]},{"text":"Il sera toujours parmi vous.","en":"He will always be with you.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"always"},null,{"g":"you"}]}]}