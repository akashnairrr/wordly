{"id":"soutenu","lemma":"soutenu","pos":"adj","rank":4379,"glosses":["sustained, maintained, concerted","sustained, lasting, enduring","high-register; formal"],"ipa":"/sut.ny/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/LL-Q150_%28fra%29-WikiLucas00-soutenu.wav/LL-Q150_%28fra%29-WikiLucas00-soutenu.wav.mp3","forms":{"feminine":"soutenue","masculinePlural":"soutenus","femininePlural":"soutenues"},"examples":[{"text":"Personne ne m'a soutenu.","en":"No one supported me.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"me"},{"g":"has","l":"avoir"},null]},{"text":"Son grand-père a toujours soutenu ses idées.","en":"His grandfather always supported his ideas.","words":[{"g":"his, her, its"},{"g":"big"},{"g":"father"},{"g":"has","l":"avoir"},{"g":"always"},null,{"g":"his"},{"g":"idea","l":"idée"}]},{"text":"Ils ont soutenu son droit à parler librement.","en":"They supported his right to speak freely.","words":[{"g":"they"},{"g":"to have","l":"avoir"},null,{"g":"his, her, its"},{"g":"right"},{"g":"to / at"},{"g":"to speak, talk"},{"g":"freely"}]},{"text":"Personne n'a soutenu ce que j'ai dit.","en":"Nobody backed up what I said.","words":[{"g":"no one, nobody"},{"g":"not"},{"g":"has","l":"avoir"},null,null,null,{"g":"I"},{"g":"have","l":"avoir"},{"g":"to say, to tell","l":"dire"}],"phrases":[[4,6,"what"]]},{"text":"Il y a eu une croissance soutenue de la population.","en":"There was a steady increase in population.","words":[null,null,null,{"g":"to have","l":"avoir"},{"g":"a"},{"g":"growth"},null,null,null,{"g":"population"}],"phrases":[[0,3,"ago"],[7,9,"of the"]]}]}