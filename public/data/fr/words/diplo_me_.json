{"id":"diplo_me_","lemma":"diplômé","pos":"adj","rank":4282,"glosses":["having a diploma or a degree"],"ipa":"/di.plo.me/","forms":{"feminine":"diplômée","masculinePlural":"diplômés","femininePlural":"diplômées"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q150_%28fra%29-VictorDtmtc-dipl%C3%B4m%C3%A9.wav","formAudio":{"diplômée":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q150_%28fra%29-Loizbec-dipl%C3%B4m%C3%A9e.wav"},"examples":[{"text":"Elle est infirmière diplômée.","en":"She is qualified as a nurse.","words":[{"g":"she / it"},{"g":"is","l":"être"},{"g":"nurse"},null]},{"text":"Je serai diplômé cette année.","en":"I'll graduate this year.","words":[{"g":"I"},{"g":"to be","l":"être"},null,{"g":"it, this, that","l":"ce"},{"g":"year"}]},{"text":"Je serai diplômée l'année prochaine.","en":"I'll graduate next year.","words":[{"g":"I"},{"g":"to be","l":"être"},null,{"g":"the / it"},{"g":"year"},{"g":"upcoming","l":"prochain"}]},{"text":"Je n'ai pas été diplômé.","en":"I didn't graduate.","words":[{"g":"I"},{"g":"not"},{"g":"have","l":"avoir"},{"g":"not"},{"g":"summer"},null]},{"text":"Que voulez-vous faire après que vous aurez été diplômés ?","en":"What do you want to do after you graduate?","words":[{"g":"that / what"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to do"},null,null,{"g":"you"},{"g":"to have","l":"avoir"},{"g":"summer"},null],"phrases":[[4,6,"after"]]}]}