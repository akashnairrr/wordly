{"id":"chez","lemma":"chez","pos":"prep","rank":123,"glosses":["to, at, in or into the place of","to, at or in the country of","in; among (a group of things or people of the same type)"],"ipa":"/ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1c/Fr-chez.ogg/Fr-chez.ogg.mp3","examples":[{"text":"Es-tu chez toi ?","en":"Are you home?","audio":"https://tatoeba.org/en/audio/download/474405","words":[{"g":"are","l":"être"},{"g":"you"},null,{"g":"you"}]},{"text":"Êtes-vous chez vous ?","en":"Are you home?","audio":"https://tatoeba.org/en/audio/download/474406","words":[{"g":"to be","l":"être"},{"g":"you"},null,{"g":"you"}]},{"text":"Pouvons-nous juste rentrer chez nous ?","en":"Can we just go home?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"we / us"},{"g":"fair, just"},{"g":"to go back"},null,{"g":"we / us"}]},{"text":"Je dois rentrer chez moi.","en":"I must go home.","audio":"https://tatoeba.org/en/audio/download/2123","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"to go back"},null,{"g":"me"}]},{"text":"Va chez toi, maintenant.","en":"Go home now.","audio":"https://tatoeba.org/en/audio/download/473716","words":[{"g":"to go","l":"aller"},null,{"g":"you"},{"g":"now, currently"}]}]}