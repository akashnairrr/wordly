{"id":"e_paule","lemma":"épaule","pos":"noun","rank":1998,"glosses":["shoulder"],"ipa":"/e.pol/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d9/Fr-%C3%A9paule.ogg/Fr-%C3%A9paule.ogg.mp3","gender":"f","forms":{"plural":"épaules"},"formAudio":{"épaules":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q150_%28fra%29-Eihel-%C3%A9paules.wav"},"examples":[{"text":"Il a touché mon épaule.","en":"He touched my shoulder.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to touch","l":"toucher"},{"g":"my"},null]},{"text":"Il a la tête sur les épaules.","en":"He has a head on his shoulders.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"the / her"},{"g":"head"},{"g":"on"},{"g":"the / them","l":"le"},null]},{"text":"Je mets la main sur son épaule.","en":"I put my hand on his shoulder.","words":[{"g":"I"},{"g":"to put","l":"mettre"},{"g":"the / her"},{"g":"hand"},{"g":"on"},{"g":"his, her, its"},null]},{"text":"Mes épaules me font mal.","en":"My shoulders hurt.","words":[{"g":"my"},null,{"g":"me"},{"g":"to do","l":"faire"},{"g":"harm, pain, evil"}]},{"text":"Mon épaule droite me fait mal.","en":"My right shoulder hurts.","words":[{"g":"my"},null,{"g":"right"},{"g":"me"},{"g":"to do","l":"faire"},{"g":"harm, pain, evil"}]}]}