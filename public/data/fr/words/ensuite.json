{"id":"ensuite","lemma":"ensuite","pos":"adv","rank":380,"glosses":["in turn, subsequently, thereafter, then"],"ipa":"/ɑ̃.sɥit/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/46/Fr-ensuite.ogg/Fr-ensuite.ogg.mp3","examples":[{"text":"Que pensez-vous faire ensuite ?","en":"What do you think you'll do next?","words":[{"g":"that / what"},{"g":"to think","l":"penser"},{"g":"you"},{"g":"to do"},null]},{"text":"Dis-moi où aller ensuite.","en":"Tell me where to go next.","words":[{"g":"to say, to tell","l":"dire"},{"g":"me"},{"g":"where"},{"g":"to go"},null]},{"text":"Que suis-je censé faire ensuite ?","en":"What am I to do next?","words":[{"g":"that / what"},{"g":"am","l":"être"},{"g":"I"},{"g":"supposed to, meant to"},{"g":"to do"},null]},{"text":"Nous devons décider quoi faire ensuite.","en":"We must decide what to do next.","words":[{"g":"we / us"},{"g":"must","l":"devoir"},{"g":"to decide"},{"g":"what"},{"g":"to do"},null]},{"text":"Qu'as-tu fait, ensuite ?","en":"What did you do then?","words":[{"g":"that / what"},{"g":"have","l":"avoir"},{"g":"you"},{"g":"to do","l":"faire"},null]}]}