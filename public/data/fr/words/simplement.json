{"id":"simplement","lemma":"simplement","pos":"adv","rank":530,"glosses":["simply"],"ipa":"/sɛ̃.plə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/64/Fr-simplement.ogg/Fr-simplement.ogg.mp3","examples":[{"text":"Pourquoi ne pas simplement rester ?","en":"Why not just stay?","words":[{"g":"why"},{"g":"not"},{"g":"not"},null,{"g":"to stay"}]},{"text":"Dites simplement non !","en":"Just say no.","audio":"https://tatoeba.org/en/audio/download/474618","words":[{"g":"to say, to tell","l":"dire"},null,{"g":"no"}]},{"text":"Je veux simplement la vérité.","en":"I just want the truth.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,{"g":"the / her"},{"g":"truth"}]},{"text":"Je veux simplement être son ami.","en":"I just want to be his friend.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,{"g":"to be"},{"g":"his, her, its"},{"g":"friend"}]},{"text":"Je voulais simplement te parler.","en":"I just wanted to talk to you.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,{"g":"you"},{"g":"to speak, talk"}]}]}