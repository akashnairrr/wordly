{"id":"manifestement","lemma":"manifestement","pos":"adv","rank":3976,"glosses":["obviously"],"ipa":"/ma.ni.fɛs.tə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/24/Fr-manifestement.ogg/Fr-manifestement.ogg.mp3","examples":[{"text":"Manifestement, elle est malade.","en":"Obviously, she's sick.","words":[null,{"g":"she / it"},{"g":"is","l":"être"},{"g":"ill, sick"}]},{"text":"Manifestement, il y a un problème.","en":"Obviously, there's a problem.","words":[null,null,null,null,{"g":"a"},{"g":"problem"}],"phrases":[[1,4,"ago"]]},{"text":"Il se passe manifestement quelque chose.","en":"There's obviously something going on.","words":[{"g":"he / it"},{"g":"oneself"},{"g":"to pass","l":"passer"},null,null,null],"phrases":[[4,6,"something"]]},{"text":"Il était manifestement saoul.","en":"He was obviously drunk.","words":[{"g":"he / it"},{"g":"to be","l":"être"},null,{"g":"drunk"}]},{"text":"Elle était manifestement contente des résultats.","en":"She was clearly satisfied with the results.","words":[{"g":"she / it"},{"g":"to be","l":"être"},null,{"g":"content","l":"content"},{"g":"some / of the","l":"un"},{"g":"outcome","l":"résultat"}]}]}