{"id":"marchant","lemma":"marchant","pos":"adj","rank":4996,"glosses":["walking"],"ipa":"/maʁ.ʃɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/96/LL-Q150_%28fra%29-Pamputt-marchant.wav/LL-Q150_%28fra%29-Pamputt-marchant.wav.mp3","forms":{"feminine":"marchante","masculinePlural":"marchants","femininePlural":"marchantes"},"examples":[{"text":"Il parlait en marchant.","en":"He was talking as he walked.","words":[{"g":"he / it"},{"g":"to speak, talk","l":"parler"},{"g":"in / of it"},null]},{"text":"Ne lis pas en marchant.","en":"Do not read while walking.","words":[{"g":"not"},{"g":"lily"},{"g":"not"},{"g":"in / of it"},null]},{"text":"Je vais à l'école en marchant.","en":"I walk to school.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to / at"},{"g":"the / it"},{"g":"school"},{"g":"in / of it"},null]},{"text":"J'ai traversé le parc en marchant.","en":"I walked across the park.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to cross, to go across","l":"traverser"},{"g":"the / it"},{"g":"park"},{"g":"in / of it"},null]},{"text":"Il s'est perdu en marchant dans les bois.","en":"He got lost while walking in the woods.","words":[{"g":"he / it"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"lost"},{"g":"in / of it"},null,{"g":"in"},{"g":"the / them","l":"le"},{"g":"wood"}]}]}