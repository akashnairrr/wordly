{"id":"tonnerre","lemma":"tonnerre","pos":"noun","rank":3263,"glosses":["thunder"],"ipa":"/tɔ.nɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9b/Fr-tonnerre.ogg/Fr-tonnerre.ogg.mp3","gender":"m","forms":{"plural":"tonnerres"},"formAudio":{"tonnerres":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q150_%28fra%29-Eihel-tonnerres.wav"},"examples":[{"text":"Elle a peur du tonnerre.","en":"She is frightened of thunder.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"fear"},{"g":"of the / some"},null]},{"text":"Tu as entendu le tonnerre gronder ?","en":"Did you hear the thunder rumbling?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"to hear","l":"entendre"},{"g":"the / it"},null,{"g":"to rumble, roar"}]},{"text":"Ça a été comme un coup de tonnerre.","en":"It was like a bolt out of the blue.","words":[null,null,null,{"g":"as"},null,null,{"g":"of / from"},null],"phrases":[[0,3,"was everything OK?"],[4,6,"once, one time"]]},{"text":"Il y a du tonnerre et des éclairs.","en":"There's thunder and lightning.","words":[null,null,null,{"g":"of the / some"},null,{"g":"and"},{"g":"some / of the","l":"un"},{"g":"lightning bolt","l":"éclair"}],"phrases":[[0,3,"ago"]]},{"text":"La foudre précède le tonnerre.","en":"Lightning precedes thunder.","words":[{"g":"the / her"},{"g":"lightning"},{"g":"to precede","l":"précéder"},{"g":"the / it"},null]}]}