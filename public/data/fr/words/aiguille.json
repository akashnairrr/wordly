{"id":"aiguille","lemma":"aiguille","pos":"noun","rank":2909,"glosses":["needle","needle (of a compass)","hand (of a watch)"],"ipa":"/ɛ.ɡɥij/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f1/Fr-aiguille.ogg/Fr-aiguille.ogg.mp3","gender":"f","forms":{"plural":"aiguilles"},"formAudio":{"aiguilles":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q150_%28fra%29-Poslovitch-aiguilles.wav"},"examples":[{"text":"Une horloge a deux aiguilles.","en":"A clock has two hands.","words":[{"g":"a"},{"g":"clock"},{"g":"has","l":"avoir"},{"g":"two"},null]},{"text":"L'aiguille des heures est cassée.","en":"The hour hand is broken.","words":[{"g":"the / it"},null,{"g":"some / of the","l":"un"},{"g":"hour, time","l":"heure"},{"g":"is","l":"être"},{"g":"broken","l":"cassé"}]},{"text":"L'aiguille indique le nord.","en":"The needle is pointing toward the north.","words":[{"g":"the / it"},null,{"g":"to connote","l":"indiquer"},{"g":"the / it"},{"g":"north"}]},{"text":"Elle coud avec une aiguille et du fil.","en":"She sews with a needle and thread.","words":[{"g":"she / it"},{"g":"to sew","l":"coudre"},{"g":"with"},{"g":"a"},null,{"g":"and"},{"g":"of the / some"},{"g":"yarn, thread, wire"}]},{"text":"La petite aiguille est cassée.","en":"The hour hand is broken.","words":[{"g":"the / her"},{"g":"small, little","l":"petit"},null,{"g":"is","l":"être"},{"g":"broken","l":"cassé"}]}]}