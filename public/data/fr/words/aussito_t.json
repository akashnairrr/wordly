{"id":"aussito_t","lemma":"aussitôt","pos":"adv","rank":3408,"glosses":["immediately"],"ipa":"/o.si.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/Fr-aussit%C3%B4t.ogg/Fr-aussit%C3%B4t.ogg.mp3","examples":[{"text":"Je serai là aussitôt.","en":"I'll be there right away.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"there"},null]},{"text":"Je reviendrai aussitôt que je peux.","en":"I'll come back home as soon as I can.","words":[{"g":"I"},{"g":"to come back","l":"revenir"},null,{"g":"that / what"},{"g":"I"},{"g":"can, to be able to","l":"pouvoir"}]},{"text":"Vous devez commencer aussitôt que possible.","en":"You have to begin as soon as possible.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to begin, commence"},null,{"g":"that / what"},{"g":"possible"}]},{"text":"Si nécessaire, je viendrai aussitôt.","en":"If necessary, I'll come soon.","words":[null,null,{"g":"I"},{"g":"to come","l":"venir"},null],"phrases":[[0,2,"if need be"]]},{"text":"Fais-moi savoir aussitôt qu'il arrive !","en":"Let me know as soon as he comes.","words":[{"g":"to do","l":"faire"},{"g":"me"},{"g":"to know"},null,{"g":"that / what"},{"g":"he / it"},{"g":"to arrive","l":"arriver"}]}]}