{"id":"marteau","lemma":"marteau","pos":"noun","rank":2977,"glosses":["a hammer used for pounding","a machine tool that pounds","a hammer-shaped tool used to hit something, such as a gavel"],"ipa":"/maʁ.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7a/Fr-marteau.ogg/Fr-marteau.ogg.mp3","gender":"m","forms":{"plural":"marteaux"},"formAudio":{"marteaux":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q150_%28fra%29-Lyoko%C3%AF-marteaux.wav"},"examples":[{"text":"Donne-moi un marteau.","en":"Give me a hammer.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null]},{"text":"Où ai-je mis le marteau ?","en":"Where did I put the hammer?","words":[{"g":"where"},{"g":"have","l":"avoir"},{"g":"I"},{"g":"to put","l":"mettre"},{"g":"the / it"},null]},{"text":"Tu peux me passer le marteau ?","en":"Could you hand me the hammer?","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"me"},{"g":"to pass"},{"g":"the / it"},null]},{"text":"Passe-moi le marteau, tu veux ?","en":"Hand me the hammer, will you?","words":[{"g":"to pass","l":"passer"},{"g":"me"},{"g":"the / it"},null,{"g":"you"},{"g":"to want, wish, desire","l":"vouloir"}]},{"text":"Regarde ce grand marteau.","en":"Look at that big hammer.","words":[{"g":"to look at","l":"regarder"},{"g":"this / it"},{"g":"big"},null]}]}