{"id":"janvier","lemma":"janvier","pos":"noun","rank":3169,"glosses":["January"],"ipa":"/ʒɑ̃.vje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/Fr-janvier.ogg/Fr-janvier.ogg.mp3","gender":"m","forms":{"plural":"janviers"},"formAudio":{"janviers":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q150_%28fra%29-0x010C-janviers.wav"},"examples":[{"text":"Chez nous, il neige en janvier.","en":"We have snow in January.","words":[{"g":"to"},{"g":"we / us"},{"g":"he / it"},{"g":"snow"},{"g":"in / of it"},null]},{"text":"Je passe un examen en janvier.","en":"I'm taking an exam in January.","words":[{"g":"I"},{"g":"to pass","l":"passer"},{"g":"a"},{"g":"examination"},{"g":"in / of it"},null]},{"text":"Je l'ai rencontré en janvier.","en":"I met him in January.","words":[{"g":"I"},{"g":"the / it"},{"g":"have","l":"avoir"},{"g":"to meet","l":"rencontrer"},{"g":"in / of it"},null]},{"text":"Janvier est le premier mois de l'année.","en":"January is the first month of the year.","words":[null,{"g":"is","l":"être"},{"g":"the / it"},{"g":"first"},{"g":"month"},{"g":"of / from"},{"g":"the / it"},{"g":"year"}]},{"text":"Janvier est normalement le mois le plus froid.","en":"January is usually the coldest month.","words":[null,{"g":"is","l":"être"},{"g":"in theory"},{"g":"the / it"},{"g":"month"},{"g":"the / it"},{"g":"more / no longer"},{"g":"cold"}]}]}