{"id":"instant","lemma":"instant","pos":"noun","rank":359,"glosses":["moment, instant"],"ipa":"/ɛ̃s.tɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ed/Fr-instant.ogg/Fr-instant.ogg.mp3","gender":"m","forms":{"plural":"instants"},"examples":[{"text":"Avez-vous un instant ?","en":"Do you have a moment?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"a"},null]},{"text":"Je serai prête dans quelques instants.","en":"I'll be ready in a few moments.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"ready","l":"prêt"},{"g":"in"},{"g":"some","l":"quelque"},null]},{"text":"Puis-je te parler un instant ?","en":"Can I speak to you a moment?","words":[{"g":"then"},{"g":"I"},{"g":"you"},{"g":"to speak, talk"},{"g":"a"},null]},{"text":"Voudrais-tu venir ici un instant ?","en":"Would you come here a moment?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to come"},{"g":"here"},{"g":"a"},null]},{"text":"Donnez-moi un instant.","en":"Give me a moment.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"a"},null]}]}