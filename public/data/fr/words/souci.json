{"id":"souci","lemma":"souci","pos":"noun","rank":1242,"glosses":["worry; concern","a problem"],"ipa":"/su.si/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/Fr-souci.ogg/Fr-souci.ogg.mp3","gender":"m","forms":{"plural":"soucis"},"formAudio":{"soucis":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q150_%28fra%29-Eihel-soucis.wav"},"examples":[{"text":"Je me fais vraiment du souci.","en":"I do worry.","audio":"https://tatoeba.org/en/audio/download/472847","words":[{"g":"I"},{"g":"me"},{"g":"to do","l":"faire"},{"g":"truly"},{"g":"of the / some"},null]},{"text":"Oubliez vos soucis.","en":"Forget your cares.","audio":"https://tatoeba.org/en/audio/download/1095563","words":[{"g":"to forget","l":"oublier"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Je comprends ton souci.","en":"I understand your concern.","words":[{"g":"I"},{"g":"to understand","l":"comprendre"},{"g":"your"},null]},{"text":"Quel est exactement ton souci ?","en":"What exactly is your concern?","words":[{"g":"which"},{"g":"is","l":"être"},{"g":"exactly, quite"},{"g":"your"},null]},{"text":"Plus d'argent, plus de soucis.","en":"More money means more problems.","words":[{"g":"more / no longer"},{"g":"of / from"},{"g":"money"},{"g":"more / no longer"},{"g":"of / from"},null]}]}