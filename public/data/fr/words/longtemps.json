{"id":"longtemps","lemma":"longtemps","pos":"adv","rank":241,"glosses":["for a long time; over a long period"],"ipa":"/lɔ̃.tɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9c/Fr-longtemps.ogg/Fr-longtemps.ogg.mp3","examples":[{"text":"Penses-tu rester longtemps ?","en":"Do you think you'll stay long?","words":[{"g":"to think","l":"penser"},{"g":"you"},{"g":"to stay"},null]},{"text":"Pensez-vous rester longtemps ?","en":"Do you think you'll stay long?","words":[{"g":"to think","l":"penser"},{"g":"you"},{"g":"to stay"},null]},{"text":"Je veux rester ici plus longtemps.","en":"I want to stay here longer.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to stay"},{"g":"here"},{"g":"more / no longer"},null]},{"text":"Cela ne va pas prendre longtemps.","en":"It's not going to take long.","audio":"https://tatoeba.org/en/audio/download/334436","words":[{"g":"that"},{"g":"not"},{"g":"to go","l":"aller"},{"g":"not"},{"g":"to take"},null]},{"text":"Vous ai-je fait attendre longtemps ?","en":"Have I kept you waiting long?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"I"},{"g":"to do","l":"faire"},{"g":"to wait for, to await"},null]}]}