{"id":"ga_che","lemma":"gâche","pos":"noun","rank":3728,"glosses":["oar","trowel"],"ipa":"/ɡaʃ/","gender":"f","forms":{"plural":"gâches"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q150_%28fra%29-WikiLucas00-g%C3%A2che.wav","examples":[{"text":"Je gâche toujours tout.","en":"I always spoil everything.","words":[{"g":"I"},null,{"g":"always"},{"g":"all"}]},{"text":"Ne gâche pas une bonne occasion.","en":"Don't throw away a good opportunity.","words":[{"g":"not"},null,{"g":"not"},{"g":"a"},{"g":"good","l":"bon"},{"g":"occasion, opportunity"}]},{"text":"Ne gâche pas tes munitions.","en":"Don't waste your ammunition.","words":[{"g":"not"},null,{"g":"not"},{"g":"your"},{"g":"ammunition","l":"munition"}]},{"text":"Pourquoi tu me gâches la vie ?","en":"Why are you ruining my life?","words":[{"g":"why"},{"g":"you"},{"g":"me"},null,{"g":"the / her"},{"g":"life"}]},{"text":"Tu gâches l'atmosphère.","en":"You're spoiling the mood.","words":[{"g":"you"},null,{"g":"the / it"},{"g":"atmosphere"}]}]}