{"id":"dans","lemma":"dans","pos":"prep","rank":24,"glosses":["in, inside (enclosed in a physical space, a group, a state)","to (indicates direction towards certain large subdivisions, see usage notes)","in, within (a longer period of time)"],"ipa":"/dɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2e/Fr-dans.ogg/Fr-dans.ogg.mp3","examples":[{"text":"Je travaille dans une usine.","en":"I work in a factory.","audio":"https://tatoeba.org/en/audio/download/1097708","words":[{"g":"I"},{"g":"to work","l":"travailler"},null,{"g":"a"},{"g":"factory"}]},{"text":"Qui est dans cette pièce ?","en":"Who is in this room?","words":[{"g":"who"},{"g":"is","l":"être"},null,{"g":"it, this, that","l":"ce"},{"g":"room in a house, etc."}]},{"text":"Je vais attendre dans la voiture.","en":"I'll wait in the car.","audio":"https://tatoeba.org/en/audio/download/249957","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"to wait for, to await"},null,{"g":"the / her"},{"g":"car"}]},{"text":"Tout est dans le dossier.","en":"It's all in the file.","audio":"https://tatoeba.org/en/audio/download/1102759","words":[{"g":"all"},{"g":"is","l":"être"},null,{"g":"the / it"},{"g":"file, case"}]},{"text":"Pourquoi es-tu dans ma maison ?","en":"Why are you in my house?","words":[{"g":"why"},{"g":"are","l":"être"},{"g":"you"},null,{"g":"my","l":"mon"},{"g":"house, home"}]}]}