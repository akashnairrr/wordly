{"id":"serrure","lemma":"serrure","pos":"noun","rank":3797,"glosses":["lock"],"ipa":"/sɛ.ʁyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fd/Fr-serrure.ogg/Fr-serrure.ogg.mp3","gender":"f","forms":{"plural":"serrures"},"formAudio":{"serrures":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q150_%28fra%29-Lyoko%C3%AF-serrures.wav"},"examples":[{"text":"Ouvre la serrure !","en":"Open the lock.","words":[{"g":"to open","l":"ouvrir"},{"g":"the / her"},null]},{"text":"J’ignore comment ouvrir cette serrure.","en":"I don't know how to open this lock.","words":[{"g":"I"},{"g":"to ignore","l":"ignorer"},{"g":"how"},{"g":"to open"},{"g":"it, this, that","l":"ce"},null]},{"text":"Le propriétaire a changé les serrures.","en":"The landlord changed the locks.","words":[{"g":"the / it"},{"g":"owner"},{"g":"has","l":"avoir"},{"g":"to exchange","l":"changer"},{"g":"the / them","l":"le"},null]},{"text":"Il a forcé la serrure.","en":"He jimmied the lock.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"forced"},{"g":"the / her"},null]},{"text":"La serrure doit être brisée.","en":"The lock must be broken.","words":[{"g":"the / her"},null,{"g":"must","l":"devoir"},{"g":"to be"},{"g":"broken","l":"brisé"}]}]}