{"id":"re_union","lemma":"réunion","pos":"noun","rank":708,"glosses":["meeting","set union"],"ipa":"/ʁe.y.njɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6b/Fr-r%C3%A9union.ogg/Fr-r%C3%A9union.ogg.mp3","gender":"f","forms":{"plural":"réunions"},"formAudio":{"réunions":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q150_%28fra%29-Roptat-r%C3%A9unions.wav"},"examples":[{"text":"Il était présent à la réunion.","en":"He was present at the meeting.","audio":"https://tatoeba.org/en/audio/download/26387","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"the now"},null,null,null],"phrases":[[3,5,"a la"]]},{"text":"Nous avons une réunion.","en":"We have a meeting.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"a"},null]},{"text":"Comment s'est passée la réunion?","en":"How was the meeting?","audio":"https://tatoeba.org/en/audio/download/214690","words":[{"g":"how"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"past","l":"passé"},{"g":"the / her"},null]},{"text":"Nous tenons nos réunions en français.","en":"We hold our meetings in French.","words":[{"g":"we / us"},{"g":"to have","l":"tenir"},{"g":"our","l":"notre"},null,{"g":"in / of it"},{"g":"French"}]},{"text":"Je suis ici pour une réunion.","en":"I'm here for a meeting.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"here"},{"g":"for"},{"g":"a"},null]}]}