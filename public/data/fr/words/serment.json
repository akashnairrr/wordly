{"id":"serment","lemma":"serment","pos":"noun","rank":2191,"glosses":["oath, pledge"],"ipa":"/sɛʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/Fr-serment.ogg/Fr-serment.ogg.mp3","gender":"m","forms":{"plural":"serments"},"formAudio":{"serments":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q150_%28fra%29-WikiLucas00-serments.wav"},"examples":[{"text":"Tu es sous serment.","en":"You are under oath.","words":[{"g":"you"},{"g":"are","l":"être"},{"g":"below, under"},null]},{"text":"Vous êtes sous serment.","en":"You are under oath.","words":[{"g":"you"},{"g":"to be","l":"être"},{"g":"below, under"},null]},{"text":"Je vous rappelle que vous êtes toujours sous serment.","en":"I remind you that you are still under oath.","words":[{"g":"I"},{"g":"you"},{"g":"to call again","l":"rappeler"},{"g":"that / what"},{"g":"you"},{"g":"to be","l":"être"},{"g":"always"},{"g":"below, under"},null]},{"text":"J'aimerais te rappeler que tu es sous serment.","en":"I'd like to remind you that you're under oath.","words":[{"g":"I"},{"g":"to love","l":"aimer"},{"g":"you"},{"g":"to call again"},{"g":"that / what"},{"g":"you"},{"g":"are","l":"être"},{"g":"below, under"},null]},{"text":"Il a prêté serment en tant que maire.","en":"He was sworn in as mayor.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to lend","l":"prêter"},null,null,null,null,{"g":"mayor"}],"phrases":[[4,7,"in that"]]}]}