{"id":"finalement","lemma":"finalement","pos":"adv","rank":920,"glosses":["finally; last; lastly","finally; eventually; after all"],"ipa":"/fi.nal.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/Fr-finalement.ogg/Fr-finalement.ogg.mp3","examples":[{"text":"Je comprends finalement.","en":"I finally understand.","words":[{"g":"I"},{"g":"to understand","l":"comprendre"},null]},{"text":"Le train est finalement arrivé.","en":"The train finally arrived.","words":[{"g":"the / it"},{"g":"train"},{"g":"is","l":"être"},null,{"g":"to arrive","l":"arriver"}]},{"text":"Finalement, j'ai ma propre voiture.","en":"Finally, I have my own car.","words":[null,{"g":"I"},{"g":"have","l":"avoir"},{"g":"my","l":"mon"},{"g":"own"},{"g":"car"}]},{"text":"C'est finalement mon tour.","en":"It's finally my turn.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"my"},{"g":"turn, circumference"}]},{"text":"Avez-vous arrêté une décision finalement ?","en":"Have you arrived at a decision yet?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to stop","l":"arrêter"},{"g":"a"},{"g":"decision"},null]}]}