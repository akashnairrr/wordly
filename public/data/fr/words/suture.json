{"id":"suture","lemma":"suture","pos":"noun","rank":4881,"glosses":["suture; stitch"],"ipa":"/sy.tyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0a/LL-Q150_%28fra%29-LoquaxFR-suture.wav/LL-Q150_%28fra%29-LoquaxFR-suture.wav.mp3","gender":"f","forms":{"plural":"sutures"},"examples":[{"text":"Vous avez besoin de points de suture.","en":"You need stitches.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"need"},{"g":"of / from"},{"g":"point","l":"point"},{"g":"of / from"},null]},{"text":"Il te faut des points de suture.","en":"You need stitches.","words":[{"g":"he / it"},{"g":"you"},{"g":"to need","l":"falloir"},{"g":"some / of the","l":"un"},{"g":"point","l":"point"},{"g":"of / from"},null]},{"text":"Tu as eu combien de points de suture ?","en":"How many stitches did you get?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"to have","l":"avoir"},{"g":"how much"},{"g":"of / from"},{"g":"point","l":"point"},{"g":"of / from"},null]},{"text":"Je pense que Tom a besoin de points de suture.","en":"I think Tom needs stitches.","words":[{"g":"I"},{"g":"to think","l":"penser"},{"g":"that / what"},null,{"g":"has","l":"avoir"},{"g":"need"},{"g":"of / from"},{"g":"point","l":"point"},{"g":"of / from"},null]},{"text":"Vos points de suture seront retirés au bout de quelques jours.","en":"Your stitches will be removed in a few days.","words":[{"g":"your, belonging to you","l":"votre"},{"g":"point","l":"point"},{"g":"of / from"},null,{"g":"to be","l":"être"},null,null,null,null,{"g":"some","l":"quelque"},{"g":"day","l":"jour"}],"phrases":[[6,9,"at the end of"]]}]}