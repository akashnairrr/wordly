{"id":"plaisir","lemma":"plaisir","pos":"noun","rank":375,"glosses":["pleasure"],"ipa":"/plɛ.ziʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/be/Fr-plaisir.ogg/Fr-plaisir.ogg.mp3","gender":"m","forms":{"plural":"plaisirs"},"formAudio":{"plaisirs":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q150_%28fra%29-0x010C-plaisirs.wav"},"examples":[{"text":"Ce serait un plaisir.","en":"It would be a pleasure.","words":[{"g":"this / it"},{"g":"to be","l":"être"},{"g":"a"},null]},{"text":"Voulez-vous me faire plaisir ?","en":"Do you want to make me happy?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"me"},{"g":"to do"},null]},{"text":"Aurai-je le plaisir de te revoir ?","en":"Will I have the pleasure of seeing you again?","words":[{"g":"to have","l":"avoir"},{"g":"I"},{"g":"the / it"},null,{"g":"of / from"},{"g":"you"},{"g":"to see again"}]},{"text":"Fais-moi plaisir.","en":"Do me a favor.","words":[{"g":"to do","l":"faire"},{"g":"me"},null]},{"text":"Rien ne me ferait plus plaisir.","en":"Nothing would give me more pleasure.","words":[{"g":"nothing"},{"g":"not"},{"g":"me"},{"g":"to do","l":"faire"},{"g":"more / no longer"},null]}]}