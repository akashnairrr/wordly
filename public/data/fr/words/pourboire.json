{"id":"pourboire","lemma":"pourboire","pos":"noun","rank":3871,"glosses":["tip (extra money given to e.g. a waiter in appreciation of service)"],"ipa":"/puʁ.bwaʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/18/Fr-pourboire-fr-Paris.ogg/Fr-pourboire-fr-Paris.ogg.mp3","gender":"m","forms":{"plural":"pourboires"},"formAudio":{"pourboires":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q150_%28fra%29-WikiLucas00-pourboires.wav"},"examples":[{"text":"Tu as laissé un pourboire ?","en":"Did you leave a tip?","audio":"https://tatoeba.org/en/audio/download/1679","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"to leave","l":"laisser"},{"g":"a"},null]},{"text":"Laisse-moi te donner un petit pourboire.","en":"Let me give you a little tip.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},{"g":"you"},{"g":"to give"},{"g":"a"},{"g":"small, little"},null]},{"text":"Nous n'acceptons pas les pourboires.","en":"We do not accept gratuities.","words":[{"g":"we / us"},{"g":"not"},{"g":"to accept","l":"accepter"},{"g":"not"},{"g":"the / them","l":"le"},null]},{"text":"Les pourboires ne sont pas acceptés.","en":"Tips are not accepted.","words":[{"g":"the / them","l":"le"},null,{"g":"not"},{"g":"to be","l":"être"},{"g":"not"},null]},{"text":"Laissez-moi vous donner un petit pourboire.","en":"Let me give you a little tip.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},{"g":"you"},{"g":"to give"},{"g":"a"},{"g":"small, little"},null]}]}