{"id":"ve_rite_","lemma":"vérité","pos":"noun","rank":304,"glosses":["truth"],"ipa":"/ve.ʁi.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/28/Fr-v%C3%A9rit%C3%A9.ogg/Fr-v%C3%A9rit%C3%A9.ogg.mp3","gender":"f","forms":{"plural":"vérités"},"formAudio":{"vérités":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q150_%28fra%29-Eihel-v%C3%A9rit%C3%A9s.wav"},"examples":[{"text":"Je connais la vérité.","en":"I know the truth.","audio":"https://tatoeba.org/en/audio/download/2079","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"the / her"},null]},{"text":"Dites-moi la vérité.","en":"Tell me the truth.","audio":"https://tatoeba.org/en/audio/download/12452","words":[{"g":"to say, to tell","l":"dire"},{"g":"me"},{"g":"the / her"},null]},{"text":"Est-ce la vérité ?","en":"Is that the truth?","audio":"https://tatoeba.org/en/audio/download/1097934","words":[{"g":"is","l":"être"},{"g":"this / it"},{"g":"the / her"},null]},{"text":"Qui dit la vérité ?","en":"Who's telling the truth?","words":[{"g":"who"},{"g":"to say, to tell","l":"dire"},{"g":"the / her"},null]},{"text":"Comment pouvons-nous apprendre la vérité ?","en":"How can we learn the truth?","words":[{"g":"how"},{"g":"can, to be able to","l":"pouvoir"},{"g":"we / us"},{"g":"to learn"},{"g":"the / her"},null]}]}