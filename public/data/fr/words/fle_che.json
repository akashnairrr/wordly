{"id":"fle_che","lemma":"flèche","pos":"noun","rank":3324,"glosses":["arrow (projectile or symbol)","spire","jib"],"ipa":"/flɛʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/Fr-fl%C3%A8che.ogg/Fr-fl%C3%A8che.ogg.mp3","gender":"f","forms":{"plural":"flèches"},"formAudio":{"flèches":"https://upload.wikimedia.org/wikipedia/commons/9/9b/LL-Q150_%28fra%29-Lyoko%C3%AF-fl%C3%A8ches.wav"},"examples":[{"text":"La flèche a atteint la cible.","en":"The arrow hit the target.","words":[{"g":"the / her"},null,{"g":"has","l":"avoir"},{"g":"to attain","l":"atteindre"},{"g":"the / her"},{"g":"target"}]},{"text":"Un arc est inutile sans flèches.","en":"A bow is no use without arrows.","words":[{"g":"a"},{"g":"bow"},{"g":"is","l":"être"},{"g":"useless"},{"g":"without"},null]},{"text":"Le temps file comme une flèche.","en":"Time flies like an arrow.","words":[{"g":"the / it"},{"g":"time"},{"g":"to spin","l":"filer"},{"g":"as"},{"g":"a"},null]},{"text":"Je pris une flèche dans le genou.","en":"I took an arrow in the knee.","words":[{"g":"I"},{"g":"to take","l":"prendre"},{"g":"a"},null,{"g":"in"},{"g":"the / it"},{"g":"knee"}]},{"text":"La flèche indique le chemin à suivre.","en":"The arrow indicates the way to go.","words":[{"g":"the / her"},null,{"g":"to connote","l":"indiquer"},{"g":"the / it"},{"g":"path, way, road"},null,null],"phrases":[[5,7,"to be continued"]]}]}