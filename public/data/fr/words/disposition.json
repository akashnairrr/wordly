{"id":"disposition","lemma":"disposition","pos":"noun","rank":3371,"glosses":["arrangement; layout","disposal; the ability or authority to use something","step; arrangement; measure"],"ipa":"/dis.po.zi.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4d/Fr-disposition.ogg/Fr-disposition.ogg.mp3","gender":"f","forms":{"plural":"dispositions"},"formAudio":{"dispositions":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q150_%28fra%29-0x010C-dispositions.wav"},"examples":[{"text":"Ma voiture est à ta disposition.","en":"My car is at your disposal.","words":[{"g":"my","l":"mon"},{"g":"car"},{"g":"is","l":"être"},{"g":"to / at"},{"g":"your"},null]},{"text":"L'argent est à votre disposition.","en":"The money is at your disposal.","words":[{"g":"the / it"},{"g":"money"},{"g":"is","l":"être"},{"g":"to / at"},{"g":"your, belonging to you"},null]},{"text":"J'ai déjà pris mes dispositions.","en":"I've already made arrangements.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"already, before"},{"g":"to take","l":"prendre"},{"g":"my"},null]},{"text":"J'ai beaucoup d'argent à ma disposition.","en":"I have a lot of money at my disposal.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"money"},{"g":"to / at"},{"g":"my","l":"mon"},null]},{"text":"La voiture de mon ami est à ma disposition.","en":"I have my friend's car at my disposal.","words":[{"g":"the / her"},{"g":"car"},{"g":"of / from"},{"g":"my"},{"g":"friend"},{"g":"is","l":"être"},{"g":"to / at"},{"g":"my","l":"mon"},null]}]}