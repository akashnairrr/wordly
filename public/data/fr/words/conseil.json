{"id":"conseil","lemma":"conseil","pos":"noun","rank":628,"glosses":["piece of advice","council"],"ipa":"/kɔ̃.sɛj/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cc/Fr-conseil.ogg/Fr-conseil.ogg.mp3","gender":"m","forms":{"plural":"conseils"},"formAudio":{"conseils":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q150_%28fra%29-0x010C-conseils.wav"},"examples":[{"text":"Tu devrais écouter son conseil.","en":"You should listen to his advice.","audio":"https://tatoeba.org/en/audio/download/334606","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to listen"},{"g":"his, her, its"},null]},{"text":"Merci pour vos conseils.","en":"Thanks for your advice.","words":[{"g":"thank you"},{"g":"for"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Merci du bon conseil.","en":"Thanks for the good advice.","words":[{"g":"thank you"},{"g":"of the / some"},{"g":"good"},null]},{"text":"Pouvez-vous me donner des conseils ?","en":"Can you give me any advice?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"me"},{"g":"to give"},{"g":"some / of the","l":"un"},null]},{"text":"Puis-je vous donner un conseil ?","en":"Can I give you a piece of advice?","words":[{"g":"then"},{"g":"I"},{"g":"you"},{"g":"to give"},{"g":"a"},null]}]}