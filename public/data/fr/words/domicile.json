{"id":"domicile","lemma":"domicile","pos":"noun","rank":2703,"glosses":["domicile"],"ipa":"/dɔ.mi.sil/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a2/Fr-domicile.ogg/Fr-domicile.ogg.mp3","gender":"m","forms":{"plural":"domiciles"},"formAudio":{"domiciles":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q150_%28fra%29-Lyoko%C3%AF-domiciles.wav"},"examples":[{"text":"Il est sur le chemin de son domicile.","en":"He's on his way home.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"on"},{"g":"the / it"},{"g":"path, way, road"},{"g":"of / from"},{"g":"his, her, its"},null]},{"text":"Je l'ai vue à son domicile.","en":"I saw her home.","words":[{"g":"I"},{"g":"the / it"},{"g":"have","l":"avoir"},{"g":"sight"},{"g":"to / at"},{"g":"his, her, its"},null]},{"text":"Mon domicile est éloigné.","en":"My home is far away.","words":[{"g":"my"},null,{"g":"is","l":"être"},{"g":"remote"}]},{"text":"J’ai laissé mon téléphone à mon domicile.","en":"I left my phone at home.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to leave","l":"laisser"},{"g":"my"},{"g":"telephone"},{"g":"to / at"},{"g":"my"},null]},{"text":"Puis-je te rendre visite à ton domicile, demain matin ?","en":"May I call on you at your house tomorrow morning?","words":[{"g":"then"},{"g":"I"},{"g":"you"},null,null,{"g":"to / at"},{"g":"your"},null,{"g":"tomorrow"},{"g":"morning"}],"phrases":[[3,5,"to visit"]]}]}