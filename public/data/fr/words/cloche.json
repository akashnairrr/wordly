{"id":"cloche","lemma":"cloche","pos":"noun","rank":1559,"glosses":["bell (metal apparatus used to produce sound)","a glass covering, originally bell-shaped, for garden plants to prevent frost damage and promote early growth","a bell-shaped, close-fitting women’s hat with a deep rounded crown and narrow rim"],"ipa":"/klɔʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/dc/Fr-cloche.ogg/Fr-cloche.ogg.mp3","gender":"f","forms":{"plural":"cloches"},"formAudio":{"cloches":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q150_%28fra%29-Poslovitch-cloches.wav"},"examples":[{"text":"La cloche sonne.","en":"The bell is ringing.","audio":"https://tatoeba.org/en/audio/download/214338","words":[{"g":"the / her"},null,{"g":"to sound","l":"sonner"}]},{"text":"J'ai entendu la cloche.","en":"I heard the bell.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to hear","l":"entendre"},{"g":"the / her"},null]},{"text":"Quelque chose cloche.","en":"Something's wrong.","audio":"https://tatoeba.org/en/audio/download/67537","words":[null,null,null],"phrases":[[0,2,"something"]]},{"text":"Les cloches de l'église sonnent.","en":"The church bells are ringing.","words":[{"g":"the / them","l":"le"},null,{"g":"of / from"},{"g":"the / it"},{"g":"church"},{"g":"to sound","l":"sonner"}]},{"text":"Tu n'as pas entendu la cloche ?","en":"Didn't you hear the bell?","words":[{"g":"you"},{"g":"not"},{"g":"have","l":"avoir"},{"g":"not"},{"g":"to hear","l":"entendre"},{"g":"the / her"},null]}]}