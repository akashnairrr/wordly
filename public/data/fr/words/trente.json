{"id":"trente","lemma":"trente","pos":"num","rank":2651,"glosses":["thirty"],"ipa":"/tʁɑ̃t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6c/Fr-trente.ogg/Fr-trente.ogg.mp3","examples":[{"text":"As-tu dit trente ?","en":"Did you say 30?","audio":"https://tatoeba.org/en/audio/download/351749","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to say, to tell","l":"dire"},null]},{"text":"Avez-vous dit trente ?","en":"Did you say 30?","audio":"https://tatoeba.org/en/audio/download/351750","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to say, to tell","l":"dire"},null]},{"text":"Donne-moi trente secondes.","en":"Give me thirty seconds.","words":[{"g":"to give","l":"donner"},{"g":"me"},null,{"g":"second","l":"seconde"}]},{"text":"Nous serons là dans trente minutes.","en":"We'll be there in thirty minutes.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"there"},{"g":"in"},null,{"g":"minute","l":"minute"}]},{"text":"Il a trente ans.","en":"He is thirty years old.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},null,{"g":"year","l":"an"}]}]}