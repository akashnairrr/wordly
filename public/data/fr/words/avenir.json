{"id":"avenir","lemma":"avenir","pos":"noun","rank":784,"glosses":["future"],"ipa":"/av.niʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/71/Fr-avenir.ogg/Fr-avenir.ogg.mp3","gender":"m","forms":{"plural":"avenirs"},"examples":[{"text":"Vous avez un avenir.","en":"You have a future.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"a"},null]},{"text":"Tu as un avenir.","en":"You have a future.","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"a"},null]},{"text":"Veux-tu connaître l'avenir ?","en":"Do you want to know the future?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to know"},{"g":"the / it"},null]},{"text":"Notre avenir en dépend.","en":"Our future depends on it.","words":[{"g":"our"},null,{"g":"in / of it"},{"g":"to depend","l":"dépendre"}]},{"text":"Mon avenir est entre vos mains.","en":"My future is in your hands.","words":[{"g":"my"},null,{"g":"is","l":"être"},{"g":"between"},{"g":"your, belonging to you","l":"votre"},{"g":"hand","l":"main"}]}]}