{"id":"veille","lemma":"veille","pos":"noun","rank":1737,"glosses":["the day before, the eve","the era or while before something; eve","wakefulness"],"ipa":"/vɛj/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6e/Fr-veille.ogg/Fr-veille.ogg.mp3","gender":"f","forms":{"plural":"veilles"},"formAudio":{"veilles":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q150_%28fra%29-WikiLucas00-veilles.wav"},"examples":[{"text":"Je veille souvent toute la nuit.","en":"I often stay up all night.","words":[{"g":"I"},null,{"g":"often"},{"g":"all","l":"tout"},{"g":"the / her"},{"g":"night"}]},{"text":"Je l'ai rencontré la veille.","en":"I met him on the previous day.","words":[{"g":"I"},{"g":"the / it"},{"g":"have","l":"avoir"},{"g":"to meet","l":"rencontrer"},{"g":"the / her"},null]},{"text":"Ne veille pas pour moi !","en":"Don't wait up for me.","words":[{"g":"not"},null,{"g":"not"},{"g":"for"},{"g":"me"}]},{"text":"Veille à ton langage !","en":"I won't tolerate such language!","words":[null,{"g":"to / at"},{"g":"your"},{"g":"language: word choice…"}]},{"text":"On veille les uns sur les autres.","en":"We look out for each other.","words":[{"g":"we / one"},null,{"g":"the / them","l":"le"},{"g":"a, an","l":"un"},{"g":"on"},{"g":"the / them","l":"le"},{"g":"other","l":"autre"}]}]}