{"id":"familier","lemma":"familier","pos":"adj","rank":2972,"glosses":["familiar (known to one)","familiar, informal, colloquial"],"ipa":"/fa.mi.lje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5c/Fr-familier.ogg/Fr-familier.ogg.mp3","forms":{"feminine":"familière","masculinePlural":"familiers","femininePlural":"familières"},"formAudio":{"familière":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q150_%28fra%29-Lyoko%C3%AF-famili%C3%A8re.wav","familiers":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q150_%28fra%29-Lyoko%C3%AF-familiers.wav","familières":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q150_%28fra%29-Lyoko%C3%AF-famili%C3%A8res.wav"},"examples":[{"text":"Son nom nous est familier.","en":"His name is familiar to us.","words":[{"g":"his, her, its"},{"g":"name"},{"g":"we / us"},{"g":"is","l":"être"},null]},{"text":"Votre voix me semble très familière.","en":"Your voice sounds very familiar to me.","words":[{"g":"your, belonging to you"},{"g":"voice"},{"g":"me"},{"g":"to seem","l":"sembler"},{"g":"very"},null]},{"text":"Je suis familier de sa musique.","en":"I am familiar with his music.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"of / from"},{"g":"his"},{"g":"music"}]},{"text":"J'ai entendu une voix familière.","en":"I heard a familiar voice.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to hear","l":"entendre"},{"g":"a"},{"g":"voice"},null]},{"text":"Ça me semble familier.","en":"That sounds familiar.","words":[{"g":"that"},{"g":"me"},{"g":"to seem","l":"sembler"},null]}]}