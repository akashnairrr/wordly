{"id":"inconnu","lemma":"inconnu","pos":"noun","rank":1706,"glosses":["an unknown person, place, or thing; a stranger","the things one does not know, in contrast to what one does"],"ipa":"/ɛ̃.kɔ.ny/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8f/Fr-inconnu.ogg/Fr-inconnu.ogg.mp3","gender":"m","forms":{"plural":"inconnus","feminine":"inconnue"},"formAudio":{"inconnue":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q150_%28fra%29-Lepticed7-inconnue.wav"},"examples":[{"text":"Son nom était inconnu.","en":"Her name was unknown.","words":[{"g":"his, her, its"},{"g":"name"},{"g":"to be","l":"être"},null]},{"text":"Il m'est totalement inconnu.","en":"He is an utter stranger to me.","words":[{"g":"he / it"},{"g":"me"},{"g":"is","l":"être"},{"g":"totally"},null]},{"text":"Cet homme était un parfait inconnu.","en":"The man was a total stranger.","words":[{"g":"this"},{"g":"man"},{"g":"to be","l":"être"},{"g":"a"},{"g":"perfect"},null]},{"text":"Ne donne pas ton nom à des inconnus.","en":"Don't tell strangers your name.","words":[{"g":"not"},{"g":"to give","l":"donner"},{"g":"not"},{"g":"your"},{"g":"name"},{"g":"to / at"},{"g":"some / of the","l":"un"},null]},{"text":"C'est un héros inconnu.","en":"He is an unsung hero.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},{"g":"hero"},null]}]}