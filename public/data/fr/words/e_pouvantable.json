{"id":"e_pouvantable","lemma":"épouvantable","pos":"adj","rank":4344,"glosses":["atrocious, awful, appalling"],"ipa":"/e.pu.vɑ̃.tabl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/Fr-%C3%A9pouvantable.ogg/Fr-%C3%A9pouvantable.ogg.mp3","forms":{"plural":"épouvantables"},"examples":[{"text":"Cette musique est épouvantable.","en":"This music is terrible.","words":[{"g":"it, this, that","l":"ce"},{"g":"music"},{"g":"is","l":"être"},null]},{"text":"Quelle journée épouvantable.","en":"It was a terrible day.","words":[{"g":"which?"},{"g":"day"},null]},{"text":"Les résultats ont été épouvantables.","en":"The results were appalling.","words":[{"g":"the / them","l":"le"},{"g":"outcome","l":"résultat"},{"g":"to have","l":"avoir"},{"g":"summer"},null]},{"text":"La nourriture était épouvantable.","en":"The food was terrible.","words":[{"g":"the / her"},{"g":"food, nourishment"},{"g":"to be","l":"être"},null]},{"text":"C'est tout simplement épouvantable.","en":"This is simply appalling.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"all"},{"g":"simply"},null]}]}