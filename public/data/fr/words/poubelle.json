{"id":"poubelle","lemma":"poubelle","pos":"noun","rank":2103,"glosses":["rubbish bin, garbage can","trash, rubbish"],"ipa":"/pu.bɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a1/Fr-poubelle.ogg/Fr-poubelle.ogg.mp3","gender":"f","forms":{"plural":"poubelles"},"formAudio":{"poubelles":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q150_%28fra%29-WikiLucas00-poubelles.wav"},"examples":[{"text":"Tu as sorti la poubelle ?","en":"Have you taken out the garbage?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"to exit","l":"sortir"},{"g":"the / her"},null]},{"text":"Je dois sortir les poubelles.","en":"I have to take out the trash.","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"to exit"},{"g":"the / them","l":"le"},null]},{"text":"La poubelle est vide.","en":"The trash can is empty.","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"empty"}]},{"text":"Je suis celui qui sort les poubelles.","en":"I'm the one who takes out the garbage.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"the one"},{"g":"who"},{"g":"fate, destiny"},{"g":"the / them","l":"le"},null]},{"text":"Jette-le à la poubelle.","en":"Throw it in the trash.","words":[{"g":"to throw","l":"jeter"},{"g":"the / it"},null,null,null],"phrases":[[2,4,"a la"]]}]}