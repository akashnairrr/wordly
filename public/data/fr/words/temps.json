{"id":"temps","lemma":"temps","pos":"noun","rank":86,"glosses":["time (in general)","weather","tense"],"ipa":"/tɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6f/Fr-temps.ogg/Fr-temps.ogg.mp3","gender":"m","examples":[{"text":"Prenez votre temps.","en":"Take your time.","audio":"https://tatoeba.org/en/audio/download/27047","words":[{"g":"to take","l":"prendre"},{"g":"your, belonging to you"},null]},{"text":"Je travaille à plein temps.","en":"I work full time.","audio":"https://tatoeba.org/en/audio/download/1095572","words":[{"g":"I"},{"g":"to work","l":"travailler"},{"g":"to / at"},{"g":"full, full up"},null]},{"text":"Donne-moi un peu de temps.","en":"Give me a little time.","audio":"https://tatoeba.org/en/audio/download/1102735","words":[{"g":"to give","l":"donner"},{"g":"me"},null,null,{"g":"of / from"},null],"phrases":[[2,4,"a little, a bit"]]},{"text":"Peux-tu le faire à temps ?","en":"Can you make it on time?","audio":"https://tatoeba.org/en/audio/download/2589","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"the / it"},{"g":"to do"},{"g":"to / at"},null]},{"text":"As-tu beaucoup de temps ?","en":"Do you have a lot of time?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"much, very much, a lot"},{"g":"of / from"},null]}]}