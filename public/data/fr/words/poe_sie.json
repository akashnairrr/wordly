{"id":"poe_sie","lemma":"poésie","pos":"noun","rank":3120,"glosses":["poetry (literature composed in verse)","poetry"],"ipa":"/pɔ.e.zi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/39/Fr-po%C3%A9sie.ogg/Fr-po%C3%A9sie.ogg.mp3","gender":"f","forms":{"plural":"poésies"},"formAudio":{"poésies":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q150_%28fra%29-WikiLucas00-po%C3%A9sies.wav"},"examples":[{"text":"J'adore la poésie.","en":"I love poetry.","words":[{"g":"I"},{"g":"to love, to adore","l":"adorer"},{"g":"the / her"},null]},{"text":"On a tous appris la poésie par cœur.","en":"We all learned the poem by heart.","words":[{"g":"we / one"},{"g":"has","l":"avoir"},{"g":"all"},{"g":"to learn","l":"apprendre"},{"g":"the / her"},null,null,null],"phrases":[[6,8,"by heart, by rote"]]},{"text":"Écrire de la poésie est un art.","en":"Writing poetry is an art.","words":[{"g":"to write"},null,null,null,{"g":"is","l":"être"},{"g":"a"},{"g":"art"}],"phrases":[[1,3,"of the"]]},{"text":"Toute la classe doit apprendre la poésie par cœur.","en":"Everyone in the class has to learn the poem by heart.","words":[{"g":"all","l":"tout"},{"g":"the / her"},{"g":"class, type, group"},{"g":"must","l":"devoir"},{"g":"to learn"},{"g":"the / her"},null,null,null],"phrases":[[7,9,"by heart, by rote"]]},{"text":"J'écris de la poésie pendant mon temps libre.","en":"I write poetry in my free time.","words":[{"g":"I"},{"g":"to write","l":"écrire"},null,null,null,{"g":"during"},{"g":"my"},null,null],"phrases":[[2,4,"of the"],[7,9,"free time"]]}]}