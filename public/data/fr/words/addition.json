{"id":"addition","lemma":"addition","pos":"noun","rank":3845,"glosses":["addition (operation of adding a number to another)","bill, check (written note of goods sold, services rendered, or work done, with the price or charge, in a bar or a restaurant)"],"ipa":"/a.di.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/Fr-addition.ogg/Fr-addition.ogg.mp3","gender":"f","forms":{"plural":"additions"},"formAudio":{"additions":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q150_%28fra%29-Pamputt-additions.wav"},"examples":[{"text":"Voici l'addition.","en":"Here is the bill.","audio":"https://tatoeba.org/en/audio/download/1095655","words":[{"g":"here is"},{"g":"the / it"},null]},{"text":"Qui va payer l'addition ?","en":"Who'll pay the bill?","words":[{"g":"who"},{"g":"to go","l":"aller"},{"g":"to pay"},{"g":"the / it"},null]},{"text":"L'addition s'il vous plaît.","en":"Check, please.","words":[{"g":"the / it"},null,{"g":"oneself / if"},{"g":"he / it"},{"g":"you"},{"g":"to please","l":"plaire"}]},{"text":"Je m'occupe de l'addition.","en":"I'll get the check.","words":[{"g":"I"},{"g":"me"},{"g":"to occupy, to take up","l":"occuper"},{"g":"of / from"},{"g":"the / it"},null]},{"text":"Puis-je avoir l'addition, je vous prie ?","en":"May I have the check, please?","words":[{"g":"then"},{"g":"I"},{"g":"to have"},{"g":"the / it"},null,{"g":"I"},{"g":"you"},{"g":"to pray","l":"prier"}]}]}