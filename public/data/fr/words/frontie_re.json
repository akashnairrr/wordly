{"id":"frontie_re","lemma":"frontière","pos":"noun","rank":1655,"glosses":["boundary, frontier, border"],"ipa":"/fʁɔ̃.tjɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bd/Fr-fronti%C3%A8re.ogg/Fr-fronti%C3%A8re.ogg.mp3","gender":"f","forms":{"plural":"frontières"},"formAudio":{"frontières":"https://upload.wikimedia.org/wikipedia/commons/4/49/LL-Q150_%28fra%29-Poslovitch-fronti%C3%A8res.wav"},"examples":[{"text":"Nous devons protéger notre frontière.","en":"We have to protect our border.","words":[{"g":"we / us"},{"g":"must","l":"devoir"},{"g":"to protect"},{"g":"our"},null]},{"text":"Comment puis-je atteindre la frontière ?","en":"How can I get to the border?","words":[{"g":"how"},{"g":"then"},{"g":"I"},{"g":"to attain"},{"g":"the / her"},null]},{"text":"Ils ont traversé la frontière.","en":"They crossed the border.","words":[{"g":"they"},{"g":"to have","l":"avoir"},{"g":"to cross, to go across","l":"traverser"},{"g":"the / her"},null]},{"text":"On doit passer la frontière.","en":"We need to cross the border.","words":[{"g":"we / one"},{"g":"must","l":"devoir"},{"g":"to pass"},{"g":"the / her"},null]},{"text":"Sa vanité ne connaît pas de frontières.","en":"Her vanity knows no bounds.","words":[{"g":"his"},{"g":"futility"},{"g":"not"},{"g":"to know","l":"connaître"},{"g":"not"},{"g":"of / from"},null]}]}