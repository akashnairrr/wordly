{"id":"doucement","lemma":"doucement","pos":"adv","rank":613,"glosses":["softly","quietly","gently"],"ipa":"/dus.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d0/Fr-doucement.ogg/Fr-doucement.ogg.mp3","examples":[{"text":"Vas-y doucement avec le vin.","en":"Go easy on the wine.","audio":"https://tatoeba.org/en/audio/download/1098079","words":[{"g":"to go","l":"aller"},{"g":"there"},null,{"g":"with"},{"g":"the / it"},{"g":"wine"}]},{"text":"Tu dois parler doucement ici.","en":"You have to speak quietly here.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to speak, talk"},null,{"g":"here"}]},{"text":"Va doucement !","en":"Go slow.","audio":"https://tatoeba.org/en/audio/download/472957","words":[{"g":"to go","l":"aller"},null]},{"text":"Parle doucement.","en":"Speak quietly.","words":[{"g":"to speak, talk","l":"parler"},null]},{"text":"Nous avons commencé très doucement.","en":"We started really slow.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"to begin, commence","l":"commencer"},{"g":"very"},null]}]}