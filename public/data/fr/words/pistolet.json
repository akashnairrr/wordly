{"id":"pistolet","lemma":"pistolet","pos":"noun","rank":1397,"glosses":["gun, pistol","spray gun","weird person"],"ipa":"/pis.tɔ.lɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fa/Fr-pistolet.ogg/Fr-pistolet.ogg.mp3","gender":"m","forms":{"plural":"pistolets"},"formAudio":{"pistolets":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q150_%28fra%29-WikiLucas00-pistolets.wav"},"examples":[{"text":"Donne-moi juste le pistolet.","en":"Just give me the gun.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"fair, just"},{"g":"the / it"},null]},{"text":"Nous avons des pistolets dans la maison.","en":"We have guns in the house.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"some / of the","l":"un"},null,{"g":"in"},{"g":"the / her"},{"g":"house, home"}]},{"text":"Pose ce pistolet sur la table.","en":"Put the gun on the table.","words":[{"g":"to stop carrying","l":"poser"},{"g":"this / it"},null,{"g":"on"},{"g":"the / her"},{"g":"table"}]},{"text":"Il garde ce pistolet chargé.","en":"He keeps this gun loaded.","words":[{"g":"he / it"},{"g":"a watch, guard"},{"g":"this / it"},null,{"g":"busy"}]},{"text":"Donnez-moi juste le pistolet.","en":"Just give me the gun.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"fair, just"},{"g":"the / it"},null]}]}