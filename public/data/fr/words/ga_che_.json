{"id":"ga_che_","lemma":"gâché","pos":"adj","rank":2217,"glosses":["spoiled, ruined","squandered, wasted"],"forms":{"feminine":"gâchée","masculinePlural":"gâchés","femininePlural":"gâchées"},"formAudio":{"gâchée":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q150_%28fra%29-0x010C-g%C3%A2ch%C3%A9e.wav"},"examples":[{"text":"Elle a gâché le boulot.","en":"She made a mess of the work.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"the / it"},{"g":"work"}]},{"text":"Beaucoup de temps fut gâché.","en":"A lot of time was wasted.","words":[{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"time"},{"g":"bole","l":"fût"},null]},{"text":"J'ai tout gâché.","en":"I ruined everything.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"all"},null]},{"text":"Désolé d'avoir gâché ton mariage.","en":"I'm sorry I ruined your wedding.","words":[{"g":"sorry"},{"g":"of / from"},{"g":"to have"},null,{"g":"your"},{"g":"marriage"}]},{"text":"Je suis désolé d'avoir gâché ta fête.","en":"I'm sorry I ruined your party.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"sorry"},{"g":"of / from"},{"g":"to have"},null,{"g":"your"},{"g":"party, celebration"}]}]}