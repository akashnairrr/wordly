{"id":"cinquie_me","lemma":"cinquième","pos":"adj","rank":3005,"glosses":["fifth"],"ipa":"/sɛ̃.kjɛm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ab/LL-Q150_%28fra%29-GrandCelinien-cinqui%C3%A8me.wav/LL-Q150_%28fra%29-GrandCelinien-cinqui%C3%A8me.wav.mp3","forms":{"plural":"cinquièmes"},"formAudio":{"cinquièmes":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q150_%28fra%29-Ekane-cinqui%C3%A8mes.wav"},"examples":[{"text":"Mon bureau est au cinquième étage.","en":"My office is on the fifth floor.","words":[{"g":"my"},{"g":"office"},{"g":"is","l":"être"},{"g":"to the"},null,{"g":"floor, storey"}]},{"text":"Il est arrivé cinquième à la course.","en":"He came in fifth in the race.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"to arrive","l":"arriver"},null,null,null,{"g":"run, running"}],"phrases":[[4,6,"a la"]]},{"text":"Elle descendit au cinquième étage.","en":"She went down to the fifth floor.","words":[{"g":"she / it"},{"g":"to go down","l":"descendre"},{"g":"to the"},null,{"g":"floor, storey"}]},{"text":"C'est le cinquième concert de cet orchestre.","en":"This is the fifth concert by this orchestra.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"the / it"},null,{"g":"concert"},{"g":"of / from"},{"g":"this"},{"g":"orchestra, band"}]},{"text":"Un incendie s'est déclaré au cinquième étage.","en":"A fire broke out on the fifth floor.","words":[{"g":"a"},{"g":"fire"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"to declare","l":"déclarer"},{"g":"to the"},null,{"g":"floor, storey"}]}]}