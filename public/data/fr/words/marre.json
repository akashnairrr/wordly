{"id":"marre","lemma":"marre","pos":"adv","rank":1058,"glosses":["enough"],"ipa":"/maʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8d/LL-Q150_%28fra%29-WikiLucas00-marre.wav/LL-Q150_%28fra%29-WikiLucas00-marre.wav.mp3","examples":[{"text":"J'en ai marre de toi.","en":"I'm sick of you.","words":[{"g":"I"},{"g":"in / of it"},{"g":"have","l":"avoir"},null,{"g":"of / from"},{"g":"you"}]},{"text":"On en a marre.","en":"We're tired of this.","words":[{"g":"we / one"},{"g":"in / of it"},{"g":"has","l":"avoir"},null]},{"text":"Ils en avaient marre d'attendre.","en":"They were tired of waiting.","words":[{"g":"they"},{"g":"in / of it"},{"g":"to have","l":"avoir"},null,{"g":"of / from"},{"g":"to wait for, to await"}]},{"text":"Je commence à en avoir marre.","en":"I'm getting tired of it.","words":[{"g":"I"},{"g":"to begin, commence","l":"commencer"},{"g":"to / at"},{"g":"in / of it"},{"g":"to have"},null]},{"text":"Tu n'en as pas marre ?","en":"Don't you get tired of it?","words":[{"g":"you"},{"g":"not"},{"g":"in / of it"},{"g":"have","l":"avoir"},{"g":"not"},null]}]}