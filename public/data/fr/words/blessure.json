{"id":"blessure","lemma":"blessure","pos":"noun","rank":1449,"glosses":["wound","injury"],"ipa":"/blɛ.syʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/36/Fr-blessure.ogg/Fr-blessure.ogg.mp3","gender":"f","forms":{"plural":"blessures"},"formAudio":{"blessures":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q150_%28fra%29-Mecanautes-blessures.wav"},"examples":[{"text":"Veuillez me montrer la blessure.","en":"Please show me the wound.","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"me"},{"g":"to show"},{"g":"the / her"},null]},{"text":"Nous avons des blessures.","en":"We have injuries.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"some / of the","l":"un"},null]},{"text":"La blessure est-elle très profonde ?","en":"Is the wound very deep?","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"she / it"},{"g":"very"},{"g":"deep","l":"profond"}]},{"text":"Il saignait de ses blessures.","en":"He was bleeding from his wounds.","words":[{"g":"he / it"},{"g":"to bleed","l":"saigner"},{"g":"of / from"},{"g":"his"},null]},{"text":"On dirait une blessure par balle.","en":"This looks like a gunshot wound.","words":[{"g":"we / one"},{"g":"to say, to tell","l":"dire"},{"g":"a"},null,{"g":"through"},{"g":"ball"}]}]}