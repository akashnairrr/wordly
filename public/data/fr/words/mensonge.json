{"id":"mensonge","lemma":"mensonge","pos":"noun","rank":1244,"glosses":["lie, falsehood"],"ipa":"/mɑ̃.sɔ̃ʒ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/23/Fr-mensonge.ogg/Fr-mensonge.ogg.mp3","gender":"m","forms":{"plural":"mensonges"},"formAudio":{"mensonges":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q150_%28fra%29-DenisdeShawi-mensonges.wav"},"examples":[{"text":"Il dit un mensonge.","en":"He is telling a lie.","words":[{"g":"he / it"},{"g":"to say, to tell","l":"dire"},{"g":"a"},null]},{"text":"Ça ne serait pas un mensonge.","en":"That would not be a lie.","words":[{"g":"that"},{"g":"not"},{"g":"to be","l":"être"},{"g":"not"},{"g":"a"},null]},{"text":"Ne dites jamais de mensonges.","en":"Never tell lies.","audio":"https://tatoeba.org/en/audio/download/2296","words":[{"g":"not"},{"g":"to say, to tell","l":"dire"},{"g":"never"},{"g":"of / from"},null]},{"text":"Elle doit avoir dit un mensonge.","en":"She must have told a lie.","words":[{"g":"she / it"},{"g":"must","l":"devoir"},{"g":"to have"},{"g":"to say, to tell","l":"dire"},{"g":"a"},null]},{"text":"Je peux voir à travers tes mensonges.","en":"I can see through your lies.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to see"},null,null,{"g":"your"},null],"phrases":[[3,5,"through"]]}]}