{"id":"extre_mement","lemma":"extrêmement","pos":"adv","rank":1983,"glosses":["extremely"],"ipa":"/ɛk.stʁɛm.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0b/Fr-extr%C3%AAmement.ogg/Fr-extr%C3%AAmement.ogg.mp3","examples":[{"text":"Tu fais ça extrêmement bien.","en":"You do that extremely well.","words":[{"g":"you"},{"g":"to do","l":"faire"},{"g":"that"},null,{"g":"well"}]},{"text":"La chambre est extrêmement petite.","en":"The room is extremely small.","words":[{"g":"the / her"},{"g":"a room."},{"g":"is","l":"être"},null,{"g":"small, little","l":"petit"}]},{"text":"Je suis extrêmement riche.","en":"I'm extremely rich.","audio":"https://tatoeba.org/en/audio/download/1097735","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"rich"}]},{"text":"Cela peut être extrêmement dangereux.","en":"It can be extremely dangerous.","words":[{"g":"that"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to be"},null,{"g":"dangerous"}]},{"text":"Le chat semble extrêmement heureux.","en":"The cat seems extremely happy.","words":[{"g":"the / it"},{"g":"cat"},{"g":"to seem","l":"sembler"},null,{"g":"happy"}]}]}