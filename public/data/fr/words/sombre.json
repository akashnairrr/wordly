{"id":"sombre","lemma":"sombre","pos":"adj","rank":1489,"glosses":["dark","right, damn, bloody"],"ipa":"/sɔ̃bʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/Fr-sombre.ogg/Fr-sombre.ogg.mp3","forms":{"plural":"sombres"},"examples":[{"text":"La pièce est sombre.","en":"The room is dark.","words":[{"g":"the / her"},{"g":"room in a house, etc."},{"g":"is","l":"être"},null]},{"text":"Pourquoi fait-il sombre ?","en":"Why is it dark?","words":[{"g":"why"},{"g":"to do","l":"faire"},{"g":"he / it"},null]},{"text":"Il porte toujours des vêtements sombres.","en":"He always wears dark clothes.","words":[{"g":"he / it"},{"g":"door"},{"g":"always"},{"g":"some / of the","l":"un"},{"g":"garment","l":"vêtement"},null]},{"text":"Il faisait si sombre.","en":"It was so dark.","audio":"https://tatoeba.org/en/audio/download/28438","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"if, whether"},null]},{"text":"Il fait sombre dans cette pièce.","en":"It is dark in that room.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"in"},{"g":"it, this, that","l":"ce"},{"g":"room in a house, etc."}]}]}