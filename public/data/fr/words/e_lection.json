{"id":"e_lection","lemma":"élection","pos":"noun","rank":2975,"glosses":["election"],"ipa":"/e.lɛk.sjɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/32/Fr-l%27%C3%A9lection.ogg/Fr-l%27%C3%A9lection.ogg.mp3","gender":"f","forms":{"plural":"élections"},"formAudio":{"élections":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q150_%28fra%29-Poslovitch-%C3%A9lections.wav"},"examples":[{"text":"J'ai perdu les élections.","en":"I lost the election.","audio":"https://tatoeba.org/en/audio/download/1097882","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"lost"},{"g":"the / them","l":"le"},null]},{"text":"Nous sommes prêts pour les élections.","en":"We're ready for the elections.","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"ready","l":"prêt"},{"g":"for"},{"g":"the / them","l":"le"},null]},{"text":"Qui a gagné les élections ?","en":"Who won the election?","words":[{"g":"who"},{"g":"has","l":"avoir"},{"g":"to win","l":"gagner"},{"g":"the / them","l":"le"},null]},{"text":"As-tu voté à la dernière élection ?","en":"Did you vote in the last election?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to vote","l":"voter"},null,null,{"g":"last","l":"dernier"},null],"phrases":[[3,5,"a la"]]},{"text":"Vas-tu voter à la prochaine élection ?","en":"Are you going to vote in the upcoming election?","words":[{"g":"to go","l":"aller"},{"g":"you"},{"g":"to vote"},null,null,{"g":"upcoming","l":"prochain"},null],"phrases":[[3,5,"a la"]]}]}