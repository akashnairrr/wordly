{"id":"combien","lemma":"combien","pos":"adv","rank":203,"glosses":["how much (for uncountable nouns and portions)","how much (for money)","how many (with countable nouns)"],"ipa":"/kɔ̃.bjɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/66/Fr-combien.ogg/Fr-combien.ogg.mp3","examples":[{"text":"C’est combien ?","en":"How much is it?","audio":"https://tatoeba.org/en/audio/download/837691","words":[{"g":"it / that"},{"g":"is","l":"être"},null]},{"text":"Combien veut-il ?","en":"How many does he want?","words":[null,{"g":"to want, wish, desire","l":"vouloir"},{"g":"he / it"}]},{"text":"Combien ça vaut ?","en":"How much is that worth?","words":[null,{"g":"that"},{"g":"to be worth","l":"valoir"}]},{"text":"Je sais combien tu le veux.","en":"I know how badly you want it.","words":[{"g":"I"},{"g":"to know","l":"savoir"},null,{"g":"you"},{"g":"the / it"},{"g":"to want, wish, desire","l":"vouloir"}]},{"text":"Je sais combien vous êtes occupé.","en":"I know how busy you are.","words":[{"g":"I"},{"g":"to know","l":"savoir"},null,{"g":"you"},{"g":"to be","l":"être"},{"g":"busy"}]}]}