{"id":"plus","lemma":"plus","pos":"adv","rank":35,"glosses":["more, -er (comparative)","most, -est (superlative)","more, most (to a greater / the greatest extent)"],"ipa":"/ply/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f5/Fr-plus.ogg/Fr-plus.ogg.mp3","examples":[{"text":"Tu dois étudier plus.","en":"You must study more.","audio":"https://tatoeba.org/en/audio/download/27295","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to study"},null]},{"text":"Viens un peu plus près.","en":"Come a little closer.","audio":"https://tatoeba.org/en/audio/download/1103093","words":[{"g":"to come","l":"venir"},null,null,null,{"g":"near, close"}],"phrases":[[1,3,"a little, a bit"]]},{"text":"Pouvez-vous nous en dire plus ?","en":"Can you tell us more about it?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"we / us"},{"g":"in / of it"},{"g":"to say, to tell"},null]},{"text":"Je peux faire plus.","en":"I can do more.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},null]},{"text":"Je veux beaucoup plus.","en":"I want much more.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"much, very much, a lot"},null]}]}