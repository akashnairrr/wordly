{"id":"autour","lemma":"autour","pos":"prep","rank":567,"glosses":["around, about"],"ipa":"/o.tuʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/Fr-autour.ogg/Fr-autour.ogg.mp3","examples":[{"text":"Regarde autour de toi.","en":"Look around.","audio":"https://tatoeba.org/en/audio/download/474414","words":[{"g":"to look at","l":"regarder"},null,{"g":"of / from"},{"g":"you"}]},{"text":"Regardez autour de vous.","en":"Look around.","audio":"https://tatoeba.org/en/audio/download/474415","words":[{"g":"to look at","l":"regarder"},null,{"g":"of / from"},{"g":"you"}]},{"text":"Elle voyage autour du monde.","en":"She is traveling around the world.","words":[{"g":"she / it"},{"g":"trip, journey, voyage"},null,{"g":"of the / some"},{"g":"world"}]},{"text":"J'ai regardé autour de moi.","en":"I looked around.","audio":"https://tatoeba.org/en/audio/download/50709","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"to look at","l":"regarder"},null,{"g":"of / from"},{"g":"me"}]},{"text":"Il tourna autour.","en":"He turned around.","words":[{"g":"he / it"},{"g":"to turn","l":"tourner"},null]}]}