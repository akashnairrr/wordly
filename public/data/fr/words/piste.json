{"id":"piste","lemma":"piste","pos":"noun","rank":993,"glosses":["track or trail (left by an animal or person)","track (road or other similar beaten path)","lead, hint (e.g. in a police investigation)"],"ipa":"/pist/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/47/Fr-piste.ogg/Fr-piste.ogg.mp3","gender":"f","forms":{"plural":"pistes"},"formAudio":{"pistes":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q150_%28fra%29-WikiLucas00-pistes.wav"},"examples":[{"text":"Vous êtes sur la bonne piste.","en":"You're on the right track.","words":[{"g":"you"},{"g":"to be","l":"être"},{"g":"on"},{"g":"the / her"},{"g":"good","l":"bon"},null]},{"text":"La police a-t-elle des pistes ?","en":"Do the police have any leads?","words":[{"g":"the / her"},{"g":"police"},{"g":"has","l":"avoir"},{"g":"you"},{"g":"she / it"},{"g":"some / of the","l":"un"},null]},{"text":"Il est sur la piste de danse.","en":"He's on the dance floor.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"on"},{"g":"the / her"},null,{"g":"of / from"},{"g":"dance"}]},{"text":"Nous n'avons pas encore de pistes.","en":"We don't have any leads yet.","words":[{"g":"we / us"},{"g":"not"},{"g":"to have","l":"avoir"},null,null,{"g":"of / from"},null],"phrases":[[3,5,"not yet"]]},{"text":"La police n'a pas encore de piste.","en":"The police still have no leads.","words":[{"g":"the / her"},{"g":"police"},{"g":"not"},{"g":"has","l":"avoir"},null,null,{"g":"of / from"},null],"phrases":[[4,6,"not yet"]]}]}