{"id":"ciel","lemma":"ciel","pos":"noun","rank":652,"glosses":["sky","heaven"],"ipa":"/sjɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/21/Fr-ciel.ogg/Fr-ciel.ogg.mp3","gender":"m","forms":{"plural":"cieux"},"formAudio":{"cieux":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q150_%28fra%29-VictorDtmtc-cieux.wav"},"examples":[{"text":"Le ciel est bleu.","en":"The sky is blue.","audio":"https://tatoeba.org/en/audio/download/28536","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"the color blue"}]},{"text":"Le ciel était clair.","en":"The sky was clear.","words":[{"g":"the / it"},null,{"g":"to be","l":"être"},{"g":"clear"}]},{"text":"Le ciel est plein d'étoiles.","en":"The sky is full of stars.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"full, full up"},{"g":"of / from"},{"g":"star","l":"étoile"}]},{"text":"Rien de nouveau sous le ciel.","en":"There's nothing new under the sun.","words":[{"g":"nothing"},null,null,{"g":"below, under"},{"g":"the / it"},null],"phrases":[[1,3,"again"]]},{"text":"Maman est maintenant au ciel.","en":"Mom is now in heaven.","words":[{"g":"mummy, mommy, mom, mum"},{"g":"is","l":"être"},{"g":"now, currently"},{"g":"to the"},null]}]}