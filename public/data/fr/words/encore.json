{"id":"encore","lemma":"encore","pos":"adv","rank":89,"glosses":["still","more","again"],"ipa":"/ɑ̃.kɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/Fr-encore.ogg/Fr-encore.ogg.mp3","examples":[{"text":"Est-il encore là?","en":"Is he still here?","audio":"https://tatoeba.org/en/audio/download/44455","words":[{"g":"is","l":"être"},{"g":"he / it"},null,{"g":"there"}]},{"text":"J'attends encore.","en":"I'm still waiting.","audio":"https://tatoeba.org/en/audio/download/214440","words":[{"g":"I"},{"g":"to wait for, to await","l":"attendre"},null]},{"text":"Y es-tu encore ?","en":"Are you still there?","words":[{"g":"there"},{"g":"are","l":"être"},{"g":"you"},null]},{"text":"Pouvez-vous encore le faire ?","en":"Can you still do it?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},null,{"g":"the / it"},{"g":"to do"}]},{"text":"Je travaille encore.","en":"I still work.","words":[{"g":"I"},{"g":"to work","l":"travailler"},null]}]}