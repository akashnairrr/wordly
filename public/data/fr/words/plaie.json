{"id":"plaie","lemma":"plaie","pos":"noun","rank":3017,"glosses":["open wound","scourge"],"ipa":"/plɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e3/Fr-plaie.ogg/Fr-plaie.ogg.mp3","gender":"f","forms":{"plural":"plaies"},"formAudio":{"plaies":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q150_%28fra%29-Eihel-plaies.wav"},"examples":[{"text":"Le gosse est une plaie.","en":"The kid is a pain in the neck.","words":[{"g":"the / it"},{"g":"child, kid"},{"g":"is","l":"être"},{"g":"a"},null]},{"text":"Elle pansa la plaie.","en":"She applied a bandage to the wound.","words":[{"g":"she / it"},null,{"g":"the / her"},null]},{"text":"Le chien blessé léchait ses plaies.","en":"The injured dog was licking its wounds.","words":[{"g":"the / it"},{"g":"dog"},{"g":"injured, wounded"},{"g":"to lick","l":"lécher"},{"g":"his"},null]},{"text":"Le temps guérit toutes les plaies.","en":"Time cures all things.","words":[{"g":"the / it"},{"g":"time"},{"g":"to cure, to heal","l":"guérir"},{"g":"all","l":"tout"},{"g":"the / them","l":"le"},null]},{"text":"Quelle plaie.","en":"What a pain!","audio":"https://tatoeba.org/en/audio/download/474310","words":[{"g":"which?"},null]}]}