{"id":"chemine_e","lemma":"cheminée","pos":"noun","rank":3582,"glosses":["a chimney","a fireplace or hearth","a vertical vent, exhaust or gallery"],"ipa":"/ʃə.mi.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/Fr-chemin%C3%A9e.ogg/Fr-chemin%C3%A9e.ogg.mp3","gender":"f","forms":{"plural":"cheminées"},"formAudio":{"cheminées":"https://upload.wikimedia.org/wikipedia/commons/a/a7/LL-Q150_%28fra%29-Eihel-chemin%C3%A9es.wav"},"examples":[{"text":"Cette cheminée est de briques.","en":"This chimney is made of brick.","words":[{"g":"it, this, that","l":"ce"},null,{"g":"is","l":"être"},{"g":"of / from"},{"g":"brick","l":"brique"}]},{"text":"Un feu crépitait dans la cheminée.","en":"A fire crackled in the fireplace.","words":[{"g":"a"},{"g":"fire"},null,{"g":"in"},{"g":"the / her"},null]},{"text":"Nous nous sommes assis devant la cheminée.","en":"We sat in front of the fireplace.","words":[{"g":"we / us"},{"g":"we / us"},{"g":"to be","l":"être"},{"g":"sat, sat down, seated"},{"g":"in front of"},{"g":"the / her"},null]},{"text":"De la fumée montait de la cheminée.","en":"Smoke rose from the chimney.","words":[null,null,{"g":"smoke"},{"g":"to go up, to climb","l":"monter"},null,null,null],"phrases":[[0,2,"of the"],[4,6,"of the"]]},{"text":"Ils se sont assis près de la cheminée.","en":"They sat by the fireplace.","words":[{"g":"they"},{"g":"oneself"},{"g":"to be","l":"être"},{"g":"sat, sat down, seated"},null,null,{"g":"the / her"},null],"phrases":[[4,6,"close to, near."]]}]}