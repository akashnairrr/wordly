{"id":"ceinture","lemma":"ceinture","pos":"noun","rank":1738,"glosses":["belt (item of clothing)"],"ipa":"/sɛ̃.tyʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fb/Fr-ceinture.ogg/Fr-ceinture.ogg.mp3","gender":"f","forms":{"plural":"ceintures"},"formAudio":{"ceintures":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q150_%28fra%29-Lepticed7-ceintures.wav"},"examples":[{"text":"Où est ma ceinture ?","en":"Where is my belt?","words":[{"g":"where"},{"g":"is","l":"être"},{"g":"my","l":"mon"},null]},{"text":"Donne-moi ta ceinture.","en":"Give me your belt.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"your"},null]},{"text":"Sans ceinture, mon pantalon tombe.","en":"My pants fall down without a belt.","words":[{"g":"without"},null,{"g":"my"},{"g":"trousers , pants"},{"g":"to fall","l":"tomber"}]},{"text":"N'oubliez pas de mettre vos ceintures.","en":"Don't forget to put on your seatbelts.","words":[{"g":"not"},{"g":"to forget","l":"oublier"},{"g":"not"},{"g":"of / from"},{"g":"to put"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Il déboucla sa ceinture.","en":"He unbuckled his belt.","words":[{"g":"he / it"},null,{"g":"his"},null]}]}