{"id":"digne","lemma":"digne","pos":"adj","rank":1984,"glosses":["worthy","having dignity; dignified"],"ipa":"/diɲ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/45/Fr-digne.ogg/Fr-digne.ogg.mp3","forms":{"plural":"dignes"},"formAudio":{"dignes":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q150_%28fra%29-WikiLucas00-dignes.wav"},"examples":[{"text":"Son comportement est digne de respect.","en":"His behavior is worthy of respect.","words":[{"g":"his, her, its"},{"g":"behaviour/behavior"},{"g":"is","l":"être"},null,{"g":"of / from"},{"g":"respect"}]},{"text":"Je veux être digne de ton amitié.","en":"I want to be worthy of your friendship.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to be"},null,{"g":"of / from"},{"g":"your"},{"g":"friendship, amity"}]},{"text":"Nous sommes dignes de confiance.","en":"We're trustworthy.","words":[{"g":"we / us"},{"g":"to be","l":"être"},null,null,null],"phrases":[[3,5,"trustworthy, reliable"]]},{"text":"Il n'est pas digne de toi.","en":"He's not worthy of you.","words":[{"g":"he / it"},{"g":"not"},{"g":"is","l":"être"},{"g":"not"},null,{"g":"of / from"},{"g":"you"}]},{"text":"Vous paraissez très dignes.","en":"You look very dignified.","words":[{"g":"you"},{"g":"to appear","l":"paraître"},{"g":"very"},null]}]}