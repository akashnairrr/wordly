{"id":"comple_tement","lemma":"complètement","pos":"adv","rank":535,"glosses":["completely"],"ipa":"/kɔ̃.plɛt.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cd/Fr-compl%C3%A8tement.ogg/Fr-compl%C3%A8tement.ogg.mp3","examples":[{"text":"Il est complètement idiot.","en":"He is a complete idiot.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"idiotic"}]},{"text":"Êtes-vous tous complètement fous ?","en":"Are you all completely crazy?","words":[{"g":"to be","l":"être"},{"g":"you"},{"g":"all"},null,{"g":"crazy, mad","l":"fou"}]},{"text":"Je l'oublie complètement.","en":"I completely forgot it.","words":[{"g":"I"},{"g":"the / it"},{"g":"to forget","l":"oublier"},null]},{"text":"Avez-vous complètement perdu l'esprit ?","en":"Have you completely lost your mind?","words":[{"g":"to have","l":"avoir"},{"g":"you"},null,{"g":"lost"},{"g":"the / it"},{"g":"mind, spirit"}]},{"text":"Cette histoire est complètement ridicule.","en":"This story is completely ridiculous.","words":[{"g":"it, this, that","l":"ce"},{"g":"story"},{"g":"is","l":"être"},null,{"g":"ridiculous"}]}]}