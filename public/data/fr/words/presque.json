{"id":"presque","lemma":"presque","pos":"adv","rank":330,"glosses":["almost"],"ipa":"/pʁɛsk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a3/Fr-presque.ogg/Fr-presque.ogg.mp3","examples":[{"text":"Nous y sommes presque.","en":"We're almost there.","audio":"https://tatoeba.org/en/audio/download/49849","words":[{"g":"we / us"},{"g":"there"},{"g":"to be","l":"être"},null]},{"text":"Je vous crois presque.","en":"I almost believe you.","words":[{"g":"I"},{"g":"you"},{"g":"to believe","l":"croire"},null]},{"text":"Mon travail est presque fini.","en":"My work is almost finished.","words":[{"g":"my"},{"g":"work"},{"g":"is","l":"être"},null,{"g":"to finish","l":"finir"}]},{"text":"J'ai presque oublié.","en":"I almost forgot.","audio":"https://tatoeba.org/en/audio/download/351791","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"to forget","l":"oublier"}]},{"text":"As-tu presque fini ?","en":"Are you almost finished?","words":[{"g":"have","l":"avoir"},{"g":"you"},null,{"g":"to finish","l":"finir"}]}]}