{"id":"quinze","lemma":"quinze","pos":"num","rank":2560,"glosses":["fifteen"],"ipa":"/kɛ̃z/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b3/Fr-quinze.ogg/Fr-quinze.ogg.mp3","examples":[{"text":"Je serai là dans quinze minutes.","en":"I'll be there in fifteen minutes.","words":[{"g":"I"},{"g":"to be","l":"être"},{"g":"there"},{"g":"in"},null,{"g":"minute","l":"minute"}]},{"text":"Il est presque quinze heures.","en":"It is almost three.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"almost"},null,{"g":"hour, time","l":"heure"}]},{"text":"Le bus part toutes les quinze minutes.","en":"The bus leaves every fifteen minutes.","words":[{"g":"the / it"},{"g":"bus"},{"g":"share"},{"g":"all","l":"tout"},{"g":"the / them","l":"le"},null,{"g":"minute","l":"minute"}]},{"text":"Quinze minutes de plus et je serai dehors.","en":"Fifteen more minutes and I'll be out of here.","words":[null,{"g":"minute","l":"minute"},null,null,{"g":"and"},{"g":"I"},{"g":"to be","l":"être"},{"g":"outside"}],"phrases":[[2,4,"moreover, furthermore"]]},{"text":"Ma fille a à peine quinze ans.","en":"My daughter is barely fifteen.","words":[{"g":"my","l":"mon"},{"g":"girl"},{"g":"has","l":"avoir"},null,null,null,{"g":"year","l":"an"}],"phrases":[[3,5,"barely"]]}]}