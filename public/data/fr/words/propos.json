{"id":"propos","lemma":"propos","pos":"noun","rank":307,"glosses":["remark","à propos = about, by the way"],"ipa":"/pʁɔ.po/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a1/Fr-propos.ogg/Fr-propos.ogg.mp3","gender":"m","examples":[{"text":"À propos de qui parles-tu ?","en":"Who are you talking about?","words":[{"g":"to / at"},null,{"g":"of / from"},{"g":"who"},{"g":"to speak, talk","l":"parler"},{"g":"you"}]},{"text":"Je voulais te parler à ce propos.","en":"I wanted to speak to you about this.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to speak, talk"},{"g":"to / at"},{"g":"this / it"},null]},{"text":"Que pouvez-vous me dire à propos de cela ?","en":"What can you tell me about that?","audio":"https://tatoeba.org/en/audio/download/334691","words":[{"g":"that / what"},{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"me"},{"g":"to say, to tell"},{"g":"to / at"},null,{"g":"of / from"},{"g":"that"}]},{"text":"Nous savons tout à votre propos.","en":"We know all about you.","words":[{"g":"we / us"},{"g":"soap","l":"savon"},{"g":"all"},{"g":"to / at"},{"g":"your, belonging to you"},null]},{"text":"Tu avais raison à ce propos.","en":"You were right about this.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"reason"},{"g":"to / at"},{"g":"this / it"},null]}]}