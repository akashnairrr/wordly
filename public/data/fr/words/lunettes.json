{"id":"lunettes","lemma":"lunettes","pos":"noun","rank":1394,"glosses":["spectacles, eyeglasses"],"ipa":"/ly.nɛt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/05/Fr-lunettes.ogg/Fr-lunettes.ogg.mp3","gender":"f","examples":[{"text":"Passe-moi mes lunettes.","en":"Bring me my glasses.","audio":"https://tatoeba.org/en/audio/download/43953","words":[{"g":"to pass","l":"passer"},{"g":"me"},{"g":"my"},null]},{"text":"Où ai-je mis mes lunettes ?","en":"Where did I put my glasses?","words":[{"g":"where"},{"g":"have","l":"avoir"},{"g":"I"},{"g":"to put","l":"mettre"},{"g":"my"},null]},{"text":"Pouvez-vous lire ceci sans vos lunettes ?","en":"Can you read this without your glasses?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"to read"},{"g":"this"},{"g":"without"},{"g":"your, belonging to you","l":"votre"},null]},{"text":"Mets tes lunettes.","en":"Put on your glasses.","words":[{"g":"to put","l":"mettre"},{"g":"your"},null]},{"text":"Où sont les lunettes ?","en":"Where are the glasses?","words":[{"g":"where"},{"g":"to be","l":"être"},{"g":"the / them","l":"le"},null]}]}