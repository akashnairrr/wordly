{"id":"supe_rieur","lemma":"supérieur","pos":"adj","rank":2043,"glosses":["superior","upper, senior","above; higher than"],"ipa":"/sy.pe.ʁjœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/10/Fr-sup%C3%A9rieur.ogg/Fr-sup%C3%A9rieur.ogg.mp3","forms":{"feminine":"supérieure","masculinePlural":"supérieurs","femininePlural":"supérieures"},"formAudio":{"supérieure":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q150_%28fra%29-Sartus85-sup%C3%A9rieure.wav","supérieurs":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q150_%28fra%29-Lyoko%C3%AF-sup%C3%A9rieurs.wav","supérieures":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q150_%28fra%29-Le_Commissaire-sup%C3%A9rieures.wav"},"examples":[{"text":"Je veux parler à votre supérieur.","en":"I want to talk to your manager.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to speak, talk"},{"g":"to / at"},{"g":"your, belonging to you"},null]},{"text":"Il appartient à la classe supérieure.","en":"He belongs to the upper class.","words":[{"g":"he / it"},{"g":"to belong","l":"appartenir"},null,null,{"g":"class, type, group"},null],"phrases":[[2,4,"a la"]]},{"text":"Je suis désormais ton supérieur.","en":"I'm now your boss.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"henceforth"},{"g":"your"},null]},{"text":"Il est respectueux envers ses supérieurs.","en":"He behaves respectfully toward his superiors.","words":[{"g":"he / it"},{"g":"is","l":"être"},{"g":"respectful"},{"g":"reverse"},{"g":"his"},null]},{"text":"Je veux discuter de ceci avec votre supérieur.","en":"I want to discuss this with your manager.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to argue, to debate"},{"g":"of / from"},{"g":"this"},{"g":"with"},{"g":"your, belonging to you"},null]}]}