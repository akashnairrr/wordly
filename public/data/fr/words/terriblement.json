{"id":"terriblement","lemma":"terriblement","pos":"adv","rank":2779,"glosses":["terribly; in a way that is terrible","much; a lot"],"ipa":"/tɛ.ʁi.blə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4c/LL-Q150_%28fra%29-Poslovitch-terriblement.wav/LL-Q150_%28fra%29-Poslovitch-terriblement.wav.mp3","examples":[{"text":"Je suis terriblement désolé.","en":"I'm terribly sorry.","audio":"https://tatoeba.org/en/audio/download/28664","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"sorry"}]},{"text":"J'ai terriblement faim.","en":"I am terribly hungry.","audio":"https://tatoeba.org/en/audio/download/2545","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"hunger"}]},{"text":"Tu dois être terriblement fatiguée.","en":"You must be terribly tired.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to be"},null,{"g":"tired","l":"fatigué"}]},{"text":"Il faisait terriblement froid hier.","en":"It was terribly cold yesterday.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},null,{"g":"cold"},{"g":"yesterday"}]},{"text":"Ils avaient terriblement faim.","en":"They were terribly hungry.","words":[{"g":"they"},{"g":"to have","l":"avoir"},null,{"g":"hunger"}]}]}