{"id":"fusil","lemma":"fusil","pos":"noun","rank":1514,"glosses":["rifle, gun","steel to strike sparks from a flint (pierre à fusil)"],"ipa":"/fy.zi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/Fr-fusil.ogg/Fr-fusil.ogg.mp3","gender":"m","forms":{"plural":"fusils"},"formAudio":{"fusils":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q150_%28fra%29-Eihel-fusils.wav"},"examples":[{"text":"Il marche toujours avec un fusil.","en":"He always walks with a rifle.","words":[{"g":"he / it"},{"g":"to walk","l":"marcher"},{"g":"always"},{"g":"with"},{"g":"a"},null]},{"text":"Donnez-moi le fusil.","en":"Give me the rifle.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"the / it"},null]},{"text":"Mon fusil est vide.","en":"My rifle's empty.","words":[{"g":"my"},null,{"g":"is","l":"être"},{"g":"empty"}]},{"text":"Pose le fusil sur la table.","en":"Toss the gun onto the table.","words":[{"g":"to stop carrying","l":"poser"},{"g":"the / it"},null,{"g":"on"},{"g":"the / her"},{"g":"table"}]},{"text":"Ils s'armèrent de fusils.","en":"They armed themselves with guns.","words":[{"g":"they"},{"g":"oneself / if"},null,{"g":"of / from"},null]}]}