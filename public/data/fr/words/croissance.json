{"id":"croissance","lemma":"croissance","pos":"noun","rank":4361,"glosses":["growth"],"ipa":"/kʁwa.sɑ̃s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1a/LL-Q150_%28fra%29-LoquaxFR-croissance.wav/LL-Q150_%28fra%29-LoquaxFR-croissance.wav.mp3","gender":"f","forms":{"plural":"croissances"},"formAudio":{"croissances":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q150_%28fra%29-Lyoko%C3%AF-croissances.wav"},"examples":[{"text":"C'est une ville à croissance rapide.","en":"It's a fast growing city.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"a"},{"g":"town, city"},{"g":"to / at"},null,{"g":"fast, quick"}]},{"text":"L'économie de ce pays est en croissance.","en":"That country's economy is growing.","words":[{"g":"the / it"},{"g":"economy"},{"g":"of / from"},{"g":"this / it"},{"g":"land"},{"g":"is","l":"être"},{"g":"in / of it"},null]},{"text":"Le secteur informatique vit une période de croissance.","en":"The computer industry is enjoying a boom.","words":[{"g":"the / it"},{"g":"circular sector"},{"g":"computer science"},{"g":"to see","l":"voir"},{"g":"a"},{"g":"period"},{"g":"of / from"},null]},{"text":"La production de légumes est en croissance dans notre région.","en":"The production of vegetables is growing in our area.","words":[{"g":"the / her"},{"g":"production"},{"g":"of / from"},null,{"g":"is","l":"être"},{"g":"in / of it"},null,{"g":"in"},{"g":"our"},{"g":"region"}]},{"text":"Il y a eu une croissance soutenue de la population.","en":"There was a steady increase in population.","words":[null,null,null,{"g":"to have","l":"avoir"},{"g":"a"},null,{"g":"sustained","l":"soutenu"},null,null,{"g":"population"}],"phrases":[[0,3,"ago"],[7,9,"of the"]]}]}