{"id":"esclave","lemma":"esclave","pos":"noun","rank":2297,"glosses":["slave"],"ipa":"/ɛs.klav/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/Fr-esclave.ogg/Fr-esclave.ogg.mp3","gender":"mf","forms":{"plural":"esclaves"},"formAudio":{"esclaves":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q150_%28fra%29-Poslovitch-esclaves.wav"},"examples":[{"text":"Je ne suis pas ton esclave.","en":"I'm not your slave.","words":[{"g":"I"},{"g":"not"},{"g":"am","l":"être"},{"g":"not"},{"g":"your"},null]},{"text":"Il me traite en esclave.","en":"He treats me like his slave.","words":[{"g":"he / it"},{"g":"me"},{"g":"to treat","l":"traiter"},{"g":"in / of it"},null]},{"text":"Est-ce que vous voulez vivre comme des esclaves ?","en":"Do you want to live like slaves?","words":[{"g":"is","l":"être"},null,null,{"g":"you"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to live"},{"g":"as"},{"g":"some / of the","l":"un"},null],"phrases":[[1,3,"what"]]},{"text":"Ils me traitaient comme un esclave.","en":"They treated me like a slave.","words":[{"g":"they"},{"g":"me"},{"g":"to treat","l":"traiter"},{"g":"as"},{"g":"a"},null]},{"text":"Je suis fatigué d'être ton esclave.","en":"I'm tired of being your slave.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"tired"},{"g":"of / from"},{"g":"to be"},{"g":"your"},null]}]}