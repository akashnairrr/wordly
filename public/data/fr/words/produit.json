{"id":"produit","lemma":"produit","pos":"noun","rank":1131,"glosses":["product","production"],"ipa":"/pʁɔ.dɥi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4f/Fr-produit.ogg/Fr-produit.ogg.mp3","gender":"m","forms":{"plural":"produits"},"examples":[{"text":"Savez-vous pourquoi ça se produit ?","en":"Do you know why this is happening?","words":[{"g":"to know","l":"savoir"},{"g":"you"},{"g":"why"},{"g":"that"},{"g":"oneself"},null]},{"text":"Notre pays produit beaucoup de sucre.","en":"Our country produces a lot of sugar.","words":[{"g":"our"},{"g":"land"},null,{"g":"much, very much, a lot"},{"g":"of / from"},{"g":"sugar"}]},{"text":"Nous devons améliorer nos produits.","en":"We need to improve our products.","words":[{"g":"we / us"},{"g":"must","l":"devoir"},{"g":"to improve"},{"g":"our","l":"notre"},null]},{"text":"Quand cela s'est-il produit ?","en":"When did it occur?","words":[{"g":"when"},{"g":"that"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"he / it"},null]},{"text":"Si ça se produit, appelle-moi !","en":"If that happens, call me.","words":[{"g":"if, whether"},{"g":"that"},{"g":"oneself"},null,{"g":"to call","l":"appeler"},{"g":"me"}]}]}