{"id":"banque","lemma":"banque","pos":"noun","rank":797,"glosses":["bank"],"ipa":"/bɑ̃k/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/10/Fr-banque.ogg/Fr-banque.ogg.mp3","gender":"f","forms":{"plural":"banques"},"formAudio":{"banques":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q150_%28fra%29-0x010C-banques.wav"},"examples":[{"text":"Mon père travaille pour une banque.","en":"My father works for a bank.","audio":"https://tatoeba.org/en/audio/download/28474","words":[{"g":"my"},{"g":"father"},{"g":"to work","l":"travailler"},{"g":"for"},{"g":"a"},null]},{"text":"Il travaille à la banque.","en":"He works at the bank.","words":[{"g":"he / it"},{"g":"to work","l":"travailler"},null,null,null],"phrases":[[2,4,"a la"]]},{"text":"Je ne crois pas aux banques.","en":"I don't believe in banks.","words":[{"g":"I"},{"g":"not"},{"g":"to believe","l":"croire"},{"g":"not"},{"g":"to the"},null]},{"text":"La banque est-elle ouverte ?","en":"Is the bank open?","words":[{"g":"the / her"},null,{"g":"is","l":"être"},{"g":"she / it"},{"g":"open","l":"ouvert"}]},{"text":"Je suis allé à la banque.","en":"I went to the bank.","audio":"https://tatoeba.org/en/audio/download/1098093","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"to go","l":"aller"},null,null,null],"phrases":[[3,5,"a la"]]}]}