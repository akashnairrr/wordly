{"id":"loin","lemma":"loin","pos":"adv","rank":284,"glosses":["far, distant"],"ipa":"/lwɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1c/Fr-loin.ogg/Fr-loin.ogg.mp3","examples":[{"text":"Est-ce loin ?","en":"Is it far?","audio":"https://tatoeba.org/en/audio/download/262480","words":[{"g":"is","l":"être"},{"g":"this / it"},null]},{"text":"C'est loin d'ici ?","en":"Is it far from here?","audio":"https://tatoeba.org/en/audio/download/1649","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"of / from"},{"g":"here"}]},{"text":"Ma maison est loin.","en":"My house is far away.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},null]},{"text":"Est-ce trop loin pour marcher ?","en":"Is it too far to walk?","words":[{"g":"is","l":"être"},{"g":"this / it"},{"g":"too"},null,{"g":"for"},{"g":"to walk"}]},{"text":"Restez loin de ce chien.","en":"Stay far away from that dog.","words":[{"g":"to stay","l":"rester"},null,{"g":"of / from"},{"g":"this / it"},{"g":"dog"}]}]}