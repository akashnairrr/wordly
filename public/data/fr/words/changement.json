{"id":"changement","lemma":"changement","pos":"noun","rank":1200,"glosses":["change"],"ipa":"/ʃɑ̃ʒ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/Fr-changement.ogg/Fr-changement.ogg.mp3","gender":"m","forms":{"plural":"changements"},"formAudio":{"changements":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q150_%28fra%29-DenisdeShawi-changements.wav"},"examples":[{"text":"Voici ton changement !","en":"Here's your change.","words":[{"g":"here is"},{"g":"your"},null]},{"text":"Nous voulons tous des changements.","en":"We all want changes.","words":[{"g":"we / us"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"all"},{"g":"some / of the","l":"un"},null]},{"text":"Tout changement n'est pas mauvais.","en":"Not all change is bad.","words":[{"g":"all"},null,{"g":"not"},{"g":"is","l":"être"},{"g":"not"},{"g":"bad"}]},{"text":"Nous avons fait beaucoup de changements.","en":"We've made a lot of changes.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"to do","l":"faire"},{"g":"much, very much, a lot"},{"g":"of / from"},null]},{"text":"Pourquoi as-tu besoin de changement ?","en":"Why do you need change?","words":[{"g":"why"},{"g":"have","l":"avoir"},{"g":"you"},{"g":"need"},{"g":"of / from"},null]}]}