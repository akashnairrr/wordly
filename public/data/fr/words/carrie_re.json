{"id":"carrie_re","lemma":"carrière","pos":"noun","rank":963,"glosses":["racecourse","career"],"ipa":"/ka.ʁjɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f1/Fr-carri%C3%A8re.ogg/Fr-carri%C3%A8re.ogg.mp3","gender":"f","forms":{"plural":"carrières"},"formAudio":{"carrières":"https://upload.wikimedia.org/wikipedia/commons/6/6a/LL-Q150_%28fra%29-Poslovitch-carri%C3%A8res.wav"},"examples":[{"text":"Je dois penser à ma carrière.","en":"I have my career to think of.","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"to think"},{"g":"to / at"},{"g":"my","l":"mon"},null]},{"text":"Ma carrière est en jeu.","en":"My career is on the line.","words":[{"g":"my","l":"mon"},null,{"g":"is","l":"être"},null,null],"phrases":[[3,5,"at stake, on the line"]]},{"text":"Votre famille devrait passer avant votre carrière.","en":"Your family should come before your career.","words":[{"g":"your, belonging to you"},{"g":"family"},{"g":"must","l":"devoir"},{"g":"to pass"},{"g":"before"},{"g":"your, belonging to you"},null]},{"text":"Je fais passer ma famille avant ma carrière.","en":"I put my family before my career.","words":[{"g":"I"},{"g":"to do","l":"faire"},{"g":"to pass"},{"g":"my","l":"mon"},{"g":"family"},{"g":"before"},{"g":"my","l":"mon"},null]},{"text":"Sa carrière est en jeu.","en":"His career is on the line.","words":[{"g":"his"},null,{"g":"is","l":"être"},null,null],"phrases":[[3,5,"at stake, on the line"]]}]}