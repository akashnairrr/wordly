{"id":"confort","lemma":"confort","pos":"noun","rank":4019,"glosses":["comfort"],"ipa":"/kɔ̃.fɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4d/Fr-confort.ogg/Fr-confort.ogg.mp3","gender":"m","forms":{"plural":"conforts"},"formAudio":{"conforts":"https://upload.wikimedia.org/wikipedia/commons/2/27/LL-Q150_%28fra%29-Totodu74-conforts.wav"},"examples":[{"text":"Je souhaite vivre dans le confort.","en":"I want to live in comfort.","words":[{"g":"I"},{"g":"to wish","l":"souhaiter"},{"g":"to live"},{"g":"in"},{"g":"the / it"},null]},{"text":"Mon oncle vit maintenant dans le confort.","en":"My uncle now lives in comfort.","words":[{"g":"my"},{"g":"uncle"},{"g":"to see","l":"voir"},{"g":"now, currently"},{"g":"in"},{"g":"the / it"},null]},{"text":"Elle vit dans le confort.","en":"She lives in comfort.","words":[{"g":"she / it"},{"g":"to see","l":"voir"},{"g":"in"},{"g":"the / it"},null]},{"text":"Son salaire élevé lui a permis de vivre dans le confort.","en":"His high salary enabled him to live in comfort.","words":[{"g":"his, her, its"},{"g":"salary, wage"},{"g":"high, aloft, perched"},{"g":"him, he, it"},{"g":"has","l":"avoir"},{"g":"permit, licence"},{"g":"of / from"},{"g":"to live"},{"g":"in"},{"g":"the / it"},null]},{"text":"Il a travaillé jour et nuit pour que sa famille puisse vivre dans le confort.","en":"He worked day and night so that his family could live in comfort.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to work","l":"travailler"},null,null,null,null,null,{"g":"his"},{"g":"family"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to live"},{"g":"in"},{"g":"the / it"},null],"phrases":[[3,6,"day and night"],[6,8,"so that, in order that"]]}]}