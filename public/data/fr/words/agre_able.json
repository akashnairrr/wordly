{"id":"agre_able","lemma":"agréable","pos":"adj","rank":1238,"glosses":["pleasurable, nice, pleasant, agreeable"],"ipa":"/a.ɡʁe.abl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5e/Fr-agr%C3%A9able.ogg/Fr-agr%C3%A9able.ogg.mp3","forms":{"plural":"agréables"},"formAudio":{"agréables":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q150_%28fra%29-Lyoko%C3%AF-agr%C3%A9ables.wav"},"examples":[{"text":"Il semble très agréable.","en":"He seems very pleasant.","words":[{"g":"he / it"},{"g":"to seem","l":"sembler"},{"g":"very"},null]},{"text":"Il a une voix agréable.","en":"He has a pleasant voice.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"a"},{"g":"voice"},null]},{"text":"As-tu passé un agréable voyage ?","en":"Did you have a pleasant trip?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"past"},{"g":"a"},null,{"g":"trip, journey, voyage"}]},{"text":"Merci pour cette agréable soirée.","en":"Thank you for the pleasant evening.","words":[{"g":"thank you"},{"g":"for"},{"g":"it, this, that","l":"ce"},null,{"g":"evening"}]},{"text":"Elle dit toujours des choses agréables à son sujet.","en":"She always says nice things about him.","words":[{"g":"she / it"},{"g":"to say, to tell","l":"dire"},{"g":"always"},{"g":"some / of the","l":"un"},{"g":"thing","l":"chose"},null,{"g":"to / at"},{"g":"his, her, its"},{"g":"subject, topic"}]}]}