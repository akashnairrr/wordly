{"id":"joint","lemma":"joint","pos":"noun","rank":3304,"glosses":["seal"],"ipa":"/ʒwɛ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/07/Fr-joint.ogg/Fr-joint.ogg.mp3","gender":"m","forms":{"plural":"joints"},"examples":[{"text":"Mon mari et moi avons un compte joint.","en":"My husband and I have a joint bank account.","words":[{"g":"my"},{"g":"husband"},{"g":"and"},{"g":"me"},{"g":"to have","l":"avoir"},{"g":"a"},{"g":"account"},null]},{"text":"J'ai joint votre bon de commande.","en":"I have enclosed your order form.","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"your, belonging to you"},null,null,null],"phrases":[[4,7,"order form"]]},{"text":"Le pont joint les deux villes.","en":"The bridge connects the two cities.","words":[{"g":"the / it"},{"g":"bridge"},null,{"g":"the / them","l":"le"},{"g":"two"},{"g":"town, city","l":"ville"}]},{"text":"Tout le monde ne s'est pas joint.","en":"Not everyone got along.","words":[null,null,null,{"g":"not"},{"g":"oneself / if"},{"g":"is","l":"être"},{"g":"not"},null],"phrases":[[0,3,"everyone, everybody"]]},{"text":"Imprimez les documents ci-joints.","en":"Print the attached documents.","words":[{"g":"to print, to print out","l":"imprimer"},{"g":"the / them","l":"le"},{"g":"document","l":"document"},{"g":"see -ci"},null]}]}