{"id":"on","lemma":"on","pos":"pron","rank":16,"glosses":["one, people, you, someone (an unspecified individual)","we"],"ipa":"/ɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/Fr-on.ogg/Fr-on.ogg.mp3","examples":[{"text":"On peut venir avec toi ?","en":"Can we come with you?","audio":"https://tatoeba.org/en/audio/download/1102929","words":[null,{"g":"can, to be able to","l":"pouvoir"},{"g":"to come"},{"g":"with"},{"g":"you"}]},{"text":"On peut toujours essayer.","en":"We can always try.","audio":"https://tatoeba.org/en/audio/download/1093018","words":[null,{"g":"can, to be able to","l":"pouvoir"},{"g":"always"},{"g":"to test, to try on"}]},{"text":"Peut-on parler français ?","en":"Can we speak French?","audio":"https://tatoeba.org/en/audio/download/472301","words":[{"g":"can, to be able to","l":"pouvoir"},null,{"g":"to speak, talk"},{"g":"French"}]},{"text":"On peut mieux faire.","en":"We can do it better.","audio":"https://tatoeba.org/en/audio/download/1102907","words":[null,{"g":"can, to be able to","l":"pouvoir"},{"g":"better"},{"g":"to do"}]},{"text":"On peut rentrer à la maison ?","en":"Can we go back home?","audio":"https://tatoeba.org/en/audio/download/1097888","words":[null,{"g":"can, to be able to","l":"pouvoir"},{"g":"to go back"},null,null,null],"phrases":[[3,6,"at home"]]}]}