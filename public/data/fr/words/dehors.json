{"id":"dehors","lemma":"dehors","pos":"prep","rank":300,"glosses":["outside; outside of"],"ipa":"/də.ɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e3/Fr-dehors.ogg/Fr-dehors.ogg.mp3","examples":[{"text":"Va attendre dehors.","en":"Go wait outside.","words":[{"g":"to go","l":"aller"},{"g":"to wait for, to await"},null]},{"text":"Laisse-nous en dehors de ça.","en":"Leave us out of it.","audio":"https://tatoeba.org/en/audio/download/1098058","words":[{"g":"to leave","l":"laisser"},{"g":"we / us"},{"g":"in / of it"},null,{"g":"of / from"},{"g":"that"}]},{"text":"Attendez-moi dehors.","en":"Wait for me outside.","words":[{"g":"to wait for, to await","l":"attendre"},{"g":"me"},null]},{"text":"Nous pouvons parler dehors.","en":"We can talk outside.","words":[{"g":"we / us"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to speak, talk"},null]},{"text":"Viens avec moi dehors.","en":"Come outside with me.","words":[{"g":"to come","l":"venir"},{"g":"with"},{"g":"me"},null]}]}