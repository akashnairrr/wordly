{"id":"pardon","lemma":"pardon","pos":"intj","rank":268,"glosses":["excuse me","sorry"],"ipa":"/paʁ.dɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/79/Fr-Pardon-fr.ogg/Fr-Pardon-fr.ogg.mp3","examples":[{"text":"Je vous demande pardon ?","en":"Excuse me?","audio":"https://tatoeba.org/en/audio/download/2365","words":[{"g":"I"},{"g":"you"},{"g":"to ask","l":"demander"},null]},{"text":"Pardon, je suis un peu nerveux.","en":"Forgive me, I'm a bit nervous.","words":[null,{"g":"I"},{"g":"am","l":"être"},null,null,{"g":"nerve"}],"phrases":[[3,5,"a little, a bit"]]},{"text":"Je te demande pardon pour tout.","en":"I'm sorry for everything.","words":[{"g":"I"},{"g":"you"},{"g":"to ask","l":"demander"},null,{"g":"for"},{"g":"all"}]},{"text":"Pardon, où est la station de taxi ?","en":"Excuse me, where is the taxi stand?","words":[null,{"g":"where"},{"g":"is","l":"être"},{"g":"the / her"},{"g":"station"},{"g":"of / from"},{"g":"taxi"}]},{"text":"Pardon de vous interrompre.","en":"Pardon me for interrupting you.","words":[null,{"g":"of / from"},{"g":"you"},{"g":"to interrupt"}]}]}