{"id":"redevable","lemma":"redevable","pos":"adj","rank":4552,"glosses":["liable, indebted","beholden, indebted, obligated, in (someone's) debt"],"ipa":"/ʁə.d(ə).vabl/","forms":{"plural":"redevables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q150_%28fra%29-Sartus85-redevable.wav","examples":[{"text":"Je lui suis redevable.","en":"I am indebted to him.","words":[{"g":"I"},{"g":"him, he, it"},{"g":"am","l":"être"},null]},{"text":"Je te suis à jamais redevable.","en":"I'm forever in your debt.","words":[{"g":"I"},{"g":"you"},{"g":"am","l":"être"},null,null,null],"phrases":[[3,5,"forever and ever"]]},{"text":"Vous êtes redevable de la dette.","en":"You're liable for the debt.","words":[{"g":"you"},{"g":"to be","l":"être"},null,null,null,{"g":"debt"}],"phrases":[[3,5,"of the"]]},{"text":"Nous sommes redevables de beaucoup à Tom.","en":"We owe Tom a lot.","words":[{"g":"we / us"},{"g":"to be","l":"être"},null,{"g":"of / from"},{"g":"much, very much, a lot"},{"g":"to / at"},null]},{"text":"Je te suis redevable de ce que je suis maintenant.","en":"I owe what I am today to you.","words":[{"g":"I"},{"g":"you"},{"g":"am","l":"être"},null,{"g":"of / from"},null,null,{"g":"I"},{"g":"am","l":"être"},{"g":"now, currently"}],"phrases":[[5,7,"what"]]}]}