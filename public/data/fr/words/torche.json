{"id":"torche","lemma":"torche","pos":"noun","rank":4156,"glosses":["torch (stick with flame at one end)"],"ipa":"/tɔʁʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/da/Fr-torche.ogg/Fr-torche.ogg.mp3","gender":"f","forms":{"plural":"torches"},"formAudio":{"torches":"https://upload.wikimedia.org/wikipedia/commons/0/0c/LL-Q150_%28fra%29-Mathieu_Kappler-torches.wav"},"examples":[{"text":"Donne-moi ta lampe torche.","en":"Give me your flashlight.","words":[{"g":"to give","l":"donner"},{"g":"me"},{"g":"your"},{"g":"lamp, light"},null]},{"text":"J'ai perdu ma lampe-torche.","en":"I lost my flashlight.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"lost"},{"g":"my","l":"mon"},{"g":"lamp, light"},null]},{"text":"Tu auras besoin d'une lampe torche.","en":"You'll need a flashlight.","words":[{"g":"you"},{"g":"to have","l":"avoir"},{"g":"need"},{"g":"of / from"},{"g":"a"},{"g":"lamp, light"},null]},{"text":"Peux-tu me prêter une lampe torche ?","en":"Do you have a flashlight I can borrow?","words":[{"g":"can, to be able to","l":"pouvoir"},{"g":"you"},{"g":"me"},{"g":"to lend"},{"g":"a"},{"g":"lamp, light"},null]},{"text":"Cette lampe-torche faiblit.","en":"This flashlight is getting dim.","words":[{"g":"it, this, that","l":"ce"},{"g":"lamp, light"},null,{"g":"to weaken","l":"faiblir"}]}]}