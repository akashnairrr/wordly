{"id":"jusque","lemma":"jusque","pos":"prep","rank":2301,"glosses":["until, up to"],"ipa":"/ʒysk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/11/Fr-jusque.ogg/Fr-jusque.ogg.mp3","examples":[{"text":"Il a marché jusque chez lui.","en":"He walked all the way home.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"market"},null,{"g":"to"},{"g":"him, he, it"}]},{"text":"Tout va bien jusque-là.","en":"So far, so good.","words":[{"g":"all"},{"g":"to go","l":"aller"},{"g":"well"},null,{"g":"there"}]},{"text":"Il lit souvent jusque tard dans la nuit.","en":"He often reads far into the night.","words":[{"g":"he / it"},{"g":"bed"},{"g":"often"},null,{"g":"late"},{"g":"in"},{"g":"the / her"},{"g":"night"}]},{"text":"Je vais seulement courir jusque la banque.","en":"I'm just going to run down to the bank.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"only"},{"g":"to run"},null,{"g":"the / her"},{"g":"bank"}]},{"text":"Compte jusque trente.","en":"Count to thirty.","words":[{"g":"account"},null,{"g":"thirty"}]}]}