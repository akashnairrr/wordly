{"id":"accorde_","lemma":"accordé","pos":"adj","rank":3919,"glosses":["agreeing, which agrees with its subject"],"ipa":"/a.kɔʁ.de/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/Fr-accord%C3%A9.ogg/Fr-accord%C3%A9.ogg.mp3","forms":{"feminine":"accordée","masculinePlural":"accordés","femininePlural":"accordées"},"formAudio":{"accordés":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q150_%28fra%29-WikiLucas00-accord%C3%A9s.wav","accordées":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q150_%28fra%29-WikiLucas00-accord%C3%A9es.wav"},"examples":[{"text":"Je vous ai accordé une faveur.","en":"I did you a favor.","words":[{"g":"I"},{"g":"you"},{"g":"have","l":"avoir"},null,{"g":"a"},{"g":"favour"}]},{"text":"Nous nous sommes accordés entre nous.","en":"We agreed among ourselves.","words":[{"g":"we / us"},{"g":"we / us"},{"g":"to be","l":"être"},null,null,null],"phrases":[[4,6,"between ourselves"]]},{"text":"Nous nous sommes accordées sur un prix.","en":"We agreed on a price.","words":[{"g":"we / us"},{"g":"we / us"},{"g":"to be","l":"être"},null,{"g":"on"},{"g":"a"},{"g":"prize"}]},{"text":"Il nous a accordé un entretien.","en":"He agreed to give us an interview.","words":[{"g":"he / it"},{"g":"we / us"},{"g":"has","l":"avoir"},null,{"g":"a"},{"g":"upkeep"}]},{"text":"La guitare est accordée.","en":"The guitar is in tune.","words":[{"g":"the / her"},{"g":"guitar"},{"g":"is","l":"être"},null]}]}