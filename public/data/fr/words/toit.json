{"id":"toit","lemma":"toit","pos":"noun","rank":1166,"glosses":["roof"],"ipa":"/twa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/Fr-toit.ogg/Fr-toit.ogg.mp3","gender":"m","forms":{"plural":"toits"},"formAudio":{"toits":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q150_%28fra%29-Eihel-toits.wav"},"examples":[{"text":"Je suis sur le toit.","en":"I'm on the roof.","words":[{"g":"I"},{"g":"am","l":"être"},{"g":"on"},{"g":"the / it"},null]},{"text":"Le toit est en feu.","en":"The roof is on fire.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},null,null],"phrases":[[3,5,"on fire, ablaze"]]},{"text":"Tu peux monter sur le toit ?","en":"Can you get up to the roof?","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to go up, to climb"},{"g":"on"},{"g":"the / it"},null]},{"text":"Le toit de ma maison est rouge.","en":"The roof of my house is red.","words":[{"g":"the / it"},null,{"g":"of / from"},{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"red"}]},{"text":"Je vois un oiseau sur le toit.","en":"I see a bird on the roof.","words":[null,null,{"g":"a"},{"g":"bird"},{"g":"on"},{"g":"the / it"},null],"phrases":[[0,2,"I see, right"]]}]}