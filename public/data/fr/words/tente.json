{"id":"tente","lemma":"tente","pos":"noun","rank":1316,"glosses":["tent"],"ipa":"/tɑ̃t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8e/Fr-tente.ogg/Fr-tente.ogg.mp3","gender":"f","forms":{"plural":"tentes"},"formAudio":{"tentes":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q150_%28fra%29-DenisdeShawi-tentes.wav"},"examples":[{"text":"Il faisait chaud dans la tente.","en":"It was hot inside the tent.","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"warm, hot"},{"g":"in"},{"g":"the / her"},null]},{"text":"Je tente de te parler.","en":"I'm trying to talk to you.","words":[{"g":"I"},null,{"g":"of / from"},{"g":"you"},{"g":"to speak, talk"}]},{"text":"Où voulez-vous planter la tente ?","en":"Where do you want to pitch the tent?","words":[{"g":"where"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"to plant"},{"g":"the / her"},null]},{"text":"Ne tente pas de trop porter !","en":"Don't try to carry too much.","words":[{"g":"not"},null,{"g":"not"},null,null,{"g":"to carry"}],"phrases":[[3,5,"too many"]]},{"text":"Plantons notre tente ici.","en":"Let's pitch our tent here.","words":[{"g":"to plant","l":"planter"},{"g":"our"},null,{"g":"here"}]}]}