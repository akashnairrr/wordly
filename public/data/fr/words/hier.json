{"id":"hier","lemma":"hier","pos":"adv","rank":294,"glosses":["yesterday"],"ipa":"/jɛʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/Fr-hier.ogg/Fr-hier.ogg.mp3","examples":[{"text":"Tu es allé où, hier ?","en":"Where did you go yesterday?","audio":"https://tatoeba.org/en/audio/download/334719","words":[{"g":"you"},{"g":"are","l":"être"},{"g":"to go","l":"aller"},{"g":"where"},null]},{"text":"Qu'avez-vous fait hier ?","en":"What did you do yesterday?","audio":"https://tatoeba.org/en/audio/download/334238","words":[{"g":"that / what"},{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to do","l":"faire"},null]},{"text":"Nous leur avons parlé hier.","en":"We talked to them yesterday.","audio":"https://tatoeba.org/en/audio/download/653752","words":[{"g":"we / us"},{"g":"them"},{"g":"to have","l":"avoir"},{"g":"to speak, talk","l":"parler"},null]},{"text":"Il faisait très froid hier matin.","en":"It was very cold yesterday morning.","audio":"https://tatoeba.org/en/audio/download/2254","words":[{"g":"he / it"},{"g":"to do","l":"faire"},{"g":"very"},{"g":"cold"},null,{"g":"morning"}]},{"text":"Où étiez-vous hier ?","en":"Where were you yesterday?","words":[{"g":"where"},{"g":"to be","l":"être"},{"g":"you"},null]}]}