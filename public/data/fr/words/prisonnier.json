{"id":"prisonnier","lemma":"prisonnier","pos":"noun","rank":1667,"glosses":["prisoner"],"ipa":"/pʁi.zɔ.nje/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/63/Fr-prisonnier.ogg/Fr-prisonnier.ogg.mp3","gender":"m","forms":{"plural":"prisonniers","feminine":"prisonnière"},"formAudio":{"prisonniers":"https://upload.wikimedia.org/wikipedia/commons/2/2f/LL-Q150_%28fra%29-WikiLucas00-prisonniers.wav","prisonnière":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q150_%28fra%29-WikiLucas00-prisonni%C3%A8re.wav"},"examples":[{"text":"Nous avons un prisonnier.","en":"We have a prisoner.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"a"},null]},{"text":"Où sont les autres prisonniers ?","en":"Where are the other prisoners?","words":[{"g":"where"},{"g":"to be","l":"être"},{"g":"the / them","l":"le"},{"g":"other","l":"autre"},null]},{"text":"Il est prisonnier, mais innocent.","en":"He is prisoner, but he is innocent.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"but"},{"g":"an innocent person"}]},{"text":"Nous ne sommes pas prisonniers.","en":"We're not prisoners.","words":[{"g":"we / us"},{"g":"not"},{"g":"to be","l":"être"},{"g":"not"},null]},{"text":"Ils relâchèrent la prisonnière.","en":"They released the prisoner.","words":[{"g":"they"},{"g":"to release","l":"relâcher"},{"g":"the / her"},null]}]}