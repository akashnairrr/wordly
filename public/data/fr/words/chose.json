{"id":"chose","lemma":"chose","pos":"noun","rank":66,"glosses":["thing"],"ipa":"/ʃoz/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5b/Fr-chose.ogg/Fr-chose.ogg.mp3","gender":"f","forms":{"plural":"choses"},"formAudio":{"choses":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q150_%28fra%29-DenisdeShawi-choses.wav"},"examples":[{"text":"Tu peux faire quelque chose ?","en":"Can you do something?","audio":"https://tatoeba.org/en/audio/download/1102712","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},{"g":"some"},null]},{"text":"Je peux faire beaucoup de choses.","en":"I can do a lot of things.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},{"g":"much, very much, a lot"},{"g":"of / from"},null]},{"text":"Je voudrais manger quelque chose.","en":"I want to eat something.","audio":"https://tatoeba.org/en/audio/download/334206","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to eat"},{"g":"some"},null]},{"text":"Comment tu sais toutes ces choses ?","en":"How do you know all these things?","words":[{"g":"how"},null,null,{"g":"all","l":"tout"},{"g":"it, this, that","l":"ce"},null],"phrases":[[1,3,"you know"]]},{"text":"Je déteste cette chose.","en":"I hate this thing.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"it, this, that","l":"ce"},null]}]}