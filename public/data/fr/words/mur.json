{"id":"mur","lemma":"mur","pos":"noun","rank":807,"glosses":["wall"],"ipa":"/myʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d0/Fr-mur.ogg/Fr-mur.ogg.mp3","gender":"m","forms":{"plural":"murs"},"formAudio":{"murs":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q150_%28fra%29-DenisdeShawi-murs.wav"},"examples":[{"text":"Mets-la sur le mur.","en":"Put it on the wall.","words":[{"g":"to put","l":"mettre"},{"g":"the / her"},{"g":"on"},{"g":"the / it"},null]},{"text":"Ce mur est très froid.","en":"This wall feels very cold.","words":[{"g":"this / it"},null,{"g":"is","l":"être"},{"g":"very"},{"g":"cold"}]},{"text":"Je déteste la couleur de ces murs.","en":"I hate the color of these walls.","words":[{"g":"I"},{"g":"to hate, to detest","l":"détester"},{"g":"the / her"},{"g":"color/colour"},{"g":"of / from"},{"g":"it, this, that","l":"ce"},null]},{"text":"Mettez le bureau contre le mur.","en":"Put the desk against the wall.","words":[{"g":"to put","l":"mettre"},{"g":"the / it"},{"g":"office"},{"g":"against"},{"g":"the / it"},null]},{"text":"Tu as peint les murs, non ?","en":"You've painted the walls, haven't you?","words":[{"g":"you"},{"g":"have","l":"avoir"},{"g":"to paint","l":"peindre"},{"g":"the / them","l":"le"},null,{"g":"no"}]}]}