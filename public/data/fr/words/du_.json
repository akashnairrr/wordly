{"id":"du_","lemma":"dû","pos":"noun","rank":4103,"glosses":["what is owed, what is due, money's worth"],"ipa":"/dy/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7d/LL-Q150_%28fra%29-Lyoko%C3%AF-d%C3%BB.wav/LL-Q150_%28fra%29-Lyoko%C3%AF-d%C3%BB.wav.mp3","gender":"m","forms":{"plural":"dus"},"formAudio":{"dus":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q150_%28fra%29-Lyoko%C3%AF-dus.wav"},"examples":[{"text":"Pourquoi as-tu dû t'arrêter ?","en":"Why did you have to stop?","words":[{"g":"why"},{"g":"have","l":"avoir"},{"g":"you"},null,{"g":"you"},{"g":"to stop"}]},{"text":"Elle a dû travailler beaucoup.","en":"She must have worked very hard.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},null,{"g":"to work"},{"g":"much, very much, a lot"}]},{"text":"Ils ont dû avoir un accident.","en":"They must have had an accident.","words":[{"g":"they"},{"g":"to have","l":"avoir"},null,{"g":"to have"},{"g":"a"},{"g":"accident"}]},{"text":"Tu aurais dû le faire avec nous.","en":"You should have done it with us.","audio":"https://tatoeba.org/en/audio/download/334557","words":[{"g":"you"},{"g":"to have","l":"avoir"},null,{"g":"the / it"},null,null,{"g":"we / us"}],"phrases":[[4,6,"to put up with it"]]},{"text":"J'ai dû travailler tard.","en":"I had to work late.","audio":"https://tatoeba.org/en/audio/download/1098027","words":[{"g":"I"},{"g":"have","l":"avoir"},null,{"g":"to work"},{"g":"late"}]}]}