{"id":"probablement","lemma":"probablement","pos":"adv","rank":515,"glosses":["probably"],"ipa":"/pʁɔ.ba.blə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a9/Fr-probablement.ogg/Fr-probablement.ogg.mp3","examples":[{"text":"Nous serons bientôt probablement tous morts.","en":"We'll probably all be dead soon.","audio":"https://tatoeba.org/en/audio/download/334427","words":[{"g":"we / us"},{"g":"to be","l":"être"},{"g":"soon"},null,{"g":"all"},{"g":"dead","l":"mort"}]},{"text":"Cela est probablement vrai.","en":"That's probably true.","audio":"https://tatoeba.org/en/audio/download/269098","words":[{"g":"that"},{"g":"is","l":"être"},null,{"g":"true"}]},{"text":"Il est probablement mort.","en":"He is probably dead.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"dead"}]},{"text":"Je peux probablement faire ça.","en":"I can probably do that.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},null,{"g":"to do"},{"g":"that"}]},{"text":"Ce serait probablement une bonne idée.","en":"It would probably be a good idea.","words":[{"g":"this / it"},{"g":"to be","l":"être"},null,{"g":"a"},{"g":"good","l":"bon"},{"g":"idea"}]}]}