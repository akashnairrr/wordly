{"id":"ensemble","lemma":"ensemble","pos":"adv","rank":214,"glosses":["together"],"ipa":"/ɑ̃.sɑ̃bl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c6/Fr-ensemble.ogg/Fr-ensemble.ogg.mp3","examples":[{"text":"Voulez-vous le faire ensemble ?","en":"Do you want to do it together?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"the / it"},{"g":"to do"},null]},{"text":"Allons manger ensemble.","en":"Let's go eat together.","words":[{"g":"to go","l":"aller"},{"g":"to eat"},null]},{"text":"Vous devez travailler ensemble.","en":"You must work together.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"to work"},null]},{"text":"Nous pouvons faire ceci ensemble.","en":"We can do this together.","words":[{"g":"we / us"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to do"},{"g":"this"},null]},{"text":"Jouez-vous dans un ensemble ?","en":"Do you play in a band?","words":[{"g":"to play","l":"jouer"},{"g":"you"},{"g":"in"},{"g":"a"},null]}]}