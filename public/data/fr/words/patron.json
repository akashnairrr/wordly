{"id":"patron","lemma":"patron","pos":"noun","rank":510,"glosses":["a boss, employer,","a head of a group of people, a department, a location, etc.","a member of the upper classes who offered aid and protection to those lesser than them"],"ipa":"/pa.tʁɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/32/Fr-patron.ogg/Fr-patron.ogg.mp3","gender":"m","forms":{"plural":"patrons","feminine":"patronne"},"formAudio":{"patrons":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q150_%28fra%29-WikiLucas00-patrons.wav","patronne":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q150_%28fra%29-J%C3%A9r%C3%A9my-G%C3%BCnther-Heinz_J%C3%A4hnick-patronne.wav"},"examples":[{"text":"Où est le patron ?","en":"Where's the boss?","audio":"https://tatoeba.org/en/audio/download/75519","words":[{"g":"where"},{"g":"is","l":"être"},{"g":"the / it"},null]},{"text":"Es-tu le patron ?","en":"Are you the boss?","words":[{"g":"are","l":"être"},{"g":"you"},{"g":"the / it"},null]},{"text":"Mon patron est un connard.","en":"My boss is a jerk.","audio":"https://tatoeba.org/en/audio/download/1097918","words":[{"g":"my"},null,{"g":"is","l":"être"},{"g":"a"},{"g":"bastard, jerk, asshole"}]},{"text":"As-tu déjà appelé le patron ?","en":"Have you called the boss already?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"already, before"},{"g":"to call","l":"appeler"},{"g":"the / it"},null]},{"text":"Vous êtes mon patron.","en":"You're my boss.","audio":"https://tatoeba.org/en/audio/download/351796","words":[{"g":"you"},{"g":"to be","l":"être"},{"g":"my"},null]}]}