{"id":"correctement","lemma":"correctement","pos":"adv","rank":2359,"glosses":["correctly (in a correct manner)"],"ipa":"/kɔ.ʁɛk.tə.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/LL-Q150_%28fra%29-WikiLucas00-correctement.wav/LL-Q150_%28fra%29-WikiLucas00-correctement.wav.mp3","examples":[{"text":"Ai-je compris cela correctement ?","en":"Did I understand that correctly?","words":[{"g":"have","l":"avoir"},{"g":"I"},{"g":"to understand","l":"comprendre"},{"g":"that"},null]},{"text":"Je veux le faire correctement.","en":"I want to do it right.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"the / it"},{"g":"to do"},null]},{"text":"Ils veulent faire cela correctement.","en":"They want to do this right.","words":[{"g":"they"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to do"},{"g":"that"},null]},{"text":"Essaie, et fais-le correctement cette fois.","en":"Try and do it right this time.","words":[{"g":"to test, to try on","l":"essayer"},{"g":"and"},{"g":"to do","l":"faire"},{"g":"the / it"},null,{"g":"it, this, that","l":"ce"},{"g":"time"}]},{"text":"Il le fait correctement.","en":"He's doing it right.","words":[{"g":"he / it"},{"g":"the / it"},{"g":"to do","l":"faire"},null]}]}