{"id":"haleine","lemma":"haleine","pos":"noun","rank":4169,"glosses":["breath","breathing, respiration"],"ipa":"/a.lɛn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/48/Fr-haleine.ogg/Fr-haleine.ogg.mp3","gender":"f","forms":{"plural":"haleines"},"examples":[{"text":"J'ai mauvaise haleine.","en":"I have bad breath.","audio":"https://tatoeba.org/en/audio/download/2283","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"bad","l":"mauvais"},null]},{"text":"Il était hors d'haleine.","en":"He was out of breath.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"outside, out of, off"},{"g":"of / from"},null]},{"text":"Fais-moi sentir ton haleine !","en":"Let me smell your breath.","words":[{"g":"to do","l":"faire"},{"g":"me"},{"g":"to smell"},{"g":"your"},null]},{"text":"Tout le monde est en haleine.","en":"Everyone gasps.","words":[null,null,null,{"g":"is","l":"être"},{"g":"in / of it"},null],"phrases":[[0,3,"everyone, everybody"]]},{"text":"Je pouvais sentir l'alcool de son haleine.","en":"I could smell the alcohol on his breath.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to smell"},{"g":"the / it"},{"g":"alcohol"},{"g":"of / from"},{"g":"his, her, its"},null]}]}