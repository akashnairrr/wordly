{"id":"expose_","lemma":"exposé","pos":"adj","rank":3038,"glosses":["exposed"],"ipa":"/ɛk.spo.ze/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/43/Fr-expos%C3%A9.ogg/Fr-expos%C3%A9.ogg.mp3","forms":{"feminine":"exposée","masculinePlural":"exposés","femininePlural":"exposées"},"formAudio":{"exposée":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q150_%28fra%29-Lyoko%C3%AF-expos%C3%A9e.wav","exposés":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q150_%28fra%29-LightD31-expos%C3%A9s.wav"},"examples":[{"text":"Il a été exposé au danger.","en":"He was exposed to danger.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"summer"},null,{"g":"to the"},{"g":"danger"}]},{"text":"Ma maison est exposée plein sud.","en":"My house looks to the south.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},null,{"g":"full, full up"},{"g":"south"}]},{"text":"Sont-ils exposés tout au long de l'année ?","en":"Are they displayed all through the year?","words":[{"g":"to be","l":"être"},{"g":"they"},null,{"g":"all"},null,null,null,{"g":"the / it"},{"g":"year"}],"phrases":[[4,7,"during"]]},{"text":"Tu devrais me laisser faire tout l’exposé.","en":"You should let me do all the talking.","words":[{"g":"you"},{"g":"must","l":"devoir"},{"g":"me"},null,null,{"g":"all"},{"g":"the / it"},null],"phrases":[[3,5,"to let someone do as…"]]},{"text":"Ma chambre est exposée à l'est.","en":"My room faces east.","words":[{"g":"my","l":"mon"},{"g":"a room."},{"g":"is","l":"être"},null,{"g":"to / at"},{"g":"the / it"},{"g":"is","l":"être"}]}]}