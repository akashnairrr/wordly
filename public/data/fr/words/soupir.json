{"id":"soupir","lemma":"soupir","pos":"noun","rank":2676,"glosses":["sigh","quarter note rest"],"ipa":"/su.piʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/07/Fr-soupir.ogg/Fr-soupir.ogg.mp3","gender":"m","forms":{"plural":"soupirs"},"examples":[{"text":"Il a rendu son dernier soupir.","en":"He breathed his last breath.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"to return","l":"rendre"},{"g":"his, her, its"},{"g":"last"},null]},{"text":"La jeune fille poussa un soupir.","en":"The young girl sighed.","words":[{"g":"the / her"},null,null,{"g":"to push","l":"pousser"},{"g":"a"},null],"phrases":[[1,3,"a girl"]]},{"text":"Il rendit son dernier soupir.","en":"He breathed his last.","words":[{"g":"he / it"},{"g":"to return","l":"rendre"},{"g":"his, her, its"},{"g":"last"},null]},{"text":"Tout le monde a poussé un soupir de soulagement.","en":"Everyone breathed a sigh of relief.","words":[null,null,null,{"g":"has","l":"avoir"},{"g":"up bow"},{"g":"a"},null,{"g":"of / from"},{"g":"relief"}],"phrases":[[0,3,"everyone, everybody"]]},{"text":"Une fois dehors, je poussai un profond soupir de soulagement.","en":"Once outside, I gave a deep sigh of relief.","words":[null,null,{"g":"outside"},{"g":"I"},{"g":"to push","l":"pousser"},{"g":"a"},{"g":"deep"},null,{"g":"of / from"},{"g":"relief"}],"phrases":[[0,2,"once, one time"]]}]}