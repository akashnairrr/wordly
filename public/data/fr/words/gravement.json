{"id":"gravement","lemma":"gravement","pos":"adv","rank":4288,"glosses":["seriously, badly"],"ipa":"/ɡʁav.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/77/Fr-gravement.ogg/Fr-gravement.ogg.mp3","examples":[{"text":"Je suis gravement blessé.","en":"I'm badly wounded.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"injured, wounded"}]},{"text":"Elle est tombée gravement malade.","en":"She became very ill.","audio":"https://tatoeba.org/en/audio/download/12428","words":[{"g":"she / it"},{"g":"is","l":"être"},{"g":"fall"},null,{"g":"ill, sick"}]},{"text":"Tu es gravement malade.","en":"You're very sick.","words":[{"g":"you"},{"g":"are","l":"être"},null,{"g":"ill, sick"}]},{"text":"J'étais gravement blessé.","en":"I was badly wounded.","words":[{"g":"I"},{"g":"to be","l":"être"},null,{"g":"injured, wounded"}]},{"text":"Il s'est gravement brûlé.","en":"He burned himself badly.","words":[{"g":"he / it"},{"g":"oneself / if"},{"g":"is","l":"être"},null,{"g":"burnt, burned"}]}]}