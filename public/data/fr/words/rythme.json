{"id":"rythme","lemma":"rythme","pos":"noun","rank":1710,"glosses":["rhythm"],"ipa":"/ʁitm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/57/Fr-rythme.ogg/Fr-rythme.ogg.mp3","gender":"m","forms":{"plural":"rythmes"},"formAudio":{"rythmes":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q150_%28fra%29-0x010C-rythmes.wav"},"examples":[{"text":"Je veux travailler à mon rythme.","en":"I want to work at my own pace.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"to work"},{"g":"to / at"},{"g":"my"},null]},{"text":"Je fais les choses à mon propre rythme.","en":"I do things at my own pace.","words":[{"g":"I"},{"g":"to do","l":"faire"},{"g":"the / them","l":"le"},{"g":"thing","l":"chose"},{"g":"to / at"},{"g":"my"},{"g":"own"},null]},{"text":"Il marchait à un rythme rapide.","en":"He walked at a quick pace.","words":[{"g":"he / it"},{"g":"to walk","l":"marcher"},{"g":"to / at"},{"g":"a"},null,{"g":"fast, quick"}]},{"text":"Je ne peux pas suivre ton rythme.","en":"I can't keep pace with you.","words":[{"g":"I"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"not"},{"g":"to follow"},{"g":"your"},null]},{"text":"Mon rythme cardiaque est lent.","en":"My pulse is slow.","words":[{"g":"my"},null,{"g":"cardiac"},{"g":"is","l":"être"},{"g":"slow"}]}]}