{"id":"crainte","lemma":"crainte","pos":"noun","rank":2776,"glosses":["fear, fright"],"ipa":"/kʁɛ̃t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e4/Fr-crainte.ogg/Fr-crainte.ogg.mp3","gender":"f","forms":{"plural":"craintes"},"formAudio":{"craintes":"https://upload.wikimedia.org/wikipedia/commons/4/4f/LL-Q150_%28fra%29-Eihel-craintes.wav"},"examples":[{"text":"Quelle est votre plus grosse crainte ?","en":"What's your biggest fear?","words":[{"g":"which?"},{"g":"is","l":"être"},{"g":"your, belonging to you"},{"g":"more / no longer"},{"g":"big, thick, fat","l":"gros"},null]},{"text":"N'ayez crainte.","en":"Fear nothing.","words":[{"g":"not"},null,null]},{"text":"N'aie aucune crainte.","en":"Fear nothing.","words":[{"g":"not"},{"g":"to have","l":"avoir"},{"g":"none, no-one","l":"aucun"},null]},{"text":"Mes pires craintes sont devenues réalité.","en":"My worst fears came true.","words":[{"g":"my"},{"g":"worse, worst","l":"pire"},null,{"g":"to be","l":"être"},null,{"g":"reality"}]},{"text":"Ce garçon ne montra aucune crainte.","en":"That boy displayed no fear.","words":[{"g":"this / it"},{"g":"boy"},{"g":"not"},{"g":"to show","l":"montrer"},{"g":"none, no-one","l":"aucun"},null]}]}