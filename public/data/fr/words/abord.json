{"id":"abord","lemma":"abord","pos":"noun","rank":370,"glosses":["d'abord = first, at first"],"ipa":"/a.bɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c7/Fr-abord.ogg/Fr-abord.ogg.mp3","gender":"m","forms":{"plural":"abords"},"formAudio":{"abords":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q150_%28fra%29-Eihel-abords.wav"},"examples":[{"text":"Fais ça d'abord.","en":"Do this first.","audio":"https://tatoeba.org/en/audio/download/1093500","words":[{"g":"to do","l":"faire"},{"g":"that"},{"g":"of / from"},null]},{"text":"Faisons d'abord ceci.","en":"Let's do this first of all.","words":[{"g":"to do","l":"faire"},{"g":"of / from"},null,{"g":"this"}]},{"text":"Tout d'abord, je dois dire ceci.","en":"First of all, I must say this.","words":[{"g":"all"},{"g":"of / from"},null,{"g":"I"},{"g":"must","l":"devoir"},{"g":"to say, to tell"},{"g":"this"}]},{"text":"Je dois d'abord finir ce travail.","en":"I must finish this work first.","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"of / from"},null,{"g":"to finish"},{"g":"this / it"},{"g":"work"}]},{"text":"Vas-y d'abord.","en":"You go first.","words":[{"g":"to go","l":"aller"},{"g":"there"},{"g":"of / from"},null]}]}