{"id":"bru_lant","lemma":"brûlant","pos":"adj","rank":4748,"glosses":["burning"],"ipa":"/bʁy.lɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/Fr-br%C3%BBlant.ogg/Fr-br%C3%BBlant.ogg.mp3","forms":{"feminine":"brûlante","masculinePlural":"brûlants","femininePlural":"brûlantes"},"formAudio":{"brûlante":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q150_%28fra%29-Poslovitch-br%C3%BBlante.wav","brûlants":"https://upload.wikimedia.org/wikipedia/commons/8/8b/LL-Q150_%28fra%29-Totodu74-br%C3%BBlants.wav","brûlantes":"https://upload.wikimedia.org/wikipedia/commons/e/e5/LL-Q150_%28fra%29-Totodu74-br%C3%BBlantes.wav"},"examples":[{"text":"La pièce est brûlante.","en":"The room is hot.","words":[{"g":"the / her"},{"g":"room in a house, etc."},{"g":"is","l":"être"},null]},{"text":"Le thé est brûlant.","en":"The tea is hot.","words":[{"g":"the / it"},{"g":"tea"},{"g":"is","l":"être"},null]},{"text":"L'eau est brûlante.","en":"The water is hot.","words":[{"g":"the / it"},{"g":"water"},{"g":"is","l":"être"},null]},{"text":"J'aime le café brûlant.","en":"I like coffee hot.","words":[{"g":"I"},{"g":"to love","l":"aimer"},{"g":"the / it"},{"g":"coffee"},null]},{"text":"Il était brûlant de fièvre.","en":"He was burning with fever.","words":[{"g":"he / it"},{"g":"to be","l":"être"},null,{"g":"of / from"},{"g":"fever"}]}]}