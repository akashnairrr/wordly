{"id":"su_rement","lemma":"sûrement","pos":"adv","rank":416,"glosses":["surely, certainly","probably"],"ipa":"/syʁ.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/Fr-s%C3%BBrement.ogg/Fr-s%C3%BBrement.ogg.mp3","examples":[{"text":"Je vais sûrement venir avec toi.","en":"I might go with you.","words":[{"g":"I"},{"g":"to go","l":"aller"},null,{"g":"to come"},{"g":"with"},{"g":"you"}]},{"text":"C'est sûrement possible.","en":"That's certainly possible.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"possible"}]},{"text":"Sûrement, vous avez raison.","en":"Certainly, you're right.","words":[null,{"g":"you"},{"g":"to have","l":"avoir"},{"g":"reason"}]},{"text":"C'est sûrement un bon garçon.","en":"He must be a good boy.","words":[{"g":"it / that"},{"g":"is","l":"être"},null,{"g":"a"},{"g":"good"},{"g":"boy"}]},{"text":"Il est sûrement en retard pour l'école.","en":"He is likely to be late for school.","audio":"https://tatoeba.org/en/audio/download/27284","words":[{"g":"he / it"},{"g":"is","l":"être"},null,null,null,{"g":"for"},{"g":"the / it"},{"g":"school"}],"phrases":[[3,5,"late, overdue"]]}]}