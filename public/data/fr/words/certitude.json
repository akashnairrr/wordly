{"id":"certitude","lemma":"certitude","pos":"noun","rank":4237,"glosses":["certitude"],"ipa":"/sɛʁ.ti.tyd/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a2/Fr-Paris--certitude.ogg/Fr-Paris--certitude.ogg.mp3","gender":"f","forms":{"plural":"certitudes"},"formAudio":{"certitudes":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q150_%28fra%29-Lyoko%C3%AF-certitudes.wav"},"examples":[{"text":"Nous ne savons pas avec certitude.","en":"We don't know exactly.","words":[{"g":"we / us"},{"g":"not"},{"g":"soap","l":"savon"},{"g":"not"},{"g":"with"},null]},{"text":"Je ne peux pas le dire avec certitude.","en":"I can't say for sure.","words":[{"g":"I"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"not"},{"g":"the / it"},{"g":"to say, to tell"},{"g":"with"},null]},{"text":"Quelle certitude avez-vous qu'il soit un criminel ?","en":"How certain are you that he's a criminal?","words":[{"g":"which?"},null,{"g":"to have","l":"avoir"},{"g":"you"},{"g":"that / what"},{"g":"he / it"},{"g":"let be"},{"g":"a"},{"g":"criminal"}]},{"text":"Je ne sais pas avec certitude quand il arrivera.","en":"I don't know for certain when he will arrive.","words":[null,null,null,null,{"g":"with"},null,{"g":"when"},{"g":"he / it"},{"g":"to arrive","l":"arriver"}],"phrases":[[0,4,"I don't know"]]},{"text":"Nous ne le saurons jamais avec certitude.","en":"We'll never know for sure.","words":[{"g":"we / us"},{"g":"not"},{"g":"the / it"},{"g":"to know","l":"savoir"},{"g":"never"},{"g":"with"},null]}]}