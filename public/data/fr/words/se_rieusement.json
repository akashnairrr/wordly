{"id":"se_rieusement","lemma":"sérieusement","pos":"adv","rank":786,"glosses":["seriously"],"ipa":"/se.ʁjøz.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/Fr-s%C3%A9rieusement.ogg/Fr-s%C3%A9rieusement.ogg.mp3","examples":[{"text":"Es-tu sérieusement malade ?","en":"Are you seriously ill?","words":[{"g":"are","l":"être"},{"g":"you"},null,{"g":"ill, sick"}]},{"text":"Penses-tu cela sérieusement ?","en":"Do you seriously think that?","words":[{"g":"to think","l":"penser"},{"g":"you"},{"g":"that"},null]},{"text":"Êtes-vous sérieusement malade ?","en":"Are you seriously ill?","words":[{"g":"to be","l":"être"},{"g":"you"},null,{"g":"ill, sick"}]},{"text":"J'en doute sérieusement.","en":"I seriously doubt it.","words":[{"g":"I"},{"g":"in / of it"},{"g":"doubt"},null]},{"text":"Nous devons prendre ça très sérieusement.","en":"We need to take this very seriously.","words":[{"g":"we / us"},{"g":"must","l":"devoir"},{"g":"to take"},{"g":"that"},{"g":"very"},null]}]}