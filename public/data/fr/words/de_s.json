{"id":"de_s","lemma":"dès","pos":"prep","rank":406,"glosses":["from, as soon as","since"],"ipa":"/dɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f2/Fr-d%C3%A8s.ogg/Fr-d%C3%A8s.ogg.mp3","examples":[{"text":"Viens dès que tu peux.","en":"Come as soon as you can.","words":[{"g":"to come","l":"venir"},null,{"g":"that / what"},{"g":"you"},{"g":"can, to be able to","l":"pouvoir"}]},{"text":"Je le ferai dès que possible.","en":"I'll do that as soon as possible.","words":[{"g":"I"},{"g":"the / it"},{"g":"to do","l":"faire"},null,{"g":"that / what"},{"g":"possible"}]},{"text":"Revenez dès que vous pouvez.","en":"Come back as soon as you can.","words":[{"g":"to come back","l":"revenir"},null,{"g":"that / what"},{"g":"you"},{"g":"can, to be able to","l":"pouvoir"}]},{"text":"Je vais le faire dès demain.","en":"I'm going to do it first thing tomorrow.","words":[{"g":"I"},{"g":"to go","l":"aller"},{"g":"the / it"},{"g":"to do"},null,{"g":"tomorrow"}]},{"text":"Je commence dès ce soir.","en":"I am starting this evening.","words":[{"g":"I"},{"g":"to begin, commence","l":"commencer"},null,{"g":"this / it"},{"g":"evening"}]}]}