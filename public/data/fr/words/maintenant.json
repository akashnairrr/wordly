{"id":"maintenant","lemma":"maintenant","pos":"adv","rank":79,"glosses":["now, currently"],"ipa":"/mɛ̃t.nɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/58/Fr-maintenant.ogg/Fr-maintenant.ogg.mp3","examples":[{"text":"Faites-le maintenant.","en":"Do it now.","audio":"https://tatoeba.org/en/audio/download/473144","words":[{"g":"to do","l":"faire"},{"g":"the / it"},null]},{"text":"Maintenant laissez-nous.","en":"Now leave us.","audio":"https://tatoeba.org/en/audio/download/671976","words":[null,{"g":"to leave","l":"laisser"},{"g":"we / us"}]},{"text":"Je dois partir maintenant.","en":"I must go now.","audio":"https://tatoeba.org/en/audio/download/12622","words":[{"g":"I"},{"g":"must","l":"devoir"},{"g":"to go away"},null]},{"text":"Tu peux regarder, maintenant.","en":"You can look now.","audio":"https://tatoeba.org/en/audio/download/214461","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to look at"},null]},{"text":"Où sommes-nous maintenant ?","en":"Where are we now?","audio":"https://tatoeba.org/en/audio/download/220662","words":[{"g":"where"},{"g":"to be","l":"être"},{"g":"we / us"},null]}]}