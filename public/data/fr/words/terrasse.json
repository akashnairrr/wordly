{"id":"terrasse","lemma":"terrasse","pos":"noun","rank":4565,"glosses":["terrace"],"ipa":"/tɛ.ʁas/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1a/Fr-terrasse.ogg/Fr-terrasse.ogg.mp3","gender":"f","forms":{"plural":"terrasses"},"formAudio":{"terrasses":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q150_%28fra%29-Eihel-terrasses.wav"},"examples":[{"text":"Vous pouvez fumer seulement en terrasse.","en":"You can only smoke on the patio.","words":[{"g":"you"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to smoke"},{"g":"only"},{"g":"in / of it"},null]},{"text":"Balaie la terrasse.","en":"Sweep the terrace.","words":[{"g":"to sweep","l":"balayer"},{"g":"the / her"},null]},{"text":"Sortons sur la terrasse.","en":"Let's go out on the terrace.","words":[{"g":"to exit","l":"sortir"},{"g":"on"},{"g":"the / her"},null]},{"text":"Vous ne pouvez fumer que sur la terrasse.","en":"You can only smoke on the terrace.","words":[{"g":"you"},{"g":"not"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to smoke"},{"g":"that / what"},{"g":"on"},{"g":"the / her"},null]},{"text":"Transportez toutes les chaises sur la terrasse.","en":"Carry all the chairs to the terrace.","words":[{"g":"to transport","l":"transporter"},{"g":"all","l":"tout"},{"g":"the / them","l":"le"},{"g":"chair, seat","l":"chaise"},{"g":"on"},{"g":"the / her"},null]}]}