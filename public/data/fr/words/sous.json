{"id":"sous","lemma":"sous","pos":"prep","rank":220,"glosses":["below, under"],"ipa":"/su/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/88/Fr-sous.ogg/Fr-sous.ogg.mp3","examples":[{"text":"Cache-le sous le lit.","en":"Hide it under the bed.","audio":"https://tatoeba.org/en/audio/download/1103058","words":[{"g":"to hide","l":"cacher"},{"g":"the / it"},null,{"g":"the / it"},{"g":"bed"}]},{"text":"Tout est-il sous contrôle ?","en":"Is it all under control?","words":[{"g":"all"},{"g":"is","l":"être"},{"g":"he / it"},null,{"g":"control"}]},{"text":"Le chien est sous la table.","en":"The dog is under the table.","words":[{"g":"the / it"},{"g":"dog"},{"g":"is","l":"être"},null,{"g":"the / her"},{"g":"table"}]},{"text":"Regarde sous le siège.","en":"Look under the seat.","words":[{"g":"to look at","l":"regarder"},null,{"g":"the / it"},{"g":"seat, chair"}]},{"text":"Avez-vous regardé sous la voiture ?","en":"Did you look under the car?","words":[{"g":"to have","l":"avoir"},{"g":"you"},{"g":"to look at","l":"regarder"},null,{"g":"the / her"},{"g":"car"}]}]}