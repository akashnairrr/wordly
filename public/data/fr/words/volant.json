{"id":"volant","lemma":"volant","pos":"noun","rank":1848,"glosses":["steering wheel","flywheel","flounce"],"ipa":"/vɔ.lɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d8/Fr-volant.ogg/Fr-volant.ogg.mp3","gender":"m","forms":{"plural":"volants"},"formAudio":{"volants":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q150_%28fra%29-Le_Commissaire-volants.wav"},"examples":[{"text":"Prenez le volant.","en":"Take the wheel.","words":[{"g":"to take","l":"prendre"},{"g":"the / it"},null]},{"text":"Une voiture a un volant.","en":"A car has one steering wheel.","words":[{"g":"a"},{"g":"car"},{"g":"has","l":"avoir"},{"g":"a"},null]},{"text":"Je prendrai le volant.","en":"I'll take the wheel.","words":[{"g":"I"},{"g":"to take","l":"prendre"},{"g":"the / it"},null]},{"text":"Une jeune fille était au volant.","en":"A young girl was at the steering wheel.","words":[{"g":"a"},null,null,{"g":"to be","l":"être"},{"g":"to the"},null],"phrases":[[1,3,"a girl"]]},{"text":"Laisse-moi le volant.","en":"Leave the driving to me.","words":[{"g":"to leave","l":"laisser"},{"g":"me"},{"g":"the / it"},null]}]}