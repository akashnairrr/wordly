{"id":"dit","lemma":"dit","pos":"verb","rank":4557,"glosses":["Indicating a surname used as a family name."],"ipa":"/di/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/Fr-Paris--dit.ogg/Fr-Paris--dit.ogg.mp3","examples":[{"text":"Fais comme il te dit.","en":"Do as he tells you.","audio":"https://tatoeba.org/en/audio/download/69453","words":[{"g":"to do","l":"faire"},{"g":"as"},{"g":"he / it"},{"g":"you"},null]},{"text":"Il me dit quand dire oui.","en":"He told me when to say yes.","audio":"https://tatoeba.org/en/audio/download/26382","words":[{"g":"he / it"},{"g":"me"},null,{"g":"when"},{"g":"to say, to tell"},{"g":"yes"}]},{"text":"Que dit-elle ?","en":"What does she say?","words":[{"g":"that / what"},null,{"g":"she / it"}]},{"text":"Que dit le garçon ?","en":"What did the boy say?","words":[{"g":"that / what"},null,{"g":"the / it"},{"g":"boy"}]},{"text":"Qui dit la vérité ?","en":"Who's telling the truth?","words":[{"g":"who"},null,{"g":"the / her"},{"g":"truth"}]}]}