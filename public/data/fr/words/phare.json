{"id":"phare","lemma":"phare","pos":"noun","rank":4910,"glosses":["lighthouse","lantern (in a lighthouse)","headlight (of a vehicle)"],"ipa":"/faʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ee/Fr-phare.ogg/Fr-phare.ogg.mp3","gender":"m","forms":{"plural":"phares"},"formAudio":{"phares":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q150_%28fra%29-Eihel-phares.wav"},"examples":[{"text":"Veux-tu encore aller jusqu'au phare ?","en":"Do you still want to go to the lighthouse?","words":[{"g":"to want, wish, desire","l":"vouloir"},{"g":"you"},{"g":"still"},{"g":"to go"},null,{"g":"to the"},null]},{"text":"Allume les phares !","en":"Turn on the lights.","words":[{"g":"to light","l":"allumer"},{"g":"the / them","l":"le"},null]},{"text":"As-tu fait un appel de phares ?","en":"Did you flash your lights?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to do","l":"faire"},{"g":"a"},{"g":"call"},{"g":"of / from"},null]},{"text":"Les phares sont allumés.","en":"The lights are on.","words":[{"g":"the / them","l":"le"},null,{"g":"to be","l":"être"},{"g":"lit, on, lit up","l":"allumé"}]},{"text":"J'ai allumé les phares.","en":"I turned on the lights.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"lit, on, lit up"},{"g":"the / them","l":"le"},null]}]}