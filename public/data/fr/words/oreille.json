{"id":"oreille","lemma":"oreille","pos":"noun","rank":1291,"glosses":["ear"],"ipa":"/ɔ.ʁɛj/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b8/Fr-oreille.ogg/Fr-oreille.ogg.mp3","gender":"f","forms":{"plural":"oreilles"},"formAudio":{"oreilles":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q150_%28fra%29-Lyoko%C3%AF-oreilles.wav"},"examples":[{"text":"Nous avons deux oreilles.","en":"We have two ears.","words":[{"g":"we / us"},{"g":"to have","l":"avoir"},{"g":"two"},null]},{"text":"Un chat a deux oreilles.","en":"A cat has two ears.","words":[{"g":"a"},{"g":"cat"},{"g":"has","l":"avoir"},{"g":"two"},null]},{"text":"Il a une bonne oreille pour la musique.","en":"He has a good ear for music.","words":[{"g":"he / it"},{"g":"has","l":"avoir"},{"g":"a"},{"g":"good","l":"bon"},null,{"g":"for"},{"g":"the / her"},{"g":"music"}]},{"text":"J'entends avec mes oreilles.","en":"I hear with my ears.","words":[{"g":"I"},{"g":"to hear","l":"entendre"},{"g":"with"},{"g":"my"},null]},{"text":"Elle joue du piano à l'oreille.","en":"She plays the piano by ear.","words":[{"g":"she / it"},{"g":"to play","l":"jouer"},{"g":"of the / some"},{"g":"piano"},{"g":"to / at"},{"g":"the / it"},null]}]}