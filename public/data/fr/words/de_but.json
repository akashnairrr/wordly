{"id":"de_but","lemma":"début","pos":"noun","rank":484,"glosses":["start, beginning"],"ipa":"/de.by/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/45/Fr-d%C3%A9but.ogg/Fr-d%C3%A9but.ogg.mp3","gender":"m","forms":{"plural":"débuts"},"formAudio":{"débuts":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q150_%28fra%29-Lyoko%C3%AF-d%C3%A9buts.wav"},"examples":[{"text":"Le début est facile.","en":"The beginning is easy.","words":[{"g":"the / it"},null,{"g":"is","l":"être"},{"g":"easy, simple"}]},{"text":"Ça serait un bon début.","en":"That would be a good start.","words":[{"g":"that"},{"g":"to be","l":"être"},{"g":"a"},{"g":"good"},null]},{"text":"Tout début est difficile.","en":"All beginnings are difficult.","words":[{"g":"all"},null,{"g":"is","l":"être"},{"g":"difficult"}]},{"text":"Il nous faut commencer au début.","en":"We must start at the beginning.","words":[{"g":"he / it"},{"g":"we / us"},{"g":"to need","l":"falloir"},{"g":"to begin, commence"},{"g":"to the"},null]},{"text":"Je le savais depuis le début.","en":"I knew it all along.","words":[{"g":"I"},{"g":"the / it"},{"g":"to know","l":"savoir"},{"g":"since"},{"g":"the / it"},null]}]}