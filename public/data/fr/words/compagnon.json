{"id":"compagnon","lemma":"compagnon","pos":"noun","rank":3432,"glosses":["lifelong partner, significant other","companion","friend, buddy, pal"],"ipa":"/kɔ̃.pa.ɲɔ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6a/Fr-compagnon.ogg/Fr-compagnon.ogg.mp3","gender":"m","forms":{"plural":"compagnons","feminine":"compagne"},"formAudio":{"compagnons":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q150_%28fra%29-Eihel-compagnons.wav","compagne":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q150_%28fra%29-WikiLucas00-compagne.wav"},"examples":[{"text":"Je connais ton compagnon de chambre.","en":"I know your roommate.","words":[{"g":"I"},{"g":"to know","l":"connaître"},{"g":"your"},null,{"g":"of / from"},{"g":"a room."}]},{"text":"Comment va ta compagne ?","en":"How's your old lady doing?","words":[{"g":"how"},{"g":"to go","l":"aller"},{"g":"your"},null]},{"text":"Je veux que tu sois mon compagnon.","en":"I want you to be my partner.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"that / what"},{"g":"you"},{"g":"to be","l":"être"},{"g":"my"},null]},{"text":"Je veux que vous soyez ma compagne.","en":"I want you to be my partner.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},{"g":"that / what"},{"g":"you"},{"g":"to be","l":"être"},{"g":"my","l":"mon"},null]},{"text":"C'est mon compagnon.","en":"He's my partner.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"my"},null]}]}