{"id":"c-ur","lemma":"cœur","pos":"noun","rank":415,"glosses":["heart (organ)","heart (shape)","heart (love)"],"ipa":"/kœʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bc/Fr-c%C5%93ur.ogg/Fr-c%C5%93ur.ogg.mp3","gender":"m","forms":{"plural":"cœurs"},"formAudio":{"cœurs":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q150_%28fra%29-Eihel-c%C5%93urs.wav"},"examples":[{"text":"Elle a bon cœur.","en":"She has a good heart.","words":[{"g":"she / it"},{"g":"has","l":"avoir"},{"g":"good"},null]},{"text":"Il sera toujours dans mon cœur.","en":"He will always be in my heart.","words":[{"g":"he / it"},{"g":"to be","l":"être"},{"g":"always"},{"g":"in"},{"g":"my"},null]},{"text":"Merci du fond du cœur.","en":"From the bottom of my heart, thank you.","words":[{"g":"thank you"},{"g":"of the / some"},{"g":"bottom, back"},{"g":"of the / some"},null]},{"text":"Je le connais par cœur.","en":"I know it by heart.","words":[{"g":"I"},{"g":"the / it"},{"g":"to know","l":"connaître"},{"g":"through"},null]},{"text":"Il demeurera à jamais dans nos cœurs.","en":"He will forever be in our hearts.","words":[{"g":"he / it"},{"g":"to live, stay","l":"demeurer"},null,null,{"g":"in"},{"g":"our","l":"notre"},null],"phrases":[[2,4,"forever and ever"]]}]}