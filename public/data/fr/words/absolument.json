{"id":"absolument","lemma":"absolument","pos":"adv","rank":552,"glosses":["absolutely; totally; completely","at all costs"],"ipa":"/ap.sɔ.ly.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a2/Fr-absolument.ogg/Fr-absolument.ogg.mp3","examples":[{"text":"Es-tu absolument sûr de ça ?","en":"Are you absolutely sure of that?","words":[{"g":"are","l":"être"},{"g":"you"},null,{"g":"sure, certain"},{"g":"of / from"},{"g":"that"}]},{"text":"Est-ce absolument nécessaire ?","en":"Is this absolutely necessary?","words":[{"g":"is","l":"être"},{"g":"this / it"},null,{"g":"necessary"}]},{"text":"Je veux absolument tout savoir.","en":"I want to know absolutely everything.","words":[{"g":"I"},{"g":"to want, wish, desire","l":"vouloir"},null,{"g":"all"},{"g":"to know"}]},{"text":"Êtes-vous absolument certaine de cela ?","en":"Are you absolutely sure of that?","words":[{"g":"to be","l":"être"},{"g":"you"},null,{"g":"certain, guaranteed","l":"certain"},{"g":"of / from"},{"g":"that"}]},{"text":"Nous devons absolument y aller.","en":"We absolutely have to go.","words":[{"g":"we / us"},{"g":"must","l":"devoir"},null,null,null],"phrases":[[3,5,"to leave"]]}]}