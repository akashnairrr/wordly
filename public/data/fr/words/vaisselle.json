{"id":"vaisselle","lemma":"vaisselle","pos":"noun","rank":3341,"glosses":["crockery, dishes, dishware","table- and cookware that remains to be washed"],"ipa":"/vɛ.sɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a1/Fr-vaisselle.ogg/Fr-vaisselle.ogg.mp3","gender":"f","examples":[{"text":"Faisons la vaisselle.","en":"Let's do the dishes.","audio":"https://tatoeba.org/en/audio/download/12291","words":[{"g":"to do","l":"faire"},{"g":"the / her"},null]},{"text":"Où est la vaisselle ?","en":"Where are the dishes?","words":[{"g":"where"},{"g":"is","l":"être"},{"g":"the / her"},null]},{"text":"Mon père fait souvent la vaisselle.","en":"My father often washes the dishes.","words":[{"g":"my"},{"g":"father"},{"g":"to do","l":"faire"},{"g":"often"},{"g":"the / her"},null]},{"text":"Va laver la vaisselle.","en":"Go wash the dishes.","words":[{"g":"to go","l":"aller"},{"g":"to wash"},{"g":"the / her"},null]},{"text":"As-tu fini de faire la vaisselle ?","en":"Have you finished washing the dishes?","words":[{"g":"have","l":"avoir"},{"g":"you"},{"g":"to finish","l":"finir"},{"g":"of / from"},{"g":"to do"},{"g":"the / her"},null]}]}