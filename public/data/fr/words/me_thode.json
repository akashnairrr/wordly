{"id":"me_thode","lemma":"méthode","pos":"noun","rank":2383,"glosses":["method","book, textbook"],"ipa":"/me.tɔd/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ec/Fr-m%C3%A9thode.ogg/Fr-m%C3%A9thode.ogg.mp3","gender":"f","forms":{"plural":"méthodes"},"formAudio":{"méthodes":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q150_%28fra%29-Eihel-m%C3%A9thodes.wav"},"examples":[{"text":"Votre méthode est meilleure.","en":"Your method is better.","words":[{"g":"your, belonging to you"},null,{"g":"is","l":"être"},{"g":"best, better","l":"meilleur"}]},{"text":"Connais-tu une meilleure méthode ?","en":"Do you know a better way?","words":[{"g":"to know","l":"connaître"},{"g":"you"},{"g":"a"},{"g":"best, better","l":"meilleur"},null]},{"text":"C'est la meilleur méthode.","en":"This is the best method.","words":[{"g":"it / that"},{"g":"is","l":"être"},{"g":"the / her"},{"g":"best, better"},null]},{"text":"Toutes ces méthodes fonctionnent.","en":"All these methods work.","words":[{"g":"all","l":"tout"},{"g":"it, this, that","l":"ce"},null,{"g":"to function, to work","l":"fonctionner"}]},{"text":"C'est de loin la meilleure méthode.","en":"This is by far the best method.","audio":"https://tatoeba.org/en/audio/download/28023","words":[{"g":"it / that"},{"g":"is","l":"être"},null,null,{"g":"the / her"},{"g":"best, better","l":"meilleur"},null],"phrases":[[2,4,"from far"]]}]}