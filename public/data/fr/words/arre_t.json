{"id":"arre_t","lemma":"arrêt","pos":"noun","rank":1052,"glosses":["stopping, checking, arrest (in development, growth, machinery etc.)","stop (place)","judgment, ruling"],"ipa":"/a.ʁɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0d/Fr-arr%C3%AAt.ogg/Fr-arr%C3%AAt.ogg.mp3","gender":"m","forms":{"plural":"arrêts"},"formAudio":{"arrêts":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q150_%28fra%29-Lyoko%C3%AF-arr%C3%AAts.wav"},"examples":[{"text":"Ceci est un arrêt de bus.","en":"This is a bus stop.","words":[{"g":"this"},{"g":"is","l":"être"},{"g":"a"},null,{"g":"of / from"},{"g":"bus"}]},{"text":"J'ai manqué mon arrêt.","en":"I missed my stop.","words":[{"g":"I"},{"g":"have","l":"avoir"},{"g":"missed"},{"g":"my"},null]},{"text":"Quel est le prochain arrêt ?","en":"What's the next stop?","words":[{"g":"which"},{"g":"is","l":"être"},{"g":"the / it"},{"g":"upcoming"},null]},{"text":"Il attend à l'arrêt de bus.","en":"He's waiting at the bus stop.","words":[{"g":"he / it"},{"g":"to wait for, to await","l":"attendre"},{"g":"to / at"},{"g":"the / it"},null,{"g":"of / from"},{"g":"bus"}]},{"text":"Je descends au prochain arrêt.","en":"I'm getting off at the next stop.","words":[{"g":"I"},{"g":"to go down","l":"descendre"},{"g":"to the"},{"g":"upcoming"},null]}]}