{"id":"profonde_ment","lemma":"profondément","pos":"adv","rank":1942,"glosses":["deeply, profoundly"],"ipa":"/pʁɔ.fɔ̃.de.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/05/Fr-profond%C3%A9ment.ogg/Fr-profond%C3%A9ment.ogg.mp3","examples":[{"text":"Je suis profondément désolé.","en":"I'm deeply sorry.","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"sorry"}]},{"text":"Je regrette profondément cette décision.","en":"I deeply regret that decision.","words":[{"g":"I"},{"g":"to regret","l":"regretter"},null,{"g":"it, this, that","l":"ce"},{"g":"decision"}]},{"text":"Respire profondément.","en":"Breathe deeply.","words":[{"g":"to breathe","l":"respirer"},null]},{"text":"Respire profondément par la bouche.","en":"Breathe deeply through your mouth.","words":[{"g":"to breathe","l":"respirer"},null,{"g":"through"},{"g":"the / her"},{"g":"mouth"}]},{"text":"Je suis profondément offensé par ceci.","en":"I'm deeply offended by this.","audio":"https://tatoeba.org/en/audio/download/334450","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"to offend","l":"offenser"},{"g":"through"},{"g":"this"}]}]}