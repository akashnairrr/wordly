{"id":"sire_ne","lemma":"sirène","pos":"noun","rank":3218,"glosses":["mermaid, siren","siren, temptress, seducer","siren, alarm"],"ipa":"/si.ʁɛn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/Fr-sir%C3%A8ne.ogg/Fr-sir%C3%A8ne.ogg.mp3","gender":"f","forms":{"plural":"sirènes"},"examples":[{"text":"J'entends des sirènes.","en":"I hear sirens.","words":[{"g":"I"},{"g":"to hear","l":"entendre"},{"g":"some / of the","l":"un"},null]},{"text":"Je pouvais entendre des sirènes au loin.","en":"I could hear sirens in the distance.","words":[{"g":"I"},{"g":"can, to be able to","l":"pouvoir"},{"g":"to hear"},{"g":"some / of the","l":"un"},null,{"g":"to the"},{"g":"far, distant"}]},{"text":"La sirène a retenti.","en":"The siren blew.","words":[{"g":"the / her"},null,{"g":"has","l":"avoir"},{"g":"to ring, to ring out","l":"retentir"}]},{"text":"Tu n'entends pas ces sirènes ?","en":"Don't you hear those sirens?","words":[{"g":"you"},{"g":"not"},{"g":"to hear","l":"entendre"},{"g":"not"},{"g":"it, this, that","l":"ce"},null]},{"text":"Les sirènes retentissent.","en":"The sirens are wailing.","words":[{"g":"the / them","l":"le"},null,null]}]}