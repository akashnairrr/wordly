{"id":"quasiment","lemma":"quasiment","pos":"adv","rank":2946,"glosses":["practically, almost"],"ipa":"/ka.zi.mɑ̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1e/LL-Q150_%28fra%29-Poslovitch-quasiment.wav/LL-Q150_%28fra%29-Poslovitch-quasiment.wav.mp3","examples":[{"text":"Je suis quasiment prêt.","en":"I'm about ready.","audio":"https://tatoeba.org/en/audio/download/41926","words":[{"g":"I"},{"g":"am","l":"être"},null,{"g":"ready"}]},{"text":"Le magasin est quasiment vide.","en":"The store is almost empty.","words":[{"g":"the / it"},{"g":"shop, store"},{"g":"is","l":"être"},null,{"g":"empty"}]},{"text":"Il est quasiment six heures.","en":"It's almost six.","words":[{"g":"he / it"},{"g":"is","l":"être"},null,{"g":"six"},{"g":"hour, time","l":"heure"}]},{"text":"Je ne te vois quasiment plus.","en":"I hardly see you anymore.","words":[{"g":"I"},{"g":"not"},{"g":"you"},{"g":"to see","l":"voir"},null,{"g":"more / no longer"}]},{"text":"C'était quasiment impossible à faire.","en":"It used to be nearly impossible to do this.","words":[{"g":"it / that"},{"g":"to be","l":"être"},null,{"g":"impossible"},{"g":"to / at"},{"g":"to do"}]}]}