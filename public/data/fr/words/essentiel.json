{"id":"essentiel","lemma":"essentiel","pos":"adj","rank":2568,"glosses":["essential"],"ipa":"/e.sɑ̃.sjɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/84/Fr-essentiel.ogg/Fr-essentiel.ogg.mp3","forms":{"feminine":"essentielle","masculinePlural":"essentiels","femininePlural":"essentielles"},"formAudio":{"essentielle":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q150_%28fra%29-Lyoko%C3%AF-essentielle.wav"},"examples":[{"text":"C'est essentiel.","en":"That is essential.","words":[{"g":"it / that"},{"g":"is","l":"être"},null]},{"text":"Dormir est essentiel à la santé.","en":"Sleep is essential to health.","words":[{"g":"to sleep"},{"g":"is","l":"être"},null,null,null,{"g":"health"}],"phrases":[[3,5,"a la"]]},{"text":"La planification est essentielle.","en":"Planning is key.","words":[{"g":"the / her"},{"g":"planning"},{"g":"is","l":"être"},null]},{"text":"Je reviens à l'essentiel.","en":"I'm just getting back to basics.","words":[{"g":"I"},{"g":"to come back","l":"revenir"},{"g":"to / at"},{"g":"the / it"},null]},{"text":"La peur est essentielle à la survie.","en":"Fear is essential for survival.","words":[{"g":"the / her"},{"g":"fear"},{"g":"is","l":"être"},null,null,null,{"g":"survival"}],"phrases":[[4,6,"a la"]]}]}