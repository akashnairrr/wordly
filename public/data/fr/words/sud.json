{"id":"sud","lemma":"sud","pos":"noun","rank":837,"glosses":["south"],"ipa":"/syd/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2a/Fr-sud.ogg/Fr-sud.ogg.mp3","gender":"m","examples":[{"text":"Ma maison est face au sud.","en":"My house faces to the south.","words":[{"g":"my","l":"mon"},{"g":"house, home"},{"g":"is","l":"être"},{"g":"face"},{"g":"to the"},null]},{"text":"Le vent vient du sud.","en":"The wind is coming from the south.","words":[{"g":"the / it"},{"g":"wind"},{"g":"to come","l":"venir"},{"g":"of the / some"},null]},{"text":"Où est le terminal sud ?","en":"Where is the south terminal?","words":[{"g":"where"},{"g":"is","l":"être"},{"g":"the / it"},{"g":"terminal"},null]},{"text":"Dirige-toi vers le sud.","en":"Head south.","words":[{"g":"to run","l":"diriger"},{"g":"you"},{"g":"towards"},{"g":"the / it"},null]},{"text":"Les oiseaux volèrent vers le sud.","en":"The birds flew to the south.","words":[{"g":"the / them","l":"le"},{"g":"bird","l":"oiseau"},{"g":"to fly through the air","l":"voler"},{"g":"towards"},{"g":"the / it"},null]}]}