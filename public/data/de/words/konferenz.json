{"id":"konferenz","lemma":"Konferenz","pos":"noun","rank":3611,"glosses":["conference"],"ipa":"/ˌkɔnfeˈʁɛnt͡s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/02/De-Konferenz.ogg/De-Konferenz.ogg.mp3","gender":"f","forms":{"genitive":"Konferenz","plural":"Konferenzen"},"formAudio":{"Konferenzen":"https://upload.wikimedia.org/wikipedia/commons/a/a5/LL-Q188_%28deu%29-Sebastian_Wallroth-Konferenzen.wav"},"examples":[{"text":"Ich habe heute eine Konferenz.","en":"I have a meeting today.","audio":"https://tatoeba.org/en/audio/download/756989","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"today"},{"g":"a"},null]},{"text":"Morgen endet die Konferenz.","en":"The conference will end tomorrow.","words":[{"g":"tomorrow"},{"g":"to end","l":"enden"},{"g":"the"},null]},{"text":"Ich nehme oft an Konferenzen teil.","en":"I often attend conferences.","words":[{"g":"I"},{"g":"to take","l":"nehmen"},{"g":"often"},{"g":"at / on"},null,{"g":"part, piece"}]},{"text":"Die Konferenz beginnt um drei.","en":"The meeting begins at three.","words":[{"g":"the"},null,{"g":"to begin","l":"beginnen"},{"g":"around / at"},{"g":"three (numerical value…"}]},{"text":"Die Konferenz geht heute zu Ende.","en":"The conference is going to end today.","words":[{"g":"the"},null,{"g":"to go, to walk","l":"gehen"},{"g":"today"},null,null],"phrases":[[4,6,"finished, through"]]}]}