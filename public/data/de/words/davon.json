{"id":"davon","lemma":"davon","pos":"adv","rank":160,"glosses":["from it, from that, therefrom, off it, off that"],"ipa":"/daˈfɔn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/De-davon.ogg/De-davon.ogg.mp3","examples":[{"text":"Können wir hier nicht davon reden?","en":"Can we not talk about it here?","audio":"https://tatoeba.org/en/audio/download/699211","words":[{"g":"can, to be able to"},{"g":"we"},{"g":"here"},{"g":"not"},null,{"g":"to talk"}]},{"text":"Sie wissen davon.","en":"They know about it.","audio":"https://tatoeba.org/en/audio/download/566221","words":[{"g":"she / they / you"},{"g":"to know"},null]},{"text":"Weiß dein Vater davon?","en":"Does your father know?","audio":"https://tatoeba.org/en/audio/download/755771","words":[{"g":"to know","l":"wissen"},{"g":"your"},{"g":"father"},null]},{"text":"Weiß deine Mutter davon?","en":"Does your mother know?","audio":"https://tatoeba.org/en/audio/download/755773","words":[{"g":"to know","l":"wissen"},{"g":"your","l":"dein"},{"g":"mother"},null]},{"text":"Ich träume noch davon.","en":"I still dream about it.","audio":"https://tatoeba.org/en/audio/download/756921","words":[{"g":"I"},{"g":"dreams"},{"g":"still / yet"},null]}]}