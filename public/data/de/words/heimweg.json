{"id":"heimweg","lemma":"Heimweg","pos":"noun","rank":4740,"glosses":["way home"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/82/De-Heimweg.ogg/De-Heimweg.ogg.mp3","gender":"m","forms":{"genitive":"Heimweges","plural":"Heimwege"},"examples":[{"text":"Bist du auf dem Heimweg?","en":"Are you on your way home?","words":[{"g":"are","l":"sein"},{"g":"you"},{"g":"on"},{"g":"(to) the","l":"der"},null]},{"text":"Kennst du den Heimweg?","en":"Do you know how to get home?","words":[{"g":"to know","l":"kennen"},{"g":"you"},{"g":"the","l":"der"},null]},{"text":"Der Heimweg war lang.","en":"It was a long walk home.","words":[{"g":"the"},null,{"g":"was","l":"sein"},{"g":"long"}]},{"text":"Auf dem Heimweg traf ich ihn.","en":"On my way home, I met him.","words":[{"g":"on"},{"g":"(to) the","l":"der"},null,{"g":"to meet","l":"treffen"},{"g":"I"},{"g":"him"}]},{"text":"Ich habe auf meinem Heimweg einen Hund getroffen.","en":"I met a dog on my way home.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"on"},{"g":"my","l":"mein"},null,{"g":"a","l":"ein"},{"g":"dog, hound"},{"g":"hit, struck, met"}]}]}