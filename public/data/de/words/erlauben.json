{"id":"erlauben","lemma":"erlauben","pos":"verb","rank":1404,"glosses":["to allow; to permit"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/59/De-erlauben.ogg/De-erlauben.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"erlaube","1p":"erlauben","2s":"erlaubst","2p":"erlaubt","3s":"erlaubt","3p":"erlauben"},"preterite":{"1s":"erlaubte","1p":"erlaubten","2s":"erlaubtest","2p":"erlaubtet","3s":"erlaubte","3p":"erlaubten"},"perfect":{"1s":"habe erlaubt","1p":"haben erlaubt","2s":"hast erlaubt","2p":"habt erlaubt","3s":"hat erlaubt","3p":"haben erlaubt"},"future":{"1s":"werde erlauben","1p":"werden erlauben","2s":"wirst erlauben","2p":"werdet erlauben","3s":"wird erlauben","3p":"werden erlauben"}},"imperative":{"affirmative":{"2s":"erlaub","2p":"erlaubt"}},"subjunctive":{"conditional":{"1s":"würde erlauben","1p":"würden erlauben","2s":"würdest erlauben","2p":"würdet erlauben","3s":"würde erlauben","3p":"würden erlauben"}}},"nonFinite":{"participle":"erlaubt"},"examples":[{"text":"Ich erlaube es.","en":"I'll allow it.","audio":"https://tatoeba.org/en/audio/download/249734","words":[{"g":"I"},null,{"g":"it"}]},{"text":"Das kann ich nicht erlauben.","en":"I can't allow that.","audio":"https://tatoeba.org/en/audio/download/390846","words":[{"g":"the / that"},{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"not"},null]},{"text":"Bitte erlauben Sie mir zu gehen.","en":"Please allow me to go.","audio":"https://tatoeba.org/en/audio/download/755278","words":[{"g":"please"},null,{"g":"she / they / you"},{"g":"(to) me","l":"ich"},{"g":"to / too"},{"g":"to go, to walk"}]},{"text":"Sie erlaubte ihm, alleine zu gehen.","en":"She allowed him to go alone.","words":[{"g":"she / they / you"},null,{"g":"(to) him","l":"er"},null,{"g":"to / too"},{"g":"to go, to walk"}]},{"text":"Ich erlaube dir zu gehen.","en":"I'm allowing you to go.","words":[{"g":"I"},null,{"g":"(to) you","l":"du"},{"g":"to / too"},{"g":"to go, to walk"}]}]}