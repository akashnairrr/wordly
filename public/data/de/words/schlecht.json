{"id":"schlecht","lemma":"schlecht","pos":"adj","rank":373,"glosses":["bad, evil, wicked (the opposite of good; immoral)","bad (unskilled; of limited ability)","bad (unhealthy, unwell)"],"ipa":"/ʃlɛçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/De-schlecht.ogg/De-schlecht.ogg.mp3","forms":{"comparative":"schlechter","superlative":"am schlechtesten"},"examples":[{"text":"Ist das so schlecht?","en":"Is that so bad?","audio":"https://tatoeba.org/en/audio/download/389180","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"so"},null]},{"text":"Jetzt fühle ich mich schlecht.","en":"Now I feel bad.","audio":"https://tatoeba.org/en/audio/download/91733","words":[{"g":"now"},{"g":"to feel","l":"fühlen"},{"g":"I"},{"g":"me","l":"ich"},null]},{"text":"Es ist schlecht für dich.","en":"It's bad for you.","audio":"https://tatoeba.org/en/audio/download/390712","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"for"},{"g":"you","l":"du"}]},{"text":"Sie sind schlecht.","en":"They're bad.","audio":"https://tatoeba.org/en/audio/download/566379","words":[{"g":"she / they / you"},{"g":"are","l":"sein"},null]},{"text":"Es war ziemlich schlecht.","en":"It was pretty bad.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"pretty"},null]}]}