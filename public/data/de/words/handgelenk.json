{"id":"handgelenk","lemma":"Handgelenk","pos":"noun","rank":4412,"glosses":["wrist"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a6/De-Handgelenk.ogg/De-Handgelenk.ogg.mp3","gender":"n","forms":{"genitive":"Handgelenkes","plural":"Handgelenke"},"examples":[{"text":"Mir tut das Handgelenk weh.","en":"My wrist hurts.","audio":"https://tatoeba.org/en/audio/download/168153","words":[{"g":"(to) me","l":"ich"},{"g":"to do","l":"tun"},{"g":"the / that"},null,{"g":"sore, painful"}]},{"text":"Der Polizist packte mich am Handgelenk.","en":"The policeman caught me by the wrist.","words":[{"g":"the"},{"g":"police officer"},{"g":"to pack","l":"packen"},{"g":"me","l":"ich"},{"g":"at the / on the"},null]},{"text":"Ich fasste sein Handgelenk.","en":"I took him by the wrist.","words":[{"g":"I"},{"g":"to gird","l":"fassen"},{"g":"to be"},null]},{"text":"Tom hat sich sein linkes Handgelenk gebrochen.","en":"Tom broke his left wrist.","words":[null,{"g":"has","l":"haben"},{"g":"oneself"},{"g":"to be"},{"g":"left-winger, leftist","l":"Linker"},null,{"g":"broken"}]},{"text":"Ich fasste Toms Handgelenk.","en":"I grabbed Tom's wrist.","words":[{"g":"I"},{"g":"to gird","l":"fassen"},null,null]}]}