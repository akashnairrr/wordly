{"id":"fluch","lemma":"Fluch","pos":"noun","rank":1849,"glosses":["curse, malediction, bane"],"ipa":"/fluːx/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/De-Fluch.oga/De-Fluch.oga.mp3","gender":"m","forms":{"genitive":"Fluches","plural":"Flüche"},"examples":[{"text":"Es ist ein Fluch.","en":"It's a curse.","audio":"https://tatoeba.org/en/audio/download/103707","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"a"},null]},{"text":"Er murmelte einen Fluch.","en":"He muttered a curse.","words":[{"g":"he / it"},null,{"g":"a","l":"ein"},null]},{"text":"Ich werde dich mit einem Fluch belegen.","en":"I'm going to put a curse on you.","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},{"g":"with"},{"g":"(to) a","l":"ein"},null,{"g":"to cover"}]},{"text":"Die Hexe belegte das arme kleine Mädchen mit einem Fluch.","en":"The witch cursed the poor little girl.","words":[{"g":"the"},{"g":"witch, sorceress"},{"g":"documented","l":"belegt"},{"g":"the / that"},{"g":"an arm","l":"Arm"},{"g":"small, little, wee","l":"klein"},{"g":"girl"},{"g":"with"},{"g":"(to) a","l":"ein"},null]},{"text":"Tom murmelte einen Fluch.","en":"Tom muttered a curse.","words":[null,null,{"g":"a","l":"ein"},null]}]}