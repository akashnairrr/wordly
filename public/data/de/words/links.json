{"id":"links","lemma":"links","pos":"adv","rank":775,"glosses":["on the left","to the left","inside out"],"ipa":"/lɪŋks/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9a/De-at-links.ogg/De-at-links.ogg.mp3","examples":[{"text":"Ich schreibe mit links.","en":"I write with my left hand.","words":[{"g":"I"},{"g":"to write, to write out","l":"schreiben"},{"g":"with"},null]},{"text":"Halte dich links.","en":"Keep to the left.","audio":"https://tatoeba.org/en/audio/download/392876","words":[{"g":"to hold","l":"halten"},{"g":"you","l":"du"},null]},{"text":"Nehmen Sie die Straße links.","en":"Take the road on the left.","words":[{"g":"to take"},{"g":"she / they / you"},{"g":"the"},{"g":"street"},null]},{"text":"Geh an der Ecke nach links.","en":"Turn left at the corner.","words":[{"g":"to go, to walk","l":"gehen"},null,null,null,{"g":"after / to"},null],"phrases":[[1,4,"at the corner, nearby"]]},{"text":"Er sah nach links und rechts.","en":"He looked left and right.","words":[{"g":"he / it"},{"g":"to see","l":"sehen"},{"g":"after / to"},null,{"g":"and"},{"g":"on the right"}]}]}