{"id":"hin","lemma":"hin","pos":"adj","rank":165,"glosses":["gone (somewhere), left, situated","dead or out of order, kaput","exhausted, depleted"],"ipa":"/hɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/31/De-hin2.ogg/De-hin2.ogg.mp3","examples":[{"text":"Geh mit mir da hin.","en":"Go there with me.","audio":"https://tatoeba.org/en/audio/download/45165","words":[{"g":"to go, to walk","l":"gehen"},{"g":"with"},{"g":"(to) me","l":"ich"},{"g":"there"},null]},{"text":"Warum gehst du dort nicht hin?","en":"Why don't you go there?","audio":"https://tatoeba.org/en/audio/download/760432","words":[{"g":"why"},{"g":"to go, to walk","l":"gehen"},{"g":"you"},{"g":"there, yonder"},{"g":"not"},null]},{"text":"Wir gehen dort alle zusammen hin.","en":"We'll all go there together.","audio":"https://tatoeba.org/en/audio/download/695582","words":[{"g":"we"},{"g":"to go, to walk"},{"g":"there, yonder"},{"g":"all, everyone"},{"g":"together"},null]},{"text":"Wo gingen sie hin?","en":"Where did they go?","audio":"https://tatoeba.org/en/audio/download/391378","words":[{"g":"where"},{"g":"to go, to walk","l":"gehen"},{"g":"she / they / you"},null]},{"text":"Wann komme ich dort hin?","en":"When do I get there?","audio":"https://tatoeba.org/en/audio/download/566212","words":[{"g":"when"},{"g":"to come","l":"kommen"},{"g":"I"},{"g":"there, yonder"},null]}]}