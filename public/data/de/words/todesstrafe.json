{"id":"todesstrafe","lemma":"Todesstrafe","pos":"noun","rank":4439,"glosses":["capital punishment, death penalty"],"ipa":"/ˈtoːdəsˌʃtʁaːfə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/48/De-Todesstrafe.ogg/De-Todesstrafe.ogg.mp3","gender":"f","forms":{"genitive":"Todesstrafe","plural":"Todesstrafen"},"examples":[{"text":"Ich bin gegen die Todesstrafe.","en":"I'm against the death penalty.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"against"},{"g":"the"},null]},{"text":"Auf Mord steht die Todesstrafe.","en":"Murder is punishable by death.","words":[{"g":"on"},{"g":"murder"},{"g":"to stand","l":"stehen"},{"g":"the"},null]},{"text":"Wir sollten die Todesstrafe abschaffen.","en":"We should abolish the death penalty.","words":[{"g":"we"},{"g":"should","l":"sollen"},{"g":"the"},null,{"g":"to abolish"}]},{"text":"Wann wurde die Todesstrafe abgeschafft?","en":"When was the death penalty abolished?","words":[{"g":"when"},{"g":"to become","l":"werden"},{"g":"the"},null,{"g":"to abolish","l":"abschaffen"}]},{"text":"Ich dachte, die Todesstrafe sollte abgeschafft werden.","en":"I thought the death penalty should be abolished.","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"the"},null,{"g":"should","l":"sollen"},{"g":"to abolish","l":"abschaffen"},{"g":"to become"}]}]}