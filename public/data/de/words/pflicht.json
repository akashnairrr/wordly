{"id":"pflicht","lemma":"Pflicht","pos":"noun","rank":1290,"glosses":["duty"],"ipa":"/p͡flɪçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cd/De-Pflicht.ogg/De-Pflicht.ogg.mp3","gender":"f","forms":{"genitive":"Pflicht","plural":"Pflichten"},"examples":[{"text":"Tu deine Pflicht.","en":"Do your duty.","audio":"https://tatoeba.org/en/audio/download/695291","words":[{"g":"to do","l":"tun"},{"g":"your","l":"dein"},null]},{"text":"Ich tat nur meine Pflicht.","en":"I only did my duty.","words":[{"g":"I"},{"g":"deed"},{"g":"only"},{"g":"my","l":"mein"},null]},{"text":"Man sollte seine Pflicht tun.","en":"One should do one's duty.","words":[{"g":"one"},{"g":"should","l":"sollen"},{"g":"his","l":"seiner"},null,{"g":"to do"}]},{"text":"Er vernachlässigte seine Pflichten.","en":"He neglected his duties.","words":[{"g":"he / it"},{"g":"neglected, unattended","l":"vernachlässigt"},{"g":"his","l":"seiner"},null]},{"text":"Es ist deine Pflicht.","en":"It's your duty.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"your","l":"dein"},null]}]}