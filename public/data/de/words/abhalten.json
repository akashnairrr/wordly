{"id":"abhalten","lemma":"abhalten","pos":"verb","rank":2554,"glosses":["to keep off, away, or out; to hold off","to stop (someone from doing something); to block; to hold back or up","to hold (a service, ceremony, etc.)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e2/De-abhalten.ogg/De-abhalten.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"halte ab","1p":"halten ab","2s":"hältst ab","2p":"haltet ab","3s":"hält ab","3p":"halten ab"},"preterite":{"1s":"hielt ab","1p":"hielten ab","2s":"hieltest ab","2p":"hieltet ab","3s":"hielt ab","3p":"hielten ab"},"perfect":{"1s":"habe abgehalten","1p":"haben abgehalten","2s":"hast abgehalten","2p":"habt abgehalten","3s":"hat abgehalten","3p":"haben abgehalten"},"future":{"1s":"werde abhalten","1p":"werden abhalten","2s":"wirst abhalten","2p":"werdet abhalten","3s":"wird abhalten","3p":"werden abhalten"}},"subjunctive":{"imperfect":{"1s":"hielte ab","1p":"hielten ab","2s":"hieltest ab","2p":"hieltet ab","3s":"hielte ab","3p":"hielten ab"},"conditional":{"1s":"würde abhalten","1p":"würden abhalten","2s":"würdest abhalten","2p":"würdet abhalten","3s":"würde abhalten","3p":"würden abhalten"}},"imperative":{"affirmative":{"2s":"halt ab","2p":"haltet ab"}}},"nonFinite":{"participle":"abgehalten"},"examples":[{"text":"Ich werde dich nicht davon abhalten.","en":"I'm not stopping you.","audio":"https://tatoeba.org/en/audio/download/695658","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},{"g":"not"},{"g":"from it"},null]},{"text":"Was hat dich vom Arbeiten abgehalten?","en":"What prevented you from working?","words":[{"g":"what"},{"g":"has","l":"haben"},{"g":"you","l":"du"},{"g":"from the"},{"g":"to work"},null]},{"text":"Niemand kann mich davon abhalten.","en":"Nobody can stop me from doing this.","words":[{"g":"nobody, no one"},{"g":"can, to be able to","l":"können"},{"g":"me","l":"ich"},{"g":"from it"},null]},{"text":"Das hat dich früher nie abgehalten.","en":"That's never stopped you before.","words":[{"g":"the / that"},{"g":"has","l":"haben"},{"g":"you","l":"du"},{"g":"formerly, in the past"},{"g":"never, never at all"},null]},{"text":"Nichts wird uns davon abhalten.","en":"Nothing will stop us from doing that.","words":[{"g":"nothing"},{"g":"to become","l":"werden"},{"g":"us","l":"wir"},{"g":"from it"},null]}]}