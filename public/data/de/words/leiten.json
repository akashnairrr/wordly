{"id":"leiten","lemma":"leiten","pos":"verb","rank":2024,"glosses":["to lead","to manage (an organization)","to conduct (a liquid, electricity etc)"],"ipa":"/ˈlaɪ̯tən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e4/De-leiten.ogg/De-leiten.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"leite","1p":"leiten","2s":"leitest","2p":"leitet","3s":"leitet","3p":"leiten"},"preterite":{"1s":"leitete","1p":"leiteten","2s":"leitetest","2p":"leitetet","3s":"leitete","3p":"leiteten"},"perfect":{"1s":"habe geleitet","1p":"haben geleitet","2s":"hast geleitet","2p":"habt geleitet","3s":"hat geleitet","3p":"haben geleitet"},"future":{"1s":"werde leiten","1p":"werden leiten","2s":"wirst leiten","2p":"werdet leiten","3s":"wird leiten","3p":"werden leiten"}},"imperative":{"affirmative":{"2s":"leit","2p":"leitet"}},"subjunctive":{"conditional":{"1s":"würde leiten","1p":"würden leiten","2s":"würdest leiten","2p":"würdet leiten","3s":"würde leiten","3p":"würden leiten"}}},"nonFinite":{"participle":"geleitet"},"examples":[{"text":"Mein Vater leitet das Geschäft.","en":"My father manages the store.","words":[{"g":"my"},{"g":"father"},null,{"g":"the / that"},{"g":"shop"}]},{"text":"Was leiten Sie daraus ab?","en":"What are you inferring?","words":[{"g":"what"},null,{"g":"she / they / you"},{"g":"out of it"},{"g":"beginning at that time…"}]},{"text":"Ich leite dich an.","en":"I'll guide you.","words":[{"g":"I"},null,{"g":"you","l":"du"},{"g":"at / on"}]},{"text":"Ich leitete die Information an ihn weiter.","en":"I passed the information on to him.","words":[{"g":"I"},null,{"g":"the"},{"g":"a piece of information"},{"g":"at / on"},{"g":"him"},{"g":"further, farther, more"}]},{"text":"Wasser leitet Strom.","en":"Water conducts electricity.","words":[{"g":"water"},null,{"g":"a large river"}]}]}