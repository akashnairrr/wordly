{"id":"friedlich","lemma":"friedlich","pos":"adj","rank":2721,"glosses":["peaceful, placid, tranquil"],"ipa":"/ˈfʁiːtlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/45/De-at-friedlich.ogg/De-at-friedlich.ogg.mp3","forms":{"comparative":"friedlicher","superlative":"am friedlichsten"},"examples":[{"text":"Es ist hier so friedlich.","en":"It's so peaceful here.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"here"},{"g":"so"},null]},{"text":"Sie starb friedlich im Schlaf.","en":"She passed away peacefully in her sleep.","words":[{"g":"she / they / you"},{"g":"to die","l":"sterben"},null,{"g":"in the"},{"g":"sleep"}]},{"text":"Es ist so friedlich hier draußen.","en":"It's so peaceful out here.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"so"},null,{"g":"here"},{"g":"outside"}]},{"text":"Die Schafe weideten friedlich.","en":"The sheep grazed peacefully in the meadow.","words":[{"g":"the"},{"g":"sheep","l":"Schaf"},null,null]},{"text":"Der Streit wurde friedlich gelöst.","en":"The dispute was settled peacefully.","words":[{"g":"the"},{"g":"quarrel"},{"g":"to become","l":"werden"},null,{"g":"solved, resolved"}]}]}