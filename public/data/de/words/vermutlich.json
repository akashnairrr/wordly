{"id":"vermutlich","lemma":"vermutlich","pos":"adv","rank":769,"glosses":["presumably"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/49/De-vermutlich.ogg/De-vermutlich.ogg.mp3","examples":[{"text":"Du hast vermutlich recht.","en":"You're probably right.","audio":"https://tatoeba.org/en/audio/download/755923","words":[{"g":"you"},{"g":"have","l":"haben"},null,{"g":"right, right-hand"}]},{"text":"Sie haben vermutlich recht.","en":"You're probably right.","audio":"https://tatoeba.org/en/audio/download/756665","words":[{"g":"she / they / you"},{"g":"have"},null,{"g":"right, right-hand"}]},{"text":"Die Antwort kennst du vermutlich schon.","en":"I assume that you already know the answer.","words":[{"g":"the"},{"g":"answer"},{"g":"to know","l":"kennen"},{"g":"you"},null,{"g":"already"}]},{"text":"Ich sollte vermutlich gehen.","en":"I should probably go.","words":[{"g":"I"},{"g":"should","l":"sollen"},null,{"g":"to go, to walk"}]},{"text":"Das ist vermutlich keine gute Idee.","en":"That's probably not a good idea.","words":[{"g":"the / that"},{"g":"is","l":"sein"},null,{"g":"no / not a","l":"kein"},{"g":"good","l":"gut"},{"g":"idea"}]}]}