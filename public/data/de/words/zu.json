{"id":"zu","lemma":"zu","pos":"prep","rank":13,"glosses":["to, towards (indicates directionality)","with respect to; regarding","along with; with (accompanying (the main thing in question))"],"ipa":"/t͡suː/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6b/DE-zu.OGG/DE-zu.OGG.mp3","examples":[{"text":"Ist es zu groß?","en":"Is it too big?","audio":"https://tatoeba.org/en/audio/download/77189","words":[{"g":"is","l":"sein"},{"g":"it"},null,{"g":"big"}]},{"text":"Bin ich zu früh dran?","en":"Am I too early?","audio":"https://tatoeba.org/en/audio/download/250024","words":[{"g":"am","l":"sein"},{"g":"I"},null,{"g":"early"},{"g":"to be in a particular…"}]},{"text":"Ich weiß zu viel.","en":"I know too much.","audio":"https://tatoeba.org/en/audio/download/251712","words":[{"g":"I"},{"g":"to know","l":"wissen"},null,{"g":"much, a lot"}]},{"text":"Es war zu einfach.","en":"It was too easy.","audio":"https://tatoeba.org/en/audio/download/240257","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"easy"}]},{"text":"Ihr arbeitet zu viel.","en":"You work too much.","audio":"https://tatoeba.org/en/audio/download/394631","words":[{"g":"you (pl.) / her"},{"g":"to work","l":"arbeiten"},null,{"g":"much, a lot"}]}]}