{"id":"schutz","lemma":"Schutz","pos":"noun","rank":1297,"glosses":["protection","protective installation"],"ipa":"/ʃʊt͡s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a3/De-Schutz.ogg/De-Schutz.ogg.mp3","gender":"m","forms":{"genitive":"Schutzes","plural":"Schutze"},"examples":[{"text":"Sie brauchen Schutz.","en":"You need protection.","words":[{"g":"she / they / you"},{"g":"to need"},null]},{"text":"Du brauchst Schutz.","en":"You need protection.","words":[{"g":"you"},{"g":"to need","l":"brauchen"},null]},{"text":"Ich brauche deinen Schutz nicht.","en":"I don't need your protection.","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"thy, your .","l":"dein"},null,{"g":"not"}]},{"text":"Ich bin für ihren Schutz verantwortlich.","en":"I am responsible for her protection.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"for"},{"g":"her","l":"ihr"},null,{"g":"responsible"}]},{"text":"Er nimmt ihn sehr in Schutz.","en":"He's very protective of him.","words":[{"g":"he / it"},{"g":"to take","l":"nehmen"},{"g":"him"},{"g":"very"},{"g":"in"},null]}]}