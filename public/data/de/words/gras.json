{"id":"gras","lemma":"Gras","pos":"noun","rank":1617,"glosses":["grass (plant)","weed, marijuana"],"ipa":"/ɡʁaːs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/41/De-at-Gras.ogg/De-at-Gras.ogg.mp3","gender":"n","forms":{"genitive":"Grases","plural":"Gräser"},"formAudio":{"Grases":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q188_%28deu%29-Jeuwre-Grases.wav"},"examples":[{"text":"Lass uns im Gras sitzen.","en":"Let's sit on the grass.","words":[{"g":"to allow","l":"lassen"},{"g":"us","l":"wir"},{"g":"in the"},null,{"g":"to sit"}]},{"text":"Ich lag im Gras.","en":"I was lying in the grass.","words":[{"g":"I"},{"g":"to lie","l":"liegen"},{"g":"in the"},null]},{"text":"Elefanten fressen Gras.","en":"Elephants eat grass.","audio":"https://tatoeba.org/en/audio/download/699092","words":[{"g":"elephant","l":"Elefant"},{"g":"to eat"},null]},{"text":"Das Gras will nicht wachsen.","en":"The grass won't grow.","words":[{"g":"the / that"},null,{"g":"to want","l":"wollen"},{"g":"not"},{"g":"to grow"}]},{"text":"Setzen wir uns hier aufs Gras!","en":"Let's sit here on the grass.","words":[{"g":"to sit down"},{"g":"we"},{"g":"us","l":"wir"},{"g":"here"},null,null]}]}