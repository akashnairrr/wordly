{"id":"paar","lemma":"paar","pos":"det","rank":136,"glosses":["some; few; a few"],"ipa":"/paːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/06/De-paar.ogg/De-paar.ogg.mp3","examples":[{"text":"Ich habe ein paar Freunde.","en":"I have a few friends.","audio":"https://tatoeba.org/en/audio/download/566510","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"a"},null,{"g":"friends"}]},{"text":"Gib mir ein paar.","en":"Give me a few.","audio":"https://tatoeba.org/en/audio/download/34750","words":[{"g":"to give","l":"geben"},{"g":"(to) me","l":"ich"},{"g":"a"},null]},{"text":"Wir brauchen ein paar neue Ideen.","en":"We need some new ideas.","audio":"https://tatoeba.org/en/audio/download/760026","words":[{"g":"we"},{"g":"to need"},{"g":"a"},null,{"g":"new","l":"neu"},{"g":"idea","l":"Idee"}]},{"text":"Hast du ein paar Minuten?","en":"Do you have a few minutes?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"a"},null,{"g":"minute (unit of time","l":"Minute"}]},{"text":"Willst du ein paar Worte sagen?","en":"Do you want to say a few words?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"a"},null,{"g":"word as an isolated unit","l":"Wort"},{"g":"to say (to pronounce"}]}]}