{"id":"gruss","lemma":"Gruß","pos":"noun","rank":2489,"glosses":["greeting","compliment","salute"],"ipa":"/ɡʁuːs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cc/De-Gru%C3%9F.ogg/De-Gru%C3%9F.ogg.mp3","gender":"m","forms":{"genitive":"Grußes","plural":"Grüße"},"examples":[{"text":"Schönen Gruß von meinem Bruder.","en":"My brother sends you his regards.","words":[{"g":"well, beautifully","l":"schön"},null,{"g":"from / of"},{"g":"my","l":"mein"},{"g":"brother"}]},{"text":"Bestelle deinen Eltern einen schönen Gruß.","en":"Give my regards to your parents.","words":[{"g":"to order","l":"bestellen"},{"g":"thy, your .","l":"dein"},{"g":"parents"},{"g":"a","l":"ein"},{"g":"well, beautifully","l":"schön"},null]},{"text":"Bitte grüße deine Familie.","en":"Please say hello to your family.","words":[{"g":"please"},null,{"g":"your","l":"dein"},{"g":"family"}]},{"text":"Bitte grüße ihn von mir.","en":"Please say hello to him for me.","words":[{"g":"please"},null,{"g":"him"},{"g":"from / of"},{"g":"(to) me","l":"ich"}]},{"text":"Er erwiderte meinen Gruß durch Anheben seinen Hutes.","en":"He acknowledged me by lifting his hat.","words":[{"g":"he / it"},{"g":"to reciprocate","l":"erwidern"},{"g":"to opine, to think"},null,{"g":"by means of"},{"g":"to lift up"},{"g":"to be","l":"sein"},{"g":"hat","l":"Hut"}]}]}