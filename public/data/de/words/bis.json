{"id":"bis","lemma":"bis","pos":"prep","rank":106,"glosses":["until, to, (US) through","by","to; all the way to"],"ipa":"/bɪs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2d/De-bis.ogg/De-bis.ogg.mp3","examples":[{"text":"Warum bis Montag warten?","en":"Why wait until Monday?","audio":"https://tatoeba.org/en/audio/download/757004","words":[{"g":"why"},null,{"g":"Monday"},{"g":"to wait"}]},{"text":"Bis später, okay?","en":"See you later, OK?","audio":"https://tatoeba.org/en/audio/download/390111","words":[null,{"g":"later"},{"g":"OK"}]},{"text":"Ich brauche es bis morgen.","en":"I need it by tomorrow.","audio":"https://tatoeba.org/en/audio/download/566667","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"it"},null,{"g":"tomorrow"}]},{"text":"Kannst du bis morgen warten?","en":"Can you wait until tomorrow?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null,{"g":"tomorrow"},{"g":"to wait"}]},{"text":"Bis morgen kann ich nicht warten.","en":"I can't wait until tomorrow.","audio":"https://tatoeba.org/en/audio/download/718057","words":[null,{"g":"tomorrow"},{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"not"},{"g":"to wait"}]}]}