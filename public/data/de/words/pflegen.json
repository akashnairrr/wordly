{"id":"pflegen","lemma":"pflegen","pos":"verb","rank":4957,"glosses":["to nurse; to care for someone in poor health","to take care of, to tend to, to maintain","to improve or care for something in an intellectual sense"],"ipa":"/ˈpfleːɡən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9a/De-pflegen.ogg/De-pflegen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"pflege","1p":"pflegen","2s":"pflegst","2p":"pflegt","3s":"pflegt","3p":"pflegen"},"preterite":{"1s":"pflegte","1p":"pflegten","2s":"pflegtest","2p":"pflegtet","3s":"pflegte","3p":"pflegten"},"perfect":{"1s":"habe gepflegt","1p":"haben gepflegt","2s":"hast gepflegt","2p":"habt gepflegt","3s":"hat gepflegt","3p":"haben gepflegt"},"future":{"1s":"werde pflegen","1p":"werden pflegen","2s":"wirst pflegen","2p":"werdet pflegen","3s":"wird pflegen","3p":"werden pflegen"}},"imperative":{"affirmative":{"2s":"pfleg","2p":"pflegt"}},"subjunctive":{"conditional":{"1s":"würde pflegen","1p":"würden pflegen","2s":"würdest pflegen","2p":"würdet pflegen","3s":"würde pflegen","3p":"würden pflegen"}}},"nonFinite":{"participle":"gepflegt"},"examples":[{"text":"Mein Vater pflegte zu reisen.","en":"My father used to travel.","words":[{"g":"my"},{"g":"father"},null,{"g":"to / too"},{"g":"to travel"}]},{"text":"Der Garten wird nicht gepflegt.","en":"The garden is neglected.","words":[{"g":"the"},{"g":"garden, yard"},{"g":"to become","l":"werden"},{"g":"not"},null]},{"text":"Er pflegt seinen Wagen sehr.","en":"He maintains his car well.","words":[{"g":"he / it"},null,{"g":"to be","l":"sein"},{"g":"a car"},{"g":"very"}]},{"text":"Ich pflegte dasselbe zu tun.","en":"I used to do the same thing.","words":[{"g":"I"},null,{"g":"the same","l":"derselbe"},{"g":"to / too"},{"g":"to do"}]},{"text":"Er pflegt zu reisen.","en":"He's accustomed to traveling.","words":[{"g":"he / it"},null,{"g":"to / too"},{"g":"to travel"}]}]}