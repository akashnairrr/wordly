{"id":"heim","lemma":"heim","pos":"adv","rank":839,"glosses":["home, to the house; always as a direction, thus never in the sense of at home"],"ipa":"/haɪ̯m/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a9/De-heim.ogg/De-heim.ogg.mp3","examples":[{"text":"Wieso gehen wir nicht heim?","en":"Why don't we go home?","audio":"https://tatoeba.org/en/audio/download/133","words":[{"g":"why"},{"g":"to go, to walk"},{"g":"we"},{"g":"not"},null]},{"text":"Geh schnell heim!","en":"Go home quickly.","audio":"https://tatoeba.org/en/audio/download/38938","words":[{"g":"to go, to walk","l":"gehen"},{"g":"quickly"},null]},{"text":"Komm um sechs heim!","en":"Come home at six.","audio":"https://tatoeba.org/en/audio/download/79569","words":[{"g":"to come","l":"kommen"},{"g":"around / at"},{"g":"six (numerical value…"},null]},{"text":"Wann kommst du heim?","en":"When will you come home?","words":[{"g":"when"},{"g":"to come","l":"kommen"},{"g":"you"},null]},{"text":"Geht ihr schon heim?","en":"Are you already going home?","words":[{"g":"to go, to walk","l":"gehen"},{"g":"you (pl.) / her"},{"g":"already"},null]}]}