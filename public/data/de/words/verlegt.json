{"id":"verlegt","lemma":"verlegt","pos":"adj","rank":3130,"glosses":["installed, transferred","relocated, transferred","misplaced, mislaid"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5c/De-verlegt.ogg/De-verlegt.ogg.mp3","examples":[{"text":"Ich habe deine Nummer verlegt.","en":"I lost your number.","audio":"https://tatoeba.org/en/audio/download/392021","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"your","l":"dein"},{"g":"number"},null]},{"text":"Ich muss es verlegt haben.","en":"I must've misplaced it.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"it"},null,{"g":"have"}]},{"text":"Wohin habe ich denn meine Brille verlegt?","en":"Where did I put my glasses?","words":[{"g":"where to, whither"},{"g":"have","l":"haben"},{"g":"I"},{"g":"so"},{"g":"my","l":"mein"},{"g":"glasses, spectacles"},null]},{"text":"Ich habe meinen Geldbeutel wohl verlegt.","en":"I seem to have misplaced my wallet.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"to opine, to think"},{"g":"wallet, purse"},{"g":"possibly, probably"},null]},{"text":"Ich habe meine Schlüssel verlegt.","en":"I've mislaid my keys.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"my","l":"mein"},{"g":"a key"},null]}]}