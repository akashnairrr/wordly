{"id":"entschieden","lemma":"entschieden","pos":"adj","rank":945,"glosses":["determined, resolute","decided"],"ipa":"/ʔɛntˈʃiːdn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2d/De-entschieden.ogg/De-entschieden.ogg.mp3","forms":{"comparative":"entschiedener","superlative":"am entschiedensten"},"examples":[{"text":"Also, hast du dich entschieden?","en":"Well, have you decided?","audio":"https://tatoeba.org/en/audio/download/759665","words":[{"g":"so, well"},{"g":"have","l":"haben"},{"g":"you"},{"g":"you","l":"du"},null]},{"text":"Also, haben Sie sich entschieden?","en":"Well, have you decided?","audio":"https://tatoeba.org/en/audio/download/759666","words":[{"g":"so, well"},{"g":"have"},{"g":"she / they / you"},{"g":"oneself"},null]},{"text":"Nun, habt ihr euch entschieden?","en":"Well, have you decided?","audio":"https://tatoeba.org/en/audio/download/760359","words":[{"g":"now, at this moment"},{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},{"g":"you (pl.)","l":"ihr"},null]},{"text":"Noch ist nichts entschieden.","en":"Nothing is decided yet.","words":[{"g":"still / yet"},{"g":"is","l":"sein"},{"g":"nothing"},null]},{"text":"Ich habe mich entschieden.","en":"I made a decision.","audio":"https://tatoeba.org/en/audio/download/394978","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"me","l":"ich"},null]}]}