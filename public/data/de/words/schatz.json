{"id":"schatz","lemma":"Schatz","pos":"noun","rank":322,"glosses":["treasure","darling, sweetheart, honey"],"ipa":"/ʃat͡s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e9/De-Schatz.ogg/De-Schatz.ogg.mp3","gender":"m","examples":[{"text":"Du bist ein Schatz!","en":"You are such a sweetheart.","words":[{"g":"you"},{"g":"are","l":"sein"},{"g":"a"},null]},{"text":"Warum sollte ich den Schatz mit dir teilen?","en":"Why should I share the treasure with you?","words":[{"g":"why"},{"g":"should","l":"sollen"},{"g":"I"},{"g":"the","l":"der"},null,{"g":"with"},{"g":"(to) you","l":"du"},{"g":"to split, to share"}]},{"text":"Du hast recht, mein Schatz.","en":"You're right, dear.","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"right, right-hand"},{"g":"my"},null]},{"text":"Ich habe eine Überraschung für dich, Schatz.","en":"I have a surprise for you, sweetheart.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"a"},{"g":"surprise"},{"g":"for"},{"g":"you","l":"du"},null]},{"text":"Schatz, du siehst hübsch aus.","en":"Honey, you look pretty.","words":[null,{"g":"you"},{"g":"to see","l":"sehen"},{"g":"pretty, handsome"},{"g":"out of / from"}]}]}