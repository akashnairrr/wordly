{"id":"gespannt","lemma":"gespannt","pos":"adj","rank":2872,"glosses":["curious, excited (of a person; about seeing how something will turn out)","tense (of vowels)","tense, strained (of relationships, situations)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/De-gespannt.ogg/De-gespannt.ogg.mp3","forms":{"comparative":"gespannter","superlative":"am gespanntesten"},"examples":[{"text":"Ich bin gespannt dich zu sehen.","en":"I'm anxious to see you.","audio":"https://tatoeba.org/en/audio/download/701060","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"you","l":"du"},{"g":"to / too"},{"g":"to see"}]},{"text":"Sie sahen gespannt zu.","en":"They watched intently.","audio":"https://tatoeba.org/en/audio/download/755946","words":[{"g":"she / they / you"},{"g":"to see","l":"sehen"},null,{"g":"to / too"}]},{"text":"Jeder wartet gespannt.","en":"Everyone is waiting anxiously.","words":[{"g":"each"},{"g":"to wait","l":"warten"},null]},{"text":"Er ist ganz gespannt.","en":"He's all excited.","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"entire"},null]},{"text":"Ich bin gespannt auf morgen.","en":"I'm looking forward to tomorrow.","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"on"},{"g":"tomorrow"}]}]}