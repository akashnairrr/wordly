{"id":"flamme","lemma":"Flamme","pos":"noun","rank":3896,"glosses":["flame (visible part of fire)","flame (romantic partner or lover)"],"ipa":"/ˈflamə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/De-at-Flamme.ogg/De-at-Flamme.ogg.mp3","gender":"f","forms":{"genitive":"Flamme","plural":"Flammen"},"examples":[{"text":"Die Flamme erlosch.","en":"The flame went out.","words":[{"g":"the"},null,null]},{"text":"Schwefel brennt mit blauer Flamme.","en":"Sulfur burns with a blue flame.","audio":"https://tatoeba.org/en/audio/download/593115","words":[{"g":"sulfur, brimstone"},{"g":"to burn","l":"brennen"},{"g":"with"},{"g":"blue","l":"blau"},null]},{"text":"Drehe die Flamme auf klein.","en":"Turn the flame down low.","words":[{"g":"to turn","l":"drehen"},{"g":"the"},null,{"g":"on"},{"g":"small, little, wee"}]},{"text":"Das Haus stand in Flammen.","en":"The house was ablaze.","audio":"https://tatoeba.org/en/audio/download/566654","words":[{"g":"the / that"},{"g":"house, building"},{"g":"to stand","l":"stehen"},{"g":"in"},null]},{"text":"Das Schiff ging in Flammen auf.","en":"The ship went up in flames.","words":[{"g":"the / that"},{"g":"ship"},{"g":"to go, to walk","l":"gehen"},{"g":"in"},null,{"g":"on"}]}]}