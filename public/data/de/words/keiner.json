{"id":"keiner","lemma":"keiner","pos":"pron","rank":303,"glosses":["none","no one, nobody","neither"],"ipa":"/ˈkaɪ̯nɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1c/De-keiner.ogg/De-keiner.ogg.mp3","forms":{"plural":"keine"},"examples":[{"text":"Keiner meiner Freunde trinkt Kaffee.","en":"None of my friends drink coffee.","audio":"https://tatoeba.org/en/audio/download/41713","words":[null,{"g":"my","l":"mein"},{"g":"friends"},{"g":"to drink by mouth)","l":"trinken"},{"g":"coffee"}]},{"text":"Keiner kennt die Wahrheit.","en":"Nobody knows the truth.","audio":"https://tatoeba.org/en/audio/download/566687","words":[null,{"g":"to know","l":"kennen"},{"g":"the"},{"g":"truth"}]},{"text":"Keiner liebt dich.","en":"No one loves you.","audio":"https://tatoeba.org/en/audio/download/566742","words":[null,{"g":"to love","l":"lieben"},{"g":"you","l":"du"}]},{"text":"Keiner weiß, warum.","en":"Nobody knows why.","audio":"https://tatoeba.org/en/audio/download/393127","words":[null,{"g":"to know","l":"wissen"},{"g":"why"}]},{"text":"Keiner glaubt mir.","en":"No one believes me.","audio":"https://tatoeba.org/en/audio/download/564313","words":[null,{"g":"to believe something","l":"glauben"},{"g":"(to) me","l":"ich"}]}]}