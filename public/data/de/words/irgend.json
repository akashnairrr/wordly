{"id":"irgend","lemma":"irgend","pos":"adv","rank":2028,"glosses":["at all (regarding possibility/ability)","any, some"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e5/De-irgend.ogg/De-irgend.ogg.mp3","examples":[{"text":"Irgend jemand will mich umbringen.","en":"Somebody wants to kill me.","words":[null,{"g":"someone, somebody"},{"g":"to want","l":"wollen"},{"g":"me","l":"ich"},{"g":"to kill"}]},{"text":"Kannst du irgend etwas tun?","en":"Can you do anything?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null,{"g":"something"},{"g":"to do"}]},{"text":"Irgend jemand muß es tun.","en":"Someone has to do it.","words":[null,{"g":"someone, somebody"},null,{"g":"it"},{"g":"to do"}]},{"text":"Wartet ihr, daß ich irgend etwas tue?","en":"Are you waiting for me to do something?","words":[{"g":"to wait","l":"warten"},{"g":"you (pl.) / her"},null,{"g":"I"},null,{"g":"something"},{"g":"to do","l":"tun"}]},{"text":"Hast du das irgend jemandem gesagt?","en":"Did you tell anybody that?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"the / that"},null,{"g":"someone, somebody","l":"jemand"},{"g":"to say (to pronounce","l":"sagen"}]}]}