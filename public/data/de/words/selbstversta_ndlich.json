{"id":"selbstversta_ndlich","lemma":"selbstverständlich","pos":"adj","rank":1304,"glosses":["natural, self-evident","granted"],"ipa":"/ˌzɛlpst.fɛɐ̯.ˈʃtɛn.tlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/44/De-selbstverst%C3%A4ndlich.ogg/De-selbstverst%C3%A4ndlich.ogg.mp3","forms":{"comparative":"selbstverständlicher","superlative":"am selbstverständlichsten"},"examples":[{"text":"Ist das nicht selbstverständlich?","en":"Isn't that obvious?","audio":"https://tatoeba.org/en/audio/download/390289","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"not"},null]},{"text":"Selbstverständlich warte ich.","en":"Of course I'll wait.","words":[null,{"g":"to wait","l":"warten"},{"g":"I"}]},{"text":"Für sie ist alles selbstverständlich.","en":"She takes everything for granted.","words":[{"g":"for"},{"g":"she / they / you"},{"g":"is","l":"sein"},{"g":"everything"},null]},{"text":"Es ist selbstverständlich, dass Zeit Geld ist.","en":"It goes without saying that time is money.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"that"},{"g":"time"},{"g":"money"},{"g":"is","l":"sein"}]},{"text":"Du hast selbstverständlich recht.","en":"You're right, of course.","words":[{"g":"you"},{"g":"have","l":"haben"},null,{"g":"right, right-hand"}]}]}