{"id":"schulter","lemma":"Schulter","pos":"noun","rank":1844,"glosses":["shoulder"],"ipa":"/ˈʃʊltɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/De-Schulter.ogg/De-Schulter.ogg.mp3","gender":"f","forms":{"genitive":"Schulter","plural":"Schultern"},"examples":[{"text":"Meine Schultern schmerzen.","en":"My shoulders hurt.","audio":"https://tatoeba.org/en/audio/download/392859","words":[{"g":"my","l":"mein"},null,{"g":"to hurt, to ache"}]},{"text":"Ich habe mir meine Schulter verletzt.","en":"I hurt my shoulder.","audio":"https://tatoeba.org/en/audio/download/389956","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"(to) me","l":"ich"},{"g":"my","l":"mein"},null,{"g":"hurt, injured"}]},{"text":"Wie geht es deiner Schulter?","en":"How's your shoulder?","words":[null,null,null,{"g":"yours, thine"},null],"phrases":[[0,3,"how are you"]]},{"text":"Mir schmerzen die Schultern.","en":"My shoulders hurt.","audio":"https://tatoeba.org/en/audio/download/392858","words":[{"g":"(to) me","l":"ich"},{"g":"to hurt, to ache"},{"g":"the"},null]},{"text":"Ich habe Schmerzen in meiner Schulter.","en":"I have a pain in my shoulders.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"to hurt, to ache"},{"g":"in"},{"g":"my","l":"mein"},null]}]}