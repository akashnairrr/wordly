{"id":"mehrere","lemma":"mehrere","pos":"pron","rank":1435,"glosses":["multiple, several; more than one; a number of"],"ipa":"/meːrərə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f2/De-mehrere.ogg/De-mehrere.ogg.mp3","examples":[{"text":"Sie hatten mehrere Kinder.","en":"They had several children.","audio":"https://tatoeba.org/en/audio/download/469849","words":[{"g":"she / they / you"},{"g":"to have","l":"haben"},null,{"g":"kid","l":"Kind"}]},{"text":"Ich habe mehrere alte Computer.","en":"I have several old computers.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"age, old age","l":"Alter"},{"g":"computer"}]},{"text":"Ich arbeite hier bereits mehrere Stunden.","en":"I've already been working here for several hours.","words":[{"g":"I"},{"g":"to work","l":"arbeiten"},{"g":"here"},{"g":"already"},null,{"g":"to defer (due date"}]},{"text":"Mehrere Leute haben es gesehen.","en":"Several people saw it.","words":[null,{"g":"people"},{"g":"have"},{"g":"it"},{"g":"to see","l":"sehen"}]},{"text":"Wir haben mehrere Möglichkeiten.","en":"We have several options.","words":[{"g":"we"},{"g":"have"},null,{"g":"possibility","l":"Möglichkeit"}]}]}