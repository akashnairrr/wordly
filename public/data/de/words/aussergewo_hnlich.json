{"id":"aussergewo_hnlich","lemma":"außergewöhnlich","pos":"adj","rank":3884,"glosses":["exceptional, extraordinary"],"ipa":"/ˈaʊ̯.sɐ.ɡəˌvøːn.lɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/83/De-au%C3%9Fergew%C3%B6hnlich.ogg/De-au%C3%9Fergew%C3%B6hnlich.ogg.mp3","examples":[{"text":"Du bist außergewöhnlich.","en":"You're extraordinary.","words":[{"g":"you"},{"g":"are","l":"sein"},null]},{"text":"Sie sind außergewöhnlich.","en":"You're extraordinary.","words":[{"g":"she / they / you"},{"g":"are","l":"sein"},null]},{"text":"Heute Abend ist der Mond außergewöhnlich schön.","en":"The moon is exceptionally pretty tonight.","words":[{"g":"today"},{"g":"evening"},{"g":"is","l":"sein"},{"g":"the"},{"g":"moon"},null,{"g":"well, beautifully"}]},{"text":"Sie ist außergewöhnlich attraktiv.","en":"She is remarkably attractive.","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},null,{"g":"attractive, fetching"}]},{"text":"Wie außergewöhnlich!","en":"How extraordinary!","words":[{"g":"how"},null]}]}