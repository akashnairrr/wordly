{"id":"schnell","lemma":"schnell","pos":"adv","rank":178,"glosses":["quickly","again; quick; used after a question to imply that one ought to know the answer"],"ipa":"/ʃnɛl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/23/De-schnell.ogg/De-schnell.ogg.mp3","examples":[{"text":"Komm schnell hierher.","en":"Come here quickly.","audio":"https://tatoeba.org/en/audio/download/394481","words":[{"g":"to come","l":"kommen"},null,{"g":"to here, here , hither"}]},{"text":"Wie schnell kannst du gehen?","en":"How fast can you walk?","audio":"https://tatoeba.org/en/audio/download/757973","words":[{"g":"how"},null,{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"to go, to walk"}]},{"text":"Sie schwimmen sehr schnell.","en":"You swim very quickly.","audio":"https://tatoeba.org/en/audio/download/567063","words":[{"g":"she / they / you"},{"g":"to swim"},{"g":"very"},null]},{"text":"Dieses Auto ist schnell.","en":"This car is fast.","audio":"https://tatoeba.org/en/audio/download/394024","words":[{"g":"this one, this","l":"dieser"},{"g":"car"},{"g":"is","l":"sein"},null]},{"text":"Er geht schnell.","en":"He walks fast.","audio":"https://tatoeba.org/en/audio/download/274095","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},null]}]}