{"id":"vertrag","lemma":"Vertrag","pos":"noun","rank":1259,"glosses":["contract, agreement","treaty"],"ipa":"/fərˈtraːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/ba/De-Vertrag.ogg/De-Vertrag.ogg.mp3","gender":"m","forms":{"genitive":"Vertrages","plural":"Verträge"},"formAudio":{"Vertrages":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q188_%28deu%29-Sebastian_Wallroth-Vertrages.wav","Verträge":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q188_%28deu%29-Sebastian_Wallroth-Vertr%C3%A4ge.wav"},"examples":[{"text":"Ich habe einen Vertrag.","en":"I have a contract.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"a","l":"ein"},null]},{"text":"Wir haben einen Vertrag.","en":"We have a contract.","words":[{"g":"we"},{"g":"have"},{"g":"a","l":"ein"},null]},{"text":"Sie sind zufrieden mit dem Vertrag.","en":"They are satisfied with the contract.","words":[{"g":"she / they / you"},{"g":"are","l":"sein"},{"g":"satisfied"},{"g":"with"},{"g":"(to) the","l":"der"},null]},{"text":"Die Verträge wurden bereits ausgehandelt.","en":"Contracts have already been negotiated.","words":[{"g":"the"},null,{"g":"to become","l":"werden"},{"g":"already"},{"g":"to negotiate","l":"aushandeln"}]},{"text":"Er musste den Vertrag unterschreiben.","en":"He was compelled to sign the contract.","words":[{"g":"he / it"},{"g":"to have to","l":"müssen"},{"g":"the","l":"der"},null,{"g":"to sign"}]}]}