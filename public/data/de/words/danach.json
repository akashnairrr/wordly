{"id":"danach","lemma":"danach","pos":"adv","rank":458,"glosses":["after it, after that; thereafter (formal), afterwards","behind it/that","accordingly, in accordance with that"],"ipa":"/daˈnaːχ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6e/De-at-danach.ogg/De-at-danach.ogg.mp3","examples":[{"text":"Wir suchen danach.","en":"We're looking for it.","audio":"https://tatoeba.org/en/audio/download/566190","words":[{"g":"we"},{"g":"to search, to look for"},null]},{"text":"Kannst du danach suchen?","en":"Can you find it?","audio":"https://tatoeba.org/en/audio/download/718134","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null,{"g":"to search, to look for"}]},{"text":"Suche bitte danach!","en":"Please look for it.","audio":"https://tatoeba.org/en/audio/download/104015","words":[{"g":"to search, to look for","l":"suchen"},{"g":"please"},null]},{"text":"Wohin gehen wir danach?","en":"Where do we go after this?","words":[{"g":"where to, whither"},{"g":"to go, to walk"},{"g":"we"},null]},{"text":"Wo soll ich danach suchen?","en":"Where should I look for it?","words":[{"g":"where"},{"g":"should","l":"sollen"},{"g":"I"},null,{"g":"to search, to look for"}]}]}