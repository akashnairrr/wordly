{"id":"sieg","lemma":"Sieg","pos":"noun","rank":1335,"glosses":["victory"],"ipa":"/ziːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/29/De-Sieg.ogg/De-Sieg.ogg.mp3","gender":"m","forms":{"genitive":"Sieges","plural":"Siege"},"examples":[{"text":"Wir brauchen einen Sieg.","en":"We need a victory.","audio":"https://tatoeba.org/en/audio/download/392821","words":[{"g":"we"},{"g":"to need"},{"g":"a","l":"ein"},null]},{"text":"Wir sollten den Sieg feiern.","en":"We should celebrate the victory.","words":[{"g":"we"},{"g":"should","l":"sollen"},{"g":"the","l":"der"},null,{"g":"to celebrate"}]},{"text":"Der Sieg ist unser.","en":"The victory is ours.","words":[{"g":"the"},null,{"g":"is","l":"sein"},{"g":"our"}]},{"text":"Das ist ein großer Sieg.","en":"This is a great victory.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"a"},{"g":"big","l":"groß"},null]},{"text":"Er ist sich seines Sieges gewiss.","en":"He is sure of winning.","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"oneself"},{"g":"his","l":"seiner"},null,{"g":"certainly, indeed"}]}]}