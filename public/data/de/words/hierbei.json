{"id":"hierbei","lemma":"hierbei","pos":"adv","rank":4130,"glosses":["hereby"],"ipa":"/hiːɐ̯ˈbaɪ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/29/De-hierbei.ogg/De-hierbei.ogg.mp3","examples":[{"text":"Ich brauche hierbei Hilfe.","en":"I need help with this.","words":[{"g":"I"},{"g":"to need","l":"brauchen"},null,{"g":"the act of helping"}]},{"text":"Ich kann dir hierbei nicht helfen.","en":"I can't help you with this.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"(to) you","l":"du"},null,{"g":"not"},{"g":"to help"}]},{"text":"Du musst mir hierbei helfen.","en":"I need you to help me with this.","words":[{"g":"you"},{"g":"to have to","l":"müssen"},{"g":"(to) me","l":"ich"},null,{"g":"to help"}]},{"text":"Um was geht es hierbei?","en":"What is this about?","words":[{"g":"around / at"},null,null,{"g":"it"},null],"phrases":[[1,3,"what's up"]]},{"text":"Du brauchst mir hierbei nicht zu helfen.","en":"You don't need to help me do this.","words":[{"g":"you"},{"g":"to need","l":"brauchen"},{"g":"(to) me","l":"ich"},null,{"g":"not"},{"g":"to / too"},{"g":"to help"}]}]}