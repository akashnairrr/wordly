{"id":"dritte","lemma":"dritte","pos":"adj","rank":1501,"glosses":["third"],"ipa":"/ˈdrɪtə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/37/De-dritte.ogg/De-dritte.ogg.mp3","examples":[{"text":"Morgen ist der dritte.","en":"Tomorrow is the third.","words":[{"g":"tomorrow"},{"g":"is","l":"sein"},{"g":"the"},null]},{"text":"Ich war der dritte in der Warteschlange.","en":"I was the third person in line.","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"the"},null,{"g":"in"},{"g":"the"},{"g":"queue"}]},{"text":"Sie haben das dritte Jahr in Folge gewonnen.","en":"They've won for the third consecutive year.","words":[{"g":"she / they / you"},{"g":"have"},{"g":"the / that"},null,{"g":"year"},{"g":"in"},{"g":"sequence"},{"g":"gained, won"}]},{"text":"Der dritte Akt fängt gleich an.","en":"The third act is about to begin.","words":[{"g":"the"},null,{"g":"act, deed"},{"g":"to catch","l":"fangen"},{"g":"alike"},{"g":"at / on"}]},{"text":"Die dritte Lektion ist schwierig.","en":"Lesson Three is hard.","words":[{"g":"the"},null,{"g":"lesson"},{"g":"is","l":"sein"},{"g":"difficult"}]}]}