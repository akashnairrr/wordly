{"id":"u_beraus","lemma":"überaus","pos":"adv","rank":3766,"glosses":["extremely"],"ipa":"/ˈyːbɐʔaʊ̯s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/55/De-%C3%BCberaus.ogg/De-%C3%BCberaus.ogg.mp3","examples":[{"text":"Sie ist eine überaus schöne Frau.","en":"She is a most beautiful lady.","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},{"g":"a"},null,{"g":"well, beautifully","l":"schön"},{"g":"woman"}]},{"text":"Es war überaus komisch.","en":"It was hilarious.","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"comedic"}]},{"text":"Wir sind überaus dankbar.","en":"We're very grateful.","words":[{"g":"we"},{"g":"are","l":"sein"},null,{"g":"grateful, thankful"}]},{"text":"Das ist wirklich überaus seltsam.","en":"It's really, really strange.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"really, actually"},null,{"g":"strangely"}]},{"text":"Er schien überaus nervös zu sein.","en":"He seemed really nervous.","words":[{"g":"he / it"},{"g":"to shine","l":"scheinen"},null,{"g":"nervous"},{"g":"to / too"},{"g":"to be"}]}]}