{"id":"nirgendwohin","lemma":"nirgendwohin","pos":"adv","rank":2869,"glosses":["nowhere (to no place)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/19/De-nirgendwohin.ogg/De-nirgendwohin.ogg.mp3","examples":[{"text":"Wir sind nirgendwohin gegangen.","en":"We didn't go anywhere.","audio":"https://tatoeba.org/en/audio/download/755743","words":[{"g":"we"},{"g":"are","l":"sein"},null,{"g":"to go, to walk","l":"gehen"}]},{"text":"Ich kann nirgendwohin gehen.","en":"I can't go anywhere.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"to go, to walk"}]},{"text":"Ohne meine Kamera gehe ich nirgendwohin.","en":"I don't go anywhere without my camera.","words":[{"g":"without"},{"g":"my","l":"mein"},{"g":"camera"},{"g":"to go, to walk","l":"gehen"},{"g":"I"},null]},{"text":"Du gehst nirgendwohin!","en":"You're going nowhere.","words":[{"g":"you"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Ich fahre heute nachmittag nirgendwohin.","en":"I'm not going anywhere this afternoon.","words":[{"g":"I"},{"g":"to go at speed","l":"fahren"},{"g":"today"},{"g":"afternoon"},null]}]}