{"id":"soweit","lemma":"soweit","pos":"conj","rank":898,"glosses":["as far as (in the scope in which something holds)","if (supposing that; assuming that)"],"ipa":"/soˈvaɪ̯t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/De-soweit.ogg/De-soweit.ogg.mp3","examples":[{"text":"Ich sehe, du bist soweit.","en":"I see you are ready.","audio":"https://tatoeba.org/en/audio/download/746635","words":[{"g":"I"},{"g":"to see","l":"sehen"},{"g":"you"},{"g":"are","l":"sein"},null]},{"text":"Ruf mich, wenn du soweit bist!","en":"Call me when you're ready.","audio":"https://tatoeba.org/en/audio/download/760950","words":[{"g":"to call out","l":"rufen"},{"g":"me","l":"ich"},{"g":"if / when"},{"g":"you"},null,{"g":"are","l":"sein"}]},{"text":"Soweit ich weiß, kommt er nicht.","en":"As far as I know, he won't come.","words":[null,{"g":"I"},{"g":"to know","l":"wissen"},{"g":"to come","l":"kommen"},{"g":"he / it"},{"g":"not"}]},{"text":"Ich glaube, ich bin soweit.","en":"I think I'm ready.","audio":"https://tatoeba.org/en/audio/download/392339","words":[{"g":"I"},{"g":"to believe something","l":"glauben"},{"g":"I"},{"g":"am","l":"sein"},null]},{"text":"Seid ihr hier soweit fertig?","en":"Are you almost done here?","words":[{"g":"are","l":"sein"},{"g":"you (pl.) / her"},{"g":"here"},null,{"g":"ready for use"}]}]}