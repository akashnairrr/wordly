{"id":"kaum","lemma":"kaum","pos":"adv","rank":406,"glosses":["barely, hardly (qualifying verbs or adjectives)","barely any, almost no (qualifying amounts)","difficult, nearly impossible"],"ipa":"/kaʊ̯m/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/58/De-at-kaum.ogg/De-at-kaum.ogg.mp3","examples":[{"text":"Ich kenne euch kaum.","en":"I barely know you.","audio":"https://tatoeba.org/en/audio/download/391473","words":[{"g":"I"},{"g":"to know","l":"kennen"},{"g":"you (pl.)","l":"ihr"},null]},{"text":"Ich kann kaum laufen.","en":"I can barely walk.","audio":"https://tatoeba.org/en/audio/download/392887","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"to walk"}]},{"text":"Er kann kaum lesen.","en":"He can barely read.","audio":"https://tatoeba.org/en/audio/download/393458","words":[{"g":"he / it"},{"g":"can, to be able to","l":"können"},null,{"g":"to read"}]},{"text":"Du kennst mich kaum.","en":"You hardly know me.","words":[{"g":"you"},{"g":"to know","l":"kennen"},{"g":"me","l":"ich"},null]},{"text":"Ihr kennt mich kaum.","en":"You hardly know me.","words":[{"g":"you (pl.) / her"},{"g":"to know","l":"kennen"},{"g":"me","l":"ich"},null]}]}