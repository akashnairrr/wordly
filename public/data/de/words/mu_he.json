{"id":"mu_he","lemma":"Mühe","pos":"noun","rank":1360,"glosses":["effort, difficulty"],"ipa":"/ˈmyːə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c6/De-M%C3%BChe.ogg/De-M%C3%BChe.ogg.mp3","gender":"f","forms":{"genitive":"Mühe","plural":"Mühen"},"examples":[{"text":"Ist es die Mühe wert?","en":"Is it worth the effort?","words":[{"g":"is","l":"sein"},{"g":"it"},{"g":"the"},null,{"g":"worth, worthy of"}]},{"text":"Du machst dir zu viel Mühe.","en":"You're trying too hard.","audio":"https://tatoeba.org/en/audio/download/760348","words":[{"g":"you"},{"g":"to make","l":"machen"},{"g":"(to) you","l":"du"},null,null,null],"phrases":[[3,5,"too much"]]},{"text":"Die Mühen sind fast zu Ende.","en":"The hard work is almost over.","words":[{"g":"the"},null,{"g":"are","l":"sein"},{"g":"almost"},null,null],"phrases":[[4,6,"finished, through"]]},{"text":"Ich kann nur mit Mühe aufstehen.","en":"I can barely stand up.","audio":"https://tatoeba.org/en/audio/download/756696","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"only"},{"g":"with"},null,{"g":"to get up (move from a…"}]},{"text":"Das war die Mühe wirklich wert.","en":"That was well worth the trouble.","words":[{"g":"the / that"},{"g":"was","l":"sein"},{"g":"the"},null,{"g":"really, actually"},{"g":"worth, worthy of"}]}]}