{"id":"ran","lemma":"ran","pos":"adv","rank":829,"glosses":["near, close to, over to"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cd/De-ran.ogg/De-ran.ogg.mp3","examples":[{"text":"Bitte geh ran.","en":"Please answer the phone.","audio":"https://tatoeba.org/en/audio/download/593345","words":[{"g":"please"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Ich ging ran.","en":"I answered the phone.","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Halte dich ran!","en":"Do it quickly.","audio":"https://tatoeba.org/en/audio/download/701219","words":[{"g":"to hold","l":"halten"},{"g":"you","l":"du"},null]},{"text":"Nun mal ran an die Arbeit.","en":"Now let's get down to work.","words":[{"g":"now, at this moment"},{"g":"just / once"},null,{"g":"at / on"},{"g":"the"},{"g":"toil"}]},{"text":"Das Telefon klingelt, aber keiner geht ran.","en":"The phone's ringing, but no one's picking it up.","words":[{"g":"the / that"},{"g":"telephone"},{"g":"to ring","l":"klingeln"},{"g":"but"},{"g":"none"},{"g":"to go, to walk","l":"gehen"},null]}]}