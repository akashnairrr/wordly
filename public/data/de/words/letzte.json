{"id":"letzte","lemma":"letzte","pos":"adj","rank":251,"glosses":["last"],"ipa":"/ˈlɛt͡stə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/db/De-letzte.ogg/De-letzte.ogg.mp3","examples":[{"text":"Das ist das letzte Spiel.","en":"This is the last game.","audio":"https://tatoeba.org/en/audio/download/44868","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"the / that"},null,{"g":"a game"}]},{"text":"Letzte Nacht war es heiß.","en":"It was hot last night.","audio":"https://tatoeba.org/en/audio/download/755447","words":[null,{"g":"night"},{"g":"was","l":"sein"},{"g":"it"},{"g":"hot"}]},{"text":"Wer war der Letzte hier?","en":"Who was the last one here?","words":[{"g":"who"},{"g":"was","l":"sein"},{"g":"the"},null,{"g":"here"}]},{"text":"Ich bin die Letzte.","en":"I'm the last.","audio":"https://tatoeba.org/en/audio/download/699133","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"the"},null]},{"text":"Sie wurde Letzte.","en":"She came last.","audio":"https://tatoeba.org/en/audio/download/70430","words":[{"g":"she / they / you"},{"g":"to become","l":"werden"},null]}]}