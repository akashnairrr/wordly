{"id":"klar","lemma":"klar","pos":"intj","rank":117,"glosses":["okay!; sure!; all right!; spontaneous agreement to a proposition","sure!, of course!; strong agreement to a statement","yeah, right!; sarcastic expression of disbelief"],"ipa":"/klaːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/De-klar.ogg/De-klar.ogg.mp3","examples":[{"text":"Der Himmel ist klar.","en":"The sky is clear.","audio":"https://tatoeba.org/en/audio/download/70570","words":[{"g":"the"},{"g":"sky"},{"g":"is","l":"sein"},null]},{"text":"Ist dir das jetzt klar genug?","en":"Is that clear enough for you now?","words":[{"g":"is","l":"sein"},{"g":"(to) you","l":"du"},{"g":"the / that"},{"g":"now"},null,{"g":"enough"}]},{"text":"Ist meine Erklärung klar?","en":"Is my explanation clear?","words":[{"g":"is","l":"sein"},{"g":"my","l":"mein"},{"g":"explanation"},null]},{"text":"Klar bin ich wütend.","en":"You bet I'm angry.","audio":"https://tatoeba.org/en/audio/download/391024","words":[null,{"g":"am","l":"sein"},{"g":"I"},{"g":"angrily, furiously"}]},{"text":"Ich höre dich laut und klar.","en":"I hear you loud and clear.","words":[{"g":"I"},{"g":"to hear through the ear)","l":"hören"},{"g":"you","l":"du"},{"g":"according to"},{"g":"and"},null]}]}