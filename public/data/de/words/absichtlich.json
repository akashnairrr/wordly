{"id":"absichtlich","lemma":"absichtlich","pos":"adv","rank":2672,"glosses":["intentionally"],"ipa":"/ˈapzɪçtlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b1/De-absichtlich.ogg/De-absichtlich.ogg.mp3","examples":[{"text":"War das absichtlich?","en":"Was that intentional?","words":[{"g":"was","l":"sein"},{"g":"the / that"},null]},{"text":"Haben Sie das absichtlich getan?","en":"Did you do that purposely?","audio":"https://tatoeba.org/en/audio/download/593296","words":[{"g":"have"},{"g":"she / they / you"},{"g":"the / that"},null,{"g":"to do","l":"tun"}]},{"text":"Hast du absichtlich einen Fehler gemacht?","en":"Did you purposefully make a mistake?","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"a","l":"ein"},{"g":"fault, error, mistake"},{"g":"to make","l":"machen"}]},{"text":"Vielleicht hat er es absichtlich gemacht.","en":"Maybe he did it on purpose.","words":[{"g":"perhaps, maybe"},{"g":"has","l":"haben"},{"g":"he / it"},{"g":"it"},null,{"g":"to make","l":"machen"}]},{"text":"Er hat ihre Gefühle absichtlich verletzt.","en":"He hurt her feelings on purpose.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"her","l":"ihr"},{"g":"feeling","l":"Gefühl"},null,{"g":"hurt, injured"}]}]}