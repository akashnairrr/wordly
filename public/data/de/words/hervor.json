{"id":"hervor","lemma":"hervor","pos":"adv","rank":3791,"glosses":["forth (in the direction of the speaker)"],"ipa":"/hɛrˈfoːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/De-hervor.ogg/De-hervor.ogg.mp3","examples":[{"text":"Er kam unter dem Auto hervor.","en":"He got out from under the car.","words":[{"g":"he / it"},{"g":"to come","l":"kommen"},{"g":"under"},{"g":"(to) the","l":"der"},{"g":"car"},null]},{"text":"Eine Katze kam unter dem Tisch hervor.","en":"A cat came out from under the desk.","audio":"https://tatoeba.org/en/audio/download/787830","words":[{"g":"a"},{"g":"house cat"},{"g":"to come","l":"kommen"},{"g":"under"},{"g":"(to) the","l":"der"},{"g":"dining table"},null]},{"text":"Die Sonne kam hervor.","en":"The sun came out.","words":[{"g":"the"},{"g":"a sun"},{"g":"to come","l":"kommen"},null]},{"text":"Die Sterne kamen hervor.","en":"The stars came out.","words":[{"g":"the"},{"g":"a star","l":"Stern"},{"g":"to come","l":"kommen"},null]},{"text":"Eine Frau kam hinter einem Baum hervor.","en":"A woman appeared from behind a tree.","words":[{"g":"a"},{"g":"woman"},{"g":"to come","l":"kommen"},{"g":"behind, after"},{"g":"(to) a","l":"ein"},{"g":"tree"},null]}]}