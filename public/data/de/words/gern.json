{"id":"gern","lemma":"gern","pos":"adv","rank":221,"glosses":["willingly; gladly; with pleasure; usually expressed with a verb in English, as in like, enjoy etc.","much; a lot","easily; often"],"ipa":"/ɡɛrn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/De-gern.ogg/De-gern.ogg.mp3","examples":[{"text":"Spielt ihr gern?","en":"Do you like to play games?","audio":"https://tatoeba.org/en/audio/download/761394","words":[{"g":"to play","l":"spielen"},{"g":"you (pl.) / her"},null]},{"text":"Spielen Sie gern?","en":"Do you like to play games?","audio":"https://tatoeba.org/en/audio/download/761395","words":[{"g":"to play"},{"g":"she / they / you"},null]},{"text":"Ich wäre gern deine Freundin.","en":"I'd like to be your friend.","audio":"https://tatoeba.org/en/audio/download/698716","words":[{"g":"I"},{"g":"to be","l":"sein"},null,{"g":"your","l":"dein"},{"g":"friend","l":"Freund"}]},{"text":"Ich hätte gern eine Katze.","en":"I'd like to have a cat.","audio":"https://tatoeba.org/en/audio/download/700947","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"a"},{"g":"house cat"}]},{"text":"Bist du gern allein?","en":"Do you like to be alone?","audio":"https://tatoeba.org/en/audio/download/759697","words":[{"g":"are","l":"sein"},{"g":"you"},null,{"g":"alone"}]}]}