{"id":"wu_rde","lemma":"Würde","pos":"noun","rank":230,"glosses":["dignity"],"ipa":"/ˈvʏrdə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a0/De-W%C3%BCrde.ogg/De-W%C3%BCrde.ogg.mp3","gender":"f","forms":{"genitive":"Würde","plural":"Würden"},"examples":[{"text":"Ich würde es wieder tun.","en":"I'd do it again.","audio":"https://tatoeba.org/en/audio/download/263234","words":[{"g":"I"},null,{"g":"it"},{"g":"again"},{"g":"to do"}]},{"text":"Was würde passieren?","en":"What would happen?","audio":"https://tatoeba.org/en/audio/download/389703","words":[{"g":"what"},null,{"g":"to happen"}]},{"text":"Ich würde einen Arzt anrufen.","en":"I should call a doctor.","audio":"https://tatoeba.org/en/audio/download/757158","words":[{"g":"I"},null,{"g":"a","l":"ein"},{"g":"doctor, physician"},{"g":"to call, to ring"}]},{"text":"Niemand würde das sagen.","en":"No one would say that.","audio":"https://tatoeba.org/en/audio/download/757218","words":[{"g":"nobody, no one"},null,{"g":"the / that"},{"g":"to say (to pronounce"}]},{"text":"Wer würde dir eigentlich glauben?","en":"Who'd believe you anyway?","audio":"https://tatoeba.org/en/audio/download/760167","words":[{"g":"who"},null,{"g":"(to) you","l":"du"},{"g":"really"},{"g":"to believe something"}]}]}