{"id":"erzeugt","lemma":"erzeugt","pos":"adj","rank":4178,"glosses":["produced, generated"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3a/De-erzeugt.ogg/De-erzeugt.ogg.mp3","examples":[{"text":"Diese Maschine erzeugt Strom.","en":"This machine generates electricity.","words":[{"g":"this one, this","l":"dieser"},{"g":"machine"},null,{"g":"a large river"}]},{"text":"Krieg erzeugt Unsicherheit.","en":"War creates uncertainty.","words":[{"g":"war, warfare"},null,{"g":"uncertainty"}]},{"text":"Künstliches Licht wird durch Elektrizität erzeugt.","en":"Artificial light is produced by electricity.","words":[{"g":"artificial","l":"künstlich"},{"g":"light"},{"g":"to become","l":"werden"},{"g":"by means of"},{"g":"electricity"},null]},{"text":"Gewalt erzeugt Gegengewalt.","en":"Violence begets violence.","words":[{"g":"strong or violent force"},null,null]}]}