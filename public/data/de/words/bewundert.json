{"id":"bewundert","lemma":"bewundert","pos":"adj","rank":4577,"glosses":["admired"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/De-bewundert.ogg/De-bewundert.ogg.mp3","forms":{"comparative":"bewunderter","superlative":"am bewundertsten"},"examples":[{"text":"Niemand bewundert ihn mehr als ich.","en":"No one admires him more than I do.","words":[{"g":"nobody, no one"},null,{"g":"him"},{"g":"more"},{"g":"at the same moment"},{"g":"I"}]},{"text":"Jeder im Dorf bewundert ihn.","en":"Everybody in the village looks up to him.","words":[{"g":"each"},{"g":"in the"},{"g":"village"},null,{"g":"him"}]},{"text":"Sie wird bewundert.","en":"She is looked up to.","words":[{"g":"she / they / you"},{"g":"to become","l":"werden"},null]},{"text":"Tom hat mein neues Auto bewundert.","en":"Tom admired my new car.","words":[null,{"g":"has","l":"haben"},{"g":"my"},{"g":"new","l":"neu"},{"g":"car"},null]},{"text":"Tom bewundert deinen Mut.","en":"Tom admires your courage.","words":[null,null,{"g":"thy, your .","l":"dein"},{"g":"courage"}]}]}