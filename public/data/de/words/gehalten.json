{"id":"gehalten","lemma":"gehalten","pos":"adj","rank":1131,"glosses":["restrained, low-key"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a9/De-gehalten.ogg/De-gehalten.ogg.mp3","forms":{"comparative":"gehaltener","superlative":"am gehaltensten"},"examples":[{"text":"Ich habe mein Wort gehalten.","en":"I kept my word.","audio":"https://tatoeba.org/en/audio/download/246913","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"my"},{"g":"word as an isolated unit"},null]},{"text":"Er hat eine Rede gehalten.","en":"He delivered a speech.","audio":"https://tatoeba.org/en/audio/download/566422","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"a"},{"g":"speech, address"},null]},{"text":"Was hast du von ihm gehalten?","en":"What did you think of him?","words":[{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},{"g":"from / of"},{"g":"(to) him","l":"er"},null]},{"text":"Habt ihr euer Versprechen gehalten?","en":"Have you kept your promise?","words":[{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},{"g":"your"},{"g":"promise"},null]},{"text":"Sie hat zu ihm gehalten.","en":"She stood by him.","audio":"https://tatoeba.org/en/audio/download/394490","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"to / too"},{"g":"(to) him","l":"er"},null]}]}