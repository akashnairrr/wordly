{"id":"woru_ber","lemma":"worüber","pos":"adv","rank":978,"glosses":["over what","about what"],"ipa":"/ˈvoːˌʁyːbɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/De-wor%C3%BCber.ogg/De-wor%C3%BCber.ogg.mp3","examples":[{"text":"Worüber denkst du nach?","en":"What're you thinking about?","audio":"https://tatoeba.org/en/audio/download/566536","words":[null,{"g":"to think","l":"denken"},{"g":"you"},{"g":"after / to"}]},{"text":"Worüber lacht ihr?","en":"What are you laughing at?","words":[null,{"g":"to laugh","l":"lachen"},{"g":"you (pl.) / her"}]},{"text":"Worüber bist du so glücklich?","en":"What are you so happy about?","words":[null,{"g":"are","l":"sein"},{"g":"you"},{"g":"so"},{"g":"happy"}]},{"text":"Ich weiß genau, worüber ihr redet.","en":"I know exactly what you're talking about.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"just, exactly"},null,{"g":"you (pl.) / her"},{"g":"to talk","l":"reden"}]},{"text":"Das ist nicht, worüber wir sprechen.","en":"That's not what we're talking about.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"not"},null,{"g":"we"},{"g":"to speak"}]}]}