{"id":"wenig","lemma":"wenig","pos":"adj","rank":334,"glosses":["little, few (a small amount, a small number)"],"ipa":"/ˈveːnɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/50/De-wenig.ogg/De-wenig.ogg.mp3","forms":{"comparative":"weniger","superlative":"am wenigsten"},"formAudio":{"weniger":"https://upload.wikimedia.org/wikipedia/commons/1/11/LL-Q188_%28deu%29-Natschoba-weniger.wav"},"examples":[{"text":"Ich habe jetzt ein wenig Geld.","en":"I have a little money now.","audio":"https://tatoeba.org/en/audio/download/760720","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"now"},{"g":"a"},null,{"g":"money"}]},{"text":"Ist das zu wenig?","en":"Is that too little?","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"to / too"},null]},{"text":"Gib mir ein wenig Zeit.","en":"Give me a little time.","words":[{"g":"to give","l":"geben"},{"g":"(to) me","l":"ich"},{"g":"a"},null,{"g":"time"}]},{"text":"Wir haben sehr wenig Zeit.","en":"We have very little time.","words":[{"g":"we"},{"g":"have"},{"g":"very"},null,{"g":"time"}]},{"text":"Ich brauche hier ein wenig Hilfe.","en":"I need a little help here.","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"here"},{"g":"a"},null,{"g":"the act of helping"}]}]}