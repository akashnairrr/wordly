{"id":"neidisch","lemma":"neidisch","pos":"adj","rank":3390,"glosses":["envious, jealous"],"ipa":"/ˈnaɪ̯dɪʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/De-neidisch.ogg/De-neidisch.ogg.mp3","forms":{"comparative":"neidischer","superlative":"am neidischsten"},"examples":[{"text":"Bist du neidisch?","en":"Are you envious?","audio":"https://tatoeba.org/en/audio/download/251360","words":[{"g":"are","l":"sein"},{"g":"you"},null]},{"text":"Sind Sie neidisch?","en":"Are you envious?","audio":"https://tatoeba.org/en/audio/download/251361","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},null]},{"text":"Seid ihr neidisch?","en":"Are you envious?","audio":"https://tatoeba.org/en/audio/download/251362","words":[{"g":"are","l":"sein"},{"g":"you (pl.) / her"},null]},{"text":"Er war neidisch auf meinen Erfolg.","en":"He was jealous of my success.","audio":"https://tatoeba.org/en/audio/download/593067","words":[{"g":"he / it"},{"g":"was","l":"sein"},null,{"g":"on"},{"g":"to opine, to think"},{"g":"success"}]},{"text":"Die anderen Mädchen waren neidisch.","en":"The other girls were jealous.","words":[{"g":"the"},{"g":"another , others","l":"anderer"},{"g":"girl"},{"g":"to be","l":"sein"},null]}]}