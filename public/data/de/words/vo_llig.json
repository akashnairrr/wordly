{"id":"vo_llig","lemma":"völlig","pos":"adv","rank":468,"glosses":["completely"],"ipa":"/ˈfœlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/45/De-v%C3%B6llig.ogg/De-v%C3%B6llig.ogg.mp3","examples":[{"text":"Ich war völlig fertig.","en":"I was devastated.","audio":"https://tatoeba.org/en/audio/download/390951","words":[{"g":"I"},{"g":"was","l":"sein"},null,{"g":"ready for use"}]},{"text":"Die Antwort ist völlig falsch.","en":"The answer is completely wrong.","words":[{"g":"the"},{"g":"answer"},{"g":"is","l":"sein"},null,{"g":"false"}]},{"text":"Deine Idee ist nicht völlig verrückt.","en":"Your idea is not entirely crazy.","words":[{"g":"your","l":"dein"},{"g":"idea"},{"g":"is","l":"sein"},{"g":"not"},null,{"g":"crazy, mad"}]},{"text":"Du bist völlig verrückt.","en":"You're completely mad.","words":[{"g":"you"},{"g":"are","l":"sein"},null,{"g":"crazy, mad"}]},{"text":"Wir sind völlig betrunken.","en":"We're quite drunk.","audio":"https://tatoeba.org/en/audio/download/394294","words":[{"g":"we"},{"g":"are","l":"sein"},null,{"g":"drunk, inebriated"}]}]}