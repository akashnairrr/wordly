io":"https://tatoeba.org/en/audio/download/464","words":[{"g":"he / it"},{"g":"to become","l":"werden"},{"g":"me","l":"ich"},{"g":"not"},null]},{"text":"Der Regen schlägt gegen die Fenster.","en":"The rain is beating against the windows.","words":[{"g":"the"},{"g":"rain"},null,{"g":"against"},{"g":"the"},{"g":"window"}]},{"text":"Ich schlage es nach.","en":"I'll look it up.","audio":"https://tatoeba.org/en/audio/download/238913","words":[{"g":"I"},null,{"g":"it"},{"g":"after / to"}]}]}