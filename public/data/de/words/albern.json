{"id":"albern","lemma":"albern","pos":"adj","rank":1878,"glosses":["goofy, silly, childish (inappropriately funny)"],"ipa":"/ˈalbərn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/be/De-albern.ogg/De-albern.ogg.mp3","forms":{"comparative":"alberner","superlative":"am albernsten"},"examples":[{"text":"Ich weiß, es klingt albern.","en":"I know it sounds silly.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"it"},{"g":"to ring","l":"klingen"},null]},{"text":"Das ist einfach albern.","en":"That's just silly.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"easy"},null]},{"text":"Sei nicht albern!","en":"Don't be ridiculous!","audio":"https://tatoeba.org/en/audio/download/497001","words":[{"g":"to be","l":"sein"},{"g":"not"},null]},{"text":"Dein Hut sieht albern aus.","en":"Your hat looks silly.","words":[{"g":"your"},{"g":"hat"},{"g":"to see","l":"sehen"},null,{"g":"out of / from"}]},{"text":"Seien Sie nicht albern!","en":"Don't be ridiculous!","words":[{"g":"to be","l":"sein"},{"g":"she / they / you"},{"g":"not"},null]}]}