{"id":"u_berein","lemma":"überein","pos":"adv","rank":3823,"glosses":["equal, matching"],"ipa":"/yːbɐˈaɪ̯n/","examples":[{"text":"Ich stimme sehr mit dir überein.","en":"I strongly agree with you.","audio":"https://tatoeba.org/en/audio/download/761421","words":[{"g":"I"},{"g":"voice"},{"g":"very"},{"g":"with"},{"g":"(to) you","l":"du"},null]},{"text":"Jeder stimmt mit Ihnen überein.","en":"Everyone agrees with them.","words":[{"g":"each"},{"g":"correct"},{"g":"with"},{"g":"(to) them","l":"sie"},null]},{"text":"Stimmen alle überein?","en":"Does everyone agree?","words":[{"g":"to be right"},{"g":"all, everyone"},null]},{"text":"Wir stimmen kaum jemals überein bei etwas.","en":"We hardly ever agree on anything.","words":[{"g":"we"},{"g":"to be right"},{"g":"barely, hardly"},{"g":"ever"},null,{"g":"at / with"},{"g":"something"}]},{"text":"Hier stimme ich überhaupt nicht mit Ihnen überein.","en":"This is where I absolutely disagree with you.","words":[{"g":"here"},{"g":"voice"},{"g":"I"},null,null,{"g":"with"},{"g":"(to) them","l":"sie"},null],"phrases":[[3,5,"not at all"]]}]}