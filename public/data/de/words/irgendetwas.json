{"id":"irgendetwas","lemma":"irgendetwas","pos":"pron","rank":697,"glosses":["anything (at all) (any matter, regardless of how minor)","something (or other) (a mundane or uninteresting matter not considered worth specifying further)"],"ipa":"/ˌɪʁɡn̩tˈʔɛtvas/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/De-irgendetwas.ogg/De-irgendetwas.ogg.mp3","examples":[{"text":"Kann ich irgendetwas tun?","en":"Can I do anything?","words":[{"g":"can, to be able to","l":"können"},{"g":"I"},null,{"g":"to do"}]},{"text":"Willst du irgendetwas?","en":"Do you want anything?","words":[{"g":"to want","l":"wollen"},{"g":"you"},null]},{"text":"Habe ich irgendetwas vergessen?","en":"Have I forgotten anything?","words":[{"g":"have","l":"haben"},{"g":"I"},null,{"g":"to forget"}]},{"text":"Gib mir irgendetwas zu tun.","en":"Give me something to do.","audio":"https://tatoeba.org/en/audio/download/701261","words":[{"g":"to give","l":"geben"},{"g":"(to) me","l":"ich"},null,{"g":"to / too"},{"g":"to do"}]},{"text":"Niemand hat uns irgendetwas erzählt.","en":"Nobody has told us anything.","words":[{"g":"nobody, no one"},{"g":"has","l":"haben"},{"g":"us","l":"wir"},null,{"g":"to tell","l":"erzählen"}]}]}