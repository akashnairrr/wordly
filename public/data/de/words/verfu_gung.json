{"id":"verfu_gung","lemma":"Verfügung","pos":"noun","rank":1864,"glosses":["disposal, disposition (control over something)","injunction, decree"],"ipa":"/fɛɐ̯ˈfyːɡʊŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7e/De-Verf%C3%BCgung.ogg/De-Verf%C3%BCgung.ogg.mp3","gender":"f","forms":{"genitive":"Verfügung","plural":"Verfügungen"},"examples":[{"text":"Ich habe viel Geld zur Verfügung.","en":"I have a lot of money at my disposal.","audio":"https://tatoeba.org/en/audio/download/593023","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"much, a lot"},{"g":"money"},{"g":"to the"},null]},{"text":"Mein Auto steht dir zur Verfügung.","en":"My car is at your disposal.","words":[{"g":"my"},{"g":"car"},{"g":"to stand","l":"stehen"},{"g":"(to) you","l":"du"},{"g":"to the"},null]},{"text":"Das Zimmer steht dir nun zur Verfügung.","en":"The room is now ready for you.","words":[{"g":"the / that"},{"g":"room"},{"g":"to stand","l":"stehen"},{"g":"(to) you","l":"du"},{"g":"now, at this moment"},{"g":"to the"},null]},{"text":"Das Auto steht heute nicht zur Verfügung.","en":"The car is not available today.","words":[{"g":"the / that"},{"g":"car"},{"g":"to stand","l":"stehen"},{"g":"today"},{"g":"not"},{"g":"to the"},null]},{"text":"Ich stehe zu deiner Verfügung.","en":"I'm at your disposal.","words":[{"g":"I"},{"g":"to stand","l":"stehen"},{"g":"to / too"},{"g":"yours, thine"},null]}]}