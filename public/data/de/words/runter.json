{"id":"runter","lemma":"runter","pos":"adv","rank":274,"glosses":["down, down here, downstairs (towards the speaker)","down, down there, downstairs (away from the speaker)"],"ipa":"/rʊntɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b8/De-runter.ogg/De-runter.ogg.mp3","examples":[{"text":"Nimm es runter.","en":"Take it down.","words":[{"g":"to take","l":"nehmen"},{"g":"it"},null]},{"text":"Kommt runter.","en":"Come downstairs.","audio":"https://tatoeba.org/en/audio/download/389591","words":[{"g":"to come","l":"kommen"},null]},{"text":"Kopf runter.","en":"Keep your head down.","audio":"https://tatoeba.org/en/audio/download/496952","words":[{"g":"head"},null]},{"text":"Warum kommst du nicht runter?","en":"Why don't you come on down?","words":[{"g":"why"},{"g":"to come","l":"kommen"},{"g":"you"},{"g":"not"},null]},{"text":"Guck runter.","en":"Look down.","audio":"https://tatoeba.org/en/audio/download/695103","words":[{"g":"to look","l":"gucken"},null]}]}