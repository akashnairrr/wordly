{"id":"dienst","lemma":"Dienst","pos":"noun","rank":1264,"glosses":["service","work, duty"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e6/De-Dienst.ogg/De-Dienst.ogg.mp3","gender":"m","forms":{"genitive":"Dienstes","plural":"Dienste"},"examples":[{"text":"Ich bin jetzt im Dienst.","en":"I am now on duty.","audio":"https://tatoeba.org/en/audio/download/44287","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"now"},{"g":"in the"},null]},{"text":"Bist du gerade im Dienst?","en":"Are you on duty now?","words":[{"g":"are","l":"sein"},{"g":"you"},{"g":"now"},{"g":"in the"},null]},{"text":"Ich würde meine Dienste freiwillig anbieten.","en":"I'd like to volunteer my services.","words":[{"g":"I"},{"g":"dignity"},{"g":"my","l":"mein"},null,{"g":"voluntary"},{"g":"to offer, to provide"}]},{"text":"Sind Sie morgen im Dienst?","en":"Are you on duty tomorrow?","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},{"g":"tomorrow"},{"g":"in the"},null]},{"text":"Wer hat heute Dienst?","en":"Who's on duty today?","words":[{"g":"who"},{"g":"has","l":"haben"},{"g":"today"},null]}]}