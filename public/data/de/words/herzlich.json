{"id":"herzlich","lemma":"herzlich","pos":"adj","rank":1383,"glosses":["warm, warmhearted, friendly, affectionate, cordial","hearty"],"ipa":"/ˈhɛʁt͡s.lɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0f/De-herzlich.ogg/De-herzlich.ogg.mp3","forms":{"comparative":"herzlicher","superlative":"am herzlichsten"},"examples":[{"text":"Sie hieß sie herzlich willkommen.","en":"She extended a warm welcome to them.","words":[{"g":"she / they / you"},{"g":"to have a name","l":"heißen"},{"g":"she / they / you"},null,{"g":"welcome"}]},{"text":"Ihr seid hier herzlich willkommen.","en":"You're very welcome here.","words":[{"g":"you (pl.) / her"},{"g":"are","l":"sein"},{"g":"here"},null,{"g":"welcome"}]},{"text":"Ich wurde herzlich willkommen geheißen.","en":"I received a warm welcome.","audio":"https://tatoeba.org/en/audio/download/760728","words":[{"g":"I"},{"g":"to become","l":"werden"},null,{"g":"welcome"},{"g":"to have a name","l":"heißen"}]},{"text":"Tom ist ein sehr herzlicher Mensch.","en":"Tom is a very warm-hearted person.","words":[null,{"g":"is","l":"sein"},{"g":"a"},{"g":"very"},null,{"g":"human"}]},{"text":"Diese Familie hat mich herzlich aufgenommen.","en":"This family gave me a warm welcome.","words":[{"g":"this one, this","l":"dieser"},{"g":"family"},{"g":"has","l":"haben"},{"g":"me","l":"ich"},null,{"g":"recorded"}]}]}