{"id":"nun","lemma":"nun","pos":"adv","rank":105,"glosses":["now, at this moment","now, then; expressing a logical or temporal consequence","unstressed and expletive, used for minor emphasis"],"ipa":"/nuːn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/15/De-nun.ogg/De-nun.ogg.mp3","examples":[{"text":"Muss ich nun gehen?","en":"Do I have to go now?","words":[{"g":"to have to","l":"müssen"},{"g":"I"},null,{"g":"to go, to walk"}]},{"text":"Was willst du nun?","en":"What do you want now?","words":[{"g":"what"},{"g":"to want","l":"wollen"},{"g":"you"},null]},{"text":"Glaubst du es nun?","en":"Do you believe it now?","words":[{"g":"to believe something","l":"glauben"},{"g":"you"},{"g":"it"},null]},{"text":"Du solltest nun gehen.","en":"You should go now.","words":[{"g":"you"},{"g":"should","l":"sollen"},null,{"g":"to go, to walk"}]},{"text":"Nun liegt es an mir.","en":"Now it's up to me.","audio":"https://tatoeba.org/en/audio/download/389467","words":[null,{"g":"to lie","l":"liegen"},{"g":"it"},{"g":"at / on"},{"g":"(to) me","l":"ich"}]}]}