{"id":"leitung","lemma":"Leitung","pos":"noun","rank":1741,"glosses":["cable, line, wire","conduit, pipe","management"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/De-Leitung.ogg/De-Leitung.ogg.mp3","gender":"f","forms":{"genitive":"Leitung","plural":"Leitungen"},"examples":[{"text":"Bleiben Sie bitte in der Leitung.","en":"Hold the line, please.","words":[{"g":"to remain"},{"g":"she / they / you"},{"g":"please"},{"g":"in"},{"g":"the"},null]},{"text":"Es war niemand am anderen Ende der Leitung.","en":"There was no one on the other end of the line.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"nobody, no one"},{"g":"at the / on the"},{"g":"another , others","l":"anderer"},{"g":"end, finish"},{"g":"the"},null]},{"text":"Du solltest die Leitung übernehmen.","en":"You should be in charge.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"the"},null,{"g":"to take over"}]},{"text":"Die Leitung ist besetzt.","en":"The line's busy.","audio":"https://tatoeba.org/en/audio/download/394736","words":[{"g":"the"},null,{"g":"is","l":"sein"},{"g":"occupied"}]},{"text":"Ich habe hier die Leitung inne.","en":"I'm in charge here.","audio":"https://tatoeba.org/en/audio/download/391801","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"here"},{"g":"the"},null,{"g":"only used in inne sein"}]}]}