{"id":"nachmittag","lemma":"Nachmittag","pos":"noun","rank":1141,"glosses":["afternoon (part of the day from about 2 p.m. to about 6 p.m.)"],"ipa":"/ˈnaːx.mɪˌtaːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/68/De-Nachmittag.ogg/De-Nachmittag.ogg.mp3","gender":"m","forms":{"genitive":"Nachmittages","plural":"Nachmittage"},"examples":[{"text":"Wie war dein Nachmittag?","en":"How was your afternoon?","audio":"https://tatoeba.org/en/audio/download/755344","words":[{"g":"how"},{"g":"was","l":"sein"},{"g":"your"},null]},{"text":"Was machst du am Nachmittag?","en":"What do you do in the afternoon?","audio":"https://tatoeba.org/en/audio/download/41759","words":[{"g":"what"},{"g":"to make","l":"machen"},{"g":"you"},{"g":"at the / on the"},null]},{"text":"Habt ihr morgen Nachmittag Zeit?","en":"Do you have time tomorrow afternoon?","words":[{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},{"g":"tomorrow"},null,{"g":"time"}]},{"text":"Ich habe dich heute Nachmittag angerufen.","en":"I called you this afternoon.","audio":"https://tatoeba.org/en/audio/download/718163","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"you","l":"du"},{"g":"today"},null,{"g":"to call, to ring","l":"anrufen"}]},{"text":"Ruf mich morgen Nachmittag an.","en":"Call me tomorrow afternoon.","words":[{"g":"to call out","l":"rufen"},{"g":"me","l":"ich"},{"g":"tomorrow"},null,{"g":"at / on"}]}]}