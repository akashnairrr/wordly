{"id":"nebenan","lemma":"nebenan","pos":"adv","rank":2037,"glosses":["next door"],"ipa":"/ˌneːbənˈan/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/67/De-nebenan.ogg/De-nebenan.ogg.mp3","examples":[{"text":"Wer ist im Zimmer nebenan?","en":"Who's in the next room?","words":[{"g":"who"},{"g":"is","l":"sein"},{"g":"in the"},{"g":"room"},null]},{"text":"Ich wohne nebenan.","en":"I live next door.","words":[{"g":"I"},{"g":"to live, reside, dwell","l":"wohnen"},null]},{"text":"Sie wohnen nebenan.","en":"They live next door.","words":[{"g":"she / they / you"},{"g":"to live, reside, dwell"},null]},{"text":"Es ist laut nebenan.","en":"It's noisy next door.","audio":"https://tatoeba.org/en/audio/download/69570","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"according to"},null]},{"text":"Er wohnt nebenan.","en":"He lives next door to us.","words":[{"g":"he / it"},{"g":"to live, reside, dwell","l":"wohnen"},null]}]}