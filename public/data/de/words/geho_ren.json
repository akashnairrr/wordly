{"id":"geho_ren","lemma":"gehören","pos":"verb","rank":840,"glosses":["to belong to, be the property of","to be a prerequisite for; to be a characteristic of","to belong to, be a part of"],"ipa":"/ɡəˈhøːʁən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6e/De-geh%C3%B6ren2.ogg/De-geh%C3%B6ren2.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"gehöre","1p":"gehören","2s":"gehörst","2p":"gehört","3s":"gehört","3p":"gehören"},"preterite":{"1s":"gehörte","1p":"gehörten","2s":"gehörtest","2p":"gehörtet","3s":"gehörte","3p":"gehörten"},"perfect":{"1s":"habe gehört","1p":"haben gehört","2s":"hast gehört","2p":"habt gehört","3s":"hat gehört","3p":"haben gehört"},"future":{"1s":"werde gehören","1p":"werden gehören","2s":"wirst gehören","2p":"werdet gehören","3s":"wird gehören","3p":"werden gehören"}},"imperative":{"affirmative":{"2s":"gehör","2p":"gehört"}},"subjunctive":{"conditional":{"1s":"würde gehören","1p":"würden gehören","2s":"würdest gehören","2p":"würdet gehören","3s":"würde gehören","3p":"würden gehören"}}},"nonFinite":{"participle":"gehört"},"examples":[{"text":"Gehören Sie zur Polizei?","en":"Are you with the police?","audio":"https://tatoeba.org/en/audio/download/760083","words":[null,{"g":"she / they / you"},{"g":"to the"},{"g":"police"}]},{"text":"Du bist hier, wohin du gehörst.","en":"You're here where you belong.","words":[{"g":"you"},{"g":"are","l":"sein"},{"g":"here"},{"g":"where to, whither"},{"g":"you"},null]},{"text":"Es gehören immer zwei dazu.","en":"It takes two to tango.","audio":"https://tatoeba.org/en/audio/download/755360","words":[{"g":"it"},null,{"g":"at all times without…"},{"g":"two (numerical value…"},{"g":"in addition to it"}]},{"text":"Niemand wusste, wem das Land gehörte.","en":"No one knew who owned the land.","words":[{"g":"nobody, no one"},{"g":"to know","l":"wissen"},{"g":"who","l":"wer"},{"g":"the / that"},{"g":"country"},null]},{"text":"Mir gehören diese Schuhe.","en":"These shoes belong to me.","audio":"https://tatoeba.org/en/audio/download/44667","words":[{"g":"(to) me","l":"ich"},null,{"g":"this one, this","l":"dieser"},{"g":"shoe","l":"Schuh"}]}]}