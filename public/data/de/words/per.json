{"id":"per","lemma":"per","pos":"prep","rank":1759,"glosses":["by, by means of, through, via","by (a date)"],"ipa":"/pɛr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/87/De-per.ogg/De-per.ogg.mp3","examples":[{"text":"Ich möchte per Scheck zahlen.","en":"I'd like to pay by check.","words":[{"g":"I"},{"g":"to like","l":"mögen"},null,{"g":"check, cheque"},{"g":"to pay"}]},{"text":"Ich schicke das Buch per Post.","en":"I'll send the book by mail.","words":[{"g":"I"},{"g":"to send, to dispatch","l":"schicken"},{"g":"the / that"},{"g":"book (collection of…"},null,{"g":"mail, post"}]},{"text":"Reisen Sie per Schiff oder fliegen Sie?","en":"Are you traveling by sea or by air?","words":[{"g":"to travel"},{"g":"she / they / you"},null,{"g":"ship"},{"g":"or"},{"g":"to fly"},{"g":"she / they / you"}]},{"text":"Ich überquerte den Fluss per Schiff.","en":"I crossed the river by boat.","audio":"https://tatoeba.org/en/audio/download/717840","words":[{"g":"I"},{"g":"to cross, to traverse","l":"überqueren"},{"g":"the","l":"der"},{"g":"river"},null,{"g":"ship"}]},{"text":"Sag mir per Anruf Bescheid.","en":"Let me know by telephone.","words":[{"g":"to say (to pronounce","l":"sagen"},{"g":"(to) me","l":"ich"},null,{"g":"a call"},{"g":"notification"}]}]}