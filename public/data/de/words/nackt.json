{"id":"nackt","lemma":"nackt","pos":"adj","rank":1555,"glosses":["nude; not wearing any clothes","not properly clothed; wearing much less than weather, custom, etc. would demand","bare; not covered"],"ipa":"/nakt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/08/De-nackt.ogg/De-nackt.ogg.mp3","forms":{"comparative":"nackter","superlative":"am nacktesten"},"examples":[{"text":"Der Mann ist nackt.","en":"The man is naked.","words":[{"g":"the"},{"g":"man, male human being"},{"g":"is","l":"sein"},null]},{"text":"Ich war fast nackt.","en":"I was almost naked.","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"almost"},null]},{"text":"Das Baby war nackt.","en":"The baby was naked.","words":[{"g":"the / that"},{"g":"baby"},{"g":"was","l":"sein"},null]},{"text":"Die Frau ist nackt.","en":"The woman is naked.","words":[{"g":"the"},{"g":"woman"},{"g":"is","l":"sein"},null]},{"text":"Ich bin nicht nackt.","en":"I'm not naked.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"not"},null]}]}