{"id":"voran","lemma":"voran","pos":"adv","rank":2062,"glosses":["forth, ahead, forwards","before"],"ipa":"/foˈʁan/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c4/De-voran.ogg/De-voran.ogg.mp3","examples":[{"text":"Ich ging voran.","en":"I led the way.","audio":"https://tatoeba.org/en/audio/download/746150","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Geh du voran.","en":"You lead the way.","audio":"https://tatoeba.org/en/audio/download/390863","words":[{"g":"to go, to walk","l":"gehen"},{"g":"you"},null]},{"text":"Wir kommen nicht voran.","en":"We're not getting anywhere.","words":[{"g":"we"},{"g":"to come"},{"g":"not"},null]},{"text":"Wie kommst du mit deiner Arbeit voran?","en":"How are you getting along with your work?","words":[{"g":"how"},{"g":"to come","l":"kommen"},{"g":"you"},{"g":"with"},{"g":"yours, thine"},{"g":"toil"},null]},{"text":"Wie kommen Sie mit der Arbeit voran?","en":"How are you getting on with your work?","words":[{"g":"how"},{"g":"to come"},{"g":"she / they / you"},{"g":"with"},{"g":"the"},{"g":"toil"},null]}]}