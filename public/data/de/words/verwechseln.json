{"id":"verwechseln","lemma":"verwechseln","pos":"verb","rank":4505,"glosses":["to mix up; to confuse or mistake something for something else"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0a/De-verwechseln.ogg/De-verwechseln.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"verwechsle","1p":"verwechseln","2s":"verwechselst","2p":"verwechselt","3s":"verwechselt","3p":"verwechseln"},"preterite":{"1s":"verwechselte","1p":"verwechselten","2s":"verwechseltest","2p":"verwechseltet","3s":"verwechselte","3p":"verwechselten"},"perfect":{"1s":"habe verwechselt","1p":"haben verwechselt","2s":"hast verwechselt","2p":"habt verwechselt","3s":"hat verwechselt","3p":"haben verwechselt"},"future":{"1s":"werde verwechseln","1p":"werden verwechseln","2s":"wirst verwechseln","2p":"werdet verwechseln","3s":"wird verwechseln","3p":"werden verwechseln"}},"imperative":{"affirmative":{"2s":"verwechsle","2p":"verwechselt"}},"subjunctive":{"conditional":{"1s":"würde verwechseln","1p":"würden verwechseln","2s":"würdest verwechseln","2p":"würdet verwechseln","3s":"würde verwechseln","3p":"würden verwechseln"}}},"nonFinite":{"participle":"verwechselt"},"examples":[{"text":"Ich glaube, Sie verwechseln mich.","en":"I think you're confusing me with someone else.","words":[{"g":"I"},{"g":"to believe something","l":"glauben"},{"g":"she / they / you"},null,{"g":"me","l":"ich"}]},{"text":"Ich habe die Tür verwechselt.","en":"I went to the wrong door.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"the"},{"g":"door"},null]},{"text":"Der Lehrer verwechselte unsere Namen.","en":"The teacher mixed up our names.","words":[{"g":"the"},{"g":"to teach","l":"lehren"},null,{"g":"our","l":"unser"},{"g":"name","l":"Name"}]},{"text":"Sie müssen mich mit jemandem verwechselt haben.","en":"You must have me confused with someone else.","words":[{"g":"she / they / you"},{"g":"to have to"},{"g":"me","l":"ich"},{"g":"with"},{"g":"someone, somebody","l":"jemand"},null,{"g":"have"}]},{"text":"Alle verwechseln mich mit meinem Bruder.","en":"Everyone mistakes me for my brother.","words":[{"g":"all, everyone"},null,{"g":"me","l":"ich"},{"g":"with"},{"g":"my","l":"mein"},{"g":"brother"}]}]}