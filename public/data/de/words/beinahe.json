{"id":"beinahe","lemma":"beinahe","pos":"adv","rank":1524,"glosses":["almost; nearly"],"ipa":"/baɪ̯ˈnaːə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2d/De-beinahe.ogg/De-beinahe.ogg.mp3","examples":[{"text":"Ich hätte es beinahe vergessen.","en":"I almost forgot it.","audio":"https://tatoeba.org/en/audio/download/393157","words":[{"g":"I"},{"g":"to have","l":"haben"},{"g":"it"},null,{"g":"to forget"}]},{"text":"Ich hätte sie beinahe nie getroffen.","en":"I almost never met her.","audio":"https://tatoeba.org/en/audio/download/755133","words":[{"g":"I"},{"g":"to have","l":"haben"},{"g":"she / they / you"},null,{"g":"never, never at all"},{"g":"hit, struck, met"}]},{"text":"Es war beinahe Mittag.","en":"It was nearly noon.","audio":"https://tatoeba.org/en/audio/download/394116","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"noon"}]},{"text":"Ich hätte beinahe den Zug verpasst.","en":"I almost missed the train.","audio":"https://tatoeba.org/en/audio/download/760713","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"the","l":"der"},{"g":"train"},{"g":"to miss (be late for","l":"verpassen"}]},{"text":"Das Restaurant war beinahe leer.","en":"The restaurant was almost empty.","words":[{"g":"the / that"},{"g":"restaurant"},{"g":"was","l":"sein"},null,{"g":"empty"}]}]}