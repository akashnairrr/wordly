{"id":"manchmal","lemma":"manchmal","pos":"adv","rank":360,"glosses":["sometimes"],"ipa":"/ˈmançmaːl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d9/De-at-manchmal.ogg/De-at-manchmal.ogg.mp3","examples":[{"text":"Ich mache manchmal Fehler.","en":"I sometimes make mistakes.","audio":"https://tatoeba.org/en/audio/download/761726","words":[{"g":"I"},{"g":"to make","l":"machen"},null,{"g":"fault, error, mistake"}]},{"text":"Manchmal hasse ich meine Arbeit.","en":"I hate my job sometimes.","audio":"https://tatoeba.org/en/audio/download/593165","words":[null,{"g":"to hate","l":"hassen"},{"g":"I"},{"g":"my","l":"mein"},{"g":"toil"}]},{"text":"Wir sehen sie manchmal.","en":"We sometimes see them.","audio":"https://tatoeba.org/en/audio/download/757601","words":[{"g":"we"},{"g":"to see"},{"g":"she / they / you"},null]},{"text":"Ich tu das manchmal.","en":"I do that sometimes.","words":[{"g":"I"},{"g":"to do","l":"tun"},{"g":"the / that"},null]},{"text":"Manchmal ist ein Wort genug.","en":"A word is sometimes enough.","words":[null,{"g":"is","l":"sein"},{"g":"a"},{"g":"word as an isolated unit"},{"g":"enough"}]}]}