{"id":"respekt","lemma":"Respekt","pos":"noun","rank":958,"glosses":["respect, regard, reverence"],"ipa":"/ʁəˈspɛkt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/59/De-Respekt.ogg/De-Respekt.ogg.mp3","gender":"m","forms":{"genitive":"Respektes"},"examples":[{"text":"Ich habe vor ihm großen Respekt.","en":"I have great respect for him.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"in front of, ahead of"},{"g":"(to) him","l":"er"},{"g":"big","l":"groß"},null]},{"text":"Alte Leute verdienen Respekt.","en":"Old people deserve respect.","words":[{"g":"age, old age","l":"Alter"},{"g":"people"},{"g":"to make money, to earn"},null]},{"text":"Ich möchte mit Respekt behandelt werden.","en":"I want to be treated with respect.","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"with"},null,{"g":"treated"},{"g":"to become"}]},{"text":"Sie hat großen Respekt vor ihrem Lehrer.","en":"She has a lot of respect for her teacher.","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"big","l":"groß"},null,{"g":"in front of, ahead of"},{"g":"her","l":"ihr"},{"g":"to teach","l":"lehren"}]},{"text":"Zeig etwas Respekt.","en":"Show a little respect.","words":[{"g":"to point","l":"zeigen"},{"g":"something"},null]}]}