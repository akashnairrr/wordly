{"id":"eingesperrt","lemma":"eingesperrt","pos":"adj","rank":1785,"glosses":["confined","caged","imprisoned, incarcerated, jailed"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8b/De-eingesperrt.ogg/De-eingesperrt.ogg.mp3","examples":[{"text":"Warum haben sie ihn eingesperrt?","en":"Why did they arrest him?","words":[{"g":"why"},{"g":"have"},{"g":"she / they / you"},{"g":"him"},null]},{"text":"Er wurde eingesperrt.","en":"He was imprisoned.","audio":"https://tatoeba.org/en/audio/download/389649","words":[{"g":"he / it"},{"g":"to become","l":"werden"},null]},{"text":"Hilfe, ich bin eingesperrt!","en":"Help! I've been locked in!","words":[{"g":"the act of helping"},{"g":"I"},{"g":"am","l":"sein"},null]},{"text":"Mein Freund wurde wegen zu schnellem Fahren eingesperrt.","en":"My friend was arrested for speeding.","audio":"https://tatoeba.org/en/audio/download/41348","words":[{"g":"my"},{"g":"friend"},{"g":"to become","l":"werden"},{"g":"for, because of"},{"g":"to / too"},null,{"g":"to go at speed"},null]},{"text":"Wird Tom eingesperrt?","en":"Is Tom going to be arrested?","words":[{"g":"to become","l":"werden"},null,null]}]}