{"id":"eher","lemma":"eher","pos":"adv","rank":525,"glosses":["fairly, relatively, somewhat; expresses a weakened degree","sooner, more readily, preferably; expresses a preference","more precisely speaking, in fact, more like; used to replace a word or phrase with another"],"ipa":"/ˈeːər/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/54/De-eher.ogg/De-eher.ogg.mp3","examples":[{"text":"Wem trauen Sie eher?","en":"Who do you trust more?","words":[{"g":"who","l":"wer"},{"g":"to trust"},{"g":"she / they / you"},null]},{"text":"Warum kommst du nicht eher?","en":"Why don't you come earlier?","words":[{"g":"why"},{"g":"to come","l":"kommen"},{"g":"you"},{"g":"not"},null]},{"text":"Du hättest mich eher anrufen sollen.","en":"You should've called me sooner.","words":[{"g":"you"},{"g":"to have","l":"haben"},{"g":"me","l":"ich"},null,{"g":"to call, to ring"},{"g":"should"}]},{"text":"Ich hätte eher kommen sollen.","en":"I should've come sooner.","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"to come"},{"g":"should"}]},{"text":"Ich will heute eher los.","en":"I want to leave early today.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"today"},null,{"g":"rid of, free of"}]}]}