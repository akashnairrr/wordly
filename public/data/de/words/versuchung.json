{"id":"versuchung","lemma":"Versuchung","pos":"noun","rank":4002,"glosses":["temptation"],"ipa":"/fɛɐ̯ˈzuːχʊŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/De-Versuchung.ogg/De-Versuchung.ogg.mp3","gender":"f","forms":{"genitive":"Versuchung","plural":"Versuchungen"},"examples":[{"text":"Sie führte ihn in Versuchung.","en":"She tempted him.","audio":"https://tatoeba.org/en/audio/download/70520","words":[{"g":"she / they / you"},{"g":"to lead","l":"führen"},{"g":"him"},{"g":"in"},null]},{"text":"Führen Sie mich nicht in Versuchung!","en":"Don't tempt me.","audio":"https://tatoeba.org/en/audio/download/81786","words":[{"g":"to lead"},{"g":"she / they / you"},{"g":"me","l":"ich"},{"g":"not"},{"g":"in"},null]},{"text":"Er gab nie der Versuchung nach.","en":"He never gave way to temptation.","words":[{"g":"he / it"},{"g":"to give","l":"geben"},{"g":"never, never at all"},{"g":"the"},null,{"g":"after / to"}]},{"text":"Ich war in Versuchung, mich krankzumelden.","en":"I was tempted to call in sick.","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"in"},null,{"g":"me","l":"ich"},null]},{"text":"Sie hat ihn in Versuchung geführt.","en":"She tempted him.","audio":"https://tatoeba.org/en/audio/download/70521","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"him"},{"g":"in"},null,{"g":"guided, conducted"}]}]}