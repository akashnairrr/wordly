{"id":"beschlossen","lemma":"beschlossen","pos":"adj","rank":1820,"glosses":["decided, agreed"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9a/De-beschlossen.ogg/De-beschlossen.ogg.mp3","examples":[{"text":"Was habt ihr beschlossen?","en":"What have you decided?","words":[{"g":"what"},{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},null]},{"text":"Sie beschlossen zu heiraten.","en":"They decided to get married.","words":[{"g":"she / they / you"},null,{"g":"to / too"},{"g":"to marry"}]},{"text":"Was ist beschlossen worden?","en":"What did they decide?","words":[{"g":"what"},{"g":"is","l":"sein"},null,{"g":"to become","l":"werden"}]},{"text":"Ich habe beschlossen, das zu tun.","en":"I've decided to do that.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"the / that"},{"g":"to / too"},{"g":"to do"}]},{"text":"Wir haben beschlossen, unser Haus zu verkaufen.","en":"We've decided to sell our house.","words":[{"g":"we"},{"g":"have"},null,{"g":"our"},{"g":"house, building"},{"g":"to / too"},{"g":"to sell"}]}]}