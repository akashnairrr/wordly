{"id":"sonntag","lemma":"Sonntag","pos":"noun","rank":1454,"glosses":["Sunday (the first day of the week in many religious traditions, and the seventh day of the week in systems using the ISO 8601 standard)"],"ipa":"/ˈzɔntaːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/85/De-Sonntag2.ogg/De-Sonntag2.ogg.mp3","gender":"m","forms":{"genitive":"Sonntages","plural":"Sonntage"},"formAudio":{"Sonntage":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q188_%28deu%29-Sebastian_Wallroth-Sonntage.wav"},"examples":[{"text":"Ich arbeite am Sonntag.","en":"I work on Sunday.","audio":"https://tatoeba.org/en/audio/download/700194","words":[{"g":"I"},{"g":"to work","l":"arbeiten"},{"g":"at the / on the"},null]},{"text":"Ich hasse Sonntage.","en":"I hate Sundays.","words":[{"g":"I"},{"g":"to hate","l":"hassen"},null]},{"text":"Was macht ihr am Sonntag?","en":"What are you doing Sunday?","audio":"https://tatoeba.org/en/audio/download/700195","words":[{"g":"what"},{"g":"to make","l":"machen"},{"g":"you (pl.) / her"},{"g":"at the / on the"},null]},{"text":"Sonntag ist der erste Tag der Woche.","en":"Sunday is the first day of the week.","audio":"https://tatoeba.org/en/audio/download/41620","words":[null,{"g":"is","l":"sein"},{"g":"the"},{"g":"first"},{"g":"day"},{"g":"the"},{"g":"week"}]},{"text":"Wir haben uns am Sonntag getroffen.","en":"We met on Sunday.","audio":"https://tatoeba.org/en/audio/download/700304","words":[{"g":"we"},{"g":"have"},{"g":"us","l":"wir"},{"g":"at the / on the"},null,{"g":"hit, struck, met"}]}]}