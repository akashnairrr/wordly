{"id":"u_bermorgen","lemma":"übermorgen","pos":"adv","rank":3418,"glosses":["overmorrow, the day after tomorrow"],"ipa":"/ˈyːbɐˌmɔʁɡn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1f/De-at-%C3%BCbermorgen.ogg/De-at-%C3%BCbermorgen.ogg.mp3","examples":[{"text":"Hast du übermorgen frei?","en":"Are you free the day after tomorrow?","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"free"}]},{"text":"Was machst du übermorgen?","en":"What'll you be doing the day after tomorrow?","words":[{"g":"what"},{"g":"to make","l":"machen"},{"g":"you"},null]},{"text":"Was macht ihr übermorgen?","en":"What'll you be doing the day after tomorrow?","words":[{"g":"what"},{"g":"to make","l":"machen"},{"g":"you (pl.) / her"},null]},{"text":"Komm mich übermorgen besuchen.","en":"Come and see me the day after tomorrow.","words":[{"g":"to come","l":"kommen"},{"g":"me","l":"ich"},null,{"g":"to visit, to see"}]},{"text":"Ich schreibe dir übermorgen.","en":"I'll write to you the day after tomorrow.","words":[{"g":"I"},{"g":"to write, to write out","l":"schreiben"},{"g":"(to) you","l":"du"},null]}]}