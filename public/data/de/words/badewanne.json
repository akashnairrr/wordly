{"id":"badewanne","lemma":"Badewanne","pos":"noun","rank":4125,"glosses":["bathtub"],"ipa":"/ˈbaːdəˌvanə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8e/De-at-Badewanne.ogg/De-at-Badewanne.ogg.mp3","gender":"f","forms":{"genitive":"Badewanne","plural":"Badewannen"},"examples":[{"text":"Sie ist in der Badewanne.","en":"She's in the bath.","audio":"https://tatoeba.org/en/audio/download/394557","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},{"g":"in"},{"g":"the"},null]},{"text":"Meine Badewanne hat ein Leck.","en":"My bath has a leak.","words":[{"g":"my","l":"mein"},null,{"g":"has","l":"haben"},{"g":"a"},{"g":"leak"}]},{"text":"Ich machte die Badewanne sauber.","en":"I cleaned the bath.","words":[{"g":"I"},{"g":"to make","l":"machen"},{"g":"the"},null,{"g":"clean"}]},{"text":"Er singt gerne in der Badewanne.","en":"He likes to sing in the bathtub.","words":[{"g":"he / it"},{"g":"to sing","l":"singen"},{"g":"don't mention it"},{"g":"in"},{"g":"the"},null]},{"text":"Wir putzten die Badewanne.","en":"We cleaned the bath.","words":[{"g":"we"},null,{"g":"the"},null]}]}