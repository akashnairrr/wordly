{"id":"raus","lemma":"raus","pos":"adv","rank":135,"glosses":["out, out of there, outta there","out, out of here, outta here"],"ipa":"/ʁaʊ̯s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8f/De-raus.ogg/De-raus.ogg.mp3","examples":[{"text":"Komm mit uns raus.","en":"Come out with us.","audio":"https://tatoeba.org/en/audio/download/566243","words":[{"g":"to come","l":"kommen"},{"g":"with"},{"g":"us","l":"wir"},null]},{"text":"Hol mich hier raus.","en":"Get me out of here.","audio":"https://tatoeba.org/en/audio/download/394017","words":[{"g":"to get, to fetch","l":"holen"},{"g":"me","l":"ich"},{"g":"here"},null]},{"text":"Wie kommen wir hier raus?","en":"How do we get out of here?","audio":"https://tatoeba.org/en/audio/download/700376","words":[{"g":"how"},{"g":"to come"},{"g":"we"},{"g":"here"},null]},{"text":"Ich muss hier raus.","en":"I have to get out of here.","audio":"https://tatoeba.org/en/audio/download/698855","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"here"},null]},{"text":"Raus aus meinem Bett!","en":"Get out of my bed.","audio":"https://tatoeba.org/en/audio/download/565885","words":[null,{"g":"out of / from"},{"g":"my","l":"mein"},{"g":"bed (piece of furniture"}]}]}