{"id":"geliebt","lemma":"geliebt","pos":"adj","rank":839,"glosses":["loved"],"ipa":"/ɡəˈliːpt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/28/De-geliebt2.ogg/De-geliebt2.ogg.mp3","forms":{"comparative":"geliebter","superlative":"am geliebtesten"},"examples":[{"text":"Hast du mich jemals geliebt?","en":"Have you ever loved me?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"me","l":"ich"},{"g":"ever"},null]},{"text":"Ich habe dich geliebt.","en":"I loved you.","audio":"https://tatoeba.org/en/audio/download/393070","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"you","l":"du"},null]},{"text":"Ich dachte, du hast es geliebt.","en":"I thought you loved it.","audio":"https://tatoeba.org/en/audio/download/757409","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"you"},{"g":"have","l":"haben"},{"g":"it"},null]},{"text":"Niemand hat ihn jemals geliebt.","en":"Nobody has ever loved him.","words":[{"g":"nobody, no one"},{"g":"has","l":"haben"},{"g":"him"},{"g":"ever"},null]},{"text":"Wir wollen doch alle geliebt werden.","en":"We all just want to be loved.","audio":"https://tatoeba.org/en/audio/download/718004","words":[{"g":"we"},{"g":"to want"},{"g":"but / yes"},{"g":"all, everyone"},null,{"g":"to become"}]}]}