{"id":"bestimmt","lemma":"bestimmt","pos":"adj","rank":342,"glosses":["certain","determined","definite"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ef/De-at-bestimmt.ogg/De-at-bestimmt.ogg.mp3","examples":[{"text":"Er wird bestimmt gewinnen.","en":"He is sure to win.","audio":"https://tatoeba.org/en/audio/download/391370","words":[{"g":"he / it"},{"g":"to become","l":"werden"},null,{"g":"to win"}]},{"text":"Er wird bestimmt ein guter Arzt.","en":"He will become a good doctor.","words":[{"g":"he / it"},{"g":"to become","l":"werden"},null,{"g":"a"},{"g":"good","l":"gut"},{"g":"doctor, physician"}]},{"text":"Du hast bestimmt viel Geld.","en":"You must have a lot of money.","words":[{"g":"you"},{"g":"have","l":"haben"},null,{"g":"much, a lot"},{"g":"money"}]},{"text":"Meine Mutter sagt ganz bestimmt nein.","en":"My mother is certain to say no.","words":[{"g":"my","l":"mein"},{"g":"mother"},{"g":"to say (to pronounce","l":"sagen"},{"g":"entire"},null,{"g":"no"}]},{"text":"Der Hund hat bestimmt Hunger.","en":"The dog must be hungry.","audio":"https://tatoeba.org/en/audio/download/758420","words":[{"g":"the"},{"g":"dog, hound"},{"g":"has","l":"haben"},null,{"g":"hunger"}]}]}