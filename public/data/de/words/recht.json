{"id":"recht","lemma":"recht","pos":"adj","rank":157,"glosses":["right, right-hand (direction)","proper, correct, right","true, real"],"ipa":"/ʁɛçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b3/De-recht.ogg/De-recht.ogg.mp3","forms":{"comparative":"rechter","superlative":"am rechtesten"},"examples":[{"text":"Niemand hat dieses Recht.","en":"No one has that right.","audio":"https://tatoeba.org/en/audio/download/757178","words":[{"g":"nobody, no one"},{"g":"has","l":"haben"},{"g":"this one, this","l":"dieser"},null]},{"text":"Habe ich recht?","en":"Am I right?","audio":"https://tatoeba.org/en/audio/download/88113","words":[{"g":"have","l":"haben"},{"g":"I"},null]},{"text":"Wer hatte recht?","en":"Who was right?","audio":"https://tatoeba.org/en/audio/download/389300","words":[{"g":"who"},{"g":"to have","l":"haben"},null]},{"text":"Du hast recht, denke ich.","en":"You're right, I think.","audio":"https://tatoeba.org/en/audio/download/757220","words":[{"g":"you"},{"g":"have","l":"haben"},null,{"g":"to think","l":"denken"},{"g":"I"}]},{"text":"Ich denke, ihr habt beide recht.","en":"I think you're both right.","audio":"https://tatoeba.org/en/audio/download/761408","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"you (pl.) / her"},{"g":"to have","l":"haben"},{"g":"both"},null]}]}