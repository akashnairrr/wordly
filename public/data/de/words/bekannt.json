{"id":"bekannt","lemma":"bekannt","pos":"adj","rank":709,"glosses":["known, familiar"],"ipa":"/bəˈkant/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/57/De-at-bekannt.ogg/De-at-bekannt.ogg.mp3","forms":{"comparative":"bekannter","superlative":"am bekanntesten"},"examples":[{"text":"Ist euch etwas darüber bekannt?","en":"Do you know something about this?","audio":"https://tatoeba.org/en/audio/download/593175","words":[{"g":"is","l":"sein"},{"g":"you (pl.)","l":"ihr"},{"g":"something"},{"g":"above"},null]},{"text":"Er ist im ganzen Land bekannt.","en":"He is known to the entire country.","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"in the"},{"g":"entire","l":"ganz"},{"g":"country"},null]},{"text":"Sein Name ist mir bekannt.","en":"His name is known to me.","words":[{"g":"to be"},{"g":"name"},{"g":"is","l":"sein"},{"g":"(to) me","l":"ich"},null]},{"text":"Ich bin nicht mit ihm bekannt.","en":"I am not acquainted with him.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"not"},{"g":"with"},{"g":"(to) him","l":"er"},null]},{"text":"Du kommst mir bekannt vor.","en":"You look familiar.","audio":"https://tatoeba.org/en/audio/download/392765","words":[{"g":"you"},{"g":"to come","l":"kommen"},{"g":"(to) me","l":"ich"},null,{"g":"in front of, ahead of"}]}]}