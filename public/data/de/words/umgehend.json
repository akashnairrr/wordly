{"id":"umgehend","lemma":"umgehend","pos":"adv","rank":4139,"glosses":["immediately"],"ipa":"/ˈʊmɡeːənt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a9/De-umgehend.ogg/De-umgehend.ogg.mp3","examples":[{"text":"Ich muss umgehend dorthin.","en":"I must go there immediately.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},null,{"g":"there , thither"}]},{"text":"Du wirst umgehend gebraucht.","en":"You're needed at once.","audio":"https://tatoeba.org/en/audio/download/756369","words":[{"g":"you"},{"g":"to become","l":"werden"},null,{"g":"secondhand"}]},{"text":"Ich bat umgehend um Entschuldigung.","en":"I apologized immediately.","words":[{"g":"I"},{"g":"to ask","l":"bitten"},null,{"g":"around / at"},{"g":"apology"}]},{"text":"Bitte antworten Sie umgehend!","en":"Please reply immediately.","words":[{"g":"please"},{"g":"to answer, to reply"},{"g":"she / they / you"},null]},{"text":"Du musst umgehend nach Hause gehen.","en":"You must go home at once.","words":[{"g":"you"},{"g":"to have to","l":"müssen"},null,null,null,{"g":"to go, to walk"}],"phrases":[[3,5,"home, homeward"]]}]}