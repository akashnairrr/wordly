{"id":"hauptmann","lemma":"Hauptmann","pos":"noun","rank":2005,"glosses":["captain (male [also female] or of unspecified sex; cf. Herr / Frau Hauptmann)"],"ipa":"/ˈhaʊp(t)ˌman/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/85/De-Hauptmann.ogg/De-Hauptmann.ogg.mp3","gender":"m","forms":{"genitive":"Hauptmannes","plural":"Hauptleute","feminine":"Hauptfrau"},"examples":[{"text":"Sie nennen mich Hauptmann.","en":"They call me captain.","words":[{"g":"she / they / you"},{"g":"to name"},{"g":"me","l":"ich"},null]},{"text":"Der Hauptmann hat den Befehl gegeben.","en":"The captain gave the order.","words":[{"g":"the"},null,{"g":"has","l":"haben"},{"g":"the","l":"der"},{"g":"command, order"},{"g":"given"}]},{"text":"Der Hauptmann behandelt seine Truppe gut.","en":"That captain handles his troops well.","words":[{"g":"the"},null,{"g":"treated"},{"g":"his","l":"seiner"},{"g":"troupe"},{"g":"good"}]},{"text":"Ein Hauptmann ist mehr als ein Sergeant.","en":"A captain is above a sergeant.","words":[{"g":"a"},null,{"g":"is","l":"sein"},{"g":"more"},{"g":"at the same moment"},{"g":"a"},null]},{"text":"Der Soldat grüßte den Hauptmann.","en":"The soldier saluted the captain.","words":[{"g":"the"},{"g":"soldier"},{"g":"to greet","l":"grüßen"},{"g":"the","l":"der"},null]}]}