{"id":"wiederholt","lemma":"wiederholt","pos":"adv","rank":3691,"glosses":["repeatedly"],"ipa":"/viːdɐˈhoːlt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d6/De-wiederholt.ogg/De-wiederholt.ogg.mp3","examples":[{"text":"Geschichte wiederholt sich.","en":"History repeats itself.","audio":"https://tatoeba.org/en/audio/download/754995","words":[{"g":"history"},null,{"g":"oneself"}]},{"text":"Es wiederholt sich zu oft.","en":"It happens too often.","words":[{"g":"it"},null,{"g":"oneself"},{"g":"to / too"},{"g":"often"}]},{"text":"Ich habe dich wiederholt darum gebeten.","en":"I've asked you repeatedly to do that.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"you","l":"du"},null,{"g":"around it, around that"},{"g":"to ask","l":"bitten"}]},{"text":"Hast du die Prüfung wiederholt?","en":"Did you retake the exam?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"the"},{"g":"an official test or…"},null]},{"text":"Ich habe Sie wiederholt gebeten, das zu lassen.","en":"I've asked you repeatedly not to do that.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"she / they / you"},null,{"g":"to ask","l":"bitten"},{"g":"the / that"},{"g":"to / too"},{"g":"to allow"}]}]}