{"id":"statue","lemma":"Statue","pos":"noun","rank":3861,"glosses":["statue"],"ipa":"/ˈʃtaːtuɐ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7e/De-Statue.ogg/De-Statue.ogg.mp3","gender":"f","forms":{"genitive":"Statue","plural":"Statuen"},"formAudio":{"Statuen":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q188_%28deu%29-Sebastian_Wallroth-Statuen.wav"},"examples":[{"text":"Die Statue hat keinen Kopf.","en":"The statue has no head.","audio":"https://tatoeba.org/en/audio/download/469827","words":[{"g":"the"},null,{"g":"has","l":"haben"},{"g":"no / not a","l":"kein"},{"g":"head"}]},{"text":"Es gibt Statuen im Park.","en":"There are statues in the park.","words":[null,null,null,{"g":"in the"},{"g":"park"}],"phrases":[[0,2,"there is, there are"]]},{"text":"Wir müssen diese Statue sehr vorsichtig bewegen.","en":"We must move this statue very carefully.","words":[{"g":"we"},{"g":"to have to"},{"g":"this one, this","l":"dieser"},null,{"g":"very"},{"g":"carefully"},{"g":"to move"}]},{"text":"Ich habe einige Statuen in meinem Garten.","en":"I have several statues in my garden.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"united","l":"einig"},null,{"g":"in"},{"g":"my","l":"mein"},{"g":"garden, yard"}]},{"text":"Diese Statue ist marmorn.","en":"This statue is marble.","words":[{"g":"this one, this","l":"dieser"},null,{"g":"is","l":"sein"},null]}]}