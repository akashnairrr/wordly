{"id":"dahin","lemma":"dahin","pos":"adv","rank":711,"glosses":["there (to or into that place; thither)","over, gone"],"ipa":"/daˈhɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/65/De-dahin.ogg/De-dahin.ogg.mp3","examples":[{"text":"Wie oft gehst du dahin?","en":"How often do you go there?","audio":"https://tatoeba.org/en/audio/download/760924","words":[{"g":"how"},{"g":"often"},{"g":"to go, to walk","l":"gehen"},{"g":"you"},null]},{"text":"Wie komme ich dahin?","en":"How do I get there?","audio":"https://tatoeba.org/en/audio/download/390222","words":[null,null,null,null],"phrases":[[0,3,"how do I get ..."]]},{"text":"Gehen Sie oft dahin?","en":"Do you go there often?","words":[{"g":"to go, to walk"},{"g":"she / they / you"},{"g":"often"},null]},{"text":"Ich kann nicht allein dahin zurück.","en":"I can't go back there alone.","audio":"https://tatoeba.org/en/audio/download/717932","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"not"},{"g":"alone"},null,{"g":"stand back!"}]},{"text":"Stelle es dahin.","en":"Put it there.","audio":"https://tatoeba.org/en/audio/download/77241","words":[{"g":"location, spot"},{"g":"it"},null]}]}