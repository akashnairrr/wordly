{"id":"unwohl","lemma":"unwohl","pos":"adj","rank":4812,"glosses":["unwell, indisposed, mildly sick","uncomfortable"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/41/De-unwohl.ogg/De-unwohl.ogg.mp3","forms":{"comparative":"unwohler","superlative":"am unwohlsten"},"examples":[{"text":"Ich fühle mich hier unwohl.","en":"I feel uneasy here.","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},{"g":"here"},null]},{"text":"Mir ist unwohl.","en":"I feel unwell.","words":[{"g":"(to) me","l":"ich"},{"g":"is","l":"sein"},null]},{"text":"Ich habe mich sehr unwohl gefühlt.","en":"I felt very uncomfortable.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"me","l":"ich"},{"g":"very"},null,{"g":"perceived"}]},{"text":"Er fühlte sich unwohl.","en":"He felt uneasy.","words":[{"g":"he / it"},{"g":"to feel","l":"fühlen"},{"g":"oneself"},null]},{"text":"Ich fühle mich in deiner Nähe unwohl.","en":"You're making me uncomfortable.","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},{"g":"in"},{"g":"yours, thine"},{"g":"nearness, closeness"},null]}]}