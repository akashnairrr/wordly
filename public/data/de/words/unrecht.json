{"id":"unrecht","lemma":"unrecht","pos":"adj","rank":1640,"glosses":["wrong, unethical"],"ipa":"/ˈʔʊnʁɛçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/De-unrecht.ogg/De-unrecht.ogg.mp3","forms":{"comparative":"unrechter","superlative":"am unrechtesten"},"examples":[{"text":"Ich denke, du hast unrecht.","en":"I think that you're wrong.","audio":"https://tatoeba.org/en/audio/download/760882","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"you"},{"g":"have","l":"haben"},null]},{"text":"Ich habe niemals Unrecht.","en":"I'm never wrong.","audio":"https://tatoeba.org/en/audio/download/177365","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"never"},null]},{"text":"Vielleicht hatte ich unrecht.","en":"Maybe I was wrong.","audio":"https://tatoeba.org/en/audio/download/392800","words":[{"g":"perhaps, maybe"},{"g":"to have","l":"haben"},{"g":"I"},null]},{"text":"Sie hat unrecht.","en":"She is wrong.","audio":"https://tatoeba.org/en/audio/download/151865","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},null]},{"text":"Ich hoffe er hat unrecht.","en":"I hope he's wrong.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},{"g":"he / it"},{"g":"has","l":"haben"},null]}]}