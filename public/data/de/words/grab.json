{"id":"grab","lemma":"Grab","pos":"noun","rank":1371,"glosses":["grave","tomb"],"ipa":"/ɡʁaːp/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/30/De-Grab.ogg/De-Grab.ogg.mp3","gender":"n","forms":{"genitive":"Grabes","plural":"Gräber"},"formAudio":{"Grabes":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q188_%28deu%29-Sebastian_Wallroth-Grabes.wav","Gräber":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q188_%28deu%29-Sebastian_Wallroth-Gr%C3%A4ber.wav"},"examples":[{"text":"Ich habe das Grab meines Vaters besucht.","en":"I visited my father's grave.","audio":"https://tatoeba.org/en/audio/download/790511","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"the / that"},null,{"g":"mine","l":"meiner"},{"g":"father","l":"Vater"},{"g":"to visit, to see","l":"besuchen"}]},{"text":"Es wurde ein Grab ausgehoben.","en":"They dug a grave.","audio":"https://tatoeba.org/en/audio/download/390205","words":[{"g":"it"},{"g":"to become","l":"werden"},{"g":"a"},null,{"g":"to excavate","l":"ausheben"}]},{"text":"Grab schneller.","en":"Dig faster.","audio":"https://tatoeba.org/en/audio/download/695099","words":[null,{"g":"quickly","l":"schnell"}]},{"text":"Grab niemals direkt nach unten!","en":"Never dig straight down.","words":[null,{"g":"never"},{"g":"directly"},null,null],"phrases":[[3,5,"down, downwards"]]},{"text":"Sie schaufelt sich ihr eigenes Grab.","en":"She's digging her own grave.","words":[{"g":"she / they / you"},{"g":"to shovel","l":"schaufeln"},{"g":"oneself"},{"g":"you (pl.) / her"},{"g":"own","l":"eigen"},null]}]}