{"id":"nirgends","lemma":"nirgends","pos":"adv","rank":2442,"glosses":["nowhere (in no place)","never (at no time)"],"ipa":"/ˈnɪʁɡn̩ts/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e6/De-nirgends.ogg/De-nirgends.ogg.mp3","examples":[{"text":"Ich kann nirgends hin.","en":"I've got nowhere to go.","audio":"https://tatoeba.org/en/audio/download/758958","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"gone , left, situated"}]},{"text":"Ich sehe sie nirgends.","en":"I don't see them anywhere.","audio":"https://tatoeba.org/en/audio/download/761239","words":[{"g":"I"},{"g":"to see","l":"sehen"},{"g":"she / they / you"},null]},{"text":"Wir können nirgends hin.","en":"We have nowhere we can go.","words":[{"g":"we"},{"g":"can, to be able to"},null,{"g":"gone , left, situated"}]},{"text":"Ich muss nirgends sein.","en":"I don't have anywhere I need to be.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},null,{"g":"to be"}]},{"text":"Der Schlüssel war nirgends zu finden.","en":"The key was nowhere to be found.","words":[{"g":"the"},{"g":"a key"},{"g":"was","l":"sein"},null,{"g":"to / too"},{"g":"to find"}]}]}