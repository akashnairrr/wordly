{"id":"halt","lemma":"halt","pos":"adv","rank":211,"glosses":["Indicating that something is generally known, or cannot be changed, or the like; often untranslatable; so, just, simply, indeed, well"],"ipa":"/halt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/29/De-halt.ogg/De-halt.ogg.mp3","examples":[{"text":"So ist er halt.","en":"That's the way he is.","audio":"https://tatoeba.org/en/audio/download/699066","words":[{"g":"so"},{"g":"is","l":"sein"},{"g":"he / it"},null]},{"text":"Halt deinen Mund!","en":"Shut your mouth.","audio":"https://tatoeba.org/en/audio/download/767497","words":[null,{"g":"thy, your .","l":"dein"},{"g":"mouth of a person"}]},{"text":"Halt mir einen Platz frei.","en":"Save me a seat.","audio":"https://tatoeba.org/en/audio/download/73794","words":[null,{"g":"(to) me","l":"ich"},{"g":"a","l":"ein"},{"g":"square, plaza, piazza"},{"g":"free"}]},{"text":"Was ist der nächste Halt?","en":"What is the next stop?","words":[{"g":"what"},{"g":"is","l":"sein"},{"g":"the"},{"g":"near","l":"nah"},null]},{"text":"Halt mal meine Tasche.","en":"Hold my bag.","audio":"https://tatoeba.org/en/audio/download/695408","words":[null,{"g":"just / once"},{"g":"my","l":"mein"},{"g":"bag"}]}]}