{"id":"mittag","lemma":"Mittag","pos":"noun","rank":1723,"glosses":["noon, midday, late morning, early afternoon (time from about 11 a.m. to 2 p.m)"],"ipa":"/ˈmɪtaːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/71/De-Mittag.ogg/De-Mittag.ogg.mp3","gender":"m","forms":{"genitive":"Mittags","plural":"Mittage"},"examples":[{"text":"Er kommt mittags.","en":"He comes at noon.","audio":"https://tatoeba.org/en/audio/download/42186","words":[{"g":"he / it"},{"g":"to come","l":"kommen"},null]},{"text":"Es war beinahe Mittag.","en":"It was nearly noon.","audio":"https://tatoeba.org/en/audio/download/394116","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"almost"},null]},{"text":"Kann ich hier zu Mittag essen?","en":"Can I eat my lunch here?","words":[{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"here"},{"g":"to / too"},null,{"g":"to eat"}]},{"text":"Ich warte bis mittags.","en":"I'll wait till noon.","words":[{"g":"I"},{"g":"to wait","l":"warten"},{"g":"until, to, through"},null]},{"text":"Was möchten Sie zu Mittag essen?","en":"What do you like to eat for lunch?","words":[{"g":"what"},{"g":"to like","l":"mögen"},{"g":"she / they / you"},{"g":"to / too"},null,{"g":"to eat"}]}]}