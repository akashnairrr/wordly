{"id":"gerne","lemma":"gerne","pos":"intj","rank":277,"glosses":["don't mention it, not at all, you're welcome"],"ipa":"/ˈɡɛrnə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/De-at-gerne.ogg/De-at-gerne.ogg.mp3","examples":[{"text":"Bin ich hier noch gerne gesehen?","en":"Am I still welcome here?","audio":"https://tatoeba.org/en/audio/download/760313","words":[{"g":"am","l":"sein"},{"g":"I"},{"g":"here"},{"g":"still / yet"},null,{"g":"to see","l":"sehen"}]},{"text":"Ich gehe gerne laufen.","en":"I like to walk.","audio":"https://tatoeba.org/en/audio/download/767487","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null,{"g":"to walk"}]},{"text":"Ich komme gerne hierher.","en":"I like to come here.","audio":"https://tatoeba.org/en/audio/download/746093","words":[{"g":"I"},{"g":"to come","l":"kommen"},null,{"g":"to here, here , hither"}]},{"text":"Trinken Sie gerne Kaffee?","en":"Do you like coffee?","audio":"https://tatoeba.org/en/audio/download/390832","words":[{"g":"to drink by mouth)"},{"g":"she / they / you"},null,{"g":"coffee"}]},{"text":"Machst du das gerne?","en":"Do you like doing that?","audio":"https://tatoeba.org/en/audio/download/757255","words":[{"g":"to make","l":"machen"},{"g":"you"},{"g":"the / that"},null]}]}