{"id":"linken","lemma":"linken","pos":"verb","rank":2004,"glosses":["to deceive"],"ipa":"/ˈlɪŋkən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f3/De-linken2.ogg/De-linken2.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"linke","1p":"linken","2s":"linkst","2p":"linkt","3s":"linkt","3p":"linken"},"preterite":{"1s":"linkte","1p":"linkten","2s":"linktest","2p":"linktet","3s":"linkte","3p":"linkten"},"perfect":{"1s":"habe gelinkt","1p":"haben gelinkt","2s":"hast gelinkt","2p":"habt gelinkt","3s":"hat gelinkt","3p":"haben gelinkt"},"future":{"1s":"werde linken","1p":"werden linken","2s":"wirst linken","2p":"werdet linken","3s":"wird linken","3p":"werden linken"}},"imperative":{"affirmative":{"2s":"link","2p":"linkt"}},"subjunctive":{"conditional":{"1s":"würde linken","1p":"würden linken","2s":"würdest linken","2p":"würdet linken","3s":"würde linken","3p":"würden linken"}}},"nonFinite":{"participle":"gelinkt"},"examples":[{"text":"Sie schreibt mit der linken Hand.","en":"She writes with her left hand.","words":[{"g":"she / they / you"},{"g":"to write, to write out","l":"schreiben"},{"g":"with"},{"g":"the"},null,{"g":"hand"}]},{"text":"Ich schicke dir den Link.","en":"I'll send you the link.","words":[{"g":"I"},{"g":"to send, to dispatch","l":"schicken"},{"g":"(to) you","l":"du"},{"g":"the","l":"der"},null]},{"text":"Es ist auf der linken Seite der Straße.","en":"It is on the left side of the street.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"on"},{"g":"the"},null,{"g":"side"},{"g":"the"},{"g":"street"}]},{"text":"Was hast du da in der linken Hand?","en":"What's that you have in your left hand?","words":[{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},{"g":"there"},{"g":"in"},{"g":"the"},null,{"g":"hand"}]},{"text":"Ich schicke Ihnen den Link.","en":"I'll send you the link.","words":[{"g":"I"},{"g":"to send, to dispatch","l":"schicken"},{"g":"(to) them","l":"sie"},{"g":"the","l":"der"},null]}]}