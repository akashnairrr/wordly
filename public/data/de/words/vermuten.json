{"id":"vermuten","lemma":"vermuten","pos":"verb","rank":1767,"glosses":["to assume, suppose, presume, suspect, (US) guess","to suppose someone to be"],"ipa":"/fɛɐ̯ˈmuːtən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e1/De-vermuten2.ogg/De-vermuten2.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"vermute","1p":"vermuten","2s":"vermutest","2p":"vermutet","3s":"vermutet","3p":"vermuten"},"preterite":{"1s":"vermutete","1p":"vermuteten","2s":"vermutetest","2p":"vermutetet","3s":"vermutete","3p":"vermuteten"},"perfect":{"1s":"habe vermutet","1p":"haben vermutet","2s":"hast vermutet","2p":"habt vermutet","3s":"hat vermutet","3p":"haben vermutet"},"future":{"1s":"werde vermuten","1p":"werden vermuten","2s":"wirst vermuten","2p":"werdet vermuten","3s":"wird vermuten","3p":"werden vermuten"}},"imperative":{"affirmative":{"2s":"vermut","2p":"vermutet"}},"subjunctive":{"conditional":{"1s":"würde vermuten","1p":"würden vermuten","2s":"würdest vermuten","2p":"würdet vermuten","3s":"würde vermuten","3p":"würden vermuten"}}},"nonFinite":{"participle":"vermutet"},"examples":[{"text":"Ich vermute, dass Sie Recht haben.","en":"I guess you're right.","audio":"https://tatoeba.org/en/audio/download/593118","words":[{"g":"I"},null,{"g":"that"},{"g":"she / they / you"},null,null],"phrases":[[4,6,"to be right"]]},{"text":"Ich vermute, er wird zu spät sein.","en":"I suppose he will be late.","audio":"https://tatoeba.org/en/audio/download/760868","words":[{"g":"I"},null,{"g":"he / it"},{"g":"to become","l":"werden"},{"g":"to / too"},{"g":"late"},{"g":"to be"}]},{"text":"Ich vermute das nur.","en":"I'm just guessing.","audio":"https://tatoeba.org/en/audio/download/390657","words":[{"g":"I"},null,{"g":"the / that"},{"g":"only"}]},{"text":"Ich vermute, es tut nichts zur Sache.","en":"I guess it doesn't matter.","audio":"https://tatoeba.org/en/audio/download/761533","words":[{"g":"I"},null,{"g":"it"},{"g":"to do","l":"tun"},{"g":"nothing"},{"g":"to the"},{"g":"mat