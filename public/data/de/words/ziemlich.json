{"id":"ziemlich","lemma":"ziemlich","pos":"adv","rank":293,"glosses":["pretty, quite, rather, fairly, kind of","pretty much, quite a bit"],"ipa":"/ˈtsiːmlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b9/De-at-ziemlich.ogg/De-at-ziemlich.ogg.mp3","examples":[{"text":"Ich war ziemlich betrunken.","en":"I was pretty drunk.","audio":"https://tatoeba.org/en/audio/download/698520","words":[{"g":"I"},{"g":"was","l":"sein"},null,{"g":"drunk, inebriated"}]},{"text":"Das Auto ist ziemlich neu.","en":"That car is quite new.","audio":"https://tatoeba.org/en/audio/download/566472","words":[{"g":"the / that"},{"g":"car"},{"g":"is","l":"sein"},null,{"g":"new"}]},{"text":"Er arbeitet ziemlich hart.","en":"He works very hard.","audio":"https://tatoeba.org/en/audio/download/394129","words":[{"g":"he / it"},{"g":"to work","l":"arbeiten"},null,{"g":"hard"}]},{"text":"Es war ziemlich lustig.","en":"It was quite funny.","audio":"https://tatoeba.org/en/audio/download/392587","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"funny, humorous"}]},{"text":"Das war ziemlich gut.","en":"That was pretty good.","words":[{"g":"the / that"},{"g":"was","l":"sein"},null,{"g":"good"}]}]}