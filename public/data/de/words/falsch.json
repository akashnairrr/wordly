{"id":"falsch","lemma":"falsch","pos":"adj","rank":411,"glosses":["false, unfactual, untrue","wrong (incorrect)","wrong (disadvantageous)"],"ipa":"/falʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f2/De-falsch.ogg/De-falsch.ogg.mp3","forms":{"superlative":"am falschesten"},"examples":[{"text":"Warum ist das falsch?","en":"Why is that wrong?","words":[{"g":"why"},{"g":"is","l":"sein"},{"g":"the / that"},null]},{"text":"Diese Übersetzung ist falsch.","en":"This translation is wrong.","audio":"https://tatoeba.org/en/audio/download/695045","words":[{"g":"this one, this","l":"dieser"},{"g":"translation"},{"g":"is","l":"sein"},null]},{"text":"Die Uhr geht falsch.","en":"The clock is wrong.","audio":"https://tatoeba.org/en/audio/download/44127","words":[{"g":"the"},{"g":"hours, o'clock"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Ich denke, es war falsch.","en":"I think it was wrong.","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"it"},{"g":"was","l":"sein"},null]},{"text":"Ich weiß, dass dies falsch ist.","en":"I know that this is wrong.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"that"},null,null,{"g":"is","l":"sein"}]}]}