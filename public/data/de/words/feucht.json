{"id":"feucht","lemma":"feucht","pos":"adj","rank":3931,"glosses":["wet, humid, moist, soggy, dank","wet, moist (sexually aroused and thus having the vulva moistened with vaginal secretions)"],"ipa":"/fɔʏ̯çt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7d/De-feucht.ogg/De-feucht.ogg.mp3","forms":{"comparative":"feuchter","superlative":"am feuchtesten"},"examples":[{"text":"Der Boden ist immer noch feucht.","en":"The ground is still wet.","audio":"https://tatoeba.org/en/audio/download/566855","words":[{"g":"the"},{"g":"ground, soil"},{"g":"is","l":"sein"},null,null,null],"phrases":[[3,5,"still"]]},{"text":"Die Luft ist feucht.","en":"The air is damp.","words":[{"g":"the"},{"g":"air, atmosphere"},{"g":"is","l":"sein"},null]},{"text":"Es ist feucht und warm.","en":"It's moist and warm.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"and"},{"g":"warm"}]},{"text":"Meine Haare sind noch feucht.","en":"My hair is still damp.","words":[{"g":"my","l":"mein"},{"g":"hair","l":"Haar"},{"g":"are","l":"sein"},{"g":"still / yet"},null]},{"text":"Im Sommer wird es hier ziemlich feucht.","en":"It gets very humid here in the summer.","words":[{"g":"in the"},{"g":"summer"},{"g":"to become","l":"werden"},{"g":"it"},{"g":"here"},{"g":"pretty"},null]}]}