{"id":"anscheinend","lemma":"anscheinend","pos":"adv","rank":1138,"glosses":["apparently"],"ipa":"/ˈanˌʃaɪnənt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8d/De-anscheinend.ogg/De-anscheinend.ogg.mp3","examples":[{"text":"Anscheinend bin ich zu alt.","en":"I'm apparently too old.","words":[null,{"g":"am","l":"sein"},{"g":"I"},{"g":"to / too"},{"g":"old"}]},{"text":"Anscheinend haben wir ein Problem.","en":"We seem to have a problem.","words":[null,{"g":"have"},{"g":"we"},{"g":"a"},{"g":"problem"}]},{"text":"Anscheinend hätte ich das tun sollen.","en":"I apparently should've done that.","words":[null,{"g":"to have","l":"haben"},{"g":"I"},{"g":"the / that"},{"g":"to do"},{"g":"should"}]},{"text":"Sie weiß anscheinend etwas Wichtiges.","en":"She seems to know something important.","words":[{"g":"she / they / you"},{"g":"to know","l":"wissen"},null,{"g":"something"},{"g":"important","l":"wichtig"}]},{"text":"Ich habe anscheinend die falsche Nummer.","en":"I seem to have the wrong number.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"the"},{"g":"false","l":"falsch"},{"g":"number"}]}]}