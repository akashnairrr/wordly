{"id":"auf","lemma":"auf","pos":"prep","rank":20,"glosses":["[with dative] on, upon (positioned at the top of)","[with accusative] on, onto, up (moving to the top of)","[with accusative] on (indicating responsibility)"],"ipa":"/aʊ̯f/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1c/De-auf.ogg/De-auf.ogg.mp3","examples":[{"text":"Warum bist du auf diesem Schiff?","en":"Why are you on this ship?","audio":"https://tatoeba.org/en/audio/download/759873","words":[{"g":"why"},{"g":"are","l":"sein"},{"g":"you"},null,{"g":"this one, this","l":"dieser"},{"g":"ship"}]},{"text":"Ist die Tür auf?","en":"Is the door open?","audio":"https://tatoeba.org/en/audio/download/391016","words":[{"g":"is","l":"sein"},{"g":"the"},{"g":"door"},null]},{"text":"Zeigen Sie auf mich?","en":"Are you pointing at me?","audio":"https://tatoeba.org/en/audio/download/755504","words":[{"g":"to point"},{"g":"she / they / you"},null,{"g":"me","l":"ich"}]},{"text":"Wir zählen auf dich.","en":"We count on you.","audio":"https://tatoeba.org/en/audio/download/80129","words":[{"g":"we"},{"g":"to count"},null,{"g":"you","l":"du"}]},{"text":"Ich kann auf dich warten.","en":"I can wait for you.","audio":"https://tatoeba.org/en/audio/download/394290","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"you","l":"du"},{"g":"to wait"}]}]}