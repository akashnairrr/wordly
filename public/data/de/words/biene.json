{"id":"biene","lemma":"Biene","pos":"noun","rank":3677,"glosses":["bee"],"ipa":"/ˈbiːnə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/De-Biene.ogg/De-Biene.ogg.mp3","gender":"f","forms":{"genitive":"Biene","plural":"Bienen"},"examples":[{"text":"Hast du Angst vor Bienen?","en":"Are you afraid of bees?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"fear"},{"g":"in front of, ahead of"},null]},{"text":"Eine Biene flog aus dem Fenster.","en":"A bee flew out of the window.","audio":"https://tatoeba.org/en/audio/download/789424","words":[{"g":"a"},null,{"g":"to fly","l":"fliegen"},{"g":"out of / from"},{"g":"(to) the","l":"der"},{"g":"window"}]},{"text":"Bienen machen Honig.","en":"Bees make honey.","audio":"https://tatoeba.org/en/audio/download/247007","words":[null,{"g":"to make"},{"g":"honey"}]},{"text":"Eine Biene summt herum.","en":"A bee is buzzing around.","words":[{"g":"a"},null,{"g":"to buzz","l":"summen"},{"g":"about, around."}]},{"text":"Blumen ziehen Bienen an.","en":"Flowers attract bees.","words":[{"g":"flower (small","l":"Blume"},{"g":"to pull"},null,{"g":"at / on"}]}]}