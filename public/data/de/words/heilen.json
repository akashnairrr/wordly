{"id":"heilen","lemma":"heilen","pos":"verb","rank":1828,"glosses":["to heal (an injury, sickness, etc.)","to become healed"],"ipa":"/ˈhaɪ̯lən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/De-heilen.ogg/De-heilen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"heile","1p":"heilen","2s":"heilst","2p":"heilt","3s":"heilt","3p":"heilen"},"preterite":{"1s":"heilte","1p":"heilten","2s":"heiltest","2p":"heiltet","3s":"heilte","3p":"heilten"},"perfect":{"1s":"habe geheilt","1p":"haben geheilt","2s":"hast geheilt","2p":"habt geheilt","3s":"hat geheilt","3p":"haben geheilt"},"future":{"1s":"werde heilen","1p":"werden heilen","2s":"wirst heilen","2p":"werdet heilen","3s":"wird heilen","3p":"werden heilen"}},"imperative":{"affirmative":{"2s":"heil","2p":"heilt"}},"subjunctive":{"conditional":{"1s":"würde heilen","1p":"würden heilen","2s":"würdest heilen","2p":"würdet heilen","3s":"würde heilen","3p":"würden heilen"}}},"nonFinite":{"participle":"geheilt"},"formAudio":{"heil":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q188_%28deu%29-Mathieu_Kappler-Heil.wav"},"examples":[{"text":"Er hat meine Krankheit geheilt.","en":"He cured my illness.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"my","l":"mein"},{"g":"sickness, illness"},null]},{"text":"Ich kann kein gebrochenes Herz heilen.","en":"I can't mend a broken heart.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"no / not a"},{"g":"broken","l":"gebrochen"},{"g":"heart"},null]},{"text":"Die Wunde heilt.","en":"The wound is healing.","words":[{"g":"the"},{"g":"sore, wound"},null]},{"text":"Ich bin geheilt.","en":"I'm cured.","words":[{"g":"I"},{"g":"am","l":"sein"},null]},{"text":"Man sagt, Zeit heile alle Wunden.","en":"It is said that time heals all the wounds.","words":[{"g":"one"},{"g":"to say (to pronounce","l":"sagen"},{"g":"time"},null,{"g":"all, everyone"},{"g":"sore, wound","l":"Wunde"}]}]}