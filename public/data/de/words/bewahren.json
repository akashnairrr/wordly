{"id":"bewahren","lemma":"bewahren","pos":"verb","rank":1922,"glosses":["to keep, to preserve (to maintain the condition of)"],"ipa":"/bəˈvaːʁən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f5/De-bewahren2.ogg/De-bewahren2.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"bewahre","1p":"bewahren","2s":"bewahrst","2p":"bewahrt","3s":"bewahrt","3p":"bewahren"},"preterite":{"1s":"bewahrte","1p":"bewahrten","2s":"bewahrtest","2p":"bewahrtet","3s":"bewahrte","3p":"bewahrten"},"perfect":{"1s":"habe bewahrt","1p":"haben bewahrt","2s":"hast bewahrt","2p":"habt bewahrt","3s":"hat bewahrt","3p":"haben bewahrt"},"future":{"1s":"werde bewahren","1p":"werden bewahren","2s":"wirst bewahren","2p":"werdet bewahren","3s":"wird bewahren","3p":"werden bewahren"}},"imperative":{"affirmative":{"2s":"bewahr","2p":"bewahrt"}},"subjunctive":{"conditional":{"1s":"würde bewahren","1p":"würden bewahren","2s":"würdest bewahren","2p":"würdet bewahren","3s":"würde bewahren","3p":"würden bewahren"}}},"nonFinite":{"participle":"bewahrt"},"examples":[{"text":"Kannst du ein Geheimnis bewahren?","en":"Can you keep a secret?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"a"},{"g":"secret"},null]},{"text":"Bewahre das Geheimnis!","en":"Keep the secret to yourself.","words":[null,{"g":"the / that"},{"g":"secret"}]},{"text":"Ich werde dein Geheimnis bewahren.","en":"I'll keep your secret.","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"your"},{"g":"secret"},null]},{"text":"Er hat mich vor Gefahren bewahrt.","en":"He saved me from danger.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"me","l":"ich"},{"g":"in front of, ahead of"},{"g":"danger","l":"Gefahr"},null]},{"text":"Er bewahrte mich vor einem großen Fehler.","en":"He kept me from making a big mistake.","words":[{"g":"he / it"},null,{"g":"me","l":"ich"},{"g":"in front of, ahead of"},{"g":"(to) a","l":"ein"},{"g":"big","l":"groß"},{"g":"fault, error, mistake"}]}]}