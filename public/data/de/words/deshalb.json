{"id":"deshalb","lemma":"deshalb","pos":"adv","rank":340,"glosses":["therefore; for that (reason), because of that"],"ipa":"/ˈdɛshalp/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/42/De-deshalb.ogg/De-deshalb.ogg.mp3","examples":[{"text":"Deshalb wollen wir dich.","en":"That's why we want you.","audio":"https://tatoeba.org/en/audio/download/759221","words":[null,{"g":"to want"},{"g":"we"},{"g":"you","l":"du"}]},{"text":"Bin ich deshalb hier?","en":"Is that why I'm here?","audio":"https://tatoeba.org/en/audio/download/566071","words":[{"g":"am","l":"sein"},{"g":"I"},null,{"g":"here"}]},{"text":"Hast du deshalb angerufen?","en":"Is that why you called?","audio":"https://tatoeba.org/en/audio/download/758744","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"to call, to ring","l":"anrufen"}]},{"text":"Bist du deshalb hier?","en":"Is that why you're here?","audio":"https://tatoeba.org/en/audio/download/565987","words":[{"g":"are","l":"sein"},{"g":"you"},null,{"g":"here"}]},{"text":"Deshalb muss ich das tun.","en":"That's why I have to do this.","words":[null,{"g":"to have to","l":"müssen"},{"g":"I"},{"g":"the / that"},{"g":"to do"}]}]}