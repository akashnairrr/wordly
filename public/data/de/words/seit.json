{"id":"seit","lemma":"seit","pos":"prep","rank":155,"glosses":["since","for (some past period of time)"],"ipa":"/zaɪ̯t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/af/De-seit.ogg/De-seit.ogg.mp3","examples":[{"text":"Ich kenne dich seit Jahren.","en":"I've known you for years.","audio":"https://tatoeba.org/en/audio/download/711766","words":[{"g":"I"},{"g":"to know","l":"kennen"},{"g":"you","l":"du"},null,{"g":"year","l":"Jahr"}]},{"text":"Seit wann ist das so wichtig?","en":"Since when is that so important?","words":[null,{"g":"when"},{"g":"is","l":"sein"},{"g":"the / that"},{"g":"so"},{"g":"important"}]},{"text":"Ich bin seit Montag krank.","en":"I've been sick since Monday.","audio":"https://tatoeba.org/en/audio/download/695082","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"Monday"},{"g":"ill, sick"}]},{"text":"Wir kennen uns seit drei Jahren.","en":"We've known each other for three years.","audio":"https://tatoeba.org/en/audio/download/593234","words":[{"g":"we"},{"g":"to know"},{"g":"us","l":"wir"},null,{"g":"three (numerical value…"},{"g":"year","l":"Jahr"}]},{"text":"Ich warte seit Stunden.","en":"I've been waiting for hours.","audio":"https://tatoeba.org/en/audio/download/775","words":[{"g":"I"},{"g":"to wait","l":"warten"},null,{"g":"to defer (due date"}]}]}