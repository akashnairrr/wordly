{"id":"beantwortet","lemma":"beantwortet","pos":"adj","rank":3083,"glosses":["answered"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/De-beantwortet.ogg/De-beantwortet.ogg.mp3","examples":[{"text":"Habe ich deine Frage beantwortet?","en":"Have I answered your question?","words":[{"g":"have","l":"haben"},{"g":"I"},{"g":"your","l":"dein"},{"g":"question"},null]},{"text":"Ist eure Frage damit beantwortet?","en":"Did that answer your question?","words":[{"g":"is","l":"sein"},{"g":"your","l":"euer"},{"g":"question"},{"g":"so that, in order that"},null]},{"text":"Warum beantwortet ihr meine Frage nicht?","en":"Why don't you answer my question?","words":[{"g":"why"},null,{"g":"you (pl.) / her"},{"g":"my","l":"mein"},{"g":"question"},{"g":"not"}]},{"text":"Nur du hast die Frage beantwortet.","en":"Only you answered the question.","words":[{"g":"only"},{"g":"you"},{"g":"have","l":"haben"},{"g":"the"},{"g":"question"},null]},{"text":"Ihr habt die Frage nie beantwortet.","en":"You never answered the question.","words":[{"g":"you (pl.) / her"},{"g":"to have","l":"haben"},{"g":"the"},{"g":"question"},{"g":"never, never at all"},null]}]}