{"id":"indianer","lemma":"Indianer","pos":"noun","rank":2086,"glosses":["Indian, American Indian, Native American","the constellation Indus"],"ipa":"/ɪnˈdi̯aːnɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/67/De-Indianer.ogg/De-Indianer.ogg.mp3","gender":"m","forms":{"genitive":"Indianers","plural":"Indianer","feminine":"Indianerin"},"examples":[{"text":"Die Indianer hatten Hunger.","en":"The Indians were hungry.","words":[{"g":"the"},null,{"g":"to have","l":"haben"},{"g":"hunger"}]},{"text":"Am Anfang waren die Indianer freundlich.","en":"At first, the Indians were friendly.","words":[{"g":"at the / on the"},{"g":"start"},{"g":"to be","l":"sein"},{"g":"the"},null,{"g":"friendly, benign"}]},{"text":"Das Geschenk freute die Indianer sehr.","en":"The gift delighted the Indians very much.","words":[{"g":"the / that"},{"g":"present, gift"},{"g":"to gladden","l":"freuen"},{"g":"the"},null,{"g":"very"}]},{"text":"Tom ist ein Indianer.","en":"Tom is a Native American.","words":[null,{"g":"is","l":"sein"},{"g":"a"},null]},{"text":"Die Indianer skalpierten ihre Feinde.","en":"The Native Americans scalped their enemies.","words":[{"g":"the"},null,null,{"g":"her","l":"ihr"},{"g":"enemy, fiend, foe","l":"Feind"}]}]}