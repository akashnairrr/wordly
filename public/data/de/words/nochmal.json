{"id":"nochmal","lemma":"nochmal","pos":"adv","rank":535,"glosses":["once again","again, one more time"],"ipa":"/ˈnɔχmaːl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/80/De-nochmal.ogg/De-nochmal.ogg.mp3","examples":[{"text":"Wer sind Sie nochmal?","en":"Who are you again?","audio":"https://tatoeba.org/en/audio/download/699174","words":[{"g":"who"},{"g":"are","l":"sein"},{"g":"she / they / you"},null]},{"text":"Sag das nochmal.","en":"Say that again.","audio":"https://tatoeba.org/en/audio/download/566238","words":[{"g":"to say (to pronounce","l":"sagen"},{"g":"the / that"},null]},{"text":"Kann ich es nochmal machen?","en":"Can I do it again?","audio":"https://tatoeba.org/en/audio/download/390677","words":[{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"it"},null,{"g":"to make"}]},{"text":"Darf ich das nochmal sehen?","en":"May I see that again?","audio":"https://tatoeba.org/en/audio/download/695708","words":[{"g":"to be allowed","l":"dürfen"},{"g":"I"},{"g":"the / that"},null,{"g":"to see"}]},{"text":"Okay, nochmal Danke.","en":"OK, thanks again.","words":[{"g":"OK"},null,{"g":"thanks, thank you"}]}]}