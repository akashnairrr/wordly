{"id":"hinein","lemma":"hinein","pos":"adv","rank":1312,"glosses":["in (away from the speaker)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/32/De-hinein.ogg/De-hinein.ogg.mp3","examples":[{"text":"Sie können nicht hinein.","en":"They can't get in.","audio":"https://tatoeba.org/en/audio/download/390690","words":[{"g":"she / they / you"},{"g":"can, to be able to"},{"g":"not"},null]},{"text":"Ich kann da nicht wieder hinein.","en":"I can't go back in there.","audio":"https://tatoeba.org/en/audio/download/701000","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"there"},{"g":"not"},{"g":"again"},null]},{"text":"Niemand darf da hinein.","en":"No one is allowed in there.","words":[{"g":"nobody, no one"},{"g":"to be allowed","l":"dürfen"},{"g":"there"},null]},{"text":"Gehst du hinein?","en":"Are you going in?","words":[{"g":"to go, to walk","l":"gehen"},{"g":"you"},null]},{"text":"Ihr könnt nicht hinein.","en":"You can't go in.","words":[{"g":"you (pl.) / her"},{"g":"can, to be able to","l":"können"},{"g":"not"},null]}]}