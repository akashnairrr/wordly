{"id":"um","lemma":"um","pos":"prep","rank":48,"glosses":["about","around","at, by (when relating to time)"],"ipa":"/ʊm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/05/De-um.ogg/De-um.ogg.mp3","examples":[{"text":"Um drei kann ich kommen.","en":"I can come at three.","audio":"https://tatoeba.org/en/audio/download/700333","words":[null,{"g":"three (numerical value…"},{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"to come"}]},{"text":"Ich muss um sechs auf sein.","en":"I have to be up at six.","audio":"https://tatoeba.org/en/audio/download/756974","words":[{"g":"I"},{"g":"to have to","l":"müssen"},null,{"g":"six (numerical value…"},{"g":"on"},{"g":"to be"}]},{"text":"Um welche Zeit kannst du kommen?","en":"What time can you come?","audio":"https://tatoeba.org/en/audio/download/759674","words":[null,{"g":"some"},{"g":"time"},{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"to come"}]},{"text":"Sie wird um fünf zurück sein.","en":"She will be back at five.","audio":"https://tatoeba.org/en/audio/download/44759","words":[{"g":"she / they / you"},{"g":"to become","l":"werden"},null,{"g":"five (numerical value…"},{"g":"stand back!"},{"g":"to be"}]},{"text":"Ich gehe um vier.","en":"I am leaving at four.","audio":"https://tatoeba.org/en/audio/download/74384","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null,{"g":"four (numerical value…"}]}]}