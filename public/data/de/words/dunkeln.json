{"id":"dunkeln","lemma":"dunkeln","pos":"verb","rank":2361,"glosses":["to darken"],"ipa":"/ˈdʊŋkl̩n/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3a/De-dunkeln.ogg/De-dunkeln.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"dunkle","1p":"dunkeln","2s":"dunkelst","2p":"dunkelt","3s":"dunkelt","3p":"dunkeln"},"preterite":{"1s":"dunkelte","1p":"dunkelten","2s":"dunkeltest","2p":"dunkeltet","3s":"dunkelte","3p":"dunkelten"},"perfect":{"1s":"habe gedunkelt","1p":"haben gedunkelt","2s":"hast gedunkelt","2p":"habt gedunkelt","3s":"hat gedunkelt","3p":"haben gedunkelt"},"future":{"1s":"werde dunkeln","1p":"werden dunkeln","2s":"wirst dunkeln","2p":"werdet dunkeln","3s":"wird dunkeln","3p":"werden dunkeln"}},"imperative":{"affirmative":{"2s":"dunkle","2p":"dunkelt"}},"subjunctive":{"conditional":{"1s":"würde dunkeln","1p":"würden dunkeln","2s":"würdest dunkeln","2p":"würdet dunkeln","3s":"würde dunkeln","3p":"würden dunkeln"}}},"nonFinite":{"participle":"gedunkelt"},"examples":[{"text":"Ein Hund kann im Dunkeln sehen.","en":"A dog can see in the dark.","audio":"https://tatoeba.org/en/audio/download/761427","words":[{"g":"a"},{"g":"dog, hound"},{"g":"can, to be able to","l":"können"},{"g":"in the"},null,{"g":"to see"}]},{"text":"Es war eine sehr dunkle Nacht.","en":"It was a very dark night.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"a"},{"g":"very"},null,{"g":"night"}]},{"text":"Warum sitzt ihr hier im Dunkeln?","en":"Why are you sitting here in the dark?","audio":"https://tatoeba.org/en/audio/download/593289","words":[{"g":"why"},{"g":"to sit","l":"sitzen"},{"g":"you (pl.) / her"},{"g":"here"},{"g":"in the"},null]},{"text":"Ich habe dunkle Haare.","en":"I have dark hair.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"hair","l":"Haar"}]},{"text":"Sie waren im Dunkeln allein.","en":"They were alone in the dark.","words":[{"g":"she / they / you"},{"g":"to be","l":"sein"},{"g":"in the"},null,{"g":"alone"}]}]}