{"id":"bein","lemma":"Bein","pos":"noun","rank":982,"glosses":["leg of a person, animal, or object"],"ipa":"/baɪ̯n/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/51/De-Bein.ogg/De-Bein.ogg.mp3","gender":"n","forms":{"genitive":"Beines","plural":"Beine"},"examples":[{"text":"Ein Hund hat vier Beine.","en":"A dog has four legs.","words":[{"g":"a"},{"g":"dog, hound"},{"g":"has","l":"haben"},{"g":"four (numerical value…"},null]},{"text":"Du hast dir das Bein gebrochen.","en":"You broke your leg.","audio":"https://tatoeba.org/en/audio/download/746445","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"(to) you","l":"du"},{"g":"the / that"},null,{"g":"broken"}]},{"text":"Meine Schwester hat lange Beine.","en":"My sister has long legs.","words":[{"g":"my","l":"mein"},{"g":"sister"},{"g":"has","l":"haben"},{"g":"long, for a long time"},null]},{"text":"Wie geht es deinem Bein?","en":"How's your leg?","words":[null,null,null,{"g":"thy, your .","l":"dein"},null],"phrases":[[0,3,"how are you"]]},{"text":"Kannst du deine Beine noch bewegen?","en":"Can you still move your legs?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"your","l":"dein"},null,{"g":"still / yet"},{"g":"to move"}]}]}