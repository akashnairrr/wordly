{"id":"weihnachtsmann","lemma":"Weihnachtsmann","pos":"noun","rank":2328,"glosses":["Santa Claus, Father Christmas","a fool, a stupid, naive and/or ridiculous person"],"ipa":"/ˈvaɪ̯.naxtsˌman/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1e/De-Weihnachtsmann.ogg/De-Weihnachtsmann.ogg.mp3","gender":"m","forms":{"genitive":"Weihnachtsmannes","plural":"Weihnachtsmänner"},"formAudio":{"Weihnachtsmannes":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q188_%28deu%29-Sebastian_Wallroth-Weihnachtsmannes.wav","Weihnachtsmänner":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q188_%28deu%29-Sebastian_Wallroth-Weihnachtsm%C3%A4nner.wav"},"examples":[{"text":"Der Weihnachtsmann stand im Garten.","en":"Santa Claus was standing in the garden.","words":[{"g":"the"},null,{"g":"to stand","l":"stehen"},{"g":"in the"},{"g":"garden, yard"}]},{"text":"Wie viele Weihnachtsmänner gibt es?","en":"How many Santas are there?","audio":"https://tatoeba.org/en/audio/download/761304","words":[{"g":"how"},{"g":"much, a lot","l":"viel"},null,{"g":"to give","l":"geben"},{"g":"it"}]},{"text":"Kommt der Weihnachtsmann dieses Jahr?","en":"Is Santa coming this year?","words":[{"g":"to come","l":"kommen"},{"g":"the"},null,{"g":"this one, this","l":"dieser"},{"g":"year"}]},{"text":"Glaubst du an den Weihnachtsmann?","en":"Do you believe in Santa Claus?","words":[{"g":"to believe something","l":"glauben"},{"g":"you"},{"g":"at / on"},{"g":"the","l":"der"},null]},{"text":"Mein Sohn glaubt an den Weihnachtsmann.","en":"My son believes in Santa Claus.","words":[{"g":"my"},{"g":"son"},{"g":"to believe something","l":"glauben"},{"g":"at / on"},{"g":"the","l":"der"},null]}]}