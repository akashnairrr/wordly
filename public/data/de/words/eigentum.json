{"id":"eigentum","lemma":"Eigentum","pos":"noun","rank":3000,"glosses":["ownership"],"ipa":"/ˈaɪɡəntuːm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a1/De-Eigentum.ogg/De-Eigentum.ogg.mp3","gender":"n","forms":{"genitive":"Eigentumes","plural":"Eigentümer"},"examples":[{"text":"Sklaven galten als Eigentum.","en":"Slaves were considered property.","words":[{"g":"slave","l":"Sklave"},{"g":"to be valid","l":"gelten"},{"g":"at the same moment"},null]},{"text":"Ich bin nicht der Eigentümer.","en":"I'm not the owner.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"not"},{"g":"the"},null]},{"text":"Wir sind die neuen Eigentümer.","en":"We're the new owners.","words":[{"g":"we"},{"g":"are","l":"sein"},{"g":"the"},{"g":"new","l":"neu"},null]},{"text":"Tom erbte das gesamte Eigentum seines Vaters.","en":"Tom inherited all of his father's property.","words":[null,{"g":"to inherit","l":"erben"},{"g":"the / that"},{"g":"total","l":"gesamt"},null,{"g":"his","l":"seiner"},{"g":"father","l":"Vater"}]},{"text":"Ihr seid die Eigentümer.","en":"You're the owners.","words":[{"g":"you (pl.) / her"},{"g":"are","l":"sein"},{"g":"the"},null]}]}