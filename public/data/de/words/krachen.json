{"id":"krachen","lemma":"krachen","pos":"verb","rank":3653,"glosses":["to crash (collide, fall or come down violently)","to crack, creak","to quarrel, to brawl"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ed/De-krachen.ogg/De-krachen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"krache","1p":"krachen","2s":"krachst","2p":"kracht","3s":"kracht","3p":"krachen"},"preterite":{"1s":"krachte","1p":"krachten","2s":"krachtest","2p":"krachtet","3s":"krachte","3p":"krachten"},"perfect":{"1s":"habe gekracht","1p":"haben gekracht","2s":"hast gekracht","2p":"habt gekracht","3s":"hat gekracht","3p":"haben gekracht"},"future":{"1s":"werde krachen","1p":"werden krachen","2s":"wirst krachen","2p":"werdet krachen","3s":"wird krachen","3p":"werden krachen"}},"imperative":{"affirmative":{"2s":"krach","2p":"kracht"}},"subjunctive":{"conditional":{"1s":"würde krachen","1p":"würden krachen","2s":"würdest krachen","2p":"würdet krachen","3s":"würde krachen","3p":"würden krachen"}}},"nonFinite":{"participle":"gekracht"},"examples":[{"text":"Du wärest fast in meinen Wagen gekracht.","en":"You almost crashed into my car.","words":[{"g":"you"},{"g":"to be","l":"sein"},{"g":"almost"},{"g":"in"},{"g":"to opine, to think"},{"g":"a car"},null]},{"text":"Der Blumentopf krachte auf den Gehsteig.","en":"The flower pot crashed to the sidewalk.","words":[{"g":"the"},{"g":"flowerpot"},null,{"g":"on"},{"g":"the","l":"der"},{"g":"pavement , sidewalk"}]},{"text":"Was war dieser Krach?","en":"What was that noise?","words":[{"g":"what"},{"g":"was","l":"sein"},{"g":"this one, this"},null]},{"text":"Unsere Nachbarn machen viel Krach.","en":"Our neighbors make a lot of noise.","words":[{"g":"our","l":"unser"},{"g":"neighbour","l":"Nachbar"},{"g":"to make"},{"g":"much, a lot"},null]},{"text":"Wer macht da so einen Krach?","en":"Who's making that racket?","words":[{"g":"who"},{"g":"to make","l":"machen"},{"g":"there"},{"g":"so"},{"g":"a","l":"ein"},null]}]}