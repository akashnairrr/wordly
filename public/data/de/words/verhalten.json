{"id":"verhalten","lemma":"Verhalten","pos":"noun","rank":1054,"glosses":["behaviour"],"ipa":"/fɛɐ̯ˈhaltn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/69/De-Verhalten.ogg/De-Verhalten.ogg.mp3","gender":"n","forms":{"genitive":"Verhaltens","plural":"Verhalten"},"examples":[{"text":"Dein Verhalten stört mich.","en":"Your behavior disturbs me.","audio":"https://tatoeba.org/en/audio/download/786679","words":[{"g":"your"},null,{"g":"to disturb","l":"stören"},{"g":"me","l":"ich"}]},{"text":"Sein Verhalten ist meine größte Sorge.","en":"His behavior is my primary concern.","audio":"https://tatoeba.org/en/audio/download/40818","words":[{"g":"to be"},null,{"g":"is","l":"sein"},{"g":"my","l":"mein"},{"g":"big","l":"groß"},{"g":"concern"}]},{"text":"Er hat sich schlecht verhalten.","en":"He behaved badly.","audio":"https://tatoeba.org/en/audio/download/50563","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"oneself"},{"g":"bad"},null]},{"text":"Sein Verhalten ist heute sehr merkwürdig.","en":"His behavior is very odd today.","words":[{"g":"to be"},null,{"g":"is","l":"sein"},{"g":"today"},{"g":"very"},{"g":"strange, odd"}]},{"text":"Wir sollten uns ruhig verhalten.","en":"Let's keep quiet.","audio":"https://tatoeba.org/en/audio/download/391052","words":[{"g":"we"},{"g":"should","l":"sollen"},{"g":"us","l":"wir"},{"g":"quietly"},null]}]}