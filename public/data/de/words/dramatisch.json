{"id":"dramatisch","lemma":"dramatisch","pos":"adj","rank":2345,"glosses":["dramatic"],"ipa":"/dʁaˈmaːtɪʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/aa/De-dramatisch.ogg/De-dramatisch.ogg.mp3","forms":{"comparative":"dramatischer","superlative":"am dramatischsten"},"examples":[{"text":"Du bist immer so dramatisch.","en":"You're always so dramatic.","words":[{"g":"you"},{"g":"are","l":"sein"},{"g":"at all times without…"},{"g":"so"},null]},{"text":"Die Situation hat sich dramatisch geändert.","en":"The situation has changed dramatically.","words":[{"g":"the"},{"g":"situation"},{"g":"has","l":"haben"},{"g":"oneself"},null,{"g":"changed"}]},{"text":"Ihr seid immer so dramatisch.","en":"You're always so dramatic.","words":[{"g":"you (pl.) / her"},{"g":"are","l":"sein"},{"g":"at all times without…"},{"g":"so"},null]},{"text":"Sie sind immer so dramatisch.","en":"You're always so dramatic.","words":[{"g":"she / they / you"},{"g":"are","l":"sein"},{"g":"at all times without…"},{"g":"so"},null]},{"text":"Sei nicht so dramatisch, Tom!","en":"Don't be so dramatic, Tom.","words":[{"g":"to be","l":"sein"},{"g":"not"},{"g":"so"},null,null]}]}