{"id":"schatten","lemma":"Schatten","pos":"noun","rank":1346,"glosses":["shade, shadow"],"ipa":"/ˈʃatən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fb/De-Schatten.ogg/De-Schatten.ogg.mp3","gender":"m","forms":{"genitive":"Schattens","plural":"Schatten"},"formAudio":{"Schattens":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q188_%28deu%29-Sebastian_Wallroth-Schattens.wav"},"examples":[{"text":"Setzen wir uns in den Schatten!","en":"Let's sit in the shade.","audio":"https://tatoeba.org/en/audio/download/758632","words":[{"g":"to sit down"},{"g":"we"},{"g":"us","l":"wir"},{"g":"in"},{"g":"the","l":"der"},null]},{"text":"Ich stehe im Schatten.","en":"I'm standing in the shade.","words":[{"g":"I"},{"g":"to stand","l":"stehen"},{"g":"in the"},null]},{"text":"Das ist ein Schatten.","en":"That's a shadow.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"a"},null]},{"text":"Parkt das Auto im Schatten.","en":"Park the car in the shade.","audio":"https://tatoeba.org/en/audio/download/789597","words":[{"g":"to park","l":"parken"},{"g":"the / that"},{"g":"car"},{"g":"in the"},null]},{"text":"Sie hat Angst vor ihrem Schatten.","en":"She is afraid of her own shadow.","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"fear"},{"g":"in front of, ahead of"},{"g":"her","l":"ihr"},null]}]}