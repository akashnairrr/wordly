{"id":"hammer","lemma":"Hammer","pos":"noun","rank":1778,"glosses":["hammer, mallet","gavel","sensation, something extraordinary (be it positive or negative)"],"ipa":"/ˈhamɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/83/De-Hammer.ogg/De-Hammer.ogg.mp3","gender":"m","forms":{"genitive":"Hammers","plural":"Hämmer"},"formAudio":{"Hammers":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q188_%28deu%29-Sebastian_Wallroth-Hammers.wav","Hämmer":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q188_%28deu%29-Sebastian_Wallroth-H%C3%A4mmer.wav"},"examples":[{"text":"Ich brauche einen Hammer.","en":"I need a hammer.","audio":"https://tatoeba.org/en/audio/download/46082","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"a","l":"ein"},null]},{"text":"Wo kann ich einen Hammer kaufen?","en":"Where can I buy a hammer?","words":[{"g":"where"},{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"a","l":"ein"},null,{"g":"to buy, to purchase"}]},{"text":"Gib mir einen Hammer.","en":"Give me a hammer.","words":[{"g":"to give","l":"geben"},{"g":"(to) me","l":"ich"},{"g":"a","l":"ein"},null]},{"text":"Schau dir diesen großen Hammer an.","en":"Look at that big hammer.","words":[{"g":"to watch, to view","l":"schauen"},{"g":"(to) you","l":"du"},{"g":"this one, this","l":"dieser"},{"g":"big","l":"groß"},null,{"g":"at / on"}]},{"text":"Leg den Hammer nieder.","en":"Put down the hammer.","words":[{"g":"to lie down","l":"legen"},{"g":"the","l":"der"},null,{"g":"low"}]}]}