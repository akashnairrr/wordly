{"id":"sechs","lemma":"sechs","pos":"num","rank":439,"glosses":["six (numerical value represented by the Arabic numeral 6; or describing a set with six elements)"],"ipa":"/zɛks/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/df/De-sechs.ogg/De-sechs.ogg.mp3","examples":[{"text":"Ich muss um sechs auf sein.","en":"I have to be up at six.","audio":"https://tatoeba.org/en/audio/download/756974","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"around / at"},null,{"g":"on"},{"g":"to be"}]},{"text":"Warte bis sechs.","en":"Wait till six.","audio":"https://tatoeba.org/en/audio/download/40577","words":[{"g":"to wait","l":"warten"},{"g":"until, to, through"},null]},{"text":"Komm um sechs heim!","en":"Come home at six.","audio":"https://tatoeba.org/en/audio/download/79569","words":[{"g":"to come","l":"kommen"},{"g":"around / at"},null,{"g":"home, to the house"}]},{"text":"Dieses Haus hat sechs Zimmer.","en":"This house has six rooms.","words":[{"g":"this one, this","l":"dieser"},{"g":"house, building"},{"g":"has","l":"haben"},null,{"g":"room"}]},{"text":"Es ist fast sechs Uhr.","en":"It's almost six.","audio":"https://tatoeba.org/en/audio/download/35579","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"almost"},null,{"g":"hours, o'clock"}]}]}