{"id":"statt","lemma":"statt","pos":"prep","rank":909,"glosses":["instead of, in one's stead"],"ipa":"/ʃtat/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/De-statt2.ogg/De-statt2.ogg.mp3","examples":[{"text":"Ich will Zeit statt Geld.","en":"I want time instead of money.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"time"},null,{"g":"money"}]},{"text":"Wo findet die Party statt?","en":"Where's the party?","words":[{"g":"where"},{"g":"to find","l":"finden"},{"g":"the"},{"g":"party"},null]},{"text":"Würdest du statt meiner gehen?","en":"Will you go in place of me?","words":[{"g":"to become","l":"werden"},{"g":"you"},null,{"g":"my","l":"mein"},{"g":"to go, to walk"}]},{"text":"Die Hochzeit findet am Samstag statt.","en":"The wedding will take place on Saturday.","audio":"https://tatoeba.org/en/audio/download/565790","words":[{"g":"the"},{"g":"wedding, marriage"},{"g":"to find","l":"finden"},{"g":"at the / on the"},{"g":"Saturday"},null]},{"text":"Das Treffen findet morgen statt.","en":"The meeting is tomorrow.","words":[{"g":"the / that"},{"g":"to meet"},{"g":"to find","l":"finden"},{"g":"tomorrow"},null]}]}