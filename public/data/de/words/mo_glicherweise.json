{"id":"mo_glicherweise","lemma":"möglicherweise","pos":"adv","rank":1468,"glosses":["possibly, potentially","perhaps","conceivably"],"ipa":"/ˈmøːklɪçɐˈvaɪ̯zə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/57/De-m%C3%B6glicherweise.ogg/De-m%C3%B6glicherweise.ogg.mp3","examples":[{"text":"Wir haben möglicherweise ein Problem.","en":"We may have a problem.","audio":"https://tatoeba.org/en/audio/download/756982","words":[{"g":"we"},{"g":"have"},null,{"g":"a"},{"g":"problem"}]},{"text":"Sie müssen möglicherweise nicht gehen.","en":"You may not have to go.","words":[{"g":"she / they / you"},{"g":"to have to"},null,{"g":"not"},{"g":"to go, to walk"}]},{"text":"Ich habe möglicherweise den Schlüssel vergessen.","en":"I might have forgotten the key.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"the","l":"der"},{"g":"a key"},{"g":"to forget"}]},{"text":"Möglicherweise mag er dich.","en":"Maybe he likes you.","words":[null,{"g":"to like","l":"mögen"},{"g":"he / it"},{"g":"you","l":"du"}]},{"text":"Möglicherweise ist es wahr.","en":"Possibly, it's true.","words":[null,{"g":"is","l":"sein"},{"g":"it"},{"g":"true, real"}]}]}