{"id":"ehre","lemma":"Ehre","pos":"noun","rank":734,"glosses":["honour","credit","kudos"],"ipa":"/ˈeːʁə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6f/De-Ehre.ogg/De-Ehre.ogg.mp3","gender":"f","forms":{"genitive":"Ehre","plural":"Ehren"},"formAudio":{"Ehren":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q188_%28deu%29-Sebastian_Wallroth-Ehren.wav"},"examples":[{"text":"Er hat seine Ehre verloren.","en":"He lost his honor.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"his","l":"seiner"},null,{"g":"lost, missing"}]},{"text":"Das ist zu viel der Ehre.","en":"The honor is more than I deserve.","words":[{"g":"the / that"},{"g":"is","l":"sein"},null,null,{"g":"the"},null],"phrases":[[2,4,"too much"]]},{"text":"Du musst zwischen Ehre und Tod wählen.","en":"You have to choose between honor and death.","words":[{"g":"you"},{"g":"to have to","l":"müssen"},{"g":"between"},null,{"g":"and"},{"g":"death"},{"g":"to choose, to select"}]},{"text":"Es ist eine Ehre.","en":"It's an honor.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"a"},null]},{"text":"Mit wem habe ich die Ehre?","en":"Who am I addressing?","words":[{"g":"with"},{"g":"who","l":"wer"},{"g":"have","l":"haben"},{"g":"I"},{"g":"the"},null]}]}