{"id":"gleich","lemma":"gleich","pos":"adv","rank":156,"glosses":["alike","in a moment","at once, at a time, simultaneously"],"ipa":"/ɡlaɪ̯ç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/De-gleich.ogg/De-gleich.ogg.mp3","examples":[{"text":"Sind sie alle gleich?","en":"Are they all the same?","audio":"https://tatoeba.org/en/audio/download/149","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},{"g":"all, everyone"},null]},{"text":"Wir können nicht jetzt gleich gehen.","en":"We can't go right now.","audio":"https://tatoeba.org/en/audio/download/701014","words":[{"g":"we"},{"g":"can, to be able to"},{"g":"not"},{"g":"now"},null,{"g":"to go, to walk"}]},{"text":"Ich werde gleich hinter dir sein.","en":"I'll be right behind you.","audio":"https://tatoeba.org/en/audio/download/789567","words":[{"g":"I"},{"g":"to become","l":"werden"},null,{"g":"behind, after"},{"g":"(to) you","l":"du"},{"g":"to be"}]},{"text":"Willst du es jetzt gleich tun?","en":"Do you want to do it right now?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"it"},{"g":"now"},null,{"g":"to do"}]},{"text":"Bist du gleich hier?","en":"Are you almost here?","words":[{"g":"are","l":"sein"},{"g":"you"},null,{"g":"here"}]}]}