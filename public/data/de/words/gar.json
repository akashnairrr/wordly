{"id":"gar","lemma":"gar","pos":"adv","rank":152,"glosses":["at all; even","even; expressing a climax","all"],"ipa":"/ɡaːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/30/De-gar.ogg/De-gar.ogg.mp3","examples":[{"text":"Nein, gar nicht.","en":"No, not at all.","words":[{"g":"no"},null,{"g":"not"}]},{"text":"Das kann gar nicht sein.","en":"That can't be.","audio":"https://tatoeba.org/en/audio/download/46121","words":[{"g":"the / that"},{"g":"can, to be able to","l":"können"},null,{"g":"not"},{"g":"to be"}]},{"text":"Kannst du gar nicht schwimmen?","en":"Can't you swim at all?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null,{"g":"not"},{"g":"to swim"}]},{"text":"So betrunken bin ich gar nicht.","en":"I'm not all that drunk.","audio":"https://tatoeba.org/en/audio/download/759271","words":[{"g":"so"},{"g":"drunk, inebriated"},{"g":"am","l":"sein"},{"g":"I"},null,{"g":"not"}]},{"text":"Vielleicht liebe ich dich gar nicht.","en":"Maybe I don't love you.","audio":"https://tatoeba.org/en/audio/download/758610","words":[{"g":"perhaps, maybe"},{"g":"lovable","l":"lieb"},{"g":"I"},{"g":"you","l":"du"},null,{"g":"not"}]}]}