{"id":"szene","lemma":"Szene","pos":"noun","rank":1289,"glosses":["scene; tableau","scene (subculture)","row"],"ipa":"/ˈst͡seːnə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4a/De-Szene.ogg/De-Szene.ogg.mp3","gender":"f","forms":{"genitive":"Szene","plural":"Szenen"},"examples":[{"text":"Mach keine Szene!","en":"Don't make a scene.","audio":"https://tatoeba.org/en/audio/download/390845","words":[{"g":"to make","l":"machen"},{"g":"no / not a","l":"kein"},null]},{"text":"Ich wollte keine Szene machen.","en":"I didn't want to cause a scene.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"no / not a","l":"kein"},null,{"g":"to make"}]},{"text":"Es war eine filmreife Szene.","en":"It was just like a scene out of a movie.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"a"},null,null]},{"text":"Die Szene war unbeschreiblich schön.","en":"The scenery was too beautiful for words.","words":[{"g":"the"},null,{"g":"was","l":"sein"},{"g":"indescribable"},{"g":"well, beautifully"}]},{"text":"Ich möchte die Szene in Zeitlupe sehen.","en":"I want to see the scene in slow motion.","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"the"},null,{"g":"in"},{"g":"slow motion"},{"g":"to see"}]}]}