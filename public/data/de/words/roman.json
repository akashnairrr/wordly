{"id":"roman","lemma":"Roman","pos":"noun","rank":1947,"glosses":["novel"],"ipa":"/ʁoˈmaːn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/De-Roman.ogg/De-Roman.ogg.mp3","gender":"m","forms":{"genitive":"Romanes","plural":"Romane"},"examples":[{"text":"Er schreibt einen Roman.","en":"He is writing a novel.","audio":"https://tatoeba.org/en/audio/download/40914","words":[{"g":"he / it"},{"g":"to write, to write out","l":"schreiben"},{"g":"a","l":"ein"},null]},{"text":"Haben Sie viele Romane gelesen?","en":"Have you read many novels?","words":[{"g":"have"},{"g":"she / they / you"},{"g":"much, a lot","l":"viel"},null,{"g":"to read","l":"lesen"}]},{"text":"Du solltest einen Roman schreiben.","en":"You should write a novel.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"a","l":"ein"},null,{"g":"to write, to write out"}]},{"text":"Ich habe alle seine Romane gelesen.","en":"I have read all his novels.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"all, everyone"},{"g":"his","l":"seiner"},null,{"g":"to read","l":"lesen"}]},{"text":"Er arbeitet an einem neuen Roman.","en":"He is working on a new novel.","words":[{"g":"he / it"},{"g":"to work","l":"arbeiten"},{"g":"at / on"},{"g":"(to) a","l":"ein"},{"g":"new","l":"neu"},null]}]}