{"id":"schieben","lemma":"schieben","pos":"verb","rank":2298,"glosses":["to push; to shove","to slide; to slip; to put","to push"],"ipa":"/ˈʃiːbən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bd/De-schieben.ogg/De-schieben.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"schiebe","1p":"schieben","2s":"schiebst","2p":"schiebt","3s":"schiebt","3p":"schieben"},"preterite":{"1s":"schob","1p":"schoben","2s":"schobst","2p":"schobt","3s":"schob","3p":"schoben"},"perfect":{"1s":"habe geschoben","1p":"haben geschoben","2s":"hast geschoben","2p":"habt geschoben","3s":"hat geschoben","3p":"haben geschoben"},"future":{"1s":"werde schieben","1p":"werden schieben","2s":"wirst schieben","2p":"werdet schieben","3s":"wird schieben","3p":"werden schieben"}},"imperative":{"affirmative":{"2s":"schieb","2p":"schiebt"}},"subjunctive":{"conditional":{"1s":"würde schieben","1p":"würden schieben","2s":"würdest schieben","2p":"würdet schieben","3s":"würde schieben","3p":"würden schieben"}}},"nonFinite":{"participle":"geschoben"},"examples":[{"text":"Schieben Sie den Tisch bitte hierher!","en":"Please push the table over this way.","words":[null,{"g":"she / they / you"},{"g":"the","l":"der"},{"g":"dining table"},{"g":"please"},{"g":"to here, here , hither"}]},{"text":"Sie schob ihn zur Tür hinaus.","en":"She pushed him out the door.","words":[{"g":"she / they / you"},null,{"g":"him"},{"g":"to the"},{"g":"door"},{"g":"out"}]},{"text":"Wir schoben das Auto von hinten.","en":"We got behind the car and pushed.","words":[{"g":"we"},null,{"g":"the / that"},{"g":"car"},{"g":"from / of"},{"g":"behind"}]},{"text":"Schieb die Pizza in den Ofen.","en":"Put the pizza in the oven.","words":[null,{"g":"the"},{"g":"pizza"},{"g":"in"},{"g":"the","l":"der"},{"g":"stove"}]},{"text":"Er schob die Schuld auf mich.","en":"He put the blame upon me.","words":[{"g":"he / it"},null,{"g":"the"},{"g":"debt"},{"g":"on"},{"g":"me","l":"ich"}]}]}