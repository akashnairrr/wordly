{"id":"nieder","lemma":"nieder","pos":"adj","rank":1820,"glosses":["low","mean","menial"],"ipa":"/ˈniː.dɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b5/De-nieder.ogg/De-nieder.ogg.mp3","forms":{"comparative":"niederer","superlative":"am niedersten"},"examples":[{"text":"Nieder mit dem König!","en":"Down with the king!","words":[null,{"g":"with"},{"g":"(to) the","l":"der"},{"g":"king"}]},{"text":"Leg die Waffe nieder!","en":"Put the gun down.","audio":"https://tatoeba.org/en/audio/download/392527","words":[{"g":"to lie down","l":"legen"},{"g":"the"},{"g":"weapon, arm"},null]},{"text":"Leg den Hammer nieder.","en":"Put down the hammer.","words":[{"g":"to lie down","l":"legen"},{"g":"the","l":"der"},{"g":"hammer, mallet"},null]},{"text":"Legt euch nieder!","en":"Lie low.","words":[{"g":"to lie down","l":"legen"},{"g":"you (pl.)","l":"ihr"},null]},{"text":"Bitte schreibe nieder was ich sagen werde.","en":"Please write down what I say.","words":[{"g":"please"},{"g":"to write, to write out","l":"schreiben"},null,{"g":"what"},{"g":"I"},{"g":"to say (to pronounce"},{"g":"to become","l":"werden"}]}]}