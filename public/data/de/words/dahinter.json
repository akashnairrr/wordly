{"id":"dahinter","lemma":"dahinter","pos":"adv","rank":1632,"glosses":["behind it/that"],"ipa":"/daˈhɪntəʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/21/De-dahinter.ogg/De-dahinter.ogg.mp3","examples":[{"text":"Wer steckt dahinter?","en":"Who's behind it?","audio":"https://tatoeba.org/en/audio/download/565896","words":[{"g":"who"},{"g":"to stick","l":"stecken"},null]},{"text":"Was ist die Idee dahinter?","en":"What's the idea behind that?","words":[{"g":"what"},{"g":"is","l":"sein"},{"g":"the"},{"g":"idea"},null]},{"text":"Du kommst schon dahinter.","en":"You'll find out.","audio":"https://tatoeba.org/en/audio/download/248129","words":[{"g":"you"},{"g":"to come","l":"kommen"},{"g":"already"},null]},{"text":"Ich komme einfach nicht dahinter.","en":"I just can't work it out.","words":[{"g":"I"},{"g":"to come","l":"kommen"},{"g":"easy"},{"g":"not"},null]},{"text":"Da steckt noch mehr dahinter.","en":"There's more to it than this.","words":[{"g":"there"},{"g":"to stick","l":"stecken"},{"g":"still / yet"},{"g":"more"},null]}]}