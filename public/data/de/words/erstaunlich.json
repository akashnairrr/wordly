{"id":"erstaunlich","lemma":"erstaunlich","pos":"adj","rank":1961,"glosses":["amazing, impressive, surprising (contrary to or surpassing expectations, in a positive or neutral framing)"],"ipa":"/ɛɐ̯ˈʃtaʊ̯nlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/15/De-erstaunlich.ogg/De-erstaunlich.ogg.mp3","forms":{"comparative":"erstaunlicher","superlative":"am erstaunlichsten"},"examples":[{"text":"Es war erstaunlich einfach.","en":"It was amazingly easy.","audio":"https://tatoeba.org/en/audio/download/757861","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"easy"}]},{"text":"Ich denke, du bist wirklich erstaunlich.","en":"I think you're really amazing.","words":[{"g":"I"},{"g":"to think","l":"denken"},{"g":"you"},{"g":"are","l":"sein"},{"g":"really, actually"},null]},{"text":"Ist das nicht erstaunlich?","en":"Isn't that amazing?","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"not"},null]},{"text":"Tom ist ein ganz erstaunlicher Mensch.","en":"Tom is a pretty amazing person.","words":[null,{"g":"is","l":"sein"},{"g":"a"},{"g":"entire"},null,{"g":"human"}]},{"text":"Es ist erstaunlich einfach.","en":"It's amazingly simple.","audio":"https://tatoeba.org/en/audio/download/756642","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"easy"}]}]}