{"id":"sitzung","lemma":"Sitzung","pos":"noun","rank":2550,"glosses":["meeting","session","assembly"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/04/De-Sitzung.ogg/De-Sitzung.ogg.mp3","gender":"f","forms":{"genitive":"Sitzung","plural":"Sitzungen"},"examples":[{"text":"Ich bin zu einer Sitzung hier.","en":"I'm here for a meeting.","audio":"https://tatoeba.org/en/audio/download/758759","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"to / too"},{"g":"a / one","l":"ein"},null,{"g":"here"}]},{"text":"Wo halten Sie Ihre Sitzungen ab?","en":"Where do you hold your meetings?","words":[{"g":"where"},{"g":"to hold"},{"g":"she / they / you"},{"g":"her","l":"ihr"},null,{"g":"beginning at that time…"}]},{"text":"Es war eine sehr lange Sitzung.","en":"It was a very long meeting.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"a"},{"g":"very"},{"g":"long, for a long time"},null]},{"text":"Wir haben morgen eine Sitzung.","en":"We have a meeting tomorrow.","words":[{"g":"we"},{"g":"have"},{"g":"tomorrow"},{"g":"a"},null]},{"text":"Du weißt doch, dass ich Sitzungen hasse.","en":"You know I hate meetings.","words":[{"g":"you"},{"g":"to know","l":"wissen"},{"g":"but / yes"},{"g":"that"},{"g":"I"},null,{"g":"to hate","l":"hassen"}]}]}