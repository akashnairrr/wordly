{"id":"erlaubnis","lemma":"Erlaubnis","pos":"noun","rank":1496,"glosses":["permission (authorisation)"],"ipa":"/ɛɐ̯ˈlaʊ̯pnɪs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/De-Erlaubnis.ogg/De-Erlaubnis.ogg.mp3","gender":"f","forms":{"genitive":"Erlaubnis","plural":"Erlaubnisse"},"formAudio":{"Erlaubnisse":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q188_%28deu%29-Sebastian_Wallroth-Erlaubnisse.wav"},"examples":[{"text":"Müssen wir um Erlaubnis fragen?","en":"Do we have to ask for permission?","words":[{"g":"to have to"},{"g":"we"},{"g":"around / at"},null,{"g":"to ask"}]},{"text":"Brauchen wir dafür eine Erlaubnis?","en":"Do we need permission to do that?","words":[{"g":"to need"},{"g":"we"},{"g":"for that, for it"},{"g":"a"},null]},{"text":"Hast du das ohne Erlaubnis getan?","en":"Did you do that without permission?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"the / that"},{"g":"without"},null,{"g":"to do","l":"tun"}]},{"text":"Ich brauche eine Erlaubnis.","en":"I need authorization.","audio":"https://tatoeba.org/en/audio/download/789610","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"a"},null]},{"text":"Du solltest erst um Erlaubnis bitten.","en":"You should ask for permission first.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"first, at first"},{"g":"around / at"},null,{"g":"to ask"}]}]}