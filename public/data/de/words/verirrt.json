{"id":"verirrt","lemma":"verirrt","pos":"adj","rank":4167,"glosses":["lost, stray"],"ipa":"/fɛɐ̯ˈʔɪʁt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3b/De-verirrt.ogg/De-verirrt.ogg.mp3","examples":[{"text":"Ihr habt euch verirrt.","en":"You're lost.","audio":"https://tatoeba.org/en/audio/download/566758","words":[{"g":"you (pl.) / her"},{"g":"to have","l":"haben"},{"g":"you (pl.)","l":"ihr"},null]},{"text":"Sie haben sich verirrt.","en":"You're lost.","audio":"https://tatoeba.org/en/audio/download/172327","words":[{"g":"she / they / you"},{"g":"have"},{"g":"oneself"},null]},{"text":"Du hast dich nicht verirrt.","en":"You're not lost.","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"you","l":"du"},{"g":"not"},null]},{"text":"Ich habe mich im Schnee verirrt.","en":"I got lost in the snow.","audio":"https://tatoeba.org/en/audio/download/756143","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"me","l":"ich"},{"g":"in the"},{"g":"snow"},null]},{"text":"Dachtest du, ich hätte mich verirrt?","en":"Did you think I was lost?","words":[{"g":"to think","l":"denken"},{"g":"you"},{"g":"I"},{"g":"to have","l":"haben"},{"g":"me","l":"ich"},null]}]}