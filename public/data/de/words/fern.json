{"id":"fern","lemma":"fern","pos":"adj","rank":1243,"glosses":["remote","far away"],"ipa":"/fɛʁn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8f/De-fern.ogg/De-fern.ogg.mp3","forms":{"comparative":"ferner","superlative":"am fernsten"},"examples":[{"text":"Wie oft seht ihr fern?","en":"How often do you watch TV?","audio":"https://tatoeba.org/en/audio/download/761264","words":[{"g":"how"},{"g":"often"},{"g":"to see","l":"sehen"},{"g":"you (pl.) / her"},null]},{"text":"Warum siehst du nicht fern?","en":"Why don't you watch TV?","audio":"https://tatoeba.org/en/audio/download/760019","words":[{"g":"why"},{"g":"to see","l":"sehen"},{"g":"you"},{"g":"not"},null]},{"text":"Wo schauen Sie fern?","en":"Where do you watch television?","words":[{"g":"where"},{"g":"to watch, to view"},{"g":"she / they / you"},null]},{"text":"Er schaut fern.","en":"He is watching TV.","audio":"https://tatoeba.org/en/audio/download/394829","words":[{"g":"he / it"},{"g":"to watch, to view","l":"schauen"},null]},{"text":"Nichts lag mir ferner.","en":"I wouldn't have dreamed of it.","words":[{"g":"nothing"},{"g":"to lie","l":"liegen"},{"g":"(to) me","l":"ich"},null]}]}