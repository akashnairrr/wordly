{"id":"a_rger","lemma":"Ärger","pos":"noun","rank":631,"glosses":["annoyance, anger","trouble, an unpleasant or dangerous situation"],"ipa":"/ˈʔɛɐ̯ɡɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/De-%C3%84rger.ogg/De-%C3%84rger.ogg.mp3","gender":"m","forms":{"genitive":"Ärgers"},"examples":[{"text":"Ich verstehe deinen Ärger.","en":"I understand your anger.","words":[{"g":"I"},{"g":"to hear and interpret","l":"verstehen"},{"g":"thy, your .","l":"dein"},null]},{"text":"Wir verstehen ja deinen Ärger.","en":"We understand your anger.","words":[{"g":"we"},{"g":"to hear and interpret"},{"g":"yes"},{"g":"thy, your .","l":"dein"},null]},{"text":"Mädchen sind nichts als Ärger.","en":"Girls are nothing but trouble.","words":[{"g":"girl"},{"g":"are","l":"sein"},null,null,null],"phrases":[[2,4,"nothing but"]]},{"text":"Wir haben nicht viel Ärger.","en":"We don't have a lot of trouble.","words":[{"g":"we"},{"g":"have"},{"g":"not"},{"g":"much, a lot"},null]},{"text":"Ich will keinen Ärger.","en":"I don't want trouble.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"no / not a","l":"kein"},null]}]}