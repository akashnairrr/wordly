{"id":"einander","lemma":"einander","pos":"pron","rank":1408,"glosses":["Reciprocal pronoun of all three plural persons: each other"],"ipa":"/aɪ̯ˈnandɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/De-einander.ogg/De-einander.ogg.mp3","examples":[{"text":"Kennen Sie einander?","en":"Do you know each other?","audio":"https://tatoeba.org/en/audio/download/756652","words":[{"g":"to know"},{"g":"she / they / you"},null]},{"text":"Wie lange kennt ihr einander schon?","en":"How long have you guys known each other?","words":[{"g":"how"},{"g":"long, for a long time"},{"g":"to know","l":"kennen"},{"g":"you (pl.) / her"},null,{"g":"already"}]},{"text":"Wir lieben einander noch.","en":"We still love each other.","words":[{"g":"we"},{"g":"to love"},null,{"g":"still / yet"}]},{"text":"Meine Eltern lieben einander.","en":"My parents love each other.","words":[{"g":"my","l":"mein"},{"g":"parents"},{"g":"to love"},null]},{"text":"Sie helfen einander oft.","en":"They often help each other.","words":[{"g":"she / they / you"},{"g":"to help"},null,{"g":"often"}]}]}