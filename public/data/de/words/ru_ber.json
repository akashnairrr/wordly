{"id":"ru_ber","lemma":"rüber","pos":"adv","rank":688,"glosses":["over here","over there"],"ipa":"/ˈʁyːbəʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cc/De-r%C3%BCber.ogg/De-r%C3%BCber.ogg.mp3","examples":[{"text":"Ich komme rüber.","en":"I'll come over.","audio":"https://tatoeba.org/en/audio/download/701217","words":[{"g":"I"},{"g":"to come","l":"kommen"},null]},{"text":"Komm rüber und hilf mir.","en":"Come over here and help me.","words":[{"g":"to come","l":"kommen"},null,{"g":"and"},{"g":"to help","l":"helfen"},{"g":"(to) me","l":"ich"}]},{"text":"Wirf es mir rüber!","en":"Throw it to me.","audio":"https://tatoeba.org/en/audio/download/171829","words":[{"g":"to throw","l":"werfen"},{"g":"it"},{"g":"(to) me","l":"ich"},null]},{"text":"Komm rüber und setz dich hin.","en":"Come over here and sit down.","words":[{"g":"to come","l":"kommen"},null,{"g":"and"},{"g":"to sit down","l":"setzen"},{"g":"you","l":"du"},{"g":"gone , left, situated"}]},{"text":"Reich mir bitte den Kaffee rüber.","en":"Pass me the coffee, please.","words":[{"g":"rich, wealthy"},{"g":"(to) me","l":"ich"},{"g":"please"},{"g":"the","l":"der"},{"g":"coffee"},null]}]}