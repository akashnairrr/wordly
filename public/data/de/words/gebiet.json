{"id":"gebiet","lemma":"Gebiet","pos":"noun","rank":1564,"glosses":["area, region","territory","a (non-empty) open and connected set, domain"],"ipa":"/ɡəˈbiːt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/60/De-Gebiet.ogg/De-Gebiet.ogg.mp3","gender":"n","forms":{"genitive":"Gebietes","plural":"Gebiete"},"examples":[{"text":"Rauchen ist in diesem Gebiet verboten.","en":"Smoking is forbidden in this area.","words":[{"g":"to smoke"},{"g":"is","l":"sein"},{"g":"in"},{"g":"this one, this","l":"dieser"},null,{"g":"forbidden"}]},{"text":"Wir überprüfen das gesamte Gebiet.","en":"We're checking the whole area.","words":[{"g":"we"},{"g":"to check, to verify"},{"g":"the / that"},{"g":"total","l":"gesamt"},null]},{"text":"Es gibt kaum Regen in diesem Gebiet.","en":"It hardly ever rains in the area.","words":[null,null,{"g":"barely, hardly"},{"g":"rain"},{"g":"in"},{"g":"this one, this","l":"dieser"},null],"phrases":[[0,2,"there is, there are"]]},{"text":"Ich wohne in einem ländlichen Gebiet.","en":"I live in a rural area.","words":[{"g":"I"},{"g":"to live, reside, dwell","l":"wohnen"},{"g":"in"},{"g":"(to) a","l":"ein"},{"g":"rural","l":"ländlich"},null]},{"text":"Das Gebiet wird jetzt bebaut.","en":"The area is built up now.","words":[{"g":"the / that"},null,{"g":"to become","l":"werden"},{"g":"now"},null]}]}