{"id":"klamotte","lemma":"Klamotte","pos":"noun","rank":1907,"glosses":["clothes, outfit, wardrobe, gear","a piece of junk, useless stuff","lowbrow film or play"],"ipa":"/klaˈmɔtə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/88/De-Klamotte.ogg/De-Klamotte.ogg.mp3","gender":"f","forms":{"genitive":"Klamotte","plural":"Klamotten"},"formAudio":{"Klamotten":"https://upload.wikimedia.org/wikipedia/commons/5/5e/LL-Q188_%28deu%29-Sebastian_Wallroth-Klamotten.wav"},"examples":[{"text":"Wie oft gehst du Klamotten kaufen?","en":"How often do you go clothes shopping?","words":[{"g":"how"},{"g":"often"},{"g":"to go, to walk","l":"gehen"},{"g":"you"},null,{"g":"to buy, to purchase"}]},{"text":"Ich muss meine Klamotten wechseln.","en":"I have to change my clothes.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"my","l":"mein"},null,{"g":"to change, to exchange"}]},{"text":"Ich gehe heute Klamotten kaufen.","en":"I'm going to buy clothes today.","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},{"g":"today"},null,{"g":"to buy, to purchase"}]},{"text":"Ich sollte mehr Klamotten anziehen.","en":"I should put on more clothes.","words":[{"g":"I"},{"g":"should","l":"sollen"},{"g":"more"},null,{"g":"to get dressed"}]},{"text":"Wozu brauchst du so viele Klamotten?","en":"Why do you need so much gear?","words":[{"g":"for what reason"},{"g":"to need","l":"brauchen"},{"g":"you"},{"g":"so"},{"g":"much, a lot","l":"viel"},null]}]}