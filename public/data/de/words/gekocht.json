{"id":"gekocht","lemma":"gekocht","pos":"verb","rank":2920,"glosses":["cooked, fucked"],"ipa":"/ɡəˈkɔxt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/De-gekocht.ogg/De-gekocht.ogg.mp3","examples":[{"text":"Hast du mir etwas gekocht?","en":"Did you cook me something?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"(to) me","l":"ich"},{"g":"something"},null]},{"text":"Ich habe Kaffee gekocht.","en":"I made coffee.","audio":"https://tatoeba.org/en/audio/download/138174","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"coffee"},null]},{"text":"Meine Mutter hat zehn Eier gekocht.","en":"My mother boiled ten eggs.","audio":"https://tatoeba.org/en/audio/download/40981","words":[{"g":"my","l":"mein"},{"g":"mother"},{"g":"has","l":"haben"},{"g":"ten"},{"g":"egg","l":"Ei"},null]},{"text":"Was hast du zum Abendessen gekocht?","en":"What did you cook for dinner?","words":[{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},{"g":"to the"},{"g":"dinner, supper"},null]},{"text":"Haben Sie das selbst gekocht?","en":"Did you cook this yourself?","words":[{"g":"have"},{"g":"she / they / you"},{"g":"the / that"},{"g":"even"},null]}]}