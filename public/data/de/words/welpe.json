{"id":"welpe","lemma":"Welpe","pos":"noun","rank":4751,"glosses":["puppy (male or of unspecified gender) (young dog)","cub (male or of unspecified gender) (young of several wild animals)"],"ipa":"/ˈvɛlpə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/27/De-Welpe.ogg/De-Welpe.ogg.mp3","gender":"m","forms":{"genitive":"Welpen","plural":"Welpen"},"examples":[{"text":"Ich will einen Welpen.","en":"I want a puppy.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"a","l":"ein"},null]},{"text":"Der Welpe will schlafen.","en":"The puppy wants to sleep.","words":[{"g":"the"},null,{"g":"to want","l":"wollen"},{"g":"to sleep"}]},{"text":"Ich mag Welpen sehr.","en":"I really like puppies.","words":[{"g":"I"},{"g":"to like","l":"mögen"},null,{"g":"very"}]},{"text":"Ein junger Hund heißt Welpe.","en":"A young dog is called a \"puppy.\"","words":[{"g":"a"},{"g":"young","l":"jung"},{"g":"dog, hound"},{"g":"to have a name","l":"heißen"},null]},{"text":"Wann wird aus einem Welpen ein Hund?","en":"When does a puppy become a dog?","words":[{"g":"when"},{"g":"to become","l":"werden"},{"g":"out of / from"},{"g":"(to) a","l":"ein"},null,{"g":"a"},{"g":"dog, hound"}]}]}