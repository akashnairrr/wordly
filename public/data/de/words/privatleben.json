{"id":"privatleben","lemma":"Privatleben","pos":"noun","rank":3707,"glosses":["personal life, private life"],"ipa":"/priˈvaːtleːbm̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b7/De-Privatleben.ogg/De-Privatleben.ogg.mp3","gender":"n","forms":{"genitive":"Privatlebens"},"formAudio":{"Privatlebens":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q188_%28deu%29-Sebastian_Wallroth-Privatlebens.wav"},"examples":[{"text":"Ich habe kein Privatleben.","en":"I have no privacy.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"no / not a"},null]},{"text":"Mein Privatleben geht dich nichts an!","en":"My personal life is none of your business.","words":[{"g":"my"},null,{"g":"to go, to walk","l":"gehen"},{"g":"you","l":"du"},{"g":"nothing"},{"g":"at / on"}]},{"text":"Mein Privatleben geht Sie nichts an!","en":"My personal life is none of your business.","words":[{"g":"my"},null,{"g":"to go, to walk","l":"gehen"},{"g":"she / they / you"},{"g":"nothing"},{"g":"at / on"}]},{"text":"Mein Privatleben geht euch nichts an!","en":"My personal life is none of your business.","words":[{"g":"my"},null,{"g":"to go, to walk","l":"gehen"},{"g":"you (pl.)","l":"ihr"},{"g":"nothing"},{"g":"at / on"}]},{"text":"Misch dich nicht in ihr Privatleben ein.","en":"Don't intrude on her privacy.","words":[{"g":"to mix","l":"mischen"},{"g":"you","l":"du"},{"g":"not"},{"g":"in"},{"g":"you (pl.) / her"},null,{"g":"a"}]}]}