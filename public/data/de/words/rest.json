{"id":"rest","lemma":"Rest","pos":"noun","rank":522,"glosses":["rest, remainder, remnant","radical"],"ipa":"/ʁɛst/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a0/De-Rest.ogg/De-Rest.ogg.mp3","gender":"m","forms":{"genitive":"Restes","plural":"Reste"},"examples":[{"text":"Wo ist der Rest?","en":"Where's the rest?","audio":"https://tatoeba.org/en/audio/download/392640","words":[{"g":"where"},{"g":"is","l":"sein"},{"g":"the"},null]},{"text":"Ich erzähle dir morgen den Rest.","en":"I'll tell you the rest tomorrow.","audio":"https://tatoeba.org/en/audio/download/745210","words":[{"g":"I"},{"g":"to tell","l":"erzählen"},{"g":"(to) you","l":"du"},{"g":"tomorrow"},{"g":"the","l":"der"},null]},{"text":"Ich wollte keine Reste mehr essen.","en":"I didn't want to eat leftovers anymore.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"no / not a","l":"kein"},null,{"g":"more"},{"g":"to eat"}]},{"text":"Den Rest weißt du.","en":"You know the rest.","words":[{"g":"the","l":"der"},null,{"g":"to know","l":"wissen"},{"g":"you"}]},{"text":"Den Rest wissen Sie.","en":"You know the rest.","words":[{"g":"the","l":"der"},null,{"g":"to know"},{"g":"she / they / you"}]}]}