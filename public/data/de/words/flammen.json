{"id":"flammen","lemma":"flammen","pos":"verb","rank":2745,"glosses":["to flame (burn with a flame, also figuratively)"],"ipa":"/flamən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b8/De-flammen.ogg/De-flammen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"flamme","1p":"flammen","2s":"flammst","2p":"flammt","3s":"flammt","3p":"flammen"},"preterite":{"1s":"flammte","1p":"flammten","2s":"flammtest","2p":"flammtet","3s":"flammte","3p":"flammten"},"perfect":{"1s":"habe geflammt","1p":"haben geflammt","2s":"hast geflammt","2p":"habt geflammt","3s":"hat geflammt","3p":"haben geflammt"},"future":{"1s":"werde flammen","1p":"werden flammen","2s":"wirst flammen","2p":"werdet flammen","3s":"wird flammen","3p":"werden flammen"}},"imperative":{"affirmative":{"2s":"flamm","2p":"flammt"}},"subjunctive":{"conditional":{"1s":"würde flammen","1p":"würden flammen","2s":"würdest flammen","2p":"würdet flammen","3s":"würde flammen","3p":"würden flammen"}}},"nonFinite":{"participle":"geflammt"},"examples":[{"text":"Das Haus stand in Flammen.","en":"The house was ablaze.","audio":"https://tatoeba.org/en/audio/download/566654","words":[{"g":"the / that"},{"g":"house, building"},{"g":"to stand","l":"stehen"},{"g":"in"},null]},{"text":"Das Schiff ging in Flammen auf.","en":"The ship went up in flames.","words":[{"g":"the / that"},{"g":"ship"},{"g":"to go, to walk","l":"gehen"},{"g":"in"},null,{"g":"on"}]},{"text":"Dein Auto steht in Flammen.","en":"Your car is on fire.","words":[{"g":"your"},{"g":"car"},{"g":"to stand","l":"stehen"},{"g":"in"},null]},{"text":"Der Wind fachte die Flammen an.","en":"The wind fanned the flames.","words":[{"g":"the"},{"g":"wind"},null,{"g":"the"},null,{"g":"at / on"}]},{"text":"Ich warf das Papier in die Flammen.","en":"I threw the paper into the flames.","words":[{"g":"I"},{"g":"to throw","l":"werfen"},{"g":"the / that"},{"g":"paper"},{"g":"in"},{"g":"the"},null]}]}