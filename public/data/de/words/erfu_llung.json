{"id":"erfu_llung","lemma":"Erfüllung","pos":"noun","rank":4991,"glosses":["fulfillment"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/62/De-Erf%C3%BCllung.ogg/De-Erf%C3%BCllung.ogg.mp3","gender":"f","forms":{"genitive":"Erfüllung","plural":"Erfüllungen"},"examples":[{"text":"Träume gehen in Erfüllung.","en":"Dreams come true.","audio":"https://tatoeba.org/en/audio/download/70538","words":[{"g":"dreams"},{"g":"to go, to walk"},{"g":"in"},null]},{"text":"Ist dein Wunsch in Erfüllung gegangen?","en":"Did your wish come true?","words":[{"g":"is","l":"sein"},{"g":"your"},{"g":"wish"},{"g":"in"},null,{"g":"to go, to walk","l":"gehen"}]},{"text":"Unsere Träume sind in Erfüllung gegangen.","en":"Our dreams came true.","words":[{"g":"our","l":"unser"},{"g":"dreams"},{"g":"are","l":"sein"},{"g":"in"},null,{"g":"to go, to walk","l":"gehen"}]},{"text":"Ich hoffe, mein Traum wird in Erfüllung gehen.","en":"I hope my dream comes true.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},{"g":"my"},{"g":"dream"},{"g":"to become","l":"werden"},{"g":"in"},null,{"g":"to go, to walk"}]},{"text":"Die Prophezeiung ging in Erfüllung.","en":"The prophecy came to pass.","words":[{"g":"the"},{"g":"prophecy"},{"g":"to go, to walk","l":"gehen"},{"g":"in"},null]}]}