n for the second term.","words":[{"g":"the"},{"g":"president"},{"g":"to say (to pronounce","l":"sagen"},{"g":"he / it"},{"g":"to want","l":"wollen"},{"g":"not"},{"g":"for"},{"g":"a"},{"g":"second"},{"g":"term, office term"},null]},{"text":"Tom hat seine Stellung hier am 20. Oktober 2013 angetreten.","en":"Tom started working here on October 20, 2013.","words":[null,{"g":"has","l":"haben"},{"g":"his","l":"seiner"},{"g":"position, posture"},{"g":"here"},{"g":"at the / on the"},{"g":"October"},null]}]}