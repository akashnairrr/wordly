{"id":"ha_sslich","lemma":"hässlich","pos":"adj","rank":1999,"glosses":["ugly"],"ipa":"/ˈhɛslɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/De-h%C3%A4sslich.ogg/De-h%C3%A4sslich.ogg.mp3","forms":{"comparative":"hässlicher","superlative":"am hässlichsten"},"examples":[{"text":"Es war sehr hässlich.","en":"It was very ugly.","audio":"https://tatoeba.org/en/audio/download/389250","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"very"},null]},{"text":"Mein Haus ist alt und hässlich.","en":"My house is old and ugly.","audio":"https://tatoeba.org/en/audio/download/566841","words":[{"g":"my"},{"g":"house, building"},{"g":"is","l":"sein"},{"g":"old"},{"g":"and"},null]},{"text":"Warum bist du so hässlich?","en":"Why are you so ugly?","words":[{"g":"why"},{"g":"are","l":"sein"},{"g":"you"},{"g":"so"},null]},{"text":"Es ist zu hässlich.","en":"It's too ugly.","audio":"https://tatoeba.org/en/audio/download/140597","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"to / too"},null]},{"text":"Ein hässlicher Mann klopfte an meiner Tür.","en":"An ugly man knocked on my door.","words":[{"g":"a"},null,{"g":"man, male human being"},{"g":"to knock, to rap","l":"klopfen"},{"g":"at / on"},{"g":"my","l":"mein"},{"g":"door"}]}]}