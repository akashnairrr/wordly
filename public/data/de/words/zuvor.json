{"id":"zuvor","lemma":"zuvor","pos":"adv","rank":933,"glosses":["before, previously"],"ipa":"/t͡suˈfoːɐ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/24/De-zuvor.ogg/De-zuvor.ogg.mp3","examples":[{"text":"Ich war noch nie zuvor hier.","en":"I've never been here before.","audio":"https://tatoeba.org/en/audio/download/469925","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"still / yet"},{"g":"never, never at all"},null,{"g":"here"}]},{"text":"Ich sah ihn niemals zuvor.","en":"I never saw him before.","words":[{"g":"I"},{"g":"to see","l":"sehen"},{"g":"him"},{"g":"never"},null]},{"text":"Ich habe ihn nie zuvor gesehen.","en":"I never saw him before.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"him"},{"g":"never, never at all"},null,{"g":"to see","l":"sehen"}]},{"text":"Ich bin so stark wie zuvor.","en":"I'm as strong as before.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"so"},{"g":"strong"},{"g":"how"},null]},{"text":"Er ist stärker als je zuvor.","en":"He is stronger than ever.","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"strong","l":"stark"},{"g":"at the same moment"},{"g":"ever"},null]}]}