{"id":"alarm","lemma":"Alarm","pos":"noun","rank":1548,"glosses":["alert, alarm"],"ipa":"/aˈlaʁm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d3/De-Alarm.ogg/De-Alarm.ogg.mp3","gender":"m","forms":{"genitive":"Alarms","plural":"Alarme"},"examples":[{"text":"Haben Sie den Alarm nicht gehört?","en":"Did you not hear the alarm?","words":[{"g":"have"},{"g":"she / they / you"},{"g":"the","l":"der"},null,{"g":"not"},{"g":"to hear through the ear)","l":"hören"}]},{"text":"Hast du den Alarm gestellt?","en":"Did you turn the alarm on?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"the","l":"der"},null,{"g":"staged"}]},{"text":"War wohl falscher Alarm.","en":"It was probably a false alarm.","words":[{"g":"was","l":"sein"},{"g":"possibly, probably"},{"g":"false","l":"falsch"},null]},{"text":"Jemand hat den Alarm ausgeschaltet.","en":"Someone turned the alarm off.","words":[{"g":"someone, somebody"},{"g":"has","l":"haben"},{"g":"the","l":"der"},null,{"g":"to turn off","l":"ausschalten"}]},{"text":"Wenn du den Alarm hörst, gehen, nicht laufen!","en":"If you hear the alarm, walk, don't run.","words":[{"g":"if / when"},{"g":"you"},{"g":"the","l":"der"},null,{"g":"to hear through the ear)","l":"hören"},{"g":"to go, to walk"},{"g":"not"},{"g":"to walk"}]}]}