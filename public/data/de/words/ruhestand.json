{"id":"ruhestand","lemma":"Ruhestand","pos":"noun","rank":3513,"glosses":["retirement"],"ipa":"/ˈʁuːəˌʃtant/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f6/De-Ruhestand.ogg/De-Ruhestand.ogg.mp3","gender":"m","forms":{"genitive":"Ruhestandes"},"formAudio":{"Ruhestandes":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q188_%28deu%29-Sebastian_Wallroth-Ruhestandes.wav"},"examples":[{"text":"Sind Sie im Ruhestand?","en":"Are you retired?","audio":"https://tatoeba.org/en/audio/download/718235","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},{"g":"in the"},null]},{"text":"Mein Vater ist Lehrer im Ruhestand.","en":"My dad is a retired teacher.","words":[{"g":"my"},{"g":"father"},{"g":"is","l":"sein"},{"g":"to teach","l":"lehren"},{"g":"in the"},null]},{"text":"Ich bin auch im Ruhestand.","en":"I'm retired, too.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"also"},{"g":"in the"},null]},{"text":"Ich will nie in den Ruhestand gehen.","en":"I never want to retire.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"never, never at all"},{"g":"in"},{"g":"the","l":"der"},null,{"g":"to go, to walk"}]},{"text":"Ich freue mich auf meinen Ruhestand.","en":"I'm looking forward to my retirement.","words":[{"g":"I"},{"g":"to gladden","l":"freuen"},{"g":"me","l":"ich"},{"g":"on"},{"g":"to opine, to think"},null]}]}