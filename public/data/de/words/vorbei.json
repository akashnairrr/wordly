{"id":"vorbei","lemma":"vorbei","pos":"adv","rank":275,"glosses":["past"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c2/De-vorbei.ogg/De-vorbei.ogg.mp3","examples":[{"text":"Ist es vorbei?","en":"Is it over?","audio":"https://tatoeba.org/en/audio/download/701210","words":[{"g":"is","l":"sein"},{"g":"it"},null]},{"text":"Kommt ihr vorbei und besucht mich?","en":"Will you come and see me?","audio":"https://tatoeba.org/en/audio/download/759935","words":[{"g":"to come","l":"kommen"},{"g":"you (pl.) / her"},null,{"g":"and"},{"g":"to visit, to see","l":"besuchen"},{"g":"me","l":"ich"}]},{"text":"Deine Zeit ist vorbei.","en":"Your time is over.","audio":"https://tatoeba.org/en/audio/download/698874","words":[{"g":"your","l":"dein"},{"g":"time"},{"g":"is","l":"sein"},null]},{"text":"Er ging am Haus vorbei.","en":"He walked past the house.","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},{"g":"at the / on the"},{"g":"house, building"},null]},{"text":"Es wird bald vorbei sein.","en":"It'll be over soon.","audio":"https://tatoeba.org/en/audio/download/389266","words":[{"g":"it"},{"g":"to become","l":"werden"},{"g":"soon"},null,{"g":"to be"}]}]}