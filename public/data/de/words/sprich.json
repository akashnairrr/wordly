{"id":"sprich","lemma":"sprich","pos":"other","rank":1185,"glosses":["Used to introduce a (typically laconic) clarification or explanation; that is, meaning","Used to parenthetically indicate a pronunciation"],"ipa":"/ʃpʁɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/47/De-sprich.ogg/De-sprich.ogg.mp3","examples":[{"text":"Sprich die Wahrheit!","en":"Tell the truth.","audio":"https://tatoeba.org/en/audio/download/77389","words":[null,{"g":"the"},{"g":"truth"}]},{"text":"Sprich mir nach!","en":"Repeat after me.","audio":"https://tatoeba.org/en/audio/download/42007","words":[null,{"g":"(to) me","l":"ich"},{"g":"after / to"}]},{"text":"Sprich bitte langsam.","en":"Speak slowly, please.","words":[null,{"g":"please"},{"g":"slowly"}]},{"text":"Sprich mich bitte nicht an!","en":"Please don't speak to me.","audio":"https://tatoeba.org/en/audio/download/567059","words":[null,{"g":"me","l":"ich"},{"g":"please"},{"g":"not"},{"g":"at / on"}]},{"text":"Sprich nicht schlecht über andere!","en":"Don't say bad things about others.","audio":"https://tatoeba.org/en/audio/download/745462","words":[null,{"g":"not"},{"g":"bad"},{"g":"[with accusative or…"},{"g":"another , others","l":"anderer"}]}]}