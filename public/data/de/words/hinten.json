{"id":"hinten","lemma":"hinten","pos":"adv","rank":598,"glosses":["behind; in the back","over (there); yonder (unspecified locative for something at some distance)"],"ipa":"/ˈhɪntən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9c/De-hinten.ogg/De-hinten.ogg.mp3","examples":[{"text":"Dein Hund ist da hinten.","en":"Your dog is back there.","audio":"https://tatoeba.org/en/audio/download/759807","words":[{"g":"your"},{"g":"dog, hound"},{"g":"is","l":"sein"},{"g":"there"},null]},{"text":"Darf ich hinten sitzen?","en":"May I sit in the back?","words":[{"g":"to be allowed","l":"dürfen"},{"g":"I"},null,{"g":"to sit"}]},{"text":"Wir wurden von hinten angegriffen.","en":"We were attacked from behind.","words":[{"g":"we"},{"g":"to become","l":"werden"},{"g":"from / of"},null,{"g":"attacked"}]},{"text":"Hast du da hinten etwas gesehen?","en":"Did you see anything back there?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"there"},null,{"g":"something"},{"g":"to see","l":"sehen"}]},{"text":"Was treibt ihr da hinten?","en":"What are you doing back there?","words":[{"g":"what"},{"g":"to drive","l":"treiben"},{"g":"you (pl.) / her"},{"g":"there"},null]}]}