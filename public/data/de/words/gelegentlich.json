{"id":"gelegentlich","lemma":"gelegentlich","pos":"prep","rank":4058,"glosses":["during, on the occasion of"],"ipa":"/ɡəˈleːɡəntlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/44/De-gelegentlich.ogg/De-gelegentlich.ogg.mp3","examples":[{"text":"Mein Onkel kommt mich gelegentlich besuchen.","en":"My uncle comes to see me once in a while.","words":[{"g":"my"},{"g":"uncle"},{"g":"to come","l":"kommen"},{"g":"me","l":"ich"},null,{"g":"to visit, to see"}]},{"text":"Bitte schreiben Sie mir gelegentlich.","en":"Please write to me once in a while.","words":[{"g":"please"},{"g":"to write, to write out"},{"g":"she / they / you"},{"g":"(to) me","l":"ich"},null]},{"text":"Wir sehen sie gelegentlich.","en":"We see them on occasion.","words":[{"g":"we"},{"g":"to see"},{"g":"she / they / you"},null]},{"text":"Er hat mich gelegentlich besucht.","en":"He occasionally visited me.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"me","l":"ich"},null,{"g":"to visit, to see","l":"besuchen"}]},{"text":"Sie besuchten mich gelegentlich.","en":"They visited me occasionally.","words":[{"g":"she / they / you"},{"g":"to visit, to see","l":"besuchen"},{"g":"me","l":"ich"},null]}]}