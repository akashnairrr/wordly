{"id":"woanders","lemma":"woanders","pos":"adv","rank":1299,"glosses":["elsewhere, somewhere else"],"ipa":"/voˈʔandɐs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/42/De-woanders.ogg/De-woanders.ogg.mp3","examples":[{"text":"Willst du woanders sitzen?","en":"Do you want to sit somewhere else?","words":[{"g":"to want","l":"wollen"},{"g":"you"},null,{"g":"to sit"}]},{"text":"Ich wäre lieber woanders.","en":"I'd rather be somewhere else.","audio":"https://tatoeba.org/en/audio/download/698742","words":[{"g":"I"},{"g":"to be","l":"sein"},{"g":"lovable","l":"lieb"},null]},{"text":"Kannst du das woanders machen?","en":"Can you do that somewhere else?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"the / that"},null,{"g":"to make"}]},{"text":"Können wir woanders darüber reden?","en":"Can we talk about it somewhere else?","words":[{"g":"can, to be able to"},{"g":"we"},null,{"g":"above"},{"g":"to talk"}]},{"text":"Sie waren woanders.","en":"They were somewhere else.","words":[{"g":"she / they / you"},{"g":"to be","l":"sein"},null]}]}