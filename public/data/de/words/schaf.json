{"id":"schaf","lemma":"Schaf","pos":"noun","rank":3258,"glosses":["sheep"],"ipa":"/ʃaːf/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/67/De-Schaf2.ogg/De-Schaf2.ogg.mp3","gender":"n","forms":{"genitive":"Schafes","plural":"Schafe"},"formAudio":{"Schafes":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q188_%28deu%29-Sebastian_Wallroth-Schafes.wav","Schafe":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q188_%28deu%29-Sebastian_Wallroth-Schafe.wav"},"examples":[{"text":"Ich habe viele Schafe.","en":"I have a lot of sheep.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"much, a lot","l":"viel"},null]},{"text":"Zeichne mir ein Schaf.","en":"Draw me a sheep.","audio":"https://tatoeba.org/en/audio/download/717830","words":[{"g":"to draw, to sketch","l":"zeichnen"},{"g":"(to) me","l":"ich"},{"g":"a"},null]},{"text":"Schafe fressen Gras.","en":"Sheep feed on grass.","words":[null,{"g":"to eat"},{"g":"grass"}]},{"text":"Ich bin das schwarze Schaf der Familie.","en":"I'm the black sheep of the family.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"the / that"},{"g":"a black object or being","l":"Schwarzer"},null,{"g":"the"},{"g":"family"}]},{"text":"Ich habe versucht, Schafe zu zählen.","en":"I tried counting sheep.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"to try, to attempt","l":"versuchen"},null,{"g":"to / too"},{"g":"to count"}]}]}