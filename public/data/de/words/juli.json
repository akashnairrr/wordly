{"id":"juli","lemma":"Juli","pos":"noun","rank":2450,"glosses":["July (the seventh month of the Gregorian calendar, following June and preceding August)"],"ipa":"/ˈjuːli/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/De-Juli.ogg/De-Juli.ogg.mp3","gender":"m","forms":{"genitive":"Julis","plural":"Julis"},"formAudio":{"Julis":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q188_%28deu%29-Sebastian_Wallroth-Julis.wav"},"examples":[{"text":"Ich bin schon seit Juli hier.","en":"I've been here since July.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"already"},{"g":"since"},null,{"g":"here"}]},{"text":"Sie bekommt ihr Kind im Juli.","en":"She will give birth in July.","words":[{"g":"she / they / you"},{"g":"to receive","l":"bekommen"},{"g":"you (pl.) / her"},{"g":"kid"},{"g":"in the"},null]},{"text":"Er ist am 28. Juli 1888 geboren.","en":"He was born on July 28th, 1888.","audio":"https://tatoeba.org/en/audio/download/1997","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"at the / on the"},null,{"g":"to give birth","l":"gebären"}]},{"text":"Ich komme jeden vierten Juli hierher.","en":"I come here every Fourth of July.","words":[{"g":"I"},{"g":"to come","l":"kommen"},{"g":"each","l":"jeder"},{"g":"fourth","l":"vierte"},null,{"g":"to here, here , hither"}]},{"text":"Die Sommerferien beginnen im Juli.","en":"Summer holiday begins in July.","words":[{"g":"the"},{"g":"summer holidays"},{"g":"to begin"},{"g":"in the"},null]}]}