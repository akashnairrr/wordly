{"id":"ohne","lemma":"ohne","pos":"prep","rank":143,"glosses":["without"],"ipa":"/ˈoːnə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/36/De-ohne.ogg/De-ohne.ogg.mp3","examples":[{"text":"Was wäre die Welt ohne Frauen?","en":"What would the world be without women?","audio":"https://tatoeba.org/en/audio/download/239","words":[{"g":"what"},{"g":"to be","l":"sein"},{"g":"the"},{"g":"world"},null,{"g":"woman","l":"Frau"}]},{"text":"Geht ohne mich!","en":"Go without me.","audio":"https://tatoeba.org/en/audio/download/497197","words":[{"g":"to go, to walk","l":"gehen"},null,{"g":"me","l":"ich"}]},{"text":"Sind Sie ohne Arbeit?","en":"Are you out of work?","audio":"https://tatoeba.org/en/audio/download/565930","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},null,{"g":"toil"}]},{"text":"Ich gehe ohne dich.","en":"I'll go without you.","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null,{"g":"you","l":"du"}]},{"text":"Ohne dich kann ich nicht leben.","en":"I can't live without you.","audio":"https://tatoeba.org/en/audio/download/787661","words":[null,{"g":"you","l":"du"},{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"not"},{"g":"a state in which…"}]}]}