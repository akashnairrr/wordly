{"id":"sanft","lemma":"sanft","pos":"adj","rank":2967,"glosses":["gentle"],"ipa":"/zanft/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/af/De-sanft.ogg/De-sanft.ogg.mp3","forms":{"comparative":"sanfter","superlative":"am sanftesten"},"examples":[{"text":"Sei sanft, aber bestimmt.","en":"Be gentle, but firm.","words":[{"g":"to be","l":"sein"},null,{"g":"but"},{"g":"certain"}]},{"text":"Es fiel ein sanfter Regen.","en":"A gentle rain fell.","words":[{"g":"it"},{"g":"to fall, to drop","l":"fallen"},{"g":"a"},null,{"g":"rain"}]},{"text":"Er stubste mich sanft an.","en":"He pushed me gently.","words":[{"g":"he / it"},null,{"g":"me","l":"ich"},null,{"g":"at / on"}]},{"text":"Der Zug hielt sanft an.","en":"The train came to a smooth stop.","words":[{"g":"the"},{"g":"train"},{"g":"to hold","l":"halten"},null,{"g":"at / on"}]},{"text":"Sie sprach mit sanfter Stimme zu den Kindern.","en":"She spoke to the children in a gentle voice.","words":[{"g":"she / they / you"},{"g":"to speak","l":"sprechen"},{"g":"with"},null,{"g":"voice"},{"g":"to / too"},{"g":"the","l":"der"},{"g":"kid","l":"Kind"}]}]}