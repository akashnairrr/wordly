{"id":"flieger","lemma":"Flieger","pos":"noun","rank":3037,"glosses":["aviator"],"ipa":"/ˈfliːɡɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/25/De-at-Flieger.ogg/De-at-Flieger.ogg.mp3","gender":"m","forms":{"genitive":"Fliegers","plural":"Flieger","feminine":"Fliegerin"},"examples":[{"text":"Der Flieger kommt um drei an.","en":"The plane will arrive at three.","words":[{"g":"the"},null,{"g":"to come","l":"kommen"},{"g":"around / at"},{"g":"three (numerical value…"},{"g":"at / on"}]},{"text":"Der nächste Flieger geht um 14.30 Uhr.","en":"The next flight is at 2:30.","words":[{"g":"the"},{"g":"near","l":"nah"},null,{"g":"to go, to walk","l":"gehen"},{"g":"around / at"},{"g":"hours, o'clock"}]},{"text":"Ich habe meinen zwei Uhr Flieger nicht bekommen.","en":"I missed the two o'clock plane.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"to opine, to think"},{"g":"two (numerical value…"},{"g":"hours, o'clock"},null,{"g":"not"},{"g":"to receive"}]},{"text":"Wann startet mein Flieger?","en":"What time does my flight leave?","words":[{"g":"when"},{"g":"to start","l":"starten"},{"g":"my"},null]},{"text":"Sein Flieger ist noch nicht am Flughafen angekommen.","en":"His plane has not arrived at the airport yet.","words":[{"g":"to be"},null,{"g":"is","l":"sein"},null,null,{"g":"at the / on the"},{"g":"airport"},{"g":"to arrive","l":"ankommen"}],"phrases":[[3,5,"not yet"]]}]}