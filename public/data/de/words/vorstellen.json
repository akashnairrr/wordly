{"id":"vorstellen","lemma":"vorstellen","pos":"verb","rank":534,"glosses":["to introduce (someone), to present","to introduce oneself","to imagine, to envision"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/De-vorstellen.ogg/De-vorstellen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"stelle vor","1p":"stellen vor","2s":"stellst vor","2p":"stellt vor","3s":"stellt vor","3p":"stellen vor"},"preterite":{"1s":"stellte vor","1p":"stellten vor","2s":"stelltest vor","2p":"stelltet vor","3s":"stellte vor","3p":"stellten vor"},"perfect":{"1s":"habe vorgestellt","1p":"haben vorgestellt","2s":"hast vorgestellt","2p":"habt vorgestellt","3s":"hat vorgestellt","3p":"haben vorgestellt"},"future":{"1s":"werde vorstellen","1p":"werden vorstellen","2s":"wirst vorstellen","2p":"werdet vorstellen","3s":"wird vorstellen","3p":"werden vorstellen"}},"imperative":{"affirmative":{"2s":"stell vor","2p":"stellt vor"}},"subjunctive":{"conditional":{"1s":"würde vorstellen","1p":"würden vorstellen","2s":"würdest vorstellen","2p":"würdet vorstellen","3s":"würde vorstellen","3p":"würden vorstellen"}}},"nonFinite":{"participle":"vorgestellt"},"examples":[{"text":"Darf ich mich vorstellen?","en":"May I introduce myself?","audio":"https://tatoeba.org/en/audio/download/758329","words":[{"g":"to be allowed","l":"dürfen"},{"g":"I"},{"g":"me","l":"ich"},null]},{"text":"Ich möchte dir meinen Sohn vorstellen.","en":"I'd like you to meet my son.","audio":"https://tatoeba.org/en/audio/download/469985","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"(to) you","l":"du"},{"g":"to opine, to think"},{"g":"son"},null]},{"text":"Würdest du dich bitte vorstellen?","en":"Would you please introduce yourself?","words":[{"g":"to become","l":"werden"},{"g":"you"},{"g":"you","l":"du"},{"g":"please"},null]},{"text":"Ich kann es mir nicht vorstellen.","en":"I can't imagine it.","audio":"https://tatoeba.org/en/audio/download/391419","words":[{"g":"I"},{"g":"can, to be able to","l":"kö