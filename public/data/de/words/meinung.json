{"id":"meinung","lemma":"Meinung","pos":"noun","rank":579,"glosses":["opinion"],"ipa":"/ˈmaɪ̯nʊŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4b/De-at-Meinung.ogg/De-at-Meinung.ogg.mp3","gender":"f","forms":{"genitive":"Meinung","plural":"Meinungen"},"examples":[{"text":"Ist das eure Meinung?","en":"Is that your opinion?","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"your","l":"euer"},null]},{"text":"Möchtest du meine Meinung hören?","en":"Do you want my opinion?","audio":"https://tatoeba.org/en/audio/download/756782","words":[{"g":"to like","l":"mögen"},{"g":"you"},{"g":"my","l":"mein"},null,{"g":"to hear through the ear)"}]},{"text":"Ich werde meine Meinung nie ändern.","en":"I'll never change my mind.","audio":"https://tatoeba.org/en/audio/download/760684","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"my","l":"mein"},null,{"g":"never, never at all"},{"g":"to change, to alter"}]},{"text":"Seine Meinungen haben Gewicht.","en":"His opinions carry weight.","audio":"https://tatoeba.org/en/audio/download/760784","words":[{"g":"his","l":"seiner"},null,{"g":"have"},{"g":"weight"}]},{"text":"Deine Meinung ist mir wichtig.","en":"Your opinion is important to me.","words":[{"g":"your","l":"dein"},null,{"g":"is","l":"sein"},{"g":"(to) me","l":"ich"},{"g":"important"}]}]}