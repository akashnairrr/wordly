{"id":"zufa_llig","lemma":"zufällig","pos":"adv","rank":1004,"glosses":["accidentally","by (any) chance"],"ipa":"/ˈt͡suːfɛlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/35/De-at-zuf%C3%A4llig.ogg/De-at-zuf%C3%A4llig.ogg.mp3","examples":[{"text":"Ich habe ihn zufällig getroffen.","en":"I met him by chance.","audio":"https://tatoeba.org/en/audio/download/745216","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"him"},null,{"g":"hit, struck, met"}]},{"text":"Hast du zufällig Zeit?","en":"Do you happen to have the time?","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"time"}]},{"text":"Kennst du ihn zufällig?","en":"Do you know him, by any chance?","words":[{"g":"to know","l":"kennen"},{"g":"you"},{"g":"him"},null]},{"text":"Kennen Sie ihn zufällig?","en":"Do you know him, by any chance?","words":[{"g":"to know"},{"g":"she / they / you"},{"g":"him"},null]},{"text":"Es geschah zufällig.","en":"It happened by accident.","audio":"https://tatoeba.org/en/audio/download/564447","words":[{"g":"it"},{"g":"to occur","l":"geschehen"},null]}]}