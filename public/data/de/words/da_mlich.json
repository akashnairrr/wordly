{"id":"da_mlich","lemma":"dämlich","pos":"adj","rank":2976,"glosses":["very stupid"],"ipa":"/ˈdɛːmlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d6/De-d%C3%A4mlich.wav/De-d%C3%A4mlich.wav.mp3","forms":{"comparative":"dämlicher","superlative":"am dämlichsten"},"examples":[{"text":"Ich bin so dämlich.","en":"I'm so stupid.","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"so"},null]},{"text":"Das war ein dämlicher Fehler.","en":"It was a foolish mistake.","words":[{"g":"the / that"},{"g":"was","l":"sein"},{"g":"a"},null,{"g":"fault, error, mistake"}]},{"text":"Ich wollte nicht dämlich aussehen.","en":"I didn't want to look foolish.","audio":"https://tatoeba.org/en/audio/download/562230","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"not"},null,{"g":"to look, seem"}]},{"text":"Sie ist dämlich.","en":"She's stupid.","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},null]},{"text":"Ihr seid dämlich.","en":"You're silly.","audio":"https://tatoeba.org/en/audio/download/263778","words":[{"g":"you (pl.) / her"},{"g":"are","l":"sein"},null]}]}