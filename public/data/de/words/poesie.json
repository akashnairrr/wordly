{"id":"poesie","lemma":"Poesie","pos":"noun","rank":4956,"glosses":["poetry","poem","poetic mood"],"ipa":"/ˌpoeˈzi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/De-Poesie.ogg/De-Poesie.ogg.mp3","gender":"f","forms":{"genitive":"Poesie","plural":"Poesien"},"examples":[{"text":"Sie hatte Poesie und Musik gern.","en":"She was fond of poetry and music.","words":[{"g":"she / they / you"},{"g":"to have","l":"haben"},null,{"g":"and"},{"g":"music"},{"g":"willingly"}]},{"text":"Ich schreibe keine Poesie.","en":"I don't write poetry.","words":[{"g":"I"},{"g":"to write, to write out","l":"schreiben"},{"g":"no / not a","l":"kein"},null]},{"text":"Poesie braucht nicht logisch zu sein.","en":"Poetry doesn't need to be logical.","words":[null,{"g":"to need","l":"brauchen"},{"g":"not"},{"g":"logically"},{"g":"to / too"},{"g":"to be"}]},{"text":"Wein ist in Flaschen gefüllte Poesie.","en":"Wine is poetry put into a bottle.","words":[{"g":"wine"},{"g":"is","l":"sein"},{"g":"in"},{"g":"bottle","l":"Flasche"},{"g":"stuffed, filled","l":"gefüllt"},null]}]}