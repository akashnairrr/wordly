{"id":"hoffen","lemma":"hoffen","pos":"verb","rank":316,"glosses":["to hope"],"ipa":"/ˈhɔfən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bd/De-hoffen.ogg/De-hoffen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"hoffe","1p":"hoffen","2s":"hoffst","2p":"hofft","3s":"hofft","3p":"hoffen"},"preterite":{"1s":"hoffte","1p":"hofften","2s":"hofftest","2p":"hofftet","3s":"hoffte","3p":"hofften"},"perfect":{"1s":"habe gehofft","1p":"haben gehofft","2s":"hast gehofft","2p":"habt gehofft","3s":"hat gehofft","3p":"haben gehofft"},"future":{"1s":"werde hoffen","1p":"werden hoffen","2s":"wirst hoffen","2p":"werdet hoffen","3s":"wird hoffen","3p":"werden hoffen"}},"imperative":{"affirmative":{"2s":"hoff","2p":"hofft"}},"subjunctive":{"conditional":{"1s":"würde hoffen","1p":"würden hoffen","2s":"würdest hoffen","2p":"würdet hoffen","3s":"würde hoffen","3p":"würden hoffen"}}},"nonFinite":{"participle":"gehofft"},"examples":[{"text":"Ich hoffe nicht.","en":"I hope not.","audio":"https://tatoeba.org/en/audio/download/395098","words":[{"g":"I"},null,{"g":"not"}]},{"text":"Ich hoffe, wir gewinnen.","en":"I hope we win.","audio":"https://tatoeba.org/en/audio/download/745854","words":[{"g":"I"},null,{"g":"we"},{"g":"to win"}]},{"text":"Wir alle hoffen auf Frieden.","en":"We all hope for peace.","audio":"https://tatoeba.org/en/audio/download/755552","words":[{"g":"we"},{"g":"all, everyone"},null,{"g":"on"},{"g":"peace"}]},{"text":"Ich hoffe, es funktioniert.","en":"I hope it works.","audio":"https://tatoeba.org/en/audio/download/153039","words":[{"g":"I"},null,{"g":"it"},{"g":"to work, function","l":"funktionieren"}]},{"text":"Ich hatte gehofft, wir könnten Freunde werden.","en":"I had hoped we might become friends.","audio":"https://tatoeba.org/en/audio/download/786655","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"we"},{"g":"can, to be able to","l":"können"},{"g":"friends"},{"g":"to become"}]}]}