{"id":"heulen","lemma":"heulen","pos":"verb","rank":2462,"glosses":["to howl, to whine (make a loud, usually high-pitched sound)","to weep, to cry (see usage notes)"],"ipa":"/ˈhɔʏ̯lən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8c/De-heulen.ogg/De-heulen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"heule","1p":"heulen","2s":"heulst","2p":"heult","3s":"heult","3p":"heulen"},"preterite":{"1s":"heulte","1p":"heulten","2s":"heultest","2p":"heultet","3s":"heulte","3p":"heulten"},"perfect":{"1s":"habe geheult","1p":"haben geheult","2s":"hast geheult","2p":"habt geheult","3s":"hat geheult","3p":"haben geheult"},"future":{"1s":"werde heulen","1p":"werden heulen","2s":"wirst heulen","2p":"werdet heulen","3s":"wird heulen","3p":"werden heulen"}},"imperative":{"affirmative":{"2s":"heul","2p":"heult"}},"subjunctive":{"conditional":{"1s":"würde heulen","1p":"würden heulen","2s":"würdest heulen","2p":"würdet heulen","3s":"würde heulen","3p":"würden heulen"}}},"nonFinite":{"participle":"geheult"},"examples":[{"text":"Der Wind heult.","en":"The wind is howling.","words":[{"g":"the"},{"g":"wind"},null]},{"text":"Ich hätte fast geheult.","en":"I almost cried.","audio":"https://tatoeba.org/en/audio/download/152275","words":[{"g":"I"},{"g":"to have","l":"haben"},{"g":"almost"},null]},{"text":"Gestern Nacht hörte ich Hunde heulen.","en":"Last night, I heard dogs howling.","words":[null,null,{"g":"to hear through the ear)","l":"hören"},{"g":"I"},{"g":"dog, hound","l":"Hund"},null],"phrases":[[0,2,"last night"]]},{"text":"Hat das Baby dann geheult?","en":"Was the baby crying then?","words":[{"g":"has","l":"haben"},{"g":"the / that"},{"g":"baby"},{"g":"then, after that"},null]},{"text":"Jetzt heul’ ich aber!","en":"I'm going to go cry now.","words":[{"g":"now"},null,{"g":"I"},{"g":"but"}]}]}