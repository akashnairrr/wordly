{"id":"kein","lemma":"kein","pos":"pron","rank":53,"glosses":["no; not a(n); not one; not any"],"ipa":"/kaɪ̯n/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/67/De-kein.ogg/De-kein.ogg.mp3","forms":{"plural":"keine"},"examples":[{"text":"Ich habe kein Geld.","en":"I have no money.","audio":"https://tatoeba.org/en/audio/download/28653","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"money"}]},{"text":"Sag kein Wort.","en":"Don't say a word.","audio":"https://tatoeba.org/en/audio/download/593420","words":[{"g":"to say (to pronounce","l":"sagen"},null,{"g":"word as an isolated unit"}]},{"text":"Wir haben kein Geld.","en":"We have no money.","audio":"https://tatoeba.org/en/audio/download/566737","words":[{"g":"we"},{"g":"have"},null,{"g":"money"}]},{"text":"Er kann kein Auto kaufen.","en":"He can't buy a car.","audio":"https://tatoeba.org/en/audio/download/393509","words":[{"g":"he / it"},{"g":"can, to be able to","l":"können"},null,{"g":"car"},{"g":"to buy, to purchase"}]},{"text":"Ich brauche kein Auto.","en":"I don't need a car.","audio":"https://tatoeba.org/en/audio/download/391527","words":[{"g":"I"},{"g":"to need","l":"brauchen"},null,{"g":"car"}]}]}