{"id":"rekord","lemma":"Rekord","pos":"noun","rank":4354,"glosses":["record (most extreme known value of some achievement)"],"ipa":"/ʁeˈkɔʁt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/86/De-Rekord.ogg/De-Rekord.ogg.mp3","gender":"m","forms":{"genitive":"Rekordes","plural":"Rekorde"},"examples":[{"text":"Er hat den Rekord gebrochen.","en":"He has broken the record.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"the","l":"der"},null,{"g":"broken"}]},{"text":"Er hält einen Rekord im Schwimmen.","en":"He holds a record in swimming.","words":[{"g":"he / it"},{"g":"to hold","l":"halten"},{"g":"a","l":"ein"},null,{"g":"in the"},{"g":"to swim"}]},{"text":"Das ist ein neuer Rekord.","en":"That's a new record.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"a"},{"g":"new","l":"neu"},null]},{"text":"Niemand kann seinen Rekord brechen.","en":"Nobody can break his record.","words":[{"g":"nobody, no one"},{"g":"can, to be able to","l":"können"},{"g":"to be","l":"sein"},null,{"g":"to break"}]},{"text":"Sein Rekord wird nie gebrochen werden.","en":"His record will never be broken.","words":[{"g":"to be"},null,{"g":"to become","l":"werden"},{"g":"never, never at all"},{"g":"broken"},{"g":"to become"}]}]}