{"id":"dicht","lemma":"dicht","pos":"adj","rank":1775,"glosses":["thick, tight, dense","impermeable, sealed, shut, locked (preventing passage or entrance)","closed, out of operation, out of business"],"ipa":"/dɪçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/De-dicht.ogg/De-dicht.ogg.mp3","forms":{"comparative":"dichter","superlative":"am dichtesten"},"examples":[{"text":"Er ist Dichter.","en":"He is a poet.","audio":"https://tatoeba.org/en/audio/download/28844","words":[{"g":"he / it"},{"g":"is","l":"sein"},null]},{"text":"Der Wald ist sehr dicht.","en":"The forest is very thick.","words":[{"g":"the"},{"g":"forest"},{"g":"is","l":"sein"},{"g":"very"},null]},{"text":"Sie stand dicht bei ihm.","en":"She stood close to him.","audio":"https://tatoeba.org/en/audio/download/469811","words":[{"g":"she / they / you"},{"g":"to stand","l":"stehen"},null,{"g":"at / with"},{"g":"(to) him","l":"er"}]},{"text":"Er kann kein Dichter sein.","en":"He cannot be a poet.","words":[{"g":"he / it"},{"g":"can, to be able to","l":"können"},{"g":"no / not a"},null,{"g":"to be"}]},{"text":"Schlaf nicht zu dicht am Feuer!","en":"Don't sleep too close to the fire.","audio":"https://tatoeba.org/en/audio/download/746530","words":[{"g":"sleep"},{"g":"not"},{"g":"to / too"},null,{"g":"at the / on the"},{"g":"fire"}]}]}