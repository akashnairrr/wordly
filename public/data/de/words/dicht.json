{"id":"dicht","lemma":"dicht","pos":"adj","rank":1771,"glosses":["thick, tight, dense","impermeable, sealed, shut, locked (preventing passage or entrance)","closed, out of operation, out of business"],"ipa":"/dɪçt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/De-dicht.ogg/De-dicht.ogg.mp3","forms":{"comparative":"dichter","superlative":"am dichtesten"},"examples":[{"text":"Der Wald ist sehr dicht.","en":"The forest is very thick.","words":[{"g":"the"},{"g":"forest"},{"g":"is","l":"sein"},{"g":"very"},null]},{"text":"Sie stand dicht bei ihm.","en":"She stood close to him.","audio":"https://tatoeba.org/en/audio/download/469811","words":[{"g":"she / they / you"},{"g":"to stand","l":"stehen"},null,{"g":"at / with"},{"g":"(to) him","l":"er"}]},{"text":"Schlaf nicht zu dicht am Feuer!","en":"Don't sleep too close to the fire.","audio":"https://tatoeba.org/en/audio/download/746530","words":[{"g":"sleep"},{"g":"not"},{"g":"to / too"},null,{"g":"at the / on the"},{"g":"fire"}]},{"text":"Ich werd' dicht.","en":"I'm getting high.","words":[{"g":"I"},{"g":"to become","l":"werden"},null]},{"text":"Mein Geburtstag liegt dicht an deinem.","en":"My birthday is close to yours.","words":[{"g":"my"},{"g":"birthday"},{"g":"to lie","l":"liegen"},null,{"g":"at / on"},{"g":"thy, your .","l":"dein"}]}]}