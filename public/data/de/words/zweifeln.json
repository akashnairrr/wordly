{"id":"zweifeln","lemma":"zweifeln","pos":"verb","rank":4051,"glosses":["to doubt, to be doubtful"],"ipa":"/ˈtsvaɪ̯fəln/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b9/De-zweifeln.ogg/De-zweifeln.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"zweifle","1p":"zweifeln","2s":"zweifelst","2p":"zweifelt","3s":"zweifelt","3p":"zweifeln"},"preterite":{"1s":"zweifelte","1p":"zweifelten","2s":"zweifeltest","2p":"zweifeltet","3s":"zweifelte","3p":"zweifelten"},"perfect":{"1s":"habe gezweifelt","1p":"haben gezweifelt","2s":"hast gezweifelt","2p":"habt gezweifelt","3s":"hat gezweifelt","3p":"haben gezweifelt"},"future":{"1s":"werde zweifeln","1p":"werden zweifeln","2s":"wirst zweifeln","2p":"werdet zweifeln","3s":"wird zweifeln","3p":"werden zweifeln"}},"imperative":{"affirmative":{"2s":"zweifle","2p":"zweifelt"}},"subjunctive":{"conditional":{"1s":"würde zweifeln","1p":"würden zweifeln","2s":"würdest zweifeln","2p":"würdet zweifeln","3s":"würde zweifeln","3p":"würden zweifeln"}}},"nonFinite":{"participle":"gezweifelt"},"examples":[{"text":"Zweifeln Sie noch immer?","en":"Do you still have doubts?","words":[null,{"g":"she / they / you"},{"g":"still / yet"},{"g":"at all times without…"}]},{"text":"Ich habe keine Sekunde daran gezweifelt.","en":"I never doubted it for a moment.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"no / not a","l":"kein"},{"g":"A unit of time"},{"g":"on it, on that"},null]},{"text":"Er zweifelt noch immer.","en":"He is still having doubts.","words":[{"g":"he / it"},null,{"g":"still / yet"},{"g":"at all times without…"}]},{"text":"Zweifle niemals daran!","en":"Don't ever doubt it.","words":[null,{"g":"never"},{"g":"on it, on that"}]},{"text":"Ich habe keinen Grund, daran zu zweifeln.","en":"I have no reason to doubt that.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"no / not a","l":"kein"},{"g":"ground, land"},{"g":"on it, on that"},{"g":"to / too"},null]}]}