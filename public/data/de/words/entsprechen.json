{"id":"entsprechen","lemma":"entsprechen","pos":"verb","rank":3563,"glosses":["to correspond (be equivalent or similar in character, etc.)","to meet (satisfy, comply with)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/79/De-entsprechen.ogg/De-entsprechen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"entspreche","1p":"entsprechen","2s":"entsprichst","2p":"entsprecht","3s":"entspricht","3p":"entsprechen"},"preterite":{"1s":"entsprach","1p":"entsprachen","2s":"entsprachst","2p":"entspracht","3s":"entsprach","3p":"entsprachen"},"perfect":{"1s":"habe entsprochen","1p":"haben entsprochen","2s":"hast entsprochen","2p":"habt entsprochen","3s":"hat entsprochen","3p":"haben entsprochen"},"future":{"1s":"werde entsprechen","1p":"werden entsprechen","2s":"wirst entsprechen","2p":"werdet entsprechen","3s":"wird entsprechen","3p":"werden entsprechen"}},"imperative":{"affirmative":{"2s":"entsprich","2p":"entsprecht"}},"subjunctive":{"conditional":{"1s":"würde entsprechen","1p":"würden entsprechen","2s":"würdest entsprechen","2p":"würdet entsprechen","3s":"würde entsprechen","3p":"würden entsprechen"}}},"nonFinite":{"participle":"entsprochen"},"examples":[{"text":"Meine Meinung entspricht etwa deiner.","en":"My opinion is similar to yours.","words":[{"g":"my","l":"mein"},{"g":"opinion"},null,{"g":"approximately"},{"g":"yours, thine"}]},{"text":"Der Mann entspricht der Beschreibung.","en":"The man answers the description.","words":[{"g":"the"},{"g":"man, male human being"},null,{"g":"the"},{"g":"description"}]},{"text":"Deine Arbeit entsprach nicht unseren Erwartungen.","en":"Your work didn't come up to our expectations.","words":[{"g":"your","l":"dein"},{"g":"toil"},null,{"g":"not"},{"g":"our","l":"unser"},{"g":"expectation","l":"Erwartung"}]},{"text":"Eine Minute entspricht sechzig Sekunden.","en":"A minute has sixty seconds.","words":[{"g":"a"},{"g":"minute (unit of time"},null,{"g":"sixty"},{"g":"A unit of time","l":"Sekunde"}]},{"text":"Es entsprach nicht seiner Natur, schlecht über Andere zu sprechen.","en":"It was not in his nature to speak ill of others.","words":[{"g":"it"},null,{"g":"not"},{"g":"his"},{"g":"nature"},{"g":"bad"},{"g":"[with accusative or…"},{"g":"another , others","l":"anderer"},{"g":"to / too"},{"g":"to speak"}]}]}