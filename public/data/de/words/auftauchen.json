rty"},{"g":"is","l":"sein"},{"g":"she / they / you"},{"g":"yesterday"},{"g":"not"},null]},{"text":"Tom ist nie wieder aufgetaucht.","en":"Tom never turned up again.","words":[null,{"g":"is","l":"sein"},{"g":"never, never at all"},{"g":"again"},null]}]}