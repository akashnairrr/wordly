{"id":"gelogen","lemma":"gelogen","pos":"adj","rank":1204,"glosses":["untrue; having been lied about"],"ipa":"/ɡəˈloːɡən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e6/De-gelogen.ogg/De-gelogen.ogg.mp3","examples":[{"text":"Warum hast du gelogen?","en":"Why did you lie?","audio":"https://tatoeba.org/en/audio/download/39616","words":[{"g":"why"},{"g":"have","l":"haben"},{"g":"you"},null]},{"text":"Das wäre gelogen.","en":"That would be a lie.","audio":"https://tatoeba.org/en/audio/download/698776","words":[{"g":"the / that"},{"g":"to be","l":"sein"},null]},{"text":"Haben sie gelogen?","en":"Were they lying?","audio":"https://tatoeba.org/en/audio/download/389499","words":[{"g":"have"},{"g":"she / they / you"},null]},{"text":"Ich habe gelogen.","en":"I lied.","audio":"https://tatoeba.org/en/audio/download/194951","words":[{"g":"I"},{"g":"have","l":"haben"},null]},{"text":"Er hat mir ins Gesicht gelogen.","en":"He lied to my face.","audio":"https://tatoeba.org/en/audio/download/393507","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"(to) me","l":"ich"},{"g":"into the"},{"g":"face"},null]}]}