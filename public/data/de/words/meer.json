{"id":"meer","lemma":"Meer","pos":"noun","rank":1063,"glosses":["sea"],"ipa":"/meːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/43/De-Meer.ogg/De-Meer.ogg.mp3","gender":"n","forms":{"genitive":"Meeres","plural":"Meere"},"examples":[{"text":"Sie hat ein Haus am Meer.","en":"She has a house by the sea.","audio":"https://tatoeba.org/en/audio/download/789439","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"a"},{"g":"house, building"},{"g":"at the / on the"},null]},{"text":"Das Meer ist ruhig.","en":"The sea is calm.","audio":"https://tatoeba.org/en/audio/download/786668","words":[{"g":"the / that"},null,{"g":"is","l":"sein"},{"g":"quietly"}]},{"text":"Er hat Angst vor dem Meer.","en":"He's afraid of the sea.","audio":"https://tatoeba.org/en/audio/download/566624","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"fear"},{"g":"in front of, ahead of"},{"g":"(to) the","l":"der"},null]},{"text":"Er wollte ans Meer fahren.","en":"He wanted to go to sea.","words":[{"g":"he / it"},{"g":"to want","l":"wollen"},null,null,{"g":"to go at speed"}]},{"text":"Rechts sehen Sie das Meer.","en":"If you look to your right, you'll see the sea.","words":[{"g":"on the right"},{"g":"to see"},{"g":"she / they / you"},{"g":"the / that"},null]}]}