{"id":"dorthin","lemma":"dorthin","pos":"adv","rank":1136,"glosses":["there (to that place), thither"],"ipa":"/dɔʁtˈhɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/71/De-dorthin.ogg/De-dorthin.ogg.mp3","examples":[{"text":"Müssen wir dorthin gehen?","en":"Do we have to go there?","audio":"https://tatoeba.org/en/audio/download/757251","words":[{"g":"to have to"},{"g":"we"},null,{"g":"to go, to walk"}]},{"text":"Wann seid ihr dorthin gegangen?","en":"When did you go there?","audio":"https://tatoeba.org/en/audio/download/756645","words":[{"g":"when"},{"g":"are","l":"sein"},{"g":"you (pl.) / her"},null,{"g":"to go, to walk","l":"gehen"}]},{"text":"Warum gehst du nicht dorthin?","en":"Why don't you go there?","audio":"https://tatoeba.org/en/audio/download/760431","words":[{"g":"why"},{"g":"to go, to walk","l":"gehen"},{"g":"you"},{"g":"not"},null]},{"text":"Wir könnten jetzt dorthin fahren.","en":"We could go there now.","audio":"https://tatoeba.org/en/audio/download/756462","words":[{"g":"we"},{"g":"can, to be able to","l":"können"},{"g":"now"},null,{"g":"to go at speed"}]},{"text":"Wir können nicht dorthin zurück.","en":"We can't go back there.","audio":"https://tatoeba.org/en/audio/download/711764","words":[{"g":"we"},{"g":"can, to be able to"},{"g":"not"},null,{"g":"stand back!"}]}]}