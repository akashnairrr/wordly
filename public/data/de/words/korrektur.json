{"id":"korrektur","lemma":"Korrektur","pos":"noun","rank":2114,"glosses":["correction"],"ipa":"/kɔrɛkˈtuːr/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/84/De-Korrektur.ogg/De-Korrektur.ogg.mp3","gender":"f","forms":{"genitive":"Korrektur","plural":"Korrekturen"},"examples":[{"text":"Danke für die Korrektur.","en":"Thank you for the correction.","words":[{"g":"thanks, thank you"},{"g":"for"},{"g":"the"},null]},{"text":"Er machte mehrere Korrekturen.","en":"He made several corrections.","words":[{"g":"he / it"},{"g":"to make","l":"machen"},{"g":"multiple, several"},null]},{"text":"Soll ich das Korrektur lesen?","en":"Would you like me to proofread this?","words":[{"g":"should","l":"sollen"},{"g":"I"},{"g":"the / that"},null,{"g":"to read"}]},{"text":"Danke für die Korrektur!","en":"Thanks for the correction.","words":[{"g":"thanks, thank you"},{"g":"for"},{"g":"the"},null]},{"text":"Ich habe einige Korrekturen vorgenommen.","en":"I’ve made a few corrections.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"united","l":"einig"},null,{"g":"to undertake","l":"vornehmen"}]}]}