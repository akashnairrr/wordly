{"id":"puppe","lemma":"Puppe","pos":"noun","rank":2331,"glosses":["doll","pupa","girl"],"ipa":"/ˈpʊpə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/80/De-Puppe.ogg/De-Puppe.ogg.mp3","gender":"f","forms":{"genitive":"Puppe","plural":"Puppen"},"examples":[{"text":"Sie hat eine schöne Puppe.","en":"She has a pretty doll.","audio":"https://tatoeba.org/en/audio/download/755239","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"a"},{"g":"well, beautifully","l":"schön"},null]},{"text":"Wie viele Puppen hast du?","en":"How many dolls do you have?","words":[{"g":"how"},{"g":"much, a lot","l":"viel"},null,{"g":"have","l":"haben"},{"g":"you"}]},{"text":"Das ist eine Puppe.","en":"That's a doll.","audio":"https://tatoeba.org/en/audio/download/48522","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"a"},null]},{"text":"Meine Schwester spielt mit Puppen.","en":"My sister plays with dolls.","words":[{"g":"my","l":"mein"},{"g":"sister"},{"g":"to play","l":"spielen"},{"g":"with"},null]},{"text":"Gib ihr eine Puppe.","en":"Give her a doll.","words":[{"g":"to give","l":"geben"},{"g":"you (pl.) / her"},{"g":"a"},null]}]}