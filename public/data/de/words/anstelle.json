{"id":"anstelle","lemma":"anstelle","pos":"prep","rank":4553,"glosses":["instead of, in place of"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/ba/De-anstelle.ogg/De-anstelle.ogg.mp3","examples":[{"text":"Würdest du anstelle von mir gehen?","en":"Will you go in place of me?","words":[{"g":"to become","l":"werden"},{"g":"you"},null,{"g":"from / of"},{"g":"(to) me","l":"ich"},{"g":"to go, to walk"}]},{"text":"Er ging anstelle seines Vaters.","en":"He went there instead of his father.","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},null,{"g":"his","l":"seiner"},{"g":"father","l":"Vater"}]},{"text":"Lass mich anstelle seiner gehen!","en":"Let me go in place of him.","words":[{"g":"to allow","l":"lassen"},{"g":"me","l":"ich"},null,{"g":"his"},{"g":"to go, to walk"}]},{"text":"Würden Sie anstelle von mir gehen?","en":"Will you go in place of me?","words":[{"g":"dignity","l":"Würde"},{"g":"she / they / you"},null,{"g":"from / of"},{"g":"(to) me","l":"ich"},{"g":"to go, to walk"}]},{"text":"Lasst mich anstelle seiner gehen!","en":"Let me go in place of him.","words":[{"g":"to allow","l":"lassen"},{"g":"me","l":"ich"},null,{"g":"his"},{"g":"to go, to walk"}]}]}