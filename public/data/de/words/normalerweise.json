{"id":"normalerweise","lemma":"normalerweise","pos":"adv","rank":1195,"glosses":["normally"],"ipa":"/nɔʁˈmaːlɐvaɪ̯zə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/De-normalerweise.ogg/De-normalerweise.ogg.mp3","examples":[{"text":"Wann geht ihr normalerweise schlafen?","en":"When do you usually go to sleep?","words":[{"g":"when"},{"g":"to go, to walk","l":"gehen"},{"g":"you (pl.) / her"},null,{"g":"to sleep"}]},{"text":"Normalerweise sind wenig Leute da.","en":"Normally there are few people there.","words":[null,{"g":"are","l":"sein"},{"g":"little, few"},{"g":"people"},{"g":"there"}]},{"text":"Ich tu das normalerweise nicht.","en":"I don't normally do that.","words":[{"g":"I"},{"g":"to do","l":"tun"},{"g":"the / that"},null,{"g":"not"}]},{"text":"Normalerweise schlafen wir in diesem Zimmer.","en":"We usually sleep in this room.","words":[null,{"g":"to sleep"},{"g":"we"},{"g":"in"},{"g":"this one, this","l":"dieser"},{"g":"room"}]},{"text":"Ich gehe normalerweise sehr früh schlafen.","en":"I usually go to sleep very early.","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null,{"g":"very"},{"g":"early"},{"g":"to sleep"}]}]}