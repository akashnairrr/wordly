/484921","words":[{"g":"everything"},null,{"g":"from the"},{"g":"money"},{"g":"beginning at that time…"}]},{"text":"Hänge deine Kleidung hier auf!","en":"Hang your clothes here.","words":[null,{"g":"your","l":"dein"},{"g":"clothing"},{"g":"here"},{"g":"on"}]},{"text":"Ich will dich nicht hängen lassen.","en":"I don't want to let you down.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"you","l":"du"},{"g":"not"},null,{"g":"to allow"}]}]}