{"id":"heran","lemma":"heran","pos":"adv","rank":3284,"glosses":["near, close to the speaker, over to (to the direction of the speaker or an object)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/34/De-heran.ogg/De-heran.ogg.mp3","examples":[{"text":"Fahren Sie hier heran!","en":"Pull over here.","audio":"https://tatoeba.org/en/audio/download/81499","words":[{"g":"to go at speed"},{"g":"she / they / you"},{"g":"here"},null]},{"text":"Ein Sturm zieht heran.","en":"A storm is coming.","words":[{"g":"a"},{"g":"A strong"},{"g":"to pull","l":"ziehen"},null]},{"text":"Ich lasse das nicht an mich heran.","en":"I don't let it bother me.","words":[{"g":"I"},{"g":"to allow","l":"lassen"},{"g":"the / that"},{"g":"not"},{"g":"at / on"},{"g":"me","l":"ich"},null]},{"text":"Komme nicht so dicht an das Feuer heran.","en":"Don't get that close to the fire.","words":[{"g":"to come","l":"kommen"},{"g":"not"},{"g":"so"},{"g":"thick, tight, dense"},{"g":"at / on"},{"g":"the / that"},{"g":"fire"},null]},{"text":"Fahre hier heran!","en":"Pull over here.","audio":"https://tatoeba.org/en/audio/download/81500","words":[{"g":"to go at speed","l":"fahren"},{"g":"here"},null]}]}