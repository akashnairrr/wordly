{"id":"beruflich","lemma":"beruflich","pos":"adv","rank":3557,"glosses":["professionally"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/42/De-beruflich.ogg/De-beruflich.ogg.mp3","examples":[{"text":"Ich mache das beruflich.","en":"I do that for a living.","audio":"https://tatoeba.org/en/audio/download/700479","words":[{"g":"I"},{"g":"to make","l":"machen"},{"g":"the / that"},null]},{"text":"Was machen Sie beruflich?","en":"What's your job?","audio":"https://tatoeba.org/en/audio/download/191443","words":[{"g":"what"},{"g":"to make"},{"g":"she / they / you"},null]},{"text":"Was machst du denn beruflich?","en":"What do you do for a living?","words":[{"g":"what"},{"g":"to make","l":"machen"},{"g":"you"},{"g":"so"},null]},{"text":"Was machen deine Eltern beruflich?","en":"What do your parents do?","words":[{"g":"what"},{"g":"to make"},{"g":"your","l":"dein"},{"g":"parents"},null]},{"text":"Ich weiß, was Tom beruflich macht.","en":"I know what Tom does for a living.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"what"},null,null,{"g":"to make","l":"machen"}]}]}