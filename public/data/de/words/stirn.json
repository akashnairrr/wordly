{"id":"stirn","lemma":"Stirn","pos":"noun","rank":2966,"glosses":["forehead, brow (often used as an indicator of emotion)","frons"],"ipa":"/ʃtɪʁn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/aa/De-Stirn.ogg/De-Stirn.ogg.mp3","gender":"f","forms":{"genitive":"Stirn","plural":"Stirnen"},"examples":[{"text":"Deine Stirn blutet.","en":"Your forehead's bleeding.","audio":"https://tatoeba.org/en/audio/download/761686","words":[{"g":"your","l":"dein"},null,{"g":"to bleed","l":"bluten"}]},{"text":"Er küsste mich auf die Stirn.","en":"He kissed me on the forehead.","words":[{"g":"he / it"},{"g":"to kiss","l":"küssen"},{"g":"me","l":"ich"},{"g":"on"},{"g":"the"},null]},{"text":"Ich drückte meine Stirn an seine.","en":"I pressed my forehead against his.","words":[{"g":"I"},{"g":"to press","l":"drücken"},{"g":"my","l":"mein"},null,{"g":"at / on"},{"g":"his","l":"seiner"}]},{"text":"Sie runzelte die Stirn.","en":"She wrinkled her brows.","words":[{"g":"she / they / you"},null,{"g":"the"},null]},{"text":"Sie hat ihn auf die Stirn geküsst.","en":"She kissed him on the forehead.","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"him"},{"g":"on"},{"g":"the"},null,{"g":"to kiss","l":"küssen"}]}]}