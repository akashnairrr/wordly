{"id":"gasse","lemma":"Gasse","pos":"noun","rank":4075,"glosses":["alley, lane, ginnel, twitchel"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/39/De-Gasse.ogg/De-Gasse.ogg.mp3","gender":"f","forms":{"genitive":"Gasse","plural":"Gassen"},"formAudio":{"Gassen":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q188_%28deu%29-Sebastian_Wallroth-Gassen.wav"},"examples":[{"text":"Hinter meinem Haus liegt eine Gasse.","en":"There's an alley behind my house.","words":[{"g":"behind, after"},{"g":"my","l":"mein"},{"g":"house, building"},{"g":"to lie","l":"liegen"},{"g":"a"},null]},{"text":"Es gibt viele enge Gassen in der Stadt.","en":"The town has many narrow lanes.","words":[null,null,{"g":"much, a lot","l":"viel"},{"g":"narrow, tight","l":"eng"},null,{"g":"in"},{"g":"the"},{"g":"city"}],"phrases":[[0,2,"there is, there are"]]},{"text":"Ich wollte ihm nicht in einer dunklen Gasse begegnen.","en":"I wouldn't want to run into him in a dark alley.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"(to) him","l":"er"},{"g":"not"},{"g":"in"},{"g":"a / one","l":"ein"},{"g":"dark","l":"dunkel"},null,{"g":"meet"}]}]}