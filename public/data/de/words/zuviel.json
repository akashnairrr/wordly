{"id":"zuviel","lemma":"Zuviel","pos":"noun","rank":2889,"glosses":["excess"],"gender":"n","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q188_%28deu%29-Kesisson-zuviel.wav","examples":[{"text":"Das könnte zuviel verlangt sein.","en":"That may be too much to ask.","words":[{"g":"the / that"},{"g":"can, to be able to","l":"können"},null,{"g":"to ask for, demand","l":"verlangen"},{"g":"to be"}]},{"text":"Du hast wohl zuviel Zeit.","en":"You must have a lot of time on your hands.","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"possibly, probably"},null,{"g":"time"}]},{"text":"Ich trinke zuviel.","en":"I drink too much.","words":[{"g":"I"},{"g":"to drink by mouth)","l":"trinken"},null]},{"text":"Das ist viel zuviel.","en":"That's way too much.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"much, a lot"},null]},{"text":"Ein Unfall ist einer zuviel.","en":"One accident is too many.","words":[{"g":"a"},{"g":"accident"},{"g":"is","l":"sein"},{"g":"a / one","l":"ein"},null]}]}