{"id":"besonders","lemma":"besonders","pos":"adv","rank":553,"glosses":["especially, particularly","very, especially","exceptionally, separately"],"ipa":"/beˈsɔndɐs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/De-at-besonders.ogg/De-at-besonders.ogg.mp3","examples":[{"text":"Du solltest heute besonders vorsichtig sein.","en":"You should be especially careful today.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"today"},null,{"g":"carefully"},{"g":"to be"}]},{"text":"Willst du etwas Besonders hören?","en":"Is there something in particular that you want to hear?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"something"},null,{"g":"to hear through the ear)"}]},{"text":"Sei besonders leise.","en":"Be very quiet.","audio":"https://tatoeba.org/en/audio/download/695270","words":[{"g":"to be","l":"sein"},null,{"g":"quietly, softly, low"}]},{"text":"Ich fühle mich nicht besonders gut.","en":"I'm not feeling very well.","audio":"https://tatoeba.org/en/audio/download/761045","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},{"g":"not"},null,{"g":"good"}]},{"text":"Kohle ist besonders wichtig.","en":"Coal is especially important.","words":[{"g":"coal (material"},{"g":"is","l":"sein"},null,{"g":"important"}]}]}