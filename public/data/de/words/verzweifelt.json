{"id":"verzweifelt","lemma":"verzweifelt","pos":"adv","rank":1949,"glosses":["desperately"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/35/De-verzweifelt.ogg/De-verzweifelt.ogg.mp3","examples":[{"text":"Ich war verzweifelt.","en":"I was desperate.","words":[{"g":"I"},{"g":"was","l":"sein"},null]},{"text":"Wir sind verzweifelt.","en":"We're desperate.","audio":"https://tatoeba.org/en/audio/download/251428","words":[{"g":"we"},{"g":"are","l":"sein"},null]},{"text":"So verzweifelt bin ich noch nicht.","en":"I'm not that desperate yet.","words":[{"g":"so"},null,{"g":"am","l":"sein"},{"g":"I"},null,null],"phrases":[[4,6,"not yet"]]},{"text":"Wir suchen verzweifelt nach einer Lösung.","en":"We're desperate to find a solution.","words":[{"g":"we"},{"g":"to search, to look for"},null,{"g":"after / to"},{"g":"a / one","l":"ein"},{"g":"solution"}]},{"text":"Er war verzweifelt.","en":"He was heartbroken.","audio":"https://tatoeba.org/en/audio/download/393661","words":[{"g":"he / it"},{"g":"was","l":"sein"},null]}]}