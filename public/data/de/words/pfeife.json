{"id":"pfeife","lemma":"Pfeife","pos":"noun","rank":3127,"glosses":["whistle","pipe (for smoking)"],"ipa":"/ˈp͡faɪ̯fə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9f/De-Pfeife.ogg/De-Pfeife.ogg.mp3","gender":"f","forms":{"genitive":"Pfeife","plural":"Pfeifen"},"formAudio":{"Pfeifen":"https://upload.wikimedia.org/wikipedia/commons/7/75/LL-Q188_%28deu%29-Natschoba-pfeifen.wav"},"examples":[{"text":"Ich pfeife aus dem letzten Loch.","en":"I'm at the end of my rope.","audio":"https://tatoeba.org/en/audio/download/761392","words":[{"g":"I"},null,{"g":"out of / from"},{"g":"(to) the","l":"der"},{"g":"the last one","l":"Letzter"},{"g":"hole"}]},{"text":"Pfeife in der Schule nicht!","en":"Don't whistle at school.","audio":"https://tatoeba.org/en/audio/download/759802","words":[null,{"g":"in"},{"g":"the"},{"g":"school"},{"g":"not"}]},{"text":"Er saß dort mit einer Pfeife im Mund.","en":"He was sitting there with a pipe in his mouth.","words":[{"g":"he / it"},{"g":"to sit","l":"sitzen"},{"g":"there, yonder"},{"g":"with"},{"g":"a / one","l":"ein"},null,{"g":"in the"},{"g":"mouth of a person"}]},{"text":"Das kann man in der Pfeife rauchen.","en":"It's no good.","audio":"https://tatoeba.org/en/audio/download/70899","words":[{"g":"the / that"},{"g":"can, to be able to","l":"können"},{"g":"one"},{"g":"in"},{"g":"the"},null,{"g":"to smoke"}]},{"text":"Kannst du pfeifen?","en":"Can you whistle?","audio":"https://tatoeba.org/en/audio/download/211449","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null]}]}