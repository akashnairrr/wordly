{"id":"vielleicht","lemma":"vielleicht","pos":"adv","rank":82,"glosses":["perhaps, maybe","frequently replaces bitte (“please”) in polite questions","expresses amazement or excitement, particularly at something negative"],"ipa":"/fiˈlaɪ̯çt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/12/De-at-vielleicht.ogg/De-at-vielleicht.ogg.mp3","examples":[{"text":"Vielleicht kann ich helfen.","en":"Maybe I can help.","audio":"https://tatoeba.org/en/audio/download/393191","words":[null,{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"to help"}]},{"text":"Vielleicht brauche ich Hilfe.","en":"I may need help.","audio":"https://tatoeba.org/en/audio/download/746583","words":[null,{"g":"to need","l":"brauchen"},{"g":"I"},{"g":"the act of helping"}]},{"text":"Vielleicht ist es wahr.","en":"Maybe it's true.","audio":"https://tatoeba.org/en/audio/download/72410","words":[null,{"g":"is","l":"sein"},{"g":"it"},{"g":"true, real"}]},{"text":"Sie kommt vielleicht nicht.","en":"She may not come.","audio":"https://tatoeba.org/en/audio/download/394008","words":[{"g":"she / they / you"},{"g":"to come","l":"kommen"},null,{"g":"not"}]},{"text":"Vielleicht kommt er heute.","en":"He may come today.","audio":"https://tatoeba.org/en/audio/download/565862","words":[null,{"g":"to come","l":"kommen"},{"g":"he / it"},{"g":"today"}]}]}