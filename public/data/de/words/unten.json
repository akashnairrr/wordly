{"id":"unten","lemma":"unten","pos":"adv","rank":383,"glosses":["below","south","at a later point in a text"],"ipa":"/ˈʊntn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/78/De-unten2.ogg/De-unten2.ogg.mp3","examples":[{"text":"Warum bist du hier unten?","en":"Why are you down here?","audio":"https://tatoeba.org/en/audio/download/756569","words":[{"g":"why"},{"g":"are","l":"sein"},{"g":"you"},{"g":"here"},null]},{"text":"Wie geht es da unten?","en":"How's it going down there?","audio":"https://tatoeba.org/en/audio/download/761585","words":[null,null,null,{"g":"there"},null],"phrases":[[0,3,"how are you"]]},{"text":"Ich mag es hier unten nicht.","en":"I don't like it down here.","audio":"https://tatoeba.org/en/audio/download/700477","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"it"},{"g":"here"},null,{"g":"not"}]},{"text":"Was denkst du, ist da unten?","en":"What do you think is down there?","words":[{"g":"what"},{"g":"to think","l":"denken"},{"g":"you"},{"g":"is","l":"sein"},{"g":"there"},null]},{"text":"Er ist noch nicht unten.","en":"He is not down yet.","words":[{"g":"he / it"},{"g":"is","l":"sein"},null,null,null],"phrases":[[2,4,"not yet"]]}]}