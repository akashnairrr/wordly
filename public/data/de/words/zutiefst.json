{"id":"zutiefst","lemma":"zutiefst","pos":"adv","rank":4419,"glosses":["deeply"],"ipa":"/tsuˈtiːfst/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/De-zutiefst.ogg/De-zutiefst.ogg.mp3","examples":[{"text":"Ich war zutiefst verletzt.","en":"I was deeply hurt.","words":[{"g":"I"},{"g":"was","l":"sein"},null,{"g":"hurt, injured"}]},{"text":"Ich bin zutiefst in dich verliebt.","en":"I'm deeply in love with you.","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"in"},{"g":"you","l":"du"},{"g":"in love, enamored"}]},{"text":"Sie hassen sich zutiefst.","en":"They really hate each other.","audio":"https://tatoeba.org/en/audio/download/786557","words":[{"g":"she / they / you"},{"g":"to hate"},{"g":"oneself"},null]},{"text":"Ich war von seiner Rede zutiefst bewegt.","en":"I was deeply moved by his speech.","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"from / of"},{"g":"his"},{"g":"speech, address"},null,{"g":"agitated, disturbed"}]},{"text":"Die Neuigkeiten bewegten ihn zutiefst.","en":"The news moved him deeply.","words":[{"g":"the"},{"g":"news","l":"Neuigkeit"},{"g":"agitated, disturbed","l":"bewegt"},{"g":"him"},null]}]}