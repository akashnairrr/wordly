{"id":"zuerst","lemma":"zuerst","pos":"adv","rank":420,"glosses":["first, firstly","at first"],"ipa":"/tsuˈʔeːɐ̯st/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c9/De-zuerst.ogg/De-zuerst.ogg.mp3","examples":[{"text":"Wer will zuerst gehen?","en":"Who wants to go first?","audio":"https://tatoeba.org/en/audio/download/786560","words":[{"g":"who"},{"g":"to want","l":"wollen"},null,{"g":"to go, to walk"}]},{"text":"Ich gehe zuerst rein.","en":"I'll go in first.","audio":"https://tatoeba.org/en/audio/download/392107","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null,{"g":"inside, in here"}]},{"text":"Darf ich zuerst gehen?","en":"Can I go first?","audio":"https://tatoeba.org/en/audio/download/77238","words":[{"g":"to be allowed","l":"dürfen"},{"g":"I"},null,{"g":"to go, to walk"}]},{"text":"Wer war zuerst hier?","en":"Who was here first?","words":[{"g":"who"},{"g":"was","l":"sein"},null,{"g":"here"}]},{"text":"Daran werden wir zuerst arbeiten.","en":"We'll work on that first.","audio":"https://tatoeba.org/en/audio/download/701237","words":[{"g":"on it, on that"},{"g":"to become"},{"g":"we"},null,{"g":"to work"}]}]}