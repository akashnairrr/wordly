{"id":"lage","lemma":"Lage","pos":"noun","rank":733,"glosses":["location, position","situation, condition","thickness (layer)"],"ipa":"/ˈlaːɡə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/62/De-Lage.ogg/De-Lage.ogg.mp3","gender":"f","forms":{"genitive":"Lage","plural":"Lagen"},"examples":[{"text":"Wie ist die Lage?","en":"How is it?","audio":"https://tatoeba.org/en/audio/download/392446","words":[{"g":"how"},{"g":"is","l":"sein"},{"g":"the"},null]},{"text":"Bitte verstehe meine Lage.","en":"Please understand my position.","words":[{"g":"please"},{"g":"to hear and interpret","l":"verstehen"},{"g":"my","l":"mein"},null]},{"text":"Sind Sie dazu in der Lage?","en":"Are you capable of that?","words":[{"g":"are","l":"sein"},{"g":"she / they / you"},{"g":"in addition to it"},{"g":"in"},{"g":"the"},null]},{"text":"Meine Lage hat sich verändert.","en":"My situation has changed.","words":[{"g":"my","l":"mein"},null,{"g":"has","l":"haben"},{"g":"oneself"},{"g":"changed, altered"}]},{"text":"Wir müssen die Lage besprechen.","en":"We need to discuss the situation.","words":[{"g":"we"},{"g":"to have to"},{"g":"the"},null,{"g":"to discuss"}]}]}