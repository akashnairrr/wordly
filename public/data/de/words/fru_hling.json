{"id":"fru_hling","lemma":"Frühling","pos":"noun","rank":3006,"glosses":["spring"],"ipa":"/ˈfʁyːlɪŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/27/De-Fr%C3%BChling.OGG/De-Fr%C3%BChling.OGG.mp3","gender":"m","forms":{"genitive":"Frühlings","plural":"Frühlinge"},"formAudio":{"Frühlings":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q188_%28deu%29-Sebastian_Wallroth-Fr%C3%BChlings.wav","Frühlinge":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q188_%28deu%29-Sebastian_Wallroth-Fr%C3%BChlinge.wav"},"examples":[{"text":"Ich mag den Frühling.","en":"I like spring.","audio":"https://tatoeba.org/en/audio/download/48365","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"the","l":"der"},null]},{"text":"Es ist Frühling.","en":"It's spring.","audio":"https://tatoeba.org/en/audio/download/394427","words":[{"g":"it"},{"g":"is","l":"sein"},null]},{"text":"Die Schule beginnt im Frühling.","en":"School begins in the spring.","words":[{"g":"the"},{"g":"school"},{"g":"to begin","l":"beginnen"},{"g":"in the"},null]},{"text":"Im Frühling werden die Tage länger.","en":"In spring, the days become longer.","words":[{"g":"in the"},null,{"g":"to become"},null,null,{"g":"long","l":"lang"}],"phrases":[[3,5,"in the coming days"]]},{"text":"Ich erwarte schon die Wiederkehr des Frühlings.","en":"I'm looking forward to the return of spring.","words":[{"g":"I"},{"g":"to expect","l":"erwarten"},{"g":"already"},{"g":"the"},{"g":"return"},{"g":"of the","l":"der"},null]}]}