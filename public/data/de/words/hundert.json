{"id":"hundert","lemma":"hundert","pos":"num","rank":1971,"glosses":["one hundred"],"ipa":"/ˈhʊndɐt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c0/De-hundert.ogg/De-hundert.ogg.mp3","examples":[{"text":"Ein Dollar ist gleich hundert Cent.","en":"A dollar is equal to a hundred cents.","audio":"https://tatoeba.org/en/audio/download/787660","words":[{"g":"a"},{"g":"dollar"},{"g":"is","l":"sein"},{"g":"alike"},null,{"g":"cent"}]},{"text":"Kannst du bis hundert zählen?","en":"Can you count to one hundred?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"until, to, through"},null,{"g":"to count"}]},{"text":"Mein Sohn kann jetzt bis hundert zählen.","en":"My son can count up to a hundred now.","audio":"https://tatoeba.org/en/audio/download/12259","words":[{"g":"my"},{"g":"son"},{"g":"can, to be able to","l":"können"},{"g":"now"},{"g":"until, to, through"},null,{"g":"to count"}]},{"text":"Hundert werden nicht viele.","en":"Not many people live to be a hundred.","words":[null,{"g":"to become"},{"g":"not"},{"g":"much, a lot","l":"viel"}]},{"text":"Er hatte nur hundert Dollar.","en":"He only had 100 dollars.","words":[{"g":"he / it"},{"g":"to have","l":"haben"},{"g":"only"},null,{"g":"dollar"}]}]}