{"id":"beneiden","lemma":"beneiden","pos":"verb","rank":4726,"glosses":["to envy","to begrudge someone something"],"ipa":"/bəˈnaɪ̯dən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f1/De-beneiden.ogg/De-beneiden.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"beneide","1p":"beneiden","2s":"beneidest","2p":"beneidet","3s":"beneidet","3p":"beneiden"},"preterite":{"1s":"beneidete","1p":"beneideten","2s":"beneidetest","2p":"beneidetet","3s":"beneidete","3p":"beneideten"},"perfect":{"1s":"habe beneidet","1p":"haben beneidet","2s":"hast beneidet","2p":"habt beneidet","3s":"hat beneidet","3p":"haben beneidet"},"future":{"1s":"werde beneiden","1p":"werden beneiden","2s":"wirst beneiden","2p":"werdet beneiden","3s":"wird beneiden","3p":"werden beneiden"}},"imperative":{"affirmative":{"2s":"beneid","2p":"beneidet"}},"subjunctive":{"conditional":{"1s":"würde beneiden","1p":"würden beneiden","2s":"würdest beneiden","2p":"würdet beneiden","3s":"würde beneiden","3p":"würden beneiden"}}},"nonFinite":{"participle":"beneidet"},"examples":[{"text":"Ich beneide ihn.","en":"I envy him.","audio":"https://tatoeba.org/en/audio/download/394309","words":[{"g":"I"},null,{"g":"him"}]},{"text":"Ich beneide dich nicht.","en":"I don't envy you.","audio":"https://tatoeba.org/en/audio/download/167077","words":[{"g":"I"},null,{"g":"you","l":"du"},{"g":"not"}]},{"text":"Er beneidet alle seine Freunde.","en":"He envies all his friends.","words":[{"g":"he / it"},null,{"g":"all, everyone"},{"g":"his","l":"seiner"},{"g":"friends"}]},{"text":"Viele würden dich beneiden.","en":"Many people would envy you.","words":[{"g":"much, a lot","l":"viel"},{"g":"dignity","l":"Würde"},{"g":"you","l":"du"},null]},{"text":"Ich beneide dich um dein Glück.","en":"I envy you your luck.","words":[{"g":"I"},null,{"g":"you","l":"du"},{"g":"around / at"},{"g":"your"},{"g":"happiness, joy, bliss"}]}]}