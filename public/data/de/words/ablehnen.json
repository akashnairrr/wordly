{"id":"ablehnen","lemma":"ablehnen","pos":"verb","rank":3327,"glosses":["to decline, refuse, reject, turn down"],"ipa":"/ˈapleːnən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/De-ablehnen.ogg/De-ablehnen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"lehne ab","1p":"lehnen ab","2s":"lehnst ab","2p":"lehnt ab","3s":"lehnt ab","3p":"lehnen ab"},"preterite":{"1s":"lehnte ab","1p":"lehnten ab","2s":"lehntest ab","2p":"lehntet ab","3s":"lehnte ab","3p":"lehnten ab"},"perfect":{"1s":"habe abgelehnt","1p":"haben abgelehnt","2s":"hast abgelehnt","2p":"habt abgelehnt","3s":"hat abgelehnt","3p":"haben abgelehnt"},"future":{"1s":"werde ablehnen","1p":"werden ablehnen","2s":"wirst ablehnen","2p":"werdet ablehnen","3s":"wird ablehnen","3p":"werden ablehnen"}},"imperative":{"affirmative":{"2s":"lehn ab","2p":"lehnt ab"}},"subjunctive":{"conditional":{"1s":"würde ablehnen","1p":"würden ablehnen","2s":"würdest ablehnen","2p":"würdet ablehnen","3s":"würde ablehnen","3p":"würden ablehnen"}}},"nonFinite":{"participle":"abgelehnt"},"examples":[{"text":"Ich muss ablehnen.","en":"I must decline.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},null]},{"text":"Konnten Sie es ablehnen?","en":"Could you turn it down?","words":[{"g":"can, to be able to","l":"können"},{"g":"she / they / you"},{"g":"it"},null]},{"text":"Du hättest die Einladung ablehnen sollen.","en":"You should've declined the invitation.","words":[{"g":"you"},{"g":"to have","l":"haben"},{"g":"the"},{"g":"invitation"},null,{"g":"should"}]},{"text":"Leider muß ich das Angebot ablehnen.","en":"Unfortunately, I must decline the offer.","words":[{"g":"unfortunately"},null,{"g":"I"},{"g":"the / that"},{"g":"offer, proposition"},null]},{"text":"Ich konnte nicht ablehnen.","en":"I couldn't refuse.","audio":"https://tatoeba.org/en/audio/download/392498","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"not"},null]}]}