{"id":"lebendig","lemma":"lebendig","pos":"adj","rank":1477,"glosses":["living, alive, animate","lively, vivacious, spirited, animated, vibrant, active, agile"],"ipa":"/leˈbɛndɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7a/De-lebendig2.ogg/De-lebendig2.ogg.mp3","forms":{"comparative":"lebendiger","superlative":"am lebendigsten"},"examples":[{"text":"Ich fühle mich lebendig.","en":"I feel alive.","audio":"https://tatoeba.org/en/audio/download/32334","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},null]},{"text":"Ist die Schlange tot oder lebendig?","en":"Is the snake alive or dead?","words":[{"g":"is","l":"sein"},{"g":"the"},{"g":"snake"},{"g":"dead, deceased"},{"g":"or"},null]},{"text":"Alle Hunde sind lebendig.","en":"All the dogs are alive.","audio":"https://tatoeba.org/en/audio/download/754938","words":[{"g":"all, everyone"},{"g":"dog, hound","l":"Hund"},{"g":"are","l":"sein"},null]},{"text":"Ist der Fisch noch lebendig?","en":"Is this fish still alive?","words":[{"g":"is","l":"sein"},{"g":"the"},{"g":"fish"},{"g":"still / yet"},null]},{"text":"Du musst das Tier lebendig fangen.","en":"You must catch the animal alive.","words":[{"g":"you"},{"g":"to have to","l":"müssen"},{"g":"the / that"},{"g":"animal"},null,{"g":"to catch"}]}]}