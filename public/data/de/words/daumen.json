{"id":"daumen","lemma":"Daumen","pos":"noun","rank":2664,"glosses":["thumb"],"ipa":"/ˈdaʊ̯mən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/De-Daumen.ogg/De-Daumen.ogg.mp3","gender":"m","forms":{"genitive":"Daumens","plural":"Daumen"},"examples":[{"text":"Ich halte dir die Daumen.","en":"I'm rooting for you.","words":[{"g":"I"},{"g":"to hold","l":"halten"},{"g":"(to) you","l":"du"},{"g":"the"},null]},{"text":"Zum Glück habe ich einen grünen Daumen.","en":"Fortunately, I have a green thumb.","audio":"https://tatoeba.org/en/audio/download/745510","words":[null,null,{"g":"have","l":"haben"},{"g":"I"},{"g":"a","l":"ein"},{"g":"to be green"},null],"phrases":[[0,2,"fortunately, luckily"]]},{"text":"Wir drücken die Daumen.","en":"We have our fingers crossed.","words":[{"g":"we"},{"g":"to press"},{"g":"the"},null]},{"text":"Du hast anscheinend einen grünen Daumen.","en":"It looks like you've got a green thumb.","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"apparently"},{"g":"a","l":"ein"},{"g":"to be green"},null]},{"text":"Drückt mir die Daumen!","en":"Wish me luck.","audio":"https://tatoeba.org/en/audio/download/391662","words":[{"g":"to press","l":"drücken"},{"g":"(to) me","l":"ich"},{"g":"the"},null]}]}