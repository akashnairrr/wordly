{"id":"achte","lemma":"achte","pos":"adj","rank":1853,"glosses":["eighth"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/34/De-achte.ogg/De-achte.ogg.mp3","examples":[{"text":"Ich achte Sie.","en":"I look up to you.","audio":"https://tatoeba.org/en/audio/download/238915","words":[{"g":"I"},null,{"g":"she / they / you"}]},{"text":"Ich gehe in die achte Klasse.","en":"I'm in the eighth grade.","audio":"https://tatoeba.org/en/audio/download/564293","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},{"g":"in"},{"g":"the"},null,{"g":"form"}]},{"text":"Ich achte nicht darauf, was sie sagen.","en":"I don't care about what they say.","audio":"https://tatoeba.org/en/audio/download/32491","words":[{"g":"I"},null,{"g":"not"},{"g":"after (behind"},{"g":"what"},{"g":"she / they / you"},{"g":"to say (to pronounce"}]},{"text":"Achte darauf, nicht zu viel zu trinken.","en":"Be careful not to drink too much.","words":[null,{"g":"after (behind"},{"g":"not"},null,null,{"g":"to / too"},{"g":"to drink by mouth)"}],"phrases":[[3,5,"too much"]]},{"text":"Achte auf deine Gesundheit.","en":"Take care of your health.","words":[null,{"g":"on"},{"g":"your","l":"dein"},{"g":"health"}]}]}