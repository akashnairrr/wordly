{"id":"datum","lemma":"Datum","pos":"noun","rank":3156,"glosses":["date (specific day for an event to take place)","datum (singular piece of information, especially numerical)"],"ipa":"/ˈdaːtʊm/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/93/De-Datum.ogg/De-Datum.ogg.mp3","gender":"n","forms":{"genitive":"Datums","plural":"Daten"},"formAudio":{"Daten":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q188_%28deu%29-Mukeber-Daten.wav"},"examples":[{"text":"Welches Datum ist heute?","en":"What's today's date?","audio":"https://tatoeba.org/en/audio/download/566581","words":[{"g":"which","l":"welcher"},null,{"g":"is","l":"sein"},{"g":"today"}]},{"text":"Habe ich vergessen, das Datum zu schreiben?","en":"Did I forget to write the date?","words":[{"g":"have","l":"haben"},{"g":"I"},{"g":"to forget"},{"g":"the / that"},null,{"g":"to / too"},{"g":"to write, to write out"}]},{"text":"Tragen Sie das Datum selbst ein.","en":"Write in the date yourself.","words":[{"g":"to carry, to bear"},{"g":"she / they / you"},{"g":"the / that"},null,{"g":"even"},{"g":"a"}]},{"text":"Welches Datum trägt der Brief?","en":"What's the date on the letter?","words":[{"g":"which","l":"welcher"},null,{"g":"to carry, to bear","l":"tragen"},{"g":"the"},{"g":"letter"}]},{"text":"Ich kenne das genaue Datum nicht.","en":"I don't know the exact date.","words":[{"g":"I"},{"g":"to know","l":"kennen"},{"g":"the / that"},{"g":"just, exactly","l":"genau"},null,{"g":"not"}]}]}