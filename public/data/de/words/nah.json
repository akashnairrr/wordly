{"id":"nah","lemma":"nah","pos":"adv","rank":433,"glosses":["near (in space or time or in an abstract sense)"],"ipa":"/naː/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b2/De-nah.ogg/De-nah.ogg.mp3","examples":[{"text":"Geh nicht zu nah ans Feuer!","en":"Don't go too near the fire.","audio":"https://tatoeba.org/en/audio/download/567068","words":[{"g":"to go, to walk","l":"gehen"},{"g":"not"},{"g":"to / too"},null,null,{"g":"fire"}]},{"text":"Das Ende der Welt ist nah.","en":"The end of the world is close.","words":[{"g":"the / that"},{"g":"end, finish"},{"g":"the"},{"g":"world"},{"g":"is","l":"sein"},null]},{"text":"Es ist sehr nah.","en":"It's very close.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"very"},null]},{"text":"Es ist ganz nah von hier.","en":"It's very near here.","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"entire"},null,{"g":"from / of"},{"g":"here"}]},{"text":"Wir waren uns sehr nah.","en":"We were very close.","words":[{"g":"we"},{"g":"to be","l":"sein"},{"g":"us","l":"wir"},{"g":"very"},null]}]}