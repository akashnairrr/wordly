{"id":"gemeinsam","lemma":"gemeinsam","pos":"adv","rank":922,"glosses":["together, jointly"],"ipa":"/ɡəˈmaɪnza(ː)m/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/64/De-gemeinsam.ogg/De-gemeinsam.ogg.mp3","examples":[{"text":"Wir entscheiden alles gemeinsam.","en":"We make every decision together.","audio":"https://tatoeba.org/en/audio/download/562268","words":[{"g":"we"},{"g":"to decide"},{"g":"everything"},null]},{"text":"Wir könnten gemeinsam gehen.","en":"We could go together.","audio":"https://tatoeba.org/en/audio/download/700176","words":[{"g":"we"},{"g":"can, to be able to","l":"können"},null,{"g":"to go, to walk"}]},{"text":"Sie haben nichts gemeinsam.","en":"They have nothing in common.","audio":"https://tatoeba.org/en/audio/download/484852","words":[{"g":"she / they / you"},{"g":"have"},{"g":"nothing"},null]},{"text":"Wir müssen es gemeinsam tun.","en":"We have to do it together.","words":[{"g":"we"},{"g":"to have to"},{"g":"it"},null,{"g":"to do"}]},{"text":"Ich hoffe, ihr seid gemeinsam glücklich.","en":"I hope you're happy together.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},{"g":"you (pl.) / her"},{"g":"are","l":"sein"},null,{"g":"happy"}]}]}