{"id":"zwei","lemma":"zwei","pos":"num","rank":115,"glosses":["two (numerical value represented by the Arabic numeral 2; or describing a set with two components)"],"ipa":"/t͡svaɪ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/27/De-zwei.ogg/De-zwei.ogg.mp3","examples":[{"text":"Warum hast du zwei Wagen?","en":"Why do you have two cars?","audio":"https://tatoeba.org/en/audio/download/759783","words":[{"g":"why"},{"g":"have","l":"haben"},{"g":"you"},null,{"g":"a car"}]},{"text":"Seid ihr zwei fertig?","en":"Are you two ready?","words":[{"g":"are","l":"sein"},{"g":"you (pl.) / her"},null,{"g":"ready for use"}]},{"text":"Ich lasse euch zwei allein.","en":"I'll leave you two alone.","audio":"https://tatoeba.org/en/audio/download/567148","words":[{"g":"I"},{"g":"to allow","l":"lassen"},{"g":"you (pl.)","l":"ihr"},null,{"g":"alone"}]},{"text":"Kennt ihr zwei euch schon?","en":"Do you two already know each other?","words":[{"g":"to know","l":"kennen"},{"g":"you (pl.) / her"},null,{"g":"you (pl.)","l":"ihr"},{"g":"already"}]},{"text":"Wir haben zwei Kinder.","en":"We have two kids.","audio":"https://tatoeba.org/en/audio/download/789417","words":[{"g":"we"},{"g":"have"},null,{"g":"kid","l":"Kind"}]}]}