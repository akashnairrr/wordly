{"id":"entlang","lemma":"entlang","pos":"prep","rank":1021,"glosses":["[with genitive]","[with dative]"],"ipa":"/ɛntˈlaŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5a/De-entlang.ogg/De-entlang.ogg.mp3","examples":[{"text":"Er ging den Fluss entlang.","en":"He walked along the river.","audio":"https://tatoeba.org/en/audio/download/760808","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},{"g":"the","l":"der"},{"g":"river"},null]},{"text":"Der Hund ging die Straße entlang.","en":"The dog was walking down the street.","words":[{"g":"the"},{"g":"dog, hound"},{"g":"to go, to walk","l":"gehen"},{"g":"the"},{"g":"street"},null]},{"text":"Hier entlang, bitte.","en":"This way, please.","audio":"https://tatoeba.org/en/audio/download/496858","words":[{"g":"here"},null,{"g":"please"}]},{"text":"Gehe dort entlang!","en":"Go that way.","audio":"https://tatoeba.org/en/audio/download/108511","words":[{"g":"to go, to walk","l":"gehen"},{"g":"there, yonder"},null]},{"text":"Wir gingen am Strand entlang.","en":"We walked along the beach.","words":[{"g":"we"},{"g":"to go, to walk","l":"gehen"},{"g":"at the / on the"},{"g":"beach"},null]}]}