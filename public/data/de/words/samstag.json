{"id":"samstag","lemma":"Samstag","pos":"noun","rank":1517,"glosses":["Saturday"],"ipa":"/ˈzamstaːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2f/De-Samstag-2.oga/De-Samstag-2.oga.mp3","gender":"m","forms":{"genitive":"Samstages","plural":"Samstage"},"formAudio":{"Samstages":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q188_%28deu%29-Sebastian_Wallroth-Samstages.wav","Samstage":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q188_%28deu%29-Sebastian_Wallroth-Samstage.wav"},"examples":[{"text":"Heute ist Samstag.","en":"Today is Saturday.","audio":"https://tatoeba.org/en/audio/download/394434","words":[{"g":"today"},{"g":"is","l":"sein"},null]},{"text":"Ich werde dich am Samstag sehen.","en":"I'll see you Saturday.","audio":"https://tatoeba.org/en/audio/download/755562","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},{"g":"at the / on the"},null,{"g":"to see"}]},{"text":"Am Samstag kann ich nicht gehen.","en":"I can't go on Saturday.","words":[{"g":"at the / on the"},null,{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"not"},{"g":"to go, to walk"}]},{"text":"Ich arbeite jeden Tag, außer Samstag.","en":"I work every day except Saturday.","words":[{"g":"I"},{"g":"to work","l":"arbeiten"},{"g":"each","l":"jeder"},{"g":"day"},{"g":"except"},null]},{"text":"Ich mag Samstage.","en":"I like Saturdays.","words":[{"g":"I"},{"g":"to like","l":"mögen"},null]}]}