{"id":"verzweiflung","lemma":"Verzweiflung","pos":"noun","rank":3864,"glosses":["desperation"],"ipa":"/fɛɐ̯ˈt͡svaɪ̯flʊŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/De-Verzweiflung.ogg/De-Verzweiflung.ogg.mp3","gender":"f","forms":{"genitive":"Verzweiflung","plural":"Verzweiflungen"},"examples":[{"text":"Die Verzweiflung trieb ihn zum Selbstmord.","en":"Despair drove him to attempt suicide.","words":[{"g":"the"},null,{"g":"to drive","l":"treiben"},{"g":"him"},{"g":"to the"},{"g":"suicide"}]},{"text":"Tom geriet in große Verzweiflung.","en":"Tom got very desperate.","audio":"https://tatoeba.org/en/audio/download/759300","words":[null,{"g":"to turn out","l":"geraten"},{"g":"in"},{"g":"big","l":"groß"},null]},{"text":"Tom fiel großer Verzweiflung anheim.","en":"Tom got very desperate.","audio":"https://tatoeba.org/en/audio/download/759301","words":[null,{"g":"to fall, to drop","l":"fallen"},{"g":"big","l":"groß"},null,null]},{"text":"Man konnte die Verzweiflung in Marias Stimme hören.","en":"You could hear the desperation in Mary's voice.","words":[{"g":"one"},{"g":"can, to be able to","l":"können"},{"g":"the"},null,{"g":"in"},null,{"g":"voice"},{"g":"to hear through the ear)"}]},{"text":"Tom geriet in tiefe Verzweiflung.","en":"Tom fell into the depths of despair.","words":[null,{"g":"to turn out","l":"geraten"},{"g":"in"},{"g":"depth"},null]}]}