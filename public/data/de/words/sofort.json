{"id":"sofort","lemma":"sofort","pos":"adv","rank":203,"glosses":["immediately, at once"],"ipa":"/zoˈfɔʁt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/18/De-sofort.ogg/De-sofort.ogg.mp3","examples":[{"text":"Du solltest es sofort tun.","en":"You ought to do it at once.","audio":"https://tatoeba.org/en/audio/download/566674","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"it"},null,{"g":"to do"}]},{"text":"Ich muss dich sofort sehen.","en":"I need to see you immediately.","audio":"https://tatoeba.org/en/audio/download/567078","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"you","l":"du"},null,{"g":"to see"}]},{"text":"Komm sofort hierher.","en":"Come here at once.","words":[{"g":"to come","l":"kommen"},null,{"g":"to here, here , hither"}]},{"text":"Bitte komme sofort zurück.","en":"Please come back at once.","words":[{"g":"please"},{"g":"to come","l":"kommen"},null,{"g":"stand back!"}]},{"text":"Ich möchte sofort anfangen.","en":"I'd like to begin immediately.","words":[{"g":"I"},{"g":"to like","l":"mögen"},null,{"g":"to begin"}]}]}