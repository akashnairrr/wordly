{"id":"dann","lemma":"dann","pos":"adv","rank":45,"glosses":["then, after that","then, in that case"],"ipa":"/dan/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d0/De-dann.ogg/De-dann.ogg.mp3","examples":[{"text":"Wenn nicht jetzt, wann dann?","en":"If not now, then when?","audio":"https://tatoeba.org/en/audio/download/700168","words":[null,null,{"g":"now"},{"g":"when"},null],"phrases":[[0,2,"unless"]]},{"text":"Und was ist dann passiert?","en":"And then what happened?","audio":"https://tatoeba.org/en/audio/download/755884","words":[{"g":"and"},{"g":"what"},{"g":"is","l":"sein"},null,{"g":"to happen","l":"passieren"}]},{"text":"Dann werde ich es tun.","en":"That's when I'll do it.","audio":"https://tatoeba.org/en/audio/download/759231","words":[null,{"g":"to become","l":"werden"},{"g":"I"},{"g":"it"},{"g":"to do"}]},{"text":"Und was hast du dann gemacht?","en":"And then, what did you do?","audio":"https://tatoeba.org/en/audio/download/761176","words":[{"g":"and"},{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},null,{"g":"to make","l":"machen"}]},{"text":"Wenn du willst, dann gehen wir.","en":"If you want to, we'll go.","words":[{"g":"if / when"},{"g":"you"},{"g":"to want","l":"wollen"},null,{"g":"to go, to walk"},{"g":"we"}]}]}