{"id":"selten","lemma":"selten","pos":"adv","rank":1516,"glosses":["seldom; rarely","unusually; extremely"],"ipa":"/ˈzɛltən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ef/De-at-selten.ogg/De-at-selten.ogg.mp3","examples":[{"text":"Sie geht selten aus.","en":"She seldom goes out.","audio":"https://tatoeba.org/en/audio/download/69554","words":[{"g":"she / they / you"},{"g":"to go, to walk","l":"gehen"},null,{"g":"out of / from"}]},{"text":"Ich trinke selten Bier.","en":"I seldom drink beer.","audio":"https://tatoeba.org/en/audio/download/746604","words":[{"g":"I"},{"g":"to drink by mouth)","l":"trinken"},null,{"g":"beer (alcoholic…"}]},{"text":"Wir singen selten.","en":"We seldom sing.","words":[{"g":"we"},{"g":"to sing"},null]},{"text":"Ich höre von ihm selten etwas.","en":"I seldom hear from him.","words":[{"g":"I"},{"g":"to hear through the ear)","l":"hören"},{"g":"from / of"},{"g":"(to) him","l":"er"},null,{"g":"something"}]},{"text":"Unser Lehrer lacht selten.","en":"Our teacher seldom laughs.","words":[{"g":"our"},{"g":"to teach","l":"lehren"},{"g":"to laugh","l":"lachen"},null]}]}