ade into butter and cheese.","words":[{"g":"milk"},{"g":"to become","l":"werden"},{"g":"to / too"},{"g":"butter"},{"g":"and"},{"g":"cheese"},null]},{"text":"Erdbeeren werden zu Marmelade verarbeitet.","en":"Strawberries are made into jam.","words":[{"g":"strawberry","l":"Erdbeere"},{"g":"to become"},{"g":"to / too"},{"g":"jam"},null]}]}