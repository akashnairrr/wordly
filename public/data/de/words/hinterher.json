{"id":"hinterher","lemma":"hinterher","pos":"adv","rank":1624,"glosses":["behind","afterwards"],"ipa":"/ˈhɪntɐˌhɛɐ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/56/De-hinterher.ogg/De-hinterher.ogg.mp3","examples":[{"text":"Komm mir hinterher.","en":"Follow behind me.","words":[{"g":"to come","l":"kommen"},{"g":"(to) me","l":"ich"},null]},{"text":"Was ist hinterher passiert?","en":"What happened afterwards?","words":[{"g":"what"},{"g":"is","l":"sein"},null,{"g":"to happen","l":"passieren"}]},{"text":"Fahren Sie diesem Wagen hinterher.","en":"Follow that car.","audio":"https://tatoeba.org/en/audio/download/74653","words":[{"g":"to go at speed"},{"g":"she / they / you"},{"g":"this one, this","l":"dieser"},{"g":"a car"},null]},{"text":"Kommen Sie mir nicht hinterher!","en":"Don't follow me.","audio":"https://tatoeba.org/en/audio/download/81795","words":[{"g":"to come"},{"g":"she / they / you"},{"g":"(to) me","l":"ich"},{"g":"not"},null]},{"text":"Ein Hund lief der Katze hinterher.","en":"A dog ran after the cat.","words":[{"g":"a"},{"g":"dog, hound"},{"g":"to walk","l":"laufen"},{"g":"the"},{"g":"house cat"},null]}]}