{"id":"notiz","lemma":"Notiz","pos":"noun","rank":3260,"glosses":["note (memorandum)","memo"],"ipa":"/noˈtiːts/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/43/De-Notiz.ogg/De-Notiz.ogg.mp3","gender":"f","forms":{"genitive":"Notiz","plural":"Notizen"},"examples":[{"text":"Ich brauche meine Notizen.","en":"I need my notes.","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"my","l":"mein"},null]},{"text":"Hast du eine Notiz geschrieben?","en":"Did you write a note?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"a"},null,{"g":"to write, to write out","l":"schreiben"}]},{"text":"Du solltest dir Notizen machen.","en":"You should make notes.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"(to) you","l":"du"},null,{"g":"to make"}]},{"text":"Habt ihr die Notiz gelesen?","en":"Did you read the note?","words":[{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},{"g":"the"},null,{"g":"to read","l":"lesen"}]},{"text":"Sie sollten sich Notizen machen.","en":"You should make notes.","words":[{"g":"she / they / you"},{"g":"should","l":"sollen"},{"g":"oneself"},null,{"g":"to make"}]}]}