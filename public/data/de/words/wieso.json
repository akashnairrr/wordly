{"id":"wieso","lemma":"wieso","pos":"adv","rank":139,"glosses":["why"],"ipa":"/viˈzoː/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/99/De-wieso.ogg/De-wieso.ogg.mp3","examples":[{"text":"Wieso sind sie hier?","en":"Why are they here?","audio":"https://tatoeba.org/en/audio/download/394117","words":[null,{"g":"are","l":"sein"},{"g":"she / they / you"},{"g":"here"}]},{"text":"Wieso sollte ich warten?","en":"Why should I wait?","audio":"https://tatoeba.org/en/audio/download/390521","words":[null,{"g":"should","l":"sollen"},{"g":"I"},{"g":"to wait"}]},{"text":"Wieso sollten wir dir helfen?","en":"Why should we help you?","audio":"https://tatoeba.org/en/audio/download/760143","words":[null,{"g":"should","l":"sollen"},{"g":"we"},{"g":"(to) you","l":"du"},{"g":"to help"}]},{"text":"Wieso ist dein Mund so groß?","en":"Why is your mouth so big?","audio":"https://tatoeba.org/en/audio/download/759616","words":[null,{"g":"is","l":"sein"},{"g":"your"},{"g":"mouth of a person"},{"g":"so"},{"g":"big"}]},{"text":"Sie wissen nicht einmal, wieso.","en":"They don't even know why.","audio":"https://tatoeba.org/en/audio/download/871","words":[{"g":"she / they / you"},{"g":"to know"},null,null,null],"phrases":[[2,4,"not even"]]}]}