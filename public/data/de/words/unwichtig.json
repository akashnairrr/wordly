{"id":"unwichtig","lemma":"unwichtig","pos":"adj","rank":2333,"glosses":["unimportant"],"ipa":"/ˈʊnvɪçtɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1a/De-unwichtig.wav/De-unwichtig.wav.mp3","forms":{"comparative":"unwichtiger","superlative":"am unwichtigsten"},"examples":[{"text":"Seine Meinung war unwichtig.","en":"His opinion was unimportant.","words":[{"g":"his","l":"seiner"},{"g":"opinion"},{"g":"was","l":"sein"},null]},{"text":"Die Sache ist unwichtig.","en":"The matter is of no importance.","words":[{"g":"the"},{"g":"matter"},{"g":"is","l":"sein"},null]},{"text":"Es ist unwichtig, was wir denken.","en":"It doesn't matter what we think.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"what"},{"g":"we"},{"g":"to think"}]},{"text":"Es ist unwichtig, woher er kommt.","en":"It doesn't matter where he comes from.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"where from, whence"},{"g":"he / it"},{"g":"to come","l":"kommen"}]},{"text":"Alles andere ist unwichtig.","en":"Everything else is irrelevant.","words":[{"g":"everything"},{"g":"another , others","l":"anderer"},{"g":"is","l":"sein"},null]}]}