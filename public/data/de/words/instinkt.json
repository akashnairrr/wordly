{"id":"instinkt","lemma":"Instinkt","pos":"noun","rank":3406,"glosses":["instinct"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/De-Instinkt.ogg/De-Instinkt.ogg.mp3","gender":"m","forms":{"genitive":"Instinktes","plural":"Instinkte"},"examples":[{"text":"Ich hätte meinem Instinkt vertrauen sollen.","en":"I should've trusted my instinct.","words":[{"g":"I"},{"g":"to have","l":"haben"},{"g":"my","l":"mein"},null,{"g":"to trust"},{"g":"should"}]},{"text":"Deine Instinkte waren falsch.","en":"Your instincts were wrong.","words":[{"g":"your","l":"dein"},null,{"g":"to be","l":"sein"},{"g":"false"}]},{"text":"Mein Instinkt hat mich nicht betrogen.","en":"My instinct was right.","audio":"https://tatoeba.org/en/audio/download/755617","words":[{"g":"my"},null,{"g":"has","l":"haben"},{"g":"me","l":"ich"},{"g":"not"},{"g":"to deceive","l":"betrügen"}]},{"text":"Mit meinem Instinkt lag ich richtig.","en":"My instinct was right.","audio":"https://tatoeba.org/en/audio/download/755619","words":[{"g":"with"},{"g":"my","l":"mein"},null,{"g":"to lie","l":"liegen"},{"g":"I"},{"g":"correct"}]},{"text":"Mein Instinkt hat ins Schwarze getroffen.","en":"My instinct was right.","audio":"https://tatoeba.org/en/audio/download/755620","words":[{"g":"my"},null,{"g":"has","l":"haben"},{"g":"into the"},{"g":"a black object or being","l":"Schwarzer"},{"g":"hit, struck, met"}]}]}