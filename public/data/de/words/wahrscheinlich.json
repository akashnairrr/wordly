{"id":"wahrscheinlich","lemma":"wahrscheinlich","pos":"adv","rank":421,"glosses":["probably, likely"],"ipa":"/vaː(ɐ̯)ˈʃaɪ̯nlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/De-wahrscheinlich.ogg/De-wahrscheinlich.ogg.mp3","examples":[{"text":"Ich kann wahrscheinlich gewinnen.","en":"I can probably win.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"to win"}]},{"text":"Er ist wahrscheinlich tot.","en":"He is probably dead.","words":[{"g":"he / it"},{"g":"is","l":"sein"},null,{"g":"dead, deceased"}]},{"text":"Ich weiß, was du wahrscheinlich denkst.","en":"I know what you're probably thinking.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"what"},{"g":"you"},null,{"g":"to think","l":"denken"}]},{"text":"Er schläft wahrscheinlich gerade.","en":"He's probably sleeping.","audio":"https://tatoeba.org/en/audio/download/755449","words":[{"g":"he / it"},{"g":"to sleep","l":"schlafen"},null,{"g":"now"}]},{"text":"Ich bin wahrscheinlich zu alt.","en":"I'm probably too old.","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"to / too"},{"g":"old"}]}]}