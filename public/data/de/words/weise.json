{"id":"weise","lemma":"Weise","pos":"noun","rank":722,"glosses":["way, manner","tune","mode/mood (of verbs)"],"ipa":"/ˈvaɪ̯zə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/06/De-Weise.ogg/De-Weise.ogg.mp3","gender":"f","forms":{"genitive":"Weise","plural":"Weisen"},"examples":[{"text":"Mach' es auf diese Weise.","en":"Do it this way.","audio":"https://tatoeba.org/en/audio/download/45671","words":[{"g":"to make","l":"machen"},{"g":"it"},{"g":"on"},{"g":"this one, this","l":"dieser"},null]},{"text":"Können Sie mir den Weg weisen?","en":"Can you show me the way?","words":[{"g":"can, to be able to"},{"g":"she / they / you"},{"g":"(to) me","l":"ich"},{"g":"the","l":"der"},{"g":"away"},null]},{"text":"Sie ist sehr weise.","en":"She's very wise.","audio":"https://tatoeba.org/en/audio/download/394906","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},{"g":"very"},null]},{"text":"Könntest du mir bitte den Weg weisen?","en":"Would you please tell me the way?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"(to) me","l":"ich"},{"g":"please"},{"g":"the","l":"der"},{"g":"away"},null]},{"text":"Du bist weise.","en":"You're wise.","audio":"https://tatoeba.org/en/audio/download/106449","words":[{"g":"you"},{"g":"are","l":"sein"},null]}]}