{"id":"mal","lemma":"mal","pos":"adv","rank":42,"glosses":["just (softens a request)","once, sometime","times (multiplied by)"],"ipa":"/maːl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/De-mal.ogg/De-mal.ogg.mp3","examples":[{"text":"Kann ich das mal sehen?","en":"Can I see that one?","audio":"https://tatoeba.org/en/audio/download/394578","words":[{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"the / that"},null,{"g":"to see"}]},{"text":"Ich war ein Mal verheiratet.","en":"I was married once.","audio":"https://tatoeba.org/en/audio/download/393800","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"a"},null,{"g":"married (in a state of…"}]},{"text":"Das ist das letzte Mal.","en":"This is the last time.","audio":"https://tatoeba.org/en/audio/download/698841","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"the / that"},{"g":"last"},null]},{"text":"Dieses Mal kriegen wir es.","en":"We'll get it this time.","audio":"https://tatoeba.org/en/audio/download/759906","words":[{"g":"this one, this","l":"dieser"},null,{"g":"to get"},{"g":"we"},{"g":"it"}]},{"text":"Willst du mal meine Katze sehen?","en":"Do you want to see my cat?","audio":"https://tatoeba.org/en/audio/download/761007","words":[{"g":"to want","l":"wollen"},{"g":"you"},null,{"g":"my","l":"mein"},{"g":"house cat"},{"g":"to see"}]}]}