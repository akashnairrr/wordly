{"id":"daran","lemma":"daran","pos":"adv","rank":228,"glosses":["on it, on that","at it, at that","thereto"],"ipa":"/daˈʁan/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d2/De-daran.ogg/De-daran.ogg.mp3","examples":[{"text":"Ich arbeite daran.","en":"I'm working on it.","audio":"https://tatoeba.org/en/audio/download/80677","words":[{"g":"I"},{"g":"to work","l":"arbeiten"},null]},{"text":"Wir arbeiten daran.","en":"We're working on it.","audio":"https://tatoeba.org/en/audio/download/87204","words":[{"g":"we"},{"g":"to work"},null]},{"text":"Hast du daran gedacht?","en":"Have you thought of that?","audio":"https://tatoeba.org/en/audio/download/566280","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"to think","l":"denken"}]},{"text":"Daran muss ich noch arbeiten.","en":"I still have to work hard.","audio":"https://tatoeba.org/en/audio/download/761832","words":[null,{"g":"to have to","l":"müssen"},{"g":"I"},{"g":"still / yet"},{"g":"to work"}]},{"text":"Warum bist du so daran interessiert?","en":"Why are you so interested in that?","words":[{"g":"why"},{"g":"are","l":"sein"},{"g":"you"},{"g":"so"},null,{"g":"interested"}]}]}