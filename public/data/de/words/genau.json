{"id":"genau","lemma":"genau","pos":"adv","rank":116,"glosses":["just, exactly"],"ipa":"/ɡəˈnaʊ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e4/De-genau.ogg/De-genau.ogg.mp3","examples":[{"text":"Was genau willst du wissen?","en":"What is it you want to know?","audio":"https://tatoeba.org/en/audio/download/711831","words":[{"g":"what"},null,{"g":"to want","l":"wollen"},{"g":"you"},{"g":"to know"}]},{"text":"Was genau machen Sie?","en":"What is it that you do, exactly?","audio":"https://tatoeba.org/en/audio/download/565944","words":[{"g":"what"},null,{"g":"to make"},{"g":"she / they / you"}]},{"text":"Was ist das genau?","en":"What is that exactly?","words":[{"g":"what"},{"g":"is","l":"sein"},{"g":"the / that"},null]},{"text":"Ich weiß genau, wer es ist.","en":"I know exactly who it is.","words":[{"g":"I"},{"g":"to know","l":"wissen"},null,{"g":"who"},{"g":"it"},{"g":"is","l":"sein"}]},{"text":"Ich weiß genau, was du brauchst.","en":"I know just what you need.","words":[{"g":"I"},{"g":"to know","l":"wissen"},null,{"g":"what"},{"g":"you"},{"g":"to need","l":"brauchen"}]}]}