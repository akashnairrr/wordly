{"id":"bald","lemma":"bald","pos":"adv","rank":256,"glosses":["soon (near in time)","almost (of a changing value that is predicted to reach said number soon)","indicates a rapid alternation of states; now ..., now ...; sometimes ..., sometimes ..."],"ipa":"/balt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fb/De-bald.ogg/De-bald.ogg.mp3","examples":[{"text":"Komm bald zurück.","en":"Come back soon.","audio":"https://tatoeba.org/en/audio/download/28223","words":[{"g":"to come","l":"kommen"},null,{"g":"stand back!"}]},{"text":"Ich rufe bald zurück.","en":"I'll call back soon.","audio":"https://tatoeba.org/en/audio/download/789551","words":[{"g":"I"},{"g":"to call out","l":"rufen"},null,{"g":"stand back!"}]},{"text":"Sind wir bald da?","en":"Are we there yet?","audio":"https://tatoeba.org/en/audio/download/755337","words":[{"g":"are","l":"sein"},{"g":"we"},null,{"g":"there"}]},{"text":"Bald ist Weihnachten.","en":"Christmas is soon.","audio":"https://tatoeba.org/en/audio/download/395062","words":[null,{"g":"is","l":"sein"},{"g":"Christmas"}]},{"text":"Er wird bald hier sein.","en":"He'll be here soon.","audio":"https://tatoeba.org/en/audio/download/394586","words":[{"g":"he / it"},{"g":"to become","l":"werden"},null,{"g":"here"},{"g":"to be"}]}]}