{"id":"verbindung","lemma":"Verbindung","pos":"noun","rank":726,"glosses":["connection","compound","accession"],"ipa":"/fɛɐ̯ˈbɪndʊŋ(k)/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4b/De-at-Verbindung.ogg/De-at-Verbindung.ogg.mp3","gender":"f","forms":{"genitive":"Verbindung","plural":"Verbindungen"},"examples":[{"text":"Ich hoffe, wir bleiben in Verbindung.","en":"I hope we stay in touch.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},{"g":"we"},{"g":"to remain"},{"g":"in"},null]},{"text":"Er bleibt mit ihr in Verbindung.","en":"He stays in touch with her.","words":[{"g":"he / it"},{"g":"to remain","l":"bleiben"},{"g":"with"},{"g":"you (pl.) / her"},{"g":"in"},null]},{"text":"Bitte bleib in Verbindung.","en":"Please keep in touch.","words":[{"g":"please"},{"g":"to remain","l":"bleiben"},{"g":"in"},null]},{"text":"Wir haben die Verbindung verloren.","en":"We've lost contact.","words":[{"g":"we"},{"g":"have"},{"g":"the"},null,{"g":"lost, missing"}]},{"text":"Setze dich mit mir in Verbindung!","en":"Get in touch with me.","words":[{"g":"to sit down","l":"setzen"},{"g":"you","l":"du"},{"g":"with"},{"g":"(to) me","l":"ich"},{"g":"in"},null]}]}