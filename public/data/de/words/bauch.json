{"id":"bauch","lemma":"Bauch","pos":"noun","rank":1533,"glosses":["abdomen, belly"],"ipa":"/baʊ̯x/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/49/De-Bauch.ogg/De-Bauch.ogg.mp3","gender":"m","forms":{"genitive":"Bauches","plural":"Bäuche"},"examples":[{"text":"Mein Bauch ist voll.","en":"My stomach is full.","words":[{"g":"my"},null,{"g":"is","l":"sein"},{"g":"full"}]},{"text":"Das Kind schläft auf dem Bauch.","en":"The child is sleeping on his stomach.","words":[{"g":"the / that"},{"g":"kid"},{"g":"to sleep","l":"schlafen"},{"g":"on"},{"g":"(to) the","l":"der"},null]},{"text":"Ich schlafe gerne auf dem Bauch.","en":"I like to sleep on my stomach.","words":[{"g":"I"},{"g":"to sleep","l":"schlafen"},{"g":"don't mention it"},{"g":"on"},{"g":"(to) the","l":"der"},null]},{"text":"Lege dich auf den Bauch.","en":"Lie on your stomach.","words":[{"g":"to lie down","l":"legen"},{"g":"you","l":"du"},{"g":"on"},{"g":"the","l":"der"},null]},{"text":"Mein Bauch tut mir weh.","en":"My stomach hurts.","words":[{"g":"my"},null,{"g":"to do","l":"tun"},{"g":"(to) me","l":"ich"},{"g":"sore, painful"}]}]}