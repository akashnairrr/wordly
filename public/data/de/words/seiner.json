{"id":"seiner","lemma":"seiner","pos":"pron","rank":114,"glosses":["his (substantival possessive)"],"ipa":"/ˈzaɪ̯nɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/85/De-seiner.ogg/De-seiner.ogg.mp3","forms":{"plural":"seine"},"examples":[{"text":"Ich brauche seine Hilfe.","en":"I need his help.","audio":"https://tatoeba.org/en/audio/download/28730","words":[{"g":"I"},{"g":"to need","l":"brauchen"},null,{"g":"the act of helping"}]},{"text":"Ich kenne seine Familie.","en":"I know his family.","audio":"https://tatoeba.org/en/audio/download/394997","words":[{"g":"I"},{"g":"to know","l":"kennen"},null,{"g":"family"}]},{"text":"Er spielte mit seiner Katze.","en":"He played with his cat.","audio":"https://tatoeba.org/en/audio/download/755116","words":[{"g":"he / it"},{"g":"to play","l":"spielen"},{"g":"with"},null,{"g":"house cat"}]},{"text":"Das Baby braucht seine Mutter.","en":"The baby needs his mother.","audio":"https://tatoeba.org/en/audio/download/40858","words":[{"g":"the / that"},{"g":"baby"},{"g":"to need","l":"brauchen"},null,{"g":"mother"}]},{"text":"Das Baby kommt nach seiner Mutter.","en":"The baby takes after his mother.","words":[{"g":"the / that"},{"g":"baby"},{"g":"to come","l":"kommen"},{"g":"after / to"},null,{"g":"mother"}]}]}