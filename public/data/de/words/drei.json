{"id":"drei","lemma":"drei","pos":"num","rank":168,"glosses":["three (numerical value represented by the Arabic numeral 3; or describing a set with three elements)"],"ipa":"/dʁaɪ̯/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/73/De-drei.ogg/De-drei.ogg.mp3","examples":[{"text":"Um drei kann ich kommen.","en":"I can come at three.","audio":"https://tatoeba.org/en/audio/download/700333","words":[{"g":"around / at"},null,{"g":"can, to be able to","l":"können"},{"g":"I"},{"g":"to come"}]},{"text":"Wir haben drei Minuten.","en":"We have three minutes.","audio":"https://tatoeba.org/en/audio/download/757855","words":[{"g":"we"},{"g":"have"},null,{"g":"minute (unit of time","l":"Minute"}]},{"text":"Gebt uns drei Minuten.","en":"Give us three minutes.","audio":"https://tatoeba.org/en/audio/download/567152","words":[{"g":"to give","l":"geben"},{"g":"us","l":"wir"},null,{"g":"minute (unit of time","l":"Minute"}]},{"text":"Ich habe drei Computer.","en":"I have three computers.","audio":"https://tatoeba.org/en/audio/download/757705","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"computer"}]},{"text":"Es ist fast drei.","en":"It's almost three.","audio":"https://tatoeba.org/en/audio/download/69549","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"almost"},null]}]}