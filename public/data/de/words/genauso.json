{"id":"genauso","lemma":"genauso","pos":"adv","rank":507,"glosses":["just as, just the same"],"ipa":"/ɡəˈnaʊ̯zoː/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/De-genauso.ogg/De-genauso.ogg.mp3","examples":[{"text":"Ich bin genauso alt.","en":"I am the same age.","audio":"https://tatoeba.org/en/audio/download/69534","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"old"}]},{"text":"Wir könnten genauso gut warten.","en":"We may as well wait.","audio":"https://tatoeba.org/en/audio/download/711655","words":[{"g":"we"},{"g":"can, to be able to","l":"können"},null,{"g":"good"},{"g":"to wait"}]},{"text":"Er läuft genauso schnell wie du.","en":"He runs as fast as you.","audio":"https://tatoeba.org/en/audio/download/756328","words":[{"g":"he / it"},null,null,{"g":"quickly"},{"g":"how"},{"g":"you"}]},{"text":"Ich weiß genauso wenig wie du.","en":"I know as little as you do.","words":[{"g":"I"},{"g":"to know","l":"wissen"},null,{"g":"little, few"},{"g":"how"},{"g":"you"}]},{"text":"Ich wollte genauso sein wie ihr.","en":"I wanted to be just like you.","words":[{"g":"I"},{"g":"to want","l":"wollen"},null,null,null,{"g":"you (pl.) / her"}],"phrases":[[3,5,"be like"]]}]}