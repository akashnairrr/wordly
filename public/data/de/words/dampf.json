{"id":"dampf","lemma":"Dampf","pos":"noun","rank":4028,"glosses":["steam","vapor / vapour"],"ipa":"/dam(p)f/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/46/De-Dampf.ogg/De-Dampf.ogg.mp3","gender":"m","forms":{"genitive":"Dampfes","plural":"Dämpfe"},"examples":[{"text":"Ich muss etwas Dampf ablassen.","en":"I need to blow off some steam.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"something"},null,{"g":"to drain"}]},{"text":"Atme die Dämpfe nicht ein!","en":"Don't breathe the fumes.","words":[{"g":"to breathe","l":"atmen"},{"g":"the"},null,{"g":"not"},{"g":"a"}]},{"text":"Ich habe nur gerade Dampf abgelassen.","en":"I was just blowing off steam.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"only"},{"g":"now"},null,{"g":"to drain","l":"ablassen"}]},{"text":"Durch den Dampf ist meine Brille beschlagen.","en":"The steam has fogged my glasses.","words":[{"g":"by means of"},{"g":"the","l":"der"},null,{"g":"is","l":"sein"},{"g":"my","l":"mein"},{"g":"glasses, spectacles"},{"g":"to coat with…"}]},{"text":"Die Lokomotive wird von Dampf angetrieben.","en":"The engine is driven by steam.","words":[{"g":"the"},{"g":"train locomotive"},{"g":"to become","l":"werden"},{"g":"from / of"},null,{"g":"driven"}]}]}