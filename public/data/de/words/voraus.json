{"id":"voraus","lemma":"voraus","pos":"adv","rank":1411,"glosses":["in front, ahead"],"ipa":"/foˈʁaʊ̯s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/De-voraus.ogg/De-voraus.ogg.mp3","examples":[{"text":"Ich gehe voraus.","en":"I'll go on ahead.","audio":"https://tatoeba.org/en/audio/download/103760","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},null]},{"text":"Können Sie mich im Voraus bezahlen?","en":"Can you pay me in advance?","words":[{"g":"can, to be able to"},{"g":"she / they / you"},{"g":"me","l":"ich"},{"g":"in the"},null,{"g":"to pay"}]},{"text":"Hast du im voraus bezahlt?","en":"Did you pay in advance?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"in the"},null,{"g":"to pay","l":"bezahlen"}]},{"text":"Du bist uns weit voraus.","en":"You're way ahead of us.","audio":"https://tatoeba.org/en/audio/download/760200","words":[{"g":"you"},{"g":"are","l":"sein"},{"g":"us","l":"wir"},{"g":"wide"},null]},{"text":"Ich danke dir im Voraus.","en":"Thank you in advance.","words":[{"g":"I"},{"g":"thanks, thank you"},{"g":"(to) you","l":"du"},{"g":"in the"},null]}]}