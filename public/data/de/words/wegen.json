{"id":"wegen","lemma":"wegen","pos":"prep","rank":162,"glosses":["for, because of","concerning, regarding"],"ipa":"/ˈveːɡən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1f/De-wegen.ogg/De-wegen.ogg.mp3","examples":[{"text":"Wir sind wegen dir hier.","en":"We're here because of you.","audio":"https://tatoeba.org/en/audio/download/700249","words":[{"g":"we"},{"g":"are","l":"sein"},null,{"g":"(to) you","l":"du"},{"g":"here"}]},{"text":"Ich bin wegen dir gekommen.","en":"I came for you.","audio":"https://tatoeba.org/en/audio/download/43660","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"(to) you","l":"du"},{"g":"to come","l":"kommen"}]},{"text":"Ich mach das wegen dem Geld.","en":"I do that for the money.","words":[{"g":"I"},{"g":"to make","l":"machen"},{"g":"the / that"},null,{"g":"(to) the","l":"der"},{"g":"money"}]},{"text":"Gehst du wegen mir weg?","en":"Did you leave because of me?","words":[{"g":"to go, to walk","l":"gehen"},{"g":"you"},null,{"g":"(to) me","l":"ich"},{"g":"away"}]},{"text":"Es tut mir leid wegen gestern.","en":"Sorry about yesterday.","audio":"https://tatoeba.org/en/audio/download/700350","words":[null,null,null,null,null,{"g":"yesterday"}],"phrases":[[0,4,"Sorry."]]}]}