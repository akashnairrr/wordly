{"id":"deswegen","lemma":"deswegen","pos":"adv","rank":462,"glosses":["therefore, because of that"],"ipa":"/ˈdɛsˈveːɡn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/De-deswegen.ogg/De-deswegen.ogg.mp3","examples":[{"text":"Deswegen mag ich Sie.","en":"That's why I like you.","audio":"https://tatoeba.org/en/audio/download/566063","words":[null,{"g":"to like","l":"mögen"},{"g":"I"},{"g":"she / they / you"}]},{"text":"Deswegen hasse ich ihn.","en":"This is why I hate him.","words":[null,{"g":"to hate","l":"hassen"},{"g":"I"},{"g":"him"}]},{"text":"Deswegen brauche ich Hilfe.","en":"This is why I need help.","words":[null,{"g":"to need","l":"brauchen"},{"g":"I"},{"g":"the act of helping"}]},{"text":"Was wirst du deswegen tun?","en":"What're you going to do about this?","words":[{"g":"what"},{"g":"to become","l":"werden"},{"g":"you"},null,{"g":"to do"}]},{"text":"Ich fühle mich wirklich schlecht deswegen.","en":"I really feel bad about it.","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},{"g":"really, actually"},{"g":"bad"},null]}]}