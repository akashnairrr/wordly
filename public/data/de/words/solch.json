{"id":"solch","lemma":"solch","pos":"pron","rank":528,"glosses":["such"],"ipa":"/zɔlç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e8/De-solch.ogg/De-solch.ogg.mp3","examples":[{"text":"Solch eine Chance kommt nie wieder.","en":"A chance like that will never come again.","words":[null,{"g":"a"},{"g":"chance"},{"g":"to come","l":"kommen"},{"g":"never, never at all"},{"g":"again"}]},{"text":"Du bist solch ein Lügner!","en":"You're such a liar.","words":[{"g":"you"},{"g":"are","l":"sein"},null,{"g":"a"},{"g":"liar"}]},{"text":"Zum Glück hast du solch gute Freunde.","en":"You are fortunate for having such good friends.","words":[null,null,{"g":"have","l":"haben"},{"g":"you"},null,{"g":"good","l":"gut"},{"g":"friends"}],"phrases":[[0,2,"fortunately, luckily"]]},{"text":"Solch einen Menschen gibt es nicht.","en":"No such person exists.","words":[null,{"g":"a","l":"ein"},{"g":"human","l":"Mensch"},{"g":"to give","l":"geben"},{"g":"it"},{"g":"not"}]},{"text":"Sei nicht in solch einer Eile.","en":"Don't be in such a hurry.","words":[{"g":"to be","l":"sein"},{"g":"not"},{"g":"in"},null,{"g":"a / one","l":"ein"},{"g":"hurry"}]}]}