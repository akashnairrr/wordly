{"id":"himmel","lemma":"Himmel","pos":"noun","rank":514,"glosses":["sky","heaven","canopy"],"ipa":"/ˈhɪməl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/70/De-Himmel.ogg/De-Himmel.ogg.mp3","gender":"m","forms":{"genitive":"Himmels","plural":"Himmel"},"examples":[{"text":"Warum ist der Himmel blau?","en":"Why is the sky blue?","audio":"https://tatoeba.org/en/audio/download/565828","words":[{"g":"why"},{"g":"is","l":"sein"},{"g":"the"},null,{"g":"blue"}]},{"text":"Vögel fliegen am Himmel.","en":"Birds fly in the sky.","words":[{"g":"a bird","l":"Vogel"},{"g":"to fly"},{"g":"at the / on the"},null]},{"text":"Die Sonne ist am Himmel.","en":"The sun is in the sky.","words":[{"g":"the"},{"g":"a sun"},{"g":"is","l":"sein"},{"g":"at the / on the"},null]},{"text":"Warum um Himmels willen sollte ich das tun?","en":"Why on earth would I do that?","words":[{"g":"why"},{"g":"around / at"},null,{"g":"will","l":"Wille"},{"g":"should","l":"sollen"},{"g":"I"},{"g":"the / that"},{"g":"to do"}]},{"text":"Der Himmel war voller Sterne.","en":"The sky was full of stars.","words":[{"g":"the"},null,{"g":"was","l":"sein"},{"g":"full of"},{"g":"a star","l":"Stern"}]}]}