{"id":"feigling","lemma":"Feigling","pos":"noun","rank":1852,"glosses":["coward, chicken"],"ipa":"/ˈfaɪ̯klɪŋ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/De-Feigling.ogg/De-Feigling.ogg.mp3","gender":"m","forms":{"genitive":"Feiglings","plural":"Feiglinge"},"examples":[{"text":"Sei kein Feigling!","en":"Don't be a coward.","audio":"https://tatoeba.org/en/audio/download/391688","words":[{"g":"to be","l":"sein"},{"g":"no / not a"},null]},{"text":"Er ist ein großer Feigling.","en":"He's a big coward.","audio":"https://tatoeba.org/en/audio/download/392559","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"a"},{"g":"big","l":"groß"},null]},{"text":"Ihr seid alle Feiglinge.","en":"You're all cowards.","words":[{"g":"you (pl.) / her"},{"g":"are","l":"sein"},{"g":"all, everyone"},null]},{"text":"Ich bin kein Feigling.","en":"I'm no coward.","audio":"https://tatoeba.org/en/audio/download/391912","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"no / not a"},null]},{"text":"Wir sind alle keine Feiglinge.","en":"None of us are cowards.","audio":"https://tatoeba.org/en/audio/download/758773","words":[{"g":"we"},{"g":"are","l":"sein"},{"g":"all, everyone"},{"g":"no / not a","l":"kein"},null]}]}