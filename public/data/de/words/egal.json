{"id":"egal","lemma":"egal","pos":"adv","rank":233,"glosses":["no matter"],"ipa":"/eˈɡaːl/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/De-egal.ogg/De-egal.ogg.mp3","examples":[{"text":"Es ist egal, was ich denke.","en":"It doesn't matter what I think.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"what"},{"g":"I"},{"g":"to think","l":"denken"}]},{"text":"Es ist egal, wann du kommst.","en":"It doesn't matter when you come.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"when"},{"g":"you"},{"g":"to come","l":"kommen"}]},{"text":"Egal wie viel es kostet.","en":"It doesn't matter how much it costs.","words":[null,null,null,{"g":"it"},{"g":"to cost","l":"kosten"}],"phrases":[[1,3,"how much"]]},{"text":"Ist dir das egal?","en":"Do you even care?","audio":"https://tatoeba.org/en/audio/download/437498","words":[{"g":"is","l":"sein"},{"g":"(to) you","l":"du"},{"g":"the / that"},null]},{"text":"Der Rest ist egal.","en":"The rest doesn't matter.","words":[{"g":"the"},{"g":"rest"},{"g":"is","l":"sein"},null]}]}