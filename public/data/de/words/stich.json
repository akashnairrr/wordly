{"id":"stich","lemma":"Stich","pos":"noun","rank":1486,"glosses":["sting, prick, stitch, stab","trick","engraving"],"ipa":"/ʃtɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bc/De-Stich.ogg/De-Stich.ogg.mp3","gender":"m","forms":{"genitive":"Stiches","plural":"Stiche"},"examples":[{"text":"Lass mich nicht im Stich.","en":"Don't let me down.","audio":"https://tatoeba.org/en/audio/download/393725","words":[{"g":"to allow","l":"lassen"},{"g":"me","l":"ich"},{"g":"not"},{"g":"in the"},null]},{"text":"Ich werde dich nie im Stich lassen.","en":"I'll never let you down.","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},{"g":"never, never at all"},{"g":"in the"},null,{"g":"to allow"}]},{"text":"Er hat seine Familie im Stich gelassen.","en":"He abandoned his family.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"his","l":"seiner"},{"g":"family"},{"g":"in the"},null,{"g":"calm"}]},{"text":"Sie hat ihre Kinder im Stich gelassen.","en":"She abandoned her children.","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"her","l":"ihr"},{"g":"kid","l":"Kind"},{"g":"in the"},null,{"g":"calm"}]},{"text":"Tom brauchte 30 Stiche.","en":"Tom needed 30 stitches.","words":[null,{"g":"to need","l":"brauchen"},null]}]}