{"id":"gegenseitig","lemma":"gegenseitig","pos":"adv","rank":1663,"glosses":["mutually","Used to emphasize reciprocity with plural reflexive pronouns."],"ipa":"/ˈɡeːɡn̩ˌzaɪ̯tɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/87/De-gegenseitig.wav/De-gegenseitig.wav.mp3","examples":[{"text":"Wir sollten uns gegenseitig helfen.","en":"We should help each other.","words":[{"g":"we"},{"g":"should","l":"sollen"},{"g":"us","l":"wir"},null,{"g":"to help"}]},{"text":"Sie helfen sich oft gegenseitig.","en":"They often help each other.","words":[{"g":"she / they / you"},{"g":"to help"},{"g":"oneself"},{"g":"often"},null]},{"text":"Die Leute sollten sich gegenseitig lieben.","en":"People should love each other.","words":[{"g":"the"},{"g":"people"},{"g":"should","l":"sollen"},{"g":"oneself"},null,{"g":"to love"}]},{"text":"Ihr müsst euch nur gegenseitig vertrauen.","en":"You just have to trust each other.","words":[{"g":"you (pl.) / her"},{"g":"to have to","l":"müssen"},{"g":"you (pl.)","l":"ihr"},{"g":"only"},null,{"g":"to trust"}]},{"text":"Sie haben sich wirklich gegenseitig geliebt.","en":"They really loved each other.","words":[{"g":"she / they / you"},{"g":"have"},{"g":"oneself"},{"g":"really, actually"},null,{"g":"loved"}]}]}