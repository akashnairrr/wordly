{"id":"vorerst","lemma":"vorerst","pos":"adv","rank":4166,"glosses":["for now, for the time being"],"ipa":"/ˌfoːɐ̯ˈʔeːɐ̯st/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1b/De-vorerst.ogg/De-vorerst.ogg.mp3","examples":[{"text":"Vorerst ist dies genug.","en":"For now, this is enough.","words":[null,{"g":"is","l":"sein"},null,{"g":"enough"}]},{"text":"Das reicht vorerst.","en":"This will do for now.","audio":"https://tatoeba.org/en/audio/download/70786","words":[{"g":"the / that"},{"g":"to reach","l":"reichen"},null]},{"text":"Tue vorerst noch nichts!","en":"Don't do anything yet.","audio":"https://tatoeba.org/en/audio/download/756313","words":[{"g":"to do","l":"tun"},null,{"g":"still / yet"},{"g":"nothing"}]},{"text":"Ich hatte vorerst genug zu essen.","en":"I've had enough to eat for now.","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"enough"},{"g":"to / too"},{"g":"to eat"}]},{"text":"Wir können vorerst nicht mehr sagen.","en":"We can't say any more at this time.","words":[{"g":"we"},{"g":"can, to be able to"},null,{"g":"not"},{"g":"more"},{"g":"to say (to pronounce"}]}]}