{"id":"beinhalten","lemma":"beinhalten","pos":"verb","rank":4932,"glosses":["to comprise, to contain, to include, to involve","to comprise, to entail","to imply, to implicate"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ea/De-beinhalten.ogg/De-beinhalten.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"beinhalte","1p":"beinhalten","2s":"beinhaltest","2p":"beinhaltet","3s":"beinhaltet","3p":"beinhalten"},"preterite":{"1s":"beinhaltete","1p":"beinhalteten","2s":"beinhaltetest","2p":"beinhaltetet","3s":"beinhaltete","3p":"beinhalteten"},"perfect":{"1s":"habe beinhaltet","1p":"haben beinhaltet","2s":"hast beinhaltet","2p":"habt beinhaltet","3s":"hat beinhaltet","3p":"haben beinhaltet"},"future":{"1s":"werde beinhalten","1p":"werden beinhalten","2s":"wirst beinhalten","2p":"werdet beinhalten","3s":"wird beinhalten","3p":"werden beinhalten"}},"imperative":{"affirmative":{"2s":"beinhalt","2p":"beinhaltet"}},"subjunctive":{"conditional":{"1s":"würde beinhalten","1p":"würden beinhalten","2s":"würdest beinhalten","2p":"würdet beinhalten","3s":"würde beinhalten","3p":"würden beinhalten"}}},"nonFinite":{"participle":"beinhaltet"},"examples":[{"text":"Diese Kiste beinhaltet Äpfel.","en":"This box contains apples.","words":[{"g":"this one, this","l":"dieser"},{"g":"chest, box"},null,{"g":"apple","l":"Apfel"}]},{"text":"Orangen beinhalten viel Vitamin C.","en":"Oranges have a lot of vitamin C.","words":[{"g":"orange","l":"Orange"},null,{"g":"much, a lot"},{"g":"vitamin"},{"g":"C"}]},{"text":"Dieser Betrag beinhaltet die Steuer.","en":"This amount includes tax.","words":[{"g":"this one, this"},{"g":"behavior","l":"Betragen"},null,{"g":"the"},{"g":"helm, rudder"}]},{"text":"Ihre Bibliothek umfasst 3500 Bücher und beinhaltet viele Erstausgaben.","en":"Her library has 3,500 books and includes many first editions.","words":[{"g":"her","l":"ihr"},{"g":"library"},{"g":"encompassed"},{"g":"book (collection of…","l":"Buch"},{"g":"and"},null,{"g":"much, a lot","l":"viel"},null]},{"text":"Die Gebühr für den Klavierunterricht beinhaltet die Benutzung des Klaviers.","en":"The price of my piano lessons includes the use of the piano.","words":[{"g":"the"},{"g":"fee"},{"g":"for"},{"g":"the","l":"der"},{"g":"piano lesson"},null,{"g":"the"},{"g":"use"},{"g":"of the","l":"der"},null]}]}