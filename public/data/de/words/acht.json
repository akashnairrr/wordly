{"id":"acht","lemma":"acht","pos":"num","rank":600,"glosses":["eight (numerical value represented by the Arabic numeral 8; or describing a set with eight elements)"],"ipa":"/axt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/De-acht.ogg/De-acht.ogg.mp3","examples":[{"text":"Er ist acht.","en":"He is eight.","audio":"https://tatoeba.org/en/audio/download/392422","words":[{"g":"he / it"},{"g":"is","l":"sein"},null]},{"text":"Es ist acht Uhr morgens.","en":"It's eight o'clock in the morning.","audio":"https://tatoeba.org/en/audio/download/566430","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"hours, o'clock"},{"g":"in the morning, a.m."}]},{"text":"Sie ist acht Jahre alt.","en":"She's eight years old.","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},null,{"g":"year","l":"Jahr"},{"g":"old"}]},{"text":"Acht ist vier mal zwei.","en":"Eight is four times two.","words":[null,{"g":"is","l":"sein"},{"g":"four (numerical value…"},{"g":"just / once"},{"g":"two (numerical value…"}]},{"text":"Es passierte zwischen acht und zehn.","en":"It happened between eight and ten.","words":[{"g":"it"},{"g":"to happen","l":"passieren"},{"g":"between"},null,{"g":"and"},{"g":"ten"}]}]}