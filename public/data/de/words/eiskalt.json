{"id":"eiskalt","lemma":"eiskalt","pos":"adj","rank":3955,"glosses":["ice-cold (having a very low temperature)","ice-cold, stone-cold (showing no emotion, ruthless)"],"ipa":"/ˈaɪ̯sˈkalt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/ca/De-eiskalt.ogg/De-eiskalt.ogg.mp3","examples":[{"text":"Dieses Wasser ist eiskalt.","en":"This water is ice cold.","words":[{"g":"this one, this","l":"dieser"},{"g":"water"},{"g":"is","l":"sein"},null]},{"text":"Deine Hände sind ja eiskalt.","en":"Your hands are like ice.","words":[{"g":"your","l":"dein"},{"g":"hand","l":"Hand"},{"g":"are","l":"sein"},{"g":"yes"},null]},{"text":"Es war eiskalt!","en":"It was freezing!","words":[{"g":"it"},{"g":"was","l":"sein"},null]},{"text":"Hier ist es eiskalt.","en":"It's freezing here.","words":[{"g":"here"},{"g":"is","l":"sein"},{"g":"it"},null]},{"text":"Es ist eiskalt hier.","en":"It's freezing in here.","words":[{"g":"it"},{"g":"is","l":"sein"},null,{"g":"here"}]}]}