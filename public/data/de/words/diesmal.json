{"id":"diesmal","lemma":"diesmal","pos":"adv","rank":795,"glosses":["this time"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/69/De-diesmal.ogg/De-diesmal.ogg.mp3","examples":[{"text":"Was ist es diesmal?","en":"What is it this time?","words":[{"g":"what"},{"g":"is","l":"sein"},{"g":"it"},null]},{"text":"Was hast du diesmal getan?","en":"What did you do this time?","words":[{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},null,{"g":"to do","l":"tun"}]},{"text":"Diesmal haben wir gewonnen.","en":"This time we won.","audio":"https://tatoeba.org/en/audio/download/392789","words":[null,{"g":"have"},{"g":"we"},{"g":"gained, won"}]},{"text":"Ich meine es diesmal ernst.","en":"I mean it this time.","audio":"https://tatoeba.org/en/audio/download/745472","words":[{"g":"I"},{"g":"my","l":"mein"},{"g":"it"},null,{"g":"serious, severe, grave"}]},{"text":"Diesmal habe ich einen Plan.","en":"I have a plan this time.","words":[null,{"g":"have","l":"haben"},{"g":"I"},{"g":"a","l":"ein"},{"g":"project"}]}]}