{"id":"schluck","lemma":"Schluck","pos":"noun","rank":2151,"glosses":["sip, swallow, small drink"],"ipa":"/ʃlʊk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bd/De-Schluck.ogg/De-Schluck.ogg.mp3","gender":"m","forms":{"genitive":"Schluckes","plural":"Schlucke"},"examples":[{"text":"Kannst du mir einen Schluck holen?","en":"Can you get me a drink?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"(to) me","l":"ich"},{"g":"a","l":"ein"},null,{"g":"to get, to fetch"}]},{"text":"Möchten Sie einen Schluck Wasser?","en":"Would you like a drink of water?","words":[{"g":"to like","l":"mögen"},{"g":"she / they / you"},{"g":"a","l":"ein"},null,{"g":"water"}]},{"text":"Schluck die Pille.","en":"Swallow the pill.","audio":"https://tatoeba.org/en/audio/download/695406","words":[null,{"g":"the"},{"g":"pill, tablet"}]},{"text":"Nimm einen Schluck hiervon.","en":"Take a sip of this.","words":[{"g":"to take","l":"nehmen"},{"g":"a","l":"ein"},null,{"g":"hence, from this"}]},{"text":"Können Sie mir einen Schluck holen?","en":"Can you get me a drink?","words":[{"g":"can, to be able to"},{"g":"she / they / you"},{"g":"(to) me","l":"ich"},{"g":"a","l":"ein"},null,{"g":"to get, to fetch"}]}]}