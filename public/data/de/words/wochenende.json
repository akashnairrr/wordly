{"id":"wochenende","lemma":"Wochenende","pos":"noun","rank":979,"glosses":["weekend (break in the working week, usually Saturday and Sunday)"],"ipa":"/ˈvɔxənˌɛndə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9c/De-Wochenende.ogg/De-Wochenende.ogg.mp3","gender":"n","forms":{"genitive":"Wochenendes","plural":"Wochenenden"},"examples":[{"text":"Wie war dein Wochenende?","en":"How was your weekend?","audio":"https://tatoeba.org/en/audio/download/566446","words":[{"g":"how"},{"g":"was","l":"sein"},{"g":"your"},null]},{"text":"Bist du frei dieses Wochenende?","en":"Are you free this weekend?","audio":"https://tatoeba.org/en/audio/download/761251","words":[{"g":"are","l":"sein"},{"g":"you"},{"g":"free"},{"g":"this one, this","l":"dieser"},null]},{"text":"Was wollt ihr dieses Wochenende essen?","en":"What do you want to eat this weekend?","words":[{"g":"what"},{"g":"to want","l":"wollen"},{"g":"you (pl.) / her"},{"g":"this one, this","l":"dieser"},null,{"g":"to eat"}]},{"text":"Am Wochenende arbeite ich nie.","en":"I never work on weekends.","words":[{"g":"at the / on the"},null,{"g":"to work","l":"arbeiten"},{"g":"I"},{"g":"never, never at all"}]},{"text":"Ich liebe dreitägige Wochenenden.","en":"I love three-day weekends.","words":[{"g":"I"},{"g":"lovable","l":"lieb"},null,null]}]}