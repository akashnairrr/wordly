{"id":"linker","lemma":"Linker","pos":"noun","rank":2334,"glosses":["left-winger, leftist (male or of unspecified gender)"],"ipa":"/ˈlɪŋkɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/De-Linker.ogg/De-Linker.ogg.mp3","gender":"m","forms":{"genitive":"Linken","plural":"Linke","feminine":"Linke"},"examples":[{"text":"Mein linker Arm ist eingeschlafen.","en":"My left arm is asleep.","audio":"https://tatoeba.org/en/audio/download/592925","words":[{"g":"my"},null,{"g":"an arm"},{"g":"is","l":"sein"},{"g":"to fall asleep","l":"einschlafen"}]},{"text":"Mein linker Fuß ist eingeschlafen.","en":"My left foot is asleep.","audio":"https://tatoeba.org/en/audio/download/758308","words":[{"g":"my"},null,{"g":"foot"},{"g":"is","l":"sein"},{"g":"to fall asleep","l":"einschlafen"}]},{"text":"Mein vorderer linker Reifen verliert Luft.","en":"My front left tire is losing air.","words":[{"g":"my"},{"g":"front, fore"},null,{"g":"tyre"},{"g":"to lose","l":"verlieren"},{"g":"air, atmosphere"}]},{"text":"Sie schreibt mit der linken Hand.","en":"She writes with her left hand.","words":[{"g":"she / they / you"},{"g":"to write, to write out","l":"schreiben"},{"g":"with"},{"g":"the"},null,{"g":"hand"}]},{"text":"Lege dich auf die linke Seite.","en":"Lie on your left side.","words":[{"g":"to lie down","l":"legen"},{"g":"you","l":"du"},{"g":"on"},{"g":"the"},null,{"g":"side"}]}]}