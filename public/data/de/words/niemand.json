{"id":"niemand","lemma":"niemand","pos":"pron","rank":202,"glosses":["nobody, no one"],"ipa":"/ˈniːmant/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c1/De-niemand.ogg/De-niemand.ogg.mp3","examples":[{"text":"Niemand liebt mich.","en":"No one loves me.","audio":"https://tatoeba.org/en/audio/download/107669","words":[null,{"g":"to love","l":"lieben"},{"g":"me","l":"ich"}]},{"text":"Niemand weiß, warum.","en":"No one knows why.","audio":"https://tatoeba.org/en/audio/download/393395","words":[null,{"g":"to know","l":"wissen"},{"g":"why"}]},{"text":"Niemand mag Krieg.","en":"No one likes war.","audio":"https://tatoeba.org/en/audio/download/393966","words":[null,{"g":"to like","l":"mögen"},{"g":"war, warfare"}]},{"text":"Niemand glaubt mir.","en":"No one believes me.","audio":"https://tatoeba.org/en/audio/download/79210","words":[null,{"g":"to believe something","l":"glauben"},{"g":"(to) me","l":"ich"}]},{"text":"Das denkt niemand.","en":"No one thinks that.","audio":"https://tatoeba.org/en/audio/download/497138","words":[{"g":"the / that"},{"g":"to think","l":"denken"},null]}]}