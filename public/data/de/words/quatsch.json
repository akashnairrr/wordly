{"id":"quatsch","lemma":"Quatsch","pos":"noun","rank":1058,"glosses":["nonsense","joking, kidding, fun","chat"],"ipa":"/kvatʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/40/De-Quatsch.ogg/De-Quatsch.ogg.mp3","gender":"m","forms":{"genitive":"Quatsches"},"examples":[{"text":"Quatsch!","en":"Nonsense!","audio":"https://tatoeba.org/en/audio/download/497299","words":[null]},{"text":"Es ist alles Quatsch.","en":"It's all nonsense.","audio":"https://tatoeba.org/en/audio/download/391989","words":[{"g":"it"},{"g":"is","l":"sein"},{"g":"everything"},null]},{"text":"Warum siehst du dir diesen Quatsch an?","en":"Why are you watching this garbage?","words":[{"g":"why"},{"g":"to see","l":"sehen"},{"g":"you"},{"g":"(to) you","l":"du"},{"g":"this one, this","l":"dieser"},null,{"g":"at / on"}]},{"text":"Red keinen Quatsch.","en":"Don't talk rubbish.","words":[{"g":"to talk","l":"reden"},{"g":"no / not a","l":"kein"},null]},{"text":"Lass den Quatsch!","en":"Stop that nonsense.","words":[{"g":"to allow","l":"lassen"},{"g":"the","l":"der"},null]}]}