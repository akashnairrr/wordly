{"id":"ru_cken","lemma":"Rücken","pos":"noun","rank":754,"glosses":["back"],"ipa":"/ˈʁʏkn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/85/De-R%C3%BCcken.ogg/De-R%C3%BCcken.ogg.mp3","gender":"m","forms":{"genitive":"Rückens","plural":"Rücken"},"examples":[{"text":"Mein Rücken tut weh.","en":"My back hurts.","audio":"https://tatoeba.org/en/audio/download/47941","words":[{"g":"my"},null,{"g":"to do","l":"tun"},{"g":"sore, painful"}]},{"text":"Ich schlafe auf dem Rücken.","en":"I sleep on my back.","words":[{"g":"I"},{"g":"to sleep","l":"schlafen"},{"g":"on"},{"g":"(to) the","l":"der"},null]},{"text":"Tut dein Rücken immer noch weh?","en":"Does your back still hurt?","words":[{"g":"to do","l":"tun"},{"g":"your"},null,null,null,{"g":"sore, painful"}],"phrases":[[3,5,"still"]]},{"text":"Ich tue nichts hinter deinem Rücken.","en":"I'm not doing anything behind your back.","words":[{"g":"I"},{"g":"to do","l":"tun"},{"g":"nothing"},{"g":"behind, after"},{"g":"thy, your .","l":"dein"},null]},{"text":"Sie trug das Baby auf ihrem Rücken.","en":"She was carrying the baby on her back.","words":[{"g":"she / they / you"},{"g":"to carry, to bear","l":"tragen"},{"g":"the / that"},{"g":"baby"},{"g":"on"},{"g":"her","l":"ihr"},null]}]}