{"id":"besitz","lemma":"Besitz","pos":"noun","rank":1780,"glosses":["ownership","possession, property"],"ipa":"/bəˈzɪts/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/De-Besitz.ogg/De-Besitz.ogg.mp3","gender":"m","forms":{"genitive":"Besitzes","plural":"Besitze"},"examples":[{"text":"Er hat einen großen Besitz.","en":"He has a great deal of property.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"a","l":"ein"},{"g":"big","l":"groß"},null]},{"text":"Sie verloren ihren Besitz.","en":"They lost their property.","words":[{"g":"she / they / you"},{"g":"lost, missing"},{"g":"her","l":"ihr"},null]},{"text":"Er hat es auf Ihren Besitz abgesehen.","en":"He has designs on your property.","words":[{"g":"he / it"},{"g":"has","l":"haben"},{"g":"it"},{"g":"on"},{"g":"her","l":"ihr"},null,{"g":"except , apart , other"}]},{"text":"Mein Vater hat mir einigen Besitz hinterlassen.","en":"My father left me some property.","words":[{"g":"my"},{"g":"father"},{"g":"has","l":"haben"},{"g":"(to) me","l":"ich"},{"g":"to unite or unify"},null,{"g":"to leave"}]},{"text":"Ich besitze dieses Auto.","en":"I own this car.","audio":"https://tatoeba.org/en/audio/download/41468","words":[{"g":"I"},null,{"g":"this one, this","l":"dieser"},{"g":"car"}]}]}