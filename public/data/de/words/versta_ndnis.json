{"id":"versta_ndnis","lemma":"Verständnis","pos":"noun","rank":2575,"glosses":["understanding, comprehension","sympathy","appreciation"],"ipa":"/fɛɐ̯ˈʃtɛntnɪs/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/54/De-Verst%C3%A4ndnis.ogg/De-Verst%C3%A4ndnis.ogg.mp3","gender":"n","forms":{"genitive":"Verständnisses","plural":"Verständnisse"},"examples":[{"text":"Danke für dein Verständnis.","en":"Thank you for understanding.","audio":"https://tatoeba.org/en/audio/download/700526","words":[{"g":"thanks, thank you"},{"g":"for"},{"g":"your"},null]},{"text":"Meine Eltern hätten kein Verständnis dafür.","en":"My parents wouldn't understand.","words":[{"g":"my","l":"mein"},{"g":"parents"},{"g":"to have","l":"haben"},{"g":"no / not a"},null,{"g":"for that, for it"}]},{"text":"Ich hoffe, daß du dafür Verständnis hast.","en":"I hope you'll understand.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},null,{"g":"you"},{"g":"for that, for it"},null,{"g":"have","l":"haben"}]},{"text":"Danke für Ihr Verständnis.","en":"Thank you for your understanding.","words":[{"g":"thanks, thank you"},{"g":"for"},{"g":"you (pl.) / her"},null]},{"text":"Ich hätte nicht gedacht, daß du Verständnis hättest.","en":"I didn't think you'd understand.","words":[{"g":"I"},{"g":"to have","l":"haben"},{"g":"not"},{"g":"to think","l":"denken"},null,{"g":"you"},null,{"g":"to have","l":"haben"}]}]}