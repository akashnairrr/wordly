{"id":"jemals","lemma":"jemals","pos":"adv","rank":614,"glosses":["ever"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/86/De-jemals.ogg/De-jemals.ogg.mp3","examples":[{"text":"Bist du jemals glücklich?","en":"Are you ever happy?","words":[{"g":"are","l":"sein"},{"g":"you"},null,{"g":"happy"}]},{"text":"Hast du jemals von ihm gehört?","en":"Have you ever heard of him?","words":[{"g":"have","l":"haben"},{"g":"you"},null,{"g":"from / of"},{"g":"(to) him","l":"er"},{"g":"to hear through the ear)","l":"hören"}]},{"text":"Habt ihr das jemals getan?","en":"Did you ever do that?","words":[{"g":"to have","l":"haben"},{"g":"you (pl.) / her"},{"g":"the / that"},null,{"g":"to do","l":"tun"}]},{"text":"Niemand wird dich jemals finden.","en":"No one will ever find you.","words":[{"g":"nobody, no one"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},null,{"g":"to find"}]},{"text":"Niemand hat ihn jemals geliebt.","en":"Nobody has ever loved him.","words":[{"g":"nobody, no one"},{"g":"has","l":"haben"},{"g":"him"},null,{"g":"loved"}]}]}