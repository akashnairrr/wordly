{"id":"lieb","lemma":"lieb","pos":"adj","rank":128,"glosses":["lovable; dear; darling; sweet; good-hearted; kind","good; well-behaved","dear"],"ipa":"/liːp/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7a/De-lieb.ogg/De-lieb.ogg.mp3","forms":{"comparative":"lieber","superlative":"am liebsten"},"formAudio":{"lieber":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q188_%28deu%29-Natschoba-lieber.wav"},"examples":[{"text":"Sollen wir lieber gehen?","en":"Should we go?","audio":"https://tatoeba.org/en/audio/download/167847","words":[{"g":"should"},{"g":"we"},null,{"g":"to go, to walk"}]},{"text":"Das ist sehr lieb von dir.","en":"That's very kind of you.","audio":"https://tatoeba.org/en/audio/download/41350","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"very"},null,{"g":"from / of"},{"g":"(to) you","l":"du"}]},{"text":"Ich warte lieber draußen.","en":"I'm going to wait outside.","audio":"https://tatoeba.org/en/audio/download/761152","words":[{"g":"I"},{"g":"to wait","l":"warten"},null,{"g":"outside"}]},{"text":"Dein Vater hat dich lieb.","en":"Your father loves you.","audio":"https://tatoeba.org/en/audio/download/755760","words":[{"g":"your"},{"g":"father"},{"g":"has","l":"haben"},{"g":"you","l":"du"},null]},{"text":"Ich sollte ihn lieber sehen.","en":"I'd better see him.","audio":"https://tatoeba.org/en/audio/download/393027","words":[{"g":"I"},{"g":"should","l":"sollen"},{"g":"him"},null,{"g":"to see"}]}]}