{"id":"hinunter","lemma":"hinunter","pos":"adv","rank":3175,"glosses":["down, downwards (from the own location downwards)"],"ipa":"/hɪˈnʊntɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/19/De-hinunter.ogg/De-hinunter.ogg.mp3","examples":[{"text":"Er ging langsam die Straße hinunter.","en":"He was walking slowly down the street.","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},{"g":"slowly"},{"g":"the"},{"g":"street"},null]},{"text":"Wir gehen hinunter.","en":"We're going down.","words":[{"g":"we"},{"g":"to go, to walk"},null]},{"text":"Er fuhr hinunter zum Hotel.","en":"He drove down to the hotel.","words":[{"g":"he / it"},{"g":"to go at speed","l":"fahren"},null,{"g":"to the"},{"g":"hotel"}]},{"text":"Ich gehe die Treppe hinunter.","en":"I am going down the stairs.","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},{"g":"the"},{"g":"stairs"},null]},{"text":"Geh hinunter!","en":"Go downstairs.","words":[{"g":"to go, to walk","l":"gehen"},null]}]}