{"id":"versetzt","lemma":"versetzt","pos":"adj","rank":2227,"glosses":["offset","shifted, displaced"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f1/De-versetzt.ogg/De-versetzt.ogg.mp3","examples":[{"text":"Versetzt euch in meine Lage.","en":"Put yourself in my place.","words":[null,{"g":"you (pl.)","l":"ihr"},{"g":"in"},{"g":"my","l":"mein"},{"g":"location, position"}]},{"text":"Das hat uns in Erstaunen versetzt.","en":"It astonished us.","words":[{"g":"the / that"},{"g":"has","l":"haben"},{"g":"us","l":"wir"},{"g":"in"},{"g":"astonishment"},null]},{"text":"Glaube versetzt Berge.","en":"Faith moves mountains.","words":[{"g":"to believe something","l":"glauben"},null,{"g":"a mountain, hill","l":"Berg"}]},{"text":"Warum wurde Tom versetzt?","en":"Why was Tom transferred?","words":[{"g":"why"},{"g":"to become","l":"werden"},null,null]},{"text":"Versetzt euch mal in deren Lage!","en":"Put yourselves in their shoes.","words":[null,{"g":"you (pl.)","l":"ihr"},{"g":"just / once"},{"g":"in"},{"g":"the","l":"der"},{"g":"location, position"}]}]}