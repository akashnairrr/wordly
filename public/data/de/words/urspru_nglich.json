{"id":"urspru_nglich","lemma":"ursprünglich","pos":"adj","rank":4404,"glosses":["original, initial, first","original, authentic, genuine, unadulterated"],"ipa":"/ˈuːʁʃpʁʏŋlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ae/De-urspr%C3%BCnglich.ogg/De-urspr%C3%BCnglich.ogg.mp3","forms":{"comparative":"ursprünglicher","superlative":"am ursprünglichsten"},"examples":[{"text":"Ursprünglich waren sie Bauern.","en":"Originally they were farmers.","words":[null,{"g":"to be","l":"sein"},{"g":"she / they / you"},{"g":"farmer","l":"Bauer"}]},{"text":"Das ist komplizierter, als ich ursprünglich dachte.","en":"It's more complicated than I originally thought.","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"complicated, complex","l":"kompliziert"},{"g":"at the same moment"},{"g":"I"},null,{"g":"to think","l":"denken"}]},{"text":"Diese Gitarre gehörte ursprünglich Tom.","en":"This guitar originally belonged to Tom.","words":[{"g":"this one, this","l":"dieser"},{"g":"guitar"},{"g":"to belong to","l":"gehören"},null,null]},{"text":"Diese Straße hieß ursprünglich Parkstraße.","en":"This street was originally named Park Street.","words":[{"g":"this one, this","l":"dieser"},{"g":"street"},{"g":"to have a name","l":"heißen"},null,null]},{"text":"Der Mensch kommt ursprünglich aus Afrika.","en":"Humans originated in Africa.","words":[{"g":"the"},{"g":"human"},{"g":"to come","l":"kommen"},null,{"g":"out of / from"},null]}]}