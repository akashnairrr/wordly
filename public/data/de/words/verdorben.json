{"id":"verdorben","lemma":"verdorben","pos":"adj","rank":3827,"glosses":["tainted, spoiled, putrid (of food)","corrupt, tainted, depraved (morally)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b2/De-verdorben.ogg/De-verdorben.ogg.mp3","forms":{"comparative":"verdorbener","superlative":"am verdorbensten"},"examples":[{"text":"Du hast es verdorben.","en":"You ruined it.","audio":"https://tatoeba.org/en/audio/download/224177","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"it"},null]},{"text":"Dieses Essen riecht verdorben.","en":"This food smells rotten.","words":[{"g":"this one, this","l":"dieser"},{"g":"to eat"},{"g":"to smell","l":"riechen"},null]},{"text":"Das ganze Fleisch war verdorben.","en":"All the meat was bad.","words":[{"g":"the / that"},{"g":"entire","l":"ganz"},{"g":"flesh"},{"g":"was","l":"sein"},null]},{"text":"Unser ganzes Essen war verdorben.","en":"All our food was rotten.","words":[{"g":"our"},{"g":"entire","l":"ganz"},{"g":"to eat"},{"g":"was","l":"sein"},null]},{"text":"Kinder sollten nicht verdorben werden.","en":"Children shouldn't be spoiled.","words":[{"g":"kid","l":"Kind"},{"g":"should","l":"sollen"},{"g":"not"},null,{"g":"to become"}]}]}