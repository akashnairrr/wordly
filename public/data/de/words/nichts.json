{"id":"nichts","lemma":"nichts","pos":"pron","rank":56,"glosses":["nothing"],"ipa":"/nɪx(t)s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6d/De-nichts.ogg/De-nichts.ogg.mp3","examples":[{"text":"Ich sehe nichts.","en":"I see nothing.","audio":"https://tatoeba.org/en/audio/download/497205","words":[{"g":"I"},{"g":"to see","l":"sehen"},null]},{"text":"Hier ist nichts.","en":"There is nothing here.","audio":"https://tatoeba.org/en/audio/download/755363","words":[{"g":"here"},{"g":"is","l":"sein"},null]},{"text":"Wir können nichts für dich tun.","en":"We can do nothing for you.","audio":"https://tatoeba.org/en/audio/download/708178","words":[{"g":"we"},{"g":"can, to be able to"},null,{"g":"for"},{"g":"you","l":"du"},{"g":"to do"}]},{"text":"Ich habe nichts zu tun.","en":"I have nothing to do.","audio":"https://tatoeba.org/en/audio/download/758789","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"to / too"},{"g":"to do"}]},{"text":"„Was war das?“ — „Nichts.“","en":"\"What was that?\" \"Nothing.\"","words":[{"g":"what"},{"g":"was","l":"sein"},{"g":"the / that"},null]}]}