{"id":"stolz","lemma":"stolz","pos":"adj","rank":553,"glosses":["proud","haughty"],"ipa":"/ʃtɔlt͡s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/12/De-stolz2.ogg/De-stolz2.ogg.mp3","forms":{"comparative":"stolzer","superlative":"am stolzesten"},"examples":[{"text":"Meine Mama ist stolz auf mich.","en":"My mom is proud of me.","audio":"https://tatoeba.org/en/audio/download/757094","words":[{"g":"my","l":"mein"},{"g":"mum, mummy, mom, mommy"},{"g":"is","l":"sein"},null,{"g":"on"},{"g":"me","l":"ich"}]},{"text":"Mein Vater ist ein stolzer Mann.","en":"My father is a proud man.","words":[{"g":"my"},{"g":"father"},{"g":"is","l":"sein"},{"g":"a"},null,{"g":"man, male human being"}]},{"text":"Du solltest stolz sein.","en":"You should be proud.","words":[{"g":"you"},{"g":"should","l":"sollen"},null,{"g":"to be"}]},{"text":"Ich könnte nicht stolzer sein.","en":"I couldn't be prouder.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"not"},null,{"g":"to be"}]},{"text":"Ich bin stolz auf meine Schule.","en":"I'm proud of my school.","audio":"https://tatoeba.org/en/audio/download/758281","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"on"},{"g":"my","l":"mein"},{"g":"school"}]}]}