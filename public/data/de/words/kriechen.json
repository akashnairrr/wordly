{"id":"kriechen","lemma":"kriechen","pos":"verb","rank":4275,"glosses":["to creep; to crawl"],"ipa":"/ˈkʁiːçn̩/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f7/De-kriechen.ogg/De-kriechen.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"krieche","1p":"kriechen","2s":"kriechst","2p":"kriecht","3s":"kriecht","3p":"kriechen"},"preterite":{"1s":"kroch","1p":"krochen","2s":"krochst","2p":"krocht","3s":"kroch","3p":"krochen"},"perfect":{"1s":"bin gekrochen","1p":"sind gekrochen","2s":"bist gekrochen","2p":"seid gekrochen","3s":"ist gekrochen","3p":"sind gekrochen"},"future":{"1s":"werde kriechen","1p":"werden kriechen","2s":"wirst kriechen","2p":"werdet kriechen","3s":"wird kriechen","3p":"werden kriechen"}},"imperative":{"affirmative":{"2s":"kriech","2p":"kriecht"}},"subjunctive":{"conditional":{"1s":"würde kriechen","1p":"würden kriechen","2s":"würdest kriechen","2p":"würdet kriechen","3s":"würde kriechen","3p":"würden kriechen"}}},"nonFinite":{"participle":"gekrochen"},"examples":[{"text":"Er kroch aus dem Fenster.","en":"He crawled out of the window.","words":[{"g":"he / it"},null,{"g":"out of / from"},{"g":"(to) the","l":"der"},{"g":"window"}]},{"text":"Die Katze ist unter die Hecke gekrochen.","en":"The cat crept under the hedge.","words":[{"g":"the"},{"g":"house cat"},{"g":"is","l":"sein"},{"g":"under"},{"g":"the"},{"g":"hedge"},null]},{"text":"Sie krochen voran.","en":"They crept forward.","words":[{"g":"she / they / you"},null,{"g":"forth, ahead, forwards"}]},{"text":"Ich kroch auf allen vieren.","en":"I crouched on all fours.","words":[{"g":"I"},null,null,null,null],"phrases":[[2,5,"on all fours"]]},{"text":"Über den Pfad kroch eine Schlange.","en":"A snake slithered across the path.","words":[{"g":"[with accusative or…"},{"g":"the","l":"der"},{"g":"path"},null,{"g":"a"},{"g":"snake"}]}]}