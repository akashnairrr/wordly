{"id":"a_usserst","lemma":"äußerst","pos":"adv","rank":1861,"glosses":["utmostly, extremely","as the last and least favoured possibility"],"ipa":"/ˈɔʏ̯sɐst/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/db/De-%C3%A4u%C3%9Ferst.ogg/De-%C3%A4u%C3%9Ferst.ogg.mp3","examples":[{"text":"Es war äußerst kalt.","en":"It was extremely cold.","audio":"https://tatoeba.org/en/audio/download/755341","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"cold, chilly"}]},{"text":"Er war äußerst glücklich.","en":"He was very happy.","audio":"https://tatoeba.org/en/audio/download/393224","words":[{"g":"he / it"},{"g":"was","l":"sein"},null,{"g":"happy"}]},{"text":"Das Zimmer ist äußerst klein.","en":"The room is extremely small.","words":[{"g":"the / that"},{"g":"room"},{"g":"is","l":"sein"},null,{"g":"small, little, wee"}]},{"text":"Wir müssen alle äußerst vorsichtig sein.","en":"We all need to be extremely careful.","words":[{"g":"we"},{"g":"to have to"},{"g":"all, everyone"},null,{"g":"carefully"},{"g":"to be"}]},{"text":"Das war äußerst lustig.","en":"It was extremely funny.","words":[{"g":"the / that"},{"g":"was","l":"sein"},null,{"g":"funny, humorous"}]}]}