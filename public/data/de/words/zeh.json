{"id":"zeh","lemma":"Zeh","pos":"noun","rank":3877,"glosses":["toe"],"ipa":"/tseː/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b7/De-Zeh.ogg/De-Zeh.ogg.mp3","gender":"m","forms":{"genitive":"Zehes","plural":"Zehen"},"formAudio":{"Zehen":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q188_%28deu%29-Sebastian_Wallroth-Zehen.wav"},"examples":[{"text":"Ich fühle meine Zehen nicht.","en":"I can't feel my toes.","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"my","l":"mein"},null,{"g":"not"}]},{"text":"Ich habe Schmerzen in meinem kleinen Zeh.","en":"I have a pain in my little toe.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"to hurt, to ache"},{"g":"in"},{"g":"my","l":"mein"},{"g":"small, little, wee","l":"klein"},null]},{"text":"Pass auf deine Zehen auf.","en":"Watch your toes.","audio":"https://tatoeba.org/en/audio/download/65245","words":[{"g":"pass, mountain pass"},{"g":"on"},{"g":"your","l":"dein"},null,{"g":"on"}]},{"text":"Wie viele Zehen haben Hunde?","en":"How many toes do dogs have?","words":[{"g":"how"},{"g":"much, a lot","l":"viel"},null,{"g":"have"},{"g":"dog, hound","l":"Hund"}]},{"text":"Welchen Zeh fasse ich gerade an?","en":"Which toe am I touching?","words":[{"g":"which","l":"welcher"},null,{"g":"to gird","l":"fassen"},{"g":"I"},{"g":"now"},{"g":"at / on"}]}]}