{"id":"knast","lemma":"Knast","pos":"noun","rank":1143,"glosses":["jail, the nick, the slammer","hunger"],"ipa":"/knast/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e5/De-Knast.ogg/De-Knast.ogg.mp3","gender":"m","forms":{"genitive":"Knastes","plural":"Knäste"},"examples":[{"text":"Sie sollten in den Knast kommen.","en":"They should be put in jail.","words":[{"g":"she / they / you"},{"g":"should","l":"sollen"},{"g":"in"},{"g":"the","l":"der"},null,{"g":"to come"}]},{"text":"Warst du schon mal im Knast?","en":"Have you been in jail before?","words":[{"g":"to be","l":"sein"},{"g":"you"},null,null,{"g":"in the"},null],"phrases":[[2,4,"ever"]]},{"text":"Er ist im Knast.","en":"He's in the joint.","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"in the"},null]},{"text":"Mein Vater sitzt im Knast.","en":"My father is in prison.","words":[{"g":"my"},{"g":"father"},{"g":"to sit","l":"sitzen"},{"g":"in the"},null]},{"text":"Am Ende landete er im Knast.","en":"In the end, he landed in jail.","words":[{"g":"at the / on the"},{"g":"end, finish"},{"g":"to land","l":"landen"},{"g":"he / it"},{"g":"in the"},null]}]}