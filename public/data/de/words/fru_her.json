{"id":"fru_her","lemma":"früher","pos":"adv","rank":414,"glosses":["formerly, in the past (often years ago, in contrast to nowadays)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/De-fr%C3%BCher.ogg/De-fr%C3%BCher.ogg.mp3","examples":[{"text":"Früher war alles besser.","en":"Everything was better in the past.","audio":"https://tatoeba.org/en/audio/download/745185","words":[null,{"g":"was","l":"sein"},{"g":"everything"},{"g":"good","l":"gut"}]},{"text":"Früher oder später wird es passieren.","en":"It's going to happen sooner or later.","audio":"https://tatoeba.org/en/audio/download/695600","words":[null,{"g":"or"},{"g":"later"},{"g":"to become","l":"werden"},{"g":"it"},{"g":"to happen"}]},{"text":"Kannst du früher kommen?","en":"Can you come early?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},null,{"g":"to come"}]},{"text":"Ich hätte früher kommen sollen.","en":"I should have come earlier.","words":[{"g":"I"},{"g":"to have","l":"haben"},null,{"g":"to come"},{"g":"should"}]},{"text":"Wir alle sterben früher oder später.","en":"We all die sooner or later.","words":[{"g":"we"},{"g":"all, everyone"},{"g":"to die"},null,{"g":"or"},{"g":"later"}]}]}