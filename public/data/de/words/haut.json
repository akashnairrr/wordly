{"id":"haut","lemma":"Haut","pos":"noun","rank":786,"glosses":["skin, hide of a person, animal or (part of a) plant","a creature, especially a person","skin (membrane found on the surface of an object, like a sausage)"],"ipa":"/haʊt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fa/De-Haut.ogg/De-Haut.ogg.mp3","gender":"f","forms":{"genitive":"Haut","plural":"Häute"},"examples":[{"text":"Ihre Haut war warm.","en":"Her skin was warm.","words":[{"g":"her","l":"ihr"},null,{"g":"was","l":"sein"},{"g":"warm"}]},{"text":"Du hast schöne Haut.","en":"You have nice skin.","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"well, beautifully","l":"schön"},null]},{"text":"Ich habe trockene Haut.","en":"I have dry skin.","audio":"https://tatoeba.org/en/audio/download/39532","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"dry (not wet","l":"trocken"},null]},{"text":"Willst du deine Haut behalten?","en":"Do you value your hide?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"your","l":"dein"},null,{"g":"to keep, to retain"}]},{"text":"Wollt ihr eure Haut behalten?","en":"Do you value your hide?","words":[{"g":"to want","l":"wollen"},{"g":"you (pl.) / her"},{"g":"your","l":"euer"},null,{"g":"to keep, to retain"}]}]}