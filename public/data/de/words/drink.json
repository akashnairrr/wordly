{"id":"drink","lemma":"Drink","pos":"noun","rank":1001,"glosses":["an alcoholic drink, especially one containing liquor and some other liquid, like a cocktail or long drink"],"ipa":"/dʁɪŋk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/66/De-Drink.ogg/De-Drink.ogg.mp3","gender":"m","forms":{"genitive":"Drinks","plural":"Drinks"},"examples":[{"text":"Wer braucht einen Drink?","en":"Who needs a drink?","words":[{"g":"who"},{"g":"to need","l":"brauchen"},{"g":"a","l":"ein"},null]},{"text":"Kannst du mir einen Drink holen?","en":"Can you get me a drink?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"(to) me","l":"ich"},{"g":"a","l":"ein"},null,{"g":"to get, to fetch"}]},{"text":"Willst du einen Drink oder nicht?","en":"Do you want a drink or not?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"a","l":"ein"},null,{"g":"or"},{"g":"not"}]},{"text":"Ich will keinen Drink.","en":"I don't want a drink.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"no / not a","l":"kein"},null]},{"text":"Ich brauche wirklich einen Drink.","en":"I really need a drink.","words":[{"g":"I"},{"g":"to need","l":"brauchen"},{"g":"really, actually"},{"g":"a","l":"ein"},null]}]}