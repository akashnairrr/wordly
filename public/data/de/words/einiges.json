{"id":"einiges","lemma":"einiges","pos":"pron","rank":1195,"glosses":["some things"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e1/De-einiges.ogg/De-einiges.ogg.mp3","examples":[{"text":"Du hast einiges zu erklären.","en":"You have some explaining to do.","words":[{"g":"you"},{"g":"have","l":"haben"},null,{"g":"to / too"},{"g":"to explain"}]},{"text":"Ich muss noch einiges mehr kaufen.","en":"I have several more things that I need to buy.","words":[{"g":"I"},{"g":"to have to","l":"müssen"},{"g":"still / yet"},null,{"g":"more"},{"g":"to buy, to purchase"}]},{"text":"Ich habe hier einiges zu tun.","en":"I've got some stuff to do here.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"here"},null,{"g":"to / too"},{"g":"to do"}]},{"text":"Wir haben einiges zu besprechen.","en":"You and I have things we need to discuss.","words":[{"g":"we"},{"g":"have"},null,{"g":"to / too"},{"g":"to discuss"}]},{"text":"Ich weiß so einiges darüber.","en":"I know a thing or two about that.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"so"},null,{"g":"above"}]}]}