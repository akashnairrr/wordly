{"id":"hinaus","lemma":"hinaus","pos":"adv","rank":1109,"glosses":["out (away from the speaker)"],"ipa":"/hɪˈnaʊ̯s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c1/De-hinaus.ogg/De-hinaus.ogg.mp3","examples":[{"text":"Papa, darf ich hinaus gehen und spielen?","en":"Daddy, may I go out and play?","words":[{"g":"dad, daddy"},{"g":"to be allowed","l":"dürfen"},{"g":"I"},null,{"g":"to go, to walk"},{"g":"and"},{"g":"to play"}]},{"text":"Worauf will er hinaus?","en":"What is he after?","audio":"https://tatoeba.org/en/audio/download/565898","words":[{"g":"whereupon"},{"g":"to want","l":"wollen"},{"g":"he / it"},null]},{"text":"Willst du auf etwas hinaus?","en":"Are you implying something?","words":[{"g":"to want","l":"wollen"},{"g":"you"},{"g":"on"},{"g":"something"},null]},{"text":"Gehe bitte sofort hinaus!","en":"Please get out of here immediately.","words":[{"g":"to go, to walk","l":"gehen"},{"g":"please"},{"g":"immediately, at once"},null]},{"text":"Bring den Müll hinaus.","en":"Take out the garbage.","words":[{"g":"to bring","l":"bringen"},{"g":"the","l":"der"},{"g":"rubbish"},null]}]}