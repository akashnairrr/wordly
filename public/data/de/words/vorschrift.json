{"id":"vorschrift","lemma":"Vorschrift","pos":"noun","rank":3038,"glosses":["regulation, rule","prescription"],"ipa":"/ˈfoːʁˌʃʁɪft/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b5/De-Vorschrift.ogg/De-Vorschrift.ogg.mp3","gender":"f","forms":{"genitive":"Vorschrift","plural":"Vorschriften"},"examples":[{"text":"Ich hasse die Vorschriften.","en":"I hate the rules.","audio":"https://tatoeba.org/en/audio/download/128032","words":[{"g":"I"},{"g":"to hate","l":"hassen"},{"g":"the"},null]},{"text":"Du kannst mir keine Vorschriften machen.","en":"You can't give me orders.","audio":"https://tatoeba.org/en/audio/download/760124","words":[{"g":"you"},{"g":"can, to be able to","l":"können"},{"g":"(to) me","l":"ich"},{"g":"no / not a","l":"kein"},null,{"g":"to make"}]},{"text":"Kann man die Vorschrift umgehen?","en":"Can you get around that regulation?","words":[{"g":"can, to be able to","l":"können"},{"g":"one"},{"g":"the"},null,{"g":"to handle"}]},{"text":"Sie können hier keine Vorschriften machen.","en":"You can't give orders around here.","words":[{"g":"she / they / you"},{"g":"can, to be able to"},{"g":"here"},{"g":"no / not a","l":"kein"},null,{"g":"to make"}]},{"text":"Du hast hier keine Vorschriften zu machen.","en":"You don't give orders here.","audio":"https://tatoeba.org/en/audio/download/695614","words":[{"g":"you"},{"g":"have","l":"haben"},{"g":"here"},{"g":"no / not a","l":"kein"},null,{"g":"to / too"},{"g":"to make"}]}]}