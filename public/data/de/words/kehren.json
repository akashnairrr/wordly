{"id":"kehren","lemma":"kehren","pos":"verb","rank":2603,"glosses":["to turn (change the direction of movement)","to care about"],"ipa":"/ˈkeːrən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/De-kehren.ogg/De-kehren.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"kehre","1p":"kehren","2s":"kehrst","2p":"kehrt","3s":"kehrt","3p":"kehren"},"preterite":{"1s":"kehrte","1p":"kehrten","2s":"kehrtest","2p":"kehrtet","3s":"kehrte","3p":"kehrten"},"perfect":{"1s":"habe gekehrt","1p":"haben gekehrt","2s":"hast gekehrt","2p":"habt gekehrt","3s":"hat gekehrt","3p":"haben gekehrt"},"future":{"1s":"werde kehren","1p":"werden kehren","2s":"wirst kehren","2p":"werdet kehren","3s":"wird kehren","3p":"werden kehren"}},"imperative":{"affirmative":{"2s":"kehr","2p":"kehrt"}},"subjunctive":{"conditional":{"1s":"würde kehren","1p":"würden kehren","2s":"würdest kehren","2p":"würdet kehren","3s":"würde kehren","3p":"würden kehren"}}},"nonFinite":{"participle":"gekehrt"},"examples":[{"text":"Wir kehren zum Schiff zurück.","en":"We're going back to the ship.","words":[{"g":"we"},null,{"g":"to the"},{"g":"ship"},{"g":"stand back!"}]},{"text":"Viele Jahre später kehrte er zurück.","en":"He came back many years later.","audio":"https://tatoeba.org/en/audio/download/44845","words":[{"g":"much, a lot","l":"viel"},{"g":"year","l":"Jahr"},{"g":"later"},null,{"g":"he / it"},{"g":"stand back!"}]},{"text":"Hierher kehre ich nie zurück.","en":"I'll never come back here.","words":[{"g":"to here, here , hither"},null,{"g":"I"},{"g":"never, never at all"},{"g":"stand back!"}]},{"text":"Kehrt um, bitte!","en":"Turn back, please.","words":[null,{"g":"around / at"},{"g":"please"}]},{"text":"Kehren Sie um, bitte!","en":"Turn back, please.","words":[null,{"g":"she / they / you"},{"g":"around / at"},{"g":"please"}]}]}