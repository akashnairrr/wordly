{"id":"sonst","lemma":"sonst","pos":"adv","rank":194,"glosses":["otherwise (under different circumstances)","normally, usually (as opposed to a particular case)","else"],"ipa":"/zɔnst/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/02/De-sonst2.ogg/De-sonst2.ogg.mp3","examples":[{"text":"Wer war sonst noch da?","en":"Who else was there?","audio":"https://tatoeba.org/en/audio/download/746283","words":[{"g":"who"},{"g":"was","l":"sein"},null,{"g":"still / yet"},{"g":"there"}]},{"text":"Was wolltest du sonst noch?","en":"What else did you want?","audio":"https://tatoeba.org/en/audio/download/760280","words":[{"g":"what"},{"g":"to want","l":"wollen"},{"g":"you"},null,{"g":"still / yet"}]},{"text":"Welche Wahl haben wir sonst?","en":"What other choice do we have?","words":[{"g":"some"},{"g":"choice, selection"},{"g":"have"},{"g":"we"},null]},{"text":"Ich habe sonst nichts.","en":"I have nothing else.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"nothing"}]},{"text":"Niemand sonst weiß es.","en":"No one else knows it.","words":[{"g":"nobody, no one"},null,{"g":"to know","l":"wissen"},{"g":"it"}]}]}