{"id":"herein","lemma":"herein","pos":"adv","rank":917,"glosses":["in (in the direction of the speaker)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ac/De-herein.ogg/De-herein.ogg.mp3","examples":[{"text":"Bringe ihn herein.","en":"Bring him in.","audio":"https://tatoeba.org/en/audio/download/58093","words":[{"g":"to bring","l":"bringen"},{"g":"him"},null]},{"text":"Warum kommst du nicht herein?","en":"Why don't you come in?","audio":"https://tatoeba.org/en/audio/download/565863","words":[{"g":"why"},{"g":"to come","l":"kommen"},{"g":"you"},{"g":"not"},null]},{"text":"Sie können nicht herein.","en":"They can't get in.","audio":"https://tatoeba.org/en/audio/download/390689","words":[{"g":"she / they / you"},{"g":"can, to be able to"},{"g":"not"},null]},{"text":"Komm herein.","en":"Come in.","audio":"https://tatoeba.org/en/audio/download/28932","words":[{"g":"to come","l":"kommen"},null]},{"text":"Lass mich herein.","en":"Let me in.","audio":"https://tatoeba.org/en/audio/download/34437","words":[{"g":"to allow","l":"lassen"},{"g":"me","l":"ich"},null]}]}