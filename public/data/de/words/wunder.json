{"id":"wunder","lemma":"Wunder","pos":"noun","rank":765,"glosses":["miracle","wonder"],"ipa":"/ˈvʊndəʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/93/De-at-Wunder.ogg/De-at-Wunder.ogg.mp3","gender":"n","forms":{"genitive":"Wunders","plural":"Wunder"},"examples":[{"text":"Ich glaube an Wunder.","en":"I believe in miracles.","audio":"https://tatoeba.org/en/audio/download/565942","words":[{"g":"I"},{"g":"to believe something","l":"glauben"},{"g":"at / on"},null]},{"text":"Glaubst du nicht an Wunder?","en":"Don't you believe in miracles?","audio":"https://tatoeba.org/en/audio/download/567128","words":[{"g":"to believe something","l":"glauben"},{"g":"you"},{"g":"not"},{"g":"at / on"},null]},{"text":"Es war ein Wunder.","en":"It was a miracle.","words":[{"g":"it"},{"g":"was","l":"sein"},{"g":"a"},null]},{"text":"Das wäre ein Wunder.","en":"That would be a miracle.","words":[{"g":"the / that"},{"g":"to be","l":"sein"},{"g":"a"},null]},{"text":"Erwartet keine Wunder.","en":"Don't expect any miracles.","audio":"https://tatoeba.org/en/audio/download/761167","words":[{"g":"expected, anticipated"},{"g":"no / not a","l":"kein"},null]}]}