{"id":"zug","lemma":"Zug","pos":"noun","rank":698,"glosses":["train (multiple vehicles one behind the other, particularly travelling on rails)","platoon","pull (force that pulls in a specific direction)"],"ipa":"/t͡suːk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8a/De-Zug2.ogg/De-Zug2.ogg.mp3","gender":"m","forms":{"genitive":"Zuges","plural":"Züge"},"formAudio":{"Zuges":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q188_%28deu%29-Sebastian_Wallroth-Zuges.wav","Züge":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q188_%28deu%29-Sebastian_Wallroth-Z%C3%BCge.wav"},"examples":[{"text":"Das ist der letzte Zug.","en":"This is the last train.","audio":"https://tatoeba.org/en/audio/download/698856","words":[{"g":"the / that"},{"g":"is","l":"sein"},{"g":"the"},{"g":"last"},null]},{"text":"Ich mag Züge.","en":"I like trains.","audio":"https://tatoeba.org/en/audio/download/37770","words":[{"g":"I"},{"g":"to like","l":"mögen"},null]},{"text":"Er liebt Züge.","en":"He loves trains.","audio":"https://tatoeba.org/en/audio/download/48504","words":[{"g":"he / it"},{"g":"to love","l":"lieben"},null]},{"text":"Er muss den Zug verpasst haben.","en":"He must have missed the train.","audio":"https://tatoeba.org/en/audio/download/41752","words":[{"g":"he / it"},{"g":"to have to","l":"müssen"},{"g":"the","l":"der"},null,{"g":"to miss (be late for","l":"verpassen"},{"g":"have"}]},{"text":"Da kommt der Zug.","en":"Here comes the train.","audio":"https://tatoeba.org/en/audio/download/790541","words":[{"g":"there"},{"g":"to come","l":"kommen"},{"g":"the"},null]}]}