{"id":"heimlich","lemma":"heimlich","pos":"adj","rank":2348,"glosses":["secret, clandestine (done or kept in secret)"],"ipa":"/ˈhaɪ̯mlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9e/De-at-heimlich.ogg/De-at-heimlich.ogg.mp3","forms":{"comparative":"heimlicher","superlative":"am heimlichsten"},"examples":[{"text":"Er betrat den Garten heimlich.","en":"He entered the garden secretly.","words":[{"g":"he / it"},{"g":"to enter","l":"betreten"},{"g":"the","l":"der"},{"g":"garden, yard"},null]},{"text":"Ich weiß, wer dein heimlicher Verehrer ist.","en":"I know who your secret admirer is.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"who"},{"g":"your"},null,{"g":"lover"},{"g":"is","l":"sein"}]},{"text":"Er zeigte mir heimlich ihr Foto.","en":"He secretly showed me her photo.","words":[{"g":"he / it"},{"g":"to point","l":"zeigen"},{"g":"(to) me","l":"ich"},null,{"g":"you (pl.) / her"},{"g":"photograph"}]},{"text":"Ich weiß, in wen du heimlich verliebt bist!","en":"I know who you're secretly in love with.","words":[{"g":"I"},{"g":"to know","l":"wissen"},{"g":"in"},{"g":"who","l":"wer"},{"g":"you"},null,{"g":"in love, enamored"},{"g":"are","l":"sein"}]},{"text":"Sie trafen sich heimlich.","en":"They met in secret.","words":[{"g":"she / they / you"},{"g":"to meet","l":"treffen"},{"g":"oneself"},null]}]}