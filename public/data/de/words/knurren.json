{"id":"knurren","lemma":"knurren","pos":"verb","rank":2458,"glosses":["to growl, to grunt, to grumble"],"ipa":"/ˈknʊʁən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/91/De-knurren.ogg/De-knurren.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"knurre","1p":"knurren","2s":"knurrst","2p":"knurrt","3s":"knurrt","3p":"knurren"},"preterite":{"1s":"knurrte","1p":"knurrten","2s":"knurrtest","2p":"knurrtet","3s":"knurrte","3p":"knurrten"},"perfect":{"1s":"habe geknurrt","1p":"haben geknurrt","2s":"hast geknurrt","2p":"habt geknurrt","3s":"hat geknurrt","3p":"haben geknurrt"},"future":{"1s":"werde knurren","1p":"werden knurren","2s":"wirst knurren","2p":"werdet knurren","3s":"wird knurren","3p":"werden knurren"}},"imperative":{"affirmative":{"2s":"knurr","2p":"knurrt"}},"subjunctive":{"conditional":{"1s":"würde knurren","1p":"würden knurren","2s":"würdest knurren","2p":"würdet knurren","3s":"würde knurren","3p":"würden knurren"}}},"nonFinite":{"participle":"geknurrt"},"examples":[{"text":"Der Hund knurrte.","en":"The dog growled.","audio":"https://tatoeba.org/en/audio/download/230641","words":[{"g":"the"},{"g":"dog, hound"},null]},{"text":"Ich kann deinen Magen knurren hören.","en":"I can hear your stomach growling.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},{"g":"thy, your .","l":"dein"},{"g":"stomach, maw"},null,{"g":"to hear through the ear)"}]},{"text":"Mein Magen knurrt.","en":"My stomach is grumbling.","words":[{"g":"my"},{"g":"stomach, maw"},null]},{"text":"Der Hund knurrte mich an.","en":"The dog growled at me.","audio":"https://tatoeba.org/en/audio/download/756876","words":[{"g":"the"},{"g":"dog, hound"},null,{"g":"me","l":"ich"},{"g":"at / on"}]},{"text":"Mein Magen begann zu knurren.","en":"My stomach began to growl.","words":[{"g":"my"},{"g":"stomach, maw"},{"g":"to begin","l":"beginnen"},{"g":"to / too"},null]}]}