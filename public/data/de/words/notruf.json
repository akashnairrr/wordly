{"id":"notruf","lemma":"Notruf","pos":"noun","rank":3195,"glosses":["emergency call"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7d/De-Notruf.ogg/De-Notruf.ogg.mp3","gender":"m","forms":{"genitive":"Notrufes","plural":"Notrufe"},"examples":[{"text":"Ich habe nicht den Notruf gewählt.","en":"I didn't call 911.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"not"},{"g":"the","l":"der"},null,{"g":"chosen, elected"}]},{"text":"Tom rief den Notruf an.","en":"Tom called 911.","words":[null,{"g":"to call out","l":"rufen"},{"g":"the","l":"der"},null,{"g":"at / on"}]},{"text":"Im Brandfall wählen Sie den Notruf 119.","en":"In case of fire, call 119.","words":[{"g":"in the"},null,{"g":"to choose, to select"},{"g":"she / they / you"},{"g":"the","l":"der"},null]},{"text":"Tom bat Maria, den Notruf zu wählen.","en":"Tom asked Mary to call 911.","words":[null,{"g":"to ask","l":"bitten"},null,{"g":"the","l":"der"},null,{"g":"to / too"},{"g":"to choose, to select"}]}]}