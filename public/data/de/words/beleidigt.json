{"id":"beleidigt","lemma":"beleidigt","pos":"adv","rank":2343,"glosses":["sulkily"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7c/De-beleidigt.ogg/De-beleidigt.ogg.mp3","examples":[{"text":"Habe ich dich irgendwie beleidigt?","en":"Have I done something to offend you?","words":[{"g":"have","l":"haben"},{"g":"I"},{"g":"you","l":"du"},{"g":"somehow"},null]},{"text":"Sie hat ihn beleidigt.","en":"She insulted him.","audio":"https://tatoeba.org/en/audio/download/393609","words":[{"g":"she / they / you"},{"g":"has","l":"haben"},{"g":"him"},null]},{"text":"Niemand beleidigt euch.","en":"Nobody is insulting you.","words":[{"g":"nobody, no one"},null,{"g":"you (pl.)","l":"ihr"}]},{"text":"Ich wurde von dem Polizisten beleidigt.","en":"I was offended by the policeman.","audio":"https://tatoeba.org/en/audio/download/786644","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"from / of"},{"g":"(to) the","l":"der"},{"g":"police officer","l":"Polizist"},null]},{"text":"Hast du mich gerade beleidigt?","en":"Did you just insult me?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"me","l":"ich"},{"g":"now"},null]}]}