{"id":"schrecklich","lemma":"schrecklich","pos":"adv","rank":755,"glosses":["awfully, terribly"],"ipa":"/ˈʃʁɛklɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4e/De-schrecklich.ogg/De-schrecklich.ogg.mp3","examples":[{"text":"Der Schmerz war schrecklich.","en":"The pain was terrible.","audio":"https://tatoeba.org/en/audio/download/757603","words":[{"g":"the"},{"g":"physical pain, ache"},{"g":"was","l":"sein"},null]},{"text":"Es war schrecklich kalt gestern.","en":"It was terribly cold yesterday.","audio":"https://tatoeba.org/en/audio/download/566904","words":[{"g":"it"},{"g":"was","l":"sein"},null,{"g":"cold, chilly"},{"g":"yesterday"}]},{"text":"Ich fühle mich schrecklich.","en":"I feel awful.","audio":"https://tatoeba.org/en/audio/download/77235","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"me","l":"ich"},null]},{"text":"Das ist schrecklich.","en":"That's awful.","audio":"https://tatoeba.org/en/audio/download/393180","words":[{"g":"the / that"},{"g":"is","l":"sein"},null]},{"text":"Die erste Nacht war schrecklich.","en":"The first night was awful.","words":[{"g":"the"},{"g":"first"},{"g":"night"},{"g":"was","l":"sein"},null]}]}