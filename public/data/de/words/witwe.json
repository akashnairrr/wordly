{"id":"witwe","lemma":"Witwe","pos":"noun","rank":2645,"glosses":["widow"],"ipa":"/ˈvɪtvə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/69/De-Witwe.ogg/De-Witwe.ogg.mp3","gender":"f","forms":{"genitive":"Witwe","plural":"Witwen","masculine":"Witwer"},"formAudio":{"Witwen":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q188_%28deu%29-Sebastian_Wallroth-Witwen.wav"},"examples":[{"text":"Die Witwe war schwarz gekleidet.","en":"The widow was dressed in black.","words":[{"g":"the"},null,{"g":"was","l":"sein"},{"g":"black"},{"g":"to dress, to clothe","l":"kleiden"}]},{"text":"Tom ist Witwer.","en":"Tom is a widower.","words":[null,{"g":"is","l":"sein"},null]},{"text":"Maria ist jetzt Witwe.","en":"Mary is a widow now.","words":[null,{"g":"is","l":"sein"},{"g":"now"},null]},{"text":"Eine Frau, deren Ehemann tot ist, wird Witwe genannt.","en":"A woman whose husband is dead is called a widow.","words":[{"g":"a"},{"g":"woman"},{"g":"the","l":"der"},{"g":"married man, husband"},{"g":"dead, deceased"},{"g":"is","l":"sein"},{"g":"to become","l":"werden"},null,{"g":"called"}]},{"text":"Einen Mann, dessen Ehefrau gestorben ist, nennt man Witwer.","en":"A man whose wife is dead is called a widower.","words":[{"g":"a","l":"ein"},{"g":"man, male human being"},{"g":"whose, of which"},{"g":"married woman, wife"},{"g":"deceased"},{"g":"is","l":"sein"},{"g":"to name","l":"nennen"},{"g":"one"},null]}]}