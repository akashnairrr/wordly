{"id":"jederzeit","lemma":"jederzeit","pos":"adv","rank":1477,"glosses":["anytime"],"ipa":"/ˈjeːdɐˌt͡saɪ̯t/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/De-jederzeit.ogg/De-jederzeit.ogg.mp3","examples":[{"text":"Du kannst mich jederzeit anrufen.","en":"You can call me any time.","audio":"https://tatoeba.org/en/audio/download/759623","words":[{"g":"you"},{"g":"can, to be able to","l":"können"},{"g":"me","l":"ich"},null,{"g":"to call, to ring"}]},{"text":"Du bist hier jederzeit willkommen.","en":"You're welcome here any time.","audio":"https://tatoeba.org/en/audio/download/695230","words":[{"g":"you"},{"g":"are","l":"sein"},{"g":"here"},null,{"g":"welcome"}]},{"text":"Sie können uns jederzeit anrufen.","en":"You can call us at any time.","words":[{"g":"she / they / you"},{"g":"can, to be able to"},{"g":"us","l":"wir"},null,{"g":"to call, to ring"}]},{"text":"Du kannst mein Auto jederzeit benutzen.","en":"You may use my car at any time.","audio":"https://tatoeba.org/en/audio/download/561525","words":[{"g":"you"},{"g":"can, to be able to","l":"können"},{"g":"my"},{"g":"car"},null,{"g":"to make use"}]},{"text":"Ich kann jederzeit anfangen.","en":"I can start anytime.","words":[{"g":"I"},{"g":"can, to be able to","l":"können"},null,{"g":"to begin"}]}]}