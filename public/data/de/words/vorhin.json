{"id":"vorhin","lemma":"vorhin","pos":"adv","rank":1111,"glosses":["earlier (a short time ago, typically between minutes and a few hours ago)"],"ipa":"/ˈfoːɐ̯hɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5d/De-vorhin.ogg/De-vorhin.ogg.mp3","examples":[{"text":"Weißt du, wer vorhin angerufen hat?","en":"Do you know who phoned earlier?","words":[{"g":"to know","l":"wissen"},{"g":"you"},{"g":"who"},null,{"g":"to call, to ring","l":"anrufen"},{"g":"has","l":"haben"}]},{"text":"Was hast du vorhin gemacht?","en":"What were you doing earlier?","words":[{"g":"what"},{"g":"have","l":"haben"},{"g":"you"},null,{"g":"to make","l":"machen"}]},{"text":"Ich habe vorhin an dich gedacht.","en":"I was thinking about you earlier today.","words":[{"g":"I"},{"g":"have","l":"haben"},null,{"g":"at / on"},{"g":"you","l":"du"},{"g":"to think","l":"denken"}]},{"text":"Ich habe euch vorhin gewinnen sehen.","en":"I saw you winning earlier.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"you (pl.)","l":"ihr"},null,{"g":"to win"},{"g":"to see"}]},{"text":"War Tom vorhin hier?","en":"Was Tom here earlier?","words":[{"g":"was","l":"sein"},null,null,{"g":"here"}]}]}