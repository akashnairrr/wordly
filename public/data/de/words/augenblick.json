{"id":"augenblick","lemma":"Augenblick","pos":"noun","rank":648,"glosses":["moment, instant, blink of an eye (very short period of time)"],"ipa":"/ˈaʊɡənblɪk/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/29/De-Augenblick.ogg/De-Augenblick.ogg.mp3","gender":"m","forms":{"genitive":"Augenblicks","plural":"Augenblicke"},"examples":[{"text":"Warte einen Augenblick.","en":"Wait a moment.","audio":"https://tatoeba.org/en/audio/download/39409","words":[{"g":"to wait","l":"warten"},{"g":"a","l":"ein"},null]},{"text":"Kannst du einen Augenblick warten?","en":"Will you wait a moment?","audio":"https://tatoeba.org/en/audio/download/760180","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"a","l":"ein"},null,{"g":"to wait"}]},{"text":"Sei mal einen Augenblick still.","en":"Be quiet for a moment.","words":[{"g":"to be","l":"sein"},{"g":"just / once"},{"g":"a","l":"ein"},null,{"g":"quiet, silent"}]},{"text":"Könnte Sie bitte einen Augenblick warten?","en":"Could you please wait a minute?","words":[{"g":"can, to be able to","l":"können"},{"g":"she / they / you"},{"g":"please"},{"g":"a","l":"ein"},null,{"g":"to wait"}]},{"text":"Könnt ihr bitte einen Augenblick herkommen?","en":"Can you come here a minute, please?","words":[{"g":"can, to be able to","l":"können"},{"g":"you (pl.) / her"},{"g":"please"},{"g":"a","l":"ein"},null,{"g":"to come over"}]}]}