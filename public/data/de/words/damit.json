{"id":"damit","lemma":"damit","pos":"conj","rank":101,"glosses":["so that, in order that"],"ipa":"/daˈmɪt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c0/De-damit.ogg/De-damit.ogg.mp3","examples":[{"text":"Kannst du bitte damit aufhören?","en":"Can you please stop that?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"please"},null,{"g":"to stop"}]},{"text":"Hattest du damit auch ein Problem?","en":"Did you also have a problem with that?","words":[{"g":"to have","l":"haben"},{"g":"you"},null,{"g":"also"},{"g":"a"},{"g":"problem"}]},{"text":"Bist du damit zufrieden?","en":"Does that satisfy you?","audio":"https://tatoeba.org/en/audio/download/700212","words":[{"g":"are","l":"sein"},{"g":"you"},null,{"g":"satisfied"}]},{"text":"Ich habe damit kein Problem.","en":"I have no problem with that.","words":[{"g":"I"},{"g":"have","l":"haben"},null,null,null],"phrases":[[3,5,"no problem"]]},{"text":"Warte damit bis Montag!","en":"Wait until Monday to do that.","audio":"https://tatoeba.org/en/audio/download/718189","words":[{"g":"to wait","l":"warten"},null,{"g":"until, to, through"},{"g":"Monday"}]}]}