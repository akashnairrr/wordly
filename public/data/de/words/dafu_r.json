{"id":"dafu_r","lemma":"dafür","pos":"adv","rank":161,"glosses":["for that, for it","instead, at least, as a compensation"],"ipa":"/daˈfyːʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/48/De-daf%C3%BCr.ogg/De-daf%C3%BCr.ogg.mp3","examples":[{"text":"Sind wir bereit dafür?","en":"Are we ready for it?","words":[{"g":"are","l":"sein"},{"g":"we"},{"g":"ready"},null]},{"text":"Ich bin zu alt dafür.","en":"I'm too old for that.","audio":"https://tatoeba.org/en/audio/download/711663","words":[{"g":"I"},{"g":"am","l":"sein"},{"g":"to / too"},{"g":"old"},null]},{"text":"Wir hatten keine Zeit dafür.","en":"We had no time to do that.","audio":"https://tatoeba.org/en/audio/download/701173","words":[{"g":"we"},{"g":"to have","l":"haben"},{"g":"no / not a","l":"kein"},{"g":"time"},null]},{"text":"Was willst du dafür?","en":"What do you want for that?","words":[{"g":"what"},{"g":"to want","l":"wollen"},{"g":"you"},null]},{"text":"Hast du genug Zeit dafür?","en":"Do you have enough time to do that?","words":[{"g":"have","l":"haben"},{"g":"you"},{"g":"enough"},{"g":"time"},null]}]}