{"id":"nahe","lemma":"nahe","pos":"prep","rank":927,"glosses":["near"],"ipa":"/ˈnaːə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/De-nahe.ogg/De-nahe.ogg.mp3","examples":[{"text":"Sie wohnen nahe bei der Schule.","en":"They live near the school.","audio":"https://tatoeba.org/en/audio/download/700916","words":[{"g":"she / they / you"},{"g":"to live, reside, dwell"},null,{"g":"at / with"},{"g":"the"},{"g":"school"}]},{"text":"Komm dem Hund nicht zu nahe.","en":"Don't go near the dog.","audio":"https://tatoeba.org/en/audio/download/700087","words":[{"g":"to come","l":"kommen"},{"g":"(to) the","l":"der"},{"g":"dog, hound"},{"g":"not"},{"g":"to / too"},null]},{"text":"Mein Haus liegt nahe der Schule.","en":"My house is near the school.","words":[{"g":"my"},{"g":"house, building"},{"g":"to lie","l":"liegen"},null,{"g":"the"},{"g":"school"}]},{"text":"Das Ende ist nahe.","en":"The end is nigh.","words":[{"g":"the / that"},{"g":"end, finish"},{"g":"is","l":"sein"},null]},{"text":"Meine Wohnung ist nahe.","en":"My apartment is near.","words":[{"g":"my","l":"mein"},{"g":"domicile"},{"g":"is","l":"sein"},null]}]}