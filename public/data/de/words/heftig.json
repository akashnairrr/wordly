{"id":"heftig","lemma":"heftig","pos":"adj","rank":2586,"glosses":["fierce, heavy, vehement, severe, violent"],"ipa":"/ˈhɛftɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/13/De-at-heftig.ogg/De-at-heftig.ogg.mp3","forms":{"comparative":"heftiger","superlative":"am heftigsten"},"examples":[{"text":"Das war ziemlich heftig.","en":"That was pretty intense.","words":[{"g":"the / that"},{"g":"was","l":"sein"},{"g":"pretty"},null]},{"text":"Gestern war heftiger Regen.","en":"There was a heavy rain yesterday.","words":[{"g":"yesterday"},{"g":"was","l":"sein"},null,{"g":"rain"}]},{"text":"Ich fühlte mein Herz heftig schlagen.","en":"I felt my heart beating violently.","words":[{"g":"I"},{"g":"to feel","l":"fühlen"},{"g":"my"},{"g":"heart"},null,{"g":"to beat"}]},{"text":"Der Wettbewerb ist heftig geworden.","en":"The competition has become fierce.","words":[{"g":"the"},{"g":"competition"},{"g":"is","l":"sein"},null,{"g":"become, got"}]},{"text":"Es fiel heftiger Regen.","en":"A heavy rain fell.","words":[{"g":"it"},{"g":"to fall, to drop","l":"fallen"},null,{"g":"rain"}]}]}