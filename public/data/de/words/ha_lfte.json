{"id":"ha_lfte","lemma":"Hälfte","pos":"noun","rank":965,"glosses":["half; fifty percent of something","half, share; any of two correlating pieces, whatever the size","middle; the virtual line where two equal halves meet"],"ipa":"/ˈhɛlftə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/De-H%C3%A4lfte.ogg/De-H%C3%A4lfte.ogg.mp3","gender":"f","forms":{"genitive":"Hälfte","plural":"Hälften"},"examples":[{"text":"Gib mir die Hälfte davon.","en":"Give me half of it.","audio":"https://tatoeba.org/en/audio/download/391151","words":[{"g":"to give","l":"geben"},{"g":"(to) me","l":"ich"},{"g":"the"},null,{"g":"from it"}]},{"text":"Ich will meine Hälfte.","en":"I want my half.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"my","l":"mein"},null]},{"text":"Schneide es in zwei Hälften.","en":"Cut it in half.","audio":"https://tatoeba.org/en/audio/download/97817","words":[{"g":"to cut","l":"schneiden"},{"g":"it"},{"g":"in"},{"g":"two (numerical value…"},null]},{"text":"Du kannst die Hälfte davon haben.","en":"You can have half of this.","words":[{"g":"you"},{"g":"can, to be able to","l":"können"},{"g":"the"},null,{"g":"from it"},{"g":"have"}]},{"text":"Sie schnitt den Kuchen in zwei Hälften.","en":"She cut the cake in two.","words":[{"g":"she / they / you"},{"g":"to cut","l":"schneiden"},{"g":"the","l":"der"},{"g":"pie"},{"g":"in"},{"g":"two (numerical value…"},null]}]}