{"id":"urteil","lemma":"Urteil","pos":"noun","rank":1841,"glosses":["judgment (the preferred spelling in a legal context), verdict, sentence (court decision)","judgement, opinion, usually one given after detailed consideration"],"ipa":"/ˈʊʁtaɪ̯l/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cc/De-Urteil.ogg/De-Urteil.ogg.mp3","gender":"n","forms":{"genitive":"Urteiles","plural":"Urteile"},"examples":[{"text":"Trauen Sie meinem Urteil?","en":"Do you trust my judgment?","words":[{"g":"to trust"},{"g":"she / they / you"},{"g":"my","l":"mein"},null]},{"text":"Bitte urteile nicht über mich!","en":"Please don't judge me.","audio":"https://tatoeba.org/en/audio/download/757505","words":[{"g":"please"},null,{"g":"not"},{"g":"[with accusative or…"},{"g":"me","l":"ich"}]},{"text":"Das Urteil liegt vor.","en":"The verdict is in.","audio":"https://tatoeba.org/en/audio/download/390538","words":[{"g":"the / that"},null,{"g":"to lie","l":"liegen"},{"g":"in front of, ahead of"}]},{"text":"Urteile selbst!","en":"Judge for yourself.","audio":"https://tatoeba.org/en/audio/download/392075","words":[null,{"g":"even"}]},{"text":"Traust du meinem Urteil?","en":"Do you trust my judgment?","words":[{"g":"to trust","l":"trauen"},{"g":"you"},{"g":"my","l":"mein"},null]}]}