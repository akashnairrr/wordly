{"id":"lehre","lemma":"Lehre","pos":"noun","rank":3816,"glosses":["teaching, tenet","apprenticeship","doctrine"],"ipa":"/ˈleːʁə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/De-Lehre.ogg/De-Lehre.ogg.mp3","gender":"f","forms":{"genitive":"Lehre","plural":"Lehren"},"formAudio":{"Lehren":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q188_%28deu%29-Natschoba-lehren.wav"},"examples":[{"text":"Ich hoffe, das ist dir eine Lehre.","en":"I hope you learned a lesson.","words":[{"g":"I"},{"g":"to hope","l":"hoffen"},{"g":"the / that"},{"g":"is","l":"sein"},{"g":"(to) you","l":"du"},{"g":"a"},null]},{"text":"Ich lehre hier kein Französisch mehr.","en":"I don't teach French here anymore.","words":[{"g":"I"},null,{"g":"here"},{"g":"no / not a"},{"g":"French, fellatio"},{"g":"more"}]},{"text":"Ich ziehe die Übersetzung der Lehre vor.","en":"I prefer translation to teaching.","words":[{"g":"I"},{"g":"to pull","l":"ziehen"},{"g":"the"},{"g":"translation"},{"g":"the"},null,{"g":"in front of, ahead of"}]},{"text":"Sein Scheitern war mir eine Lehre.","en":"His failure taught me a good lesson.","words":[{"g":"to be"},{"g":"to fail"},{"g":"was","l":"sein"},{"g":"(to) me","l":"ich"},{"g":"a"},null]},{"text":"Was lehren Sie?","en":"What do you teach?","words":[{"g":"what"},null,{"g":"she / they / you"}]}]}