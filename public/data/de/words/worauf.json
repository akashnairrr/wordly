{"id":"worauf","lemma":"worauf","pos":"adv","rank":904,"glosses":["whereupon; upon which; on which; to which; at which; above which; upon."],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/90/De-worauf.ogg/De-worauf.ogg.mp3","examples":[{"text":"Worauf warten wir?","en":"What're we waiting for?","audio":"https://tatoeba.org/en/audio/download/103920","words":[null,{"g":"to wait"},{"g":"we"}]},{"text":"Worauf wartet ihr?","en":"What are you waiting for?","words":[null,{"g":"to wait","l":"warten"},{"g":"you (pl.) / her"}]},{"text":"Worauf verstehst du dich gut?","en":"What are you good at?","words":[null,{"g":"to hear and interpret","l":"verstehen"},{"g":"you"},{"g":"you","l":"du"},{"g":"good"}]},{"text":"Ich weiß, worauf ich achten muss.","en":"I know what to watch for.","audio":"https://tatoeba.org/en/audio/download/695659","words":[{"g":"I"},{"g":"to know","l":"wissen"},null,{"g":"I"},{"g":"to care about"},{"g":"to have to","l":"müssen"}]},{"text":"Ich habe nichts, worauf ich schreiben kann.","en":"I have nothing to write on.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"nothing"},null,{"g":"I"},{"g":"to write, to write out"},{"g":"can, to be able to","l":"können"}]}]}