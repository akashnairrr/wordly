{"id":"toter","lemma":"Toter","pos":"noun","rank":809,"glosses":["cadaver; corpse (male or of unspecified gender)"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/De-Toter.ogg/De-Toter.ogg.mp3","gender":"m","forms":{"genitive":"Toten","plural":"Tote","feminine":"Tote"},"examples":[{"text":"Tote erzählen keine Geschichten.","en":"Dead men tell no tales.","words":[null,{"g":"to tell"},{"g":"no / not a","l":"kein"},{"g":"history","l":"Geschichte"}]},{"text":"Ich will nicht schlecht über die Toten sprechen.","en":"I don't want to speak ill of the dead.","words":[{"g":"I"},{"g":"to want","l":"wollen"},{"g":"not"},{"g":"bad"},{"g":"[with accusative or…"},{"g":"the"},null,{"g":"to speak"}]},{"text":"Tote reden nicht.","en":"Dead men tell no tales.","words":[null,{"g":"to talk"},{"g":"not"}]},{"text":"Über die Toten sag nichts Schlechtes!","en":"Don't speak ill of the dead.","words":[{"g":"[with accusative or…"},{"g":"the"},null,{"g":"to say (to pronounce","l":"sagen"},{"g":"nothing"},{"g":"bad","l":"schlecht"}]},{"text":"Tote Hunde beißen nicht.","en":"Dead dogs can't bite.","words":[null,{"g":"dog, hound","l":"Hund"},{"g":"to bite"},{"g":"not"}]}]}