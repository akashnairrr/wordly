{"id":"regen","lemma":"Regen","pos":"noun","rank":1398,"glosses":["rain"],"ipa":"/ˈʁeːɡən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c8/De-Regen.ogg/De-Regen.ogg.mp3","gender":"m","forms":{"genitive":"Regens","plural":"Regen"},"formAudio":{"Regens":"https://upload.wikimedia.org/wikipedia/commons/0/0a/LL-Q188_%28deu%29-WangleLine-Regens.wav"},"examples":[{"text":"Magst du Regen?","en":"Do you like rain?","audio":"https://tatoeba.org/en/audio/download/45977","words":[{"g":"to like","l":"mögen"},{"g":"you"},null]},{"text":"Gibt es morgen Regen?","en":"Will it rain tomorrow?","audio":"https://tatoeba.org/en/audio/download/754951","words":[{"g":"to give","l":"geben"},{"g":"it"},{"g":"tomorrow"},null]},{"text":"Ist das der Fehler des Regens?","en":"Is the rain to blame?","words":[{"g":"is","l":"sein"},{"g":"the / that"},{"g":"the"},{"g":"fault, error, mistake"},{"g":"of the","l":"der"},null]},{"text":"Wir mögen den Regen nicht.","en":"We don't like the rain.","audio":"https://tatoeba.org/en/audio/download/1979","words":[{"g":"we"},{"g":"to like"},{"g":"the","l":"der"},null,{"g":"not"}]},{"text":"Er ging trotz des Regens raus.","en":"He went out in spite of the rain.","words":[{"g":"he / it"},{"g":"to go, to walk","l":"gehen"},{"g":"in spite of, despite"},{"g":"of the","l":"der"},null,{"g":"out"}]}]}