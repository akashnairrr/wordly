{"id":"sitz","lemma":"Sitz","pos":"noun","rank":1509,"glosses":["seat","domicile"],"ipa":"/zɪt͡s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/26/De-Sitz.ogg/De-Sitz.ogg.mp3","gender":"m","forms":{"genitive":"Sitzes","plural":"Sitze"},"formAudio":{"Sitzes":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q188_%28deu%29-Sebastian_Wallroth-Sitzes.wav","Sitze":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q188_%28deu%29-Sebastian_Wallroth-Sitze.wav"},"examples":[{"text":"Der Sitz ist verstellbar.","en":"The seat is adjustable.","words":[{"g":"the"},null,{"g":"is","l":"sein"},null]},{"text":"Diesen Sitz kann man verstellen.","en":"You can adjust this seat.","words":[{"g":"this one, this","l":"dieser"},null,{"g":"can, to be able to","l":"können"},{"g":"one"},{"g":"to adjust"}]},{"text":"Ich möchte gerne einen Sitz reservieren.","en":"I'd like to reserve a seat.","words":[{"g":"I"},{"g":"to like","l":"mögen"},{"g":"don't mention it"},{"g":"a","l":"ein"},null,{"g":"to reserve"}]},{"text":"Ich habe immer eine Pistole unter dem Sitz.","en":"I keep a gun under the seat.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"at all times without…"},{"g":"a"},{"g":"pistol, gun"},{"g":"under"},{"g":"(to) the","l":"der"},null]},{"text":"Sitz still.","en":"Sit still.","audio":"https://tatoeba.org/en/audio/download/389856","words":[null,{"g":"quiet, silent"}]}]}