{"id":"sorgfa_ltig","lemma":"sorgfältig","pos":"adj","rank":4161,"glosses":["careful, meticulous, thorough, diligent"],"ipa":"/ˈzɔʁkˌfɛl.tɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/35/De-sorgf%C3%A4ltig.ogg/De-sorgf%C3%A4ltig.ogg.mp3","forms":{"comparative":"sorgfältiger","superlative":"am sorgfältigsten"},"examples":[{"text":"Er ist sehr sorgfältig.","en":"He is very careful.","audio":"https://tatoeba.org/en/audio/download/393666","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"very"},null]},{"text":"Schau dir die Sache sorgfältiger an.","en":"Look into the matter more carefully.","words":[{"g":"to watch, to view","l":"schauen"},{"g":"(to) you","l":"du"},{"g":"the"},{"g":"matter"},null,{"g":"at / on"}]},{"text":"Den Vertrag bitte sorgfältig lesen!","en":"Please read the contract carefully.","words":[{"g":"the","l":"der"},{"g":"contract, agreement"},{"g":"please"},null,{"g":"to read"}]},{"text":"Es muss sorgfältiger gemacht werden.","en":"It must be done more carefully.","words":[{"g":"it"},{"g":"to have to","l":"müssen"},null,{"g":"to make","l":"machen"},{"g":"to become"}]},{"text":"Ich habe den Bericht sorgfältig gelesen.","en":"I read the report carefully.","words":[{"g":"I"},{"g":"have","l":"haben"},{"g":"the","l":"der"},{"g":"report"},null,{"g":"to read","l":"lesen"}]}]}