{"id":"sirene","lemma":"Sirene","pos":"noun","rank":3956,"glosses":["siren (noisemaker)","siren (mythology)","sirenian"],"ipa":"/ˌziˈʁeːnə/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/84/De-Sirene.ogg/De-Sirene.ogg.mp3","gender":"f","forms":{"genitive":"Sirene","plural":"Sirenen"},"examples":[{"text":"Kannst du nicht die Sirene hören?","en":"Can't you hear the siren?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"not"},{"g":"the"},null,{"g":"to hear through the ear)"}]},{"text":"Die Sirenen gingen los.","en":"The sirens went off.","words":[{"g":"the"},null,{"g":"to go, to walk","l":"gehen"},{"g":"rid of, free of"}]},{"text":"Tom hörte Sirenen.","en":"Tom heard sirens.","words":[null,{"g":"to hear through the ear)","l":"hören"},null]},{"text":"Die Sirenen heulen.","en":"The sirens are wailing.","words":[{"g":"the"},null,{"g":"to howl, to whine"}]},{"text":"Die Sirenen fingen an zu heulen.","en":"The sirens went off.","words":[{"g":"the"},null,{"g":"to catch","l":"fangen"},{"g":"at / on"},{"g":"to / too"},{"g":"to howl, to whine"}]}]}