{"id":"rein","lemma":"rein","pos":"adv","rank":182,"glosses":["inside, in here","inside, in there"],"ipa":"/ʁaɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8b/De-rein.ogg/De-rein.ogg.mp3","examples":[{"text":"Ich gehe zuerst rein.","en":"I'll go in first.","audio":"https://tatoeba.org/en/audio/download/392107","words":[{"g":"I"},{"g":"to go, to walk","l":"gehen"},{"g":"first, firstly"},null]},{"text":"Warum gehen wir nicht rein?","en":"Why don't we go in?","audio":"https://tatoeba.org/en/audio/download/745717","words":[{"g":"why"},{"g":"to go, to walk"},{"g":"we"},{"g":"not"},null]},{"text":"Kommst du rein oder nicht?","en":"Are you coming in or not?","audio":"https://tatoeba.org/en/audio/download/700426","words":[{"g":"to come","l":"kommen"},{"g":"you"},null,{"g":"or"},{"g":"not"}]},{"text":"Denkst du, es passt hier rein?","en":"Do you think it'll fit here?","words":[{"g":"to think","l":"denken"},{"g":"you"},{"g":"it"},{"g":"to fit","l":"passen"},{"g":"here"},null]},{"text":"Bitte lasst mich rein.","en":"Please let me in.","audio":"https://tatoeba.org/en/audio/download/391427","words":[{"g":"please"},{"g":"to allow","l":"lassen"},{"g":"me","l":"ich"},null]}]}