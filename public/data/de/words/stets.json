{"id":"stets","lemma":"stets","pos":"adv","rank":1944,"glosses":["always; constantly; the whole time (very often)","every time (whenever some precondition is given)","always (at all times without exception)"],"ipa":"/ʃteːts/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/09/De-stets.ogg/De-stets.ogg.mp3","examples":[{"text":"Du bist stets willkommen!","en":"You are always welcome.","audio":"https://tatoeba.org/en/audio/download/759819","words":[{"g":"you"},{"g":"are","l":"sein"},null,{"g":"welcome"}]},{"text":"Sie sind stets willkommen!","en":"You are always welcome.","audio":"https://tatoeba.org/en/audio/download/759820","words":[{"g":"she / they / you"},{"g":"are","l":"sein"},null,{"g":"welcome"}]},{"text":"Ich bin stets bereit.","en":"I'm always ready.","words":[{"g":"I"},{"g":"am","l":"sein"},null,{"g":"ready"}]},{"text":"Sag stets die Wahrheit.","en":"Always tell the truth.","words":[{"g":"to say (to pronounce","l":"sagen"},null,{"g":"the"},{"g":"truth"}]},{"text":"Wir waren stets zusammen.","en":"We were always together.","words":[{"g":"we"},{"g":"to be","l":"sein"},null,{"g":"together"}]}]}