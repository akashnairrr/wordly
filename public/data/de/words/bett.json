{"id":"bett","lemma":"Bett","pos":"noun","rank":373,"glosses":["bed (piece of furniture, usually flat and soft, for resting or sleeping on; one's place of sleep or rest)","bed (bottom of a body of water, such as an ocean, sea, lake, or river)"],"ipa":"/bɛt/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5e/De-Bett.ogg/De-Bett.ogg.mp3","gender":"n","forms":{"genitive":"Bettes","plural":"Betten"},"formAudio":{"Bettes":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q188_%28deu%29-Sebastian_Wallroth-Bettes.wav","Betten":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q188_%28deu%29-Sebastian_Wallroth-Betten.wav"},"examples":[{"text":"Ich mache nie mein Bett.","en":"I never make my bed.","audio":"https://tatoeba.org/en/audio/download/745405","words":[{"g":"I"},{"g":"to make","l":"machen"},{"g":"never, never at all"},{"g":"my"},null]},{"text":"Ich war schon im Bett.","en":"I was in bed already.","audio":"https://tatoeba.org/en/audio/download/566768","words":[{"g":"I"},{"g":"was","l":"sein"},{"g":"already"},{"g":"in the"},null]},{"text":"Auf welcher Seite des Bettes schläfst du?","en":"Which side of the bed do you sleep on?","words":[{"g":"on"},{"g":"which"},{"g":"side"},{"g":"of the","l":"der"},null,{"g":"to sleep","l":"schlafen"},{"g":"you"}]},{"text":"Mach dein Bett!","en":"Make your bed.","audio":"https://tatoeba.org/en/audio/download/83984","words":[{"g":"to make","l":"machen"},{"g":"your"},null]},{"text":"Raus aus meinem Bett!","en":"Get out of my bed.","audio":"https://tatoeba.org/en/audio/download/565885","words":[{"g":"out"},{"g":"out of / from"},{"g":"my","l":"mein"},null]}]}