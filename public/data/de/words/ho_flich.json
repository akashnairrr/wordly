{"id":"ho_flich","lemma":"höflich","pos":"adj","rank":2671,"glosses":["polite (well-mannered)"],"ipa":"/ˈhøːflɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/01/De-h%C3%B6flich.ogg/De-h%C3%B6flich.ogg.mp3","forms":{"comparative":"höflicher","superlative":"am höflichsten"},"examples":[{"text":"Bist du höflich?","en":"Are you polite?","audio":"https://tatoeba.org/en/audio/download/188910","words":[{"g":"are","l":"sein"},{"g":"you"},null]},{"text":"Er ist ein höflicher Junge.","en":"He is a kind boy.","audio":"https://tatoeba.org/en/audio/download/45687","words":[{"g":"he / it"},{"g":"is","l":"sein"},{"g":"a"},null,{"g":"boy"}]},{"text":"Sei höflich zu deinen Eltern.","en":"Be polite to your parents.","audio":"https://tatoeba.org/en/audio/download/760840","words":[{"g":"to be","l":"sein"},null,{"g":"to / too"},{"g":"thy, your .","l":"dein"},{"g":"parents"}]},{"text":"Bitte seien Sie höflich.","en":"Please be polite.","audio":"https://tatoeba.org/en/audio/download/394609","words":[{"g":"please"},{"g":"to be","l":"sein"},{"g":"she / they / you"},null]},{"text":"Du solltest versuchen, höflicher zu sein.","en":"You should try to be more polite.","words":[{"g":"you"},{"g":"should","l":"sollen"},{"g":"to try, to attempt"},null,{"g":"to / too"},{"g":"to be"}]}]}