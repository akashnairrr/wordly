{"id":"blicken","lemma":"blicken","pos":"verb","rank":2518,"glosses":["to look (usually in a certain direction toward something)","to get, to understand"],"audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6c/De-blicken.ogg/De-blicken.ogg.mp3","conjugation":{"indicative":{"present":{"1s":"blicke","1p":"blicken","2s":"blickst","2p":"blickt","3s":"blickt","3p":"blicken"},"preterite":{"1s":"blickte","1p":"blickten","2s":"blicktest","2p":"blicktet","3s":"blickte","3p":"blickten"},"perfect":{"1s":"habe geblickt","1p":"haben geblickt","2s":"hast geblickt","2p":"habt geblickt","3s":"hat geblickt","3p":"haben geblickt"},"future":{"1s":"werde blicken","1p":"werden blicken","2s":"wirst blicken","2p":"werdet blicken","3s":"wird blicken","3p":"werden blicken"}},"imperative":{"affirmative":{"2s":"blick","2p":"blickt"}},"subjunctive":{"conditional":{"1s":"würde blicken","1p":"würden blicken","2s":"würdest blicken","2p":"würdet blicken","3s":"würde blicken","3p":"würden blicken"}}},"nonFinite":{"participle":"geblickt"},"examples":[{"text":"Der Mann blickte mich an.","en":"The man looked at me.","words":[{"g":"the"},{"g":"man, male human being"},null,{"g":"me","l":"ich"},{"g":"at / on"}]},{"text":"Er blickt immer in die Zukunft.","en":"He is always looking to the future.","words":[{"g":"he / it"},null,{"g":"at all times without…"},{"g":"in"},{"g":"the"},{"g":"future"}]},{"text":"Wir blickten auf.","en":"We looked up.","audio":"https://tatoeba.org/en/audio/download/238908","words":[{"g":"we"},null,{"g":"on"}]},{"text":"Sie haben sich nie blicken lassen.","en":"They never showed up.","words":[{"g":"she / they / you"},{"g":"have"},{"g":"oneself"},{"g":"never, never at all"},null,{"g":"to allow"}]},{"text":"Sie blickten alle auf.","en":"They all looked up.","words":[{"g":"she / they / you"},null,{"g":"all, everyone"},{"g":"on"}]}]}