{"id":"pu_nktlich","lemma":"pünktlich","pos":"adj","rank":1955,"glosses":["punctual, on time"],"ipa":"/ˈpʏŋktlɪç/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/16/De-p%C3%BCnktlich.ogg/De-p%C3%BCnktlich.ogg.mp3","forms":{"comparative":"pünktlicher","superlative":"am pünktlichsten"},"examples":[{"text":"Sie ist nie pünktlich.","en":"She is never on time.","audio":"https://tatoeba.org/en/audio/download/717758","words":[{"g":"she / they / you"},{"g":"is","l":"sein"},{"g":"never, never at all"},null]},{"text":"Kann sie pünktlich kommen?","en":"Can she come in time?","words":[{"g":"can, to be able to","l":"können"},{"g":"she / they / you"},null,{"g":"to come"}]},{"text":"Ich werde pünktlich zurück sein.","en":"I'll be back in time.","audio":"https://tatoeba.org/en/audio/download/701238","words":[{"g":"I"},{"g":"to become","l":"werden"},null,{"g":"stand back!"},{"g":"to be"}]},{"text":"Sei pünktlich.","en":"Be on time.","audio":"https://tatoeba.org/en/audio/download/564503","words":[{"g":"to be","l":"sein"},null]},{"text":"Der Zug kam pünktlich an.","en":"The train came on time.","audio":"https://tatoeba.org/en/audio/download/566631","words":[{"g":"the"},{"g":"train"},{"g":"to come","l":"kommen"},null,{"g":"at / on"}]}]}