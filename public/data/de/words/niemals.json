{"id":"niemals","lemma":"niemals","pos":"adv","rank":353,"glosses":["never (at no time)"],"ipa":"/ˈniːmaːls/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/ce/De-niemals.ogg/De-niemals.ogg.mp3","examples":[{"text":"Ich tue das niemals.","en":"I never do that.","audio":"https://tatoeba.org/en/audio/download/389293","words":[{"g":"I"},{"g":"to do","l":"tun"},{"g":"the / that"},null]},{"text":"Sag niemals „nie“!","en":"Never say never.","audio":"https://tatoeba.org/en/audio/download/38487","words":[{"g":"to say (to pronounce","l":"sagen"},null,{"g":"never, never at all"}]},{"text":"Ich werde dich niemals vergessen.","en":"I'll never forget you.","audio":"https://tatoeba.org/en/audio/download/756589","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"you","l":"du"},null,{"g":"to forget"}]},{"text":"Ich gebe niemals auf.","en":"I never give up.","audio":"https://tatoeba.org/en/audio/download/44109","words":[{"g":"I"},{"g":"to give","l":"geben"},null,{"g":"on"}]},{"text":"Niemals hier spielen.","en":"Never play here.","words":[null,{"g":"here"},{"g":"to play"}]}]}