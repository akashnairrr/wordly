{"id":"darin","lemma":"darin","pos":"adv","rank":719,"glosses":["in it, in that, therein"],"ipa":"/daˈʁɪn/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/30/De-darin.ogg/De-darin.ogg.mp3","examples":[{"text":"Bist du gut darin?","en":"Are you good at it?","audio":"https://tatoeba.org/en/audio/download/566330","words":[{"g":"are","l":"sein"},{"g":"you"},{"g":"good"},null]},{"text":"Ich bin sehr gut darin.","en":"I'm very good at it.","audio":"https://tatoeba.org/en/audio/download/700492","words":[{"g":"I"},{"g":"am","l":"sein"},null,null,null],"phrases":[[2,4,"being of an academic…"]]},{"text":"Was war darin?","en":"What was inside?","words":[{"g":"what"},{"g":"was","l":"sein"},null]},{"text":"Ich sehe darin kein Problem.","en":"I don't see a problem with that.","words":[{"g":"I"},{"g":"to see","l":"sehen"},null,null,null],"phrases":[[3,5,"no problem"]]},{"text":"Du bist darin nicht so gut, oder?","en":"You aren't very good at it, are you?","audio":"https://tatoeba.org/en/audio/download/562207","words":[{"g":"you"},{"g":"are","l":"sein"},null,{"g":"not"},{"g":"so"},{"g":"good"},{"g":"or"}]}]}