{"id":"reifen","lemma":"Reifen","pos":"noun","rank":1878,"glosses":["tyre; tire","hoop"],"ipa":"/ˈraɪ̯fən/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/63/De-Reifen.ogg/De-Reifen.ogg.mp3","gender":"m","forms":{"genitive":"Reifens","plural":"Reifen"},"examples":[{"text":"Dieser Wagen braucht neue Reifen.","en":"This car needs new tires.","words":[{"g":"this one, this"},{"g":"a car"},{"g":"to need","l":"brauchen"},{"g":"new","l":"neu"},null]},{"text":"Haben Sie die Reifen schon überprüft?","en":"Have you already checked the tires?","words":[{"g":"have"},{"g":"she / they / you"},{"g":"the"},null,{"g":"already"},{"g":"to check, to verify","l":"überprüfen"}]},{"text":"Der Reifen verliert Luft.","en":"The tire leaks air.","audio":"https://tatoeba.org/en/audio/download/798084","words":[{"g":"the"},null,{"g":"to lose","l":"verlieren"},{"g":"air, atmosphere"}]},{"text":"Kannst du einen Reifen wechseln?","en":"Do you know how to change a tire?","words":[{"g":"can, to be able to","l":"können"},{"g":"you"},{"g":"a","l":"ein"},null,{"g":"to change, to exchange"}]},{"text":"Ich werde deine Reifen später wechseln.","en":"I'll change your tires later.","words":[{"g":"I"},{"g":"to become","l":"werden"},{"g":"your","l":"dein"},null,{"g":"later"},{"g":"to change, to exchange"}]}]}