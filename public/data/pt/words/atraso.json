{"id":"atraso","lemma":"atraso","pos":"noun","rank":1608,"glosses":["belatedness (state of being late)","delay, lag","backwardness, primitiveness (lack of progress or development)"],"ipa":"/ɐˈtɾa.zu/","gender":"m","forms":{"plural":"atrasos"},"examples":[{"text":"Desculpe-me pelo atraso.","en":"Forgive me for being late.","words":[{"g":"to forgive","l":"desculpar"},{"g":"me"},{"g":"by / for the","l":"pelar"},null]},{"text":"Esteja preparado para atrasos.","en":"Be prepared for delays.","words":[{"g":"to be","l":"estar"},{"g":"prepared, ready"},{"g":"for / to"},null]},{"text":"Não houve atraso.","en":"There was no delay.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null]},{"text":"Este livro está em atraso.","en":"This book is overdue.","words":[{"g":"this"},{"g":"book"},{"g":"is","l":"estar"},{"g":"in"},null]},{"text":"Nunca me atraso para a escola.","en":"I'm never late for school.","words":[{"g":"never (at no time"},{"g":"me"},null,{"g":"for / to"},{"g":"the / to"},{"g":"school"}]}]}