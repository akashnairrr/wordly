{"id":"traidor","lemma":"traidor","pos":"adj","rank":1864,"glosses":["traitorous (characteristic of a traitor)","which betrays (reveals unintentionally)"],"ipa":"/tɾajˈdoɾ/","forms":{"feminine":"traidora","masculinePlural":"traidores","femininePlural":"traidoras"},"examples":[{"text":"Tom é o traidor.","en":"Tom is the traitor.","audio":"https://tatoeba.org/en/audio/download/494867","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"the / it"},null]},{"text":"Eles são traidores.","en":"They're traitors.","words":[{"g":"they"},{"g":"to be","l":"ser"},null]},{"text":"Você sabe quem é o traidor?","en":"Do you know who the traitor is?","words":[{"g":"you (formal)"},{"g":"to be aware, to know","l":"saber"},{"g":"who"},{"g":"is","l":"ser"},{"g":"the / it"},null]},{"text":"Os soldados viraram traidores.","en":"The soldiers turned traitor.","audio":"https://tatoeba.org/en/audio/download/1271262","words":[{"g":"the"},{"g":"soldier","l":"soldado"},null,null]},{"text":"Ele virou traidor.","en":"He turned traitor.","audio":"https://tatoeba.org/en/audio/download/1271263","words":[{"g":"he"},{"g":"to turn","l":"virar"},null]}]}