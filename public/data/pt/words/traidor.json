{"id":"traidor","lemma":"traidor","pos":"adj","rank":1864,"glosses":["traitorous (characteristic of a traitor)","which betrays (reveals unintentionally)"],"ipa":"/tɾa.iˈdoʁ/","forms":{"feminine":"traidora","masculinePlural":"traidores","femininePlural":"traidoras"},"examples":[{"text":"Ele virou traidor.","en":"He turned traitor.","audio":"https://tatoeba.org/en/audio/download/1271263","words":[{"g":"he"},{"g":"to turn","l":"virar"},null]},{"text":"Você sabe quem é o traidor?","en":"Do you know who the traitor is?","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},{"g":"who"},{"g":"is","l":"ser"},{"g":"the / it"},null]},{"text":"Eles são traidores.","en":"They're traitors.","words":[{"g":"they"},{"g":"to be","l":"ser"},null]},{"text":"Há um traidor entre nós.","en":"There's a traitor among us.","words":[{"g":"there be","l":"haver"},{"g":"a"},null,{"g":"among"},{"g":"we"}]},{"text":"Os soldados viraram traidores.","en":"The soldiers turned traitor.","audio":"https://tatoeba.org/en/audio/download/1271262","words":[{"g":"the"},{"g":"soldier","l":"soldado"},null,null]}]}