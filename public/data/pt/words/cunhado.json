{"id":"cunhado","lemma":"cunhado","pos":"noun","rank":3504,"glosses":["brother-in-law"],"ipa":"/kũˈɲa.du/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cc/LL-Q5146_%28por%29-MedK1-cunhado.wav/LL-Q5146_%28por%29-MedK1-cunhado.wav.mp3","gender":"m","forms":{"plural":"cunhados","feminine":"cunhada","femininePlural":"cunhadas"},"formAudio":{"cunhada":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q5146_%28por%29-MedK1-cunhada.wav"},"examples":[{"text":"Tom é o cunhado de Mary.","en":"Tom is Mary's brother-in-law.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"the / it"},null,{"g":"of / from"},null]},{"text":"Meu cunhado quer que eu seja padrinho do filho dele.","en":"My brother-in-law would like me to be his son's godfather.","words":[{"g":"my, mine"},null,{"g":"to want","l":"querer"},{"g":"that / what"},{"g":"I"},{"g":"to be","l":"ser"},{"g":"godfather"},{"g":"of the"},{"g":"son"},{"g":"to destroy, erase","l":"delir"}]},{"text":"Minha cunhada teve quatro crianças em cinco anos.","en":"My sister-in-law had four children in five years.","words":[{"g":"my, mine","l":"meu"},null,{"g":"to own","l":"ter"},{"g":"four"},{"g":"child","l":"criança"},{"g":"in"},{"g":"five"},{"g":"year","l":"ano"}]},{"text":"Tom e John são cunhados.","en":"Tom and John are brothers-in-law.","words":[{"g":"tone"},{"g":"and"},null,{"g":"to be","l":"ser"},null]},{"text":"Mary é minha cunhada.","en":"Mary is my brother's wife.","words":[null,{"g":"is","l":"ser"},{"g":"my, mine","l":"meu"},null]}]}