{"id":"ambic_a_o","lemma":"ambição","pos":"noun","rank":3569,"glosses":["ambition"],"ipa":"/ɐ̃.biˈsɐ̃w̃/","gender":"f","forms":{"plural":"ambições"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q5146_%28por%29-MedK1-ambi%C3%A7%C3%A3o.wav","examples":[{"text":"Tenho muita ambição.","en":"I have a lot of ambition.","words":[{"g":"have","l":"ter"},{"g":"very, a lot","l":"muito"},null]},{"text":"Ele tinha ambição.","en":"He had ambition.","words":[{"g":"he"},{"g":"to own","l":"ter"},null]},{"text":"Quais são suas ambições?","en":"What are your ambitions?","words":[{"g":"which","l":"qual"},{"g":"to be","l":"ser"},{"g":"his","l":"seu"},null]},{"text":"Aquele político é cheio de ambição.","en":"That politician is full of ambition.","words":[{"g":"that over there, yon"},{"g":"political"},{"g":"is","l":"ser"},{"g":"full"},{"g":"of / from"},null]},{"text":"Nós estamos sem ambição.","en":"We're unambitious.","words":[{"g":"we"},{"g":"to be","l":"estar"},{"g":"-less"},null]}]}