{"id":"bone_","lemma":"boné","pos":"noun","rank":4134,"glosses":["cap (head covering)"],"ipa":"/bɔˈnɛ/","gender":"m","forms":{"plural":"bonés"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q5146_%28por%29-MedK1-bon%C3%A9.wav","examples":[{"text":"Perdi meu boné.","en":"I have lost my cap.","words":[{"g":"to lose","l":"perder"},{"g":"my, mine"},null]},{"text":"Quantos bonés você tem?","en":"How many caps do you have?","words":[{"g":"how many"},null,{"g":"you (formal)"},{"g":"has / there is","l":"ter"}]},{"text":"Ele botou um boné na cabeça.","en":"He put a cap on his head.","audio":"https://tatoeba.org/en/audio/download/1274060","words":[{"g":"he"},null,{"g":"a"},null,{"g":"in the"},{"g":"head"}]},{"text":"Paguei dez dólares por este boné.","en":"I paid ten dollars for this cap.","words":[{"g":"to give [someone] money…","l":"pagar"},{"g":"ten"},{"g":"dollar","l":"dólar"},{"g":"for / by"},{"g":"this"},null]},{"text":"Tire o teu boné.","en":"Take your hat off.","words":[{"g":"to take","l":"tirar"},{"g":"the / it"},{"g":"hey"},null]}]}