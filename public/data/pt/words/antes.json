{"id":"antes","lemma":"antes","pos":"adv","rank":105,"glosses":["before (at an earlier time)","in the past; previously","preferably, better, rather"],"ipa":"/ˈɐ̃.t͡ʃis/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7e/LL-Q5146_%28por%29-Sillim-antes.wav/LL-Q5146_%28por%29-Sillim-antes.wav.mp3","examples":[{"text":"Vocês já fizeram isso antes?","en":"Have you ever done that before?","audio":"https://tatoeba.org/en/audio/download/482246","words":[{"g":"you (pl.)"},{"g":"already"},null,{"g":"that"},null]},{"text":"Você sabia disso antes?","en":"Did you know that before?","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},null,null]},{"text":"Eu ouvi isso antes.","en":"I've heard this before.","audio":"https://tatoeba.org/en/audio/download/535119","words":[{"g":"I"},{"g":"to hear","l":"ouvir"},{"g":"that"},null]},{"text":"Isso não aconteceu antes?","en":"Hasn't this happened before?","audio":"https://tatoeba.org/en/audio/download/889765","words":[{"g":"that"},{"g":"not / no"},{"g":"to happen","l":"acontecer"},null]},{"text":"Isto nunca aconteceu antes.","en":"This has never happened before.","words":[{"g":"this"},{"g":"never (at no time"},{"g":"to happen","l":"acontecer"},null]}]}