{"id":"teimoso","lemma":"teimoso","pos":"adj","rank":3429,"glosses":["stubborn","obstinate (who does not easily change their opinion or attitude)","insistent (who doesn't give up easily)"],"ipa":"/tɐjˈmo.zu/","forms":{"feminine":"teimosa","masculinePlural":"teimosos","femininePlural":"teimosas"},"examples":[{"text":"Tom era muito teimoso.","en":"Tom was very stubborn.","audio":"https://tatoeba.org/en/audio/download/536198","words":[{"g":"tone"},{"g":"to be","l":"ser"},{"g":"very / a lot"},null]},{"text":"Ela é uma mulher teimosa.","en":"She's a stubborn woman.","words":[{"g":"she"},{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"woman"},null]},{"text":"Tom é mesmo teimoso, não é?","en":"Tom is really stubborn, isn't he?","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"really"},null,null,null],"phrases":[[4,6,"isn't it"]]},{"text":"Não sejam teimosos.","en":"Don't be stubborn.","words":[{"g":"not / no"},{"g":"to be","l":"ser"},null]},{"text":"Não seja teimosa.","en":"Don't be stubborn.","words":[{"g":"not / no"},{"g":"to be","l":"ser"},null]}]}