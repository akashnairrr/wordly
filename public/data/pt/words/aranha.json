{"id":"aranha","lemma":"aranha","pos":"noun","rank":2689,"glosses":["spider","vulva, vagina, especially when hairy"],"ipa":"/aˈɾɐ̃.ɲɐ/","gender":"f","forms":{"plural":"aranhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q5146_%28por%29-Nelson_Ricardo_2500-aranha.wav","examples":[{"text":"Eu odeio aranhas.","en":"I hate spiders.","audio":"https://tatoeba.org/en/audio/download/491073","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Isso é uma aranha?","en":"Is that a spider?","words":[{"g":"that"},{"g":"is","l":"ser"},{"g":"a","l":"um"},null]},{"text":"A aranha está morta.","en":"The spider is dead.","words":[{"g":"the / to"},null,{"g":"is","l":"estar"},{"g":"dead","l":"morto"}]},{"text":"Ele odeia aranhas.","en":"He hates spiders.","words":[{"g":"he"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Tom matou a aranha.","en":"Tom killed the spider.","words":[{"g":"tone"},{"g":"to kill","l":"matar"},{"g":"the / to"},null]}]}