{"id":"honra","lemma":"honra","pos":"noun","rank":713,"glosses":["honor; respect","honor (positive reputation)","honor (objectification of praiseworthiness)"],"ipa":"/ˈõ.ʁɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b5/LL-Q5146_%28por%29-Santamarcanda-honra.wav/LL-Q5146_%28por%29-Santamarcanda-honra.wav.mp3","gender":"f","examples":[{"text":"É uma honra conhecer você.","en":"I'm honored to know you.","audio":"https://tatoeba.org/en/audio/download/1270446","words":[{"g":"is","l":"ser"},{"g":"a","l":"um"},null,{"g":"to know"},{"g":"you"}]},{"text":"Ele perdeu sua honra.","en":"He lost his honor.","words":[{"g":"he"},{"g":"to lose","l":"perder"},{"g":"his","l":"seu"},null]},{"text":"Você já foi dama de honra?","en":"Have you ever been a bridesmaid?","words":[{"g":"you"},{"g":"already"},{"g":"to be","l":"ser"},{"g":"lady"},{"g":"of / from"},null]},{"text":"Você me daria a honra de dançar comigo?","en":"Would you do me the honor of dancing with me?","words":[{"g":"you"},{"g":"me"},{"g":"to transfer one’s…","l":"dar"},{"g":"the / to"},null,{"g":"of / from"},{"g":"to dance"},{"g":"prepositional form with…"}]},{"text":"É uma honra imensa estar aqui contigo.","en":"It's a huge honor to be here with you.","audio":"https://tatoeba.org/en/audio/download/738342","words":[{"g":"is","l":"ser"},{"g":"a","l":"um"},null,{"g":"immensely, very much","l":"imenso"},{"g":"to be"},{"g":"here"},{"g":"with you"}]}]}