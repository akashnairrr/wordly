{"id":"cinquenta","lemma":"cinquenta","pos":"noun","rank":3669,"glosses":["fifty (an amount of 50)"],"ipa":"/sĩˈkwẽ.tɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e9/LL-Q5146_%28por%29-MedK1-cinquenta.wav/LL-Q5146_%28por%29-MedK1-cinquenta.wav.mp3","gender":"m","forms":{"plural":"cinquentas"},"examples":[{"text":"Só cinquenta pessoas vieram.","en":"Only fifty people came.","words":[{"g":"only"},null,{"g":"person","l":"pessoa"},null]},{"text":"Meu pai tem cinquenta anos de idade.","en":"My father is fifty years old.","words":[{"g":"my, mine"},{"g":"father"},{"g":"has / there is","l":"ter"},null,{"g":"year","l":"ano"},null,null],"phrases":[[5,7,"aged"]]},{"text":"Ela vai pagar, no máximo, cinquenta dólares.","en":"She will pay up to fifty dollars.","audio":"https://tatoeba.org/en/audio/download/769955","words":[{"g":"she"},{"g":"to go","l":"ir"},{"g":"to give [someone] money…"},null,null,null,{"g":"dollar","l":"dólar"}],"phrases":[[3,5,"at most"]]},{"text":"Esta camisa custa mais de cinquenta dólares.","en":"This shirt costs more than fifty dollars.","words":[{"g":"this","l":"este"},{"g":"shirt"},{"g":"to cost","l":"custar"},null,null,null,{"g":"dollar","l":"dólar"}],"phrases":[[3,5,"more than"]]},{"text":"Havia cinquenta passageiros no avião.","en":"There were fifty passengers on the plane.","words":[{"g":"there be","l":"haver"},null,{"g":"passing, transitory","l":"passageiro"},{"g":"in the"},{"g":"airplane, aeroplane"}]}]}