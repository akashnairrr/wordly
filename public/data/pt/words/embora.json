{"id":"embora","lemma":"embora","pos":"conj","rank":173,"glosses":["although (used with subjunctive, introducing a clause that expresses a concession)"],"ipa":"/ẽˈbɔ.ɾɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ab/LL-Q5146_%28por%29-Santamarcanda-embora.wav/LL-Q5146_%28por%29-Santamarcanda-embora.wav.mp3","examples":[{"text":"Você quer ir embora agora?","en":"Do you want to leave now?","audio":"https://tatoeba.org/en/audio/download/484147","words":[{"g":"you"},{"g":"to want","l":"querer"},{"g":"to go"},null,{"g":"now"}]},{"text":"Eu disse: vá embora.","en":"I said go away.","audio":"https://tatoeba.org/en/audio/download/490933","words":[{"g":"I"},{"g":"to speak","l":"dizer"},{"g":"to go","l":"ir"},null]},{"text":"Eu nunca irei embora.","en":"I'll never leave.","audio":"https://tatoeba.org/en/audio/download/493108","words":[{"g":"I"},{"g":"never (at no time"},{"g":"to go","l":"ir"},null]},{"text":"Nós não vamos embora.","en":"We're not going away.","audio":"https://tatoeba.org/en/audio/download/1274614","words":[{"g":"we"},{"g":"not / no"},{"g":"let's go"},null]},{"text":"Eu deveria ir embora.","en":"I should go.","words":[{"g":"I"},{"g":"should","l":"dever"},{"g":"to go"},null]}]}