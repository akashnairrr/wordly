{"id":"ui_sque","lemma":"uísque","pos":"noun","rank":2008,"glosses":["whiskey (liquor distilled from fermented grain)","whiskey (a drink of whiskey)"],"ipa":"/ˈwiʃ.kɨ/","gender":"m","forms":{"plural":"uísques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q5146_%28por%29-Nelson_Ricardo_2500-U%C3%ADsque.wav","examples":[{"text":"Este uísque é muito forte.","en":"This whisky is very strong.","words":[{"g":"this"},null,{"g":"is","l":"ser"},{"g":"very / a lot"},{"g":"capable of producing…"}]},{"text":"Você bebe uísque?","en":"Do you drink whiskey?","words":[{"g":"you (formal)"},{"g":"to drink","l":"beber"},null]},{"text":"Há um pouco de uísque nesta garrafa.","en":"There is a bit of whisky in this bottle.","words":[{"g":"there be","l":"haver"},null,null,{"g":"of / from"},null,{"g":"in this"},{"g":"bottle"}],"phrases":[[1,3,"slightly"]]},{"text":"Ele vende uísque.","en":"He sells whisky.","words":[{"g":"he"},{"g":"to sell","l":"vender"},null]},{"text":"Esse uísque é muito forte.","en":"That whiskey is very strong.","words":[{"g":"that"},null,{"g":"is","l":"ser"},{"g":"very / a lot"},{"g":"capable of producing…"}]}]}