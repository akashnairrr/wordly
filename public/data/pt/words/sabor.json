{"id":"sabor","lemma":"sabor","pos":"noun","rank":2109,"glosses":["flavour (the quality produced by the sensation of taste)","an enjoyable quality","flavour"],"ipa":"/sɐˈboɾ/","gender":"m","forms":{"plural":"sabores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q5146_%28por%29-MedK1-sabor.wav","examples":[{"text":"Tinha um sabor doce.","en":"It tasted sweet.","audio":"https://tatoeba.org/en/audio/download/852196","words":[{"g":"to own","l":"ter"},{"g":"a"},null,{"g":"sweet, sugary"}]},{"text":"Eu não gosto do sabor.","en":"I don't like the taste.","words":[{"g":"I"},{"g":"not / no"},{"g":"to like","l":"gostar"},{"g":"of the"},null]},{"text":"O sabor do amor é amargo.","en":"The taste of love is bitter.","words":[{"g":"the / it"},null,{"g":"of the"},{"g":"love"},{"g":"is","l":"ser"},{"g":"bitter, acrid"}]},{"text":"De que sabor é esse sorvete?","en":"What flavor is that ice cream?","words":[{"g":"of / from"},{"g":"that / what"},null,{"g":"is","l":"ser"},{"g":"that"},{"g":"sorbet"}]},{"text":"Tom não gostou muito do sabor.","en":"Tom didn't like the taste much.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to like","l":"gostar"},{"g":"very / a lot"},{"g":"of the"},null]}]}