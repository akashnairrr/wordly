{"id":"redor","lemma":"redor","pos":"noun","rank":954,"glosses":["the area surrounding someone or something"],"ipa":"/ʁeˈdɔʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6b/Pt-pt-redor.ogg/Pt-pt-redor.ogg.mp3","gender":"m","forms":{"plural":"redores"},"examples":[{"text":"Dei uma olhada ao redor.","en":"I took a look around.","audio":"https://tatoeba.org/en/audio/download/534183","words":[{"g":"to transfer one’s…","l":"dar"},{"g":"a","l":"um"},{"g":"look, glance"},null,null]},{"text":"Quero viajar ao redor do mundo.","en":"I want to travel around the world.","words":[{"g":"to want","l":"querer"},{"g":"to travel"},null,null,null,null],"phrases":[[4,6,"non-religious"]]},{"text":"Ele é famoso ao redor do mundo.","en":"He's famous around the world.","words":[{"g":"he"},{"g":"is","l":"ser"},{"g":"famous"},null,null,null,null],"phrases":[[5,7,"non-religious"]]},{"text":"Há algumas casas ao redor.","en":"There are a few houses around.","words":[{"g":"there be","l":"haver"},{"g":"some, any","l":"algum"},{"g":"house, home","l":"casa"},null,null]},{"text":"Há muitas árvores ao redor da lagoa.","en":"There are a lot of trees around the pond.","audio":"https://tatoeba.org/en/audio/download/840983","words":[{"g":"there be","l":"haver"},{"g":"very, a lot","l":"muito"},{"g":"tree","l":"árvore"},null,null,{"g":"of the"},{"g":"pond, pool, small lake"}]}]}