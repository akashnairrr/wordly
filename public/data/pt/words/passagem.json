{"id":"passagem","lemma":"passagem","pos":"noun","rank":1416,"glosses":["passage (act of passing)","passageway (any way for passing in, out or through something)","ticket (pass entitling the holder to board a train, a bus, a plane, or other means of transportation)"],"ipa":"/pɐˈsa.ʒɐ̃j̃/","gender":"f","forms":{"plural":"passagens"},"examples":[{"text":"Não esqueças a passagem.","en":"Don't forget the ticket.","audio":"https://tatoeba.org/en/audio/download/843448","words":[{"g":"not / no"},{"g":"to forget","l":"esquecer"},{"g":"the / to"},null]},{"text":"Tom não comprou uma passagem.","en":"Tom didn't buy a ticket.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to buy","l":"comprar"},{"g":"a","l":"um"},null]},{"text":"Só tenho duas passagens aéreas.","en":"I only have two plane tickets.","words":[{"g":"only"},{"g":"have","l":"ter"},{"g":"deuce","l":"dois"},null,{"g":"aerial","l":"aéreo"}]},{"text":"Estamos só de passagem.","en":"We're just passing through.","words":[{"g":"to be","l":"estar"},{"g":"only"},{"g":"of / from"},null]},{"text":"Você sabia que havia uma passagem secreta?","en":"Did you know there was a secret passage?","words":[{"g":"you (formal)"},{"g":"to be aware, to know","l":"saber"},{"g":"that / what"},{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"secret","l":"secreto"}]}]}