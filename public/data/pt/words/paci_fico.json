{"id":"paci_fico","lemma":"pacífico","pos":"adj","rank":2862,"glosses":["peaceful (inclined to peace; peaceable)","pacific; calm; peaceful"],"ipa":"/pɐˈsi.fi.ku/","forms":{"feminine":"pacífica","masculinePlural":"pacíficos","femininePlural":"pacíficas"},"examples":[{"text":"Esse lugar é pacífico.","en":"This is a peaceful place.","words":[{"g":"that"},{"g":"place"},{"g":"is","l":"ser"},null]},{"text":"Nós queremos uma solução pacífica.","en":"We want a peaceful solution.","audio":"https://tatoeba.org/en/audio/download/840349","words":[{"g":"we"},{"g":"to want","l":"querer"},{"g":"a","l":"um"},{"g":"solution"},null]},{"text":"Podemos fazer uso pacífico da energia atômica.","en":"We can make peaceful use of atomic energy.","words":[{"g":"to be able to","l":"poder"},{"g":"to create"},{"g":"use"},null,{"g":"of the"},{"g":"energy"},null]},{"text":"Precisamos pensar em usos pacíficos da energia atômica.","en":"We must think about peaceful uses of atomic energy.","words":[{"g":"to need","l":"precisar"},null,null,{"g":"use","l":"uso"},null,{"g":"of the"},{"g":"energy"},null],"phrases":[[1,3,"to think about"]]},{"text":"O barco navegou pelo oceano Pacífico.","en":"The boat sailed across the Pacific Ocean.","words":[{"g":"the / it"},{"g":"boat"},{"g":"to navigate, sail","l":"navegar"},{"g":"by / for the","l":"pelar"},{"g":"ocean"},null]}]}