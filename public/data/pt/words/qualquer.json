{"id":"qualquer","lemma":"qualquer","pos":"pron","rank":136,"glosses":["any (no matter what kind, which or who)","anyone (no matter who)"],"ipa":"/ˌkwawˈkɛ(ʁ)/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/16/Pt-br-qualquer.ogg/Pt-br-qualquer.ogg.mp3","forms":{"plural":"quaisquer"},"examples":[{"text":"Qualquer criança sabe disso.","en":"Any child knows that.","words":[null,{"g":"child"},{"g":"to be aware, to know","l":"saber"},null]},{"text":"Eu não tenho quaisquer amigos.","en":"I don't have any friends.","words":[{"g":"I"},{"g":"not / no"},{"g":"have","l":"ter"},null,{"g":"friend","l":"amigo"}]},{"text":"Eu posso trabalhar com qualquer pessoa.","en":"I can work with anyone.","audio":"https://tatoeba.org/en/audio/download/535587","words":[{"g":"I"},{"g":"to be able to","l":"poder"},{"g":"to work"},{"g":"with"},null,{"g":"person"}]},{"text":"Ele estará aqui a qualquer momento.","en":"He will be here any moment.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"here"},{"g":"the / to"},null,{"g":"moment"}]},{"text":"Faremos qualquer coisa por você.","en":"We will do anything for you.","audio":"https://tatoeba.org/en/audio/download/841856","words":[{"g":"to create","l":"fazer"},null,{"g":"thing"},{"g":"for / by"},{"g":"you"}]}]}