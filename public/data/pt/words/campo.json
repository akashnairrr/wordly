{"id":"campo","lemma":"campo","pos":"noun","rank":478,"glosses":["country; countryside","field (large open area, especially one where crops are grown or sports are played)","field (domain of knowledge or practice)"],"ipa":"/ˈkɐ̃.pu/","gender":"m","forms":{"plural":"campos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q5146_%28por%29-Nelson_Ricardo_2500-campo.wav","examples":[{"text":"Tom é um rapaz do campo.","en":"Tom is a country boy.","audio":"https://tatoeba.org/en/audio/download/1274508","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"a"},{"g":"boy"},{"g":"of the"},null]},{"text":"O campo é belo.","en":"The countryside is beautiful.","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"beautiful"}]},{"text":"Meu pai mora no campo.","en":"My father lives in the country.","words":[{"g":"my, mine"},{"g":"father"},{"g":"to live, reside","l":"morar"},{"g":"in the"},null]},{"text":"Os campos secaram.","en":"The fields are dry.","audio":"https://tatoeba.org/en/audio/download/840462","words":[{"g":"the"},null,null]},{"text":"A comida neste campo é terrível.","en":"The food at this camp is terrible.","words":[{"g":"the / to"},{"g":"food, something edible"},{"g":"in this"},null,{"g":"is","l":"ser"},{"g":"terrible"}]}]}