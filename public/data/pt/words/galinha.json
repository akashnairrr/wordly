{"id":"galinha","lemma":"galinha","pos":"noun","rank":1885,"glosses":["hen","chicken (meat)","a person (especially a woman) who is almost never single"],"ipa":"/ɡaˈlĩ.ɲɐ/","gender":"f","forms":{"plural":"galinhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q5146_%28por%29-Nelson_Ricardo_2500-galinha.wav","examples":[{"text":"Aquilo é uma galinha?","en":"Is that a chicken?","words":[{"g":"that over there, yon","l":"aquele"},{"g":"is","l":"ser"},{"g":"a","l":"um"},null]},{"text":"Eu tenho três galinhas em casa.","en":"I have three chickens in my house.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"three"},null,null,null],"phrases":[[4,6,"home"]]},{"text":"Tom tem galinhas.","en":"Tom has chickens.","audio":"https://tatoeba.org/en/audio/download/493170","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},null]},{"text":"Eu realmente não gosto de galinha.","en":"I really don't like chickens.","words":[{"g":"I"},{"g":"truly"},{"g":"not / no"},{"g":"taste"},{"g":"of / from"},null]},{"text":"Preciso ir alimentar as galinhas.","en":"I need to go feed the chickens.","words":[{"g":"precise"},{"g":"to go"},{"g":"to feed"},{"g":"the"},null]}]}