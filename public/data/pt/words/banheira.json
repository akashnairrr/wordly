{"id":"banheira","lemma":"banheira","pos":"noun","rank":2377,"glosses":["bathtub (a large container for holding water in which a person may bathe)","synonym of abatanado"],"ipa":"/bɐˈɲɐj.ɾɐ/","gender":"f","forms":{"plural":"banheiras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q5146_%28por%29-Jessie_Edwin_Lawrence-banheira.wav","examples":[{"text":"A banheira precisa ser limpa.","en":"The bathtub needs to be cleaned.","words":[{"g":"the / to"},null,{"g":"to need","l":"precisar"},{"g":"to be"},{"g":"to clean","l":"limpar"}]},{"text":"Estou na banheira.","en":"I'm in the bathtub.","words":[{"g":"am","l":"estar"},{"g":"in the"},null]},{"text":"Tom saiu da banheira.","en":"Tom got out of the bath.","words":[{"g":"tone"},{"g":"to exit","l":"sair"},{"g":"of the"},null]},{"text":"Tom entrou na banheira.","en":"Tom got in the bathtub.","words":[{"g":"tone"},{"g":"to enter","l":"entrar"},{"g":"in the"},null]},{"text":"Alguém a afogou na banheira.","en":"Somebody had drowned her in the bathtub.","words":[{"g":"somebody"},{"g":"the / to"},{"g":"to drown","l":"afogar"},{"g":"in the"},null]}]}