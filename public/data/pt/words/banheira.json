{"id":"banheira","lemma":"banheira","pos":"noun","rank":2236,"glosses":["bathtub (a large container for holding water in which a person may bathe)","synonym of abatanado"],"ipa":"/bɐ̃ˈɲe(j).ɾɐ/","gender":"f","forms":{"plural":"banheiras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q5146_%28por%29-Jessie_Edwin_Lawrence-banheira.wav","examples":[{"text":"Estou na banheira.","en":"I'm in the bathtub.","words":[{"g":"am","l":"estar"},{"g":"in the"},null]},{"text":"A banheira precisa ser limpa.","en":"The bathtub needs to be cleaned.","words":[{"g":"the / to"},null,{"g":"precise","l":"preciso"},{"g":"to be"},{"g":"to clean","l":"limpar"}]},{"text":"Tom saiu da banheira.","en":"Tom got out of the bath.","words":[{"g":"tone"},{"g":"to exit","l":"sair"},{"g":"of the"},null]},{"text":"Você limpou a banheira?","en":"Did you clean the bathtub?","words":[{"g":"you"},{"g":"to clean","l":"limpar"},{"g":"the / to"},null]},{"text":"Tom ficou de molho na banheira.","en":"Tom soaked in the bathtub.","audio":"https://tatoeba.org/en/audio/download/963493","words":[{"g":"tone"},{"g":"to become","l":"ficar"},null,null,{"g":"in the"},null],"phrases":[[2,4,"immersed in water"]]}]}