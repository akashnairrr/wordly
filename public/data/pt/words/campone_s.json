{"id":"campone_s","lemma":"camponês","pos":"noun","rank":4913,"glosses":["peasant (member of the agriculture low class)"],"ipa":"/kɐ̃.puˈneʃ/","gender":"m","forms":{"plural":"camponeses","feminine":"camponesa","femininePlural":"camponesas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ce/LL-Q5146_%28por%29-Jessie_Edwin_Lawrence-campon%C3%AAs.wav","examples":[{"text":"Os camponeses pobres comiam batatas.","en":"The poor peasants ate potatoes.","audio":"https://tatoeba.org/en/audio/download/840978","words":[{"g":"the"},null,{"g":"poor","l":"pobre"},{"g":"to consume meals","l":"comer"},{"g":"potato","l":"batata"}]},{"text":"Muitos camponeses morreram durante a seca.","en":"Many peasants died during the drought.","words":[{"g":"very, a lot","l":"muito"},null,null,{"g":"during"},{"g":"the / to"},{"g":"drought"}]},{"text":"Eu não sou nada mais que um pobre camponês.","en":"I'm nothing but a poor peasant.","words":[{"g":"I"},{"g":"not / no"},{"g":"am","l":"ser"},{"g":"nothing"},{"g":"more"},{"g":"that / what"},{"g":"a"},{"g":"poor"},null]}]}