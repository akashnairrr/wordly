{"id":"quinto","lemma":"quinto","pos":"adj","rank":3203,"glosses":["fifth"],"ipa":"/ˈkĩ.tu/","forms":{"feminine":"quinta","masculinePlural":"quintos","femininePlural":"quintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q5146_%28por%29-Nelson_Ricardo_2500-quinto.wav","formAudio":{"quinta":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q5146_%28por%29-Santamarcanda-quinta.wav"},"examples":[{"text":"Meu escritório é no quinto andar.","en":"My office is on the fifth floor.","words":[{"g":"my, mine"},{"g":"office"},{"g":"is","l":"ser"},{"g":"in the"},null,{"g":"to walk"}]},{"text":"Moro no quinto andar.","en":"I live on the fifth floor.","audio":"https://tatoeba.org/en/audio/download/1270297","words":[{"g":"to live, reside","l":"morar"},{"g":"in the"},null,{"g":"to walk"}]},{"text":"O departamento de brinquedos é no quinto andar.","en":"The toy department is on the fifth floor.","words":[{"g":"the / it"},{"g":"department"},{"g":"of / from"},{"g":"toy, plaything","l":"brinquedo"},{"g":"is","l":"ser"},{"g":"in the"},null,{"g":"to walk"}]},{"text":"Estarei aqui de segunda a quinta.","en":"I will be here from Monday to Thursday.","words":[{"g":"to be","l":"estar"},{"g":"here"},null,null,{"g":"the / to"},null],"phrases":[[2,4,"of low quality"]]},{"text":"Hoje é quinta-feira.","en":"Today is Thursday.","words":[{"g":"today"},{"g":"is","l":"ser"},null,{"g":"market"}]}]}