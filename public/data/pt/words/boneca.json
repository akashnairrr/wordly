{"id":"boneca","lemma":"boneca","pos":"noun","rank":2102,"glosses":["doll (a toy in the form of a human)","a very pretty or well-dressed woman","flamer (homosexual male)"],"ipa":"/buˈnɛ.kɐ/","gender":"f","forms":{"plural":"bonecas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q5146_%28por%29-MedK1-boneca.wav","examples":[{"text":"É uma boneca.","en":"It's a doll.","audio":"https://tatoeba.org/en/audio/download/67737","words":[{"g":"is","l":"ser"},{"g":"a","l":"um"},null]},{"text":"Ela tem uma boneca bonita.","en":"She has a pretty doll.","words":[{"g":"she"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},null,{"g":"pretty, lovely","l":"bonito"}]},{"text":"Há uma boneca na caixa.","en":"There is a doll in the box.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"in the"},{"g":"box"}]},{"text":"Quantas bonecas você tem?","en":"How many dolls do you have?","words":[{"g":"how much","l":"quanto"},null,{"g":"you (formal)"},{"g":"has / there is","l":"ter"}]},{"text":"Ela fez a boneca para mim.","en":"She made the doll for me.","words":[{"g":"she"},{"g":"to create","l":"fazer"},{"g":"the / to"},null,{"g":"for / to"},{"g":"me"}]}]}