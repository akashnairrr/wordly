{"id":"prisioneiro","lemma":"prisioneiro","pos":"noun","rank":1626,"glosses":["prisoner (person incarcerated in a prison)","prisoner (any person held against his or her will)"],"ipa":"/pɾi.zjuˈnɐj.ɾu/","gender":"m","forms":{"plural":"prisioneiros","feminine":"prisioneira","femininePlural":"prisioneiras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q5146_%28por%29-MedK1-prisioneiro.wav","examples":[{"text":"Tom é meu prisioneiro.","en":"Tom is my prisoner.","audio":"https://tatoeba.org/en/audio/download/494868","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"my, mine"},null]},{"text":"Vocês são prisioneiros.","en":"You're prisoners.","words":[{"g":"you (pl.)"},{"g":"to be","l":"ser"},null]},{"text":"Eu sou prisioneiro.","en":"I'm a prisoner.","audio":"https://tatoeba.org/en/audio/download/491280","words":[{"g":"I"},{"g":"am","l":"ser"},null]},{"text":"Quase todos os prisioneiros estavam vivos.","en":"Almost all the prisoners were alive.","words":[{"g":"almost"},{"g":"everyone"},{"g":"the"},null,{"g":"to be","l":"estar"},{"g":"alive (having life","l":"vivo"}]},{"text":"Temos um prisioneiro.","en":"We have a prisoner.","words":[{"g":"to own","l":"ter"},{"g":"a"},null]}]}