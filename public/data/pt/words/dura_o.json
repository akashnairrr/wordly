{"id":"dura_o","lemma":"durão","pos":"adj","rank":4810,"glosses":["tough (in character); brave"],"ipa":"/duˈɾɐ̃w̃/","forms":{"feminine":"durona","masculinePlural":"durões","femininePlural":"duronas"},"examples":[{"text":"Tom é bem durão.","en":"Tom is pretty tough.","audio":"https://tatoeba.org/en/audio/download/495281","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"well"},null]},{"text":"Quem é esse cara durão?","en":"Who is this tough guy?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"that"},{"g":"face"},null]},{"text":"Ela não é tão durona como parece.","en":"She is not as tough as she seems.","words":[{"g":"she"},null,null,{"g":"so"},null,{"g":"how / like"},{"g":"to seem","l":"parecer"}],"phrases":[[1,3,"isn't it"]]},{"text":"Tom não é tão durão quanto eu.","en":"Tom isn't as tough as I am.","words":[{"g":"tone"},null,null,{"g":"so"},null,{"g":"how much"},{"g":"I"}],"phrases":[[1,3,"isn't it"]]},{"text":"Parece que o Tom é durão.","en":"It looks like Tom is tough.","words":[{"g":"to seem","l":"parecer"},{"g":"that / what"},{"g":"the / it"},{"g":"tone"},{"g":"is","l":"ser"},null]}]}