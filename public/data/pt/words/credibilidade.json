{"id":"credibilidade","lemma":"credibilidade","pos":"noun","rank":4792,"glosses":["credibility"],"ipa":"/kɾɨ.di.bi.liˈda.dɨ/","gender":"f","forms":{"plural":"credibilidades"},"examples":[{"text":"Tom perdeu a credibilidade.","en":"Tom lost his credibility.","words":[{"g":"tone"},{"g":"to lose","l":"perder"},{"g":"the / to"},null]},{"text":"Nós não queremos perder a nossa credibilidade.","en":"We don't want to lose our credibility.","words":[{"g":"we"},{"g":"not / no"},{"g":"to want","l":"querer"},{"g":"to lose"},{"g":"the / to"},{"g":"ours being addressed)","l":"nosso"},null]},{"text":"Eles perderam toda a credibilidade.","en":"They've lost all credibility.","words":[{"g":"they"},null,{"g":"of the Toda people"},{"g":"the / to"},null]},{"text":"Você perdeu a sua credibilidade.","en":"You've lost your credibility.","words":[{"g":"you (formal)"},{"g":"to lose","l":"perder"},{"g":"the / to"},{"g":"his","l":"seu"},null]},{"text":"Esse escândalo destruiu a credibilidade de Tom.","en":"That scandal destroyed Tom's credibility.","words":[{"g":"that"},{"g":"scandal"},{"g":"to ruin, devastate","l":"destruir"},{"g":"the / to"},null,{"g":"of / from"},{"g":"tone"}]}]}