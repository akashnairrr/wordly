{"id":"teto","lemma":"teto","pos":"noun","rank":2716,"glosses":["ceiling (upper surface of room)","ceiling (upper limit of a value)"],"ipa":"/ˈtɛ.tu/","gender":"m","forms":{"plural":"tetos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-teto.wav","examples":[{"text":"Tom consegue tocar o teto.","en":"Tom can touch the ceiling.","words":[{"g":"tone"},{"g":"to get, obtain","l":"conseguir"},{"g":"to touch"},{"g":"the / it"},null]},{"text":"Ele é sem-teto.","en":"He is homeless.","words":[{"g":"he"},{"g":"is","l":"ser"},{"g":"-less"},null]},{"text":"Pinte o teto primeiro.","en":"Paint the ceiling first.","words":[{"g":"to paint","l":"pintar"},{"g":"the / it"},null,{"g":"first"}]},{"text":"Tem uma libélula no teto.","en":"There is a dragonfly on the ceiling.","words":[{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},{"g":"dragonfly"},{"g":"in the"},null]},{"text":"Você alcança o teto?","en":"Can you reach the ceiling?","words":[{"g":"you (formal)"},{"g":"to reach","l":"alcançar"},{"g":"the / it"},null]}]}