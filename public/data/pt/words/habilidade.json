{"id":"habilidade","lemma":"habilidade","pos":"noun","rank":2426,"glosses":["ability","skill"],"ipa":"/ɐ.bliˈda.dɨ/","gender":"f","forms":{"plural":"habilidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q5146_%28por%29-Waldyrious-habilidade.wav","examples":[{"text":"Tenho confiança nas habilidades dele.","en":"I have confidence in his abilities.","words":[{"g":"have","l":"ter"},{"g":"trust, confidence"},null,null,{"g":"his / of him","l":"delir"}]},{"text":"Ele é um homem de grande habilidade.","en":"He is a man of great ability.","words":[{"g":"he"},{"g":"is","l":"ser"},{"g":"a"},{"g":"male"},{"g":"of / from"},{"g":"large"},null]},{"text":"Confio completamente nas suas habilidades.","en":"I completely trust your abilities.","audio":"https://tatoeba.org/en/audio/download/58608","words":[{"g":"to confide, entrust","l":"confiar"},{"g":"completely"},null,{"g":"his","l":"seu"},null]},{"text":"Nadar é uma habilidade muito útil.","en":"Swimming is a very useful skill.","words":[{"g":"to swim"},{"g":"is","l":"ser"},{"g":"a","l":"um"},null,{"g":"very / a lot"},{"g":"profitable"}]},{"text":"Tom tem habilidades especiais.","en":"Tom has special abilities.","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},null,{"g":"special","l":"especial"}]}]}