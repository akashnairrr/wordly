{"id":"bolha","lemma":"bolha","pos":"noun","rank":4086,"glosses":["bubble (a sphere of soapy liquid)","bubble (spherical cavity in solid material)","blister (pocket of fluid in the skin)"],"ipa":"/ˈbo.ʎɐ/","gender":"f","forms":{"plural":"bolhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q5146_%28por%29-Wiktionairy-bolha.wav","examples":[{"text":"A garota está soprando bolhas.","en":"The girl is blowing bubbles.","words":[{"g":"the / to"},{"g":"girl"},{"g":"is","l":"estar"},{"g":"to blow","l":"soprar"},null]},{"text":"Tom tinha bolhas em suas mãos.","en":"Tom had blisters on his hands.","words":[{"g":"tone"},{"g":"to own","l":"ter"},null,{"g":"in"},{"g":"his","l":"seu"},{"g":"hand","l":"mão"}]},{"text":"Eu tenho bolhas nos meus pés.","en":"I've got blisters on my feet.","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"us","l":"nós"},{"g":"my kin"},{"g":"foot","l":"pé"}]},{"text":"As crianças estão soprando bolhas.","en":"The children are blowing bubbles.","words":[{"g":"the"},{"g":"child","l":"criança"},{"g":"to be","l":"estar"},{"g":"to blow","l":"soprar"},null]},{"text":"Eu tenho bolhas de queimadura.","en":"I got blisters from the burn.","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"of / from"},{"g":"a burn"}]}]}