{"id":"rodovia","lemma":"rodovia","pos":"noun","rank":3271,"glosses":["highway (main, direct public road)"],"ipa":"/ʁo.doˈvi.ɐ/","gender":"f","forms":{"plural":"rodovias"},"examples":[{"text":"Houve um acidente horrível na rodovia.","en":"There was a terrible accident on the freeway.","words":[{"g":"there be","l":"haver"},{"g":"a"},{"g":"accident"},{"g":"cause of horror"},{"g":"in the"},null]},{"text":"Esta rodovia nos economiza muito tempo.","en":"This highway saves us a lot of time.","words":[{"g":"this","l":"este"},null,{"g":"us","l":"nós"},{"g":"to economize, save","l":"economizar"},{"g":"very / a lot"},{"g":"time"}]},{"text":"Muitas rodovias ainda estão fechadas.","en":"Many highways are still closed.","words":[{"g":"very, a lot","l":"muito"},null,{"g":"still"},{"g":"to be","l":"estar"},{"g":"closed, shut","l":"fechado"}]},{"text":"Há muito trânsito na rodovia.","en":"There's a lot of traffic on the freeway.","words":[{"g":"there be","l":"haver"},{"g":"very / a lot"},{"g":"traffic"},{"g":"in the"},null]},{"text":"Tom atravessou a rodovia.","en":"Tom crossed the highway.","words":[{"g":"tone"},{"g":"to put across","l":"atravessar"},{"g":"the / to"},null]}]}