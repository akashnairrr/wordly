{"id":"folga","lemma":"folga","pos":"noun","rank":1430,"glosses":["rest, day off (from work)","respite; break (a brief interval of rest or relief)","slack (extent to which a part of a mechanism can move freely)"],"ipa":"/ˈfɔw.ɡɐ/","gender":"f","forms":{"plural":"folgas"},"examples":[{"text":"Eu estou de folga hoje.","en":"I am off today.","words":[{"g":"I"},{"g":"am","l":"estar"},{"g":"of / from"},null,{"g":"today"}]},{"text":"Amanhã é meu dia de folga.","en":"Tomorrow's my day off.","audio":"https://tatoeba.org/en/audio/download/58676","words":[{"g":"tomorrow"},{"g":"is","l":"ser"},{"g":"my, mine"},{"g":"period between sunrise…"},{"g":"of / from"},null]},{"text":"Você está de folga esta noite?","en":"Are you off duty tonight?","words":[{"g":"you"},{"g":"is","l":"estar"},{"g":"of / from"},null,{"g":"this","l":"este"},{"g":"night"}]},{"text":"Eu estava de folga no momento.","en":"I was off duty at the time.","words":[{"g":"I"},{"g":"to be","l":"estar"},{"g":"of / from"},null,null,null],"phrases":[[4,6,"at the moment"]]},{"text":"Tire alguns dias de folga.","en":"Take a few days off.","words":[{"g":"to take","l":"tirar"},{"g":"some, any","l":"algum"},{"g":"period between sunrise…","l":"dia"},{"g":"of / from"},null]}]}