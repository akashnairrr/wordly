{"id":"folga","lemma":"folga","pos":"noun","rank":1748,"glosses":["rest, day off (from work)","respite; break (a brief interval of rest or relief)","slack (extent to which a part of a mechanism can move freely)"],"ipa":"/ˈfɔl.ɡɐ/","gender":"f","forms":{"plural":"folgas"},"examples":[{"text":"Amanhã é meu dia de folga.","en":"Tomorrow's my day off.","audio":"https://tatoeba.org/en/audio/download/58676","words":[{"g":"tomorrow"},{"g":"is","l":"ser"},{"g":"my, mine"},{"g":"period between sunrise…"},{"g":"of / from"},null]},{"text":"Estou de folga hoje.","en":"I am off today.","words":[{"g":"am","l":"estar"},{"g":"of / from"},null,{"g":"today"}]},{"text":"Vocês estão de folga esta noite?","en":"Are you off duty tonight?","words":[{"g":"you (pl.)"},{"g":"to be","l":"estar"},{"g":"of / from"},null,{"g":"this","l":"este"},{"g":"night"}]},{"text":"Vou tirar uma folga amanhã.","en":"I'm taking tomorrow off.","words":[{"g":"to go","l":"ir"},{"g":"to take"},{"g":"a","l":"um"},null,{"g":"tomorrow"}]},{"text":"Ele tirou um dia de folga.","en":"He took a day off.","words":[{"g":"he"},{"g":"to take","l":"tirar"},null,null,{"g":"of / from"},null],"phrases":[[2,4,"someday / once"]]}]}