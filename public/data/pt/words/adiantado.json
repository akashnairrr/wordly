{"id":"adiantado","lemma":"adiantado","pos":"adv","rank":4586,"glosses":["early (sooner than expected)","in advance"],"ipa":"/ɐ.djɐ̃ˈta.du/","examples":[{"text":"Ele chegou aqui dez minutos adiantado.","en":"He arrived here ten minutes early.","words":[{"g":"he"},{"g":"to arrive","l":"chegar"},{"g":"here"},{"g":"ten"},{"g":"minute","l":"minuto"},null]},{"text":"Estou muito adiantado?","en":"Am I too early?","words":[{"g":"am","l":"estar"},{"g":"very / a lot"},null]},{"text":"Tom está vinte minutos adiantado.","en":"Tom is twenty minutes early.","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"twenty"},{"g":"minute","l":"minuto"},null]},{"text":"Meu relógio está cinco minutos adiantado.","en":"My clock is five minutes fast.","words":[{"g":"my, mine"},{"g":"clock"},{"g":"is","l":"estar"},{"g":"five"},{"g":"minute","l":"minuto"},null]},{"text":"Esse relógio está um minuto adiantado.","en":"That clock is one minute fast.","words":[{"g":"that"},{"g":"clock"},{"g":"is","l":"estar"},{"g":"a"},{"g":"minute"},null]}]}