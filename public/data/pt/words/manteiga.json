{"id":"manteiga","lemma":"manteiga","pos":"noun","rank":2158,"glosses":["butter (fatty and unctuous substance obtained from the cream of milk)","lard","fatty substance of some vegetables"],"ipa":"/mɐ̃ˈte(j).ɡɐ/","gender":"f","forms":{"plural":"manteigas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q5146_%28por%29-Nelson_Ricardo_2500-manteiga.wav","examples":[{"text":"Eu preciso de mais manteiga.","en":"I need more butter.","audio":"https://tatoeba.org/en/audio/download/494680","words":[{"g":"I"},{"g":"precise"},{"g":"of / from"},{"g":"more"},null]},{"text":"Onde está a manteiga?","en":"Where's the butter?","words":[{"g":"where"},{"g":"is","l":"estar"},{"g":"the / to"},null]},{"text":"Ele passou manteiga no pão.","en":"He spread butter on the bread.","words":[{"g":"he"},{"g":"to pass","l":"passar"},null,{"g":"in the"},{"g":"bread"}]},{"text":"Você usa muita manteiga mesmo.","en":"You sure do use a lot of butter.","words":[{"g":"you"},{"g":"to use","l":"usar"},{"g":"very, a lot","l":"muito"},null,{"g":"really"}]},{"text":"Ele gosta de pão com manteiga.","en":"He likes bread and butter.","words":[{"g":"he"},{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"bread"},{"g":"with"},null]}]}