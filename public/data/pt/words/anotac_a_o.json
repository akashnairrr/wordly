{"id":"anotac_a_o","lemma":"anotação","pos":"noun","rank":4954,"glosses":["notation (specific note or piece of information written in such a notation)","annotation (comment added to a text)"],"ipa":"/ɐ.nu.tɐˈsɐ̃w̃/","gender":"f","forms":{"plural":"anotações"},"examples":[{"text":"Deixe-me ver suas anotações.","en":"Let me see your notes.","words":[{"g":"to leave","l":"deixar"},{"g":"me"},{"g":"to see"},{"g":"his","l":"seu"},null]},{"text":"Tom fez anotações.","en":"Tom took notes.","audio":"https://tatoeba.org/en/audio/download/491132","words":[{"g":"tone"},{"g":"to create","l":"fazer"},null]},{"text":"Tom conferiu suas anotações.","en":"Tom checked his notes.","words":[{"g":"tone"},null,{"g":"his","l":"seu"},null]},{"text":"Essas são as anotações do Tom?","en":"Are these Tom's notes?","audio":"https://tatoeba.org/en/audio/download/533986","words":[{"g":"that, that one","l":"esse"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of the"},{"g":"tone"}]},{"text":"Eu posso copiar as suas anotações?","en":"Can I copy your notes?","words":[{"g":"I"},{"g":"to be able to","l":"poder"},{"g":"to copy"},{"g":"the"},{"g":"his","l":"seu"},null]}]}