{"id":"violino","lemma":"violino","pos":"noun","rank":4082,"glosses":["violin"],"ipa":"/vjuˈli.nu/","gender":"m","forms":{"plural":"violinos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q5146_%28por%29-Nelson_Ricardo_2500-violino.wav","examples":[{"text":"Tom é muito bom no violino.","en":"Tom is very good at playing the violin.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"very / a lot"},{"g":"desirable"},{"g":"in the"},null]},{"text":"Você tem um violino?","en":"Do you have a violin?","words":[{"g":"you (formal)"},{"g":"has / there is","l":"ter"},{"g":"a"},null]},{"text":"Você sabe tocar violino?","en":"Can you play the violin?","words":[{"g":"you (formal)"},{"g":"to be aware, to know","l":"saber"},{"g":"to touch"},null]},{"text":"Os primeiros violinos carregam a melodia.","en":"The first violins carry the melody.","words":[{"g":"the"},{"g":"first","l":"primeiro"},null,{"g":"to carry","l":"carregar"},{"g":"the / to"},{"g":"melody"}]},{"text":"Você ouviu o meu filho tocar violino?","en":"Did you hear my son play the violin?","words":[{"g":"you (formal)"},{"g":"to hear","l":"ouvir"},{"g":"the / it"},{"g":"my, mine"},{"g":"son"},{"g":"to touch"},null]}]}