{"id":"assinatura","lemma":"assinatura","pos":"noun","rank":2106,"glosses":["signature","byline","subscription (for a publication or service)"],"ipa":"/ɐ.si.nɐˈtu.ɾɐ/","gender":"f","forms":{"plural":"assinaturas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q5146_%28por%29-Wiktionairy-assinatura.wav","examples":[{"text":"Não havia assinatura no contrato.","en":"There was no signature on the contract.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null,{"g":"in the"},{"g":"contract"}]},{"text":"Essa é minha assinatura.","en":"That's my signature.","words":[{"g":"that, that one","l":"esse"},{"g":"is","l":"ser"},{"g":"my, mine","l":"meu"},null]},{"text":"Compare as assinaturas.","en":"Compare the signatures.","words":[{"g":"to compare","l":"comparar"},{"g":"the"},null]},{"text":"Precisamos de sua assinatura.","en":"We need your signature.","words":[{"g":"to need","l":"precisar"},{"g":"of / from"},{"g":"his","l":"seu"},null]},{"text":"Sua assinatura aqui, por favor.","en":"Please sign here.","words":[{"g":"his","l":"seu"},null,{"g":"here"},null,null],"phrases":[[3,5,"please"]]}]}