{"id":"ave","lemma":"ave","pos":"noun","rank":2700,"glosses":["bird"],"ipa":"/ˈa.vɨ/","gender":"f","forms":{"plural":"aves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q5146_%28por%29-Nelson_Ricardo_2500-ave.wav","examples":[{"text":"Esta ave sabe voar.","en":"This bird can fly.","words":[{"g":"this","l":"este"},null,{"g":"to be aware, to know","l":"saber"},{"g":"to fly"}]},{"text":"Eu adoro observar aves.","en":"I love watching birds.","words":[{"g":"I"},{"g":"to love","l":"adorar"},{"g":"to observe, watch"},null]},{"text":"A águia é a rainha das aves.","en":"The eagle is the king of birds.","words":[{"g":"the / to"},{"g":"eagle"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"queen"},null,null]},{"text":"O avestruz é a maior ave do mundo.","en":"Ostriches are the largest birds in the world.","words":[{"g":"the / it"},{"g":"ostrich"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"major, greater"},null,null,null],"phrases":[[6,8,"non-religious"]]},{"text":"As aves costumam voar juntas.","en":"Birds often fly together.","words":[{"g":"the"},null,{"g":"to be accustomed to","l":"costumar"},{"g":"to fly"},{"g":"together","l":"junto"}]}]}