{"id":"foco","lemma":"foco","pos":"noun","rank":4261,"glosses":["focus (point at which rays of light converge)","focus (point of a conic at which rays reflected from a curve or surface converge)","focus (convergence of light on the photographic medium)"],"ipa":"/ˈfɔ.ku/","gender":"m","forms":{"plural":"focos"},"examples":[{"text":"Precisamos manter o foco.","en":"We need to maintain focus.","words":[{"g":"to need","l":"precisar"},{"g":"to keep, maintain"},{"g":"the / it"},null]},{"text":"Tom perdeu o foco.","en":"Tom has lost his focus.","words":[{"g":"tone"},{"g":"to lose","l":"perder"},{"g":"the / it"},null]},{"text":"Não perca o foco.","en":"Don't lose focus.","words":[{"g":"not / no"},{"g":"to lose","l":"perder"},{"g":"the / it"},null]},{"text":"Ajusta o foco do microscópio.","en":"Adjust the microscope's focus.","words":[{"g":"to adjust","l":"ajustar"},{"g":"the / it"},null,{"g":"of the"},{"g":"microscope"}]},{"text":"Mantenha o foco.","en":"Keep focused.","words":[{"g":"to keep, maintain","l":"manter"},{"g":"the / it"},null]}]}