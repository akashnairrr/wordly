{"id":"prazer","lemma":"prazer","pos":"noun","rank":336,"glosses":["pleasure","nice to meet you (muito prazer)"],"ipa":"/pɾɐˈzeɾ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/LL-Q5146_%28por%29-Santamarcanda-prazer.wav/LL-Q5146_%28por%29-Santamarcanda-prazer.wav.mp3","gender":"m","forms":{"plural":"prazeres"},"examples":[{"text":"Será um prazer.","en":"It'll be a pleasure.","words":[{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"O prazer é todo meu.","en":"The pleasure's mine.","audio":"https://tatoeba.org/en/audio/download/762206","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"every"},{"g":"my, mine"}]},{"text":"Ler é um dos prazeres da vida.","en":"Reading is one of life's great pleasures.","words":[{"g":"to read"},{"g":"is","l":"ser"},{"g":"a"},null,null,null,null],"phrases":[[5,7,"extremely"]]},{"text":"É um grande prazer estar aqui.","en":"It is a great pleasure to be here.","words":[{"g":"is","l":"ser"},{"g":"a"},{"g":"large"},null,{"g":"to be"},{"g":"here"}]},{"text":"É sempre um prazer te ver.","en":"It's always a pleasure to see you.","words":[{"g":"is","l":"ser"},{"g":"always"},{"g":"a"},null,{"g":"you"},{"g":"to see"}]}]}