{"id":"prazer","lemma":"prazer","pos":"noun","rank":348,"glosses":["pleasure","nice to meet you (muito prazer)"],"ipa":"/pɾaˈzeʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/LL-Q5146_%28por%29-Santamarcanda-prazer.wav/LL-Q5146_%28por%29-Santamarcanda-prazer.wav.mp3","gender":"m","forms":{"plural":"prazeres"},"examples":[{"text":"Será um prazer.","en":"It'll be a pleasure.","words":[{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"O prazer é todo meu.","en":"The pleasure's mine.","audio":"https://tatoeba.org/en/audio/download/762206","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"every"},{"g":"my, mine"}]},{"text":"Ler é um dos prazeres da vida.","en":"Reading is one of life's great pleasures.","words":[{"g":"to read"},{"g":"is","l":"ser"},{"g":"a"},null,null,null,null],"phrases":[[5,7,"extremely"]]},{"text":"Eu vou ajudar você com prazer.","en":"I will gladly help you.","audio":"https://tatoeba.org/en/audio/download/533774","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"to help, aid"},{"g":"you"},{"g":"with"},null]},{"text":"É um prazer comer com você.","en":"Eating with you is a pleasure.","words":[{"g":"is","l":"ser"},{"g":"a"},null,{"g":"to consume meals"},{"g":"with"},{"g":"you"}]}]}