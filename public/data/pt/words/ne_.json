{"id":"ne_","lemma":"né","pos":"other","rank":622,"glosses":["Expresses that something is obvious; commonly spoken with emphasis; duh; obviously"],"ipa":"/ˈnɛ/","examples":[{"text":"Você já sabe, né?","en":"You already know, don't you?","audio":"https://tatoeba.org/en/audio/download/1270605","words":[{"g":"you"},{"g":"already"},{"g":"to be aware, to know","l":"saber"},null]},{"text":"Tom vai comprar aquilo, né?","en":"Tom will buy that, right?","audio":"https://tatoeba.org/en/audio/download/1271233","words":[{"g":"tone"},{"g":"to go","l":"ir"},{"g":"to buy"},{"g":"that over there, yon","l":"aquele"},null]},{"text":"Você sabe quem eu sou, né?","en":"You know who I am, don't you?","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},{"g":"who"},{"g":"I"},{"g":"am","l":"ser"},null]},{"text":"Tom está com fome, né?","en":"Tom is hungry, isn't he?","audio":"https://tatoeba.org/en/audio/download/1270884","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"with"},{"g":"hunger"},null]},{"text":"Isso é tudo, né?","en":"That's everything, right?","words":[{"g":"that"},{"g":"is","l":"ser"},{"g":"everything"},null]}]}