{"id":"ne_","lemma":"né","pos":"other","rank":3470,"glosses":["Expresses that something is obvious; commonly spoken with emphasis; duh; obviously"],"ipa":"/ˈnɛ/","examples":[{"text":"Tom vai comprar aquilo, né?","en":"Tom will buy that, right?","audio":"https://tatoeba.org/en/audio/download/1271233","words":[{"g":"tone"},{"g":"to go","l":"ir"},{"g":"to buy"},{"g":"that over there, yon","l":"aquele"},null]},{"text":"Tom está com fome, né?","en":"Tom is hungry, isn't he?","audio":"https://tatoeba.org/en/audio/download/1270884","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"with"},{"g":"hunger"},null]},{"text":"Isso é tudo, né?","en":"That's everything, right?","words":[{"g":"that"},{"g":"is","l":"ser"},{"g":"everything"},null]},{"text":"Você já sabe, né?","en":"You already know, don't you?","audio":"https://tatoeba.org/en/audio/download/1270605","words":[{"g":"you (formal)"},{"g":"already"},{"g":"to be aware, to know","l":"saber"},null]},{"text":"O francês é difícil, né?","en":"French is difficult, isn't it?","words":[{"g":"the / it"},{"g":"French"},{"g":"is","l":"ser"},{"g":"difficult"},null]}]}