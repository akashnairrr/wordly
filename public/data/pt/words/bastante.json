{"id":"bastante","lemma":"bastante","pos":"adv","rank":369,"glosses":["enough; sufficiently","rather; fairly; quite"],"ipa":"/bɐʃˈtɐ̃.tɨ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/71/LL-Q5146_%28por%29-Santamarcanda-bastante.wav/LL-Q5146_%28por%29-Santamarcanda-bastante.wav.mp3","examples":[{"text":"É grande o bastante?","en":"Is it large enough?","words":[{"g":"is","l":"ser"},{"g":"large"},{"g":"the / it"},null]},{"text":"Não tenho bastante tempo.","en":"I don't have enough time.","audio":"https://tatoeba.org/en/audio/download/840468","words":[{"g":"not / no"},{"g":"have","l":"ter"},null,{"g":"time"}]},{"text":"Tu sabes bastante.","en":"You know enough.","audio":"https://tatoeba.org/en/audio/download/844099","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},null]},{"text":"Estou bastante feliz.","en":"I'm happy enough.","audio":"https://tatoeba.org/en/audio/download/493433","words":[{"g":"am","l":"estar"},null,{"g":"happy"}]},{"text":"Isso ajuda bastante.","en":"That's quite helpful.","audio":"https://tatoeba.org/en/audio/download/1186210","words":[{"g":"that"},{"g":"help, assistance, aid"},null]}]}