{"id":"luz","lemma":"luz","pos":"noun","rank":401,"glosses":["light (medium within which vision is possible)","light; light source (object that emits light)","light; enlightenment (knowledge about things as they really are)"],"ipa":"/ˈluʃ/","gender":"f","forms":{"plural":"luzes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q5146_%28por%29-Nelson_Ricardo_2500-luz.wav","formAudio":{"luzes":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q5146_%28por%29-Nelson_Ricardo_2500-luzes.wav"},"examples":[{"text":"Vejo uma luz.","en":"I see a light.","audio":"https://tatoeba.org/en/audio/download/87643","words":[{"g":"to see","l":"ver"},{"g":"a","l":"um"},null]},{"text":"Não há luzes.","en":"There're no lights.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null]},{"text":"Não havia luz.","en":"There was no light.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null]},{"text":"Eu posso ver a luz.","en":"I can see the light.","audio":"https://tatoeba.org/en/audio/download/46677","words":[{"g":"I"},{"g":"to be able to","l":"poder"},{"g":"to see"},{"g":"the / to"},null]},{"text":"Posso desligar as luzes?","en":"May I turn off the lights?","words":[{"g":"to be able to","l":"poder"},{"g":"to hang up"},{"g":"the"},null]}]}