{"id":"curta","lemma":"curta","pos":"noun","rank":2154,"glosses":["short (film of length shorter than a feature film)"],"ipa":"/ˈkuʁ.tɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/LL-Q5146_%28por%29-Santamarcanda-curta.wav/LL-Q5146_%28por%29-Santamarcanda-curta.wav.mp3","forms":{"plural":"curtas"},"examples":[{"text":"A resposta curta é sim.","en":"The short answer is yes.","words":[{"g":"the / to"},{"g":"answer, response"},null,{"g":"is","l":"ser"},{"g":"yes"}]},{"text":"Essa saia não é muito curta?","en":"Isn't that skirt too short?","words":[{"g":"that, that one","l":"esse"},{"g":"to exit","l":"sair"},null,null,{"g":"very / a lot"},null],"phrases":[[2,4,"isn't it"]]},{"text":"Esta camisa é muito curta para mim.","en":"This shirt is too small for me to wear.","words":[{"g":"this","l":"este"},{"g":"shirt"},{"g":"is","l":"ser"},{"g":"very / a lot"},null,{"g":"for / to"},{"g":"me"}]},{"text":"As pessoas têm memória curta.","en":"People have short memories.","words":[{"g":"the"},{"g":"person","l":"pessoa"},{"g":"to own","l":"ter"},{"g":"memory"},null]},{"text":"Dez milhas não é uma curta distância.","en":"Ten miles is not a short distance.","words":[{"g":"awesome, amazing"},{"g":"milha","l":"milha"},null,null,{"g":"a","l":"um"},null,{"g":"distance"}],"phrases":[[2,4,"isn't it"]]}]}