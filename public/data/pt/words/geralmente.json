{"id":"geralmente","lemma":"geralmente","pos":"adv","rank":1333,"glosses":["generally, usually"],"ipa":"/ʒeˌɾawˈmẽ.t͡ʃi/","examples":[{"text":"Eu geralmente o vejo.","en":"I often see him.","audio":"https://tatoeba.org/en/audio/download/490875","words":[{"g":"I"},null,{"g":"the / it"},{"g":"to see","l":"ver"}]},{"text":"É assim que geralmente acontece.","en":"That's the way it usually happens.","words":[{"g":"is","l":"ser"},null,null,null,{"g":"to happen","l":"acontecer"}],"phrases":[[1,3,"as soon as"]]},{"text":"Geralmente vou para cama às nove.","en":"I usually go to bed at nine.","words":[null,{"g":"to go","l":"ir"},{"g":"for / to"},{"g":"bed"},null,{"g":"nine"}]},{"text":"A que horas você geralmente sai?","en":"What time do you usually leave?","words":[{"g":"the / to"},{"g":"that / what"},{"g":"hour","l":"hora"},{"g":"you"},null,{"g":"to exit","l":"sair"}]},{"text":"Eu geralmente não faço isso.","en":"I don't usually do that.","words":[{"g":"I"},null,{"g":"not / no"},{"g":"to create","l":"fazer"},{"g":"that"}]}]}