{"id":"suprimento","lemma":"suprimento","pos":"noun","rank":2927,"glosses":["supply, provision"],"ipa":"/su.pɾiˈmẽ.tu/","gender":"m","forms":{"plural":"suprimentos"},"examples":[{"text":"Preciso de mais suprimentos.","en":"I need more supplies.","audio":"https://tatoeba.org/en/audio/download/535846","words":[{"g":"precise"},{"g":"of / from"},{"g":"more"},null]},{"text":"Precisamos pegar alguns suprimentos médicos.","en":"We need to get some medical supplies.","words":[{"g":"to need","l":"precisar"},{"g":"to grab, hold"},{"g":"some, any","l":"algum"},null,{"g":"consulting room","l":"médico"}]},{"text":"O suprimento de alimentos no forte estava muito baixo.","en":"Food supplies at the fort were very low.","words":[{"g":"the / it"},null,{"g":"of / from"},{"g":"food , foodstuff","l":"alimento"},{"g":"in the"},{"g":"capable of producing…"},{"g":"to be","l":"estar"},{"g":"very / a lot"},{"g":"bass"}]},{"text":"O cérebro precisa de um suprimento contínuo de sangue.","en":"The brain needs a continuous supply of blood.","words":[{"g":"the / it"},{"g":"brain, cerebrum"},{"g":"precise","l":"preciso"},{"g":"of / from"},{"g":"a"},null,{"g":"something that is…"},{"g":"of / from"},{"g":"blood"}]},{"text":"Os suprimentos médicos estão acabando.","en":"Medical supplies are running out.","words":[{"g":"the"},null,{"g":"consulting room","l":"médico"},{"g":"to be","l":"estar"},{"g":"to finish","l":"acabar"}]}]}