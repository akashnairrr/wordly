{"id":"computador","lemma":"computador","pos":"adj","rank":809,"glosses":["computing (which performs computations)"],"ipa":"/kõ.pu.taˈdoʁ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c0/LL-Q5146_%28por%29-Santamarcanda-computador.wav/LL-Q5146_%28por%29-Santamarcanda-computador.wav.mp3","forms":{"feminine":"computadora","masculinePlural":"computadores","femininePlural":"computadoras"},"examples":[{"text":"Eu odeio o meu computador.","en":"I hate my computer.","audio":"https://tatoeba.org/en/audio/download/493750","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},{"g":"the / it"},{"g":"my, mine"},null]},{"text":"Eu tenho três computadores.","en":"I have three computers.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"three"},null]},{"text":"Quero um computador.","en":"I want a computer.","words":[{"g":"to want","l":"querer"},{"g":"a"},null]},{"text":"Não havia computadores no escritório.","en":"There were no computers in the office.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null,{"g":"in the"},{"g":"office"}]},{"text":"Você sabe usar um computador?","en":"Can you use a computer?","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},{"g":"to use"},{"g":"a"},null]}]}