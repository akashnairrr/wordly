{"id":"milha","lemma":"milha","pos":"noun","rank":1898,"glosses":["milha, Portuguese mile, a traditional unit of distance equivalent to about 1481.5, 1851.9, or 2057.6 m depending on the number of equatorial degrees per league","English or American mile, a unit of distance equivalent to about 1.61 km"],"ipa":"/ˈmi.ʎɐ/","gender":"f","forms":{"plural":"milhas"},"examples":[{"text":"A cidade está a duas milhas.","en":"The city is two miles away.","words":[{"g":"the / to"},{"g":"city, town"},{"g":"is","l":"estar"},{"g":"the / to"},{"g":"deuce","l":"dois"},null]},{"text":"Ele pode nadar uma milha.","en":"He can swim a mile.","words":[{"g":"he"},{"g":"to be able to","l":"poder"},{"g":"to swim"},{"g":"a","l":"um"},null]},{"text":"Ele correu cinco milhas.","en":"He ran five miles.","words":[{"g":"he"},{"g":"to run","l":"correr"},{"g":"five"},null]},{"text":"Andamos três milhas.","en":"We walked three miles.","audio":"https://tatoeba.org/en/audio/download/1274094","words":[{"g":"to walk","l":"andar"},{"g":"three"},null]},{"text":"Tom correu três milhas hoje.","en":"Tom ran three miles today.","words":[{"g":"tone"},{"g":"to run","l":"correr"},{"g":"three"},null,{"g":"today"}]}]}