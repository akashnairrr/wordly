{"id":"la_grima","lemma":"lágrima","pos":"noun","rank":1699,"glosses":["tear, teardrop"],"ipa":"/ˈla.ɡɾi.mɐ/","gender":"f","forms":{"plural":"lágrimas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q5146_%28por%29-Nelson_Ricardo_2500-l%C3%A1grima.wav","examples":[{"text":"Minha mãe estava em lágrimas.","en":"My mother was in tears.","words":[{"g":"my, mine","l":"meu"},{"g":"mother"},{"g":"to be","l":"estar"},{"g":"in"},null]},{"text":"Eu vejo lágrimas nos seus olhos.","en":"I see tears in your eyes.","words":[{"g":"I"},{"g":"to see","l":"ver"},null,{"g":"us","l":"nós"},{"g":"their or your kin"},{"g":"eye","l":"olho"}]},{"text":"Tom tentou esconder suas lágrimas.","en":"Tom tried to hide his tears.","words":[{"g":"tone"},{"g":"to try","l":"tentar"},{"g":"to hide"},{"g":"his","l":"seu"},null]},{"text":"Ela respondeu em lágrimas.","en":"She answered in tears.","words":[{"g":"she"},{"g":"to answer","l":"responder"},{"g":"in"},null]},{"text":"As palavras dele a levaram às lágrimas.","en":"His words moved her to tears.","words":[{"g":"the"},{"g":"unit of language","l":"palavra"},{"g":"to destroy, erase","l":"delir"},{"g":"the / to"},null,null,null]}]}