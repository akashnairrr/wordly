{"id":"mosca","lemma":"mosca","pos":"noun","rank":3218,"glosses":["fly (various insects in the order Diptera)","soul patch (narrow beard)","bullseye (centre of a target)"],"ipa":"/ˈmos.kɐ/","gender":"f","forms":{"plural":"moscas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q5146_%28por%29-Nelson_Ricardo_2500-mosca.wav","examples":[{"text":"Há uma mosca no café.","en":"There is a fly in the coffee.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"in the"},{"g":"coffee"}]},{"text":"Em boca fechada não entra mosca.","en":"A fly does not fly into a shut mouth.","words":[{"g":"in"},{"g":"mouth"},{"g":"closed, shut","l":"fechado"},{"g":"not / no"},{"g":"to enter","l":"entrar"},null]},{"text":"Eu vi uma mosca no teto.","en":"I saw a fly on the ceiling.","words":[{"g":"I"},{"g":"to see","l":"ver"},{"g":"a","l":"um"},null,{"g":"in the"},{"g":"ceiling"}]},{"text":"Ele acertou na mosca.","en":"He hit the bull's-eye.","words":[{"g":"he"},{"g":"to hit","l":"acertar"},{"g":"in the"},null]},{"text":"Ele não machucaria nem uma mosca.","en":"He wouldn't harm a fly.","words":[{"g":"he"},{"g":"not / no"},{"g":"to hurt","l":"machucar"},{"g":"nor"},{"g":"a","l":"um"},null]}]}