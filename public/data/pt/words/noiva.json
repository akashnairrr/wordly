{"id":"noiva","lemma":"noiva","pos":"noun","rank":1088,"glosses":["bride (female equivalent of noivo)","fiancée (an engaged woman about to marry)"],"ipa":"/ˈnoj.vɐ/","gender":"f","forms":{"plural":"noivas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q5146_%28por%29-Nelson_Ricardo_2500-noiva.wav","examples":[{"text":"Vocês conhecem os pais da noiva?","en":"Do you know the bride's parents?","words":[{"g":"you (pl.)"},{"g":"to know","l":"conhecer"},{"g":"the"},{"g":"parents"},{"g":"of the"},null]},{"text":"Eu não conheço a noiva.","en":"I don't know the bride.","audio":"https://tatoeba.org/en/audio/download/535726","words":[{"g":"I"},{"g":"not / no"},{"g":"to know","l":"conhecer"},{"g":"the / to"},null]},{"text":"Onde está a sua noiva?","en":"Where is your fiancée?","words":[{"g":"where"},{"g":"is","l":"estar"},{"g":"the / to"},{"g":"his","l":"seu"},null]},{"text":"Minha irmã ficou noiva dele.","en":"My sister is engaged to him.","words":[{"g":"my, mine","l":"meu"},{"g":"sister"},{"g":"to become","l":"ficar"},null,{"g":"his / of him","l":"delir"}]},{"text":"A noiva parecia muito bonita.","en":"The bride looked very beautiful.","words":[{"g":"the / to"},null,{"g":"to seem","l":"parecer"},{"g":"very / a lot"},{"g":"pretty, lovely","l":"bonito"}]}]}