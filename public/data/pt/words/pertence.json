{"id":"pertence","lemma":"pertence","pos":"noun","rank":1155,"glosses":["belonging (something physical that is owned)"],"ipa":"/peʁˈtẽ.si/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3a/LL-Q5146_%28por%29-Santamarcanda-pertence.wav/LL-Q5146_%28por%29-Santamarcanda-pertence.wav.mp3","gender":"m","forms":{"plural":"pertences"},"examples":[{"text":"Aquela casa me pertence.","en":"That house belongs to me.","audio":"https://tatoeba.org/en/audio/download/66703","words":[{"g":"that over there, yon","l":"aquele"},{"g":"house, home"},{"g":"me"},null]},{"text":"A casa pertence a ele.","en":"The house belongs to him.","audio":"https://tatoeba.org/en/audio/download/1270352","words":[{"g":"the / to"},{"g":"house, home"},null,{"g":"the / to"},{"g":"he"}]},{"text":"Este livro te pertence.","en":"This book belongs to you.","words":[{"g":"this"},{"g":"book"},{"g":"you"},null]},{"text":"Isso pertence ao meu irmão.","en":"That belongs to my brother.","words":[{"g":"that"},null,null,null,null],"phrases":[[3,5,"bro, dude"]]},{"text":"Esta casa pertence ao meu tio.","en":"This house belongs to my uncle.","words":[{"g":"this","l":"este"},{"g":"house, home"},null,null,{"g":"my, mine"},{"g":"uncle"}]}]}