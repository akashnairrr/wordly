{"id":"marrom","lemma":"marrom","pos":"adj","rank":3214,"glosses":["brown"],"ipa":"/maˈʁõ/","forms":{"plural":"marrons"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q5146_%28por%29-Nelson_Ricardo_2500-marrom.wav","examples":[{"text":"Meu cabelo é marrom.","en":"My hair is brown.","words":[{"g":"my, mine"},{"g":"hair, head of hair"},{"g":"is","l":"ser"},null]},{"text":"O gato é marrom.","en":"The cat is brown.","words":[{"g":"the / it"},{"g":"cat"},{"g":"is","l":"ser"},null]},{"text":"Vi um menino usando sapatos marrons.","en":"I saw a boy wearing brown shoes.","words":[{"g":"to see","l":"ver"},{"g":"a"},{"g":"boy"},{"g":"to use","l":"usar"},{"g":"shoe","l":"sapato"},null]},{"text":"O chapéu marrom está velho.","en":"The brown hat is old.","words":[{"g":"the / it"},{"g":"hat"},null,{"g":"is","l":"estar"},{"g":"old"}]},{"text":"Eu gosto da cor marrom.","en":"I like the color brown.","words":[{"g":"I"},{"g":"taste"},{"g":"of the"},{"g":"colour , color"},null]}]}