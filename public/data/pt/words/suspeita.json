{"id":"suspeita","lemma":"suspeita","pos":"noun","rank":1977,"glosses":["suspicion"],"ipa":"/suʃˈpɐj.tɐ/","gender":"f","forms":{"plural":"suspeitas"},"examples":[{"text":"De quem você suspeita?","en":"Who do you suspect?","audio":"https://tatoeba.org/en/audio/download/1271302","words":[{"g":"of / from"},{"g":"who"},{"g":"you (formal)"},null]},{"text":"Tom não suspeita de nada.","en":"Tom suspects nothing.","audio":"https://tatoeba.org/en/audio/download/535057","words":[{"g":"tone"},{"g":"not / no"},null,null,null],"phrases":[[3,5,"it's nothing"]]},{"text":"Eu também estou sob suspeita.","en":"I'm under suspicion, too.","audio":"https://tatoeba.org/en/audio/download/1270663","words":[{"g":"I"},{"g":"also"},{"g":"am","l":"estar"},{"g":"under"},null]},{"text":"A polícia suspeita que foi um assassinato.","en":"The police suspect it was a murder.","words":[{"g":"the / to"},{"g":"police"},null,null,null,{"g":"a"},{"g":"murder"}],"phrases":[[3,5,"what's the matter?"]]},{"text":"Eu sei que a polícia suspeita de mim.","en":"I know that the police suspect me.","words":[{"g":"I"},{"g":"to be aware, to know","l":"saber"},{"g":"that / what"},{"g":"the / to"},{"g":"police"},null,{"g":"of / from"},{"g":"me"}]}]}