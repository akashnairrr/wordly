{"id":"quintal","lemma":"quintal","pos":"noun","rank":2518,"glosses":["yard (land with vegetable garden, next to a house)","small farm","courtyard"],"ipa":"/kĩˈtaw/","gender":"m","forms":{"plural":"quintais"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/60/LL-Q5146_%28por%29-Ed_Guimaraes-quintal.wav","examples":[{"text":"Tom está brincando no quintal.","en":"Tom is playing in the yard.","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"to play","l":"brincar"},{"g":"in the"},null]},{"text":"Há três árvores no quintal.","en":"There are three trees in the yard.","words":[{"g":"there be","l":"haver"},{"g":"three"},{"g":"tree","l":"árvore"},{"g":"in the"},null]},{"text":"Tem alguém no quintal.","en":"There's someone in the backyard.","words":[{"g":"has / there is","l":"ter"},{"g":"somebody"},{"g":"in the"},null]},{"text":"Há uma árvore no meu quintal.","en":"There is a tree in my backyard.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},{"g":"tree"},{"g":"in the"},{"g":"my, mine"},null]},{"text":"As crianças estavam brincando no quintal.","en":"The children were playing in the backyard.","words":[{"g":"the"},{"g":"child","l":"criança"},{"g":"to be","l":"estar"},{"g":"to play","l":"brincar"},{"g":"in the"},null]}]}