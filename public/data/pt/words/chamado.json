{"id":"chamado","lemma":"chamado","pos":"noun","rank":564,"glosses":["calling"],"ipa":"/ʃɐˈma.du/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cf/LL-Q5146_%28por%29-Santamarcanda-chamado.wav/LL-Q5146_%28por%29-Santamarcanda-chamado.wav.mp3","gender":"m","forms":{"plural":"chamados"},"examples":[{"text":"Desculpe ter te chamado tão cedo.","en":"Sorry for calling you so early.","words":[{"g":"to forgive","l":"desculpar"},{"g":"to own"},{"g":"you"},null,{"g":"so"},{"g":"early (at a time before…"}]},{"text":"Tom deveria ter chamado a polícia.","en":"Tom should've called the police.","words":[{"g":"tone"},{"g":"should","l":"dever"},{"g":"to own"},null,{"g":"the / to"},{"g":"police"}]},{"text":"Ouvi meu nome ser chamado por alguém.","en":"I heard my name being called by someone.","words":[{"g":"to hear","l":"ouvir"},{"g":"my, mine"},{"g":"name"},{"g":"to be"},null,{"g":"for / by"},{"g":"somebody"}]},{"text":"Ele ouviu um chamado de socorro.","en":"He heard a cry for help.","words":[{"g":"he"},{"g":"to hear","l":"ouvir"},{"g":"a"},null,{"g":"of / from"},{"g":"help!"}]},{"text":"Todos aqui são chamados de Tom.","en":"Everyone here is named Tom.","words":[{"g":"everyone"},{"g":"here"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"tone"}]}]}