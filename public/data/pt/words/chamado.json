{"id":"chamado","lemma":"chamado","pos":"noun","rank":476,"glosses":["calling"],"ipa":"/ʃaˈma.du/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cf/LL-Q5146_%28por%29-Santamarcanda-chamado.wav/LL-Q5146_%28por%29-Santamarcanda-chamado.wav.mp3","gender":"m","forms":{"plural":"chamados"},"examples":[{"text":"Você deveria ter chamado a polícia.","en":"You should've called the cops.","words":[{"g":"you"},{"g":"should","l":"dever"},{"g":"to own"},null,{"g":"the / to"},{"g":"police"}]},{"text":"Desculpe ter te chamado tão cedo.","en":"Sorry for calling you so early.","words":[{"g":"to forgive","l":"desculpar"},{"g":"to own"},{"g":"you"},null,{"g":"so"},{"g":"early (at a time before…"}]},{"text":"Ouvi meu nome ser chamado por alguém.","en":"I heard my name being called by someone.","words":[{"g":"to hear","l":"ouvir"},{"g":"my, mine"},{"g":"name"},{"g":"to be"},null,{"g":"for / by"},{"g":"somebody"}]},{"text":"Ele ouviu um chamado de socorro.","en":"He heard a cry for help.","words":[{"g":"he"},{"g":"to hear","l":"ouvir"},{"g":"a"},null,{"g":"of / from"},{"g":"help!"}]},{"text":"Conheço três caras chamados Tom.","en":"I know three guys named Tom.","words":[{"g":"to know","l":"conhecer"},{"g":"three"},{"g":"greatly valued","l":"caro"},null,{"g":"tone"}]}]}