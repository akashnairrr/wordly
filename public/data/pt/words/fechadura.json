{"id":"fechadura","lemma":"fechadura","pos":"noun","rank":3685,"glosses":["lock (of a door)"],"ipa":"/fe.ʃaˈdu.ɾɐ/","gender":"f","forms":{"plural":"fechaduras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q5146_%28por%29-Ed_Guimaraes-fechadura.wav","examples":[{"text":"Ele pôs a chave na fechadura.","en":"He put the key in the lock.","words":[{"g":"he"},{"g":"to put","l":"pôr"},{"g":"the / to"},{"g":"key"},{"g":"in the"},null]},{"text":"Esta chave não cabe na fechadura.","en":"This key doesn't fit in the lock.","words":[{"g":"this","l":"este"},{"g":"key"},{"g":"not / no"},{"g":"to fit","l":"caber"},{"g":"in the"},null]},{"text":"Troquei a fechadura de minha porta.","en":"I changed the lock on my door.","words":[{"g":"to replace","l":"trocar"},{"g":"the / to"},null,{"g":"of / from"},{"g":"my, mine","l":"meu"},{"g":"door"}]},{"text":"Não olhe pelo buraco da fechadura.","en":"Don't look through the keyhole.","words":[{"g":"not / no"},{"g":"gaze","l":"olhar"},{"g":"hair"},{"g":"pit"},{"g":"of the"},null]},{"text":"Tom consertou a fechadura.","en":"Tom fixed the lock.","words":[{"g":"tone"},{"g":"to fix, to repair","l":"consertar"},{"g":"the / to"},null]}]}