{"id":"multida_o","lemma":"multidão","pos":"noun","rank":1913,"glosses":["crowd (a group of people)","multitude, heap (a great number or large quantity of things)"],"ipa":"/muw.t͡ʃiˈdɐ̃w̃/","gender":"f","forms":{"plural":"multidões"},"examples":[{"text":"Eu odeio multidões.","en":"I hate crowds.","audio":"https://tatoeba.org/en/audio/download/489906","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Ele desapareceu na multidão.","en":"He disappeared into the crowd.","words":[{"g":"he"},{"g":"to disappear","l":"desaparecer"},{"g":"in the"},null]},{"text":"Havia uma multidão no parque.","en":"There was a large crowd in the park.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"in the"},{"g":"park"}]},{"text":"Tom gosta de evitar grandes multidões.","en":"Tom likes to avoid large crowds.","words":[{"g":"tone"},{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"to avoid"},{"g":"large","l":"grande"},null]},{"text":"A multidão ainda está gritando.","en":"The crowd is still yelling.","words":[{"g":"the / to"},null,{"g":"still"},{"g":"is","l":"estar"},{"g":"to shout","l":"gritar"}]}]}