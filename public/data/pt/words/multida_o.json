{"id":"multida_o","lemma":"multidão","pos":"noun","rank":2002,"glosses":["crowd (a group of people)","multitude, heap (a great number or large quantity of things)"],"ipa":"/mul.tiˈdɐ̃w̃/","gender":"f","forms":{"plural":"multidões"},"examples":[{"text":"Ele desapareceu na multidão.","en":"He disappeared into the crowd.","words":[{"g":"he"},{"g":"to disappear","l":"desaparecer"},{"g":"in the"},null]},{"text":"Eu odeio multidões.","en":"I hate crowds.","audio":"https://tatoeba.org/en/audio/download/489906","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Havia uma multidão no parque.","en":"There was a large crowd in the park.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"in the"},{"g":"park"}]},{"text":"Tom gosta de evitar grandes multidões.","en":"Tom likes to avoid large crowds.","words":[{"g":"tone"},{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"to avoid"},{"g":"large","l":"grande"},null]},{"text":"Não importa se há uma multidão.","en":"It doesn't matter if there's a crowd.","words":[null,null,{"g":"if / oneself"},{"g":"there be","l":"haver"},{"g":"a","l":"um"},null],"phrases":[[0,2,"no matter"]]}]}