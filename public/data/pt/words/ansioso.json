{"id":"ansioso","lemma":"ansioso","pos":"adj","rank":1881,"glosses":["anxious","eager"],"ipa":"/ɐ̃ˈsjo.zu/","forms":{"feminine":"ansiosa","masculinePlural":"ansiosos","femininePlural":"ansiosas"},"examples":[{"text":"Ele está ansioso para te ver.","en":"He is anxious to see you.","words":[{"g":"he"},{"g":"is","l":"estar"},null,{"g":"for / to"},{"g":"you"},{"g":"to see"}]},{"text":"Eles estão ansiosos por vossa ajuda.","en":"They are anxious for your help.","words":[{"g":"they"},{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"yours","l":"vosso"},{"g":"help, assistance, aid"}]},{"text":"Tom parece estar um pouco ansioso.","en":"Tom seems to be a little anxious.","words":[{"g":"tone"},{"g":"to seem","l":"parecer"},{"g":"to be"},null,null,null],"phrases":[[3,5,"slightly"]]},{"text":"Eu estava ansiosa.","en":"I was anxious.","words":[{"g":"I"},{"g":"to be","l":"estar"},null]},{"text":"Tom está ansioso, não está?","en":"Tom is anxious, isn't he?","words":[{"g":"tone"},{"g":"is","l":"estar"},null,{"g":"not / no"},{"g":"is","l":"estar"}]}]}