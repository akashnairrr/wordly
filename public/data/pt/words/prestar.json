ion to the teacher.","words":[{"g":"he"},{"g":"not / no"},null,{"g":"attention"},null,{"g":"teacher"}]},{"text":"Agora prestem atenção, crianças.","en":"Now pay attention, children.","words":[{"g":"now"},null,{"g":"attention"},{"g":"child","l":"criança"}]},{"text":"Todo mundo parecia estar prestando atenção.","en":"Everybody seemed to be paying attention.","words":[null,null,{"g":"to seem","l":"parecer"},{"g":"to be"},null,{"g":"attention"}],"phrases":[[0,2,"everyone"]]}]}