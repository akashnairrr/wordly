{"id":"muro","lemma":"muro","pos":"noun","rank":2571,"glosses":["wall (outdoors)"],"ipa":"/ˈmu.ɾu/","gender":"m","forms":{"plural":"muros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q5146_%28por%29-MedK1-muro.wav","examples":[{"text":"O que há atrás do muro?","en":"What's behind the wall?","words":[null,null,{"g":"there be","l":"haver"},{"g":"behind"},{"g":"of the"},null],"phrases":[[0,2,"what"]]},{"text":"Ele está parado atrás do muro.","en":"He's standing behind the wall.","words":[{"g":"he"},{"g":"is","l":"estar"},{"g":"stopped"},{"g":"behind"},{"g":"of the"},null]},{"text":"Devemos construir pontes, não muros.","en":"We should build bridges, not walls.","words":[{"g":"should","l":"dever"},{"g":"to build"},{"g":"bridge","l":"ponte"},{"g":"not / no"},null]},{"text":"Há um grande buraco no muro.","en":"There's a huge hole in the wall.","words":[{"g":"there be","l":"haver"},{"g":"a"},{"g":"large"},{"g":"pit"},{"g":"in the"},null]},{"text":"O carro bateu no muro.","en":"The car crashed into the wall.","words":[{"g":"the / it"},{"g":"cart"},{"g":"to beat","l":"bater"},{"g":"in the"},null]}]}