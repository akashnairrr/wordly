{"id":"mandado","lemma":"mandado","pos":"noun","rank":1301,"glosses":["mandate (official order given by a superior)","warrant (judicial writ)"],"ipa":"/mɐ̃ˈda.du/","gender":"m","forms":{"plural":"mandados"},"examples":[{"text":"Temos um mandado de busca.","en":"We have a search warrant.","audio":"https://tatoeba.org/en/audio/download/1274183","words":[{"g":"to own","l":"ter"},{"g":"a"},null,{"g":"of / from"},{"g":"searching"}]},{"text":"Ele foi mandado à prisão.","en":"He was sent to prison.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"to the"},{"g":"prison"}]},{"text":"Você tem mandado?","en":"Do you have a warrant?","words":[{"g":"you (formal)"},{"g":"has / there is","l":"ter"},null]},{"text":"Tom não foi mandado embora.","en":"Tom wasn't told not to leave.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to be","l":"ser"},null,{"g":"although"}]},{"text":"Eu fui mandado para casa.","en":"I was sent home.","words":[{"g":"I"},{"g":"to go","l":"ir"},null,null,null],"phrases":[[3,5,"home"]]}]}