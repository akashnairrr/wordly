{"id":"jaula","lemma":"jaula","pos":"noun","rank":3090,"glosses":["cage (enclosure)"],"ipa":"/ˈʒaw.lɐ/","gender":"f","forms":{"plural":"jaulas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q5146_%28por%29-MedK1-jaula.wav","examples":[{"text":"O macaco está na jaula.","en":"The monkey is in the cage.","words":[{"g":"the / it"},{"g":"monkey"},{"g":"is","l":"estar"},{"g":"in the"},null]},{"text":"A jaula está aberta.","en":"The cage is open.","words":[{"g":"the / to"},null,{"g":"is","l":"estar"},{"g":"a sunny spell"}]},{"text":"Os leões rugiam em suas jaulas.","en":"The lions roared in their cages.","words":[{"g":"the"},{"g":"lion","l":"leão"},null,{"g":"in"},{"g":"his","l":"seu"},null]},{"text":"Esta jaula é feita de arame.","en":"This cage is made of wire.","words":[{"g":"this","l":"este"},null,{"g":"is","l":"ser"},{"g":"like","l":"feito"},{"g":"of / from"},{"g":"wire"}]},{"text":"O mundo é como uma jaula de loucos.","en":"The world is a madhouse.","words":[{"g":"the / it"},{"g":"world"},{"g":"is","l":"ser"},{"g":"how / like"},{"g":"a","l":"um"},null,{"g":"of / from"},{"g":"crazy, mad, insane","l":"louco"}]}]}