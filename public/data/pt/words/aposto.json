{"id":"aposto","lemma":"aposto","pos":"adj","rank":625,"glosses":["apposed (placed next or near to)","apposed (placed side by side)"],"ipa":"/aˈpos.tu/","forms":{"feminine":"aposta","masculinePlural":"apostos","femininePlural":"apostas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q5146_%28por%29-Nelson_Ricardo_2500-aposto.wav","examples":[{"text":"Aposto que você sabe disso.","en":"I bet you know this.","audio":"https://tatoeba.org/en/audio/download/494807","words":[null,{"g":"that / what"},{"g":"you"},{"g":"to be aware, to know","l":"saber"},null]},{"text":"Eu aposto que você fala francês.","en":"I bet you know French.","audio":"https://tatoeba.org/en/audio/download/471572","words":[{"g":"I"},null,{"g":"that / what"},{"g":"you"},{"g":"speech"},{"g":"French"}]},{"text":"Aposto que todo mundo está esperando.","en":"I bet everyone is waiting.","words":[null,{"g":"that / what"},null,null,{"g":"is","l":"estar"},{"g":"to wait","l":"esperar"}],"phrases":[[2,4,"everyone"]]},{"text":"Aposto que é um ótimo professor.","en":"I bet you're a great teacher.","words":[null,{"g":"that / what"},{"g":"is","l":"ser"},{"g":"a"},{"g":"great"},{"g":"teacher"}]},{"text":"Aposto que não sabe a resposta.","en":"I bet you don't know the answer.","words":[null,{"g":"that / what"},{"g":"not / no"},{"g":"to be aware, to know","l":"saber"},{"g":"the / to"},{"g":"answer, response"}]}]}