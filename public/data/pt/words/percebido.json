{"id":"percebido","lemma":"percebido","pos":"adj","rank":1693,"glosses":["perceived"],"ipa":"/pɨɾ.sɨˈbi.du/","forms":{"feminine":"percebida","masculinePlural":"percebidos","femininePlural":"percebidas"},"examples":[{"text":"Tom parecia ter percebido.","en":"Tom seemed to have figured it out.","words":[{"g":"tone"},{"g":"to seem","l":"parecer"},{"g":"to own"},null]},{"text":"Caso não tenha percebido, estou ocupado.","en":"In case you haven't noticed, I'm busy.","words":[{"g":"an actual event"},{"g":"not / no"},{"g":"to own","l":"ter"},null,{"g":"am","l":"estar"},{"g":"busy"}]},{"text":"Eu nem sequer tinha percebido.","en":"I hadn't even noticed.","words":[{"g":"I"},null,null,{"g":"to own","l":"ter"},null],"phrases":[[1,3,"not even"]]},{"text":"Espero que Tom não tenha percebido.","en":"I hope Tom didn't notice.","words":[{"g":"to wait","l":"esperar"},{"g":"that / what"},{"g":"tone"},{"g":"not / no"},{"g":"to own","l":"ter"},null]},{"text":"Tom não tinha percebido que a sua vida estava em perigo.","en":"Tom didn't realize his life was in danger.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to own","l":"ter"},null,{"g":"that / what"},{"g":"the / to"},{"g":"his","l":"seu"},{"g":"state of being alive"},{"g":"to be","l":"estar"},{"g":"in"},{"g":"danger"}]}]}