{"id":"praticamente","lemma":"praticamente","pos":"adv","rank":1541,"glosses":["practically (in practice; in effect)","practically (almost entirely)","practically (in a practical manner)"],"ipa":"/ˌpɾa.ti.kɐˈmẽ.tɨ/","examples":[{"text":"Ele está praticamente morto.","en":"He is as good as dead.","words":[{"g":"he"},{"g":"is","l":"estar"},null,{"g":"dead"}]},{"text":"Somos praticamente da mesma família.","en":"We're practically family.","words":[{"g":"to be","l":"ser"},null,{"g":"of the"},{"g":"really","l":"mesmo"},{"g":"family"}]},{"text":"Tom vem aqui praticamente todos os dias.","en":"Tom comes here practically every day.","words":[{"g":"tone"},{"g":"to come","l":"vir"},{"g":"here"},null,{"g":"everyone"},{"g":"the"},{"g":"period between sunrise…","l":"dia"}]},{"text":"Eu praticamente o consegui de graça.","en":"I got it practically for free.","words":[{"g":"I"},null,{"g":"the / it"},{"g":"to get, obtain","l":"conseguir"},null,null],"phrases":[[4,6,"for free"]]},{"text":"Este dicionário é praticamente inútil.","en":"This dictionary is nearly useless.","words":[{"g":"this"},{"g":"dictionary"},{"g":"is","l":"ser"},null,{"g":"useless"}]}]}