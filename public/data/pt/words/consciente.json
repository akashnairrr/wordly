{"id":"consciente","lemma":"consciente","pos":"adj","rank":3004,"glosses":["conscious (not sleeping, fainted or in coma)","aware (having knowledge of something)","ethical (morally approvable)"],"ipa":"/kõʃˈsjẽ.tɨ/","forms":{"plural":"conscientes"},"examples":[{"text":"Tom está consciente agora.","en":"Tom is conscious now.","words":[{"g":"tone"},{"g":"is","l":"estar"},null,{"g":"now"}]},{"text":"Tenho sonhos conscientes.","en":"I have lucid dreams.","audio":"https://tatoeba.org/en/audio/download/1186147","words":[{"g":"have","l":"ter"},{"g":"dream","l":"sonho"},null]},{"text":"Tom é muito consciente.","en":"Tom is very conscientious.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"very / a lot"},null]},{"text":"Ela pode não estar consciente do perigo.","en":"She may not be aware of the danger.","words":[{"g":"she"},{"g":"to be able to","l":"poder"},{"g":"not / no"},{"g":"to be"},null,{"g":"of the"},{"g":"danger"}]},{"text":"Ele não estava consciente de seu próprio erro.","en":"He was not conscious of his own mistake.","words":[{"g":"he"},{"g":"not / no"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"his"},{"g":"own"},{"g":"error"}]}]}