{"id":"excec_a_o","lemma":"exceção","pos":"noun","rank":2882,"glosses":["exception"],"ipa":"/(i)ʃ.sɛˈsɐ̃w̃/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d9/Pt_exepcao.ogg/Pt_exepcao.ogg.mp3","gender":"f","forms":{"plural":"exceções"},"examples":[{"text":"Hoje não é exceção.","en":"Today is no exception.","words":[{"g":"today"},null,null,null],"phrases":[[1,3,"isn't it"]]},{"text":"Há três exceções.","en":"There are three exceptions.","words":[{"g":"there be","l":"haver"},{"g":"three"},null]},{"text":"Isto é uma exceção.","en":"This is an exception.","words":[null,null,{"g":"a","l":"um"},null],"phrases":[[0,2,"that is"]]},{"text":"Não haverá exceções.","en":"There will be no exceptions.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null]},{"text":"Essa regra não tem exceções.","en":"This rule has no exceptions.","words":[{"g":"that, that one","l":"esse"},{"g":"rule"},{"g":"not / no"},{"g":"has / there is","l":"ter"},null]}]}