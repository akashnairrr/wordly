{"id":"inconveniente","lemma":"inconveniente","pos":"adj","rank":4502,"glosses":["inconvenient (not convenient; not expedient)","inopportune (all senses)","inappropriate, improper"],"ipa":"/ĩ.kõ.ve.niˈẽ.t͡ʃi/","forms":{"plural":"inconvenientes"},"examples":[{"text":"Aquilo foi um inconveniente.","en":"That was an inconvenience.","words":[{"g":"that over there, yon","l":"aquele"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Ele fez uma pergunta inconveniente.","en":"He asked an awkward question.","words":[{"g":"he"},{"g":"to create","l":"fazer"},{"g":"a","l":"um"},{"g":"question"},null]},{"text":"Nós lamentamos o inconveniente.","en":"We are sorry for the inconvenience.","words":[{"g":"we"},{"g":"to lament","l":"lamentar"},{"g":"the / it"},null]},{"text":"Isso poderia ser meio inconveniente para você, não acha?","en":"That might be a little inconvenient for you, don't you think?","words":[{"g":"that"},{"g":"to be able to","l":"poder"},{"g":"to be"},{"g":"middle, center"},null,{"g":"for / to"},{"g":"you"},{"g":"not / no"},{"g":"to find","l":"achar"}]},{"text":"Pedimos desculpas por qualquer inconveniente.","en":"We're sorry for any inconvenience.","words":[{"g":"to ask for","l":"pedir"},{"g":"excuse, pretext","l":"desculpa"},{"g":"for / by"},{"g":"any"},null]}]}