{"id":"procura","lemma":"procura","pos":"noun","rank":278,"glosses":["search (an attempt to find something)","pursuit (act of pursuing a goal)","demand (amount of a good or service that consumers are willing to buy at a particular price)"],"ipa":"/pɾɔˈku.ɾɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9b/LL-Q5146_%28por%29-Santamarcanda-procura.wav/LL-Q5146_%28por%29-Santamarcanda-procura.wav.mp3","gender":"f","forms":{"plural":"procuras"},"examples":[{"text":"A quem procura você?","en":"Who are you looking for?","audio":"https://tatoeba.org/en/audio/download/1270388","words":[{"g":"the / to"},{"g":"who"},null,{"g":"you (formal)"}]},{"text":"Bem, o que você procura?","en":"Well, what are you looking for?","words":[{"g":"well"},null,null,{"g":"you (formal)"},null],"phrases":[[1,3,"what"]]},{"text":"Ela andava à procura dele.","en":"She walked around looking for him.","words":[{"g":"she"},{"g":"to walk","l":"andar"},{"g":"to the"},null,{"g":"his / of him","l":"delir"}]},{"text":"Essa é a chave que você procura?","en":"Is that the key you're looking for?","words":[{"g":"that, that one","l":"esse"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"key"},{"g":"that / what"},{"g":"you (formal)"},null]},{"text":"Estou à procura de trabalho.","en":"I'm looking for a job.","words":[{"g":"am","l":"estar"},{"g":"to the"},null,{"g":"of / from"},{"g":"job"}]}]}