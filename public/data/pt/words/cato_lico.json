{"id":"cato_lico","lemma":"católico","pos":"adj","rank":3832,"glosses":["Catholic","correct, adequate"],"ipa":"/kɐˈtɔ.li.ku/","forms":{"feminine":"católica","masculinePlural":"católicos","femininePlural":"católicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q5146_%28por%29-MedK1-cat%C3%B3lico.wav","examples":[{"text":"Eu não sou católico.","en":"I'm not Catholic.","audio":"https://tatoeba.org/en/audio/download/493342","words":[{"g":"I"},{"g":"not / no"},{"g":"am","l":"ser"},null]},{"text":"Quem me conhece sabe que sou católico.","en":"Those who know me know that I'm Catholic.","words":[{"g":"who"},{"g":"me"},{"g":"to know","l":"conhecer"},{"g":"to be aware, to know","l":"saber"},{"g":"that / what"},{"g":"am","l":"ser"},null]},{"text":"Tom frequentou uma escola católica.","en":"Tom went to a Catholic school.","words":[{"g":"tone"},{"g":"to frequent","l":"frequentar"},{"g":"a","l":"um"},{"g":"school"},null]},{"text":"Meu pais são católicos fervorosos.","en":"My parents are devout Catholics.","words":[{"g":"my, mine"},{"g":"parents"},{"g":"to be","l":"ser"},null,null]},{"text":"Tom se tornou católico.","en":"Tom became a Catholic.","audio":"https://tatoeba.org/en/audio/download/535705","words":[{"g":"tone"},{"g":"if / oneself"},{"g":"to make","l":"tornar"},null]}]}