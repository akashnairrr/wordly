{"id":"receio","lemma":"receio","pos":"noun","rank":1502,"glosses":["fear, awe","concern, apprehension, trepidation"],"ipa":"/ʁeˈsej.u/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/86/LL-Q5146_%28por%29-Santamarcanda-receio.wav/LL-Q5146_%28por%29-Santamarcanda-receio.wav.mp3","gender":"m","forms":{"plural":"receios"},"examples":[{"text":"Nada receio.","en":"I fear nothing.","words":[{"g":"nothing"},null]},{"text":"Estou com receio do exame.","en":"I'm dreading the exam.","audio":"https://tatoeba.org/en/audio/download/535532","words":[{"g":"am","l":"estar"},{"g":"with"},null,{"g":"of the"},{"g":"examination"}]},{"text":"Não tenha receio.","en":"Fear nothing.","words":[{"g":"not / no"},{"g":"to own","l":"ter"},null]},{"text":"Receio que isso não irá funcionar.","en":"I'm afraid it won't work.","audio":"https://tatoeba.org/en/audio/download/769804","words":[null,null,null,{"g":"not / no"},{"g":"to go","l":"ir"},{"g":"to work"}],"phrases":[[1,3,"what's that?"]]},{"text":"Eu receio que tenho que sair.","en":"I'm afraid I have to leave.","words":[{"g":"I"},null,{"g":"that / what"},{"g":"have","l":"ter"},{"g":"that / what"},{"g":"to exit"}]}]}