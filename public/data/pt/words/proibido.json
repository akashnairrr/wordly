{"id":"proibido","lemma":"proibido","pos":"adj","rank":2675,"glosses":["prohibited, forbidden","illegal"],"ipa":"/pɾu.iˈbi.du/","forms":{"feminine":"proibida","masculinePlural":"proibidos","femininePlural":"proibidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q5146_%28por%29-Nelson_Ricardo_2500-proibido.wav","examples":[{"text":"Isso deveria ser proibido.","en":"That should be prohibited.","words":[{"g":"that"},{"g":"should","l":"dever"},{"g":"to be"},null]},{"text":"Eles foram proibidos de deixar o hotel.","en":"They were prohibited from leaving the hotel.","words":[{"g":"they"},null,null,{"g":"of / from"},{"g":"to leave"},{"g":"the / it"},{"g":"hotel"}]},{"text":"Aqui é proibido fumar.","en":"Smoking is forbidden here.","words":[{"g":"here"},{"g":"is","l":"ser"},null,{"g":"to smoke"}]},{"text":"As crianças estão proibidas de fumar.","en":"Children are prohibited from smoking.","words":[{"g":"the"},{"g":"child","l":"criança"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to smoke"}]},{"text":"Estou proibido de usar esse telefone.","en":"I am forbidden to use this telephone.","words":[{"g":"am","l":"estar"},null,{"g":"of / from"},{"g":"to use"},{"g":"that"},{"g":"telephone"}]}]}