{"id":"religia_o","lemma":"religião","pos":"noun","rank":2117,"glosses":["religion"],"ipa":"/ʁɨ.liˈʒjɐ̃w̃/","gender":"f","forms":{"plural":"religiões"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q5146_%28por%29-Nelson_Ricardo_2500-religi%C3%A3o.wav","examples":[{"text":"É contra minha religião.","en":"It's against my religion.","audio":"https://tatoeba.org/en/audio/download/852200","words":[{"g":"is","l":"ser"},{"g":"against"},{"g":"my, mine","l":"meu"},null]},{"text":"Não vamos falar de religião, ok?","en":"Let's not talk about religion, OK?","words":[{"g":"not / no"},{"g":"let's go"},{"g":"to speak"},{"g":"of / from"},null,null]},{"text":"Você deve pensar nas religiões deles.","en":"You should think of their religions.","words":[{"g":"you (formal)"},{"g":"should","l":"dever"},{"g":"to think"},null,null,{"g":"to destroy, erase","l":"delir"}]},{"text":"Eu não tenho religião.","en":"I have no religion.","words":[{"g":"I"},{"g":"not / no"},{"g":"have","l":"ter"},null]},{"text":"Ganhar dinheiro é a religião dele.","en":"Making money is his religion.","words":[{"g":"to win"},{"g":"money"},{"g":"is","l":"ser"},{"g":"the / to"},null,{"g":"his / of him","l":"delir"}]}]}