{"id":"neve","lemma":"neve","pos":"noun","rank":1236,"glosses":["snow"],"ipa":"/ˈnɛ.vɨ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c8/LL-Q5146_%28por%29-Santamarcanda-neve.wav/LL-Q5146_%28por%29-Santamarcanda-neve.wav.mp3","gender":"f","forms":{"plural":"neves"},"examples":[{"text":"A neve desapareceu.","en":"The snow has disappeared.","words":[{"g":"the / to"},null,{"g":"to disappear","l":"desaparecer"}]},{"text":"Talvez neve amanhã.","en":"Perhaps it'll snow tomorrow.","words":[{"g":"perhaps"},null,{"g":"tomorrow"}]},{"text":"Ei, olha para a neve.","en":"Hey, look at the snow.","audio":"https://tatoeba.org/en/audio/download/1274225","words":[{"g":"hey"},{"g":"a stew prepared with…"},{"g":"for / to"},{"g":"the / to"},null]},{"text":"Há neve na montanha.","en":"There is snow on the mountain.","words":[{"g":"there be","l":"haver"},null,{"g":"in the"},{"g":"mountain"}]},{"text":"Há neve no topo da montanha?","en":"Is there snow on top of the mountain?","words":[{"g":"there be","l":"haver"},null,{"g":"in the"},{"g":"top"},{"g":"of the"},{"g":"mountain"}]}]}