{"id":"neve","lemma":"neve","pos":"noun","rank":1262,"glosses":["snow"],"ipa":"/ˈnɛ.vi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c8/LL-Q5146_%28por%29-Santamarcanda-neve.wav/LL-Q5146_%28por%29-Santamarcanda-neve.wav.mp3","gender":"f","forms":{"plural":"neves"},"examples":[{"text":"Eu adoro neve.","en":"I love snow.","words":[{"g":"I"},{"g":"to love","l":"adorar"},null]},{"text":"Talvez neve amanhã.","en":"Perhaps it'll snow tomorrow.","words":[{"g":"perhaps"},null,{"g":"tomorrow"}]},{"text":"Você gosta de neve?","en":"Do you like snow?","words":[{"g":"you"},{"g":"to like","l":"gostar"},{"g":"of / from"},null]},{"text":"Ei, olha para a neve.","en":"Hey, look at the snow.","audio":"https://tatoeba.org/en/audio/download/1274225","words":[{"g":"hey"},{"g":"a stew prepared with…"},{"g":"for / to"},{"g":"the / to"},null]},{"text":"Há neve na montanha.","en":"There is snow on the mountain.","words":[{"g":"there be","l":"haver"},null,{"g":"in the"},{"g":"mountain"}]}]}