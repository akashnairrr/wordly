{"id":"a_g","lemma":"à","pos":"prep","rank":73,"glosses":["forms adverbs meaning \"in a manner related or resembling\"","accented preposition, the preposition a is accented when it comes before feminine words in prepositional, adverbial and conjunctive phrases; in"],"ipa":"/a/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/55/LL-Q5146_%28por%29-JnpoJuwan-%C3%A0.wav/LL-Q5146_%28por%29-JnpoJuwan-%C3%A0.wav.mp3","examples":[{"text":"Eu vou à igreja.","en":"I go to church.","audio":"https://tatoeba.org/en/audio/download/491229","words":[{"g":"I"},{"g":"to go","l":"ir"},null,{"g":"church"}]},{"text":"Você foi à loja?","en":"Did you go to the store?","audio":"https://tatoeba.org/en/audio/download/852122","words":[{"g":"you"},{"g":"to be","l":"ser"},null,{"g":"shop, store"}]},{"text":"Como você vai à escola?","en":"How do you go to school?","words":[{"g":"how / like"},{"g":"you"},{"g":"to go","l":"ir"},null,{"g":"school"}]},{"text":"Quem é a criança à frente?","en":"Who is the child in front?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"child"},null,{"g":"front"}]},{"text":"Eu não fui à escola.","en":"I didn't go to school.","audio":"https://tatoeba.org/en/audio/download/1274549","words":[{"g":"I"},{"g":"not / no"},{"g":"to go","l":"ir"},null,{"g":"school"}]}]}