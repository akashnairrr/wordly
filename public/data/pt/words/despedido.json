{"id":"despedido","lemma":"despedido","pos":"adj","rank":1775,"glosses":["laid off, dismissed (employees)"],"ipa":"/dɨʃ.pɨˈdi.du/","forms":{"feminine":"despedida","masculinePlural":"despedidos","femininePlural":"despedidas"},"examples":[{"text":"Tom foi o primeiro a ser despedido.","en":"Tom was the first to be fired.","words":[{"g":"tone"},{"g":"to be","l":"ser"},{"g":"the / it"},{"g":"first"},{"g":"the / to"},{"g":"to be"},null]},{"text":"Vocês estão despedidos.","en":"You're fired.","words":[{"g":"you (pl.)"},{"g":"to be","l":"estar"},null]},{"text":"Você está despedido.","en":"You're fired.","audio":"https://tatoeba.org/en/audio/download/49957","words":[{"g":"you (formal)"},{"g":"is","l":"estar"},null]},{"text":"Ele foi despedido pelo chefe da fábrica.","en":"He was dismissed by the boss of the factory.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"by / for the","l":"pelar"},{"g":"chief"},{"g":"of the"},{"g":"factory"}]},{"text":"Todos nós fomos despedidos.","en":"We all got fired.","words":[{"g":"everyone"},{"g":"we"},{"g":"to go","l":"ir"},null]}]}