{"id":"desculpa","lemma":"desculpa","pos":"noun","rank":405,"glosses":["excuse, pretext (explanation designed to avoid or alleviate guilt or negative judgement)","apology (expression of remorse)"],"ipa":"/desˈkuw.pɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/55/LL-Q5146_%28por%29-Santamarcanda-desculpa.wav/LL-Q5146_%28por%29-Santamarcanda-desculpa.wav.mp3","gender":"f","forms":{"plural":"desculpas"},"formAudio":{"desculpas":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q5146_%28por%29-Nelson_Ricardo_2500-desculpas.wav"},"examples":[{"text":"Desculpa, eu esqueci.","en":"Sorry, I forgot.","audio":"https://tatoeba.org/en/audio/download/63890","words":[null,{"g":"I"},{"g":"to forget","l":"esquecer"}]},{"text":"É uma ótima desculpa.","en":"It's a great excuse.","words":[{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"great","l":"ótimo"},null]},{"text":"Desculpa-me, mas posso usar o telefone?","en":"Excuse me, but may I use the phone?","words":[null,{"g":"me"},{"g":"but"},{"g":"to be able to","l":"poder"},{"g":"to use"},{"g":"the / it"},{"g":"telephone"}]},{"text":"Essa é a tua desculpa?","en":"Is that your excuse?","words":[{"g":"that, that one","l":"esse"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"hey","l":"teu"},null]},{"text":"Eu peço desculpa a todos.","en":"I apologize to everyone.","audio":"https://tatoeba.org/en/audio/download/535323","words":[{"g":"I"},{"g":"to ask for","l":"pedir"},null,{"g":"the / to"},{"g":"everyone"}]}]}