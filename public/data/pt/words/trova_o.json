{"id":"trova_o","lemma":"trovão","pos":"noun","rank":4975,"glosses":["thunder (the sound caused by the discharge of atmospheric electrical charge)","thunder (sound resembling thunder)"],"ipa":"/tɾuˈvɐ̃w̃/","gender":"m","forms":{"plural":"trovões"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q5146_%28por%29-Ed_Guimaraes-trov%C3%A3o.wav","examples":[{"text":"Eu ouvi um trovão.","en":"I heard thunder.","audio":"https://tatoeba.org/en/audio/download/1272818","words":[{"g":"I"},{"g":"to hear","l":"ouvir"},{"g":"a"},null]},{"text":"Tenho medo de trovões.","en":"I'm afraid of thunder.","words":[{"g":"have","l":"ter"},{"g":"Median"},{"g":"of / from"},null]},{"text":"O trovão ficou mais alto.","en":"The thunder became louder.","words":[{"g":"the / it"},null,{"g":"to become","l":"ficar"},{"g":"more"},{"g":"loud"}]},{"text":"Há trovões, mas não chove.","en":"There's thunder, but no rain.","words":[{"g":"there be","l":"haver"},null,{"g":"but"},{"g":"not / no"},{"g":"to rain from the sky)","l":"chover"}]},{"text":"Depois do raio, veio o trovão.","en":"After the lightning, came the thunder.","words":[{"g":"later"},{"g":"of the"},{"g":"ray"},{"g":"to come","l":"vir"},{"g":"the / it"},null]}]}