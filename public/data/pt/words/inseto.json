{"id":"inseto","lemma":"inseto","pos":"noun","rank":3842,"glosses":["insect (arthropod of class Insecta)","insect (a contemptible or powerless person)"],"ipa":"/ĩˈsɛ.tu/","gender":"m","forms":{"plural":"insetos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q5146_%28por%29-Nelson_Ricardo_2500-inseto.wav","examples":[{"text":"Eu odeio insetos.","en":"I hate insects.","audio":"https://tatoeba.org/en/audio/download/491076","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Tom encontrou o inseto.","en":"Tom found the bug.","audio":"https://tatoeba.org/en/audio/download/1274194","words":[{"g":"tone"},{"g":"to meet","l":"encontrar"},{"g":"the / it"},null]},{"text":"Tem insetos em todo lugar.","en":"There are insects everywhere.","words":[{"g":"has / there is","l":"ter"},null,{"g":"in"},{"g":"every"},{"g":"place"}]},{"text":"Você tem medo de inseto?","en":"Are you afraid of insects?","words":[{"g":"you (formal)"},{"g":"has / there is","l":"ter"},{"g":"Median"},{"g":"of / from"},null]},{"text":"Vocês gostam de insetos?","en":"Do you like bugs?","words":[{"g":"you (pl.)"},{"g":"to like","l":"gostar"},{"g":"of / from"},null]}]}