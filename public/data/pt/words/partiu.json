{"id":"partiu","lemma":"partiu","pos":"intj","rank":1771,"glosses":["let's go"],"ipa":"/paʁˈt͡ʃiw/","examples":[{"text":"Tom partiu por um mês.","en":"Tom left for a month.","audio":"https://tatoeba.org/en/audio/download/1274611","words":[{"g":"tone"},null,{"g":"for / by"},{"g":"a"},{"g":"month"}]},{"text":"Quando você partiu?","en":"When did you leave?","words":[{"g":"when"},{"g":"you"},null]},{"text":"Você partiu meu coração.","en":"You broke my heart.","words":[{"g":"you"},null,{"g":"my, mine"},{"g":"heart"}]},{"text":"Ele já partiu.","en":"He has left already.","words":[{"g":"he"},{"g":"already"},null]},{"text":"Na manhã seguinte, ele partiu.","en":"The next morning, he was gone.","words":[{"g":"in the"},{"g":"morning"},{"g":"next"},{"g":"he"},null]}]}