{"id":"bombeiro","lemma":"bombeiro","pos":"noun","rank":2428,"glosses":["firefighter (person trained to extinguish fires and undertake rescue operations)"],"ipa":"/bõˈbɐj.ɾu/","gender":"m","forms":{"plural":"bombeiros","feminine":"bombeira","femininePlural":"bombeiras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q5146_%28por%29-Nelson_Ricardo_2500-bombeiro.wav","examples":[{"text":"Meu sonho é ser bombeiro.","en":"My dream is to be a firefighter.","words":[{"g":"my, mine"},{"g":"dream"},{"g":"is","l":"ser"},{"g":"to be"},null]},{"text":"Chame os bombeiros!","en":"Call the fire department!","words":[{"g":"to call","l":"chamar"},{"g":"the"},null]},{"text":"Eu nunca quis ser bombeiro.","en":"I never wanted to be a fireman.","words":[{"g":"I"},{"g":"never (at no time"},{"g":"to want","l":"querer"},{"g":"to be"},null]},{"text":"Sou bombeira.","en":"I'm a firefighter.","words":[{"g":"am","l":"ser"},null]},{"text":"Ele decidiu ser um bombeiro.","en":"He made up his mind to be a fireman.","words":[{"g":"he"},{"g":"to decide","l":"decidir"},{"g":"to be"},{"g":"a"},null]}]}