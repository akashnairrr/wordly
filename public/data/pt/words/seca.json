{"id":"seca","lemma":"seca","pos":"noun","rank":1696,"glosses":["drought (period of unusually low rainfall)","act of drying","nuisance; bore"],"ipa":"/ˈsɛ.kɐ/","gender":"f","forms":{"plural":"secas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q5146_%28por%29-MedK1-seca.wav","examples":[{"text":"A minha boca está seca.","en":"My mouth is dry.","words":[null,null,{"g":"mouth"},{"g":"is","l":"estar"},null],"phrases":[[0,2,"the missus"]]},{"text":"Ela ainda não está seca.","en":"It's not dry yet.","words":[{"g":"she"},{"g":"still"},{"g":"not / no"},{"g":"is","l":"estar"},null]},{"text":"A minha garganta está um pouco seca.","en":"My throat's a little dry.","words":[null,null,{"g":"throat"},{"g":"is","l":"estar"},null,null,null],"phrases":[[0,2,"the missus"],[4,6,"slightly"]]},{"text":"Muitos camponeses morreram durante a seca.","en":"Many peasants died during the drought.","words":[{"g":"very, a lot","l":"muito"},{"g":"peasant","l":"camponês"},null,{"g":"during"},{"g":"the / to"},null]},{"text":"Traga-me uma toalha seca.","en":"Bring me a dry towel.","audio":"https://tatoeba.org/en/audio/download/46161","words":[{"g":"bring","l":"trazer"},{"g":"me"},{"g":"a","l":"um"},{"g":"towel"},null]}]}