{"id":"ferimento","lemma":"ferimento","pos":"noun","rank":2672,"glosses":["injury, hurt, harm","blow (from a weapon)","wound"],"ipa":"/fe.ɾiˈmẽ.tu/","gender":"m","forms":{"plural":"ferimentos"},"examples":[{"text":"Isto parece um ferimento a bala.","en":"This looks like a gunshot wound.","words":[{"g":"this"},{"g":"to seem","l":"parecer"},{"g":"a"},null,{"g":"the / to"},{"g":"bullet, projectile"}]},{"text":"Seus ferimentos não são graves.","en":"Your injuries aren't serious.","words":[{"g":"their or your kin"},null,{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"to engrave","l":"gravar"}]},{"text":"Tom sobreviveu ao ferimento.","en":"Tom survived his injury.","words":[{"g":"tone"},{"g":"survive","l":"sobreviver"},null,null]},{"text":"Três dos corpos tinham ferimentos a bala.","en":"Three of the bodies had gunshot wounds.","words":[{"g":"three"},null,{"g":"body","l":"corpo"},{"g":"to own","l":"ter"},null,{"g":"the / to"},{"g":"bullet, projectile"}]},{"text":"A longa viagem agravou seu ferimento.","en":"The long trip aggravated her injury.","words":[{"g":"the / to"},{"g":"long syllable"},{"g":"trip, journey, voyage"},null,{"g":"his"},null]}]}