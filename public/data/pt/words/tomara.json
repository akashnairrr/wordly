{"id":"tomara","lemma":"tomara","pos":"intj","rank":3025,"glosses":["I hope so"],"ipa":"/toˈma.ɾɐ/","examples":[{"text":"Tomara que não seja tarde demais.","en":"I hope it's not too late.","audio":"https://tatoeba.org/en/audio/download/1270589","words":[null,{"g":"that / what"},{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"late"},{"g":"too, overly"}]},{"text":"Tomara que você nunca saia da cadeia.","en":"I hope you never get out of prison.","words":[null,{"g":"that / what"},{"g":"you"},{"g":"never (at no time"},{"g":"to exit","l":"sair"},{"g":"of the"},{"g":"prison"}]},{"text":"Tomara que ele venha.","en":"Have him come.","words":[null,{"g":"that / what"},{"g":"he"},{"g":"to come","l":"vir"}]},{"text":"Tomara que chova amanhã.","en":"Hopefully, it'll rain tomorrow.","words":[null,{"g":"that / what"},{"g":"to rain from the sky)","l":"chover"},{"g":"tomorrow"}]},{"text":"Tomara que meu time vença.","en":"I hope my team wins.","words":[null,{"g":"that / what"},{"g":"my, mine"},{"g":"a team"},{"g":"to win","l":"vencer"}]}]}