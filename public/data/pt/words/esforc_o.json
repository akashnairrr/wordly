{"id":"esforc_o","lemma":"esforço","pos":"noun","rank":1641,"glosses":["effort (the amount of work involved in achieving something)","stress (as in stress test, such as a financial stress test)"],"ipa":"/isˈfoʁ.su/","gender":"m","forms":{"plural":"esforços"},"examples":[{"text":"O esforço valeu a pena.","en":"The effort paid off.","words":[{"g":"the / it"},null,{"g":"thanks"},{"g":"the / to"},{"g":"punishment"}]},{"text":"Seus esforços foram em vão.","en":"His efforts were in vain.","words":[{"g":"their or your kin"},null,null,null,null],"phrases":[[3,5,"in vain (ending in…"]]},{"text":"Nada se consegue sem esforço.","en":"Nothing is achieved without effort.","words":[{"g":"nothing"},{"g":"if / oneself"},{"g":"to get, obtain","l":"conseguir"},{"g":"-less"},null]},{"text":"Os esforços deles não foram por nada.","en":"Their efforts were not for nothing.","words":[{"g":"the"},null,{"g":"to destroy, erase","l":"delir"},{"g":"not / no"},null,null,null],"phrases":[[5,7,"you're welcome"]]},{"text":"Faça um esforço.","en":"Make an effort.","words":[{"g":"to create","l":"fazer"},{"g":"a"},null]}]}