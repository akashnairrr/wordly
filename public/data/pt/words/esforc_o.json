{"id":"esforc_o","lemma":"esforço","pos":"noun","rank":1638,"glosses":["effort (the amount of work involved in achieving something)","stress (as in stress test, such as a financial stress test)"],"ipa":"/(i)ʃˈfoɾ.su/","gender":"m","forms":{"plural":"esforços"},"examples":[{"text":"Os esforços dele foram em vão.","en":"His efforts were in vain.","words":[{"g":"the"},null,{"g":"his / of him","l":"delir"},null,null,null],"phrases":[[4,6,"in vain (ending in…"]]},{"text":"Nada se consegue sem esforço.","en":"Nothing is achieved without effort.","words":[{"g":"nothing"},{"g":"if / oneself"},{"g":"to get, obtain","l":"conseguir"},{"g":"-less"},null]},{"text":"Faça um esforço.","en":"Make an effort.","words":[{"g":"to create","l":"fazer"},{"g":"a"},null]},{"text":"Os esforços deles não foram por nada.","en":"Their efforts were not for nothing.","words":[{"g":"the"},null,{"g":"to destroy, erase","l":"delir"},{"g":"not / no"},null,null,null],"phrases":[[5,7,"you're welcome"]]},{"text":"A liberdade não vem sem esforço.","en":"Freedom is not free.","words":[{"g":"the / to"},{"g":"liberty, freedom"},{"g":"not / no"},{"g":"to come","l":"vir"},{"g":"-less"},null]}]}