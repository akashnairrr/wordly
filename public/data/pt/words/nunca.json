{"id":"nunca","lemma":"nunca","pos":"adv","rank":68,"glosses":["never (at no time; not ever)"],"ipa":"/ˈnũ.kɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/09/LL-Q5146_%28por%29-Santamarcanda-nunca.wav/LL-Q5146_%28por%29-Santamarcanda-nunca.wav.mp3","examples":[{"text":"Isso nunca aconteceu.","en":"That never happened.","audio":"https://tatoeba.org/en/audio/download/843608","words":[{"g":"that"},null,{"g":"to happen","l":"acontecer"}]},{"text":"Eu nunca entendi aquilo.","en":"I never understood that.","audio":"https://tatoeba.org/en/audio/download/535652","words":[{"g":"I"},null,{"g":"to understand","l":"entender"},{"g":"that over there, yon","l":"aquele"}]},{"text":"Nunca te deixarei.","en":"I'll never leave you.","audio":"https://tatoeba.org/en/audio/download/533696","words":[null,{"g":"you"},{"g":"to leave","l":"deixar"}]},{"text":"Eu nunca ouvi falar de você.","en":"I've never heard of you.","audio":"https://tatoeba.org/en/audio/download/535130","words":[{"g":"I"},null,{"g":"to hear","l":"ouvir"},{"g":"to speak"},{"g":"of / from"},{"g":"you"}]},{"text":"Eu nunca te esqueci.","en":"I've never forgotten you.","audio":"https://tatoeba.org/en/audio/download/769792","words":[{"g":"I"},null,{"g":"you"},{"g":"to forget","l":"esquecer"}]}]}