{"id":"nunca","lemma":"nunca","pos":"adv","rank":68,"glosses":["never (at no time; not ever)"],"ipa":"/ˈnũ.kɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/09/LL-Q5146_%28por%29-Santamarcanda-nunca.wav/LL-Q5146_%28por%29-Santamarcanda-nunca.wav.mp3","examples":[{"text":"Isso nunca aconteceu.","en":"That never happened.","audio":"https://tatoeba.org/en/audio/download/843608","words":[{"g":"that"},null,{"g":"to happen","l":"acontecer"}]},{"text":"Vocês nunca fizeram isso, fizeram?","en":"You've never done that, have you?","words":[{"g":"you (pl.)"},null,null,{"g":"that"},null]},{"text":"Ele nunca me fez nenhuma pergunta.","en":"He has never asked me any questions.","audio":"https://tatoeba.org/en/audio/download/63968","words":[{"g":"he"},null,{"g":"me"},{"g":"to create","l":"fazer"},{"g":"not any, none","l":"nenhum"},{"g":"question"}]},{"text":"Nunca se sabe.","en":"You never know.","audio":"https://tatoeba.org/en/audio/download/71323","words":[null,{"g":"if / oneself"},{"g":"to be aware, to know","l":"saber"}]},{"text":"Eles nunca disseram não.","en":"They never said no.","words":[{"g":"they"},null,null,{"g":"not / no"}]}]}