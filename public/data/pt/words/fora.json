{"id":"fora","lemma":"fora","pos":"adv","rank":119,"glosses":["outside (on the outside of a building or location)","abroad; overseas (in another country)","out (away from home or one’s usual place)"],"ipa":"/ˈfɔ.ɾɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q5146_%28por%29-Nelson_Ricardo_2500-fora.wav","examples":[{"text":"Pense fora da caixa.","en":"Think outside the box.","audio":"https://tatoeba.org/en/audio/download/1270442","words":[{"g":"to think","l":"pensar"},null,{"g":"of the"},{"g":"box"}]},{"text":"Meu irmão está fora.","en":"My brother is out.","audio":"https://tatoeba.org/en/audio/download/852096","words":[null,null,{"g":"is","l":"estar"},null],"phrases":[[0,2,"bro, dude"]]},{"text":"Estarei fora da cidade.","en":"I'll be out of town.","audio":"https://tatoeba.org/en/audio/download/495419","words":[{"g":"to be","l":"estar"},null,{"g":"of the"},{"g":"city, town"}]},{"text":"Há algo lá fora.","en":"There's something out there.","audio":"https://tatoeba.org/en/audio/download/852025","words":[{"g":"there be","l":"haver"},{"g":"something"},{"g":"there"},null]},{"text":"Venha aqui fora.","en":"Come outside.","audio":"https://tatoeba.org/en/audio/download/1270810","words":[{"g":"to come","l":"vir"},{"g":"here"},null]}]}