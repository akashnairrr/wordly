{"id":"absoluto","lemma":"absoluto","pos":"adj","rank":2724,"glosses":["absolute","unmitigated","total"],"ipa":"/ab.soˈlu.tu/","forms":{"feminine":"absoluta","masculinePlural":"absolutos","femininePlural":"absolutas"},"examples":[{"text":"Eu tenho absoluta confiança nele.","en":"I have absolute trust in him.","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"trust, confidence"},null]},{"text":"Você tem certeza absoluta?","en":"Do you know it for a fact?","words":[{"g":"you"},{"g":"has / there is","l":"ter"},{"g":"certainty"},null]},{"text":"Não tenho certeza absoluta.","en":"I'm not exactly sure.","words":[{"g":"not / no"},{"g":"have","l":"ter"},{"g":"certainty"},null]},{"text":"Você tem absoluta certeza de que estamos seguros?","en":"Are you absolutely certain we're safe?","words":[{"g":"you"},{"g":"has / there is","l":"ter"},null,{"g":"certainty"},{"g":"of / from"},{"g":"that / what"},{"g":"to be","l":"estar"},{"g":"safe","l":"seguro"}]},{"text":"O divórcio deles foi uma absoluta surpresa.","en":"Their divorce came as a complete surprise.","words":[{"g":"the / it"},{"g":"divorce"},{"g":"to destroy, erase","l":"delir"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},null,{"g":"surprise"}]}]}