{"id":"absoluto","lemma":"absoluto","pos":"adj","rank":2251,"glosses":["absolute","unmitigated","total"],"ipa":"/ɐb.suˈlu.tu/","forms":{"feminine":"absoluta","masculinePlural":"absolutos","femininePlural":"absolutas"},"examples":[{"text":"Eu tenho absoluta confiança nele.","en":"I have absolute trust in him.","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"trust, confidence"},null]},{"text":"Não tenho certeza absoluta.","en":"I'm not exactly sure.","words":[{"g":"not / no"},{"g":"have","l":"ter"},{"g":"certainty"},null]},{"text":"Você tem certeza absoluta?","en":"Do you know it for a fact?","words":[{"g":"you (formal)"},{"g":"has / there is","l":"ter"},{"g":"certainty"},null]},{"text":"O divórcio deles foi uma absoluta surpresa.","en":"Their divorce came as a complete surprise.","words":[{"g":"the / it"},{"g":"divorce"},{"g":"to destroy, erase","l":"delir"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},null,{"g":"surprise"}]},{"text":"Eu tenho certeza absoluta disso.","en":"I'm absolutely certain of it.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"certainty"},null,{"g":"of that"}]}]}