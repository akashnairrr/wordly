{"id":"eleic_a_o","lemma":"eleição","pos":"noun","rank":2410,"glosses":["election"],"ipa":"/i.lɐjˈsɐ̃w̃/","gender":"f","forms":{"plural":"eleições"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-elei%C3%A7%C3%A3o.wav","examples":[{"text":"Ganhei a eleição.","en":"I won the election.","audio":"https://tatoeba.org/en/audio/download/495011","words":[{"g":"to win","l":"ganhar"},{"g":"the / to"},null]},{"text":"Ele ganhou a eleição seguinte.","en":"He won the next election.","words":[{"g":"he"},{"g":"to win","l":"ganhar"},{"g":"the / to"},null,{"g":"next"}]},{"text":"O ano que vem é ano de eleições.","en":"Next year is an election year.","words":[{"g":"the / it"},null,null,null,{"g":"is","l":"ser"},{"g":"year"},{"g":"of / from"},null],"phrases":[[1,4,"next year"]]},{"text":"Ele provavelmente vai ganhar a próxima eleição.","en":"He'll probably win in the next election.","words":[{"g":"he"},{"g":"probably"},{"g":"to go","l":"ir"},{"g":"to win"},{"g":"the / to"},{"g":"near, close","l":"próximo"},null]},{"text":"As eleições estão chegando.","en":"Elections are just around the corner.","words":[{"g":"the"},null,{"g":"to be","l":"estar"},{"g":"to arrive","l":"chegar"}]}]}