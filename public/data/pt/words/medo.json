{"id":"medo","lemma":"medo","pos":"adj","rank":213,"glosses":["Median"],"ipa":"/ˈmɛ.du/","forms":{"feminine":"meda","masculinePlural":"medos","femininePlural":"medas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q5146_%28por%29-Nelson_Ricardo_2500-medo.wav","examples":[{"text":"Ele tem medo da morte?","en":"Is he afraid of death?","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,{"g":"of the"},{"g":"death"}]},{"text":"Ninguém parece ter medo de mim.","en":"No one seems to be afraid of me.","audio":"https://tatoeba.org/en/audio/download/769832","words":[{"g":"no one"},{"g":"to seem","l":"parecer"},{"g":"to own"},null,{"g":"of / from"},{"g":"me"}]},{"text":"Eu tenho medo de você.","en":"I'm afraid of you.","audio":"https://tatoeba.org/en/audio/download/493906","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"of / from"},{"g":"you"}]},{"text":"Ele tem medo de ficar doente.","en":"He is afraid of becoming sick.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,{"g":"of / from"},{"g":"to become"},{"g":"sick"}]},{"text":"Você precisa encarar os seus medos.","en":"You must face your fears.","words":[{"g":"you"},{"g":"precise","l":"preciso"},{"g":"to face"},{"g":"the"},{"g":"their or your kin"},null]}]}