{"id":"perda_o","lemma":"perdão","pos":"intj","rank":816,"glosses":["excuse me (used to request someone’s attention)","sorry (used as an apology)"],"ipa":"/pɛʁˈdɐ̃w̃/ [pɛɦˈdɐ̃ʊ̯̃]","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1b/LL-Q5146_%28por%29-Santamarcanda-perd%C3%A3o.wav/LL-Q5146_%28por%29-Santamarcanda-perd%C3%A3o.wav.mp3","examples":[{"text":"Perdão, mas quem é você?","en":"Excuse me, but who are you?","audio":"https://tatoeba.org/en/audio/download/1271116","words":[null,{"g":"but"},{"g":"who"},{"g":"is","l":"ser"},{"g":"you"}]},{"text":"Perdão, por um momento.","en":"Pardon me for a moment.","words":[null,{"g":"for / by"},{"g":"a"},{"g":"moment"}]},{"text":"Eu quero te pedir perdão.","en":"I want to ask you for forgiveness.","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"you"},{"g":"to ask for"},null]},{"text":"Perdão, o que você disse?","en":"I beg your pardon. What did you say?","words":[null,null,null,{"g":"you"},{"g":"to speak","l":"dizer"}],"phrases":[[1,3,"what"]]},{"text":"Perdão por chegar tarde.","en":"Sorry for being late.","words":[null,{"g":"for / by"},{"g":"to arrive"},{"g":"late"}]}]}