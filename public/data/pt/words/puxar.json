{"id":"puxar","lemma":"puxar","pos":"verb","rank":2053,"glosses":["to pull (to apply force to something so it comes towards one)","to drag (to pull along a surface)","to draw (pull out) a weapon"],"ipa":"/puˈʃaɾ/","conjugation":{"indicative":{"present":{"1s":"puxo","2s":"puxas","3s":"puxa","1p":"puxamos","2p":"puxais","3p":"puxam"},"imperfect":{"1s":"puxava","2s":"puxavas","3s":"puxava","1p":"puxávamos","2p":"puxáveis","3p":"puxavam"},"preterite":{"1s":"puxei","2s":"puxaste","3s":"puxou","1p":"puxámos","2p":"puxastes","3p":"puxaram"},"future":{"1s":"puxarei","2s":"puxarás","3s":"puxará","1p":"puxaremos","2p":"puxareis","3p":"puxarão"},"conditional":{"1s":"puxaria","2s":"puxarias","3s":"puxaria","1p":"puxaríamos","2p":"puxaríeis","3p":"puxariam"}},"subjunctive":{"present":{"1s":"puxe","2s":"puxes","3s":"puxe","1p":"puxemos","2p":"puxeis","3p":"puxem"},"imperfect":{"1s":"puxasse","2s":"puxasses","3s":"puxasse","1p":"puxássemos","2p":"puxásseis","3p":"puxassem"}},"imperative":{"affirmative":{"2s":"puxa","3s":"puxe","1p":"puxemos","2p":"puxai","3p":"puxem"},"negative":{"2s":"não puxes","3s":"não puxe","1p":"não puxemos","2p":"não puxeis","3p":"não puxem"}}},"nonFinite":{"gerund":"puxando","participle":"puxado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q5146_%28por%29-Wiktionairy-puxar.wav","formAudio":{"puxe":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q5146_%28por%29-Nelson_Ricardo_2500-puxe.wav"},"examples":[{"text":"Ela puxou minha camisa.","en":"She pulled my shirt.","audio":"https://tatoeba.org/en/audio/download/670185","words":[{"g":"she"},null,{"g":"my, mine","l":"meu"},{"g":"shirt"}]},{"text":"Pare de puxar o meu cabelo!","en":"Stop pulling my hair.","words":[{"g":"to stop","l":"parar"},{"g":"of / from"},null,{"g":"the / it"},{"g":"my, mine"},{"g":"hair, head of hair"}]},{"text":"Minha irmã puxou meu cabelo.","en":"My sister pulled my hair.","words":[{"g":"my, mine","l":"meu"},{"g":"sister"},null,{"g":"my, mine"},{"g":"hair, he