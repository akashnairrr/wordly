{"id":"avo_","lemma":"avó","pos":"noun","rank":1021,"glosses":["grandmother, female grandparent"],"ipa":"/aˈvɔ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ea/Pt-br-av%C3%B3.oga/Pt-br-av%C3%B3.oga.mp3","gender":"f","forms":{"plural":"avós","masculine":"avô","masculinePlural":"avôs"},"formAudio":{"avô":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q5146_%28por%29-Nelson_Ricardo_2500-av%C3%B4.wav"},"examples":[{"text":"Minha avó mora no campo.","en":"My grandmother lives in the country.","words":[{"g":"my, mine","l":"meu"},null,{"g":"to live, reside","l":"morar"},{"g":"in the"},{"g":"country"}]},{"text":"Minha avó é velha, mas saudável.","en":"My grandmother is old but healthy.","words":[{"g":"my, mine","l":"meu"},null,{"g":"is","l":"ser"},{"g":"mother"},{"g":"but"},{"g":"healthy"}]},{"text":"A avó dele não anda, anda?","en":"His grandmother can't walk, can she?","words":[{"g":"the / to"},null,{"g":"to destroy, erase","l":"delir"},{"g":"not / no"},{"g":"to walk","l":"andar"},{"g":"to walk","l":"andar"}]},{"text":"Minha avó sabe voar.","en":"My grandmother can fly.","words":[{"g":"my, mine","l":"meu"},null,{"g":"to be aware, to know","l":"saber"},{"g":"to fly"}]},{"text":"Como vai a sua avó?","en":"How is your grandmother?","words":[null,null,{"g":"the / to"},{"g":"his","l":"seu"},null],"phrases":[[0,2,"how are you?"]]}]}