{"id":"passarinho","lemma":"passarinho","pos":"noun","rank":3643,"glosses":["any small species of bird, such as passerines","birdie (small bird, or a term of endearment)"],"ipa":"/pa.saˈɾĩ.ɲu/","gender":"m","forms":{"plural":"passarinhos","feminine":"passarinha","femininePlural":"passarinhas"},"examples":[{"text":"O passarinho está morto.","en":"The bird is dead.","words":[{"g":"the / it"},null,{"g":"is","l":"estar"},{"g":"dead"}]},{"text":"Escute os passarinhos cantando.","en":"Listen to the birds singing.","words":[{"g":"to listen to","l":"escutar"},{"g":"the"},null,{"g":"to sing","l":"cantar"}]},{"text":"Um passarinho me contou.","en":"A little bird told me.","words":[{"g":"a"},null,{"g":"me"},{"g":"to tell","l":"contar"}]},{"text":"Ela tomou conta do pobre passarinho.","en":"She took care of the poor little bird.","words":[{"g":"she"},{"g":"to take","l":"tomar"},{"g":"operation, calculation"},{"g":"of the"},{"g":"poor"},null]},{"text":"Eu matei dois passarinhos com uma pedra.","en":"I killed two birds with one stone.","words":[{"g":"I"},{"g":"to kill","l":"matar"},{"g":"deuce"},null,{"g":"with"},{"g":"a","l":"um"},{"g":"stone"}]}]}