{"id":"passarinho","lemma":"passarinho","pos":"noun","rank":3938,"glosses":["any small species of bird, such as passerines","birdie (small bird, or a term of endearment)"],"ipa":"/pɐ.sɐˈɾi.ɲu/","gender":"m","forms":{"plural":"passarinhos","feminine":"passarinha","femininePlural":"passarinhas"},"examples":[{"text":"O passarinho está morto.","en":"The bird is dead.","words":[{"g":"the / it"},null,{"g":"is","l":"estar"},{"g":"dead"}]},{"text":"Um passarinho me contou.","en":"A little bird told me.","words":[{"g":"a"},null,{"g":"me"},{"g":"to tell","l":"contar"}]},{"text":"Escute os passarinhos cantando.","en":"Listen to the birds singing.","words":[{"g":"to listen to","l":"escutar"},{"g":"the"},null,{"g":"to sing","l":"cantar"}]},{"text":"Ela tomou conta do pobre passarinho.","en":"She took care of the poor little bird.","words":[{"g":"she"},{"g":"to take","l":"tomar"},{"g":"bill, check"},{"g":"of the"},{"g":"poor"},null]},{"text":"Muitos passarinhos estão no galho.","en":"Many birds are on the branch.","words":[{"g":"very, a lot","l":"muito"},null,{"g":"to be","l":"estar"},{"g":"in the"},{"g":"branch"}]}]}