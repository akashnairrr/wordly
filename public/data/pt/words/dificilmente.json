{"id":"dificilmente","lemma":"dificilmente","pos":"adv","rank":3477,"glosses":["with difficulty","hardly, scarcely"],"ipa":"/d͡ʒiˌfi.siwˈmẽ.t͡ʃi/","examples":[{"text":"Dificilmente tenho dinheiro comigo.","en":"I have hardly any money with me.","words":[null,{"g":"have","l":"ter"},{"g":"money"},{"g":"prepositional form with…"}]},{"text":"Aqui dificilmente chove.","en":"It hardly ever rains here.","audio":"https://tatoeba.org/en/audio/download/843993","words":[{"g":"here"},null,{"g":"to rain from the sky)","l":"chover"}]},{"text":"Dificilmente fazemos isso.","en":"We scarcely ever do that anymore.","words":[null,{"g":"to create","l":"fazer"},{"g":"that"}]},{"text":"Eu dificilmente ganho.","en":"I seldom win.","words":[{"g":"I"},null,{"g":"gain, profit"}]},{"text":"Eu dificilmente acreditava nisso.","en":"I hardly believed it myself.","words":[{"g":"I"},null,{"g":"to believe","l":"acreditar"},null]}]}