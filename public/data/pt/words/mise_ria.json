{"id":"mise_ria","lemma":"miséria","pos":"noun","rank":3782,"glosses":["misery, distress (extreme pain of body or mind)","misery (extreme poverty)","misery (calamity, misfortune)"],"ipa":"/miˈzɛ.ɾjɐ/","gender":"f","forms":{"plural":"misérias"},"examples":[{"text":"A miséria adora companhia.","en":"Misery loves company.","words":[{"g":"the / to"},null,{"g":"to love","l":"adorar"},{"g":"company, companionship"}]},{"text":"Vou te tirar da miséria.","en":"I'll put you out of your misery.","words":[{"g":"to go","l":"ir"},{"g":"you"},{"g":"to take"},{"g":"of the"},null]},{"text":"Alguém deveria tirar aquele cachorro da miséria.","en":"Someone should put that dog out of its misery.","words":[{"g":"somebody"},{"g":"should","l":"dever"},{"g":"to take"},{"g":"that over there, yon"},{"g":"puppy"},{"g":"of the"},null]},{"text":"Miséria e tristeza acompanham a guerra.","en":"Misery and sorrow accompany war.","words":[null,{"g":"and"},{"g":"sadness"},{"g":"to accompany","l":"acompanhar"},{"g":"the / to"},{"g":"war"}]}]}