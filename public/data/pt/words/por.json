{"id":"por","lemma":"por","pos":"prep","rank":14,"glosses":["for (on behalf of)","for (in order to obtain)","for (over a period of time)"],"ipa":"/puɾ/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q5146_%28por%29-Nelson_Ricardo_2500-por.wav","examples":[{"text":"Obrigado por ajudar.","en":"Thanks for helping.","audio":"https://tatoeba.org/en/audio/download/843925","words":[{"g":"thank you"},null,{"g":"to help, aid"}]},{"text":"Por que aquilo aconteceu?","en":"Why did that happen?","audio":"https://tatoeba.org/en/audio/download/1271285","words":[null,{"g":"that / what"},{"g":"that over there, yon","l":"aquele"},{"g":"to happen","l":"acontecer"}]},{"text":"É por mim?","en":"Is this for me?","words":[{"g":"is","l":"ser"},null,{"g":"me"}]},{"text":"Espere por mim, por favor.","en":"Please wait for me.","audio":"https://tatoeba.org/en/audio/download/889755","words":[{"g":"to wait","l":"esperar"},null,{"g":"me"},null,{"g":"favor"}]},{"text":"Obrigado por me avisar.","en":"Thank you for warning me.","audio":"https://tatoeba.org/en/audio/download/163140","words":[{"g":"thank you"},null,{"g":"me"},{"g":"to notify, to warn"}]}]}