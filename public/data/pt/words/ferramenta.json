{"id":"ferramenta","lemma":"ferramenta","pos":"noun","rank":2218,"glosses":["tool (mechanical device intended to make a task easier)","penis"],"ipa":"/fe.ʁaˈmẽ.tɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e3/LL-Q5146_%28por%29-MedK1-ferramenta.wav/LL-Q5146_%28por%29-MedK1-ferramenta.wav.mp3","gender":"f","forms":{"plural":"ferramentas"},"examples":[{"text":"Eu vou precisar de algumas ferramentas.","en":"I'll need some tools.","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"to need"},{"g":"of / from"},{"g":"some, any","l":"algum"},null]},{"text":"Eu trouxe as minhas ferramentas.","en":"I brought my tools.","words":[{"g":"I"},{"g":"bring","l":"trazer"},{"g":"the"},{"g":"my, mine","l":"meu"},null]},{"text":"Pega a minha caixa de ferramentas.","en":"Get my tool box.","words":[{"g":"to grab, hold","l":"pegar"},null,null,{"g":"box"},{"g":"of / from"},null],"phrases":[[1,3,"the missus"]]},{"text":"Essa não é a ferramenta que eu usaria.","en":"That isn't the tool I'd use.","words":[{"g":"that, that one","l":"esse"},null,null,{"g":"the / to"},null,{"g":"that / what"},{"g":"I"},{"g":"to use","l":"usar"}],"phrases":[[1,3,"isn't it"]]},{"text":"Tom guarda as suas ferramentas na garagem.","en":"Tom keeps his tools in the garage.","words":[{"g":"tone"},{"g":"guard"},{"g":"the"},{"g":"his","l":"seu"},null,{"g":"in the"},{"g":"garage"}]}]}