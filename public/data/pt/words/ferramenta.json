{"id":"ferramenta","lemma":"ferramenta","pos":"noun","rank":2182,"glosses":["tool (mechanical device intended to make a task easier)"],"ipa":"/fɨ.ʁɐˈmẽ.tɐ/","gender":"f","forms":{"plural":"ferramentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q5146_%28por%29-MedK1-ferramenta.wav","examples":[{"text":"Vou precisar de algumas ferramentas.","en":"I'll need some tools.","words":[{"g":"to go","l":"ir"},{"g":"to need"},{"g":"of / from"},{"g":"some, any","l":"algum"},null]},{"text":"Pega a minha caixa de ferramentas.","en":"Get my tool box.","words":[{"g":"to grab, hold","l":"pegar"},null,null,{"g":"box"},{"g":"of / from"},null],"phrases":[[1,3,"the missus"]]},{"text":"Tom guarda as suas ferramentas na garagem.","en":"Tom keeps his tools in the garage.","words":[{"g":"tone"},{"g":"guard"},{"g":"the"},{"g":"his","l":"seu"},null,{"g":"in the"},{"g":"garage"}]},{"text":"Esta é a melhor ferramenta a se utilizar.","en":"This is the best tool to use.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"desirable","l":"bom"},null,{"g":"the / to"},{"g":"if / oneself"},{"g":"to use, employ, apply"}]},{"text":"Vou pegar as minhas ferramentas.","en":"I'll get my tools.","words":[{"g":"to go","l":"ir"},{"g":"to grab, hold"},{"g":"the"},{"g":"my, mine","l":"meu"},null]}]}