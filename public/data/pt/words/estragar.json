o/download/58641","words":[{"g":"the / to"},{"g":"flesh"},null,{"g":"if / oneself"}]},{"text":"Tu estragaste tudo.","en":"You ruined everything.","audio":"https://tatoeba.org/en/audio/download/844235","words":[{"g":"you"},null,{"g":"everything"}]},{"text":"Você sempre estraga tudo.","en":"You always spoil everything.","words":[{"g":"you (formal)"},{"g":"always"},null,{"g":"everything"}]},{"text":"Desculpa, eu realmente estraguei tudo.","en":"I'm sorry, I really messed up.","words":[{"g":"sorry!, excuse me"},{"g":"I"},{"g":"truly"},null,{"g":"everything"}]}]}