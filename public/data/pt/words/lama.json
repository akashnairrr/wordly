{"id":"lama","lemma":"lama","pos":"noun","rank":2188,"glosses":["mud (soil and water)"],"ipa":"/ˈlɐ̃.mɐ/","gender":"f","forms":{"plural":"lamas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q5146_%28por%29-NMaia-lama.wav","examples":[{"text":"Eu pisei a lama.","en":"I stepped in the mud.","audio":"https://tatoeba.org/en/audio/download/535266","words":[{"g":"I"},{"g":"to step on, to tread","l":"pisar"},{"g":"the / to"},null]},{"text":"Ela o tirou da lama.","en":"She pulled him out of the mud.","words":[{"g":"she"},{"g":"the / it"},{"g":"to take","l":"tirar"},{"g":"of the"},null]},{"text":"Meu caminhão ficou preso na lama.","en":"My truck got stuck in the mud.","words":[{"g":"my, mine"},{"g":"truck"},{"g":"to become","l":"ficar"},{"g":"arrested"},{"g":"in the"},null]},{"text":"Tom caiu na lama.","en":"Tom fell into the mud.","words":[{"g":"tone"},{"g":"to fall","l":"cair"},{"g":"in the"},null]},{"text":"O meu carro atolou na lama.","en":"My car got stuck in the mud.","words":[{"g":"the / it"},{"g":"my, mine"},{"g":"cart"},null,{"g":"in the"},null]}]}