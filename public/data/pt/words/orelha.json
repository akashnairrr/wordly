{"id":"orelha","lemma":"orelha","pos":"noun","rank":2432,"glosses":["ear","bookflap","the claw of a claw hammer"],"ipa":"/ɔˈɾɐ(j).ʎɐ/","gender":"f","forms":{"plural":"orelhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q5146_%28por%29-Nelson_Ricardo_2500-orelha.wav","examples":[{"text":"Um gato tem duas orelhas.","en":"A cat has two ears.","words":[{"g":"a"},{"g":"cat"},{"g":"has / there is","l":"ter"},{"g":"deuce","l":"dois"},null]},{"text":"Tom sorriu de orelha a orelha.","en":"Tom beamed from ear to ear.","words":[{"g":"tone"},{"g":"to smile","l":"sorrir"},{"g":"of / from"},null,{"g":"the / to"},null]},{"text":"Escuta-se com as orelhas.","en":"We hear with our ears.","words":[{"g":"bug, wire"},{"g":"if / oneself"},{"g":"with"},{"g":"the"},null]},{"text":"Tom pressionou a orelha contra a parede.","en":"Tom pressed his ear against the wall.","words":[{"g":"tone"},{"g":"to press","l":"pressionar"},{"g":"the / to"},null,{"g":"against"},{"g":"the / to"},{"g":"wall"}]},{"text":"Nós temos duas orelhas.","en":"We have two ears.","words":[{"g":"we"},{"g":"to own","l":"ter"},{"g":"deuce","l":"dois"},null]}]}