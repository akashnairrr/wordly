{"id":"orelha","lemma":"orelha","pos":"noun","rank":2546,"glosses":["ear","bookflap","dog-ear"],"ipa":"/oˈɾe.ʎɐ/","gender":"f","forms":{"plural":"orelhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q5146_%28por%29-Nelson_Ricardo_2500-orelha.wav","examples":[{"text":"Um gato tem duas orelhas.","en":"A cat has two ears.","words":[{"g":"a"},{"g":"cat"},{"g":"has / there is","l":"ter"},{"g":"deuce","l":"dois"},null]},{"text":"Nós temos duas orelhas.","en":"We have two ears.","words":[{"g":"we"},{"g":"to own","l":"ter"},{"g":"deuce","l":"dois"},null]},{"text":"Tom colocou a orelha na porta e ouviu.","en":"Tom put his ear to the door and listened.","words":[{"g":"tone"},{"g":"to place","l":"colocar"},{"g":"the / to"},null,{"g":"in the"},{"g":"door"},{"g":"and"},{"g":"to hear","l":"ouvir"}]},{"text":"Escuta-se com as orelhas.","en":"We hear with our ears.","words":[{"g":"bug, wire"},{"g":"if / oneself"},{"g":"with"},{"g":"the"},null]},{"text":"Coloquei o fone na orelha.","en":"I put the receiver to my ear.","words":[{"g":"to place","l":"colocar"},{"g":"the / it"},{"g":"earphone, earpiece"},{"g":"in the"},null]}]}