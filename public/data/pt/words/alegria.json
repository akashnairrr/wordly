{"id":"alegria","lemma":"alegria","pos":"noun","rank":1347,"glosses":["joy, happiness","party; fun","synonym of gergelim"],"ipa":"/a.leˈɡɾi.ɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/56/Br-Alegria.ogg/Br-Alegria.ogg.mp3","gender":"f","forms":{"plural":"alegrias"},"examples":[{"text":"Eu pulei de alegria.","en":"I jumped for joy.","audio":"https://tatoeba.org/en/audio/download/1274232","words":[{"g":"I"},{"g":"to jump","l":"pular"},{"g":"of / from"},null]},{"text":"Ela dançou de alegria.","en":"She danced with joy.","audio":"https://tatoeba.org/en/audio/download/852065","words":[{"g":"she"},{"g":"to dance","l":"dançar"},{"g":"of / from"},null]},{"text":"Não existe alegria sem dor.","en":"There is no pleasure without pain.","words":[{"g":"not / no"},{"g":"to exist","l":"existir"},null,{"g":"-less"},{"g":"pain"}]},{"text":"Isso eu farei com alegria.","en":"I will do it gladly.","words":[{"g":"that"},{"g":"I"},{"g":"to create","l":"fazer"},{"g":"with"},null]},{"text":"Meu coração transbordava de alegria.","en":"My heart was filled with happiness.","words":[{"g":"my, mine"},{"g":"heart"},null,{"g":"of / from"},null]}]}