{"id":"alegria","lemma":"alegria","pos":"noun","rank":1473,"glosses":["joy, happiness","party; fun","synonym of gergelim"],"ipa":"/ɐ.lɨˈɡɾi.ɐ/","gender":"f","forms":{"plural":"alegrias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/de/LL-Q5146_%28por%29-Nelson_Ricardo_2500-alegria.wav","examples":[{"text":"Ela dançou de alegria.","en":"She danced with joy.","audio":"https://tatoeba.org/en/audio/download/852065","words":[{"g":"she"},{"g":"to dance","l":"dançar"},{"g":"of / from"},null]},{"text":"Não existe alegria sem dor.","en":"There is no pleasure without pain.","words":[{"g":"not / no"},{"g":"to exist","l":"existir"},null,{"g":"-less"},{"g":"pain"}]},{"text":"Meu coração transbordava de alegria.","en":"My heart was filled with happiness.","words":[{"g":"my, mine"},{"g":"heart"},null,{"g":"of / from"},null]},{"text":"Eu pulei de alegria.","en":"I jumped for joy.","audio":"https://tatoeba.org/en/audio/download/1274232","words":[{"g":"I"},null,{"g":"of / from"},null]},{"text":"Tom pulou de alegria.","en":"Tom jumped for joy.","words":[{"g":"tone"},{"g":"to jump","l":"pular"},{"g":"of / from"},null]}]}