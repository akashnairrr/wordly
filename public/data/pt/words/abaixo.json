{"id":"abaixo","lemma":"abaixo","pos":"adv","rank":672,"glosses":["down, downwards (towards a lower place)"],"ipa":"/ɐˈbaj.ʃu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e7/LL-Q5146_%28por%29-Santamarcanda-abaixo.wav/LL-Q5146_%28por%29-Santamarcanda-abaixo.wav.mp3","examples":[{"text":"Meu quarto fica logo abaixo.","en":"My room is just below.","words":[{"g":"my, mine"},{"g":"quarter"},{"g":"to become","l":"ficar"},{"g":"soon"},null]},{"text":"Tom rolou janela abaixo.","en":"Tom rolled the window down.","words":[{"g":"tone"},{"g":"to roll","l":"rolar"},{"g":"window"},null]},{"text":"O cavalo troteou estrada abaixo.","en":"The horse trotted down the road.","words":[{"g":"the / it"},{"g":"knight"},null,{"g":"road"},null]},{"text":"Está dez graus abaixo de zero agora.","en":"It is ten degrees below zero now.","words":[{"g":"is","l":"estar"},{"g":"ten"},{"g":"degree","l":"grau"},null,{"g":"of / from"},{"g":"zero"},{"g":"now"}]},{"text":"A temperatura está abaixo de zero hoje.","en":"The temperature is below zero today.","words":[{"g":"the / to"},{"g":"temperature"},{"g":"is","l":"estar"},null,{"g":"of / from"},{"g":"zero"},{"g":"today"}]}]}