{"id":"abaixo","lemma":"abaixo","pos":"adv","rank":985,"glosses":["down, downwards (towards a lower place)"],"ipa":"/aˈbaj.ʃu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e7/LL-Q5146_%28por%29-Santamarcanda-abaixo.wav/LL-Q5146_%28por%29-Santamarcanda-abaixo.wav.mp3","examples":[{"text":"Meu quarto fica logo abaixo.","en":"My room is just below.","words":[{"g":"my, mine"},{"g":"quarter"},{"g":"to become","l":"ficar"},{"g":"soon"},null]},{"text":"Tom quase caiu escada abaixo.","en":"Tom almost fell down the stairs.","words":[{"g":"tone"},{"g":"almost"},{"g":"to fall","l":"cair"},{"g":"ladder"},null]},{"text":"Tom rolou janela abaixo.","en":"Tom rolled the window down.","words":[{"g":"tone"},{"g":"to roll","l":"rolar"},{"g":"window"},null]},{"text":"O cavalo troteou estrada abaixo.","en":"The horse trotted down the road.","words":[{"g":"the / it"},{"g":"knight"},null,{"g":"road"},null]},{"text":"Nós fomos de canoa rio abaixo.","en":"We canoed downstream.","words":[{"g":"we"},{"g":"to go","l":"ir"},{"g":"of / from"},{"g":"canoe"},{"g":"river"},null]}]}