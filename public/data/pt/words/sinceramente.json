{"id":"sinceramente","lemma":"sinceramente","pos":"adv","rank":1462,"glosses":["sincerely"],"ipa":"/sĩˌsɛ.ɾɐˈmẽ.tɨ/","examples":[{"text":"Eu acredito sinceramente nisto.","en":"I honestly believe this.","audio":"https://tatoeba.org/en/audio/download/535842","words":[{"g":"I"},{"g":"to believe","l":"acreditar"},null,{"g":"in this"}]},{"text":"Eu sinceramente espero que você seja vegano.","en":"I sincerely hope that you're vegan.","words":[{"g":"I"},null,{"g":"to wait","l":"esperar"},{"g":"that / what"},{"g":"you (formal)"},{"g":"to be","l":"ser"},null]},{"text":"Eu sinceramente concordo.","en":"I wholeheartedly agree.","words":[{"g":"I"},null,{"g":"to agree","l":"concordar"}]},{"text":"Nós sinceramente pedimos desculpas pelo nosso erro.","en":"We sincerely apologize for our error.","words":[{"g":"we"},null,{"g":"to ask for","l":"pedir"},{"g":"sorry!, excuse me","l":"desculpa"},{"g":"by / for the","l":"pelar"},{"g":"ours being addressed)"},{"g":"error"}]},{"text":"Sinceramente, o seu novo romance não é muito interessante.","en":"Frankly speaking, his new novel is not very interesting.","words":[null,{"g":"the / it"},{"g":"his"},{"g":"recently made or created"},{"g":"novel"},null,null,{"g":"very / a lot"},{"g":"entertaining"}],"phrases":[[5,7,"isn't it"]]}]}