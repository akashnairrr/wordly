{"id":"solto","lemma":"solto","pos":"adj","rank":2330,"glosses":["loose; free"],"ipa":"/ˈsow.tu/","forms":{"feminine":"solta","masculinePlural":"soltos","femininePlural":"soltas","superlative":"o mais solto"},"examples":[{"text":"Este botão está solto.","en":"This button is loose.","audio":"https://tatoeba.org/en/audio/download/1270639","words":[{"g":"this"},{"g":"button"},{"g":"is","l":"estar"},null]},{"text":"Ela usa o cabelo solto.","en":"She wears her hair loose.","words":[{"g":"she"},{"g":"to use","l":"usar"},{"g":"the / it"},{"g":"hair, head of hair"},null]},{"text":"Esse cara tem um parafuso solto!","en":"That guy has a screw loose!","words":[{"g":"that"},{"g":"guy, dude"},{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"screw"},null]},{"text":"Os prisioneiros que fugiram ainda estão soltos.","en":"The escaped prisoners are still on the run.","words":[{"g":"the"},{"g":"prisoner","l":"prisioneiro"},{"g":"that / what"},null,{"g":"still"},{"g":"to be","l":"estar"},null]},{"text":"Ele deixou o cachorro solto no jardim.","en":"He let the dog loose in the garden.","words":[{"g":"he"},{"g":"to leave","l":"deixar"},{"g":"the / it"},{"g":"puppy"},null,{"g":"in the"},{"g":"garden"}]}]}