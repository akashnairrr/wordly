{"id":"solto","lemma":"solto","pos":"adj","rank":3384,"glosses":["loose; free"],"ipa":"/ˈsol.tu/","forms":{"feminine":"solta","masculinePlural":"soltos","femininePlural":"soltas","superlative":"o mais solto"},"examples":[{"text":"Este botão está solto.","en":"This button is loose.","audio":"https://tatoeba.org/en/audio/download/1270639","words":[{"g":"this"},{"g":"button"},{"g":"is","l":"estar"},null]},{"text":"Ela usa o cabelo solto.","en":"She wears her hair loose.","words":[{"g":"she"},{"g":"to use","l":"usar"},{"g":"the / it"},{"g":"hair, head of hair"},null]},{"text":"Tom foi solto da prisão semana passada.","en":"Tom was released from the prison last week.","words":[{"g":"tone"},{"g":"to be","l":"ser"},null,{"g":"of the"},{"g":"prison"},{"g":"week"},{"g":"step"}]},{"text":"Os prisioneiros que fugiram ainda estão soltos.","en":"The escaped prisoners are still on the run.","words":[{"g":"the"},{"g":"prisoner","l":"prisioneiro"},{"g":"that / what"},null,{"g":"still"},{"g":"to be","l":"estar"},null]},{"text":"Esse cara tem um parafuso solto!","en":"That guy has a screw loose!","words":[{"g":"that"},{"g":"face"},{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"screw"},null]}]}