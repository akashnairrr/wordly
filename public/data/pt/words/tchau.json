{"id":"tchau","lemma":"tchau","pos":"noun","rank":2140,"glosses":["goodbye (an instance of wishing goodbye, especially with the word tchau)"],"ipa":"/ˈt͡ʃaw/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5c/LL-Q5146_%28por%29-Santamarcanda-tchau.wav/LL-Q5146_%28por%29-Santamarcanda-tchau.wav.mp3","gender":"m","forms":{"plural":"tchaus"},"examples":[{"text":"Diga tchau aos seus amigos.","en":"Say goodbye to your friends.","words":[{"g":"to speak","l":"dizer"},null,null,{"g":"their or your kin"},{"g":"friendly","l":"amigo"}]},{"text":"Quero dizer tchau.","en":"I want to say goodbye.","words":[{"g":"to want","l":"querer"},{"g":"to speak"},null]},{"text":"Diz tchau para os teus amigos.","en":"Say goodbye to your friends.","words":[{"g":"to speak","l":"dizer"},null,{"g":"for / to"},{"g":"the"},{"g":"your or thy kin"},{"g":"friendly","l":"amigo"}]},{"text":"Eu tenho que dizer tchau.","en":"I've got to say goodbye.","audio":"https://tatoeba.org/en/audio/download/536176","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"that / what"},{"g":"to speak"},null]},{"text":"Tom foi embora sem dizer tchau.","en":"Tom left without saying goodbye.","words":[{"g":"tone"},{"g":"to be","l":"ser"},{"g":"although"},{"g":"-less"},{"g":"to speak"},null]}]}