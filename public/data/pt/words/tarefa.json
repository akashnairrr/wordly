{"id":"tarefa","lemma":"tarefa","pos":"noun","rank":1701,"glosses":["task, job","burden, chore","piece work (type of employment where wages are calculated per unit of tasks performed)"],"ipa":"/tɐˈɾɛ.fɐ/","gender":"f","forms":{"plural":"tarefas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q5146_%28por%29-MedK1-tarefa.wav","examples":[{"text":"Esta tarefa é difícil para mim.","en":"This task is difficult for me.","words":[{"g":"this","l":"este"},null,{"g":"is","l":"ser"},{"g":"difficult"},{"g":"for / to"},{"g":"me"}]},{"text":"A tarefa é fácil.","en":"The task is simple.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"easy"}]},{"text":"Quem lhe deu essa tarefa?","en":"Who gave you that task?","words":[{"g":"who"},{"g":"(to) him / her"},{"g":"to transfer one’s…","l":"dar"},{"g":"that, that one","l":"esse"},null]},{"text":"Eu tenho algumas tarefas para fazer.","en":"I have some chores to do.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"some, any","l":"algum"},null,{"g":"for / to"},{"g":"to create"}]},{"text":"Tenho uma tarefa para você.","en":"I have a job for you.","words":[{"g":"have","l":"ter"},{"g":"a","l":"um"},null,{"g":"for / to"},{"g":"you (formal)"}]}]}