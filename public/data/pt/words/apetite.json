{"id":"apetite","lemma":"apetite","pos":"noun","rank":2663,"glosses":["appetite","craving","desire; passion; ambition"],"ipa":"/ɐ.pɨˈti.tɨ/","gender":"m","forms":{"plural":"apetites"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q5146_%28por%29-MedK1-apetite.wav","examples":[{"text":"Ele tem um bom apetite.","en":"He has a good appetite.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"desirable"},null]},{"text":"Estou sem apetite.","en":"I have no appetite.","words":[{"g":"am","l":"estar"},{"g":"-less"},null]},{"text":"Eu não tenho muito apetite ultimamente.","en":"I don't have much appetite lately.","words":[{"g":"I"},{"g":"not / no"},{"g":"have","l":"ter"},{"g":"very / a lot"},null,{"g":"lately"}]},{"text":"Tom perdeu o apetite.","en":"Tom lost his appetite.","words":[{"g":"tone"},{"g":"to lose","l":"perder"},{"g":"the / it"},null]},{"text":"Ele estava sem apetite devido ao calor.","en":"He had no appetite because of the heat.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"-less"},null,{"g":"due, owing"},{"g":"to the"},{"g":"heat"}]}]}