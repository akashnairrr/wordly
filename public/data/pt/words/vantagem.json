{"id":"vantagem","lemma":"vantagem","pos":"noun","rank":1556,"glosses":["advantage, vantage","benefit"],"ipa":"/vɐ̃ˈta.ʒɐ̃j̃/","gender":"f","forms":{"plural":"vantagens"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q5146_%28por%29-Ed_Guimaraes-vantagem.wav","examples":[{"text":"Tem muitas vantagens.","en":"There are many advantages.","audio":"https://tatoeba.org/en/audio/download/1265565","words":[{"g":"has / there is","l":"ter"},{"g":"very, a lot","l":"muito"},null]},{"text":"Isso seria uma vantagem.","en":"That would be a plus.","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},null]},{"text":"Ele tirou vantagem de mim.","en":"He took advantage of me.","words":[{"g":"he"},{"g":"to take","l":"tirar"},null,{"g":"of / from"},{"g":"me"}]},{"text":"Qual é a vantagem dessa tecnologia?","en":"What are the advantages of this technology?","words":[{"g":"which"},{"g":"is","l":"ser"},{"g":"the / to"},null,{"g":"of that"},{"g":"technology"}]},{"text":"Há um monte de vantagens.","en":"There are lots of advantages.","words":[{"g":"there be","l":"haver"},null,null,{"g":"of / from"},null],"phrases":[[1,3,"a lot"]]}]}