{"id":"conversa","lemma":"conversa","pos":"noun","rank":467,"glosses":["conversation; talking","an instance of conversation"],"ipa":"/kõˈvɛɾ.sɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d9/LL-Q5146_%28por%29-Santamarcanda-conversa.wav/LL-Q5146_%28por%29-Santamarcanda-conversa.wav.mp3","gender":"f","forms":{"plural":"conversas"},"examples":[{"text":"Ele conversa muito.","en":"He talks a lot.","words":[{"g":"he"},null,{"g":"very / a lot"}]},{"text":"Precisamos ter uma conversa.","en":"We need to have a talk.","words":[{"g":"to need","l":"precisar"},{"g":"to own"},{"g":"a","l":"um"},null]},{"text":"Você conversa com seus vizinhos?","en":"Do you talk with your neighbors?","words":[{"g":"you (formal)"},null,{"g":"with"},{"g":"their or your kin"},{"g":"neighbouring","l":"vizinho"}]},{"text":"A conversa hoje foi sobre dinheiro.","en":"Today's talk was about money.","words":[{"g":"the / to"},null,{"g":"today"},{"g":"to be","l":"ser"},{"g":"on"},{"g":"money"}]},{"text":"Eu não tomei parte na conversa.","en":"I didn't take part in the conversation.","words":[{"g":"I"},{"g":"not / no"},{"g":"to take","l":"tomar"},{"g":"part"},{"g":"in the"},null]}]}