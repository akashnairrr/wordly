{"id":"fita","lemma":"fita","pos":"noun","rank":1642,"glosses":["tape, ribbon, band","film, movie","a colored ribbon to indicate membership of a faculty"],"ipa":"/ˈfi.tɐ/","gender":"f","forms":{"plural":"fitas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q5146_%28por%29-Wiktionairy-fita.wav","examples":[{"text":"Preciso daquela fita.","en":"I need that tape.","words":[{"g":"to need","l":"precisar"},null,null]},{"text":"Eu preciso da fita.","en":"I need the tape.","words":[{"g":"I"},{"g":"to need","l":"precisar"},{"g":"of the"},null]},{"text":"Precisamos destruir esta fita.","en":"We need to destroy this tape.","words":[{"g":"to need","l":"precisar"},{"g":"to ruin, devastate"},{"g":"this","l":"este"},null]},{"text":"Você também ganhou uma fita?","en":"Did you win a ribbon, too?","words":[{"g":"you (formal)"},{"g":"also"},{"g":"to win","l":"ganhar"},{"g":"a","l":"um"},null]},{"text":"Não tem fita nesta câmera.","en":"There's no film in this camera.","words":[{"g":"not / no"},{"g":"has / there is","l":"ter"},null,{"g":"in this"},null]}]}