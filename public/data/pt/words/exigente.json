{"id":"exigente","lemma":"exigente","pos":"adj","rank":4875,"glosses":["demanding, picky, exacting, choosy, fussy, tough, fastidious, finicky (hard to please)","demanding, challenging, taxing","exigent (needing immediate action)"],"ipa":"/i.ziˈʒẽ.tɨ/","forms":{"plural":"exigentes","superlative":"o mais exigente"},"examples":[{"text":"Tom era exigente.","en":"Tom used to be demanding.","audio":"https://tatoeba.org/en/audio/download/1270975","words":[{"g":"tone"},{"g":"to be","l":"ser"},null]},{"text":"Não seja tão exigente.","en":"Don't be so choosy.","audio":"https://tatoeba.org/en/audio/download/845346","words":[{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"so"},null]},{"text":"Pare de ser tão exigente.","en":"Stop being so picky.","words":[{"g":"to stop","l":"parar"},{"g":"of / from"},{"g":"to be"},{"g":"so"},null]},{"text":"Você é exigente.","en":"You're demanding.","words":[{"g":"you (formal)"},{"g":"is","l":"ser"},null]},{"text":"Tom é muito exigente.","en":"Tom is fussy.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"very / a lot"},null]}]}