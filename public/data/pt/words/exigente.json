{"id":"exigente","lemma":"exigente","pos":"adj","rank":4642,"glosses":["demanding, picky, exacting, choosy, fussy, tough, fastidious, finicky (hard to please)","demanding, challenging, taxing","exigent (needing immediate action)"],"ipa":"/e.ziˈʒẽ.t͡ʃi/","forms":{"plural":"exigentes","superlative":"o mais exigente"},"examples":[{"text":"Tom era exigente.","en":"Tom used to be demanding.","audio":"https://tatoeba.org/en/audio/download/1270975","words":[{"g":"tone"},{"g":"to be","l":"ser"},null]},{"text":"Não seja tão exigente.","en":"Don't be so choosy.","audio":"https://tatoeba.org/en/audio/download/845346","words":[{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"so"},null]},{"text":"Você é exigente.","en":"You're demanding.","words":[{"g":"you"},{"g":"is","l":"ser"},null]},{"text":"Eu não sou exigente.","en":"I'm not fussy.","words":[{"g":"I"},{"g":"not / no"},{"g":"am","l":"ser"},null]},{"text":"Pare de ser tão exigente.","en":"Stop being so picky.","words":[{"g":"to stop","l":"parar"},{"g":"of / from"},{"g":"to be"},{"g":"so"},null]}]}