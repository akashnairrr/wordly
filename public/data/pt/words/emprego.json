{"id":"emprego","lemma":"emprego","pos":"noun","rank":493,"glosses":["job (economic role for which a person is paid)","use; usage (the act of using something or the way something is used)","employment (the state of being employed)"],"ipa":"/ẽˈpɾe.ɡu/","gender":"m","forms":{"plural":"empregos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q5146_%28por%29-Nelson_Ricardo_2500-emprego.wav","examples":[{"text":"Tom tem um segundo emprego.","en":"Tom has a second job.","audio":"https://tatoeba.org/en/audio/download/535007","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"second"},null]},{"text":"Precisamos criar mais empregos.","en":"We need to create more jobs.","audio":"https://tatoeba.org/en/audio/download/1268235","words":[{"g":"to need","l":"precisar"},{"g":"to create"},{"g":"more"},null]},{"text":"Só quero um emprego.","en":"I just want a job.","audio":"https://tatoeba.org/en/audio/download/471636","words":[{"g":"only"},{"g":"to want","l":"querer"},{"g":"a"},null]},{"text":"Preciso conseguir um emprego.","en":"I need to get a job.","words":[{"g":"to need","l":"precisar"},{"g":"to get, obtain"},{"g":"a"},null]},{"text":"Tom trabalha em dois empregos.","en":"Tom works two jobs.","audio":"https://tatoeba.org/en/audio/download/494722","words":[{"g":"tone"},{"g":"to work","l":"trabalhar"},{"g":"in"},{"g":"deuce"},null]}]}