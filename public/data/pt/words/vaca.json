{"id":"vaca","lemma":"vaca","pos":"noun","rank":1615,"glosses":["a cow","beef (meat)","a promiscuous woman; a bitch"],"ipa":"/ˈva.kɐ/","gender":"f","forms":{"plural":"vacas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q5146_%28por%29-Nelson_Ricardo_2500-vaca.wav","examples":[{"text":"Tom tem uma vaca.","en":"Tom has a cow.","audio":"https://tatoeba.org/en/audio/download/489725","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},null]},{"text":"Ele tem dez vacas.","en":"He has ten cows.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},{"g":"ten"},null]},{"text":"Eu tenho uma vaca.","en":"I have a cow.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"a","l":"um"},null]},{"text":"Nunca vi uma vaca de verdade.","en":"I've never seen a real cow.","words":[{"g":"never (at no time"},{"g":"to see","l":"ver"},{"g":"a","l":"um"},null,null,null],"phrases":[[4,6,"in a way that is not…"]]},{"text":"Eu não tenho vacas.","en":"I don't have any cows.","words":[{"g":"I"},{"g":"not / no"},{"g":"have","l":"ter"},null]}]}