{"id":"esquecido","lemma":"esquecido","pos":"adj","rank":1686,"glosses":["forgotten","forgetful"],"ipa":"/(i)ʃ.kɛˈsi.du/","forms":{"feminine":"esquecida","masculinePlural":"esquecidos","femininePlural":"esquecidas","superlative":"o mais esquecido"},"examples":[{"text":"Tom é muito esquecido.","en":"Tom is very forgetful.","audio":"https://tatoeba.org/en/audio/download/534080","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"very / a lot"},null]},{"text":"Seu nome foi esquecido.","en":"His name was forgotten.","words":[{"g":"his"},{"g":"name"},{"g":"to be","l":"ser"},null]},{"text":"Vocês são bastante esquecidos, não são?","en":"You're quite forgetful, aren't you?","words":[{"g":"you (pl.)"},{"g":"to be","l":"ser"},{"g":"enough"},null,{"g":"not / no"},{"g":"to be","l":"ser"}]},{"text":"Você é realmente esquecida, não é?","en":"You're quite forgetful, aren't you?","words":[{"g":"you (formal)"},{"g":"is","l":"ser"},{"g":"truly"},null,null,null],"phrases":[[4,6,"isn't it"]]},{"text":"Em alguns meses, isso será esquecido.","en":"It'll be forgotten in a few months' time.","words":[{"g":"in"},{"g":"some, any","l":"algum"},{"g":"month","l":"mês"},{"g":"that"},{"g":"to be","l":"ser"},null]}]}