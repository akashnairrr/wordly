{"id":"frango","lemma":"frango","pos":"noun","rank":1447,"glosses":["young chicken","poultry (chicken meat)","young boy"],"ipa":"/ˈfɾɐ̃.ɡu/","gender":"m","forms":{"plural":"frangos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q5146_%28por%29-Nelson_Ricardo_2500-frango.wav","examples":[{"text":"Sabe cozinhar frango?","en":"Do you know how to cook chicken?","words":[{"g":"to be aware, to know","l":"saber"},{"g":"to cook , to bake"},null]},{"text":"Vocês conseguem pegar o frango?","en":"Can you catch the chicken?","audio":"https://tatoeba.org/en/audio/download/469709","words":[{"g":"you (pl.)"},{"g":"to get, obtain","l":"conseguir"},{"g":"to grab, hold"},{"g":"the / it"},null]},{"text":"Ele pegou o frango.","en":"He caught the chicken.","words":[{"g":"he"},{"g":"to grab, hold","l":"pegar"},{"g":"the / it"},null]},{"text":"O frango estava ótimo.","en":"The chicken was great.","words":[{"g":"the / it"},null,{"g":"to be","l":"estar"},{"g":"great"}]},{"text":"Eu como frango.","en":"I eat chicken.","words":[{"g":"I"},{"g":"how / like"},null]}]}