{"id":"chuveiro","lemma":"chuveiro","pos":"noun","rank":2784,"glosses":["cloudburst","shower (device for bathing)"],"ipa":"/ʃuˈve(j).ɾu/","gender":"m","forms":{"plural":"chuveiros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q5146_%28por%29-Wiktionairy-chuveiro.wav","examples":[{"text":"Não está saindo água do chuveiro.","en":"Water is not coming out of the shower.","words":[{"g":"not / no"},{"g":"is","l":"estar"},{"g":"to exit","l":"sair"},{"g":"water"},{"g":"of the"},null]},{"text":"Onde ficam os chuveiros?","en":"Where are the showers?","words":[{"g":"where"},{"g":"to become","l":"ficar"},{"g":"the"},null]},{"text":"Quero um quarto com chuveiro.","en":"I want a room with a shower.","words":[{"g":"to want","l":"querer"},{"g":"a"},{"g":"quarter"},{"g":"with"},null]},{"text":"Eu vou entrar no chuveiro.","en":"I'll take a shower.","audio":"https://tatoeba.org/en/audio/download/494483","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"to enter"},{"g":"in the"},null]},{"text":"Eu acabei de sair do chuveiro.","en":"I just got out of the shower.","words":[{"g":"I"},{"g":"to finish","l":"acabar"},{"g":"of / from"},{"g":"to exit"},{"g":"of the"},null]}]}