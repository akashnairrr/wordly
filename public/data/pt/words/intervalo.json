{"id":"intervalo","lemma":"intervalo","pos":"noun","rank":2197,"glosses":["interval (distance in space)","interval (period of time)","interval (difference in pitch between two notes)"],"ipa":"/ĩ.teʁˈva.lu/","gender":"m","forms":{"plural":"intervalos"},"examples":[{"text":"Quando é o intervalo?","en":"When is the intermission?","audio":"https://tatoeba.org/en/audio/download/856805","words":[{"g":"when"},{"g":"is","l":"ser"},{"g":"the / it"},null]},{"text":"Fui ao banheiro durante o intervalo.","en":"I went to the restroom during the intermission.","words":[{"g":"to go","l":"ir"},null,{"g":"bathroom, lavatory"},{"g":"during"},{"g":"the / it"},null]},{"text":"Tom não precisava tirar intervalo.","en":"Tom didn't need to take a break.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to need","l":"precisar"},{"g":"to take"},null]},{"text":"É hora do intervalo.","en":"It's break time.","audio":"https://tatoeba.org/en/audio/download/841552","words":[{"g":"is","l":"ser"},{"g":"hour"},{"g":"of the"},null]},{"text":"Eu ganhei um intervalo.","en":"I've earned a break.","words":[{"g":"I"},{"g":"to win","l":"ganhar"},{"g":"a"},null]}]}