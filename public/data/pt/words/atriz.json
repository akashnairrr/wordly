{"id":"atriz","lemma":"atriz","pos":"noun","rank":2113,"glosses":["actress (female equivalent of ator)"],"ipa":"/aˈtɾis/","gender":"f","forms":{"plural":"atrizes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q5146_%28por%29-Jessie_Edwin_Lawrence-atriz.wav","examples":[{"text":"Eu quero ser atriz.","en":"I want to be an actress.","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"to be"},null]},{"text":"Minha namorada é atriz.","en":"My girlfriend is an actress.","words":[{"g":"my, mine","l":"meu"},{"g":"boyfriend","l":"namorado"},{"g":"is","l":"ser"},null]},{"text":"Ela virou atriz.","en":"She became an actress.","words":[{"g":"she"},{"g":"to turn","l":"virar"},null]},{"text":"Você parece uma atriz.","en":"You look like an actress.","words":[{"g":"you"},{"g":"to seem","l":"parecer"},{"g":"a","l":"um"},null]},{"text":"Eu falei com a própria atriz.","en":"I spoke to the actress herself.","words":[{"g":"I"},{"g":"to speak","l":"falar"},{"g":"with"},{"g":"the / to"},{"g":"own","l":"próprio"},null]}]}