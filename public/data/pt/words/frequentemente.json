{"id":"frequentemente","lemma":"frequentemente","pos":"adv","rank":3656,"glosses":["frequently, often"],"ipa":"/fɾeˌkwẽ.t͡ʃiˈmẽ.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q5146_%28por%29-Wiktionairy-frequentemente.wav","examples":[{"text":"Você nada frequentemente?","en":"Do you swim often?","audio":"https://tatoeba.org/en/audio/download/840342","words":[{"g":"you"},{"g":"nothing"},null]},{"text":"Eu como aqui frequentemente.","en":"I often eat here.","audio":"https://tatoeba.org/en/audio/download/493484","words":[{"g":"I"},{"g":"how / like"},{"g":"here"},null]},{"text":"Frequentemente vou à praia.","en":"I often go to the beach.","audio":"https://tatoeba.org/en/audio/download/535901","words":[null,{"g":"to go","l":"ir"},{"g":"forms adverbs meaning…"},{"g":"beach"}]},{"text":"Ele frequentemente ajuda os outros.","en":"He often helps others.","words":[{"g":"he"},null,{"g":"help, assistance, aid"},{"g":"the"},{"g":"other one","l":"outro"}]},{"text":"Tenho frequentemente o mesmo sonho.","en":"I often have the same dream.","words":[{"g":"have","l":"ter"},null,null,null,{"g":"dream"}],"phrases":[[2,4,"the latter, he/she/it"]]}]}