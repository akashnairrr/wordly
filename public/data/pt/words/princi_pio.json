{"id":"princi_pio","lemma":"princípio","pos":"noun","rank":1321,"glosses":["start, beginning","principle"],"ipa":"/pɾĩˈsi.pju/","gender":"m","forms":{"plural":"princípios"},"examples":[{"text":"Tom não tem princípios.","en":"Tom has no principles.","audio":"https://tatoeba.org/en/audio/download/280802","words":[{"g":"tone"},{"g":"not / no"},{"g":"has / there is","l":"ter"},null]},{"text":"Ela gostou dele desde o princípio.","en":"She liked him right off.","words":[{"g":"she"},{"g":"to like","l":"gostar"},{"g":"his / of him","l":"delir"},{"g":"since"},{"g":"the / it"},null]},{"text":"É uma questão de princípios.","en":"It's a question of principle.","words":[{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"question"},{"g":"of / from"},null]},{"text":"Ele não entende o princípio da coisa.","en":"He doesn't understand the principle of the thing.","words":[{"g":"he"},{"g":"not / no"},{"g":"to understand","l":"entender"},{"g":"the / it"},null,{"g":"of the"},{"g":"thing"}]},{"text":"Tem sido assim desde o princípio dos tempos.","en":"It’s been like this since the dawn of time.","words":[{"g":"has / there is","l":"ter"},{"g":"to be","l":"ser"},{"g":"this way"},{"g":"since"},{"g":"the / it"},null,null,{"g":"time","l":"tempo"}]}]}