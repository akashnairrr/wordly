{"id":"depressa","lemma":"depressa","pos":"adv","rank":716,"glosses":["quickly"],"ipa":"/deˈpɾɛ.sɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/LL-Q5146_%28por%29-Santamarcanda-depressa.wav/LL-Q5146_%28por%29-Santamarcanda-depressa.wav.mp3","examples":[{"text":"Venha depressa.","en":"Come quickly!","audio":"https://tatoeba.org/en/audio/download/1269524","words":[{"g":"to come","l":"vir"},null]},{"text":"O tempo passou muito depressa.","en":"The time has passed very quickly.","words":[{"g":"the / it"},{"g":"time"},{"g":"to pass","l":"passar"},{"g":"very / a lot"},null]},{"text":"Não fale tão depressa assim.","en":"Don't speak so fast.","audio":"https://tatoeba.org/en/audio/download/1269498","words":[{"g":"not / no"},{"g":"to speak","l":"falar"},{"g":"so"},null,{"g":"this way"}]},{"text":"Ele faz tudo depressa.","en":"He does everything very quickly.","words":[{"g":"he"},{"g":"to create","l":"fazer"},{"g":"everything"},null]},{"text":"Pode ir mais depressa?","en":"Can you go faster?","words":[{"g":"to be able to","l":"poder"},{"g":"to go"},{"g":"more"},null]}]}