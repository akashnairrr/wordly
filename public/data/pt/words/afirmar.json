{"id":"afirmar","lemma":"afirmar","pos":"verb","rank":3592,"glosses":["to state; to declare; to affirm (to make a declaration)","to confirm; to attest (to affirm to be correct, true or genuine)","to consolidate (to make firm, secure)"],"ipa":"/ɐ.fiɾˈmaɾ/","conjugation":{"indicative":{"present":{"1s":"afirmo","2s":"afirmas","3s":"afirma","1p":"afirmamos","2p":"afirmais","3p":"afirmam"},"imperfect":{"1s":"afirmava","2s":"afirmavas","3s":"afirmava","1p":"afirmávamos","2p":"afirmáveis","3p":"afirmavam"},"preterite":{"1s":"afirmei","2s":"afirmaste","3s":"afirmou","1p":"afirmámos","2p":"afirmastes","3p":"afirmaram"},"future":{"1s":"afirmarei","2s":"afirmarás","3s":"afirmará","1p":"afirmaremos","2p":"afirmareis","3p":"afirmarão"},"conditional":{"1s":"afirmaria","2s":"afirmarias","3s":"afirmaria","1p":"afirmaríamos","2p":"afirmaríeis","3p":"afirmariam"}},"subjunctive":{"present":{"1s":"afirme","2s":"afirmes","3s":"afirme","1p":"afirmemos","2p":"afirmeis","3p":"afirmem"},"imperfect":{"1s":"afirmasse","2s":"afirmasses","3s":"afirmasse","1p":"afirmássemos","2p":"afirmásseis","3p":"afirmassem"}},"imperative":{"affirmative":{"2s":"afirma","3s":"afirme","1p":"afirmemos","2p":"afirmai","3p":"afirmem"},"negative":{"2s":"não afirmes","3s":"não afirme","1p":"não afirmemos","2p":"não afirmeis","3p":"não afirmem"}}},"nonFinite":{"gerund":"afirmando","participle":"afirmado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q5146_%28por%29-Ed_Guimaraes-afirmar.wav","examples":[{"text":"Tom afirma não ter visto ninguém.","en":"Tom says he didn't see anybody.","audio":"https://tatoeba.org/en/audio/download/485098","words":[{"g":"tone"},null,{"g":"not / no"},{"g":"to own"},{"g":"to see","l":"ver"},{"g":"no one"}]},{"text":"O que lhe faz afirmar isto?","en":"What makes you say that?","words":[null,null,{"g":"(to) him / her"},{"g":"to create","l":"fazer"},null,{"g":"this"}],"phrases":[[0,2,"what"]]},{"text":"Ele afirma que é verdade.","en":"He maintains that it's true.","words":[{"g":"he"},null,{"g":"that / what"},{"g":"is","l":"ser"},{"g":"truth"}]},{"text":"Não dá para afirmar com certeza.","en":"It's hard to say for sure.","words":[{"g":"not / no"},{"g":"to transfer one’s…","l":"dar"},{"g":"for / to"},null,null,null],"phrases":[[4,6,"surely, with certainty"]]},{"text":"Ela afirmou ser a proprietária da terra.","en":"She claimed to be the owner of the land.","words":[{"g":"she"},null,{"g":"to be"},{"g":"the / to"},{"g":"owner","l":"proprietário"},{"g":"of the"},{"g":"land"}]}]}