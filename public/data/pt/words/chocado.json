{"id":"chocado","lemma":"chocado","pos":"adj","rank":3687,"glosses":["shocked (surprised, startled, confused or taken aback)"],"ipa":"/ʃoˈka.du/","forms":{"feminine":"chocada","masculinePlural":"chocados","femininePlural":"chocadas"},"examples":[{"text":"Eu fiquei totalmente chocado.","en":"I was totally shocked.","audio":"https://tatoeba.org/en/audio/download/535855","words":[{"g":"I"},{"g":"to become","l":"ficar"},{"g":"totally"},null]},{"text":"Nós estamos chocados.","en":"We're shocked.","audio":"https://tatoeba.org/en/audio/download/1272482","words":[{"g":"we"},{"g":"to be","l":"estar"},null]},{"text":"Estou ainda chocado.","en":"I'm still in shock.","audio":"https://tatoeba.org/en/audio/download/494581","words":[{"g":"am","l":"estar"},{"g":"still"},null]},{"text":"Eu sei que você está chocada.","en":"I know you're shocked.","words":[{"g":"I"},{"g":"to be aware, to know","l":"saber"},{"g":"that / what"},{"g":"you"},{"g":"is","l":"estar"},null]},{"text":"Fiquei chocado ao ver isto.","en":"I was shocked to see this.","words":[{"g":"to become","l":"ficar"},null,null,{"g":"to see"},{"g":"this"}]}]}