{"id":"ceder","lemma":"ceder","pos":"verb","rank":3077,"glosses":["to cede, to give up, to give away, to hand over, to give (one's own property or rights to others)","to lend","to decide in favor (against one's own previous decision or after doubt)"],"ipa":"/sɨˈdeɾ/","conjugation":{"indicative":{"present":{"1s":"cedo","2s":"cedes","3s":"cede","1p":"cedemos","2p":"cedeis","3p":"cedem"},"imperfect":{"1s":"cedia","2s":"cedias","3s":"cedia","1p":"cedíamos","2p":"cedíeis","3p":"cediam"},"preterite":{"1s":"cedi","2s":"cedeste","3s":"cedeu","1p":"cedemos","2p":"cedestes","3p":"cederam"},"future":{"1s":"cederei","2s":"cederás","3s":"cederá","1p":"cederemos","2p":"cedereis","3p":"cederão"},"conditional":{"1s":"cederia","2s":"cederias","3s":"cederia","1p":"cederíamos","2p":"cederíeis","3p":"cederiam"}},"subjunctive":{"present":{"1s":"ceda","2s":"cedas","3s":"ceda","1p":"cedamos","2p":"cedais","3p":"cedam"},"imperfect":{"1s":"cedesse","2s":"cedesses","3s":"cedesse","1p":"cedêssemos","2p":"cedêsseis","3p":"cedessem"}},"imperative":{"affirmative":{"2s":"cede","3s":"ceda","1p":"cedamos","2p":"cedei","3p":"cedam"},"negative":{"2s":"não cedas","3s":"não ceda","1p":"não cedamos","2p":"não cedais","3p":"não cedam"}}},"nonFinite":{"gerund":"cedendo","participle":"cedido"},"formAudio":{"cedo":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q5146_%28por%29-Nelson_Ricardo_2500-cedo.wav"},"examples":[{"text":"A ponte cedeu.","en":"The bridge gave way.","audio":"https://tatoeba.org/en/audio/download/843707","words":[{"g":"the / to"},{"g":"bridge"},null]},{"text":"Ele nunca cede, mesmo quando está errado.","en":"He will never give in even when he is wrong.","words":[{"g":"he"},{"g":"never (at no time"},null,{"g":"really"},{"g":"when"},{"g":"is","l":"estar"},{"g":"not correct"}]},{"text":"Cedi meu lugar a uma senhora.","en":"I gave up my seat to an old lady.","words":[null,{"g":"my, mine"},{"g":"place"},{"g":"the / to"},{"g":"a","l":"um"},{"g":"lady"}]},{"text":"O exército cedeu a cidade ao inimigo.","en":"The army abandoned the town to the enemy.","words":[{"g":"the / it"},{"g":"army"},null,{"g":"the / to"},{"g":"city, town"},{"g":"to the"},{"g":"enemy"}]},{"text":"Os joelhos dele cederam.","en":"His knees gave way.","words":[{"g":"the"},{"g":"knee","l":"joelho"},{"g":"his / of him","l":"delir"},null]}]}