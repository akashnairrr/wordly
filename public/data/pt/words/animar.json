{"id":"animar","lemma":"animar","pos":"verb","rank":3809,"glosses":["to cheer someone up (to make someone stop being sad)","to cheer up (to stop being sad)","to inspire; to enliven"],"ipa":"/a.niˈma(ʁ)/","conjugation":{"indicative":{"present":{"1s":"animo","2s":"animas","3s":"anima","1p":"animamos","2p":"animais","3p":"animam"},"imperfect":{"1s":"animava","2s":"animavas","3s":"animava","1p":"animávamos","2p":"animáveis","3p":"animavam"},"preterite":{"1s":"animei","2s":"animaste","3s":"animou","1p":"animamos","2p":"animastes","3p":"animaram"},"future":{"1s":"animarei","2s":"animarás","3s":"animará","1p":"animaremos","2p":"animareis","3p":"animarão"},"conditional":{"1s":"animaria","2s":"animarias","3s":"animaria","1p":"animaríamos","2p":"animaríeis","3p":"animariam"}},"subjunctive":{"present":{"1s":"anime","2s":"animes","3s":"anime","1p":"animemos","2p":"animeis","3p":"animem"},"imperfect":{"1s":"animasse","2s":"animasses","3s":"animasse","1p":"animássemos","2p":"animásseis","3p":"animassem"}},"imperative":{"affirmative":{"2s":"anima","3s":"anime","1p":"animemos","2p":"animai","3p":"animem"},"negative":{"2s":"não animes","3s":"não anime","1p":"não animemos","2p":"não animeis","3p":"não animem"}}},"nonFinite":{"gerund":"animando","participle":"animado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-animar.wav","formAudio":{"animais":"https://upload.wikimedia.org/wikipedia/commons/4/42/LL-Q5146_%28por%29-Nelson_Ricardo_2500-animais.wav"},"examples":[{"text":"Eu sei o que irá te animar.","en":"I know what'll cheer you up.","words":[{"g":"I"},{"g":"to be aware, to know","l":"saber"},null,null,{"g":"to go","l":"ir"},{"g":"you"},null],"phrases":[[2,4,"what"]]},{"text":"Não se anime.","en":"Don't get excited.","audio":"https://tatoeba.org/en/audio/download/79397","words":[{"g":"not / no"},{"g":"if / oneself"},null]},{"text":"Sua chegada animou a festa.","en":"His arrival pepped up the party.","words":[{"g":"his","l":"seu"},{"g":"arrival"},null,{"g":"the / to"},{"g":"party"}]},{"text":"Tom me animou a aprender o francês.","en":"Tom encouraged me to learn French.","audio":"https://tatoeba.org/en/audio/download/485273","words":[{"g":"tone"},{"g":"me"},null,{"g":"the / to"},{"g":"to learn"},{"g":"the / it"},{"g":"French"}]},{"text":"É preciso que alguém a anime um pouco.","en":"She needs a little cheering up.","words":[{"g":"is","l":"ser"},{"g":"precise"},{"g":"that / what"},{"g":"somebody"},{"g":"the / to"},null,null,null],"phrases":[[6,8,"slightly"]]}]}