{"id":"esto_mago","lemma":"estômago","pos":"noun","rank":1479,"glosses":["stomach (organ that stores food)"],"ipa":"/isˈtõ.ma.ɡu/","gender":"m","forms":{"plural":"estômagos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d2/LL-Q5146_%28por%29-Nelson_Ricardo_2500-est%C3%B4mago.wav","examples":[{"text":"O meu estômago dói.","en":"My stomach hurts.","words":[{"g":"the / it"},{"g":"my, mine"},null,{"g":"to hurt","l":"doer"}]},{"text":"Meu estômago está cheio.","en":"My stomach's full.","words":[{"g":"my, mine"},null,{"g":"is","l":"estar"},{"g":"full"}]},{"text":"Você está com dor de estômago?","en":"Do you have a stomachache?","words":[{"g":"you"},{"g":"is","l":"estar"},{"g":"with"},{"g":"pain"},{"g":"of / from"},null]},{"text":"Tenho dor no estômago.","en":"My stomach hurts.","words":[{"g":"have","l":"ter"},{"g":"pain"},{"g":"in the"},null]},{"text":"Eu estou com dor de estômago, doutor.","en":"I have a stomachache, doctor.","words":[{"g":"I"},{"g":"am","l":"estar"},{"g":"with"},{"g":"pain"},{"g":"of / from"},null,{"g":"a doctor"}]}]}