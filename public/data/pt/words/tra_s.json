{"id":"tra_s","lemma":"trás","pos":"noun","rank":350,"glosses":["behind, rear"],"ipa":"/ˈtɾaʃ/","gender":"f","forms":{"plural":"trases"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q5146_%28por%29-Nelson_Ricardo_2500-tr%C3%A1s.wav","examples":[{"text":"Ela ficou para trás com alguns amigos.","en":"She stayed behind with some friends.","words":[{"g":"she"},{"g":"to become","l":"ficar"},{"g":"for / to"},null,{"g":"with"},{"g":"some, any","l":"algum"},{"g":"friendly","l":"amigo"}]},{"text":"Não me deixe para trás!","en":"Don't leave me behind!","words":[{"g":"not / no"},{"g":"me"},{"g":"to leave","l":"deixar"},{"g":"for / to"},null]},{"text":"Tom deixou algo para trás.","en":"Tom left something behind.","words":[{"g":"tone"},{"g":"to leave","l":"deixar"},{"g":"something"},{"g":"for / to"},null]},{"text":"Um homem apareceu de trás da porta.","en":"A man appeared from behind the door.","words":[{"g":"a"},{"g":"male"},{"g":"to appear","l":"aparecer"},{"g":"of / from"},null,{"g":"of the"},{"g":"door"}]},{"text":"O que eu deixei para trás?","en":"What did I leave behind?","words":[null,null,{"g":"I"},{"g":"to leave","l":"deixar"},{"g":"for / to"},null],"phrases":[[0,2,"what"]]}]}