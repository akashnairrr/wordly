{"id":"juventude","lemma":"juventude","pos":"noun","rank":2199,"glosses":["youth (quality or state of being young)"],"ipa":"/ʒu.vẽˈtu.d͡ʒi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/LL-Q5146_%28por%29-MedK1-juventude.wav/LL-Q5146_%28por%29-MedK1-juventude.wav.mp3","gender":"f","examples":[{"text":"Passei minha juventude lá.","en":"I spent my youth there.","words":[{"g":"to pass","l":"passar"},{"g":"my, mine","l":"meu"},null,{"g":"there"}]},{"text":"Os jovens desperdiçam a juventude.","en":"Youth is wasted on the young.","words":[{"g":"the"},{"g":"young, youthful","l":"jovem"},{"g":"to waste, squander","l":"desperdiçar"},{"g":"the / to"},null]},{"text":"A juventude é desperdiçada nos jovens.","en":"Youth is wasted on the young.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},null,{"g":"us","l":"nós"},{"g":"young, youthful","l":"jovem"}]},{"text":"Isso me recorda minha juventude.","en":"It reminds me of my youth.","words":[{"g":"that"},{"g":"me"},{"g":"to remember","l":"recordar"},{"g":"my, mine","l":"meu"},null]},{"text":"Aproveite a sua juventude enquanto dure.","en":"Enjoy your youth while it lasts.","words":[{"g":"to take, appropriate","l":"aproveitar"},{"g":"the / to"},{"g":"his","l":"seu"},null,{"g":"as"},{"g":"to last, endure","l":"durar"}]}]}