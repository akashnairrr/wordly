{"id":"abrigo","lemma":"abrigo","pos":"noun","rank":1704,"glosses":["shelter, haven, refuge","divider created by hydrangeas or reeds"],"ipa":"/ɐˈbɾi.ɡu/","gender":"m","forms":{"plural":"abrigos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q5146_%28por%29-MedK1-abrigo.wav","examples":[{"text":"Vamos para dentro do abrigo.","en":"Let's go inside the shelter.","words":[{"g":"let's go"},{"g":"for / to"},{"g":"inside"},{"g":"of the"},null]},{"text":"Vamos entrar no abrigo.","en":"Let's go inside the shelter.","words":[{"g":"let's go"},{"g":"to enter"},{"g":"in the"},null]},{"text":"De quem é este abrigo?","en":"Whose coat is this?","words":[{"g":"of / from"},{"g":"who"},{"g":"is","l":"ser"},{"g":"this"},null]},{"text":"Eu construí um abrigo.","en":"I built a shelter.","audio":"https://tatoeba.org/en/audio/download/493444","words":[{"g":"I"},{"g":"to build","l":"construir"},{"g":"a"},null]},{"text":"Este abrigo te serve.","en":"This coat fits you.","words":[{"g":"this"},null,{"g":"you"},{"g":"to serve","l":"servir"}]}]}