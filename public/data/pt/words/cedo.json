{"id":"cedo","lemma":"cedo","pos":"adv","rank":404,"glosses":["early (at a time before expected; sooner than usual)","early (near the start of the day)"],"ipa":"/ˈse.du/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b7/Pt_cedo.ogg/Pt_cedo.ogg.mp3","examples":[{"text":"Cheguei lá cedo demais.","en":"I arrived there too early.","audio":"https://tatoeba.org/en/audio/download/845173","words":[{"g":"to arrive","l":"chegar"},{"g":"there"},null,{"g":"too, overly"}]},{"text":"Estarei em casa cedo.","en":"I'll be home early.","audio":"https://tatoeba.org/en/audio/download/494566","words":[{"g":"to be","l":"estar"},null,null,null],"phrases":[[1,3,"home"]]},{"text":"Eu acordo muito cedo.","en":"I wake up very early.","audio":"https://tatoeba.org/en/audio/download/535052","words":[{"g":"I"},{"g":"agreement, deal"},{"g":"very / a lot"},null]},{"text":"Ainda é cedo.","en":"It's still early.","audio":"https://tatoeba.org/en/audio/download/844060","words":[{"g":"still"},{"g":"is","l":"ser"},null]},{"text":"Quero sair cedo.","en":"I want to leave early.","audio":"https://tatoeba.org/en/audio/download/535671","words":[{"g":"to want","l":"querer"},{"g":"to exit"},null]}]}