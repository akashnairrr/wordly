{"id":"dividido","lemma":"dividido","pos":"adj","rank":4807,"glosses":["divided (separated or split into pieces)","shared (whose parts have been given to different entities)","divided (having conflicting interests or emotions)"],"ipa":"/d͡ʒi.viˈd͡ʒi.du/","forms":{"feminine":"dividida","masculinePlural":"divididos","femininePlural":"divididas"},"examples":[{"text":"Este livro está dividido em quatro partes.","en":"This book is divided into four parts.","words":[{"g":"this"},{"g":"book"},{"g":"is","l":"estar"},null,{"g":"in"},{"g":"four"},{"g":"male genitals"}]},{"text":"A oposição estava dividida.","en":"The opposition was divided.","words":[{"g":"the / to"},{"g":"opposition"},{"g":"to be","l":"estar"},null]},{"text":"Seis dividido por dois é igual a três.","en":"Six divided by two is three.","words":[{"g":"six"},null,{"g":"for / by"},{"g":"deuce"},{"g":"is","l":"ser"},null,null,{"g":"three"}],"phrases":[[5,7,"equal to"]]},{"text":"Unidos resistiremos, divididos cairemos.","en":"United we stand, divided we fall.","words":[{"g":"united","l":"unido"},{"g":"to resist","l":"resistir"},null,{"g":"to fall","l":"cair"}]},{"text":"Está dividida em três partes.","en":"It's divided into three parts.","words":[{"g":"is","l":"estar"},null,{"g":"in"},{"g":"three"},{"g":"male genitals"}]}]}