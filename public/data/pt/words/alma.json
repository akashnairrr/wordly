{"id":"alma","lemma":"alma","pos":"noun","rank":648,"glosses":["soul"],"ipa":"/ˈal.mɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/14/LL-Q5146_%28por%29-Santamarcanda-alma.wav/LL-Q5146_%28por%29-Santamarcanda-alma.wav.mp3","gender":"f","forms":{"plural":"almas"},"examples":[{"text":"A alma é imortal.","en":"The soul is immortal.","audio":"https://tatoeba.org/en/audio/download/843466","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"immortal"}]},{"text":"Os animais têm almas?","en":"Do animals have souls?","words":[{"g":"the"},{"g":"animal","l":"animal"},{"g":"to own","l":"ter"},null]},{"text":"Não havia uma alma viva lá.","en":"There wasn't a living soul there.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"hooray!"},{"g":"there"}]},{"text":"A tua alma me pertence.","en":"Your soul belongs to me.","words":[{"g":"the / to"},{"g":"hey","l":"teu"},null,{"g":"me"},{"g":"to belong","l":"pertencer"}]},{"text":"Tom acredita na existência da alma.","en":"Tom believes in the existence of the soul.","words":[{"g":"tone"},{"g":"to believe","l":"acreditar"},{"g":"in the"},{"g":"existence, being"},{"g":"of the"},null]}]}