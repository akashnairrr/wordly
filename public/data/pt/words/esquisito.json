{"id":"esquisito","lemma":"esquisito","pos":"adj","rank":1427,"glosses":["strange; weird (not normal)","picky; particular (demanding to have things just right)"],"ipa":"/(i)ʃ.kiˈzi.tu/","forms":{"feminine":"esquisita","masculinePlural":"esquisitos","femininePlural":"esquisitas","superlative":"o mais esquisito"},"examples":[{"text":"Este lugar é esquisito.","en":"This place is weird.","words":[{"g":"this"},{"g":"place"},{"g":"is","l":"ser"},null]},{"text":"Ela é uma pessoa muito esquisita.","en":"She's a very strange person.","words":[{"g":"she"},{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"person"},{"g":"very / a lot"},null]},{"text":"Quem é aquele esquisito?","en":"Who's that weirdo?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"that over there, yon"},null]},{"text":"Eles não são esquisitos.","en":"They're not freaks.","words":[{"g":"they"},{"g":"not / no"},{"g":"to be","l":"ser"},null]},{"text":"Esta foi uma situação esquisita.","en":"It was a strange situation.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},{"g":"situation"},null]}]}