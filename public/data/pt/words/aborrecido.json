{"id":"aborrecido","lemma":"aborrecido","pos":"adj","rank":1998,"glosses":["bored, annoyed","upset, angry"],"ipa":"/ɐ.bu.ʁɨˈsi.du/","forms":{"feminine":"aborrecida","masculinePlural":"aborrecidos","femininePlural":"aborrecidas","superlative":"o mais aborrecido"},"examples":[{"text":"Tom parecia aborrecido.","en":"Tom seemed bored.","audio":"https://tatoeba.org/en/audio/download/493249","words":[{"g":"tone"},{"g":"to seem","l":"parecer"},null]},{"text":"Ela está muito aborrecida comigo.","en":"She is very annoyed with me.","words":[{"g":"she"},{"g":"is","l":"estar"},{"g":"very / a lot"},null,{"g":"prepositional form with…"}]},{"text":"Ele parece aborrecido.","en":"He looks bored.","words":[{"g":"he"},{"g":"to seem","l":"parecer"},null]},{"text":"Tom ficou realmente aborrecido.","en":"Tom was really annoyed.","audio":"https://tatoeba.org/en/audio/download/863073","words":[{"g":"tone"},{"g":"to become","l":"ficar"},{"g":"truly"},null]},{"text":"Pareces aborrecida.","en":"You look bored.","words":[{"g":"to seem","l":"parecer"},null]}]}