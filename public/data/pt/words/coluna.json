{"id":"coluna","lemma":"coluna","pos":"noun","rank":2365,"glosses":["column (a vertical line of entries in a table)","column; pillar","spine; backbone"],"ipa":"/kuˈlu.nɐ/","gender":"f","forms":{"plural":"colunas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q5146_%28por%29-Wiktionairy-coluna.wav","examples":[{"text":"Eu tenho problemas de coluna.","en":"I have back problems.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"problem","l":"problema"},{"g":"of / from"},null]},{"text":"A tua coluna ainda está doendo?","en":"Does your back still hurt?","words":[{"g":"the / to"},{"g":"hey","l":"teu"},null,{"g":"still"},{"g":"is","l":"estar"},{"g":"to hurt","l":"doer"}]},{"text":"Colunas fornecem uma fundação sólida.","en":"Columns provide a solid foundation.","words":[null,{"g":"to supply","l":"fornecer"},{"g":"a","l":"um"},{"g":"foundation"},{"g":"in the solid state","l":"sólido"}]},{"text":"A minha coluna está doendo.","en":"My back hurts.","words":[null,null,null,{"g":"is","l":"estar"},{"g":"to hurt","l":"doer"}],"phrases":[[0,2,"the missus"]]},{"text":"A coluna vertebral compõe-se de vinte e quatro ossos.","en":"The spinal column is composed of twenty-four bones.","words":[{"g":"the / to"},null,{"g":"vertebral"},{"g":"to compose","l":"compor"},{"g":"if / oneself"},{"g":"of / from"},null,null,null,{"g":"bone","l":"osso"}],"phrases":[[6,9,"twenty-four"]]}]}