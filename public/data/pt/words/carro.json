{"id":"carro","lemma":"carro","pos":"noun","rank":160,"glosses":["cart (vehicle drawn or pushed by a person or animal)","car; automobile","any “vehicle” which is drawn, such as an elevator, a cable car, or a train wagon"],"ipa":"/ˈka.ʁu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fd/Pt-br-um_carro.oga/Pt-br-um_carro.oga.mp3","gender":"m","forms":{"plural":"carros"},"formAudio":{"carros":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q5146_%28por%29-Nelson_Ricardo_2500-carros.wav"},"examples":[{"text":"Você sabe dirigir um carro?","en":"Do you know how to drive a car?","audio":"https://tatoeba.org/en/audio/download/40177","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},{"g":"to drive"},{"g":"a"},null]},{"text":"Eu quero aquele carro.","en":"I want that car.","audio":"https://tatoeba.org/en/audio/download/491224","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"that over there, yon"},null]},{"text":"Há sempre muitos carros nesta rua.","en":"There are always a lot of cars on this street.","words":[{"g":"there be","l":"haver"},{"g":"always"},{"g":"very, a lot","l":"muito"},null,null,{"g":"street"}]},{"text":"Espera no carro.","en":"Wait in the car.","audio":"https://tatoeba.org/en/audio/download/279771","words":[{"g":"wait"},{"g":"in the"},null]},{"text":"Tenho dois carros.","en":"I have two cars.","audio":"https://tatoeba.org/en/audio/download/46184","words":[{"g":"have","l":"ter"},{"g":"deuce"},null]}]}