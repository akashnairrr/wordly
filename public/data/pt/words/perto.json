{"id":"perto","lemma":"perto","pos":"adv","rank":262,"glosses":["close, closely, next (at a little distance)"],"ipa":"/ˈpɛɾ.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2c/LL-Q5146_%28por%29-Santamarcanda-perto.wav/LL-Q5146_%28por%29-Santamarcanda-perto.wav.mp3","examples":[{"text":"Tem um hospital aqui perto?","en":"Is there a hospital near here?","words":[{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"hospital"},{"g":"here"},null]},{"text":"Minha casa é perto da escola.","en":"My house is close to the school.","words":[{"g":"my, mine","l":"meu"},{"g":"house, home"},{"g":"is","l":"ser"},null,{"g":"of the"},{"g":"school"}]},{"text":"O hotel é perto do aeroporto?","en":"Is the hotel close to the airport?","words":[{"g":"the / it"},{"g":"hotel"},{"g":"is","l":"ser"},null,{"g":"of the"},{"g":"airport"}]},{"text":"Quão perto vocês estavam?","en":"How close were you?","audio":"https://tatoeba.org/en/audio/download/859169","words":[{"g":"as"},null,{"g":"you (pl.)"},{"g":"to be","l":"estar"}]},{"text":"Estou perto da ponte.","en":"I am close to the bridge.","words":[{"g":"am","l":"estar"},null,{"g":"of the"},{"g":"bridge"}]}]}