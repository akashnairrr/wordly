{"id":"tinta","lemma":"tinta","pos":"noun","rank":2025,"glosses":["paint","ink","dye"],"ipa":"/ˈt͡ʃĩ.tɐ/","gender":"f","forms":{"plural":"tintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0e/LL-Q5146_%28por%29-Ed_Guimaraes-tinta.wav","examples":[{"text":"Eu preciso de tinta.","en":"I need paint.","audio":"https://tatoeba.org/en/audio/download/489919","words":[{"g":"I"},{"g":"precise"},{"g":"of / from"},null]},{"text":"Esta tinta é a melhor.","en":"This ink is the best.","words":[{"g":"this","l":"este"},null,{"g":"is","l":"ser"},{"g":"the / to"},{"g":"desirable","l":"bom"}]},{"text":"Estou-me nas tintas.","en":"Who cares?","words":[{"g":"am","l":"estar"},{"g":"me"},null,null]},{"text":"Use tinta acrílica.","en":"Use acrylic paint.","audio":"https://tatoeba.org/en/audio/download/843986","words":[{"g":"to use","l":"usar"},null,null]},{"text":"Esta tinta sai muito facilmente.","en":"This paint comes off easily.","words":[{"g":"this","l":"este"},null,{"g":"to exit","l":"sair"},{"g":"very / a lot"},{"g":"easily"}]}]}