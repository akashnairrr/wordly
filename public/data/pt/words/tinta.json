{"id":"tinta","lemma":"tinta","pos":"noun","rank":1883,"glosses":["paint","ink","dye"],"ipa":"/ˈtĩ.tɐ/","gender":"f","forms":{"plural":"tintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0e/LL-Q5146_%28por%29-Ed_Guimaraes-tinta.wav","examples":[{"text":"Eu preciso de tinta.","en":"I need paint.","audio":"https://tatoeba.org/en/audio/download/489919","words":[{"g":"I"},{"g":"to need","l":"precisar"},{"g":"of / from"},null]},{"text":"Esta tinta é a melhor.","en":"This ink is the best.","words":[{"g":"this","l":"este"},null,{"g":"is","l":"ser"},{"g":"the / to"},{"g":"desirable","l":"bom"}]},{"text":"Devo escrever à tinta?","en":"Must I write in ink?","words":[{"g":"should","l":"dever"},{"g":"to write"},{"g":"to the"},null]},{"text":"Esta tinta sai muito facilmente.","en":"This paint comes off easily.","words":[{"g":"this","l":"este"},null,{"g":"to exit","l":"sair"},{"g":"very / a lot"},{"g":"easily"}]},{"text":"Só me traz a tinta, tá?","en":"Just bring me the ink, will you?","words":[{"g":"only"},{"g":"me"},{"g":"bring","l":"trazer"},{"g":"the / to"},null,null]}]}