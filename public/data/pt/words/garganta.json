{"id":"garganta","lemma":"garganta","pos":"noun","rank":1508,"glosses":["throat (posterior region of the oral cavity)","throat (anterior-superior part of the neck)","canyon, narrow (narrow passage between mountains)"],"ipa":"/ɡaʁˈɡɐ̃.tɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/09/LL-Q5146_%28por%29-MedK1-garganta.wav/LL-Q5146_%28por%29-MedK1-garganta.wav.mp3","gender":"f","forms":{"plural":"gargantas"},"examples":[{"text":"Minha garganta dói.","en":"My throat hurts.","audio":"https://tatoeba.org/en/audio/download/470364","words":[{"g":"my, mine","l":"meu"},null,{"g":"to hurt","l":"doer"}]},{"text":"\"A sua garganta dói?\" \"Sim, um pouco.\"","en":"\"Does your throat hurt?\" \"Yes, a little.\"","words":[{"g":"the / to"},{"g":"his","l":"seu"},null,{"g":"to hurt","l":"doer"},{"g":"yes"},null,null],"phrases":[[5,7,"slightly"]]},{"text":"Eu estou com dor de garganta.","en":"I have a sore throat.","words":[{"g":"I"},{"g":"am","l":"estar"},{"g":"with"},{"g":"pain"},{"g":"of / from"},null]},{"text":"Ele limpou a garganta.","en":"He cleared his throat.","words":[{"g":"he"},{"g":"to clean","l":"limpar"},{"g":"the / to"},null]},{"text":"Tenho nó na garganta.","en":"I have a frog in my throat.","words":[{"g":"have","l":"ter"},{"g":"knot"},{"g":"in the"},null]}]}