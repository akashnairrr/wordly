{"id":"esquerda","lemma":"esquerda","pos":"noun","rank":672,"glosses":["the left side, part, half or direction","the left hand or leg","left (punch with the left fist)"],"ipa":"/isˈkeʁ.dɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d8/LL-Q5146_%28por%29-Santamarcanda-esquerda.wav/LL-Q5146_%28por%29-Santamarcanda-esquerda.wav.mp3","gender":"f","forms":{"plural":"esquerdas"},"examples":[{"text":"Fica ali à esquerda.","en":"It's there to the left.","audio":"https://tatoeba.org/en/audio/download/845200","words":[{"g":"to become","l":"ficar"},{"g":"there )"},{"g":"forms adverbs meaning…"},null]},{"text":"A saída está à esquerda.","en":"The exit is on the left.","words":[{"g":"the / to"},{"g":"exit"},{"g":"is","l":"estar"},{"g":"forms adverbs meaning…"},null]},{"text":"É à sua esquerda.","en":"It's to your left.","audio":"https://tatoeba.org/en/audio/download/856732","words":[{"g":"is","l":"ser"},{"g":"forms adverbs meaning…"},{"g":"his","l":"seu"},null]},{"text":"Há uma janela à sua esquerda.","en":"There's a window on your left.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},{"g":"window"},{"g":"forms adverbs meaning…"},{"g":"his","l":"seu"},null]},{"text":"Tentei escrever com a mão esquerda.","en":"I tried writing with my left hand.","words":[{"g":"to try","l":"tentar"},{"g":"to write"},{"g":"with"},{"g":"the / to"},{"g":"hand"},null]}]}