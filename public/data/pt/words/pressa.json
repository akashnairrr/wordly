{"id":"pressa","lemma":"pressa","pos":"noun","rank":1186,"glosses":["hurry; rush; haste"],"ipa":"/ˈpɾɛ.sɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c0/LL-Q5146_%28por%29-Santamarcanda-pressa.wav/LL-Q5146_%28por%29-Santamarcanda-pressa.wav.mp3","gender":"f","forms":{"plural":"pressas"},"examples":[{"text":"Não tenho pressa.","en":"I'm in no hurry.","audio":"https://tatoeba.org/en/audio/download/491287","words":[{"g":"not / no"},{"g":"have","l":"ter"},null]},{"text":"Vocês ainda estão com pressa?","en":"Are you still in a hurry?","words":[{"g":"you (pl.)"},{"g":"still"},{"g":"to be","l":"estar"},{"g":"with"},null]},{"text":"Tom saiu de casa às pressas.","en":"Tom left home in a hurry.","words":[{"g":"tone"},{"g":"to exit","l":"sair"},{"g":"of / from"},{"g":"house, home"},null,null]},{"text":"Tom parecia estar com muita pressa.","en":"Tom seemed to be in a big hurry.","words":[{"g":"tone"},{"g":"to seem","l":"parecer"},{"g":"to be"},{"g":"with"},{"g":"very, a lot","l":"muito"},null]},{"text":"Ele entrou em seu carro às pressas.","en":"He got into his car in a hurry.","words":[{"g":"he"},{"g":"to enter","l":"entrar"},{"g":"in"},{"g":"his"},{"g":"cart"},null,null]}]}