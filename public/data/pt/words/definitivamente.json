{"id":"definitivamente","lemma":"definitivamente","pos":"adv","rank":969,"glosses":["definitely (without question and beyond doubt)"],"ipa":"/de.fi.niˌt͡ʃi.vaˈmẽ.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/ba/LL-Q5146_%28por%29-Santamarcanda-definitivamente.wav/LL-Q5146_%28por%29-Santamarcanda-definitivamente.wav.mp3","examples":[{"text":"Nós definitivamente precisamos de mais ajuda.","en":"We definitely need more help.","words":[{"g":"we"},null,{"g":"to need","l":"precisar"},{"g":"of / from"},{"g":"more"},{"g":"help, assistance, aid"}]},{"text":"Eu definitivamente quero tentar fazer isso.","en":"I definitely want to try to do that.","words":[{"g":"I"},null,{"g":"to want","l":"querer"},{"g":"to try"},{"g":"to create"},{"g":"that"}]},{"text":"Definitivamente, vamos fazer aquilo.","en":"Let's definitely do that.","words":[null,{"g":"let's go"},{"g":"to create"},{"g":"that over there, yon","l":"aquele"}]},{"text":"Ele definitivamente não vem.","en":"He's definitely not coming.","words":[{"g":"he"},null,{"g":"not / no"},{"g":"to come","l":"vir"}]},{"text":"Este é definitivamente melhor.","en":"This one is definitely better.","words":[{"g":"this"},{"g":"is","l":"ser"},null,{"g":"desirable","l":"bom"}]}]}