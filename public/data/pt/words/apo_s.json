{"id":"apo_s","lemma":"após","pos":"prep","rank":417,"glosses":["after (later in time)","past (further in location)","after (a great amount of)"],"ipa":"/aˈpɔ(j)s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b5/LL-Q5146_%28por%29-Santamarcanda-ap%C3%B3s.wav/LL-Q5146_%28por%29-Santamarcanda-ap%C3%B3s.wav.mp3","examples":[{"text":"Ele morreu logo após o acidente.","en":"He died soon after the accident.","words":[{"g":"he"},{"g":"to die","l":"morrer"},{"g":"soon"},null,{"g":"the / it"},{"g":"accident"}]},{"text":"Te verei após o trabalho.","en":"I'll see you after work.","audio":"https://tatoeba.org/en/audio/download/534028","words":[{"g":"you"},{"g":"to see","l":"ver"},null,{"g":"the / it"},{"g":"job"}]},{"text":"Venha me ver após o trabalho.","en":"Come see me after work.","words":[{"g":"to come","l":"vir"},{"g":"me"},{"g":"to see"},null,{"g":"the / it"},{"g":"job"}]},{"text":"Não há nada após a morte.","en":"After death there is nothing.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},{"g":"nothing"},null,{"g":"the / to"},{"g":"death"}]},{"text":"Ele veio de novo após uma semana.","en":"He came again after a week.","words":[{"g":"he"},{"g":"to come","l":"vir"},null,null,null,{"g":"a","l":"um"},{"g":"week"}],"phrases":[[2,4,"again"]]}]}