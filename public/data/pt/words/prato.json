{"id":"prato","lemma":"prato","pos":"noun","rank":1733,"glosses":["a flat dish from which food is served or eaten","a course at a meal","cymbal"],"ipa":"/ˈpɾa.tu/","gender":"m","forms":{"plural":"pratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q5146_%28por%29-Nelson_Ricardo_2500-prato.wav","examples":[{"text":"Onde estão os pratos?","en":"Where are the dishes?","words":[{"g":"where"},{"g":"to be","l":"estar"},{"g":"the"},null]},{"text":"O prato estava cheio de comida.","en":"The plate was piled high with food.","words":[{"g":"the / it"},null,{"g":"to be","l":"estar"},{"g":"full"},{"g":"of / from"},{"g":"food, something edible"}]},{"text":"Quero dez pratos.","en":"I want ten plates.","words":[{"g":"to want","l":"querer"},{"g":"ten"},null]},{"text":"Quem quebrou o prato?","en":"Who broke the dish?","words":[{"g":"who"},{"g":"to break","l":"quebrar"},{"g":"the / it"},null]},{"text":"Quantos pratos você quer?","en":"How many plates do you want?","words":[{"g":"how many"},null,{"g":"you (formal)"},{"g":"to want","l":"querer"}]}]}