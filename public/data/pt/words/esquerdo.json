{"id":"esquerdo","lemma":"esquerdo","pos":"adj","rank":1972,"glosses":["left; left-hand; on or towards the left side"],"ipa":"/isˈkeʁ.du/","forms":{"feminine":"esquerda","masculinePlural":"esquerdos","femininePlural":"esquerdas","superlative":"o mais esquerdo"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q5146_%28por%29-MedK1-esquerdo.wav","formAudio":{"esquerda":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q5146_%28por%29-Nelson_Ricardo_2500-esquerda.wav"},"examples":[{"text":"Está no lado esquerdo da rua.","en":"It is on the left side of the street.","words":[{"g":"is","l":"estar"},{"g":"in the"},{"g":"side"},null,{"g":"of the"},{"g":"street"}]},{"text":"Eu feri meu braço esquerdo.","en":"I hurt my left arm.","audio":"https://tatoeba.org/en/audio/download/494013","words":[{"g":"I"},{"g":"to hurt, injure","l":"ferir"},{"g":"my, mine"},{"g":"arm"},null]},{"text":"Meu pé esquerdo adormeceu.","en":"My left foot is asleep.","words":[{"g":"my, mine"},{"g":"foot"},null,{"g":"to fall asleep","l":"adormecer"}]},{"text":"Tom é o homem do lado esquerdo.","en":"Tom is the man on the left.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"the / it"},{"g":"male"},{"g":"of the"},{"g":"side"},null]},{"text":"Ele quebrou o braço esquerdo.","en":"He broke his left arm.","words":[{"g":"he"},{"g":"to break","l":"quebrar"},{"g":"the / it"},{"g":"arm"},null]}]}