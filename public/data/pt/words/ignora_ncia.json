{"id":"ignora_ncia","lemma":"ignorância","pos":"noun","rank":4737,"glosses":["ignorance","aggressiveness","rudeness, impoliteness, attitude"],"ipa":"/i.ɡi.noˈɾɐ̃.sjɐ/","gender":"f","forms":{"plural":"ignorâncias"},"examples":[{"text":"Ignorância não é desculpa.","en":"Ignorance is no excuse.","words":[null,null,null,{"g":"excuse, pretext"}],"phrases":[[1,3,"isn't it"]]},{"text":"Perdoe-me pela minha ignorância.","en":"Forgive me for my ignorance.","words":[{"g":"to forgive","l":"perdoar"},{"g":"me"},{"g":"to skin","l":"pelar"},{"g":"my, mine","l":"meu"},null]},{"text":"Ignorância sempre gera medo.","en":"Ignorance always creates fear.","audio":"https://tatoeba.org/en/audio/download/851964","words":[null,{"g":"always"},{"g":"to generate","l":"gerar"},{"g":"Median"}]},{"text":"Ela frequentemente leva vantagem de sua ignorância.","en":"She often takes advantage of his ignorance.","words":[{"g":"she"},{"g":"frequently, often"},{"g":"to take","l":"levar"},{"g":"advantage, vantage"},{"g":"of / from"},{"g":"his","l":"seu"},null]},{"text":"Eu admito a minha ignorância.","en":"I plead ignorance.","words":[{"g":"I"},{"g":"to admit, accept","l":"admitir"},null,null,null],"phrases":[[2,4,"the missus"]]}]}