{"id":"adeus","lemma":"adeus","pos":"intj","rank":400,"glosses":["goodbye (farewell)"],"ipa":"/aˈdews/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/Pt_adeus.ogg/Pt_adeus.ogg.mp3","examples":[{"text":"Eu queria dizer adeus.","en":"I wanted to say goodbye.","audio":"https://tatoeba.org/en/audio/download/535985","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"to speak"},null]},{"text":"Você quer dizer adeus?","en":"Do you want to say goodbye?","words":[{"g":"you"},null,null,null],"phrases":[[1,3,"I mean"]]},{"text":"Tom nunca disse adeus.","en":"Tom never said goodbye.","audio":"https://tatoeba.org/en/audio/download/1274157","words":[{"g":"tone"},{"g":"never (at no time"},{"g":"to speak","l":"dizer"},null]},{"text":"Nós precisamos dizer adeus.","en":"We need to say goodbye.","words":[{"g":"we"},{"g":"to need","l":"precisar"},{"g":"to speak"},null]},{"text":"Diga adeus aos seus amigos.","en":"Say goodbye to your friends.","words":[{"g":"to speak","l":"dizer"},null,null,{"g":"their or your kin"},{"g":"friend","l":"amigo"}]}]}