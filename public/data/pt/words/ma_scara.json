{"id":"ma_scara","lemma":"máscara","pos":"noun","rank":1827,"glosses":["mask (a cover, or partial cover, for the face)","mask (that which disguises; a pretext or subterfuge)"],"ipa":"/ˈmas.ka.ɾɐ/","gender":"f","forms":{"plural":"máscaras"},"examples":[{"text":"Tire sua máscara.","en":"Take off your mask.","audio":"https://tatoeba.org/en/audio/download/843967","words":[{"g":"to take","l":"tirar"},{"g":"his","l":"seu"},null]},{"text":"Eu usei uma máscara.","en":"I wore a mask.","audio":"https://tatoeba.org/en/audio/download/1274337","words":[{"g":"I"},{"g":"to use","l":"usar"},{"g":"a","l":"um"},null]},{"text":"Acho que devemos usar máscaras.","en":"I think we should wear masks.","words":[{"g":"to find","l":"achar"},{"g":"that / what"},{"g":"should","l":"dever"},{"g":"to use"},null]},{"text":"Não tire a máscara.","en":"Don't take off your mask.","audio":"https://tatoeba.org/en/audio/download/856728","words":[{"g":"not / no"},{"g":"to take","l":"tirar"},{"g":"the / to"},null]},{"text":"Nós estaremos usando máscaras de gás.","en":"We'll be wearing gas masks.","words":[{"g":"we"},{"g":"to be","l":"estar"},{"g":"to use","l":"usar"},null,{"g":"of / from"},{"g":"gas"}]}]}