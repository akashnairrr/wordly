{"id":"veneno","lemma":"veneno","pos":"noun","rank":1564,"glosses":["poison (substance harmful to a living organism)","poison (something that harms a person or thing)","venom (feeling or speech marked by spite or malice)"],"ipa":"/vɨˈne.nu/","gender":"m","forms":{"plural":"venenos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q5146_%28por%29-Nelson_Ricardo_2500-veneno.wav","examples":[{"text":"Isso é veneno.","en":"That's poison.","words":[{"g":"that"},{"g":"is","l":"ser"},null]},{"text":"A nicotina é um veneno.","en":"Nicotine is a poison.","words":[{"g":"the / to"},{"g":"nicotine"},{"g":"is","l":"ser"},{"g":"a"},null]},{"text":"Tom cuspiu o veneno.","en":"Tom spit out the poison.","words":[{"g":"tone"},{"g":"to spit","l":"cuspir"},{"g":"the / it"},null]},{"text":"Ele fez um erro e bebeu veneno.","en":"He made a mistake and drank poison.","words":[{"g":"he"},{"g":"to create","l":"fazer"},{"g":"a"},{"g":"error"},{"g":"and"},{"g":"to drink","l":"beber"},null]},{"text":"Ele perdeu a esperança e se matou com veneno.","en":"He lost hope and killed himself with poison.","words":[{"g":"he"},{"g":"to lose","l":"perder"},{"g":"the / to"},{"g":"hope"},null,null,{"g":"to kill","l":"matar"},{"g":"with"},null],"phrases":[[4,6,"what if"]]}]}