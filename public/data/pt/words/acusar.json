{"id":"acusar","lemma":"acusar","pos":"verb","rank":2969,"glosses":["to accuse"],"ipa":"/ɐ.kuˈzaɾ/","conjugation":{"indicative":{"present":{"1s":"acuso","2s":"acusas","3s":"acusa","1p":"acusamos","2p":"acusais","3p":"acusam"},"imperfect":{"1s":"acusava","2s":"acusavas","3s":"acusava","1p":"acusávamos","2p":"acusáveis","3p":"acusavam"},"preterite":{"1s":"acusei","2s":"acusaste","3s":"acusou","1p":"acusámos","2p":"acusastes","3p":"acusaram"},"future":{"1s":"acusarei","2s":"acusarás","3s":"acusará","1p":"acusaremos","2p":"acusareis","3p":"acusarão"},"conditional":{"1s":"acusaria","2s":"acusarias","3s":"acusaria","1p":"acusaríamos","2p":"acusaríeis","3p":"acusariam"}},"subjunctive":{"present":{"1s":"acuse","2s":"acuses","3s":"acuse","1p":"acusemos","2p":"acuseis","3p":"acusem"},"imperfect":{"1s":"acusasse","2s":"acusasses","3s":"acusasse","1p":"acusássemos","2p":"acusásseis","3p":"acusassem"}},"imperative":{"affirmative":{"2s":"acusa","3s":"acuse","1p":"acusemos","2p":"acusai","3p":"acusem"},"negative":{"2s":"não acuses","3s":"não acuse","1p":"não acusemos","2p":"não acuseis","3p":"não acusem"}}},"nonFinite":{"gerund":"acusando","participle":"acusado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q5146_%28por%29-Wiktionairy-acusar.wav","examples":[{"text":"Ele quem se desculpa se acusa.","en":"He who excuses himself accuses himself.","words":[{"g":"he"},{"g":"who"},{"g":"if / oneself"},{"g":"sorry!, excuse me"},{"g":"if / oneself"},null]},{"text":"Ela me acusou de ser um mentiroso.","en":"She accused me of being a liar.","words":[{"g":"she"},{"g":"me"},null,{"g":"of / from"},{"g":"to be"},{"g":"a"},{"g":"which lies or deceives"}]},{"text":"Eles a acusaram de pegar o dinheiro.","en":"They accused her of taking the money.","words":[{"g":"they"},{"g":"the / to"},null,{"g":"of / from"},{"g":"to grab, hold"},{"g":"the / it"},{"g":"money"}]},{"text":"Eu não estou te acusando de nada.","en":"I'm not accusing you of anything.","words":[{"g":"I"},{"g":"not / n