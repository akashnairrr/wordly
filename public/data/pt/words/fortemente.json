{"id":"fortemente","lemma":"fortemente","pos":"adv","rank":4623,"glosses":["strongly"],"ipa":"/ˌfɔɾ.tɨˈmẽ.tɨ/","examples":[{"text":"Eu discordo fortemente.","en":"I disagree strongly.","words":[{"g":"I"},{"g":"to disagree","l":"discordar"},null]},{"text":"O vento está soprando muito fortemente.","en":"The wind is blowing very hard.","words":[{"g":"the / it"},{"g":"wind"},{"g":"is","l":"estar"},{"g":"to blow","l":"soprar"},{"g":"very / a lot"},null]},{"text":"Tom me aconselhou fortemente a fazer isso.","en":"Tom strongly advised me to do that.","words":[{"g":"tone"},{"g":"me"},{"g":"to advise, counsel","l":"aconselhar"},null,{"g":"the / to"},{"g":"to create"},{"g":"that"}]},{"text":"Ele a segurou fortemente.","en":"He held her tightly.","words":[{"g":"he"},{"g":"the / to"},{"g":"to hold","l":"segurar"},null]},{"text":"Eles estão fortemente armados.","en":"They're heavily armed.","words":[{"g":"they"},{"g":"to be","l":"estar"},null,{"g":"equipped with","l":"armado"}]}]}