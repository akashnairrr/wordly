{"id":"curva","lemma":"curva","pos":"noun","rank":2828,"glosses":["curve (a gentle bend)","curve (a curved line)"],"ipa":"/ˈkuɾ.vɐ/","gender":"f","forms":{"plural":"curvas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q5146_%28por%29-MedK1-curva.wav","examples":[{"text":"Não feche tanto a curva.","en":"Don't hug the inside of the curve.","audio":"https://tatoeba.org/en/audio/download/889211","words":[{"g":"not / no"},{"g":"to close","l":"fechar"},{"g":"an unspecified or…"},{"g":"the / to"},null]},{"text":"Não faça a curva assim tão fechada.","en":"Don't hug the inside of the curve.","words":[{"g":"not / no"},{"g":"to create","l":"fazer"},{"g":"the / to"},null,{"g":"this way"},{"g":"so"},{"g":"closed, shut","l":"fechado"}]},{"text":"Eu acho que fizemos uma curva errada.","en":"I think that we made a wrong turn.","words":[{"g":"I"},{"g":"to find","l":"achar"},{"g":"that / what"},{"g":"to create","l":"fazer"},{"g":"a","l":"um"},null,{"g":"not correct","l":"errado"}]},{"text":"Por favor vire à esquerda na próxima curva.","en":"Please turn left at the first corner.","words":[null,null,{"g":"to turn","l":"virar"},{"g":"to the"},{"g":"the left side"},{"g":"in the"},{"g":"near, close","l":"próximo"},null],"phrases":[[0,2,"please"]]}]}