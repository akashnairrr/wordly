{"id":"montanha","lemma":"montanha","pos":"noun","rank":1280,"glosses":["mountain"],"ipa":"/mõˈtɐ.ɲɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/74/LL-Q5146_%28por%29-Santamarcanda-montanha.wav/LL-Q5146_%28por%29-Santamarcanda-montanha.wav.mp3","gender":"f","forms":{"plural":"montanhas"},"examples":[{"text":"A montanha é verde.","en":"The mountain is green.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"green"}]},{"text":"Eu tenho uma casa nas montanhas.","en":"I have a house in the mountains.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"a","l":"um"},{"g":"house, home"},null,null]},{"text":"Há neve na montanha.","en":"There is snow on the mountain.","words":[{"g":"there be","l":"haver"},{"g":"snow"},{"g":"in the"},null]},{"text":"Há neve no topo da montanha?","en":"Is there snow on top of the mountain?","words":[{"g":"there be","l":"haver"},{"g":"snow"},{"g":"in the"},{"g":"top"},{"g":"of the"},null]},{"text":"Ela escalava montanhas com ele.","en":"She used to go mountain climbing with him.","words":[{"g":"she"},{"g":"to climb, mount, scale","l":"escalar"},null,{"g":"with"},{"g":"he"}]}]}