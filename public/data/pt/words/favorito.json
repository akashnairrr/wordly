{"id":"favorito","lemma":"favorito","pos":"noun","rank":1816,"glosses":["favourite (person who enjoys special regard or favour)","favourite (person who is preferred or trusted above all others)","favourite (contestant or competitor thought most likely to win)"],"ipa":"/fɐ.vuˈɾi.tu/","gender":"m","forms":{"plural":"favoritos","feminine":"favorita","femininePlural":"favoritas"},"examples":[{"text":"Este é o meu favorito.","en":"This is my favorite.","words":[{"g":"this"},{"g":"is","l":"ser"},{"g":"the / it"},{"g":"my, mine"},null]},{"text":"Esta é a minha favorita.","en":"This is my favorite.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},null,null,null],"phrases":[[2,4,"the missus"]]},{"text":"Qual é a sua bebida favorita?","en":"What's your favorite drink?","audio":"https://tatoeba.org/en/audio/download/58447","words":[{"g":"which"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"his","l":"seu"},{"g":"drink"},null]},{"text":"Eles são os meus favoritos.","en":"They're my favorite.","words":[{"g":"they"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"my kin"},null]},{"text":"Esse é o seu favorito, certo?","en":"That's your favorite, right?","words":[{"g":"that"},{"g":"is","l":"ser"},{"g":"the / it"},{"g":"his"},null,{"g":"right"}]}]}