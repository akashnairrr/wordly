{"id":"orgulhoso","lemma":"orgulhoso","pos":"adj","rank":1304,"glosses":["proud"],"ipa":"/ɔɾ.ɡuˈʎo.zu/","forms":{"feminine":"orgulhosa","masculinePlural":"orgulhosos","femininePlural":"orgulhosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q5146_%28por%29-MedK1-orgulhoso.wav","examples":[{"text":"Estou tão orgulhoso.","en":"I'm so proud.","audio":"https://tatoeba.org/en/audio/download/1265388","words":[{"g":"am","l":"estar"},{"g":"so"},null]},{"text":"Estou orgulhosa do meu filho.","en":"I'm proud of my son.","words":[{"g":"am","l":"estar"},null,{"g":"of the"},{"g":"my, mine"},{"g":"son"}]},{"text":"Nossos pais estão tão orgulhosos.","en":"Our parents are so proud.","words":[{"g":"our kin"},{"g":"parents"},{"g":"to be","l":"estar"},{"g":"so"},null]},{"text":"Vocês estão orgulhosas de seu pai?","en":"Are you proud of your father?","words":[{"g":"you (pl.)"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"his"},{"g":"father"}]},{"text":"Vocês me deixaram orgulhoso.","en":"You made me proud.","words":[{"g":"you (pl.)"},{"g":"me"},null,null]}]}