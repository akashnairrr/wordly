{"id":"equipe","lemma":"equipe","pos":"noun","rank":337,"glosses":["team"],"ipa":"/eˈki.pi/","gender":"f","forms":{"plural":"equipes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/42/LL-Q5146_%28por%29-Nelson_Ricardo_2500-equipe.wav","examples":[{"text":"Ele é o capitão da equipe.","en":"He is the captain of the team.","words":[{"g":"he"},{"g":"is","l":"ser"},{"g":"the / it"},{"g":"captain"},{"g":"of the"},null]},{"text":"Esta é uma equipe muito boa.","en":"This is a really good team.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},{"g":"a","l":"um"},null,{"g":"very / a lot"},{"g":"an interesting story"}]},{"text":"Vencemos três equipes.","en":"We beat three teams.","audio":"https://tatoeba.org/en/audio/download/844020","words":[{"g":"to win","l":"vencer"},{"g":"three"},null]},{"text":"Eis a minha equipe.","en":"There's my team.","audio":"https://tatoeba.org/en/audio/download/852167","words":[{"g":"here is, here are"},null,null,null],"phrases":[[1,3,"the missus"]]},{"text":"Eu quero estar na sua equipe.","en":"I want to be on your team.","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"to be"},{"g":"in the"},{"g":"his","l":"seu"},null]}]}