{"id":"rapidamente","lemma":"rapidamente","pos":"adv","rank":1133,"glosses":["rapidly, quickly"],"ipa":"/ˌʁa.pi.daˈmẽ.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1a/LL-Q5146_%28por%29-Santamarcanda-rapidamente.wav/LL-Q5146_%28por%29-Santamarcanda-rapidamente.wav.mp3","examples":[{"text":"O tempo passa rapidamente.","en":"Time passes by quickly.","audio":"https://tatoeba.org/en/audio/download/1264322","words":[{"g":"the / it"},{"g":"time"},{"g":"to pass","l":"passar"},null]},{"text":"Isso rapidamente mudou.","en":"That quickly changed.","words":[{"g":"that"},null,{"g":"to change","l":"mudar"}]},{"text":"Aprendi francês muito rapidamente.","en":"I learned French very quickly.","audio":"https://tatoeba.org/en/audio/download/485432","words":[{"g":"to learn","l":"aprender"},{"g":"French"},{"g":"very / a lot"},null]},{"text":"Ela abriu rapidamente a carta.","en":"She quickly opened the letter.","words":[{"g":"she"},{"g":"to open","l":"abrir"},null,{"g":"the / to"},{"g":"letter"}]},{"text":"Ele saiu rapidamente da sala.","en":"He quickly went out of the room.","words":[{"g":"he"},{"g":"to exit","l":"sair"},null,{"g":"of the"},{"g":"room"}]}]}