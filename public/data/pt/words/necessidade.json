{"id":"necessidade","lemma":"necessidade","pos":"noun","rank":1284,"glosses":["need"],"ipa":"/ne.se.siˈda.d͡ʒi/","gender":"f","forms":{"plural":"necessidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q5146_%28por%29-Wiktionairy-necessidade.wav","examples":[{"text":"Eu tenho necessidades.","en":"I have needs.","audio":"https://tatoeba.org/en/audio/download/489752","words":[{"g":"I"},{"g":"have","l":"ter"},null]},{"text":"Todos tem uma necessidade disso.","en":"Everyone has a need for it.","words":[{"g":"everyone"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},null,null]},{"text":"Existe uma necessidade por isso.","en":"There is a need for that.","words":[{"g":"to exist","l":"existir"},{"g":"a","l":"um"},null,null,null],"phrases":[[3,5,"therefore"]]},{"text":"Não há necessidade de explicar.","en":"There's no need to explain.","words":[{"g":"not / no"},{"g":"there be","l":"haver"},null,{"g":"of / from"},{"g":"to explain"}]},{"text":"Parece não haver necessidade de ir.","en":"There seems to be no need to go.","words":[{"g":"to seem","l":"parecer"},{"g":"not / no"},{"g":"there be"},null,{"g":"of / from"},{"g":"to go"}]}]}