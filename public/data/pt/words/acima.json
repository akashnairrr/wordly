{"id":"acima","lemma":"acima","pos":"adv","rank":878,"glosses":["on top (in higher part)","upward (toward a higher place or part)"],"ipa":"/aˈsĩ.mɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/LL-Q5146_%28por%29-Santamarcanda-acima.wav/LL-Q5146_%28por%29-Santamarcanda-acima.wav.mp3","examples":[{"text":"Ninguém está acima da lei.","en":"No one is above the law.","words":[{"g":"no one"},{"g":"is","l":"estar"},null,{"g":"of the"},{"g":"law"}]},{"text":"Vais lá acima?","en":"Are you going up there?","words":[{"g":"to go","l":"ir"},{"g":"there"},null]},{"text":"Vi a lua acima do telhado.","en":"I saw the moon above the roof.","words":[{"g":"to see","l":"ver"},{"g":"the / to"},{"g":"moonlight, moonshine"},null,{"g":"of the"},{"g":"roof"}]},{"text":"Está bem acima de você.","en":"It's right above you.","words":[null,null,null,{"g":"of / from"},{"g":"you"}],"phrases":[[0,2,"all right"]]},{"text":"Tom ainda está acima do peso.","en":"Tom is still overweight.","words":[{"g":"tone"},{"g":"still"},{"g":"is","l":"estar"},null,{"g":"of the"},{"g":"weight"}]}]}