{"id":"perdedor","lemma":"perdedor","pos":"noun","rank":2307,"glosses":["loser (person who fails to win)","loser (someone with bad luck or poor skills who consistently loses)","loser (person who is frequently unsuccessful in life)"],"ipa":"/peʁ.deˈdoʁ/","gender":"m","forms":{"plural":"perdedores","feminine":"perdedora","femininePlural":"perdedoras"},"examples":[{"text":"Esse cara é um perdedor.","en":"This guy is a loser.","audio":"https://tatoeba.org/en/audio/download/1274130","words":[{"g":"that"},{"g":"guy, dude"},{"g":"is","l":"ser"},{"g":"a"},null]},{"text":"Que perdedora!","en":"What a loser!","audio":"https://tatoeba.org/en/audio/download/76237","words":[{"g":"that / what"},null]},{"text":"Quem é o perdedor?","en":"Who's the loser?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"the / it"},null]},{"text":"Não somos perdedores.","en":"We're not losers.","words":[{"g":"not / no"},{"g":"to be","l":"ser"},null]},{"text":"Você não é uma perdedora.","en":"You're not a loser.","words":[{"g":"you"},null,null,{"g":"a","l":"um"},null],"phrases":[[1,3,"isn't it"]]}]}