{"id":"parada","lemma":"parada","pos":"noun","rank":2484,"glosses":["halt (the act of stopping or halting)","parade (organised procession with displays and performances)","stake (money laid down as a wager)"],"ipa":"/pɐˈɾa.dɐ/","gender":"f","forms":{"plural":"paradas"},"examples":[{"text":"Podemos fazer uma parada?","en":"Can we take a break?","audio":"https://tatoeba.org/en/audio/download/963392","words":[{"g":"to be able to","l":"poder"},{"g":"to create"},{"g":"a","l":"um"},null]},{"text":"Esta é a minha parada.","en":"This is my stop.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},null,null,null],"phrases":[[2,4,"the missus"]]},{"text":"Ela ficou parada em frente ao espelho.","en":"She stood in front of the mirror.","words":[{"g":"she"},{"g":"to become","l":"ficar"},null,{"g":"in"},{"g":"front"},{"g":"to the"},{"g":"mirror"}]},{"text":"Quero descer na próxima parada.","en":"I want to get off at the next stop.","words":[{"g":"to want","l":"querer"},{"g":"to descend, to go down"},{"g":"in the"},{"g":"near, close","l":"próximo"},null]},{"text":"Tente ficar parada.","en":"Try to stay still.","words":[{"g":"to try","l":"tentar"},{"g":"to become"},null]}]}