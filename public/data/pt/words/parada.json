{"id":"parada","lemma":"parada","pos":"noun","rank":1159,"glosses":["halt (the act of stopping or halting)","stop (place where passengers get on and off buses or trams)","parade (organised procession with displays and performances)"],"ipa":"/paˈɾa.dɐ/","gender":"f","forms":{"plural":"paradas"},"examples":[{"text":"Podemos fazer uma parada?","en":"Can we take a break?","audio":"https://tatoeba.org/en/audio/download/963392","words":[{"g":"to be able to","l":"poder"},{"g":"to create"},{"g":"a","l":"um"},null]},{"text":"Esta é a minha parada.","en":"This is my stop.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},null,null,null],"phrases":[[2,4,"the missus"]]},{"text":"Havia uma parada de ônibus aqui.","en":"There used to be a bus stop here.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"of / from"},{"g":"bus"},{"g":"here"}]},{"text":"Você não deveria tomar água parada.","en":"You shouldn't drink stagnant water.","words":[{"g":"you"},{"g":"not / no"},{"g":"should","l":"dever"},{"g":"to take"},{"g":"water"},null]},{"text":"Tente ficar parada.","en":"Try to stay still.","words":[{"g":"to try","l":"tentar"},{"g":"to become"},null]}]}