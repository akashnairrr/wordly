{"id":"seguinte","lemma":"seguinte","pos":"adj","rank":736,"glosses":["next (following in a sequence)","following (about to be specified)"],"ipa":"/sɨˈɡĩ.tɨ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ae/LL-Q5146_%28por%29-Santamarcanda-seguinte.wav/LL-Q5146_%28por%29-Santamarcanda-seguinte.wav.mp3","forms":{"plural":"seguintes"},"examples":[{"text":"Na manhã seguinte, ele partiu.","en":"The next morning, he was gone.","words":[{"g":"in the"},{"g":"morning"},null,{"g":"he"},{"g":"to split","l":"partir"}]},{"text":"Ele morreu no dia seguinte.","en":"He died the next day.","words":[{"g":"he"},{"g":"to die","l":"morrer"},{"g":"in the"},{"g":"period between sunrise…"},null]},{"text":"A chuva parou no dia seguinte.","en":"The rain stopped the next day.","words":[{"g":"the / to"},{"g":"rain"},{"g":"to stop","l":"parar"},{"g":"in the"},{"g":"period between sunrise…"},null]},{"text":"Eu preciso dos seguintes itens.","en":"I need the following items.","words":[{"g":"I"},{"g":"to need","l":"precisar"},null,null,{"g":"item","l":"item"}]},{"text":"Tom morreu na noite seguinte.","en":"Tom died the following night.","words":[{"g":"tone"},{"g":"to die","l":"morrer"},{"g":"in the"},{"g":"night"},null]}]}