{"id":"se_culo","lemma":"século","pos":"noun","rank":1438,"glosses":["century (time)"],"ipa":"/ˈsɛ.ku.lu/","gender":"m","forms":{"plural":"séculos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c3/LL-Q5146_%28por%29-Nelson_Ricardo_2500-s%C3%A9culo.wav","examples":[{"text":"Um século tem cem anos.","en":"A century is one hundred years.","words":[{"g":"a"},null,{"g":"has / there is","l":"ter"},{"g":"a value of one hundred"},{"g":"year","l":"ano"}]},{"text":"Eu tenho meio século de idade.","en":"I'm over a half century old.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"middle, center"},null,null,null],"phrases":[[4,6,"aged"]]},{"text":"Eu não faço isso há séculos.","en":"I haven't done this in ages.","words":[{"g":"I"},{"g":"not / no"},{"g":"to create","l":"fazer"},{"g":"that"},{"g":"there be","l":"haver"},null]},{"text":"Ele nasceu no século XIX.","en":"He was born in the 19th century.","words":[{"g":"he"},{"g":"to be born","l":"nascer"},{"g":"in the"},null,null]},{"text":"Faz séculos que eu não te vejo.","en":"I haven't seen you in ages.","words":[{"g":"to create","l":"fazer"},null,{"g":"that / what"},{"g":"I"},{"g":"not / no"},{"g":"you"},{"g":"to see","l":"ver"}]}]}