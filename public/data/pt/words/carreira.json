{"id":"carreira","lemma":"carreira","pos":"noun","rank":938,"glosses":["path, trail (particularly one which had to be opened)","trail left by a moving vehicle","career (one's profession)"],"ipa":"/kɐˈʁɐj.ɾɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/LL-Q5146_%28por%29-Santamarcanda-carreira.wav/LL-Q5146_%28por%29-Santamarcanda-carreira.wav.mp3","gender":"f","forms":{"plural":"carreiras"},"examples":[{"text":"Minha carreira está em jogo.","en":"My career is on the line.","words":[{"g":"my, mine","l":"meu"},null,{"g":"is","l":"estar"},null,null],"phrases":[[3,5,"at stake"]]},{"text":"Estou pensando em mudar de carreira.","en":"I'm thinking about changing careers.","words":[{"g":"am","l":"estar"},{"g":"to think","l":"pensar"},{"g":"in"},{"g":"to change"},{"g":"of / from"},null]},{"text":"Sua família deve vir antes da sua carreira.","en":"Your family should come before your career.","words":[{"g":"his","l":"seu"},{"g":"family"},{"g":"should","l":"dever"},{"g":"to come"},{"g":"before"},{"g":"of the"},{"g":"his","l":"seu"},null]},{"text":"Para ela a carreira política terminou.","en":"Her political career has ended.","words":[{"g":"for / to"},{"g":"she"},{"g":"the / to"},null,{"g":"politics"},{"g":"to finish","l":"terminar"}]},{"text":"O que vem primeiro, sua carreira ou sua família?","en":"Which comes first, your career or your family?","words":[null,null,{"g":"to come","l":"vir"},{"g":"first"},{"g":"his","l":"seu"},null,{"g":"or"},{"g":"his","l":"seu"},{"g":"family"}],"phrases":[[0,2,"what"]]}]}