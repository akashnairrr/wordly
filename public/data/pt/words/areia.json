{"id":"areia","lemma":"areia","pos":"noun","rank":1648,"glosses":["sand (finely ground rock)"],"ipa":"/ɐˈɾɐj.ɐ/","gender":"f","forms":{"plural":"areias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q5146_%28por%29-Nelson_Ricardo_2500-areia.wav","examples":[{"text":"Eu odeio areia.","en":"I hate sand.","audio":"https://tatoeba.org/en/audio/download/103417","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},null]},{"text":"Vamos deitar na areia.","en":"Let's lie on the sand.","words":[{"g":"let's go"},{"g":"to lie down"},{"g":"in the"},null]},{"text":"A areia estava quente.","en":"The sand was warm.","words":[{"g":"the / to"},null,{"g":"to be","l":"estar"},{"g":"hot, warm"}]},{"text":"Não gosto de areia.","en":"I don't like sand.","words":[{"g":"not / no"},{"g":"to like","l":"gostar"},{"g":"of / from"},null]},{"text":"Fizemos um castelo de areia.","en":"We made a sand castle.","words":[{"g":"to create","l":"fazer"},{"g":"a"},{"g":"castle"},{"g":"of / from"},null]}]}