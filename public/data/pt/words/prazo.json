{"id":"prazo","lemma":"prazo","pos":"noun","rank":2029,"glosses":["deadline (date on or before which something must be completed)","expiration date","a period of time"],"ipa":"/ˈpɾa.zu/","gender":"m","forms":{"plural":"prazos"},"examples":[{"text":"O prazo é segunda.","en":"The deadline is Monday.","audio":"https://tatoeba.org/en/audio/download/471639","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"second","l":"segundo"}]},{"text":"Ele perdeu o prazo.","en":"He missed the deadline.","words":[{"g":"he"},{"g":"to lose","l":"perder"},{"g":"the / it"},null]},{"text":"O prazo era ontem.","en":"The deadline was yesterday.","words":[{"g":"the / it"},null,{"g":"to be","l":"ser"},{"g":"yesterday"}]},{"text":"Quero pagar a prazo.","en":"I want to pay in installments.","words":[{"g":"to want","l":"querer"},{"g":"to give [someone] money…"},{"g":"the / to"},null]},{"text":"Eles lutaram para cumprir seus prazos.","en":"They struggled to meet their deadlines.","words":[{"g":"they"},null,{"g":"for / to"},{"g":"to carry out"},{"g":"their or your kin"},null]}]}