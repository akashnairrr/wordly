{"id":"lentamente","lemma":"lentamente","pos":"adv","rank":2373,"glosses":["slowly"],"ipa":"/ˌlẽ.tɐˈmẽ.tɨ/","examples":[{"text":"Ele anda lentamente.","en":"He walks slowly.","words":[{"g":"he"},{"g":"to walk","l":"andar"},null]},{"text":"Abri a porta lentamente.","en":"I opened the door slowly.","audio":"https://tatoeba.org/en/audio/download/65830","words":[{"g":"to open","l":"abrir"},{"g":"the / to"},{"g":"door"},null]},{"text":"Ele me disse para falar mais lentamente.","en":"He told me to speak more slowly.","words":[{"g":"he"},{"g":"me"},{"g":"to speak","l":"dizer"},{"g":"for / to"},{"g":"to speak"},{"g":"more"},null]},{"text":"Vamos descer as escadas lentamente.","en":"Let's go down the stairs slowly.","words":[{"g":"let's go"},{"g":"to descend, to go down"},{"g":"the"},{"g":"ladder","l":"escada"},null]},{"text":"Tom escreve lentamente.","en":"Tom writes slowly.","audio":"https://tatoeba.org/en/audio/download/1274485","words":[{"g":"tone"},{"g":"to write","l":"escrever"},null]}]}