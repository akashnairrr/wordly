{"id":"lentamente","lemma":"lentamente","pos":"adv","rank":2221,"glosses":["slowly"],"ipa":"/ˌlẽ.taˈmẽ.t͡ʃi/","examples":[{"text":"Ele anda lentamente.","en":"He walks slowly.","words":[{"g":"he"},{"g":"to walk","l":"andar"},null]},{"text":"A porta se abriu lentamente.","en":"The door opened slowly.","words":[{"g":"the / to"},{"g":"door"},{"g":"if / oneself"},{"g":"to open","l":"abrir"},null]},{"text":"Ele me disse para falar mais lentamente.","en":"He told me to speak more slowly.","words":[{"g":"he"},{"g":"me"},{"g":"to speak","l":"dizer"},{"g":"for / to"},{"g":"to speak"},{"g":"more"},null]},{"text":"Tom escreve lentamente.","en":"Tom writes slowly.","audio":"https://tatoeba.org/en/audio/download/1274485","words":[{"g":"tone"},{"g":"to write","l":"escrever"},null]},{"text":"Eles avançaram lentamente.","en":"They moved ahead slowly.","words":[{"g":"they"},null,null]}]}