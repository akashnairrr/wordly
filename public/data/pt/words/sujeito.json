{"id":"sujeito","lemma":"sujeito","pos":"noun","rank":1743,"glosses":["subject (the noun, pronoun or noun phrase about whom the statement is made)","guy, bloke, person (unnamed individual)","subject (that of which something is stated)"],"ipa":"/suˈʒɐj.tu/","gender":"m","forms":{"plural":"sujeitos"},"examples":[{"text":"Tom é um sujeito estranho.","en":"Tom is a strange guy.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"a"},null,{"g":"odd"}]},{"text":"O sujeito de pé ali é meu amigo.","en":"The fellow standing over there is my friend.","words":[{"g":"the / it"},null,null,null,{"g":"there )"},{"g":"is","l":"ser"},{"g":"my, mine"},{"g":"friendly"}],"phrases":[[2,4,"up"]]},{"text":"Ele é sujeito a acessos de raiva.","en":"He is subject to fits of anger.","words":[{"g":"he"},{"g":"is","l":"ser"},null,{"g":"the / to"},{"g":"access","l":"acesso"},{"g":"of / from"},{"g":"anger"}]},{"text":"Sou um sujeito azarado.","en":"I'm an unlucky guy.","words":[{"g":"am","l":"ser"},{"g":"a"},null,{"g":"unlucky"}]},{"text":"Tom é um sujeito interessante.","en":"Tom is an interesting fellow.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"a"},null,{"g":"entertaining"}]}]}