{"id":"trabalho","lemma":"trabalho","pos":"noun","rank":116,"glosses":["job (economic role for which a person is paid)","job; task (piece of work done as part of one’s duties)","work; toil; labour; effort"],"ipa":"/tɾɐˈba.ʎu/","gender":"m","forms":{"plural":"trabalhos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q5146_%28por%29-Nelson_Ricardo_2500-trabalho.wav","examples":[{"text":"Odeio este trabalho.","en":"I hate this job.","audio":"https://tatoeba.org/en/audio/download/490920","words":[{"g":"to hate, to loathe","l":"odiar"},{"g":"this"},null]},{"text":"Não é o meu trabalho.","en":"It's not my job.","audio":"https://tatoeba.org/en/audio/download/1272158","words":[null,null,{"g":"the / it"},{"g":"my, mine"},null],"phrases":[[0,2,"isn't it"]]},{"text":"Tom tem um trabalho muito fácil.","en":"Tom has a very easy job.","audio":"https://tatoeba.org/en/audio/download/1274556","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},{"g":"a"},null,{"g":"very / a lot"},{"g":"easy"}]},{"text":"Tom tem dois trabalhos.","en":"Tom has two jobs.","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},{"g":"deuce"},null]},{"text":"Tom gosta do trabalho dele?","en":"Does Tom like his job?","audio":"https://tatoeba.org/en/audio/download/535106","words":[{"g":"tone"},{"g":"to like","l":"gostar"},{"g":"of the"},null,{"g":"his / of him","l":"delir"}]}]}