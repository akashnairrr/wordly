{"id":"trabalho","lemma":"trabalho","pos":"noun","rank":121,"glosses":["job (economic role for which a person is paid)","job; task (piece of work done as part of one’s duties)","work; toil; labour; effort"],"ipa":"/tɾaˈba.ʎu/","gender":"m","forms":{"plural":"trabalhos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q5146_%28por%29-Nelson_Ricardo_2500-trabalho.wav","examples":[{"text":"Eu amo meu trabalho.","en":"I love my job.","audio":"https://tatoeba.org/en/audio/download/489922","words":[{"g":"I"},{"g":"to love","l":"amar"},{"g":"my, mine"},null]},{"text":"Odeio este trabalho.","en":"I hate this job.","audio":"https://tatoeba.org/en/audio/download/490920","words":[{"g":"to hate, to loathe","l":"odiar"},{"g":"this"},null]},{"text":"Não é o meu trabalho.","en":"It's not my job.","audio":"https://tatoeba.org/en/audio/download/1272158","words":[null,null,{"g":"the / it"},{"g":"my, mine"},null],"phrases":[[0,2,"isn't it"]]},{"text":"Eu tenho um trabalho para terminar.","en":"I have a job to finish.","audio":"https://tatoeba.org/en/audio/download/535238","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"a"},null,{"g":"for / to"},{"g":"to finish"}]},{"text":"Tom tem dois trabalhos.","en":"Tom has two jobs.","words":[{"g":"tone"},{"g":"has / there is","l":"ter"},{"g":"deuce"},null]}]}