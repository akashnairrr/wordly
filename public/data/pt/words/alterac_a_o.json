{"id":"alterac_a_o","lemma":"alteração","pos":"noun","rank":3677,"glosses":["alteration, change, modification"],"ipa":"/al.tɨ.ɾɐˈsɐ̃w̃/","gender":"f","forms":{"plural":"alterações"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q5146_%28por%29-Wiktionairy-altera%C3%A7%C3%A3o.wav","examples":[{"text":"Fizemos três alterações.","en":"We made three changes.","words":[{"g":"to create","l":"fazer"},{"g":"three"},null]},{"text":"Eles fizeram muitas alterações.","en":"They made many changes.","words":[{"g":"they"},null,{"g":"very, a lot","l":"muito"},null]},{"text":"Não gostei das alterações que vocês fizeram.","en":"I don't like the changes you've made.","words":[{"g":"not / no"},{"g":"to like","l":"gostar"},null,null,{"g":"that / what"},{"g":"you (pl.)"},null]},{"text":"Eu sugeriria a seguinte alteração.","en":"I would suggest the following change.","words":[{"g":"I"},{"g":"to suggest","l":"sugerir"},{"g":"the / to"},{"g":"next"},null]},{"text":"Elas fizeram muitas alterações.","en":"They made many changes.","words":[{"g":"they"},null,{"g":"very, a lot","l":"muito"},null]}]}