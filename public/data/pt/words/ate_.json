{"id":"ate_","lemma":"até","pos":"prep","rank":65,"glosses":["until (up to the time of something happening)","by (at some point before the given time)","to (all the way to a place)"],"ipa":"/aˈtɛ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/LL-Q5146_%28por%29-MedK1-at%C3%A9.wav/LL-Q5146_%28por%29-MedK1-at%C3%A9.wav.mp3","examples":[{"text":"Espere até amanhã.","en":"Wait until tomorrow.","audio":"https://tatoeba.org/en/audio/download/843764","words":[{"g":"to wait","l":"esperar"},null,{"g":"tomorrow"}]},{"text":"Eu trabalho até muito tarde.","en":"I work until very late.","audio":"https://tatoeba.org/en/audio/download/533954","words":[{"g":"I"},{"g":"job"},null,{"g":"very / a lot"},{"g":"late"}]},{"text":"Onde você esteve até agora?","en":"Where have you been until now?","words":[{"g":"where"},{"g":"you"},{"g":"to be","l":"estar"},null,{"g":"now"}]},{"text":"Irei com você até lá.","en":"I'll go there with you.","words":[{"g":"to go","l":"ir"},{"g":"with"},{"g":"you"},null,{"g":"there"}]},{"text":"Não irei até amanhã.","en":"I won't go till tomorrow.","audio":"https://tatoeba.org/en/audio/download/1270323","words":[{"g":"not / no"},{"g":"to go","l":"ir"},null,{"g":"tomorrow"}]}]}