{"id":"trabalhador","lemma":"trabalhador","pos":"adj","rank":2201,"glosses":["hard-working"],"ipa":"/tɾɐ.bɐ.ʎɐˈdoɾ/","forms":{"feminine":"trabalhadora","masculinePlural":"trabalhadores","femininePlural":"trabalhadoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/75/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-trabalhador.wav","examples":[{"text":"Três trabalhadores morreram.","en":"Three workers died.","words":[{"g":"three"},null,null]},{"text":"Precisamos de mais trabalhadores.","en":"We need more workers.","words":[{"g":"to need","l":"precisar"},{"g":"of / from"},{"g":"more"},null]},{"text":"Ele é um trabalhador esforçado.","en":"He is a hard worker.","words":[{"g":"he"},{"g":"is","l":"ser"},{"g":"a"},null,{"g":"to strain","l":"esforçar"}]},{"text":"Ele era um líder da classe trabalhadora.","en":"He was a leader of the working class.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"leader"},{"g":"of the"},{"g":"class, kind"},null]},{"text":"Muitos dos trabalhadores morreram de fome.","en":"Many of the workers died of hunger.","words":[{"g":"very, a lot","l":"muito"},null,null,null,{"g":"of / from"},{"g":"hunger"}]}]}