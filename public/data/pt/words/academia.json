{"id":"academia","lemma":"academia","pos":"noun","rank":2153,"glosses":["academy"],"ipa":"/ɐ.kɐ.dɨˈmi.ɐ/","gender":"f","forms":{"plural":"academias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q5146_%28por%29-MedK1-academia.wav","examples":[{"text":"Tom deveria ir à academia.","en":"Tom should go to the gym.","words":[{"g":"tone"},{"g":"should","l":"dever"},{"g":"to go"},{"g":"to the"},null]},{"text":"Tom está na academia.","en":"Tom is in the gym.","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"in the"},null]},{"text":"Eu fui à academia.","en":"I went to the gym.","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"to the"},null]},{"text":"Você quer ir à academia com a gente?","en":"Do you want to go to the gym with us?","words":[{"g":"you (formal)"},{"g":"to want","l":"querer"},{"g":"to go"},{"g":"to the"},null,{"g":"with"},null,null],"phrases":[[6,8,"we"]]},{"text":"Estou indo para a academia.","en":"I'm going to the gym.","words":[{"g":"am","l":"estar"},{"g":"to go","l":"ir"},{"g":"for / to"},{"g":"the / to"},null]}]}