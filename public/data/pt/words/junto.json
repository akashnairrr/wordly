{"id":"junto","lemma":"junto","pos":"adv","rank":231,"glosses":["together (at the same time, in the same place)","near, next"],"ipa":"/ˈʒũ.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/LL-Q5146_%28por%29-Santamarcanda-junto.wav/LL-Q5146_%28por%29-Santamarcanda-junto.wav.mp3","examples":[{"text":"Você quer ir junto?","en":"Do you want to go together?","words":[{"g":"you"},{"g":"to want","l":"querer"},{"g":"to go"},null]},{"text":"Havia outros junto a você?","en":"Were there others with you?","audio":"https://tatoeba.org/en/audio/download/1271131","words":[{"g":"there be","l":"haver"},{"g":"other one","l":"outro"},null,{"g":"the / to"},{"g":"you"}]},{"text":"Eu ainda gostaria de trabalhar junto.","en":"I'd still like to work together.","words":[{"g":"I"},{"g":"still"},{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"to work"},null]},{"text":"Posso fazer isso junto com você?","en":"Can I do that with you?","words":[{"g":"to be able to","l":"poder"},{"g":"to create"},{"g":"that"},null,{"g":"with"},{"g":"you"}]},{"text":"A gente deveria ir junto.","en":"We should go together.","words":[null,null,{"g":"should","l":"dever"},{"g":"to go"},null],"phrases":[[0,2,"we"]]}]}