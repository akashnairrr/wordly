{"id":"garoto","lemma":"garoto","pos":"noun","rank":262,"glosses":["boy, young man","café au lait, latte (coffee with milk)"],"ipa":"/ɡaˈɾo.tu/","gender":"m","forms":{"plural":"garotos","feminine":"garota","femininePlural":"garotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q5146_%28por%29-Nelson_Ricardo_2500-garoto.wav","formAudio":{"garota":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q5146_%28por%29-Nelson_Ricardo_2500-garota.wav","garotas":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q5146_%28por%29-Nelson_Ricardo_2500-garotas.wav"},"examples":[{"text":"Eu sou um garoto.","en":"I'm a boy.","audio":"https://tatoeba.org/en/audio/download/489665","words":[{"g":"I"},{"g":"am","l":"ser"},{"g":"a"},null]},{"text":"Você conhece o garoto nesta foto?","en":"Do you know the boy in this picture?","words":[{"g":"you"},{"g":"to know","l":"conhecer"},{"g":"the / it"},null,null,{"g":"photo"}]},{"text":"Quem é aquele garoto?","en":"Who's that boy?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"that over there, yon"},null]},{"text":"Ele parece um bom garoto.","en":"He looks like a good boy.","audio":"https://tatoeba.org/en/audio/download/841604","words":[{"g":"he"},{"g":"to seem","l":"parecer"},{"g":"a"},{"g":"desirable"},null]},{"text":"Há um garoto perto da porta.","en":"There is a boy near the door.","words":[{"g":"there be","l":"haver"},{"g":"a"},null,{"g":"close, closely, next"},{"g":"of the"},{"g":"door"}]}]}