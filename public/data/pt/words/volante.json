{"id":"volante","lemma":"volante","pos":"adj","rank":3390,"glosses":["flying","floating","loose"],"ipa":"/voˈlɐ̃.t͡ʃi/","forms":{"plural":"volantes"},"examples":[{"text":"Coloque as mãos no volante.","en":"Put both hands on the steering wheel.","words":[{"g":"to place","l":"colocar"},{"g":"the"},{"g":"hand","l":"mão"},{"g":"in the"},null]},{"text":"Tinha uma garotinha no volante.","en":"A young girl was at the steering wheel.","words":[{"g":"to own","l":"ter"},{"g":"a","l":"um"},{"g":"girl","l":"garota"},{"g":"in the"},null]},{"text":"Tom dormiu ao volante.","en":"Tom fell asleep at the wheel.","words":[{"g":"tone"},{"g":"to sleep","l":"dormir"},null,null]},{"text":"Toma o volante, Tom.","en":"Take the wheel, Tom.","words":[{"g":"to take","l":"tomar"},{"g":"the / it"},null,{"g":"tone"}]},{"text":"Tom dormiu no volante e causou um acidente.","en":"Tom fell asleep at the wheel and caused an accident.","words":[{"g":"tone"},{"g":"to sleep","l":"dormir"},{"g":"in the"},null,{"g":"and"},{"g":"to cause","l":"causar"},{"g":"a"},{"g":"accident"}]}]}