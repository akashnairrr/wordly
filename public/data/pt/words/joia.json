{"id":"joia","lemma":"joia","pos":"noun","rank":4059,"glosses":["jewel (a precious or semi-precious stone)","gem, treasure (anything considered precious or valuable)","admission (the cost or fee associated with attendance or entry)"],"ipa":"/ˈʒɔj.ɐ/","gender":"f","forms":{"plural":"joias"},"examples":[{"text":"Eu nunca comprei joias.","en":"I've never bought jewelry.","words":[{"g":"I"},{"g":"never (at no time"},{"g":"to buy","l":"comprar"},null]},{"text":"Estas joias são caras.","en":"These jewels are expensive.","words":[{"g":"this","l":"este"},null,{"g":"to be","l":"ser"},{"g":"greatly valued","l":"caro"}]},{"text":"A polícia encontrou a joia roubada.","en":"The police found the stolen jewelry.","words":[{"g":"the / to"},{"g":"police"},{"g":"to meet","l":"encontrar"},{"g":"the / to"},null,{"g":"robbed","l":"roubado"}]},{"text":"Não possuo nenhuma joia cara.","en":"I don't own any expensive jewelry.","words":[{"g":"not / no"},{"g":"to possess","l":"possuir"},{"g":"not any, none","l":"nenhum"},null,{"g":"face"}]},{"text":"Normalmente não uso joias.","en":"I don't usually wear jewelry.","words":[{"g":"normally"},{"g":"not / no"},{"g":"use"},null]}]}