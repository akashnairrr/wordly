{"id":"constantemente","lemma":"constantemente","pos":"adv","rank":2563,"glosses":["constantly"],"ipa":"/kõʃˌtɐ̃.tɨˈmẽ.tɨ/","examples":[{"text":"Eles brigam constantemente.","en":"They fight constantly.","words":[{"g":"they"},{"g":"to brawl, fight","l":"brigar"},null]},{"text":"Ele critica outras pessoas constantemente.","en":"He constantly criticizes other people.","words":[{"g":"he"},{"g":"to criticize","l":"criticar"},{"g":"other one","l":"outro"},{"g":"person","l":"pessoa"},null]},{"text":"Minha mãe esquece constantemente o nome das pessoas.","en":"My mother is constantly forgetting people's names.","words":[{"g":"my, mine","l":"meu"},{"g":"mother"},{"g":"to forget","l":"esquecer"},null,{"g":"the / it"},{"g":"name"},null,{"g":"person","l":"pessoa"}]},{"text":"Eu constantemente falo comigo mesmo.","en":"I constantly talk to myself.","words":[{"g":"I"},null,{"g":"to speak","l":"falar"},{"g":"prepositional form with…"},{"g":"really"}]},{"text":"Eu estou, constantemente, esquecendo nomes.","en":"I am constantly forgetting names.","words":[{"g":"I"},{"g":"am","l":"estar"},null,{"g":"to forget","l":"esquecer"},{"g":"name","l":"nome"}]}]}