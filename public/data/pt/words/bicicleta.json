{"id":"bicicleta","lemma":"bicicleta","pos":"noun","rank":1599,"glosses":["bicycle (vehicle)","bicycle kick (a kick in which the kicker leans backwards and kicks the ball back over his head)"],"ipa":"/bi.siˈklɛ.tɐ/","gender":"f","forms":{"plural":"bicicletas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q5146_%28por%29-Nelson_Ricardo_2500-bicicleta.wav","examples":[{"text":"Não tenho uma bicicleta.","en":"I don't have a bicycle.","audio":"https://tatoeba.org/en/audio/download/533677","words":[{"g":"not / no"},{"g":"have","l":"ter"},{"g":"a","l":"um"},null]},{"text":"Nós temos apenas três bicicletas.","en":"We only have three bicycles.","words":[{"g":"we"},{"g":"to own","l":"ter"},{"g":"only"},{"g":"three"},null]},{"text":"Ele tem uma bicicleta.","en":"He has a bicycle.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},null]},{"text":"Eu quero uma bicicleta.","en":"I want a bicycle.","words":[{"g":"I"},{"g":"to want","l":"querer"},{"g":"a","l":"um"},null]},{"text":"Eu não preciso de três bicicletas.","en":"I don't need three bicycles.","words":[{"g":"I"},{"g":"not / no"},{"g":"precise"},{"g":"of / from"},{"g":"three"},null]}]}