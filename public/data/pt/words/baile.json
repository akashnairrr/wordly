{"id":"baile","lemma":"baile","pos":"noun","rank":1148,"glosses":["ball (a formal dance)","subjugation"],"ipa":"/ˈbaj.lɨ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/LL-Q5146_%28por%29-Santamarcanda-baile.wav/LL-Q5146_%28por%29-Santamarcanda-baile.wav.mp3","gender":"m","forms":{"plural":"bailes"},"examples":[{"text":"Iremos ao baile juntos.","en":"We'll go to the prom together.","words":[{"g":"to go","l":"ir"},{"g":"to the"},null,{"g":"together","l":"junto"}]},{"text":"Tom não foi ao baile.","en":"Tom didn't go to the dance.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"to the"},null]},{"text":"Nós temos bailes aqui uma vez por mês.","en":"We have dances here once a month.","words":[{"g":"we"},{"g":"to own","l":"ter"},null,{"g":"here"},null,null,{"g":"for / by"},{"g":"month"}],"phrases":[[4,6,"once"]]},{"text":"\"Quer ir comigo ao baile?\" \"Sinto muito, mas não dá.\"","en":"\"Do you want to go to the dance with me?\" \"I'm really sorry, but I can't.\"","words":[{"g":"to want","l":"querer"},{"g":"to go"},{"g":"prepositional form with…"},{"g":"to the"},null,null,null,{"g":"but"},{"g":"not / no"},{"g":"to transfer one’s…","l":"dar"}],"phrases":[[5,7,"I'm sorry"]]},{"text":"Com quem o Tom quer ir ao baile?","en":"Who does Tom want to go to the prom with?","words":[{"g":"with"},{"g":"who"},{"g":"the / it"},{"g":"tone"},{"g":"to want","l":"querer"},{"g":"to go"},{"g":"to the"},null]}]}