{"id":"quinze","lemma":"quinze","pos":"noun","rank":2386,"glosses":["fifteen"],"ipa":"/ˈkĩ.zɨ/","gender":"m","forms":{"plural":"quinzes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c3/LL-Q5146_%28por%29-Nelson_Ricardo_2500-quinze.wav","examples":[{"text":"São nove e quinze da manhã.","en":"It's a quarter after nine in the morning.","audio":"https://tatoeba.org/en/audio/download/64157","words":[{"g":"to be","l":"ser"},{"g":"nine"},{"g":"and"},null,{"g":"of the"},{"g":"morning"}]},{"text":"Mais quinze minutos e estarei livre.","en":"Fifteen more minutes and I'll be out of here.","words":[{"g":"more"},null,{"g":"minute","l":"minuto"},{"g":"and"},{"g":"to be","l":"estar"},{"g":"free"}]},{"text":"Por favor, espere quinze minutos.","en":"Please wait fifteen minutes.","words":[null,null,{"g":"to wait","l":"esperar"},null,{"g":"minute","l":"minuto"}],"phrases":[[0,2,"please"]]},{"text":"Na época tínhamos apenas quinze anos.","en":"At the time, we were just fifteen years old.","words":[null,null,{"g":"to own","l":"ter"},{"g":"only"},null,{"g":"year","l":"ano"}],"phrases":[[0,2,"back then"]]},{"text":"Minha filha mal sequer tem quinze anos.","en":"My daughter is barely fifteen.","words":[{"g":"my, mine","l":"meu"},{"g":"daughter"},{"g":"badly"},{"g":"at least, at the least"},{"g":"has / there is","l":"ter"},null,{"g":"year","l":"ano"}]}]}