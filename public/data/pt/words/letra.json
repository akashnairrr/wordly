{"id":"letra","lemma":"letra","pos":"noun","rank":2214,"glosses":["letter (letter of the alphabet)","calligraphy (style of handwriting of a person), handwriting","font"],"ipa":"/ˈle.tɾɐ/","gender":"f","forms":{"plural":"letras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q5146_%28por%29-Nelson_Ricardo_2500-letra.wav","examples":[{"text":"Sua letra é horrível.","en":"Your writing is horrible.","audio":"https://tatoeba.org/en/audio/download/1270408","words":[{"g":"his","l":"seu"},null,{"g":"is","l":"ser"},{"g":"cause of horror"}]},{"text":"Você sabe a letra?","en":"Do you know the lyrics?","words":[{"g":"you (formal)"},{"g":"to be aware, to know","l":"saber"},{"g":"the / to"},null]},{"text":"Qual é a letra dessa música?","en":"What are the lyrics to that song?","words":[{"g":"which"},{"g":"is","l":"ser"},{"g":"the / to"},null,{"g":"of that"},{"g":"music"}]},{"text":"Ela tem uma letra muito bonita.","en":"She has very nice-looking handwriting.","words":[{"g":"she"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},null,{"g":"very / a lot"},{"g":"pretty, lovely","l":"bonito"}]},{"text":"Nós não sabemos a letra.","en":"We don't know the lyrics.","words":[{"g":"we"},{"g":"not / no"},{"g":"to be aware, to know","l":"saber"},{"g":"the / to"},null]}]}