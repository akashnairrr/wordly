{"id":"coberto","lemma":"coberto","pos":"adj","rank":2933,"glosses":["covered (overlaid with something)","covered by blankets","having a roof above"],"ipa":"/kuˈbɛɾ.tu/","forms":{"feminine":"coberta","masculinePlural":"cobertos","femininePlural":"cobertas"},"examples":[{"text":"O chão esta coberto de neve.","en":"The ground is covered with snow.","words":[{"g":"the / it"},{"g":"ground, soil, earth"},{"g":"this","l":"este"},null,{"g":"of / from"},{"g":"snow"}]},{"text":"Eles estavam cobertos de sangue.","en":"They were covered in blood.","words":[{"g":"they"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"blood"}]},{"text":"Tudo aqui está coberto de pó.","en":"Everything here is covered in dust.","words":[{"g":"everything"},{"g":"here"},{"g":"is","l":"estar"},null,{"g":"of / from"},{"g":"powder"}]},{"text":"Tom estava coberto de sangue.","en":"Tom was covered in blood.","words":[{"g":"tone"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"blood"}]},{"text":"O céu está coberto de nuvens.","en":"The sky is covered with clouds.","words":[{"g":"the / it"},{"g":"sky"},{"g":"is","l":"estar"},null,{"g":"of / from"},{"g":"cloud","l":"nuvem"}]}]}