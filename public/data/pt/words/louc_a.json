{"id":"louc_a","lemma":"louça","pos":"noun","rank":4670,"glosses":["dishware, dishes; crockery","china (vessels made of pottery etc.)"],"ipa":"/ˈlo(w).sɐ/","gender":"f","forms":{"plural":"louças"},"examples":[{"text":"Vá ajudar lavar a louça.","en":"Go and help wash the dishes.","words":[{"g":"to go","l":"ir"},{"g":"to help, aid"},{"g":"to wash"},{"g":"the / to"},null]},{"text":"Meu trabalho é lavar as louças.","en":"My job is to wash the dishes.","words":[{"g":"my, mine"},{"g":"job"},{"g":"is","l":"ser"},{"g":"to wash"},{"g":"the"},null]},{"text":"Eu tenho de lavar a louça.","en":"I have to wash the dishes.","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"of / from"},{"g":"to wash"},{"g":"the / to"},null]},{"text":"Você poderia me ajudar com as louças?","en":"Could you help me wash the dishes?","words":[{"g":"you"},{"g":"to be able to","l":"poder"},{"g":"me"},{"g":"to help, aid"},{"g":"with"},{"g":"the"},null]},{"text":"Tom ajudou com a louça.","en":"Tom helped with the dishes.","words":[{"g":"tone"},{"g":"to help, aid","l":"ajudar"},{"g":"with"},{"g":"the / to"},null]}]}