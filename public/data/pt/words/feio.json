{"id":"feio","lemma":"feio","pos":"adj","rank":1815,"glosses":["ugly (visually unpleasant)","wrong, immoral","disrespectful, impolite, rude"],"ipa":"/ˈfɐj.u/","forms":{"feminine":"feia","masculinePlural":"feios","femininePlural":"feias","superlative":"o mais feio"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q5146_%28por%29-MedK1-feio.wav","examples":[{"text":"Não és feio.","en":"You're not ugly.","audio":"https://tatoeba.org/en/audio/download/1268202","words":[{"g":"not / no"},{"g":"are","l":"ser"},null]},{"text":"Vocês não são feios.","en":"You're not ugly.","audio":"https://tatoeba.org/en/audio/download/1268200","words":[{"g":"you (pl.)"},{"g":"not / no"},{"g":"to be","l":"ser"},null]},{"text":"Ele está velho e feio.","en":"He's old and ugly.","words":[{"g":"he"},{"g":"is","l":"estar"},{"g":"old"},{"g":"and"},null]},{"text":"Tom é muito feio.","en":"Tom is very ugly.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"very / a lot"},null]},{"text":"Quem é aquele cara feio?","en":"Who's that ugly man?","words":[{"g":"who"},{"g":"is","l":"ser"},{"g":"that over there, yon"},{"g":"face"},null]}]}