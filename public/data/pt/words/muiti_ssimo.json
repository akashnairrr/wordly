{"id":"muiti_ssimo","lemma":"muitíssimo","pos":"adj","rank":3622,"glosses":["very much"],"ipa":"/mũj̃ˈt͡ʃi.si.mu/","forms":{"feminine":"muitíssima","masculinePlural":"muitíssimos","femininePlural":"muitíssimas"},"examples":[{"text":"Prefiro muitíssimo trabalhar à noite.","en":"I much prefer working at night.","words":[{"g":"to prefer","l":"preferir"},null,{"g":"to work"},null,null],"phrases":[[3,5,"at night"]]},{"text":"Muitíssimo obrigado.","en":"Thank you so very much.","audio":"https://tatoeba.org/en/audio/download/1270395","words":[null,{"g":"obligatory"}]},{"text":"\"Quantas vezes você comeu aqui?\" \"Muitíssimas vezes.\"","en":"\"How many times have you eaten here?\" \"Many, many times.\"","words":[{"g":"how much","l":"quanto"},{"g":"times"},{"g":"you"},{"g":"to consume meals","l":"comer"},{"g":"here"},null,{"g":"times"}]},{"text":"Lamento muitíssimo.","en":"I'm terribly sorry.","audio":"https://tatoeba.org/en/audio/download/1268461","words":[{"g":"wailing"},null]},{"text":"Apesar de ser rico, ele trabalha muitíssimo.","en":"Although he is rich he works very hard.","words":[null,null,{"g":"to be"},{"g":"rich, wealthy"},{"g":"he"},{"g":"to work","l":"trabalhar"},null],"phrases":[[0,2,"in spite of"]]}]}