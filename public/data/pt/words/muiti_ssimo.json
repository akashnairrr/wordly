{"id":"muiti_ssimo","lemma":"muitíssimo","pos":"adj","rank":3698,"glosses":["very much"],"ipa":"/mũj̃ˈti.si.mu/","forms":{"feminine":"muitíssima","masculinePlural":"muitíssimos","femininePlural":"muitíssimas"},"examples":[{"text":"Muitíssimo obrigado.","en":"Thank you so very much.","audio":"https://tatoeba.org/en/audio/download/1270395","words":[null,{"g":"thank you"}]},{"text":"Prefiro muitíssimo trabalhar à noite.","en":"I much prefer working at night.","words":[{"g":"to prefer","l":"preferir"},null,{"g":"to work"},null,null],"phrases":[[3,5,"at night"]]},{"text":"Muitíssimo obrigado pela hospitalidade hoje.","en":"Thank you very much for your hospitality today.","words":[null,{"g":"thank you"},{"g":"by / for the","l":"pelar"},{"g":"hospitality"},{"g":"today"}]},{"text":"\"Quantas vezes vocês comeram aqui?\" \"Muitíssimas vezes.\"","en":"\"How many times have you eaten here?\" \"Many, many times.\"","words":[{"g":"how much","l":"quanto"},{"g":"times"},{"g":"you (pl.)"},null,{"g":"here"},null,{"g":"times"}]},{"text":"Muitíssimo obrigado pelo maravilhoso jantar de ontem.","en":"Thank you very much for the wonderful dinner last night.","words":[null,{"g":"thank you"},{"g":"by / for the","l":"pelar"},{"g":"wonderful"},{"g":"to dine"},{"g":"of / from"},{"g":"yesterday"}]}]}