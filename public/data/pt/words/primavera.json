{"id":"primavera","lemma":"primavera","pos":"noun","rank":1899,"glosses":["spring (the season)","spring (a period of political liberalization and democratization)"],"ipa":"/pɾi.mɐˈvɛ.ɾɐ/","gender":"f","forms":{"plural":"primaveras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q5146_%28por%29-Nelson_Ricardo_2500-primavera.wav","examples":[{"text":"Logo será primavera.","en":"It'll be spring soon.","words":[{"g":"soon"},{"g":"to be","l":"ser"},null]},{"text":"Quando começa a primavera?","en":"When does spring begin?","audio":"https://tatoeba.org/en/audio/download/852111","words":[{"g":"when"},{"g":"to start","l":"começar"},{"g":"the / to"},null]},{"text":"A primavera chegou cedo este ano.","en":"Spring has come early this year.","words":[{"g":"the / to"},null,{"g":"to arrive","l":"chegar"},{"g":"early (at a time before…"},{"g":"this"},{"g":"year"}]},{"text":"Eu não gosto de primavera.","en":"I don't like spring.","audio":"https://tatoeba.org/en/audio/download/494667","words":[{"g":"I"},{"g":"not / no"},{"g":"to like","l":"gostar"},{"g":"of / from"},null]},{"text":"A primavera está vindo logo.","en":"Spring is coming soon.","words":[{"g":"the / to"},null,{"g":"is","l":"estar"},{"g":"arrived"},{"g":"soon"}]}]}