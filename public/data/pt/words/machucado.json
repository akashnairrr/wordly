{"id":"machucado","lemma":"machucado","pos":"adj","rank":2382,"glosses":["wounded, hurt"],"ipa":"/ma.ʃuˈka.du/","forms":{"feminine":"machucada","masculinePlural":"machucados","femininePlural":"machucadas"},"examples":[{"text":"Onde você está machucado?","en":"Where are you hurt?","words":[{"g":"where"},{"g":"you"},{"g":"is","l":"estar"},null]},{"text":"Tom não está machucado.","en":"Tom isn't hurt.","audio":"https://tatoeba.org/en/audio/download/967325","words":[{"g":"tone"},{"g":"not / no"},{"g":"is","l":"estar"},null]},{"text":"Eu não gostaria de te ver machucada.","en":"I wouldn't want to see you get hurt.","words":[{"g":"I"},{"g":"not / no"},{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"you"},{"g":"to see"},null]},{"text":"Tom nunca teria te machucado.","en":"Tom would never have hurt you.","words":[{"g":"tone"},{"g":"never (at no time"},{"g":"to own","l":"ter"},{"g":"you"},null]},{"text":"Estou machucado.","en":"I'm hurt.","audio":"https://tatoeba.org/en/audio/download/78505","words":[{"g":"am","l":"estar"},null]}]}