{"id":"inevita_vel","lemma":"inevitável","pos":"adj","rank":3288,"glosses":["inevitable; unavoidable (that cannot be avoided)"],"ipa":"/i.ne.viˈta.vew/","forms":{"plural":"inevitáveis"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-inevit%C3%A1vel.wav","examples":[{"text":"A guerra não é inevitável.","en":"War is not inevitable.","words":[{"g":"the / to"},{"g":"war"},null,null,null],"phrases":[[2,4,"isn't it"]]},{"text":"Eu sei que é inevitável.","en":"I know that it's inevitable.","words":[{"g":"I"},{"g":"to be aware, to know","l":"saber"},{"g":"that / what"},{"g":"is","l":"ser"},null]},{"text":"O que aconteceu foi inevitável.","en":"What happened was unavoidable.","words":[null,null,{"g":"to happen","l":"acontecer"},{"g":"to be","l":"ser"},null],"phrases":[[0,2,"what"]]},{"text":"Os acidentes são inevitáveis.","en":"Accidents are inevitable.","words":[{"g":"the"},{"g":"accident","l":"acidente"},{"g":"to be","l":"ser"},null]},{"text":"Isso era inevitável.","en":"That was unavoidable.","words":[{"g":"that"},{"g":"to be","l":"ser"},null]}]}