{"id":"chuva","lemma":"chuva","pos":"noun","rank":1287,"glosses":["rain"],"ipa":"/ˈʃu.vɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/Pt_chuva.ogg/Pt_chuva.ogg.mp3","gender":"f","forms":{"plural":"chuvas"},"examples":[{"text":"Quer comprar um guarda-chuva?","en":"Do you want to buy an umbrella?","audio":"https://tatoeba.org/en/audio/download/64135","words":[{"g":"to want","l":"querer"},{"g":"to buy"},{"g":"a"},{"g":"guard"},null]},{"text":"A chuva parou.","en":"The rain stopped.","words":[{"g":"the / to"},null,{"g":"to stop","l":"parar"}]},{"text":"Onde estão seus guarda-chuvas?","en":"Where are your umbrellas?","words":[{"g":"where"},{"g":"to be","l":"estar"},{"g":"their or your kin"},{"g":"guard"},null]},{"text":"Espere até parar a chuva.","en":"Wait till the rain stops.","words":[{"g":"to wait","l":"esperar"},{"g":"until"},{"g":"to stop"},{"g":"the / to"},null]},{"text":"Não tivemos chuvas aqui há muito tempo.","en":"We haven't had rain here in a long time.","words":[{"g":"not / no"},{"g":"to own","l":"ter"},null,{"g":"here"},{"g":"there be","l":"haver"},{"g":"very / a lot"},{"g":"time"}]}]}