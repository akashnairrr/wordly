{"id":"chuva","lemma":"chuva","pos":"noun","rank":1145,"glosses":["rain"],"ipa":"/ˈʃu.vɐ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f4/Pt_chuva.ogg/Pt_chuva.ogg.mp3","gender":"f","forms":{"plural":"chuvas"},"examples":[{"text":"Escutem a chuva.","en":"Listen to the rain.","audio":"https://tatoeba.org/en/audio/download/844022","words":[{"g":"to listen to","l":"escutar"},{"g":"the / to"},null]},{"text":"Nós precisamos da chuva.","en":"We need the rain.","words":[{"g":"we"},{"g":"to need","l":"precisar"},{"g":"of the"},null]},{"text":"Nós vamos quando a chuva parar.","en":"We'll go when the rain stops.","words":[{"g":"we"},{"g":"let's go"},{"g":"when"},{"g":"the / to"},null,{"g":"to stop"}]},{"text":"Eu vendo guarda-chuvas.","en":"I sell umbrellas.","audio":"https://tatoeba.org/en/audio/download/493320","words":[{"g":"I"},{"g":"to see","l":"ver"},{"g":"guard"},null]},{"text":"Meu filho está brincando na chuva.","en":"My son is playing in the rain.","words":[{"g":"my, mine"},{"g":"son"},{"g":"is","l":"estar"},{"g":"to play","l":"brincar"},{"g":"in the"},null]}]}