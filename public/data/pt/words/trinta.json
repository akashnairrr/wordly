{"id":"trinta","lemma":"trinta","pos":"noun","rank":2238,"glosses":["thirty"],"ipa":"/ˈtɾĩ.tɐ/","gender":"m","forms":{"plural":"trintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q5146_%28por%29-Nelson_Ricardo_2500-trinta.wav","examples":[{"text":"Ele tem trinta anos.","en":"He is thirty years old.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,{"g":"year","l":"ano"}]},{"text":"Eu só tenho trinta anos.","en":"I'm only thirty years old.","words":[{"g":"I"},{"g":"only"},{"g":"have","l":"ter"},null,{"g":"year","l":"ano"}]},{"text":"Espere trinta minutos, por favor.","en":"Please wait for thirty minutes.","words":[{"g":"to wait","l":"esperar"},null,{"g":"minute","l":"minuto"},null,null],"phrases":[[3,5,"please"]]},{"text":"Você ainda tem trinta minutos.","en":"You've still got thirty minutes.","words":[{"g":"you"},{"g":"still"},{"g":"has / there is","l":"ter"},null,{"g":"minute","l":"minuto"}]},{"text":"Há trinta nomes na lista.","en":"There are thirty names on the list.","words":[{"g":"there be","l":"haver"},null,{"g":"name","l":"nome"},{"g":"in the"},{"g":"list"}]}]}