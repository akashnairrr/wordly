{"id":"trinta","lemma":"trinta","pos":"noun","rank":1909,"glosses":["thirty"],"ipa":"/ˈtɾĩ.tɐ/","gender":"m","forms":{"plural":"trintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q5146_%28por%29-Nelson_Ricardo_2500-trinta.wav","examples":[{"text":"Ele tem trinta anos.","en":"He is thirty years old.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,{"g":"year","l":"ano"}]},{"text":"Espere trinta minutos, por favor.","en":"Please wait for thirty minutes.","words":[{"g":"to wait","l":"esperar"},null,{"g":"minute","l":"minuto"},null,null],"phrases":[[3,5,"please"]]},{"text":"Há trinta nomes na lista.","en":"There are thirty names on the list.","words":[{"g":"there be","l":"haver"},null,{"g":"name","l":"nome"},{"g":"in the"},{"g":"list"}]},{"text":"Fomos amigos por trinta anos.","en":"We've been friends for thirty years.","words":[{"g":"to go","l":"ir"},{"g":"friendly","l":"amigo"},{"g":"for / by"},null,{"g":"year","l":"ano"}]},{"text":"A reunião começou trinta minutos atrás.","en":"The meeting started thirty minutes ago.","words":[{"g":"the / to"},{"g":"meeting, reunion"},{"g":"to start","l":"começar"},null,{"g":"minute","l":"minuto"},{"g":"behind"}]}]}