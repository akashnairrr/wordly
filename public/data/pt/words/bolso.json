{"id":"bolso","lemma":"bolso","pos":"noun","rank":1400,"glosses":["pocket","one's finances or acquisitive power"],"ipa":"/ˈbow.su/","gender":"m","forms":{"plural":"bolsos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q5146_%28por%29-Santamarcanda-bolso.wav","examples":[{"text":"Está no meu bolso.","en":"It's in my pocket.","audio":"https://tatoeba.org/en/audio/download/852110","words":[{"g":"is","l":"estar"},{"g":"in the"},{"g":"my, mine"},null]},{"text":"Eu não tenho dinheiro no bolso.","en":"I have no money in my pocket.","words":[{"g":"I"},{"g":"not / no"},{"g":"have","l":"ter"},{"g":"money"},{"g":"in the"},null]},{"text":"Este casaco não tem bolsos.","en":"This coat doesn't have pockets.","words":[{"g":"this"},{"g":"coat"},{"g":"not / no"},{"g":"has / there is","l":"ter"},null]},{"text":"Ela colocou a chave no bolso.","en":"She put the key in her pocket.","words":[{"g":"she"},{"g":"to place","l":"colocar"},{"g":"the / to"},{"g":"key"},{"g":"in the"},null]},{"text":"Sempre o carrego no bolso.","en":"I always carry it in my pocket.","audio":"https://tatoeba.org/en/audio/download/59111","words":[{"g":"always"},{"g":"the / it"},{"g":"to carry","l":"carregar"},{"g":"in the"},null]}]}