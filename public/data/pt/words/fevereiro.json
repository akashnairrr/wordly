{"id":"fevereiro","lemma":"fevereiro","pos":"noun","rank":3170,"glosses":["February"],"ipa":"/fɨ.vɨˈɾɐj.ɾu/","gender":"m","forms":{"plural":"fevereiros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q5146_%28por%29-Nelson_Ricardo_2500-fevereiro.wav","examples":[{"text":"Faz muito frio aqui em fevereiro.","en":"It's very cold here in February.","words":[{"g":"to create","l":"fazer"},{"g":"very / a lot"},{"g":"having low temperatures"},{"g":"here"},{"g":"in"},null]},{"text":"Ele terá 17 anos em fevereiro.","en":"He'll be seventeen in February.","words":[{"g":"he"},{"g":"to own","l":"ter"},{"g":"year","l":"ano"},{"g":"in"},null]},{"text":"Neva muito em fevereiro.","en":"We have a lot of snow in February.","words":[{"g":"to snow","l":"nevar"},{"g":"very / a lot"},{"g":"in"},null]},{"text":"O dia dos namorados é comemorado em fevereiro.","en":"Valentine's Day is celebrated in February.","words":[{"g":"the / it"},null,null,null,{"g":"is","l":"ser"},{"g":"to celebrate","l":"comemorar"},{"g":"in"},null],"phrases":[[1,4,"Saint Valentine's Day"]]},{"text":"Em fevereiro, chove muito no Brasil.","en":"It rains a lot during February here in Brazil.","words":[{"g":"in"},null,{"g":"to rain from the sky)","l":"chover"},{"g":"very / a lot"},{"g":"in the"},null]}]}