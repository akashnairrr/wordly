{"id":"disposto","lemma":"disposto","pos":"adj","rank":1609,"glosses":["willing (prepared and wanting to do something)","feeling all right; not indisposed","set out (placed or displayed in a particular manner)"],"ipa":"/d͡ʒisˈpos.tu/","forms":{"feminine":"disposta","masculinePlural":"dispostos","femininePlural":"dispostas","superlative":"o mais disposto"},"examples":[{"text":"Eu estou disposto a te ajudar.","en":"I'm willing to help you.","audio":"https://tatoeba.org/en/audio/download/533671","words":[{"g":"I"},{"g":"am","l":"estar"},null,{"g":"the / to"},{"g":"you"},{"g":"to help, aid"}]},{"text":"Eu não estava disposto a esperar.","en":"I wasn't willing to wait.","words":[{"g":"I"},{"g":"not / no"},{"g":"to be","l":"estar"},null,{"g":"the / to"},{"g":"to wait"}]},{"text":"Estamos bem-dispostos.","en":"We're in good spirits.","audio":"https://tatoeba.org/en/audio/download/1266077","words":[{"g":"to be","l":"estar"},{"g":"well"},null]},{"text":"Tom está disposto a nos ajudar.","en":"Tom's willing to help us.","words":[{"g":"tone"},{"g":"is","l":"estar"},null,{"g":"the / to"},{"g":"us","l":"nós"},{"g":"to help, aid"}]},{"text":"Eu estaria disposta a te ajudar.","en":"I would be willing to help you.","words":[{"g":"I"},{"g":"to be","l":"estar"},null,{"g":"the / to"},{"g":"you"},{"g":"to help, aid"}]}]}