{"id":"disposto","lemma":"disposto","pos":"adj","rank":1315,"glosses":["willing (prepared and wanting to do something)","feeling all right; not indisposed","set out (placed or displayed in a particular manner)"],"ipa":"/diʃˈpoʃ.tu/","forms":{"feminine":"disposta","masculinePlural":"dispostos","femininePlural":"dispostas","superlative":"o mais disposto"},"examples":[{"text":"Estou disposto a ajudar.","en":"I'm willing to help.","audio":"https://tatoeba.org/en/audio/download/495517","words":[{"g":"am","l":"estar"},null,{"g":"the / to"},{"g":"to help, aid"}]},{"text":"Tom está disposto a nos ajudar.","en":"Tom's willing to help us.","words":[{"g":"tone"},{"g":"is","l":"estar"},null,{"g":"the / to"},{"g":"us","l":"nós"},{"g":"to help, aid"}]},{"text":"Estamos bem-dispostos.","en":"We're in good spirits.","audio":"https://tatoeba.org/en/audio/download/1266077","words":[{"g":"to be","l":"estar"},{"g":"well"},null]},{"text":"Eu estaria disposta a te ajudar.","en":"I would be willing to help you.","words":[{"g":"I"},{"g":"to be","l":"estar"},null,{"g":"the / to"},{"g":"you"},{"g":"to help, aid"}]},{"text":"Tom estava disposto a tentar novamente.","en":"Tom was willing to try it again.","words":[{"g":"tone"},{"g":"to be","l":"estar"},null,{"g":"the / to"},{"g":"to try"},{"g":"again"}]}]}