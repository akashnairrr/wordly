{"id":"ciumento","lemma":"ciumento","pos":"adj","rank":4602,"glosses":["jealous (suspecting rivalry in love; fearful of being replaced, in position or in affection)","jealous (protective, guarding; careful in the protection of something one has or appreciates)"],"ipa":"/siwˈmẽ.tu/","forms":{"feminine":"ciumenta","masculinePlural":"ciumentos","femininePlural":"ciumentas"},"examples":[{"text":"Tenho um marido ciumento.","en":"I have a jealous husband.","audio":"https://tatoeba.org/en/audio/download/845180","words":[{"g":"have","l":"ter"},{"g":"a"},{"g":"husband"},null]},{"text":"Ela é uma mulher ciumenta.","en":"She's a jealous woman.","words":[{"g":"she"},{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"woman"},null]},{"text":"Eu sou ciumento.","en":"I'm jealous.","audio":"https://tatoeba.org/en/audio/download/489689","words":[{"g":"I"},{"g":"am","l":"ser"},null]},{"text":"Eu acho que vocês são ciumentos.","en":"I think that you're just jealous.","words":[{"g":"I"},{"g":"to find","l":"achar"},{"g":"that / what"},{"g":"you (pl.)"},{"g":"to be","l":"ser"},null]},{"text":"Eu odeio mulheres ciumentas.","en":"I hate jealous women.","words":[{"g":"I"},{"g":"to hate, to loathe","l":"odiar"},{"g":"woman","l":"mulher"},null]}]}