{"id":"seco","lemma":"seco","pos":"adj","rank":2549,"glosses":["devoid of liquids; dry","desiccated (of fruits and plants that have been desiccated)","withered"],"ipa":"/ˈse.ku/","forms":{"feminine":"seca","masculinePlural":"secos","femininePlural":"secas","superlative":"o mais seco"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q5146_%28por%29-MedK1-seco.wav","formAudio":{"seca":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q5146_%28por%29-MedK1-seca.wav"},"examples":[{"text":"Estava quente e seco.","en":"It was hot and dry.","words":[{"g":"to be","l":"estar"},{"g":"hot, warm"},{"g":"and"},null]},{"text":"Tente ficar seco.","en":"Try to stay dry.","words":[{"g":"to try","l":"tentar"},{"g":"to become"},null]},{"text":"Os campos estão secos.","en":"The fields are dry.","audio":"https://tatoeba.org/en/audio/download/852121","words":[{"g":"the"},{"g":"country","l":"campo"},{"g":"to be","l":"estar"},null]},{"text":"Ele ainda não está seco.","en":"It's not dry yet.","words":[{"g":"he"},{"g":"still"},{"g":"not / no"},{"g":"is","l":"estar"},null]},{"text":"O poço está quase seco.","en":"The well is almost dry.","words":[{"g":"the / it"},{"g":"well"},{"g":"is","l":"estar"},{"g":"almost"},null]}]}