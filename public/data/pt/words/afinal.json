{"id":"afinal","lemma":"afinal","pos":"adv","rank":740,"glosses":["after all (in the end; anyway)"],"ipa":"/ɐ.fiˈnal/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bc/LL-Q5146_%28por%29-Santamarcanda-afinal.wav/LL-Q5146_%28por%29-Santamarcanda-afinal.wav.mp3","examples":[{"text":"Ele estava certo, afinal.","en":"He was right after all.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"right"},null]},{"text":"Afinal chegou uma ambulância.","en":"Eventually, an ambulance arrived.","audio":"https://tatoeba.org/en/audio/download/856770","words":[null,{"g":"to arrive","l":"chegar"},{"g":"a","l":"um"},{"g":"ambulance"}]},{"text":"Que dia é hoje, afinal?","en":"What day is it, anyway?","words":[{"g":"that / what"},{"g":"period between sunrise…"},{"g":"is","l":"ser"},{"g":"today"},null]},{"text":"Tom afinal foi embora.","en":"Tom eventually left.","audio":"https://tatoeba.org/en/audio/download/495555","words":[{"g":"tone"},null,{"g":"to be","l":"ser"},{"g":"although"}]},{"text":"Ela afinal conseguiu.","en":"Eventually, she succeeded.","words":[{"g":"she"},null,{"g":"to get, obtain","l":"conseguir"}]}]}