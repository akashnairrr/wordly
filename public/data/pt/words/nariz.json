{"id":"nariz","lemma":"nariz","pos":"noun","rank":962,"glosses":["nose (a protuberance on the face housing the nostrils, which are used to breathe or smell)"],"ipa":"/nɐˈɾiʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f0/LL-Q5146_%28por%29-Santamarcanda-nariz.wav/LL-Q5146_%28por%29-Santamarcanda-nariz.wav.mp3","gender":"m","forms":{"plural":"narizes"},"examples":[{"text":"Meu nariz está sangrando.","en":"My nose is bleeding.","audio":"https://tatoeba.org/en/audio/download/63990","words":[{"g":"my, mine"},null,{"g":"is","l":"estar"},{"g":"to draw blood","l":"sangrar"}]},{"text":"Tom arranhou o seu nariz.","en":"Tom scratched his nose.","audio":"https://tatoeba.org/en/audio/download/535818","words":[{"g":"tone"},{"g":"to scratch, scrape","l":"arranhar"},{"g":"the / it"},{"g":"his"},null]},{"text":"Não consigo respirar pelo nariz.","en":"I can't breathe through my nose.","words":[{"g":"not / no"},{"g":"to get, obtain","l":"conseguir"},{"g":"to breathe"},{"g":"by / for the","l":"pelar"},null]},{"text":"Um elefante tem um nariz longo.","en":"An elephant has a long nose.","words":[{"g":"a"},{"g":"elephant"},{"g":"has / there is","l":"ter"},{"g":"a"},null,{"g":"long"}]},{"text":"Quero coçar o nariz.","en":"I want to scratch my nose.","words":[{"g":"to want","l":"querer"},{"g":"to scratch"},{"g":"the / it"},null]}]}