{"id":"morro","lemma":"morro","pos":"noun","rank":3468,"glosses":["a landform with elevation intermediate between that of a hill and that of a small mountain"],"ipa":"/ˈmo.ʁu/","gender":"m","forms":{"plural":"morros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-morro.wav","examples":[{"text":"Ele desceu o morro.","en":"He went down the hill.","audio":"https://tatoeba.org/en/audio/download/1271384","words":[{"g":"he"},{"g":"to descend, to go down","l":"descer"},{"g":"the / it"},null]},{"text":"Eu morro de saudades de você.","en":"I miss you badly.","words":[{"g":"I"},null,{"g":"of / from"},{"g":"wistfulness","l":"saudade"},{"g":"of / from"},{"g":"you (formal)"}]},{"text":"É um ótimo exercício subir morros.","en":"It's good exercise to climb hills.","words":[{"g":"is","l":"ser"},{"g":"a"},{"g":"great"},{"g":"exercise"},{"g":"to ascend, to go up"},null]}]}