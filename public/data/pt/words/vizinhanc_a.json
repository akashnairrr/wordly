{"id":"vizinhanc_a","lemma":"vizinhança","pos":"noun","rank":2100,"glosses":["neighborhood (close proximity, particularly in reference to home)","neighborhood (inhabitants in the close proximity)","the relationship between neighbours"],"ipa":"/vi.zĩˈɲɐ̃.sɐ/","gender":"f","forms":{"plural":"vizinhanças"},"examples":[{"text":"Ela vive nessa vizinhança.","en":"She lives in this neighborhood.","words":[{"g":"she"},{"g":"to live","l":"viver"},null,null]},{"text":"Ela mora nesta vizinhança.","en":"She lives in this neighborhood.","words":[{"g":"she"},{"g":"to live, reside","l":"morar"},null,null]},{"text":"Uma briga começou em nossa vizinhança.","en":"A fight broke out in our neighborhood.","words":[{"g":"a","l":"um"},{"g":"fight"},{"g":"to start","l":"começar"},{"g":"in"},{"g":"oh, my God!"},null]},{"text":"Eu cresci nessa vizinhança.","en":"I grew up in this neighborhood.","words":[{"g":"I"},{"g":"to grow","l":"crescer"},null,null]},{"text":"Ela mora nessa vizinhança.","en":"She lives in this neighborhood.","words":[{"g":"she"},{"g":"to live, reside","l":"morar"},null,null]}]}