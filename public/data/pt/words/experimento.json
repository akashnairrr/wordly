{"id":"experimento","lemma":"experimento","pos":"noun","rank":2865,"glosses":["experiment"],"ipa":"/is.pe.ɾiˈmẽ.tu/","gender":"m","forms":{"plural":"experimentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d2/LL-Q5146_%28por%29-Wiktionairy-experimento.wav","examples":[{"text":"O experimento tem de começar.","en":"The experiment has to begin.","words":[{"g":"the / it"},null,{"g":"has / there is","l":"ter"},{"g":"of / from"},{"g":"to start"}]},{"text":"É um experimento.","en":"It's an experiment.","words":[{"g":"is","l":"ser"},{"g":"a"},null]},{"text":"Nós precisamos interromper esse experimento.","en":"We need to stop this experiment.","words":[{"g":"we"},{"g":"to need","l":"precisar"},{"g":"to interrupt"},{"g":"that"},null]},{"text":"Primeiro, vamos falar sobre os experimentos conduzidos em laboratório.","en":"First, let us talk about the experiments conducted in laboratories.","words":[{"g":"first"},{"g":"let's go"},{"g":"to speak"},{"g":"on"},{"g":"the"},null,{"g":"conducted, transported","l":"conduzido"},{"g":"in"},{"g":"laboratory"}]},{"text":"Eles continuaram o experimento dia e noite.","en":"They continued the experiment day and night.","words":[{"g":"they"},null,{"g":"the / it"},null,null,null,null],"phrases":[[4,7,"day and night"]]}]}