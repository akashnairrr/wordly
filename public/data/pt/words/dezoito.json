{"id":"dezoito","lemma":"dezoito","pos":"noun","rank":4900,"glosses":["eighteen"],"ipa":"/dɨˈzɔj.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d1/LL-Q5146_%28por%29-Nelson_Ricardo_2500-dezoito.wav/LL-Q5146_%28por%29-Nelson_Ricardo_2500-dezoito.wav.mp3","gender":"m","forms":{"plural":"dezoitos"},"examples":[{"text":"Tenho dezoito anos.","en":"I'm eighteen.","audio":"https://tatoeba.org/en/audio/download/763817","words":[{"g":"have","l":"ter"},null,{"g":"year","l":"ano"}]},{"text":"Ela tem dezoito anos no máximo.","en":"She is eighteen at most.","words":[{"g":"she"},{"g":"has / there is","l":"ter"},null,{"g":"year","l":"ano"},null,null],"phrases":[[4,6,"at most"]]},{"text":"Ela mora sozinha desde os dezoito anos.","en":"She has been on her own since the age of eighteen.","words":[{"g":"she"},{"g":"to live, reside","l":"morar"},{"g":"alone","l":"sozinho"},{"g":"since"},{"g":"the"},null,{"g":"year","l":"ano"}]},{"text":"Nós comeremos às dezoito horas.","en":"We'll eat at six o'clock.","words":[{"g":"we"},{"g":"to consume meals","l":"comer"},null,null,{"g":"hour","l":"hora"}]},{"text":"Ela tinha apenas dezoito quando se graduou na universidade.","en":"She was only 18 when she graduated from university.","words":[{"g":"she"},{"g":"to own","l":"ter"},{"g":"only"},null,{"g":"when"},{"g":"if / oneself"},null,{"g":"in the"},{"g":"university"}]}]}