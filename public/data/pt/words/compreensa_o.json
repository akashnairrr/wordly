{"id":"compreensa_o","lemma":"compreensão","pos":"noun","rank":3699,"glosses":["comprehension, understanding","sympathy (for a troublesome situation)"],"ipa":"/kõ.pɾi.ẽˈsɐ̃w̃/","gender":"f","forms":{"plural":"compreensões"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q5146_%28por%29-MedK1-compreens%C3%A3o.wav","examples":[{"text":"Obrigado pela compreensão.","en":"Thank you for understanding.","words":[{"g":"thank you"},{"g":"by / for the","l":"pelar"},null]},{"text":"O problema está além da minha compreensão.","en":"The problem is beyond my grasp.","words":[{"g":"the / it"},{"g":"problem"},{"g":"is","l":"estar"},{"g":"there, over there"},{"g":"of the"},{"g":"my, mine","l":"meu"},null]},{"text":"É um livro de difícil compreensão.","en":"This book is difficult to understand.","words":[{"g":"is","l":"ser"},{"g":"a"},{"g":"book"},{"g":"of / from"},{"g":"difficult"},null]},{"text":"Está para lá de qualquer compreensão.","en":"It's beyond all comprehension.","words":[{"g":"is","l":"estar"},null,null,null,{"g":"any"},null],"phrases":[[1,4,"rather"]]},{"text":"Seu romance está além de minha compreensão.","en":"His novel is beyond my comprehension.","words":[{"g":"his"},{"g":"novel"},{"g":"is","l":"estar"},null,null,{"g":"my, mine","l":"meu"},null],"phrases":[[3,5,"beyond"]]}]}