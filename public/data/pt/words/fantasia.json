{"id":"fantasia","lemma":"fantasia","pos":"noun","rank":1440,"glosses":["fantasy (imagining)","fantasy (literary genre)","costume (outfit or a disguise worn as fancy dress)"],"ipa":"/fɐ̃.taˈzi.ɐ/","gender":"f","forms":{"plural":"fantasias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q5146_%28por%29-MedK1-fantasia.wav","formAudio":{"fantasias":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q5146_%28por%29-Ad%C3%A9la%C3%AFde_Calais_WMFr-fantasias.wav"},"examples":[{"text":"Ele vive num mundo de fantasia.","en":"He lives in a world of fantasy.","words":[{"g":"he"},{"g":"to live","l":"viver"},null,{"g":"world"},{"g":"of / from"},null]},{"text":"O que você acha da minha fantasia?","en":"What do you think of my costume?","words":[null,null,{"g":"you"},{"g":"to find","l":"achar"},{"g":"of the"},{"g":"my, mine","l":"meu"},null],"phrases":[[0,2,"what"]]},{"text":"Eu gosto de festas à fantasia.","en":"I like costume parties.","words":[{"g":"I"},{"g":"taste"},{"g":"of / from"},{"g":"party","l":"festa"},{"g":"forms adverbs meaning…"},null]},{"text":"Não esqueça a sua fantasia.","en":"Don't forget your costume.","words":[{"g":"not / no"},{"g":"to forget","l":"esquecer"},{"g":"the / to"},{"g":"his","l":"seu"},null]},{"text":"Onde posso alugar uma fantasia?","en":"Where can I rent a costume?","words":[{"g":"where"},{"g":"to be able to","l":"poder"},{"g":"to rent, to hire"},{"g":"a","l":"um"},null]}]}