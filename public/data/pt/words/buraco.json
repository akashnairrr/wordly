{"id":"buraco","lemma":"buraco","pos":"noun","rank":878,"glosses":["pit; hole (hollow spot in a surface)","burrow (a tunnel or hole dug by a creature)","a very filthy, crude or precarious house"],"ipa":"/buˈɾa.ku/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9d/LL-Q5146_%28por%29-Santamarcanda-buraco.wav/LL-Q5146_%28por%29-Santamarcanda-buraco.wav.mp3","gender":"m","forms":{"plural":"buracos"},"formAudio":{"buracos":"https://upload.wikimedia.org/wikipedia/commons/f/f3/LL-Q5146_%28por%29-Santamarcanda-buracos.wav"},"examples":[{"text":"Há um buraco nisso.","en":"There's a hole in this.","words":[{"g":"there be","l":"haver"},{"g":"a"},null,{"g":"in that"}]},{"text":"Ele tem buracos nas roupas.","en":"He has holes in his clothes.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,null,{"g":"clothing, clothes","l":"roupa"}]},{"text":"O buraco é grande o bastante.","en":"The hole is big enough.","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"large"},{"g":"the / it"},{"g":"enough"}]},{"text":"É um buraco negro.","en":"It is a black hole.","words":[{"g":"is","l":"ser"},{"g":"a"},null,{"g":"black in colour"}]},{"text":"Eu achei buracos aqui e ali.","en":"I found holes here and there.","words":[{"g":"I"},{"g":"to find","l":"achar"},null,null,null,null],"phrases":[[3,6,"here and there"]]}]}