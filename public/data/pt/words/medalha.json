{"id":"medalha","lemma":"medalha","pos":"noun","rank":2627,"glosses":["medal (stamped metal disc used as ornament or charm)","medal (metal object used as a prize or military decoration)"],"ipa":"/mɨˈda.ʎɐ/","gender":"f","forms":{"plural":"medalhas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q5146_%28por%29-MedK1-medalha.wav","examples":[{"text":"Me deram uma medalha.","en":"I was given a medal.","words":[{"g":"me"},null,{"g":"a","l":"um"},null]},{"text":"Medalhas tem dois lados.","en":"Medals have two sides.","words":[null,{"g":"has / there is","l":"ter"},{"g":"deuce"},{"g":"side","l":"lado"}]},{"text":"Ele ganhou uma medalha de ouro.","en":"He won a gold medal.","words":[{"g":"he"},{"g":"to win","l":"ganhar"},{"g":"a","l":"um"},null,null,null],"phrases":[[4,6,"golden"]]},{"text":"Eu ganhei a medalha de ouro.","en":"I won the gold medal.","audio":"https://tatoeba.org/en/audio/download/533660","words":[{"g":"I"},{"g":"to win","l":"ganhar"},{"g":"the / to"},null,null,null],"phrases":[[4,6,"golden"]]},{"text":"Tom merece uma medalha.","en":"Tom deserves a medal.","words":[{"g":"tone"},{"g":"to merit","l":"merecer"},{"g":"a","l":"um"},null]}]}