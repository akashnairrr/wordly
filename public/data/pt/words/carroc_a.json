{"id":"carroc_a","lemma":"carroça","pos":"noun","rank":3288,"glosses":["cart (small, open, wheeled vehicle, drawn or pushed by a person or animal)","a slow, old or low-quality car"],"ipa":"/kɐˈʁɔ.sɐ/","gender":"f","forms":{"plural":"carroças"},"examples":[{"text":"Tom está na carroça.","en":"Tom is on the wagon.","words":[{"g":"tone"},{"g":"is","l":"estar"},{"g":"in the"},null]},{"text":"Consertarei sua carroça.","en":"I'll fix your wagon.","words":[{"g":"to fix, to repair","l":"consertar"},{"g":"his","l":"seu"},null]},{"text":"Não ponha a carroça na frente dos bois.","en":"Don't put the cart before the horse.","words":[{"g":"not / no"},{"g":"to put","l":"pôr"},{"g":"the / to"},null,{"g":"in the"},{"g":"front"},null,{"g":"ox","l":"boi"}]},{"text":"Repararei sua carroça.","en":"I'll fix your wagon.","words":[{"g":"to realize","l":"reparar"},{"g":"his","l":"seu"},null]},{"text":"Não coloque a carroça à frente dos bois!","en":"Don't get ahead of yourself.","words":[{"g":"not / no"},{"g":"to place","l":"colocar"},{"g":"the / to"},null,null,null,null,{"g":"ox","l":"boi"}],"phrases":[[4,6,"ahead"]]}]}