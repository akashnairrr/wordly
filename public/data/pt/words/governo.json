{"id":"governo","lemma":"governo","pos":"noun","rank":565,"glosses":["government"],"ipa":"/ɡuˈveʁ.nu/","gender":"m","forms":{"plural":"governos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2f/LL-Q5146_%28por%29-Nelson_Ricardo_2500-governo.wav","examples":[{"text":"Tom trabalha para o governo.","en":"Tom works for the government.","words":[{"g":"tone"},{"g":"to work","l":"trabalhar"},{"g":"for / to"},{"g":"the / it"},null]},{"text":"Eles eram membros dos governos locais.","en":"They were members of the local governments.","words":[{"g":"they"},{"g":"to be","l":"ser"},{"g":"member","l":"membro"},null,null,{"g":"premises, rooms","l":"local"}]},{"text":"Tom não confia no governo.","en":"Tom doesn't trust the government.","words":[{"g":"tone"},{"g":"not / no"},{"g":"to confide, entrust","l":"confiar"},{"g":"in the"},null]},{"text":"Não culpe o governo.","en":"Don't blame the government.","words":[{"g":"not / no"},{"g":"to blame","l":"culpar"},{"g":"the / it"},null]},{"text":"É um governo democrático.","en":"It's a democratic government.","words":[{"g":"is","l":"ser"},{"g":"a"},null,{"g":"democratic"}]}]}