{"id":"acidentalmente","lemma":"acidentalmente","pos":"adv","rank":3443,"glosses":["accidentally","casually"],"ipa":"/a.si.dẽˌtawˈmẽ.t͡ʃi/","examples":[{"text":"Tom fez isso acidentalmente.","en":"Tom accidentally did that.","audio":"https://tatoeba.org/en/audio/download/859114","words":[{"g":"tone"},{"g":"to create","l":"fazer"},{"g":"that"},null]},{"text":"Eu me envenenei acidentalmente.","en":"I accidentally poisoned myself.","words":[{"g":"I"},{"g":"me"},{"g":"to poison","l":"envenenar"},null]},{"text":"Eu deletei suas mensagens acidentalmente.","en":"I accidentally deleted your messages.","words":[{"g":"I"},{"g":"delete","l":"deletar"},{"g":"his","l":"seu"},{"g":"message","l":"mensagem"},null]},{"text":"Tom acidentalmente derramou sua bebida.","en":"Tom accidentally knocked over his drink.","words":[{"g":"tone"},null,{"g":"to spill","l":"derramar"},{"g":"his","l":"seu"},{"g":"drink"}]},{"text":"Eu acidentalmente derrubei o vaso.","en":"I accidentally knocked over the vase.","words":[{"g":"I"},null,{"g":"to overthrow, overturn","l":"derrubar"},{"g":"the / it"},{"g":"vessel"}]}]}