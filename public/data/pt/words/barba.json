{"id":"barba","lemma":"barba","pos":"noun","rank":1935,"glosses":["beard"],"ipa":"/ˈbaʁ.bɐ/","gender":"f","forms":{"plural":"barbas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q5146_%28por%29-Nelson_Ricardo_2500-barba.wav","examples":[{"text":"Eu tenho uma barba.","en":"I have a beard.","audio":"https://tatoeba.org/en/audio/download/1272837","words":[{"g":"I"},{"g":"have","l":"ter"},{"g":"a","l":"um"},null]},{"text":"Ele tem barba.","en":"He has a beard.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null]},{"text":"Tom é o cara com barba.","en":"Tom is the guy with the beard.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"the / it"},{"g":"guy, dude"},{"g":"with"},null]},{"text":"Quero deixar minha barba crescer.","en":"I want to let my beard grow.","words":[{"g":"to want","l":"querer"},{"g":"to leave"},{"g":"my, mine","l":"meu"},null,{"g":"to grow"}]},{"text":"Eu adoro a sua barba.","en":"I love your beard.","words":[{"g":"I"},{"g":"to love","l":"adorar"},{"g":"the / to"},{"g":"his","l":"seu"},null]}]}