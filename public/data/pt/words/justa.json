{"id":"justa","lemma":"justa","pos":"noun","rank":2664,"glosses":["joust"],"ipa":"/ˈʒus.tɐ/","gender":"f","forms":{"plural":"justas"},"examples":[{"text":"Você é justa.","en":"You're fair.","audio":"https://tatoeba.org/en/audio/download/1272860","words":[{"g":"you"},{"g":"is","l":"ser"},null]},{"text":"Tu és justa.","en":"You're fair.","audio":"https://tatoeba.org/en/audio/download/1272862","words":[{"g":"you"},{"g":"to be","l":"ser"},null]},{"text":"A lei nem sempre é justa.","en":"The law isn't always fair.","words":[{"g":"the / to"},{"g":"law"},{"g":"nor"},{"g":"always"},{"g":"is","l":"ser"},null]},{"text":"Eu acho que é uma decisão justa.","en":"I think it's a fair decision.","audio":"https://tatoeba.org/en/audio/download/485136","words":[{"g":"I"},{"g":"to find","l":"achar"},{"g":"that / what"},{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"decision"},null]},{"text":"Não foi uma luta justa.","en":"It wasn't a fair fight.","words":[{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},{"g":"fight"},null]}]}