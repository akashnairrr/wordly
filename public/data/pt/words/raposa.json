{"id":"raposa","lemma":"raposa","pos":"noun","rank":3611,"glosses":["fox (both the \"true foxes\" of the Old World and North America, and the \"false foxes\" of Latin America)","vixen (female fox)","opossum (any American marsupial of the family Didelphidae)"],"ipa":"/ʁaˈpo.zɐ/","gender":"f","forms":{"plural":"raposas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q5146_%28por%29-Nelson_Ricardo_2500-raposa.wav","examples":[{"text":"Uma raposa chegou.","en":"A fox came along.","words":[{"g":"a","l":"um"},null,{"g":"to arrive","l":"chegar"}]},{"text":"Esse cara parece uma raposa.","en":"This guy looks like a fox.","words":[{"g":"that"},{"g":"guy, dude"},{"g":"to seem","l":"parecer"},{"g":"a","l":"um"},null]},{"text":"Eles caçaram raposas.","en":"They hunted foxes.","words":[{"g":"they"},{"g":"to hunt","l":"caçar"},null]},{"text":"Eles capturaram a raposa.","en":"They trapped the fox.","words":[{"g":"they"},null,{"g":"the / to"},null]},{"text":"A raposa é um animal selvagem.","en":"A fox is a wild animal.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"a"},{"g":"animal"},{"g":"sylvan"}]}]}