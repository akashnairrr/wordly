{"id":"interesse","lemma":"interesse","pos":"noun","rank":1068,"glosses":["interest, curiosity","self-interest, especially when pretending to like someone to attain some benefit for oneself"],"ipa":"/ĩ.teˈɾe.si/","gender":"m","forms":{"plural":"interesses"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q5146_%28por%29-Nelson_Ricardo_2500-interesse.wav","examples":[{"text":"Eu tenho interesse no francês.","en":"I'm interested in French.","audio":"https://tatoeba.org/en/audio/download/485220","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"in the"},{"g":"French"}]},{"text":"Eu perdi o interesse.","en":"I lost interest.","audio":"https://tatoeba.org/en/audio/download/491333","words":[{"g":"I"},{"g":"to lose","l":"perder"},{"g":"the / it"},null]},{"text":"Não tenho interesse por café.","en":"I don't care for coffee.","audio":"https://tatoeba.org/en/audio/download/533723","words":[{"g":"not / no"},{"g":"have","l":"ter"},null,{"g":"for / by"},{"g":"coffee"}]},{"text":"Você tem interesse por música?","en":"Are you interested in music?","words":[{"g":"you"},{"g":"has / there is","l":"ter"},null,{"g":"for / by"},{"g":"music"}]},{"text":"Ele perdeu interesse na política.","en":"He has lost interest in politics.","words":[{"g":"he"},{"g":"to lose","l":"perder"},null,{"g":"in the"},{"g":"politics"}]}]}