{"id":"interesse","lemma":"interesse","pos":"noun","rank":1056,"glosses":["interest, curiosity","self-interest, especially when pretending to like someone to attain some benefit for oneself"],"ipa":"/ĩ.tɨˈɾe.sɨ/","gender":"m","forms":{"plural":"interesses"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q5146_%28por%29-Nelson_Ricardo_2500-interesse.wav","examples":[{"text":"Não tenho interesse por café.","en":"I don't care for coffee.","audio":"https://tatoeba.org/en/audio/download/533723","words":[{"g":"not / no"},{"g":"have","l":"ter"},null,{"g":"for / by"},{"g":"coffee"}]},{"text":"Obrigado pelo seu interesse.","en":"Thanks for your interest.","words":[{"g":"thank you"},{"g":"by / for the","l":"pelar"},{"g":"his"},null]},{"text":"Eu tenho interesse no francês.","en":"I'm interested in French.","audio":"https://tatoeba.org/en/audio/download/485220","words":[{"g":"I"},{"g":"have","l":"ter"},null,{"g":"in the"},{"g":"French"}]},{"text":"Esse livro não é de meu interesse.","en":"That book is of no interest to me.","words":[{"g":"that"},{"g":"book"},null,null,{"g":"of / from"},{"g":"my, mine"},null],"phrases":[[2,4,"isn't it"]]},{"text":"Ele perdeu interesse na política.","en":"He has lost interest in politics.","words":[{"g":"he"},{"g":"to lose","l":"perder"},null,{"g":"in the"},{"g":"politics"}]}]}