{"id":"talvez","lemma":"talvez","pos":"adv","rank":84,"glosses":["perhaps; maybe (indicates possibility or doubt)"],"ipa":"/talˈveʃ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/70/LL-Q5146_%28por%29-Nelson_Ricardo_2500-talvez.wav/LL-Q5146_%28por%29-Nelson_Ricardo_2500-talvez.wav.mp3","examples":[{"text":"Talvez ele venha.","en":"Perhaps he will come.","words":[null,{"g":"he"},{"g":"to come","l":"vir"}]},{"text":"Talvez ela venha amanhã.","en":"Perhaps she will come tomorrow.","words":[null,{"g":"she"},{"g":"to come","l":"vir"},{"g":"tomorrow"}]},{"text":"Talvez haja outras razões.","en":"Perhaps there are other reasons.","audio":"https://tatoeba.org/en/audio/download/852128","words":[null,{"g":"there be","l":"haver"},{"g":"other one","l":"outro"},{"g":"reason","l":"razão"}]},{"text":"Talvez ele não seja feliz.","en":"He may not be happy.","words":[null,{"g":"he"},{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"happy"}]},{"text":"Talvez ela saiba a resposta.","en":"She might know the answer.","words":[null,{"g":"she"},{"g":"to be aware, to know","l":"saber"},{"g":"the / to"},{"g":"answer, response"}]}]}