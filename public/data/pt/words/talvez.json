{"id":"talvez","lemma":"talvez","pos":"adv","rank":85,"glosses":["perhaps; maybe (indicates possibility or doubt)"],"ipa":"/tawˈve(j)s/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7f/LL-Q5146_%28por%29-Juliano_P._Junho_%28Jjunho%29-talvez.wav/LL-Q5146_%28por%29-Juliano_P._Junho_%28Jjunho%29-talvez.wav.mp3","examples":[{"text":"Talvez ele venha.","en":"Perhaps he will come.","words":[null,{"g":"he"},{"g":"to come","l":"vir"}]},{"text":"Talvez ela venha amanhã.","en":"Perhaps she will come tomorrow.","words":[null,{"g":"she"},{"g":"to come","l":"vir"},{"g":"tomorrow"}]},{"text":"Talvez haja outras razões.","en":"Perhaps there are other reasons.","audio":"https://tatoeba.org/en/audio/download/852128","words":[null,{"g":"there be","l":"haver"},{"g":"other one","l":"outro"},{"g":"reason","l":"razão"}]},{"text":"Talvez você queira ir.","en":"You might want to go.","audio":"https://tatoeba.org/en/audio/download/484066","words":[null,{"g":"you"},{"g":"to want","l":"querer"},{"g":"to go"}]},{"text":"Talvez ele não seja feliz.","en":"He may not be happy.","words":[null,{"g":"he"},{"g":"not / no"},{"g":"to be","l":"ser"},{"g":"happy"}]}]}