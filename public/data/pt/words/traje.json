{"id":"traje","lemma":"traje","pos":"noun","rank":4432,"glosses":["attire, dress, garb","suit"],"ipa":"/ˈtɾa.ʒɨ/","gender":"m","forms":{"plural":"trajes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q5146_%28por%29-MedK1-traje.wav","examples":[{"text":"Gosto do seu traje.","en":"I like your costume.","audio":"https://tatoeba.org/en/audio/download/494547","words":[{"g":"to like","l":"gostar"},{"g":"of the"},{"g":"his"},null]},{"text":"Não tenho um traje de banho.","en":"I don't have a bathing suit.","words":[{"g":"not / no"},{"g":"have","l":"ter"},{"g":"a"},null,{"g":"of / from"},{"g":"bath"}]},{"text":"Ela desenhou belos trajes para o filme.","en":"She designed beautiful costumes for the movie.","words":[{"g":"she"},{"g":"to draw","l":"desenhar"},{"g":"beautiful","l":"belo"},null,{"g":"for / to"},{"g":"the / it"},{"g":"film"}]},{"text":"Arranje um traje decente.","en":"Get yourself a decent suit.","audio":"https://tatoeba.org/en/audio/download/843467","words":[{"g":"to arrange","l":"arranjar"},{"g":"a"},null,{"g":"decent, proper"}]},{"text":"Ela está usando um traje azul claro.","en":"She's wearing a light blue suit.","words":[{"g":"she"},{"g":"is","l":"estar"},{"g":"to use","l":"usar"},{"g":"a"},null,{"g":"blue"},{"g":"light"}]}]}