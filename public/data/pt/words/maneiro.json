{"id":"maneiro","lemma":"maneiro","pos":"adj","rank":3039,"glosses":["handy (easy to be handled); portable (small and light)","eating at a person's hands","agile (moving quick and easily)"],"ipa":"/maˈne(j).ɾu/","forms":{"feminine":"maneira","masculinePlural":"maneiros","femininePlural":"maneiras"},"formAudio":{"maneira":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q5146_%28por%29-Nelson_Ricardo_2500-maneira.wav"},"examples":[{"text":"Não há outra maneira.","en":"There is no other way.","audio":"https://tatoeba.org/en/audio/download/1271103","words":[{"g":"not / no"},{"g":"there be","l":"haver"},{"g":"other one","l":"outro"},null]},{"text":"Ninguém fala dessa maneira.","en":"No one talks like that.","audio":"https://tatoeba.org/en/audio/download/767407","words":[{"g":"no one"},{"g":"speech"},null,null]},{"text":"Ele tentou várias maneiras diferentes.","en":"He tried many different methods.","words":[{"g":"he"},{"g":"to try","l":"tentar"},null,null,{"g":"different","l":"diferente"}]},{"text":"Você sabe de uma maneira melhor?","en":"Do you know a better way?","words":[{"g":"you"},{"g":"to be aware, to know","l":"saber"},{"g":"of / from"},{"g":"a","l":"um"},null,{"g":"desirable","l":"bom"}]},{"text":"Ele tem péssimas maneiras à mesa.","en":"He has atrocious table manners.","words":[{"g":"he"},{"g":"has / there is","l":"ter"},null,null,{"g":"forms adverbs meaning…"},{"g":"table"}]}]}