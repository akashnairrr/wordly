{"id":"te","lemma":"te","pos":"pron","rank":45,"glosses":["you (singular), thee","particle of spontaneity, when it indicates that there was spontaneity in the action by its agent."],"ipa":"/t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/35/LL-Q5146_%28por%29-JnpoJuwan-te.wav/LL-Q5146_%28por%29-JnpoJuwan-te.wav.mp3","examples":[{"text":"Te vejo amanhã?","en":"See you tomorrow?","audio":"https://tatoeba.org/en/audio/download/1270065","words":[null,{"g":"to see","l":"ver"},{"g":"tomorrow"}]},{"text":"Ela te conhece?","en":"Does she know you?","audio":"https://tatoeba.org/en/audio/download/1271051","words":[{"g":"she"},null,{"g":"to know","l":"conhecer"}]},{"text":"Eu te conheço.","en":"I know you.","audio":"https://tatoeba.org/en/audio/download/67420","words":[{"g":"I"},null,{"g":"to know","l":"conhecer"}]},{"text":"Quem te ajudou?","en":"Who helped you?","audio":"https://tatoeba.org/en/audio/download/1272458","words":[{"g":"who"},null,{"g":"to help, aid","l":"ajudar"}]},{"text":"Eu ainda te amo.","en":"I still love you.","audio":"https://tatoeba.org/en/audio/download/493130","words":[{"g":"I"},{"g":"still"},null,{"g":"to love","l":"amar"}]}]}