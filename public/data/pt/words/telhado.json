{"id":"telhado","lemma":"telhado","pos":"noun","rank":1671,"glosses":["roof"],"ipa":"/teˈʎa.du/","gender":"m","forms":{"plural":"telhados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q5146_%28por%29-Nelson_Ricardo_2500-telhado.wav","examples":[{"text":"O telhado é muito baixo.","en":"The roof is very low.","words":[{"g":"the / it"},null,{"g":"is","l":"ser"},{"g":"very / a lot"},{"g":"bass"}]},{"text":"O gato está no telhado.","en":"The cat is on the roof.","words":[{"g":"the / it"},{"g":"cat"},{"g":"is","l":"estar"},{"g":"in the"},null]},{"text":"A parte do telhado caiu.","en":"Part of the roof fell off.","words":[{"g":"the / to"},{"g":"part"},{"g":"of the"},null,{"g":"to fall","l":"cair"}]},{"text":"Olhe, tem um gato no telhado.","en":"Look, there's a cat on the roof.","words":[{"g":"gaze","l":"olhar"},{"g":"has / there is","l":"ter"},{"g":"a"},{"g":"cat"},{"g":"in the"},null]},{"text":"O telhado da minha casa é vermelho.","en":"The roof of my house is red.","words":[{"g":"the / it"},null,{"g":"of the"},{"g":"my, mine","l":"meu"},{"g":"house, home"},{"g":"is","l":"ser"},{"g":"red"}]}]}