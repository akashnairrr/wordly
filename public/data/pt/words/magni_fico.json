{"id":"magni_fico","lemma":"magnífico","pos":"adj","rank":2813,"glosses":["magnificent (grand, elegant or splendid in appearance)","very good; terrific; excellent","the title of a rector (headmaster in various educational institutions)"],"ipa":"/ma.ɡiˈni.fi.ku/","forms":{"feminine":"magnífica","masculinePlural":"magníficos","femininePlural":"magníficas"},"examples":[{"text":"Este lugar é magnífico.","en":"This place is wonderful.","audio":"https://tatoeba.org/en/audio/download/894480","words":[{"g":"this"},{"g":"place"},{"g":"is","l":"ser"},null]},{"text":"Que vista magnífica!","en":"What a great view!","audio":"https://tatoeba.org/en/audio/download/844208","words":[{"g":"that / what"},{"g":"view, sight"},null]},{"text":"Tom fez um trabalho magnífico.","en":"Tom has done a superb job.","words":[{"g":"tone"},{"g":"to create","l":"fazer"},{"g":"a"},{"g":"job"},null]},{"text":"Estes são magníficos.","en":"These are wonderful.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},null]},{"text":"Este hotel tem uma vista magnífica para o mar.","en":"This hotel has a magnificent view of the sea.","words":[{"g":"this"},{"g":"hotel"},{"g":"has / there is","l":"ter"},{"g":"a","l":"um"},{"g":"view, sight"},null,{"g":"for / to"},{"g":"the / it"},{"g":"sea"}]}]}