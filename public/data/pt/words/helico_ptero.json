{"id":"helico_ptero","lemma":"helicóptero","pos":"noun","rank":1610,"glosses":["helicopter (an aircraft that is borne along by one or more sets of long rotating blades which allow it to hover)"],"ipa":"/ɛ.liˈkɔp.tɨ.ɾu/","gender":"m","forms":{"plural":"helicópteros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q5146_%28por%29-MedK1-helic%C3%B3ptero.wav","examples":[{"text":"Tom é piloto de helicóptero.","en":"Tom is a helicopter pilot.","words":[{"g":"tone"},{"g":"is","l":"ser"},{"g":"pilot"},{"g":"of / from"},null]},{"text":"Você já esteve num helicóptero?","en":"Have you ever been on a helicopter?","words":[{"g":"you (formal)"},{"g":"already"},{"g":"to be","l":"estar"},null,null]},{"text":"Os helicópteros são barulhentos.","en":"Helicopters are noisy.","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"noisy","l":"barulhento"}]},{"text":"Tom podia ouvir helicópteros sobrevoando.","en":"Tom could hear helicopters overhead.","words":[{"g":"tone"},{"g":"to be able to","l":"poder"},{"g":"to hear"},null,null]},{"text":"Tom aterrissou seu helicóptero sobre o telhado.","en":"Tom landed his helicopter on the roof.","words":[{"g":"tone"},null,{"g":"his"},null,{"g":"on"},{"g":"the / it"},{"g":"roof"}]}]}