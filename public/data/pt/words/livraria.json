{"id":"livraria","lemma":"livraria","pos":"noun","rank":4516,"glosses":["bookshop (a shop that sells books)"],"ipa":"/li.vɾɐˈɾi.ɐ/","gender":"f","forms":{"plural":"livrarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q5146_%28por%29-MedK1-livraria.wav","examples":[{"text":"Eu fui à livraria.","en":"I went to the bookstore.","audio":"https://tatoeba.org/en/audio/download/279811","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"to the"},null]},{"text":"A livraria é perto do parque.","en":"The bookstore is near the park.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"close, closely, next"},{"g":"of the"},{"g":"park"}]},{"text":"A livraria está aberta.","en":"The bookstore is open.","words":[{"g":"the / to"},null,{"g":"is","l":"estar"},{"g":"a sunny spell"}]},{"text":"Esta é a maior livraria da cidade.","en":"This is the biggest bookstore in town.","words":[{"g":"this","l":"este"},{"g":"is","l":"ser"},{"g":"the / to"},{"g":"major, greater"},null,{"g":"of the"},{"g":"city, town"}]},{"text":"Há uma livraria em frente da minha casa.","en":"There is a bookstore in front of my house.","words":[{"g":"there be","l":"haver"},{"g":"a","l":"um"},null,{"g":"in"},{"g":"front"},{"g":"of the"},{"g":"my, mine","l":"meu"},{"g":"house, home"}]}]}