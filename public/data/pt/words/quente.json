{"id":"quente","lemma":"quente","pos":"adj","rank":524,"glosses":["hot, warm"],"ipa":"/ˈkẽ.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/16/Pt-quente.ogg/Pt-quente.ogg.mp3","forms":{"plural":"quentes"},"examples":[{"text":"A água está quente.","en":"The water is hot.","audio":"https://tatoeba.org/en/audio/download/64119","words":[{"g":"the / to"},{"g":"water"},{"g":"is","l":"estar"},null]},{"text":"Não havia água quente.","en":"There was no hot water.","audio":"https://tatoeba.org/en/audio/download/859186","words":[{"g":"not / no"},{"g":"there be","l":"haver"},{"g":"water"},null]},{"text":"Eu não gosto de lugares quentes.","en":"I don't like hot places.","audio":"https://tatoeba.org/en/audio/download/533851","words":[{"g":"I"},{"g":"not / no"},{"g":"taste"},{"g":"of / from"},{"g":"place","l":"lugar"},null]},{"text":"O café ainda está quente?","en":"Is the coffee still hot?","words":[{"g":"the / it"},{"g":"coffee"},{"g":"still"},{"g":"is","l":"estar"},null]},{"text":"Esqueci de trazer roupas quentes.","en":"I forgot to bring warm clothes.","words":[{"g":"to forget","l":"esquecer"},{"g":"of / from"},{"g":"bring"},{"g":"clothing, clothes","l":"roupa"},null]}]}