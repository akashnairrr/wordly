{"id":"so_","lemma":"só","pos":"adv","rank":36,"glosses":["only; just (indicates that no other action is/was/will be performed)","only; merely; just; simply (indicates that the action is not significant)","alone (unaccompanied or without help)"],"ipa":"/ˈsɔ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0a/LL-Q5146_%28por%29-Santamarcanda-s%C3%B3.wav/LL-Q5146_%28por%29-Santamarcanda-s%C3%B3.wav.mp3","examples":[{"text":"Só preciso de um minuto.","en":"I only need a minute.","audio":"https://tatoeba.org/en/audio/download/536202","words":[null,{"g":"to need","l":"precisar"},{"g":"of / from"},{"g":"a"},{"g":"minute"}]},{"text":"Só quero um emprego.","en":"I just want a job.","audio":"https://tatoeba.org/en/audio/download/471636","words":[null,{"g":"to want","l":"querer"},{"g":"a"},{"g":"job"}]},{"text":"Eu só quero você.","en":"I only want you.","audio":"https://tatoeba.org/en/audio/download/1272449","words":[{"g":"I"},null,{"g":"to want","l":"querer"},{"g":"you (formal)"}]},{"text":"Isto é só para você.","en":"This is only for you.","audio":"https://tatoeba.org/en/audio/download/887655","words":[null,null,null,{"g":"for / to"},{"g":"you (formal)"}],"phrases":[[0,2,"that is"]]},{"text":"Só digo a verdade.","en":"I speak only the truth.","words":[null,{"g":"to speak","l":"dizer"},{"g":"the / to"},{"g":"truth"}]}]}