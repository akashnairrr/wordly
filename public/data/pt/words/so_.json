{"id":"so_","lemma":"só","pos":"adv","rank":36,"glosses":["only; just (indicates that no other action is/was/will be performed)","only; merely; just; simply (indicates that the action is not significant)","alone (unaccompanied or without help)"],"ipa":"/ˈsɔ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6d/LL-Q5146_%28por%29-JnpoJuwan-s%C3%B3.wav/LL-Q5146_%28por%29-JnpoJuwan-s%C3%B3.wav.mp3","examples":[{"text":"Eu só quero você.","en":"I only want you.","audio":"https://tatoeba.org/en/audio/download/1272449","words":[{"g":"I"},null,{"g":"to want","l":"querer"},{"g":"you"}]},{"text":"Isto é só para você.","en":"This is only for you.","audio":"https://tatoeba.org/en/audio/download/887655","words":[null,null,null,{"g":"for / to"},{"g":"you"}],"phrases":[[0,2,"that is"]]},{"text":"Eu só tenho um irmão.","en":"I only have one brother.","audio":"https://tatoeba.org/en/audio/download/535483","words":[{"g":"I"},null,{"g":"have","l":"ter"},{"g":"a"},{"g":"brother"}]},{"text":"Só quero um emprego.","en":"I just want a job.","audio":"https://tatoeba.org/en/audio/download/471636","words":[null,{"g":"to want","l":"querer"},{"g":"a"},{"g":"job"}]},{"text":"Eu só sei disso.","en":"I know only this.","words":[{"g":"I"},null,{"g":"to be aware, to know","l":"saber"},null]}]}