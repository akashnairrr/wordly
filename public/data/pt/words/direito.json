{"id":"direito","lemma":"direito","pos":"adj","rank":355,"glosses":["right (toward the right side; right-hand)","right (complying with justice, correctness or reason; correct)","right (fit for purpose; appropriate; right)"],"ipa":"/d͡ʒiˈɾej.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2a/LL-Q5146_%28por%29-Santamarcanda-direito.wav/LL-Q5146_%28por%29-Santamarcanda-direito.wav.mp3","forms":{"feminine":"direita","masculinePlural":"direitos","femininePlural":"direitas","superlative":"o mais direito"},"formAudio":{"direita":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q5146_%28por%29-Nelson_Ricardo_2500-direita.wav","direitos":"https://upload.wikimedia.org/wikipedia/commons/6/67/LL-Q5146_%28por%29-Nelson_Ricardo_2500-direitos.wav"},"examples":[{"text":"Eu tenho direitos.","en":"I have rights.","audio":"https://tatoeba.org/en/audio/download/489760","words":[{"g":"I"},{"g":"have","l":"ter"},null]},{"text":"Ninguém tem esse direito.","en":"No one has that right.","words":[{"g":"no one"},{"g":"has / there is","l":"ter"},{"g":"that"},null]},{"text":"É o seu direito.","en":"It's their right.","audio":"https://tatoeba.org/en/audio/download/963371","words":[{"g":"is","l":"ser"},{"g":"the / it"},{"g":"his"},null]},{"text":"Você conhece os seus direitos.","en":"You know your rights.","words":[{"g":"you"},{"g":"to know","l":"conhecer"},{"g":"the"},{"g":"their or your kin"},null]},{"text":"Eu sou cego do olho direito.","en":"I am blind in the right eye.","words":[{"g":"I"},{"g":"am","l":"ser"},{"g":"blind"},{"g":"of the"},{"g":"eye"},null]}]}