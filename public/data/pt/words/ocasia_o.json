{"id":"ocasia_o","lemma":"ocasião","pos":"noun","rank":2366,"glosses":["occasion (favorable opportunity)"],"ipa":"/ɔ.kɐˈzjɐ̃w̃/","gender":"f","forms":{"plural":"ocasiões"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q5146_%28por%29-Jessie_Edwin_Lawrence-ocasi%C3%A3o.wav","examples":[{"text":"Esta será uma excelente ocasião.","en":"This will be a great opportunity.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"a","l":"um"},{"g":"excellent"},null]},{"text":"Isso aconteceu em várias ocasiões.","en":"That happened on several occasions.","words":[{"g":"that"},{"g":"to happen","l":"acontecer"},{"g":"in"},null,null]},{"text":"Esta não é a ocasião.","en":"This isn't the time.","words":[{"g":"this","l":"este"},null,null,{"g":"the / to"},null],"phrases":[[1,3,"isn't it"]]},{"text":"Vamos reservar aquilo para outra ocasião.","en":"Let's reserve that for another occasion.","words":[{"g":"let's go"},{"g":"to reserve"},{"g":"that over there, yon","l":"aquele"},{"g":"for / to"},{"g":"other one","l":"outro"},null]},{"text":"Ele foi avisado em várias ocasiões.","en":"He has been warned on several occasions.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"warned"},{"g":"in"},null,null]}]}