{"id":"provavelmente","lemma":"provavelmente","pos":"adv","rank":370,"glosses":["probably"],"ipa":"/pɾuˌva.vɛlˈmẽ.tɨ/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9d/LL-Q5146_%28por%29-Santamarcanda-provavelmente.wav/LL-Q5146_%28por%29-Santamarcanda-provavelmente.wav.mp3","examples":[{"text":"Isso provavelmente vai acontecer.","en":"That'll probably happen.","audio":"https://tatoeba.org/en/audio/download/1270087","words":[{"g":"that"},null,{"g":"to go","l":"ir"},{"g":"to happen"}]},{"text":"Ele está provavelmente morto.","en":"He is probably dead.","words":[{"g":"he"},{"g":"is","l":"estar"},null,{"g":"dead"}]},{"text":"Isto provavelmente significa guerra.","en":"This probably means war.","words":[{"g":"this"},null,{"g":"to mean","l":"significar"},{"g":"war"}]},{"text":"Estou provavelmente perdido.","en":"I am probably lost.","words":[{"g":"am","l":"estar"},null,{"g":"lost"}]},{"text":"Ela provavelmente virá.","en":"She'll probably come.","words":[{"g":"she"},null,{"g":"to come","l":"vir"}]}]}