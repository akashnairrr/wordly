{"id":"bonitinho","lemma":"bonitinho","pos":"adj","rank":3188,"glosses":["cute (attractive or pleasing in a youthful, dainty, quaint or fun-spirited way)","somewhat beautiful (attractive to a small extent)"],"ipa":"/bu.niˈt͡ʃĩ.ɲu/","forms":{"feminine":"bonitinha","masculinePlural":"bonitinhos","femininePlural":"bonitinhas"},"examples":[{"text":"Aquele ali é bonitinho mesmo.","en":"That one over there's really cute.","words":[{"g":"that over there, yon"},{"g":"there )"},{"g":"is","l":"ser"},null,{"g":"really"}]},{"text":"Que menina bonitinha!","en":"What a cute girl!","words":[{"g":"that / what"},{"g":"girl"},null]},{"text":"Isso é tão bonitinho.","en":"That's so cute.","words":[{"g":"that"},{"g":"is","l":"ser"},{"g":"so"},null]},{"text":"Ela não é bonitinha?","en":"Ain't she cute?","words":[{"g":"she"},null,null,null],"phrases":[[1,3,"isn't it"]]},{"text":"Ele não é bonitinho?","en":"Ain't he cute?","words":[{"g":"he"},null,null,null],"phrases":[[1,3,"isn't it"]]}]}