{"id":"cento","lemma":"cento","pos":"noun","rank":2556,"glosses":["hundred (100 units of something)"],"ipa":"/ˈsẽ.tu/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3b/LL-Q5146_%28por%29-MedK1-cento.wav/LL-Q5146_%28por%29-MedK1-cento.wav.mp3","gender":"m","forms":{"plural":"centos"},"examples":[{"text":"Eu concordo cem por cento.","en":"I agree one hundred percent.","words":[{"g":"I"},{"g":"to agree","l":"concordar"},{"g":"a value of one hundred"},{"g":"for / by"},null]},{"text":"Você está cem por cento certo.","en":"You're a hundred percent right.","words":[{"g":"you"},{"g":"is","l":"estar"},{"g":"a value of one hundred"},{"g":"for / by"},null,{"g":"right"}]},{"text":"Onde fica o quarto 105 (cento e cinco)?","en":"Where is Room 105?","audio":"https://tatoeba.org/en/audio/download/841560","words":[{"g":"where"},{"g":"to become","l":"ficar"},{"g":"the / it"},{"g":"quarter"},null,{"g":"and"},{"g":"five"}]},{"text":"Há cem por cento de chance de chuva.","en":"There's a hundred percent chance of rain.","words":[{"g":"there be","l":"haver"},{"g":"a value of one hundred"},{"g":"for / by"},null,{"g":"of / from"},{"g":"probability"},{"g":"of / from"},{"g":"rain"}]},{"text":"Ela tem dez por cento das ações da companhia.","en":"She has a 10 percent interest in the company.","words":[{"g":"she"},{"g":"has / there is","l":"ter"},{"g":"awesome, amazing"},{"g":"for / by"},null,null,{"g":"action","l":"ação"},{"g":"of the"},{"g":"company, companionship"}]}]}