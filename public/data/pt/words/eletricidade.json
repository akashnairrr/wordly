{"id":"eletricidade","lemma":"eletricidade","pos":"noun","rank":2659,"glosses":["electricity"],"ipa":"/e.le.tɾi.siˈda.d͡ʒi/","gender":"f","forms":{"plural":"eletricidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q5146_%28por%29-Ed_Guimaraes-eletricidade.wav","examples":[{"text":"Desligue a eletricidade.","en":"Turn off the electricity.","words":[{"g":"to hang up","l":"desligar"},{"g":"the / to"},null]},{"text":"Você pagou a conta de eletricidade?","en":"Have you paid the electric bill?","words":[{"g":"you"},{"g":"to give [someone] money…","l":"pagar"},{"g":"the / to"},{"g":"operation, calculation"},{"g":"of / from"},null]},{"text":"A eletricidade é muito útil.","en":"Electricity is very useful.","words":[{"g":"the / to"},null,{"g":"is","l":"ser"},{"g":"very / a lot"},{"g":"profitable"}]},{"text":"Estamos sem eletricidade desde manhã.","en":"The power has been off since this morning.","words":[{"g":"to be","l":"estar"},{"g":"-less"},null,{"g":"since"},{"g":"morning"}]},{"text":"Eu não consigo imaginar um futuro sem eletricidade.","en":"I can't imagine a future with no electricity.","words":[{"g":"I"},{"g":"not / no"},{"g":"to get, obtain","l":"conseguir"},{"g":"to imagine"},{"g":"a"},{"g":"future"},{"g":"-less"},null]}]}