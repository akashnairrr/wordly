{"id":"ama_vel","lemma":"amável","pos":"adj","rank":2245,"glosses":["amiable, lovable, lovely","friendly, kind","courteous, engaging"],"ipa":"/ɐˈma.vɛl/","forms":{"plural":"amáveis","superlative":"o mais amável"},"examples":[{"text":"Tom é amável.","en":"Tom is lovable.","audio":"https://tatoeba.org/en/audio/download/1272700","words":[{"g":"tone"},{"g":"is","l":"ser"},null]},{"text":"Ela é uma garota muito amável.","en":"She is a very kind girl.","words":[{"g":"she"},{"g":"is","l":"ser"},{"g":"a","l":"um"},{"g":"girl"},{"g":"very / a lot"},null]},{"text":"Ela não é amável com ele.","en":"She isn't kind to him.","words":[{"g":"she"},null,null,null,{"g":"with"},{"g":"he"}],"phrases":[[1,3,"isn't it"]]},{"text":"Que amável!","en":"How lovely!","audio":"https://tatoeba.org/en/audio/download/87664","words":[{"g":"that / what"},null]},{"text":"Pelo que eu sei, ele é amável.","en":"As far as I know, he's a kind man.","words":[{"g":"by / for the","l":"pelar"},{"g":"that / what"},{"g":"I"},{"g":"to be aware, to know","l":"saber"},{"g":"he"},{"g":"is","l":"ser"},null]}]}