{"id":"estranhamente","lemma":"estranhamente","pos":"adv","rank":4390,"glosses":["strangely"],"ipa":"/(i)ʃˌtɾɐ.ɲɐˈmẽ.tɨ/","examples":[{"text":"Tom está estranhamente quieto hoje.","en":"Tom is unusually quiet today.","words":[{"g":"tone"},{"g":"is","l":"estar"},null,{"g":"quiet"},{"g":"today"}]},{"text":"Eu me senti estranhamente calmo.","en":"I felt strangely calm.","audio":"https://tatoeba.org/en/audio/download/1274503","words":[{"g":"I"},{"g":"me"},{"g":"to sense","l":"sentir"},null,{"g":"calm"}]},{"text":"Estranhamente, não senti absolutamente nenhuma dor.","en":"Strangely enough, I didn't feel any pain at all.","words":[null,{"g":"not / no"},{"g":"to sense","l":"sentir"},{"g":"absolutely"},{"g":"not any, none","l":"nenhum"},{"g":"pain"}]},{"text":"Tom se comportou estranhamente.","en":"Tom behaved strangely.","words":[{"g":"tone"},{"g":"if / oneself"},{"g":"to behave","l":"comportar"},null]}]}