{"id":"charuto","lemma":"charuto","pos":"noun","rank":4366,"glosses":["cigar (rolled bundle of tobacco made for smoking)"],"ipa":"/ʃɐˈɾu.tu/","gender":"m","forms":{"plural":"charutos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q5146_%28por%29-Wiktionairy-charuto.wav","examples":[{"text":"Gostaria de alguns charutos.","en":"I'd like to have some cigars.","words":[{"g":"to like","l":"gostar"},{"g":"of / from"},{"g":"some, any","l":"algum"},null]},{"text":"É um charuto cubano.","en":"It's a Cuban cigar.","words":[{"g":"is","l":"ser"},{"g":"a"},null,{"g":"Cuban"}]},{"text":"Você fuma charutos?","en":"Do you smoke cigars?","words":[{"g":"you (formal)"},{"g":"to smoke","l":"fumar"},null]},{"text":"Tom estava fumando um charuto.","en":"Tom was smoking a cigar.","words":[{"g":"tone"},{"g":"to be","l":"estar"},{"g":"to smoke","l":"fumar"},{"g":"a"},null]}]}