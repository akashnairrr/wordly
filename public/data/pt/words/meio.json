{"id":"meio","lemma":"meio","pos":"noun","rank":212,"glosses":["middle, center","half","way, mean (method by which something is done)"],"ipa":"/ˈmej.u/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/LL-Q5146_%28por%29-Juliano_P._Junho_%28Jjunho%29-meio.wav/LL-Q5146_%28por%29-Juliano_P._Junho_%28Jjunho%29-meio.wav.mp3","gender":"m","forms":{"plural":"meios"},"examples":[{"text":"A do meio é minha.","en":"The middle one is mine.","words":[{"g":"the / to"},{"g":"of the"},null,{"g":"is","l":"ser"},{"g":"my, mine","l":"meu"}]},{"text":"Estou no meio de uma reunião.","en":"I'm in the middle of a meeting.","words":[{"g":"am","l":"estar"},{"g":"in the"},null,{"g":"of / from"},{"g":"a","l":"um"},{"g":"meeting, reunion"}]},{"text":"Foi meio que de surpresa.","en":"It was kind of a surprise.","audio":"https://tatoeba.org/en/audio/download/1270817","words":[{"g":"to be","l":"ser"},null,{"g":"that / what"},{"g":"of / from"},{"g":"surprise"}]},{"text":"O fim justifica os meios.","en":"The end justifies the means.","words":[{"g":"the / it"},{"g":"end"},{"g":"to justify","l":"justificar"},{"g":"the"},null]},{"text":"Está meio quente.","en":"It's kind of hot.","audio":"https://tatoeba.org/en/audio/download/963474","words":[{"g":"is","l":"estar"},null,{"g":"hot, warm"}]}]}