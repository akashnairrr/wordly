{"id":"meio","lemma":"meio","pos":"noun","rank":302,"glosses":["middle, center","half","way, mean (method by which something is done)"],"ipa":"/ˈmɐj.u/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/9f/LL-Q5146_%28por%29-Santamarcanda-meio.wav/LL-Q5146_%28por%29-Santamarcanda-meio.wav.mp3","gender":"m","forms":{"plural":"meios"},"examples":[{"text":"A do meio é minha.","en":"The middle one is mine.","words":[{"g":"the / to"},{"g":"of the"},null,{"g":"is","l":"ser"},{"g":"my, mine","l":"meu"}]},{"text":"Não vejo meio de resolver isto.","en":"I see no means of solving this.","words":[{"g":"not / no"},{"g":"to see","l":"ver"},null,{"g":"of / from"},{"g":"to solve"},{"g":"this"}]},{"text":"Estou no meio de uma reunião.","en":"I'm in the middle of a meeting.","words":[{"g":"am","l":"estar"},{"g":"in the"},null,{"g":"of / from"},{"g":"a","l":"um"},{"g":"meeting, reunion"}]},{"text":"O fim justifica os meios.","en":"The end justifies the means.","words":[{"g":"the / it"},{"g":"end"},{"g":"to justify","l":"justificar"},{"g":"the"},null]},{"text":"Foi meio que de surpresa.","en":"It was kind of a surprise.","audio":"https://tatoeba.org/en/audio/download/1270817","words":[{"g":"to be","l":"ser"},null,{"g":"that / what"},{"g":"of / from"},{"g":"surprise"}]}]}