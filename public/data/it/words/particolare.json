{"id":"particolare","lemma":"particolare","pos":"adj","rank":1105,"glosses":["particular, private, personal (antonym of general)","singular, unusual, particular, special, distinctive (unusual, special)","homosexual (of a relationship)"],"ipa":"/par.ti.koˈla.re/","forms":{"plural":"particolari"},"examples":[{"text":"C'è qualcosa in particolare che vuoi?","en":"Is there something in particular that you want?","words":[null,{"g":"is","l":"essere"},{"g":"something"},{"g":"in"},null,{"g":"that / what"},{"g":"to want","l":"volere"}]},{"text":"Siamo molto particolari.","en":"We're very particular.","words":[{"g":"to be","l":"essere"},{"g":"very / a lot"},null]},{"text":"\"Hai qualcosa da fare?\" \"Nulla di particolare.\"","en":"\"Do you have anything to do?\" \"Nothing in particular.\"","words":[{"g":"have","l":"avere"},{"g":"something"},{"g":"from"},{"g":"to do"},{"g":"nothing, anything"},{"g":"of"},null]},{"text":"Voi siete particolari.","en":"You're particular.","words":[{"g":"you (pl.)"},{"g":"to be","l":"essere"},null]},{"text":"Io sono particolare.","en":"I'm particular.","words":[{"g":"I"},{"g":"am / are","l":"essere"},null]}]}