{"id":"scorta","lemma":"scorta","pos":"noun","rank":2137,"glosses":["escort (especially military, etc.)","supply, hoard"],"ipa":"/ˈskɔr.ta/","gender":"f","forms":{"plural":"scorte"},"examples":[{"text":"Per fortuna ho una chiave di scorta.","en":"Thankfully, I've got a spare key.","words":[null,null,{"g":"have","l":"avere"},{"g":"a","l":"uno"},{"g":"key"},{"g":"of"},null],"phrases":[[0,2,"luckily, fortunately"]]},{"text":"Abbiamo una scorta di carta igienica.","en":"We have a stock of toilet paper.","words":[{"g":"to have","l":"avere"},{"g":"a","l":"uno"},null,{"g":"of"},null,null],"phrases":[[4,6,"toilet paper"]]},{"text":"Le loro scorte erano poche.","en":"Their supplies were low.","words":[{"g":"the / to her"},{"g":"they"},null,{"g":"to be","l":"essere"},{"g":"little, not much","l":"poco"}]},{"text":"Le nostre scorte stanno finendo.","en":"Our supplies are running out.","words":[{"g":"the / to her"},{"g":"our","l":"nostro"},null,{"g":"to stay, remain","l":"stare"},{"g":"to finish","l":"finire"}]},{"text":"Avrai bisogno di una scorta armata.","en":"You will need an armed escort.","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a","l":"uno"},null,{"g":"army"}]}]}