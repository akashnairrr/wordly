{"id":"alba","lemma":"alba","pos":"noun","rank":1572,"glosses":["dawn, daybreak, break of day","sunrise"],"ipa":"/ˈal.ba/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c7/LL-Q652_%28ita%29-LangPao-alba.wav/LL-Q652_%28ita%29-LangPao-alba.wav.mp3","gender":"f","forms":{"plural":"albe"},"examples":[{"text":"Ho dormito fino all'alba.","en":"I slept till dawn.","words":[{"g":"have","l":"avere"},{"g":"to sleep","l":"dormire"},{"g":"till, until, as far as"},null,null]},{"text":"Ci siamo alzati all'alba.","en":"We got up at dawn.","words":[{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"raised","l":"alzato"},null,null]},{"text":"Dobbiamo alzarci all'alba.","en":"We must get up at dawn.","words":[{"g":"to owe","l":"dovere"},null,null,null]},{"text":"L'attacco nemico è finito all'alba.","en":"The enemy attack ended at dawn.","words":[null,{"g":"attack, assault"},{"g":"enemy"},{"g":"is","l":"essere"},{"g":"finished"},null,null]},{"text":"Sta sorgendo l'alba.","en":"The dawn is breaking.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to rise","l":"sorgere"},null,null]}]}