{"id":"insieme","lemma":"insieme","pos":"adv","rank":181,"glosses":["together","at the same time"],"ipa":"/inˈsjɛ.me/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q652_%28ita%29-LangPao-insieme.wav","examples":[{"text":"Volete andare insieme?","en":"Do you want to go together?","words":[{"g":"to want","l":"volere"},{"g":"to go"},null]},{"text":"Perché non andiamo insieme?","en":"Why don't we go together?","words":[{"g":"why / because"},{"g":"not"},{"g":"to go","l":"andare"},null]},{"text":"Gli amici fanno cose insieme.","en":"Friends do things together.","words":[{"g":"the / to him"},{"g":"friend","l":"amico"},{"g":"to do","l":"fare"},{"g":"thing","l":"cosa"},null]},{"text":"Saranno molto felici insieme.","en":"They'll be very happy together.","words":[{"g":"to be","l":"essere"},{"g":"very / a lot"},{"g":"happy","l":"felice"},null]},{"text":"Andiamo a mangiare insieme.","en":"Let's go eat together.","words":[{"g":"to go","l":"andare"},{"g":"to / at"},{"g":"to eat"},null]}]}