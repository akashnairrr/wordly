{"id":"cassetto","lemma":"cassetto","pos":"noun","rank":2883,"glosses":["drawer"],"ipa":"/kasˈset.to/","gender":"m","forms":{"plural":"cassetti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q652_%28ita%29-LangPao-cassetto.wav","examples":[{"text":"Chiudi il cassetto.","en":"Close the drawer.","words":[{"g":"to close, to shut","l":"chiudere"},{"g":"the"},null]},{"text":"La scrivania ha tre cassetti.","en":"The desk has three drawers.","words":[{"g":"the / her"},{"g":"desk"},{"g":"has","l":"avere"},{"g":"three"},null]},{"text":"Questa scrivania ha un cassetto segreto.","en":"This desk has a secret drawer.","words":[{"g":"this, this one, these","l":"questo"},{"g":"desk"},{"g":"has","l":"avere"},{"g":"a"},null,{"g":"secret"}]},{"text":"Hanno perso la chiave del cassetto.","en":"They've lost the key to the drawer.","words":[{"g":"to have","l":"avere"},{"g":"lost, wasted"},{"g":"the / her"},{"g":"key"},{"g":"of the"},null]},{"text":"Perché questo coltello non è nel cassetto?","en":"Why is this knife not in the drawer?","words":[{"g":"why / because"},{"g":"this"},{"g":"knife"},{"g":"not"},{"g":"is","l":"essere"},{"g":"in the"},null]}]}