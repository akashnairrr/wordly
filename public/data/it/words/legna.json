{"id":"legna","lemma":"legna","pos":"noun","rank":3942,"glosses":["firewood"],"ipa":"/ˈleɲ.ɲa/","gender":"f","examples":[{"text":"Questa legna non brucerà.","en":"This wood won't burn.","audio":"https://tatoeba.org/en/audio/download/1006403","words":[{"g":"this, this one, these","l":"questo"},null,{"g":"not"},{"g":"to burn","l":"bruciare"}]},{"text":"Mi piace tagliare la legna.","en":"I like to chop wood.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"to cut, to slash"},{"g":"the / her"},null]},{"text":"La legna secca brucia velocemente.","en":"Dry wood burns quickly.","audio":"https://tatoeba.org/en/audio/download/1010016","words":[{"g":"the / her"},null,{"g":"shoal, sandbank"},{"g":"to burn","l":"bruciare"},{"g":"quickly"}]},{"text":"Tom taglia la legna ogni giorno.","en":"Tom chops wood every day.","words":[null,{"g":"size"},{"g":"the / her"},null,null,null],"phrases":[[4,6,"daily"]]},{"text":"Tom aggiunse più legna al fuoco.","en":"Tom added more wood to the fire.","words":[null,{"g":"to add, to append","l":"aggiungere"},{"g":"more"},null,{"g":"to the"},{"g":"fire"}]}]}