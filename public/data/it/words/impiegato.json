{"id":"impiegato","lemma":"impiegato","pos":"noun","rank":2651,"glosses":["clerk, office worker","employee, (plural) staff, personnel"],"ipa":"/im.pjeˈɡa.to/","gender":"m","forms":{"plural":"impiegati","feminine":"impiegata"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q652_%28ita%29-XANA000-impiegato.wav","examples":[{"text":"Quanti impiegati hai?","en":"How many employees do you have?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"have","l":"avere"}]},{"text":"È un impiegato di banca.","en":"He is a bank clerk.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"of"},{"g":"bank"}]},{"text":"Ho impiegato tre anni.","en":"It took me three years.","words":[{"g":"have","l":"avere"},null,{"g":"three"},{"g":"year","l":"anno"}]},{"text":"Sono ancora impiegata.","en":"I'm still employed.","words":[{"g":"am / are","l":"essere"},{"g":"still / again"},null]},{"text":"Siamo impiegati di banca.","en":"We're bank clerks.","words":[{"g":"to be","l":"essere"},null,{"g":"of"},{"g":"bank"}]}]}