{"id":"onestamente","lemma":"onestamente","pos":"adv","rank":1727,"glosses":["honestly","fairly, virtuously","frankly"],"ipa":"/o.nes.taˈmen.te/","examples":[{"text":"Onestamente, sembra una battuta.","en":"Honestly, it sounds like a joke.","words":[null,{"g":"to seem","l":"sembrare"},{"g":"a","l":"uno"},{"g":"witty remark, joke"}]},{"text":"Onestamente non lo so.","en":"I don't honestly know.","words":[null,null,null,null],"phrases":[[1,4,"I don't know"]]},{"text":"Devi rispondere onestamente.","en":"You must answer honestly.","words":[{"g":"to owe","l":"dovere"},{"g":"to answer"},null]},{"text":"Pensi onestamente che farei qualcosa del genere?","en":"Do you honestly think I'd do something like that?","words":[{"g":"to think","l":"pensare"},null,{"g":"that / what"},{"g":"to do","l":"fare"},{"g":"something"},null,null],"phrases":[[5,7,"like that"]]},{"text":"Hai vinto, onestamente.","en":"You won, fair and square.","words":[{"g":"have","l":"avere"},{"g":"defeated, beaten"},null]}]}