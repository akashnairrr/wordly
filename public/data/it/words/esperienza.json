{"id":"esperienza","lemma":"esperienza","pos":"noun","rank":882,"glosses":["experience"],"ipa":"/es.peˈrjɛn.t͡sa/","gender":"f","forms":{"plural":"esperienze"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q652_%28ita%29-LangPao-esperienza.wav","examples":[{"text":"Posso parlare per esperienza personale.","en":"I can speak from personal experience.","words":[{"g":"can, could","l":"potere"},{"g":"to talk, to speak"},{"g":"for"},null,{"g":"staff, personnel"}]},{"text":"Non ho abbastanza esperienza.","en":"I'm not experienced enough.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"enough, sufficiently"},null]},{"text":"Manca di esperienza.","en":"He lacks experience.","words":[{"g":"to be lacking","l":"mancare"},{"g":"of"},null]},{"text":"Era una nuova esperienza per me.","en":"That was a new experience for me.","words":[{"g":"to be","l":"essere"},{"g":"a","l":"uno"},{"g":"news"},null,{"g":"for"},{"g":"me"}]},{"text":"Le manca esperienza, no?","en":"She lacks experience, doesn't she?","words":[{"g":"the / to her"},{"g":"to be lacking","l":"mancare"},null,{"g":"no"}]}]}