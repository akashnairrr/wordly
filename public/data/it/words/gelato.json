{"id":"gelato","lemma":"gelato","pos":"adj","rank":1540,"glosses":["icy, frozen, very cold"],"ipa":"/d͡ʒeˈla.to/","forms":{"feminine":"gelata","masculinePlural":"gelati","femininePlural":"gelate"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q652_%28ita%29-LangPao-gelato.wav","examples":[{"text":"Quanto gelato vuoi?","en":"How much ice cream do you want?","words":[{"g":"how much, however much"},null,{"g":"to want","l":"volere"}]},{"text":"Due gelati, per piacere.","en":"Two ice creams, please.","words":[{"g":"two"},null,null,null],"phrases":[[2,4,"please"]]},{"text":"Chi vuole del gelato?","en":"Who wants ice cream?","words":[{"g":"who"},{"g":"to want","l":"volere"},{"g":"of the"},null]},{"text":"Hai fame per il gelato?","en":"Are you hungry for ice cream?","words":[{"g":"have","l":"avere"},{"g":"hunger"},{"g":"for"},{"g":"the"},null]},{"text":"Voglio mangiare del gelato.","en":"I want to eat ice cream.","words":[{"g":"to want","l":"volere"},{"g":"to eat"},{"g":"of the"},null]}]}