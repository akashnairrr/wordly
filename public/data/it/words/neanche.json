{"id":"neanche","lemma":"neanche","pos":"adv","rank":243,"glosses":["not … either","not even"],"ipa":"/neˈan.ke/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q652_%28ita%29-XANA000-neanche.wav","examples":[{"text":"Forse non è neanche possibile.","en":"Maybe it's not even possible.","words":[{"g":"maybe"},{"g":"not"},{"g":"is","l":"essere"},null,{"g":"possible"}]},{"text":"Non ero neanche un po' stanco.","en":"I was not a bit tired.","words":[{"g":"not"},{"g":"to be","l":"essere"},null,{"g":"a"},null,{"g":"tired"}]},{"text":"Neanche io posso farlo.","en":"I can't do that either.","words":[null,{"g":"I"},{"g":"can, could","l":"potere"},null]},{"text":"Non voglio neanche sapere chi sei.","en":"I don't even want to know who you are.","words":[{"g":"not"},{"g":"to want","l":"volere"},null,{"g":"to know"},{"g":"who"},{"g":"are","l":"essere"}]},{"text":"Non ho neanche una casa.","en":"I don't even have a house.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"a","l":"uno"},{"g":"house"}]}]}