{"id":"bisogna","lemma":"bisogna","pos":"noun","rank":616,"glosses":["thing, matter, affair","necessity, requirement, need"],"ipa":"/biˈzoɲ.ɲa/","gender":"f","forms":{"plural":"bisogne"},"examples":[{"text":"Bisogna essere pazienti.","en":"You have to be patient.","words":[null,{"g":"to be"},{"g":"patient","l":"paziente"}]},{"text":"Non bisogna aspettare fino alla fine.","en":"You don't have to wait until the end.","words":[{"g":"not"},null,{"g":"to wait for"},null,null,null],"phrases":[[3,6,"until the very end"]]},{"text":"Bisogna seguire le regole.","en":"One must follow the rules.","words":[null,{"g":"to follow, to pursue"},{"g":"the / to her"},{"g":"rule","l":"regola"}]},{"text":"Non bisogna dimenticare questo fatto.","en":"This fact must not be forgotten.","words":[{"g":"not"},null,{"g":"to forget"},{"g":"this"},{"g":"to do","l":"fare"}]},{"text":"Bisogna dare da mangiare al cane.","en":"The dog needs to be fed.","words":[null,{"g":"to give"},{"g":"from"},{"g":"to eat"},{"g":"to the"},{"g":"dog"}]}]}