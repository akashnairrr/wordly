{"id":"tavola","lemma":"tavola","pos":"noun","rank":1512,"glosses":["table","table (grid of data)","board, panel, plank, slab (thin piece of wood or other material)"],"ipa":"/ˈta.vo.la/","gender":"f","forms":{"plural":"tavole"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q652_%28ita%29-LangPao-tavola.wav","examples":[{"text":"C'è un gatto sulla tavola?","en":"Is there a cat on the table?","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"cat"},{"g":"plant of the genus Sulla"},null]},{"text":"Forse l'ho lasciato sulla tavola.","en":"Maybe I left it on the table.","words":[{"g":"maybe"},null,{"g":"have","l":"avere"},{"g":"to leave","l":"lasciare"},{"g":"plant of the genus Sulla"},null]},{"text":"Nessuno voleva alzarsi da tavola.","en":"Nobody wanted to get up from the table.","words":[{"g":"none"},{"g":"to want","l":"volere"},{"g":"to stand up"},{"g":"from"},null]},{"text":"Mia madre apparecchiò la tavola.","en":"My mother set the table.","words":[{"g":"mine","l":"mio"},{"g":"mother"},null,{"g":"the / her"},null]},{"text":"Devo apparecchiare la tavola?","en":"Do I need to set the table?","words":[{"g":"to owe","l":"dovere"},{"g":"to arrange"},{"g":"the / her"},null]}]}