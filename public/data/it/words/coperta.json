{"id":"coperta","lemma":"coperta","pos":"noun","rank":2121,"glosses":["blanket","rug","deck (of a ship)"],"ipa":"/koˈpɛr.ta/","gender":"f","forms":{"plural":"coperte"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q652_%28ita%29-DivoLetto-coperta.wav","examples":[{"text":"Voglio una coperta.","en":"I want a blanket.","words":[{"g":"to want","l":"volere"},{"g":"a","l":"uno"},null]},{"text":"Posso portarti una coperta?","en":"Can I get you a blanket?","words":[{"g":"can, could","l":"potere"},null,{"g":"a","l":"uno"},null]},{"text":"Sono sotto la coperta.","en":"I am under the blanket.","words":[{"g":"am / are","l":"essere"},{"g":"down"},{"g":"the / her"},null]},{"text":"Hanno solo una coperta.","en":"They have only one blanket.","words":[{"g":"to have","l":"avere"},{"g":"only, just"},{"g":"a","l":"uno"},null]},{"text":"Vuoi un'altra coperta?","en":"Do you want another blanket?","words":[{"g":"to want","l":"volere"},{"g":"a"},{"g":"other","l":"altro"},null]}]}