{"id":"anziano","lemma":"anziano","pos":"adj","rank":2534,"glosses":["elder, senior","aged"],"ipa":"/anˈt͡sja.no/","forms":{"feminine":"anziana","masculinePlural":"anziani","femininePlural":"anziane"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q652_%28ita%29-LangPao-anziano.wav","examples":[{"text":"Rispetto gli anziani.","en":"I respect the elderly.","words":[{"g":"respect, deference"},{"g":"the / to him"},null]},{"text":"È un anziano.","en":"He's a senior.","words":[{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Chi è quella donna anziana?","en":"Who's that old woman?","words":[{"g":"who"},{"g":"is","l":"essere"},{"g":"that one","l":"quello"},{"g":"woman"},null]},{"text":"I miei genitori sono anziani.","en":"My parents are old.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"parent","l":"genitore"},{"g":"am / are","l":"essere"},null]},{"text":"L'uomo anziano è molto gentile.","en":"The old man is very kind.","words":[null,{"g":"person, man"},null,{"g":"is","l":"essere"},{"g":"very / a lot"},{"g":"kind, courteous"}]}]}