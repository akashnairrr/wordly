{"id":"quarto","lemma":"quarto","pos":"noun","rank":1406,"glosses":["quarter (part of a town)","quarter, fourth"],"ipa":"/ˈkwar.to/","gender":"m","forms":{"plural":"quarti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q652_%28ita%29-XANA000-quarto.wav","examples":[{"text":"Manca un quarto alle due.","en":"It's a quarter till two.","words":[{"g":"to be lacking","l":"mancare"},{"g":"a"},null,null,{"g":"two"}]},{"text":"Sono le due meno un quarto.","en":"It's a quarter to two.","words":[{"g":"am / are","l":"essere"},{"g":"the / to her"},{"g":"two"},{"g":"less"},{"g":"a"},null]},{"text":"Tre metà sono sei quarti.","en":"Three halves is six quarters.","words":[{"g":"three"},{"g":"half"},{"g":"am / are","l":"essere"},{"g":"are","l":"essere"},null]},{"text":"È al quarto anno.","en":"He's in the fourth year.","words":[{"g":"is","l":"essere"},{"g":"to the"},null,{"g":"year"}]},{"text":"Verrà alle tre e un quarto.","en":"He'll come at quarter past three.","words":[{"g":"to come","l":"venire"},null,{"g":"three"},{"g":"and"},{"g":"a"},null]}]}