{"id":"probabile","lemma":"probabile","pos":"adj","rank":1630,"glosses":["probable, likely, prospective"],"ipa":"/proˈba.bi.le/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2f/LL-Q652_%28ita%29-LangPao-probabile.wav/LL-Q652_%28ita%29-LangPao-probabile.wav.mp3","forms":{"plural":"probabili"},"examples":[{"text":"È possibile, ma non probabile.","en":"It's possible, but not probable.","words":[{"g":"is","l":"essere"},{"g":"possible"},{"g":"but"},{"g":"not"},null]},{"text":"È probabile che non sia vero.","en":"That's likely not true.","words":[{"g":"is","l":"essere"},null,{"g":"that / what"},{"g":"not"},{"g":"both ... and .."},{"g":"true"}]},{"text":"È più probabile di quanto pensi.","en":"It's more likely than you think.","words":[{"g":"is","l":"essere"},{"g":"more"},null,{"g":"of"},{"g":"how much, however much"},{"g":"to think","l":"pensare"}]},{"text":"È molto probabile che sarà pericoloso.","en":"It's very likely going to be dangerous.","words":[{"g":"is","l":"essere"},{"g":"very / a lot"},null,{"g":"that / what"},{"g":"to be","l":"essere"},{"g":"dangerous"}]},{"text":"Semplicemente non sembra probabile.","en":"It just doesn't seem likely.","words":[{"g":"simply, plainly, plain"},{"g":"not"},{"g":"to seem","l":"sembrare"},null]}]}