{"id":"intenzione","lemma":"intenzione","pos":"noun","rank":498,"glosses":["intention, intent, purpose, mind, wish"],"ipa":"/in.tenˈt͡sjo.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/44/LL-Q652_%28ita%29-LangPao-intenzione.wav/LL-Q652_%28ita%29-LangPao-intenzione.wav.mp3","gender":"f","forms":{"plural":"intenzioni"},"examples":[{"text":"Era tua intenzione?","en":"Was that your intention?","words":[{"g":"to be","l":"essere"},{"g":"yours","l":"tuo"},null]},{"text":"Quali sono le tue intenzioni?","en":"What's your intention?","words":[{"g":"what?","l":"quale"},{"g":"am / are","l":"essere"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null]},{"text":"Avevo intenzione di finire il lavoro.","en":"I intended to have finished the work.","words":[{"g":"to have","l":"avere"},null,{"g":"of"},{"g":"to finish"},{"g":"the"},{"g":"work"}]},{"text":"Che ha intenzione di fare?","en":"What does he intend to do?","words":[{"g":"that / what"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"to do"}]},{"text":"So esattamente quali sono le sue intenzioni.","en":"I know exactly what your intentions are.","words":[{"g":"to know","l":"sapere"},{"g":"exactly"},{"g":"what?","l":"quale"},{"g":"am / are","l":"essere"},null,null,null],"phrases":[[4,6,"his"]]}]}