{"id":"armadio","lemma":"armadio","pos":"noun","rank":1891,"glosses":["wardrobe, closet, cupboard, cabinet"],"ipa":"/arˈma.djo/","gender":"m","forms":{"plural":"armadi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q652_%28ita%29-LangPao-armadio.wav","examples":[{"text":"Ho bisogno di un armadio nuovo.","en":"I need a new wardrobe.","words":[{"g":"have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a"},null,{"g":"new"}]},{"text":"Lo metta nell'armadio.","en":"Put it in the closet.","words":[{"g":"the / it"},{"g":"to put","l":"mettere"},null,null]},{"text":"Che altro c'è nell'armadio?","en":"What else is in the closet?","words":[{"g":"that / what"},{"g":"other"},null,{"g":"is","l":"essere"},null,null]},{"text":"Mi serve un armadio nuovo.","en":"I need a new wardrobe.","words":[{"g":"me / myself"},{"g":"slave","l":"servo"},{"g":"a"},null,{"g":"new"}]},{"text":"Sta pulendo il suo armadio.","en":"He's cleaning out his closet.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to clean","l":"pulire"},{"g":"the"},{"g":"his, hers, its"},null]}]}