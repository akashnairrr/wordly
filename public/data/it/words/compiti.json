{"id":"compiti","lemma":"compiti","pos":"noun","rank":1682,"glosses":["housework, chores"],"ipa":"/ˈkom.pi.ti/","gender":"m","examples":[{"text":"Hai già finito i tuoi compiti?","en":"Have you already finished your homework?","words":[{"g":"have","l":"avere"},{"g":"already"},{"g":"finished"},{"g":"the","l":"la"},{"g":"\"your parents\""},null]},{"text":"Ho molti compiti oggi.","en":"I have a lot of homework today.","words":[{"g":"have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"today"}]},{"text":"Perché abbiamo dei compiti?","en":"Why do we have homework?","words":[{"g":"why / because"},{"g":"to have","l":"avere"},{"g":"some"},null]},{"text":"Farò i tuoi compiti per te.","en":"I'll do your homework for you.","words":[{"g":"to do","l":"fare"},{"g":"the","l":"la"},{"g":"\"your parents\""},null,{"g":"for"},{"g":"you, thee"}]},{"text":"Ho un sacco di compiti oggi.","en":"I have a lot of homework today.","words":[{"g":"have","l":"avere"},null,null,{"g":"of"},null,{"g":"today"}],"phrases":[[1,3,"a lot"]]}]}