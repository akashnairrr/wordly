{"id":"dichiarato","lemma":"dichiarato","pos":"adj","rank":2319,"glosses":["avowed, explicit, professed","reported"],"ipa":"/di.kjaˈra.to/","forms":{"feminine":"dichiarata","masculinePlural":"dichiarati","femininePlural":"dichiarate"},"examples":[{"text":"Si è dichiarato alla giovane donna.","en":"He proposed to the young woman.","words":[{"g":"oneself"},{"g":"is","l":"essere"},null,{"g":"to the"},{"g":"young"},{"g":"woman"}]},{"text":"Abbiamo dichiarato guerra.","en":"We declared war.","words":[{"g":"to have","l":"avere"},null,{"g":"war, warfare"}]},{"text":"Il testimone ha dichiarato il suo nome.","en":"The witness stated his name.","words":[{"g":"the"},{"g":"witness"},{"g":"has","l":"avere"},null,{"g":"the"},{"g":"his, hers, its"},{"g":"name"}]},{"text":"La corte l'ha dichiarato colpevole.","en":"The court found him guilty.","words":[{"g":"the / her"},{"g":"courtyard"},null,{"g":"has","l":"avere"},null,{"g":"guilty"}]},{"text":"Ha dichiarato di conoscerti bene.","en":"He claimed he knew you well.","words":[{"g":"has","l":"avere"},null,{"g":"of"},null,{"g":"well"}]}]}