{"id":"tenuto","lemma":"tenuto","pos":"adj","rank":1097,"glosses":["obliged, indebted, grateful, bound to someone","obliged, required to do something"],"ipa":"/teˈnu.to/","forms":{"feminine":"tenuta","masculinePlural":"tenuti","femininePlural":"tenute"},"examples":[{"text":"Quando sarà tenuto il concerto?","en":"When will the concert be held?","words":[{"g":"when"},{"g":"to be","l":"essere"},null,{"g":"the"},{"g":"concert, recital"}]},{"text":"Perché lo avete tenuto segreto?","en":"Why did you keep it a secret?","words":[{"g":"why / because"},{"g":"the / it"},{"g":"to have","l":"avere"},null,{"g":"secret"}]},{"text":"Ho tenuto il cane.","en":"I kept the dog.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"dog"}]},{"text":"Il rumore ci ha tenuti svegli.","en":"The noise kept us awake.","words":[{"g":"the"},{"g":"noise, sound"},{"g":"us / there"},{"g":"has","l":"avere"},null,{"g":"awake","l":"sveglio"}]},{"text":"Ho tenuto il meglio per ultimo.","en":"I've saved the best for last.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"better"},null,null],"phrases":[[4,6,"last, ultimately"]]}]}