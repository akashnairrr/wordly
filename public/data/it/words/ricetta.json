{"id":"ricetta","lemma":"ricetta","pos":"noun","rank":2721,"glosses":["prescription, script (written order for a medical treatment)","recipe","remedy, cure"],"ipa":"/riˈt͡ʃɛt.ta/","gender":"f","forms":{"plural":"ricette"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q652_%28ita%29-LangPao-ricetta.wav","examples":[{"text":"Puoi darmi la ricetta?","en":"Can you give me the recipe?","words":[{"g":"can, could","l":"potere"},null,{"g":"the / her"},null]},{"text":"Può prendere questa medicina senza ricetta.","en":"You can get this medicine without a prescription.","words":[{"g":"can, could","l":"potere"},{"g":"to take"},{"g":"this, this one, these","l":"questo"},{"g":"medicine"},{"g":"without, -less"},null]},{"text":"Mi piace provare nuove ricette.","en":"I like to try new recipes.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"to try"},{"g":"new","l":"nuovo"},null]},{"text":"Avrò bisogno di una ricetta?","en":"Will I need a prescription?","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a","l":"uno"},null]},{"text":"Ho scritto un libro di ricette.","en":"I wrote a cookbook.","words":[{"g":"have","l":"avere"},{"g":"written"},{"g":"a"},{"g":"book"},{"g":"of"},null]}]}