{"id":"febbraio","lemma":"febbraio","pos":"noun","rank":3716,"glosses":["February"],"ipa":"/febˈbra.jo/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q652_%28ita%29-LangPao-febbraio.wav","examples":[{"text":"Fa molto freddo qui a febbraio.","en":"It's very cold here in February.","words":[{"g":"to do","l":"fare"},{"g":"very / a lot"},{"g":"the cold"},{"g":"here"},{"g":"to / at"},null]},{"text":"Abbiamo molta neve a febbraio.","en":"We have a lot of snow in February.","words":[{"g":"to have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},{"g":"snow"},{"g":"to / at"},null]},{"text":"Non ci scrive da febbraio.","en":"He has not written to us since last February.","words":[{"g":"not"},{"g":"us / there"},{"g":"to write","l":"scrivere"},{"g":"from"},null]},{"text":"Avrà diciassette anni in febbraio.","en":"He'll be seventeen in February.","words":[{"g":"to have","l":"avere"},{"g":"seventeen"},{"g":"year","l":"anno"},{"g":"in"},null]},{"text":"Marzo viene tra febbraio ed aprile.","en":"March comes between February and April.","words":[{"g":"March"},{"g":"to come","l":"venire"},{"g":"between"},null,null,{"g":"April"}]}]}