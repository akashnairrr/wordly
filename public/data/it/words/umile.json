{"id":"umile","lemma":"umile","pos":"adj","rank":3829,"glosses":["humble"],"ipa":"/ˈu.mi.le/","forms":{"plural":"umili"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q652_%28ita%29-LangPao-umile.wav","examples":[{"text":"Sono solo un umile insegnante.","en":"I am just a humble teacher.","words":[{"g":"am / are","l":"essere"},{"g":"only, just"},{"g":"a"},null,{"g":"teaching"}]},{"text":"Siete troppo umili.","en":"You're too humble.","words":[{"g":"to be","l":"essere"},{"g":"too much"},null]},{"text":"Sei troppo umile.","en":"You're too humble.","words":[{"g":"are","l":"essere"},{"g":"too much"},null]},{"text":"Lei è troppo umile.","en":"You're too humble.","words":[{"g":"she / you (formal)"},{"g":"is","l":"essere"},{"g":"too much"},null]},{"text":"Benvenuto nella mia umile casa.","en":"Welcome to my humble adobe.","words":[{"g":"welcome"},{"g":"in the"},{"g":"mine","l":"mio"},null,{"g":"house"}]}]}