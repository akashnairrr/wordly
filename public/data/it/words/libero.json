{"id":"libero","lemma":"libero","pos":"adj","rank":538,"glosses":["free (not imprisoned or enslaved)","clear, unobstructed (without blockages)","free (without obligations)"],"ipa":"/ˈli.be.ro/","forms":{"feminine":"libera","masculinePlural":"liberi","femininePlural":"libere"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q652_%28ita%29-LangPao-libero.wav","examples":[{"text":"Sei libero domani?","en":"Are you free tomorrow?","audio":"https://tatoeba.org/en/audio/download/1006375","words":[{"g":"are","l":"essere"},null,{"g":"tomorrow"}]},{"text":"Quando sarai libero?","en":"When will you be free?","words":[{"g":"when"},{"g":"to be","l":"essere"},null]},{"text":"Quando sarete libere?","en":"When will you be free?","words":[{"g":"when"},{"g":"to be","l":"essere"},null]},{"text":"Sono un uomo libero.","en":"I'm a free man.","audio":"https://tatoeba.org/en/audio/download/1000263","words":[{"g":"am / are","l":"essere"},{"g":"a"},{"g":"person, man"},null]},{"text":"Siete libere di andare o restare.","en":"You are free to go or stay.","words":[{"g":"to be","l":"essere"},null,{"g":"of"},{"g":"to go"},{"g":"or"},{"g":"to stay, to remain"}]}]}