{"id":"pressione","lemma":"pressione","pos":"noun","rank":867,"glosses":["pressure","pressure, leverage","blood pressure"],"ipa":"/presˈsjo.ne/","gender":"f","forms":{"plural":"pressioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q652_%28ita%29-DiplomaticBadger-pressione.wav","examples":[{"text":"Non lavoro bene sotto pressione.","en":"I don't work well under pressure.","words":[{"g":"not"},{"g":"work"},{"g":"well"},{"g":"down"},null]},{"text":"Ho la pressione del sangue alta.","en":"I have high blood pressure.","words":[{"g":"have","l":"avere"},{"g":"the / her"},null,{"g":"of the"},{"g":"blood"},{"g":"high, tall","l":"alto"}]},{"text":"Ho sentito molta pressione.","en":"I felt a lot of pressure.","words":[{"g":"have","l":"avere"},{"g":"sincere"},{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Chi sta applicando questa pressione?","en":"Who's applying this pressure?","words":[{"g":"who"},{"g":"to stay, remain","l":"stare"},{"g":"to apply","l":"applicare"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Tom sta subendo molte pressioni.","en":"Tom is under a lot of pressure.","words":[null,{"g":"to stay, remain","l":"stare"},{"g":"to undergo","l":"subire"},{"g":"much, very much, a lot","l":"molto"},null]}]}