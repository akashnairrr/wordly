{"id":"panico","lemma":"panico","pos":"adj","rank":1508,"glosses":["panic","Panic, Pandean (characteristic of Pan)"],"ipa":"/ˈpa.ni.ko/","forms":{"feminine":"panica","masculinePlural":"panici","femininePlural":"paniche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q652_%28ita%29-XANA000-Panico.wav","examples":[{"text":"Chi è andato nel panico?","en":"Who panicked?","words":[{"g":"who"},{"g":"is","l":"essere"},{"g":"to go","l":"andare"},{"g":"in the"},null]},{"text":"Non andiamo nel panico.","en":"Let's not panic.","words":[{"g":"not"},{"g":"to go","l":"andare"},{"g":"in the"},null]},{"text":"Ero nel panico più totale.","en":"I was in a total panic.","words":[{"g":"to be","l":"essere"},{"g":"in the"},null,{"g":"more"},{"g":"total"}]},{"text":"Niente panico!","en":"Don't panic!","audio":"https://tatoeba.org/en/audio/download/993503","words":[{"g":"nothing"},null]},{"text":"Non farti prendere dal panico.","en":"Don't panic.","words":[{"g":"not"},null,{"g":"to take"},{"g":"since"},null]}]}