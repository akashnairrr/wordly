{"id":"governo","lemma":"governo","pos":"noun","rank":718,"glosses":["government, administration, rule","running, management, direction","feeding, tending (of animals)"],"ipa":"/ɡoˈvɛr.no/","gender":"m","forms":{"plural":"governi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q652_%28ita%29-LangPao-governo.wav","examples":[{"text":"È quello che vuole il governo?","en":"Is that what the government wants?","words":[{"g":"is","l":"essere"},{"g":"that"},{"g":"that / what"},{"g":"to want","l":"volere"},{"g":"the"},null]},{"text":"Ho fiducia nel mio governo.","en":"I have faith in my government.","words":[{"g":"have","l":"avere"},{"g":"trust, faith"},{"g":"in the"},{"g":"mine"},null]},{"text":"Hanno accettato il nuovo governo.","en":"They accepted the new government.","words":[{"g":"to have","l":"avere"},{"g":"to accept, to admit","l":"accettare"},{"g":"the"},{"g":"new"},null]},{"text":"Il governo prese la nostra terra.","en":"The government took our land.","words":[{"g":"the"},null,{"g":"busy","l":"preso"},{"g":"the / her"},{"g":"our","l":"nostro"},{"g":"ground"}]},{"text":"Il governo vuole le tue pistole.","en":"The government wants your guns.","words":[{"g":"the"},null,{"g":"to want","l":"volere"},{"g":"the / to her"},{"g":"yours","l":"tuo"},{"g":"pistol, handgun","l":"pistola"}]}]}