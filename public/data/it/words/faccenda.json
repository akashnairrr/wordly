{"id":"faccenda","lemma":"faccenda","pos":"noun","rank":1114,"glosses":["task, labour/labor (thing to do)","issue, matter, affair, business, thing","housework, household chores"],"ipa":"/fatˈt͡ʃɛn.da/","gender":"f","forms":{"plural":"faccende"},"formAudio":{"faccende":"https://upload.wikimedia.org/wikipedia/commons/6/6a/LL-Q652_%28ita%29-LangPao-faccende.wav"},"examples":[{"text":"Questa è una faccenda seria.","en":"This is a serious matter.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"serious","l":"serio"}]},{"text":"Farò tutte le faccende.","en":"I'll do all the chores.","words":[{"g":"to do","l":"fare"},{"g":"everything, all","l":"tutto"},{"g":"the / to her"},null]},{"text":"È una faccenda di grande importanza.","en":"This is a matter of great importance.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"of"},{"g":"adult, grownup"},{"g":"importance"}]},{"text":"Odio le faccende di casa.","en":"I hate housekeeping.","words":[{"g":"hatred"},{"g":"the / to her"},null,{"g":"of"},{"g":"house"}]},{"text":"Devo fare le mie faccende.","en":"I've got to do my chores.","words":[{"g":"to owe","l":"dovere"},{"g":"to do"},{"g":"the / to her"},{"g":"mine","l":"mio"},null]}]}