{"id":"chiacchierata","lemma":"chiacchierata","pos":"noun","rank":2662,"glosses":["chat, talk, chinwag"],"ipa":"/kjak.kjeˈra.ta/","gender":"f","forms":{"plural":"chiacchierate"},"examples":[{"text":"Facciamo una chiacchierata.","en":"Let's have a chat.","words":[{"g":"to do","l":"fare"},{"g":"a","l":"uno"},null]},{"text":"Dobbiamo fare una chiacchierata.","en":"We need to have a talk.","words":[{"g":"to owe","l":"dovere"},{"g":"to do"},{"g":"a","l":"uno"},null]},{"text":"Abbiamo avuto una chiacchierata molto lunga.","en":"We had a very long talk.","words":[{"g":"to have","l":"avere"},{"g":"to have","l":"avere"},{"g":"a","l":"uno"},null,{"g":"very / a lot"},{"g":"long"}]},{"text":"Vorrei fare una piccola chiacchierata con te.","en":"I'd like to have a little chat with you.","words":[{"g":"to want","l":"volere"},{"g":"to do"},{"g":"a","l":"uno"},{"g":"a small glass of beer"},null,{"g":"with"},{"g":"you, thee"}]},{"text":"Incontriamoci per una chiacchierata.","en":"Let's meet for a chat.","words":[{"g":"to meet","l":"incontrarsi"},{"g":"for"},{"g":"a","l":"uno"},null]}]}