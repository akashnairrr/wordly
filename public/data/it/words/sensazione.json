{"id":"sensazione","lemma":"sensazione","pos":"noun","rank":1004,"glosses":["sensation, feeling"],"ipa":"/sen.satˈt͡sjo.ne/","gender":"f","forms":{"plural":"sensazioni"},"examples":[{"text":"Conosco la sensazione.","en":"I know the feeling.","words":[{"g":"to know","l":"conoscere"},{"g":"the / her"},null]},{"text":"Ho una buona sensazione.","en":"I have a good feeling.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},{"g":"righteous, moral","l":"buono"},null]},{"text":"Era solo una sensazione.","en":"It was just a feeling.","words":[{"g":"to be","l":"essere"},{"g":"only, just"},{"g":"a","l":"uno"},null]},{"text":"Lo sai che sensazioni provo per te.","en":"You know how I feel about you.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},{"g":"that / what"},null,{"g":"to try","l":"provare"},{"g":"for"},{"g":"you, thee"}]},{"text":"La sensazione era incredibile.","en":"The feeling was incredible.","words":[{"g":"the / her"},null,{"g":"to be","l":"essere"},{"g":"incredible"}]}]}