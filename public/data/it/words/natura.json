{"id":"natura","lemma":"natura","pos":"noun","rank":992,"glosses":["nature","essence, character"],"ipa":"/naˈtu.ra/","gender":"f","forms":{"plural":"nature"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q652_%28ita%29-LangPao-natura.wav","examples":[{"text":"Amo la natura.","en":"I love nature.","words":[{"g":"to love, to like","l":"amare"},{"g":"the / her"},null]},{"text":"È la natura umana.","en":"It's human nature.","words":[{"g":"is","l":"essere"},{"g":"the / her"},null,{"g":"human","l":"umano"}]},{"text":"Ha una natura generosa.","en":"He has a generous nature.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},null,{"g":"generous","l":"generoso"}]},{"text":"La bellezza della natura è preziosa.","en":"The beauty of nature is precious.","words":[{"g":"the / her"},{"g":"beauty"},{"g":"of the"},null,{"g":"is","l":"essere"},{"g":"precious","l":"prezioso"}]},{"text":"È pigro di natura.","en":"He is lazy by nature.","words":[{"g":"is","l":"essere"},{"g":"lazy"},{"g":"of"},null]}]}