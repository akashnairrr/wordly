{"id":"persino","lemma":"persino","pos":"adv","rank":965,"glosses":["even"],"ipa":"/perˈsi.no/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q652_%28ita%29-LangPao-persino.wav","examples":[{"text":"Lavoro persino la domenica.","en":"I work even on Sunday.","words":[{"g":"work"},null,{"g":"the / her"},{"g":"Sunday"}]},{"text":"Abbiamo persino un aeroporto.","en":"We even have an airport.","words":[{"g":"to have","l":"avere"},null,{"g":"a"},{"g":"airport, airfield"}]},{"text":"Potrebbe persino funzionare.","en":"It might even work.","words":[{"g":"can, could","l":"potere"},null,{"g":"to function, to work"}]},{"text":"Persino Tom è un po' sorpreso.","en":"Even Tom is a little surprised.","words":[null,null,{"g":"is","l":"essere"},{"g":"a"},null,{"g":"surprised"}]},{"text":"Persino Tom la pensa così.","en":"Even Tom thinks so.","words":[null,null,{"g":"the / her"},{"g":"to think","l":"pensare"},{"g":"so"}]}]}