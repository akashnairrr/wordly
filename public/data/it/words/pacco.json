{"id":"pacco","lemma":"pacco","pos":"noun","rank":2119,"glosses":["parcel, package","bundle, deck","swindle, con"],"ipa":"/ˈpak.ko/","gender":"m","forms":{"plural":"pacchi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q652_%28ita%29-DivoLetto-pacco.wav","examples":[{"text":"Ho il pacco.","en":"I have the package.","words":[{"g":"have","l":"avere"},{"g":"the"},null]},{"text":"Il pacco è qui.","en":"The package is here.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"here"}]},{"text":"Apri il pacco, per piacere.","en":"Please open the package.","words":[{"g":"to open","l":"aprire"},{"g":"the"},null,null,null],"phrases":[[3,5,"please"]]},{"text":"Le cose buone vengono in pacchi piccoli.","en":"Good things come in small packages.","words":[{"g":"the / to her"},{"g":"thing","l":"cosa"},{"g":"righteous, moral","l":"buono"},{"g":"to come","l":"venire"},{"g":"in"},null,{"g":"small","l":"piccolo"}]},{"text":"Ti ho mandato un pacco.","en":"I've sent you a package.","words":[{"g":"you"},{"g":"have","l":"avere"},{"g":"mandate"},{"g":"a"},null]}]}