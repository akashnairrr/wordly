{"id":"raccolto","lemma":"raccolto","pos":"adj","rank":2071,"glosses":["thoughtful, wrapped up","secluded","drawn up (of the legs etc.)"],"ipa":"/rakˈkɔl.to/","forms":{"feminine":"raccolta","masculinePlural":"raccolti","femininePlural":"raccolte"},"examples":[{"text":"Abbiamo raccolto abbastanza soldi?","en":"Have we raised enough money?","words":[{"g":"to have","l":"avere"},null,{"g":"enough, sufficiently"},{"g":"money"}]},{"text":"Ha raccolto il libro.","en":"He picked up the book.","words":[{"g":"has","l":"avere"},null,{"g":"the"},{"g":"book"}]},{"text":"I raccolti hanno bisogno della pioggia.","en":"The crops need rain.","words":[{"g":"the","l":"la"},null,{"g":"to have","l":"avere"},{"g":"need"},{"g":"of the"},{"g":"rain"}]},{"text":"Hai raccolto le tue cose?","en":"Have you collected your things?","words":[{"g":"have","l":"avere"},null,{"g":"the / to her"},{"g":"yours","l":"tuo"},{"g":"thing","l":"cosa"}]},{"text":"Ha raccolto una pietra.","en":"He picked up a stone.","words":[{"g":"has","l":"avere"},null,{"g":"a","l":"uno"},{"g":"stone"}]}]}