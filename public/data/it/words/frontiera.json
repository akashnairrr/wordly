{"id":"frontiera","lemma":"frontiera","pos":"noun","rank":3887,"glosses":["frontier, border"],"ipa":"/fronˈtjɛ.ra/","gender":"f","forms":{"plural":"frontiere"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q652_%28ita%29-LangPao-frontiera.wav","examples":[{"text":"La frontiera è chiusa.","en":"The border is closed.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"enclosure"}]},{"text":"Abitiamo vicino alla frontiera.","en":"We live near the border.","words":[{"g":"to live, to reside","l":"abitare"},{"g":"near"},{"g":"to the"},null]},{"text":"Hanno attraversato la frontiera.","en":"They crossed the border.","words":[{"g":"to have","l":"avere"},{"g":"to cross","l":"attraversare"},{"g":"the / her"},null]},{"text":"Loro attraversarono la frontiera.","en":"They crossed the border.","words":[{"g":"they"},{"g":"to cross","l":"attraversare"},{"g":"the / her"},null]},{"text":"Attraversarono la frontiera.","en":"They crossed the border.","words":[{"g":"to cross","l":"attraversare"},{"g":"the / her"},null]}]}