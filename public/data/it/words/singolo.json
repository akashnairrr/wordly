{"id":"singolo","lemma":"singolo","pos":"noun","rank":2148,"glosses":["single (45 rpm record)","singles match","single scull"],"ipa":"/ˈsin.ɡo.lo/","gender":"m","forms":{"plural":"singoli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cc/LL-Q652_%28ita%29-LangPao-singolo.wav","examples":[{"text":"Ci penso ogni singolo giorno.","en":"I think about that every single day.","words":[{"g":"us / there"},{"g":"to think","l":"pensare"},{"g":"each, every"},null,{"g":"day"}]},{"text":"Vorresti un singolo o un doppio?","en":"Would you like a single or a double?","words":[{"g":"to want","l":"volere"},{"g":"a"},null,{"g":"or"},{"g":"a"},{"g":"two"}]},{"text":"Ogni viaggio inizia con un singolo passo.","en":"Every journey begins with a single step.","words":[{"g":"each, every"},{"g":"journey"},{"g":"to begin, to set about","l":"iniziare"},{"g":"with"},{"g":"a"},null,{"g":"footstep"}]},{"text":"Ho superato ogni singolo esame.","en":"I passed every single test.","words":[{"g":"have","l":"avere"},{"g":"overtaken"},{"g":"each, every"},null,{"g":"examination, test"}]},{"text":"Non ho preso un singolo pesce.","en":"I didn't catch one single fish.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},{"g":"a"},null,{"g":"fish"}]}]}