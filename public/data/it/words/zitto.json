{"id":"zitto","lemma":"zitto","pos":"adj","rank":573,"glosses":["quiet, silent"],"ipa":"/ˈd͡zit.to/","forms":{"feminine":"zitta","masculinePlural":"zitti","femininePlural":"zitte"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q652_%28ita%29-XANA000-zitto.wav","examples":[{"text":"Stai zitto un momento.","en":"Be quiet for a moment.","audio":"https://tatoeba.org/en/audio/download/1006364","words":[{"g":"to stay, remain","l":"stare"},null,{"g":"a"},{"g":"moment"}]},{"text":"Sta' zitta e ascolta.","en":"Shut up and listen.","words":[{"g":"to stay, remain","l":"stare"},null,{"g":"and"},{"g":"to listen to","l":"ascoltare"}]},{"text":"Stai zitto e siediti.","en":"Shut up and sit down.","words":[{"g":"to stay, remain","l":"stare"},null,{"g":"and"},{"g":"to sit","l":"sedersi"}]},{"text":"State zitti e sedetevi.","en":"Shut up and sit down.","words":[{"g":"to stay, remain","l":"stare"},null,{"g":"and"},{"g":"to sit","l":"sedersi"}]},{"text":"Il bibliotecario ci disse di stare zitte.","en":"The librarian told us to keep quiet.","words":[{"g":"the"},{"g":"librarian"},{"g":"us / there"},{"g":"to utter with one's…","l":"dire"},{"g":"of"},{"g":"to stay, remain"},null]}]}