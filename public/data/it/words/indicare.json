{"id":"indicare","lemma":"indicare","pos":"verb","rank":3360,"glosses":["to point out, point to","to show, to mean, to signpost, to mark","to recommend, to advise"],"ipa":"/in.diˈka.re/","conjugation":{"indicative":{"present":{"1s":"indico","2s":"indichi","3s":"indica","1p":"indichiamo","2p":"indicate","3p":"indicano"},"imperfect":{"1s":"indicavo","2s":"indicavi","3s":"indicava","1p":"indicavamo","2p":"indicavate","3p":"indicavano"},"preterite":{"1s":"indicai","2s":"indicasti","3s":"indicò","1p":"indicammo","2p":"indicaste","3p":"indicarono"},"future":{"1s":"indicherò","2s":"indicherai","3s":"indicherà","1p":"indicheremo","2p":"indicherete","3p":"indicheranno"},"conditional":{"1s":"indicherei","2s":"indicheresti","3s":"indicherebbe","1p":"indicheremmo","2p":"indichereste","3p":"indicherebbero"},"perfect":{"1s":"ho indicato","2s":"hai indicato","3s":"ha indicato","1p":"abbiamo indicato","2p":"avete indicato","3p":"hanno indicato"}},"subjunctive":{"present":{"1s":"indichi","2s":"indichi","3s":"indichi","1p":"indichiamo","2p":"indichiate","3p":"indichino"},"imperfect":{"1s":"indicassi","2s":"indicassi","3s":"indicasse","1p":"indicassimo","2p":"indicaste","3p":"indicassero"}},"imperative":{"affirmative":{"2s":"indica","1p":"indichiamo","2p":"indicate"},"negative":{"2s":"indicare","1p":"indichiamo","2p":"indicate"}}},"nonFinite":{"gerund":"indicando","participle":"indicato"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q652_%28ita%29-LangPao-indicare.wav","examples":[{"text":"Non indicare gli altri.","en":"Don't point at others.","words":[{"g":"not"},null,{"g":"the / to him"},{"g":"other","l":"altro"}]},{"text":"Che cosa stai indicando?","en":"What are you pointing at?","words":[null,null,{"g":"to stay, remain","l":"stare"},null],"phrases":[[0,2,"what"]]},{"text":"Non indichi le persone.","en":"Don't point at people.","words":[{"g":"not"},null,{"g":"the / to her"},{"g":"person","l":"persona"}]},{"text":"Le bussole indicano il nord.","en":"Compasses poi