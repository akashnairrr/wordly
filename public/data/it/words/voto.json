{"id":"voto","lemma":"voto","pos":"noun","rank":1647,"glosses":["vow","vote, ballot","mark, grade"],"ipa":"/ˈvo.to/","gender":"m","forms":{"plural":"voti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q652_%28ita%29-DivoLetto-voto.wav","examples":[{"text":"Il voto è unanime.","en":"The vote is unanimous.","audio":"https://tatoeba.org/en/audio/download/1010080","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"unanimous"}]},{"text":"Ti meriti un bel voto.","en":"You deserve a good grade.","words":[{"g":"you"},{"g":"to deserve, merit","l":"meritare"},{"g":"a"},{"g":"nice","l":"bello"},null]},{"text":"Non voto nemmeno.","en":"I don't even vote.","words":[{"g":"not"},null,{"g":"not even"}]},{"text":"Presi un buon voto in inglese.","en":"I got a good grade in English.","words":[{"g":"busy","l":"preso"},{"g":"a"},null,null,{"g":"in"},{"g":"Englishman"}]},{"text":"Per chi voti?","en":"Who are you voting for?","words":[{"g":"for"},{"g":"who"},null]}]}