{"id":"caduta","lemma":"caduta","pos":"noun","rank":1312,"glosses":["fall (act of falling)","drop (i.e. temperature drop)"],"ipa":"/kaˈdu.ta/","gender":"f","forms":{"plural":"cadute"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q652_%28ita%29-LangPao-caduta.wav","examples":[{"text":"Sono caduta da un albero.","en":"I fell from a tree.","words":[{"g":"am / are","l":"essere"},null,{"g":"from"},{"g":"a"},{"g":"tree"}]},{"text":"Sono caduta nella piscina.","en":"I fell in the pool.","words":[{"g":"am / are","l":"essere"},null,{"g":"in the"},{"g":"swimming pool"}]},{"text":"È caduta la linea.","en":"The line went dead.","words":[{"g":"is","l":"essere"},null,{"g":"the / her"},{"g":"line"}]},{"text":"La sua testa fu ferita nella caduta.","en":"His head was hurt by the fall.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"head"},{"g":"deceased, late"},{"g":"injury"},{"g":"in the"},null]},{"text":"Sono caduta in una trappola.","en":"I fell into a trap.","words":[{"g":"am / are","l":"essere"},null,{"g":"in"},{"g":"a","l":"uno"},{"g":"trap, snare, catch"}]}]}