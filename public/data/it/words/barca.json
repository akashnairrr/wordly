{"id":"barca","lemma":"barca","pos":"noun","rank":827,"glosses":["boat","skiff"],"ipa":"/ˈbar.ka/","gender":"f","forms":{"plural":"barche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q652_%28ita%29-LangPao-barca.wav","examples":[{"text":"Ho una barca.","en":"I have a boat.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Abbiamo due barche.","en":"We have two boats.","words":[{"g":"to have","l":"avere"},{"g":"two"},null]},{"text":"Può andare lì in barca.","en":"You can go there in a boat.","words":[{"g":"can, could","l":"potere"},{"g":"to go"},{"g":"there"},{"g":"in"},null]},{"text":"Ci sono alcune barche sul lago.","en":"There are a few boats on the lake.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"some, a few","l":"alcuno"},null,null,{"g":"lake"}]},{"text":"La barca può essere ancora vista.","en":"The boat can still be seen.","words":[{"g":"the / her"},null,{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"still / again"},{"g":"sight"}]}]}