{"id":"girato","lemma":"girato","pos":"adj","rank":2107,"glosses":["turned","cooked on a turnspit","endorsed (of a cheque/check, etc.)"],"ipa":"/d͡ʒiˈra.to/","forms":{"feminine":"girata","masculinePlural":"girati","femininePlural":"girate"},"examples":[{"text":"Girati.","en":"Turn around.","audio":"https://tatoeba.org/en/audio/download/993456","words":[null]},{"text":"Ho girato la chiave.","en":"I turned the key.","words":[{"g":"have","l":"avere"},null,{"g":"the / her"},{"g":"key"}]},{"text":"Girati verso di me, per piacere.","en":"Turn toward me, please.","words":[null,{"g":"in the direction of"},{"g":"of"},{"g":"me"},null,null],"phrases":[[4,6,"please"]]},{"text":"Ho girato a destra.","en":"I turned right.","words":[{"g":"have","l":"avere"},null,{"g":"to / at"},{"g":"right"}]},{"text":"È giusto girato l'angolo.","en":"It's just around the corner.","words":[{"g":"is","l":"essere"},{"g":"just, exactly"},null,null,{"g":"angle, corner"}]}]}