{"id":"inverno","lemma":"inverno","pos":"noun","rank":1814,"glosses":["winter"],"ipa":"/inˈvɛr.no/","gender":"m","forms":{"plural":"inverni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/42/LL-Q652_%28ita%29-XANA000-inverno.wav","examples":[{"text":"Presto sarà inverno.","en":"Soon it'll be winter.","words":[{"g":"soon"},{"g":"to be","l":"essere"},null]},{"text":"Sarà un lungo inverno.","en":"It's going to be a long winter.","words":[{"g":"to be","l":"essere"},{"g":"a"},{"g":"along"},null]},{"text":"Abbiamo avuto molta neve questo inverno.","en":"We have had a lot of snow this winter.","words":[{"g":"to have","l":"avere"},{"g":"to have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},{"g":"snow"},{"g":"this"},null]},{"text":"Questo inverno è caldo.","en":"This winter is warm.","words":[{"g":"this"},null,{"g":"is","l":"essere"},{"g":"heat"}]},{"text":"Non mi piacciono gli inverni caldi.","en":"I don't like warm winters.","words":[{"g":"not"},{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the / to him"},null,{"g":"heat","l":"caldo"}]}]}