{"id":"stasera","lemma":"stasera","pos":"adv","rank":278,"glosses":["this evening, tonight"],"ipa":"/staˈse.ra/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q652_%28ita%29-LangPao-stasera.wav","examples":[{"text":"Sei libero stasera?","en":"Are you free tonight?","words":[{"g":"are","l":"essere"},{"g":"free"},null]},{"text":"Posso stare qui stasera?","en":"Can I stay here tonight?","words":[{"g":"can, could","l":"potere"},{"g":"to stay, remain"},{"g":"here"},null]},{"text":"Vuoi mangiare fuori stasera?","en":"Do you want to eat out tonight?","words":[{"g":"to want","l":"volere"},{"g":"to eat"},{"g":"out, outside, outwards"},null]},{"text":"Mi chiami stasera.","en":"Call me tonight.","words":[{"g":"me / myself"},{"g":"to call","l":"chiamare"},null]},{"text":"Sarò qua stasera.","en":"I'll be here tonight.","words":[{"g":"to be","l":"essere"},{"g":"here"},null]}]}