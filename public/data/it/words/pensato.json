{"id":"pensato","lemma":"pensato","pos":"adj","rank":248,"glosses":["well thought-out or considered","designed (for)"],"ipa":"/penˈsa.to/","forms":{"feminine":"pensata","masculinePlural":"pensati","femininePlural":"pensate"},"examples":[{"text":"Ho pensato la stessa cosa.","en":"I thought the same thing.","words":[{"g":"have","l":"avere"},null,{"g":"the / her"},{"g":"same","l":"stesso"},{"g":"thing"}]},{"text":"Ho pensato al futuro.","en":"I thought about the future.","words":[{"g":"have","l":"avere"},null,{"g":"to the"},{"g":"future"}]},{"text":"Qualcuno ha pensato a questo?","en":"Has anyone thought about this?","words":[{"g":"someone, somebody"},{"g":"has","l":"avere"},null,{"g":"to / at"},{"g":"this"}]},{"text":"È quello che abbiamo pensato tutti.","en":"That's what we all thought.","words":[{"g":"is","l":"essere"},{"g":"that"},{"g":"that / what"},{"g":"to have","l":"avere"},null,{"g":"all"}]},{"text":"È come ho sempre pensato.","en":"It's like I always thought.","words":[{"g":"is","l":"essere"},{"g":"how / like"},{"g":"have","l":"avere"},{"g":"always"},null]}]}