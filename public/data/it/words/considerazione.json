{"id":"considerazione","lemma":"considerazione","pos":"noun","rank":2338,"glosses":["consideration, reflection, thought","consideration, notice, regard, esteem, reputation, account","remark, comment, thought"],"ipa":"/kon.si.de.ratˈt͡sjo.ne/","gender":"f","forms":{"plural":"considerazioni"},"examples":[{"text":"Ho preso tutto in considerazione.","en":"I've taken everything into consideration.","words":[{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},{"g":"everything, all"},{"g":"in"},null]},{"text":"Deve essere presa in considerazione.","en":"It has to be taken into account.","words":[{"g":"to owe","l":"dovere"},{"g":"to be"},{"g":"grip"},{"g":"in"},null]},{"text":"Lo prenderò in considerazione.","en":"I'll take it into consideration.","words":[{"g":"the / it"},{"g":"to take","l":"prendere"},{"g":"in"},null]},{"text":"Ho preso in considerazione la tua richiesta.","en":"I've considered your request.","words":[{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},{"g":"in"},null,{"g":"the / her"},{"g":"yours","l":"tuo"},{"g":"request"}]},{"text":"Ho preso in considerazione anche quella possibilità.","en":"I've considered that possibility as well.","words":[{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},{"g":"in"},null,{"g":"also"},{"g":"that one","l":"quello"},{"g":"possibility"}]}]}