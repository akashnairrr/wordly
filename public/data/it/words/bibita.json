{"id":"bibita","lemma":"bibita","pos":"noun","rank":4841,"glosses":["soft drink"],"ipa":"/ˈbi.bi.ta/","gender":"f","forms":{"plural":"bibite"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q652_%28ita%29-LangPao-bibita.wav","examples":[{"text":"Grazie per la bibita.","en":"Thanks for the drink.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the / her"},null]},{"text":"Arrivo subito con delle bibite.","en":"I'll be right back with refreshments.","words":[{"g":"arrival"},{"g":"at once"},{"g":"with"},null,null]},{"text":"Barista, vorrei avere una bibita.","en":"Bartender, I'd like to have a drink.","words":[{"g":"barman"},{"g":"to want","l":"volere"},{"g":"to have"},{"g":"a","l":"uno"},null]},{"text":"Le bibite sono a metà prezzo fino alle sei.","en":"The drinks are half price until six.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"to / at"},{"g":"half"},{"g":"price"},{"g":"till, until, as far as"},null,{"g":"are","l":"essere"}]},{"text":"Vorrei un hamburger e una bibita.","en":"I'd like a hamburger and a cola.","words":[{"g":"to want","l":"volere"},{"g":"a"},{"g":"patty"},{"g":"and"},{"g":"a","l":"uno"},null]}]}