{"id":"fuori","lemma":"fuori","pos":"prep","rank":98,"glosses":["out, outside, outwards (towards the outside)","outside, beyond","out, away from"],"ipa":"/ˈfwɔ.ri/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q652_%28ita%29-Jennum-fuori.wav","examples":[{"text":"Posso andare fuori?","en":"Can I go outside?","words":[{"g":"can, could","l":"potere"},{"g":"to go"},null]},{"text":"Qualcuno è lì fuori?","en":"Is somebody out there?","words":[{"g":"someone, somebody"},{"g":"is","l":"essere"},{"g":"there"},null]},{"text":"Potresti aspettare fuori?","en":"Could you wait outside?","words":[{"g":"can, could","l":"potere"},{"g":"to wait for"},null]},{"text":"Lascia il cane fuori.","en":"Keep the dog out.","audio":"https://tatoeba.org/en/audio/download/1001325","words":[{"g":"to leave","l":"lasciare"},{"g":"the"},{"g":"dog"},null]},{"text":"Vieni fuori ora.","en":"Come out now.","words":[{"g":"to come","l":"venire"},null,{"g":"now"}]}]}