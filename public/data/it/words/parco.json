{"id":"parco","lemma":"parco","pos":"adj","rank":1164,"glosses":["frugal, moderate, temperate, sparing"],"ipa":"/ˈpar.ko/","forms":{"feminine":"parca","masculinePlural":"parchi","femininePlural":"parche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q652_%28ita%29-LangPao-parco.wav","examples":[{"text":"Chi vuole andare al parco?","en":"Who wants to go to the park?","words":[{"g":"who"},{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to the"},null]},{"text":"Vedi della gente nel parco?","en":"Do you see people in the park?","words":[{"g":"to see","l":"vedere"},{"g":"of the"},null,{"g":"in the"},null]},{"text":"Ti piace andare ai parchi?","en":"Do you enjoy going to parks?","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"to go"},null,null]},{"text":"Vivo vicino ad un parco.","en":"I live near a park.","words":[{"g":"alive, live"},{"g":"near"},null,{"g":"a"},null]},{"text":"Ci sono molti parchi qui attorno.","en":"There are many parks around here.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"here"},{"g":"around"}]}]}