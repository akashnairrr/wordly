{"id":"ruolo","lemma":"ruolo","pos":"noun","rank":1283,"glosses":["role"],"ipa":"/ˈrwɔ.lo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/LL-Q652_%28ita%29-LangPao-ruolo.wav/LL-Q652_%28ita%29-LangPao-ruolo.wav.mp3","gender":"m","forms":{"plural":"ruoli"},"examples":[{"text":"Ho un ruolo importante.","en":"I have an important role.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"important"}]},{"text":"Capisco il mio ruolo.","en":"I understand my role.","words":[{"g":"to understand","l":"capire"},{"g":"the"},{"g":"mine"},null]},{"text":"Devi accettare il tuo ruolo.","en":"You must accept your role.","words":[{"g":"to owe","l":"dovere"},{"g":"to accept, to admit"},{"g":"the"},{"g":"yours"},null]},{"text":"Sono di ruolo.","en":"I have tenure.","words":[{"g":"am / are","l":"essere"},{"g":"of"},null]},{"text":"La fortuna gioca un ruolo importante nella vita.","en":"Luck plays an important part in life.","words":[{"g":"the / her"},{"g":"luck"},{"g":"to play a game","l":"giocare"},{"g":"a"},null,{"g":"important"},{"g":"in the"},{"g":"life"}]}]}