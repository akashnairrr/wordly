{"id":"semplice","lemma":"semplice","pos":"adj","rank":504,"glosses":["simple","easy"],"ipa":"/ˈsem.pli.t͡ʃe/","forms":{"plural":"semplici"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q652_%28ita%29-LangPao-semplice.wav","examples":[{"text":"È un uomo semplice.","en":"He is a simple man.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},null]},{"text":"Le regole sono semplici.","en":"The rules are simple.","words":[{"g":"the / to her"},{"g":"rule","l":"regola"},{"g":"am / are","l":"essere"},null]},{"text":"Sembrava così semplice.","en":"It seemed so simple.","words":[{"g":"to seem","l":"sembrare"},{"g":"so"},null]},{"text":"Questi sono i semplici fatti.","en":"These are the simple facts.","words":[{"g":"this, this one, these","l":"questo"},{"g":"am / are","l":"essere"},{"g":"the","l":"la"},null,{"g":"done, made","l":"fatto"}]},{"text":"Vivo una vita semplice.","en":"I live a simple life.","words":[{"g":"alive, live"},{"g":"a","l":"uno"},{"g":"life"},null]}]}