{"id":"donna","lemma":"donna","pos":"noun","rank":179,"glosses":["woman","wife","queen"],"ipa":"/ˈdɔn.na/","gender":"f","forms":{"plural":"donne","masculine":"donnone"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q652_%28ita%29-XANA000-donna.wav","examples":[{"text":"Sei una donna?","en":"Are you a woman?","words":[{"g":"are","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"Come sarebbe il mondo senza donne?","en":"How would the world be without women?","words":[{"g":"how / like"},{"g":"to be","l":"essere"},{"g":"the"},{"g":"world"},{"g":"without, -less"},null]},{"text":"Quella è una donna?","en":"Is that a woman?","words":[{"g":"that one","l":"quello"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"Ci sono molte donne qui.","en":"There are a lot of women here.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"here"}]},{"text":"Conosco questa donna.","en":"I know this woman.","words":[{"g":"to know","l":"conoscere"},{"g":"this, this one, these","l":"questo"},null]}]}