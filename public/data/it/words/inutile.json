{"id":"inutile","lemma":"inutile","pos":"adj","rank":993,"glosses":["useless, unnecessary, needless","ineffective"],"ipa":"/iˈnu.ti.le/","forms":{"plural":"inutili"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q652_%28ita%29-LangPao-inutile.wav","examples":[{"text":"Questo è inutile.","en":"This is useless.","words":[{"g":"this"},{"g":"is","l":"essere"},null]},{"text":"Tutta questa roba è inutile.","en":"All of this stuff is useless.","words":[{"g":"everything, all","l":"tutto"},{"g":"this, this one, these","l":"questo"},{"g":"things, stuff"},{"g":"is","l":"essere"},null]},{"text":"Le informazioni erano piuttosto inutili.","en":"The information was quite useless.","words":[{"g":"the / to her"},{"g":"information","l":"informazione"},{"g":"to be","l":"essere"},{"g":"rather than"},null]},{"text":"Mio marito è un essere inutile.","en":"My husband is useless.","audio":"https://tatoeba.org/en/audio/download/1010104","words":[{"g":"mine"},{"g":"husband"},{"g":"is","l":"essere"},{"g":"a"},{"g":"to be"},null]},{"text":"Noi siamo inutili.","en":"We're useless.","words":[{"g":"we"},{"g":"to be","l":"essere"},null]}]}