{"id":"argomento","lemma":"argomento","pos":"noun","rank":1568,"glosses":["topic, matter, subject, issue, point (subject)","argument (reason)"],"ipa":"/ar.ɡoˈmen.to/","gender":"m","forms":{"plural":"argomenti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q652_%28ita%29-LangPao-argomento.wav","examples":[{"text":"Hai scelto un argomento?","en":"Have you chosen a topic?","words":[{"g":"have","l":"avere"},{"g":"chosen"},{"g":"a"},null]},{"text":"Alcuni argomenti sono senza tempo.","en":"Some topics are timeless.","words":[{"g":"some, a few","l":"alcuno"},null,{"g":"am / are","l":"essere"},null,null],"phrases":[[3,5,"timeless"]]},{"text":"È un argomento molto interessante.","en":"That's a very interesting topic.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"very / a lot"},{"g":"interesting"}]},{"text":"Ora, possiamo cambiare argomento, per piacere?","en":"Now, can we please change the subject?","words":[{"g":"now"},null,{"g":"to exchange"},null,null,null],"phrases":[[4,6,"please"]]},{"text":"È un argomento difficile da discutere.","en":"It's a difficult topic to discuss.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"difficult, hard"},{"g":"from"},{"g":"to discuss"}]}]}