{"id":"spiacente","lemma":"spiacente","pos":"adj","rank":2358,"glosses":["sorry"],"ipa":"/spjaˈt͡ʃɛn.te/","forms":{"plural":"spiacenti"},"examples":[{"text":"Spiacente, hai il numero sbagliato.","en":"Sorry, you have the wrong number.","words":[null,{"g":"have","l":"avere"},{"g":"the"},{"g":"number"},{"g":"wrong"}]},{"text":"OK, spiacenti, a domani.","en":"OK, sorry, see you tomorrow.","words":[null,null,{"g":"to / at"},{"g":"tomorrow"}]},{"text":"Spiacente, ma devo lavorare stasera.","en":"Sorry, but I have to work tonight.","words":[null,{"g":"but"},{"g":"to owe","l":"dovere"},{"g":"to work"},{"g":"this evening, tonight"}]},{"text":"Spiacenti, ho fatto un errore.","en":"Sorry, I made a mistake.","words":[null,{"g":"have","l":"avere"},{"g":"to do","l":"fare"},{"g":"a"},{"g":"mistake"}]},{"text":"Spiacente, ma non capisco.","en":"I'm sorry, but I don't understand.","words":[null,{"g":"but"},null,null],"phrases":[[2,4,"I don't understand"]]}]}