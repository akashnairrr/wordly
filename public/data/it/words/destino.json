{"id":"destino","lemma":"destino","pos":"noun","rank":909,"glosses":["destiny, fate","destination"],"ipa":"/desˈti.no/","gender":"m","forms":{"plural":"destini"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q652_%28ita%29-Jennum-destino.wav","examples":[{"text":"Credi nel destino?","en":"Do you believe in destiny?","words":[{"g":"to believe","l":"credere"},{"g":"in the"},null]},{"text":"Abbiamo lo stesso destino.","en":"We have the same destiny.","words":[{"g":"to have","l":"avere"},null,null,null],"phrases":[[1,3,"all the same"]]},{"text":"Questo è il tuo destino.","en":"This is your fate.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"the"},{"g":"yours"},null]},{"text":"Lei crede nel destino?","en":"Do you believe in destiny?","words":[{"g":"she / you (formal)"},{"g":"to believe","l":"credere"},{"g":"in the"},null]},{"text":"I nostri destini sembrano essere intrecciati.","en":"Our destinies seem to be interwoven.","words":[{"g":"the","l":"la"},{"g":"our","l":"nostro"},null,{"g":"to seem","l":"sembrare"},{"g":"to be"},{"g":"to intertwine","l":"intrecciarsi"}]}]}