{"id":"aglio","lemma":"aglio","pos":"noun","rank":418,"glosses":["garlic"],"ipa":"/ˈaʎ.ʎo/","gender":"m","forms":{"plural":"agli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q652_%28ita%29-LangPao-aglio.wav","examples":[{"text":"Amo l'aglio.","en":"I love garlic.","words":[{"g":"to love, to like","l":"amare"},null,null]},{"text":"Hai chiesto agli altri?","en":"Did you ask the others?","words":[{"g":"have","l":"avere"},{"g":"to ask","l":"chiedere"},null,{"g":"other","l":"altro"}]},{"text":"Che dovremmo dire agli altri?","en":"What should we tell the others?","words":[{"g":"that / what"},{"g":"to owe","l":"dovere"},{"g":"to utter with one's…"},null,{"g":"other","l":"altro"}]},{"text":"Ti piace l'aglio?","en":"Do you like garlic?","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},null,null]},{"text":"Andiamo a dirlo agli altri.","en":"Let's go tell the others.","words":[{"g":"to go","l":"andare"},{"g":"to / at"},null,null,{"g":"other","l":"altro"}]}]}