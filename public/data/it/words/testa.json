{"id":"testa","lemma":"testa","pos":"noun","rank":194,"glosses":["head","obverse (of a coin)","head (of a bone)"],"ipa":"/ˈtɛs.ta/","gender":"f","forms":{"plural":"teste","masculine":"testone"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q652_%28ita%29-Ciampix-testa.wav","examples":[{"text":"Mi ha colpito sulla testa.","en":"He hit me on the head.","audio":"https://tatoeba.org/en/audio/download/1010077","words":[{"g":"me / myself"},{"g":"has","l":"avere"},{"g":"struck"},{"g":"plant of the genus Sulla"},null]},{"text":"È fuori di testa.","en":"He is out of his mind.","words":[{"g":"is","l":"essere"},null,null,null],"phrases":[[1,3,"out of"]]},{"text":"Dove hai la testa?","en":"Where's your head at?","words":[{"g":"where"},{"g":"have","l":"avere"},{"g":"the / her"},null]},{"text":"Ho un brutto mal di testa.","en":"I have a bad headache.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"ugly, bad, nasty"},null,{"g":"of"},null]},{"text":"Ha gli occhi dietro la testa.","en":"He has eyes at the back of his head.","words":[{"g":"has","l":"avere"},{"g":"the / to him"},{"g":"look out! watch out!","l":"occhio"},{"g":"behind"},{"g":"the / her"},null]}]}