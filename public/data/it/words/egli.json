{"id":"egli","lemma":"egli","pos":"pron","rank":1706,"glosses":["he"],"ipa":"/ˈeʎ.ʎi/","forms":{"feminine":"ella"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q652_%28ita%29-XANA000-egli.wav","examples":[{"text":"Egli ha molti soldi.","en":"He has a lot of money.","words":[null,{"g":"has","l":"avere"},{"g":"much, very much, a lot","l":"molto"},{"g":"money"}]},{"text":"Egli è un ladro.","en":"He is a thief.","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"thief, lift"}]},{"text":"Egli aveva un cane.","en":"He had a dog.","words":[null,{"g":"to have","l":"avere"},{"g":"a"},{"g":"dog"}]},{"text":"Egli conosce molte persone.","en":"He knows a lot of people.","words":[null,{"g":"to know","l":"conoscere"},{"g":"much, very much, a lot","l":"molto"},{"g":"person","l":"persona"}]},{"text":"Egli si sente molto meglio oggi.","en":"He feels a lot better today.","words":[null,{"g":"oneself"},{"g":"to feel","l":"sentire"},{"g":"very / a lot"},{"g":"better"},{"g":"today"}]}]}