{"id":"giusto","lemma":"giusto","pos":"adv","rank":147,"glosses":["just, exactly"],"ipa":"/ˈd͡ʒus.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q652_%28ita%29-LangPao-giusto.wav","examples":[{"text":"Questo è ciò che volevi, giusto?","en":"This is what you wanted, right?","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"this"},{"g":"that / what"},{"g":"to want","l":"volere"},null]},{"text":"È giusto o sbagliato?","en":"Is it right or wrong?","words":[{"g":"is","l":"essere"},null,{"g":"or"},{"g":"wrong"}]},{"text":"Questi sono tuoi, giusto?","en":"These are yours, right?","words":[{"g":"this, this one, these","l":"questo"},{"g":"am / are","l":"essere"},{"g":"\"your parents\""},null]},{"text":"Nulla sembra giusto.","en":"Nothing seems right.","words":[{"g":"nothing, anything"},{"g":"to seem","l":"sembrare"},null]},{"text":"Sembrava tutto giusto.","en":"Everything seemed right.","words":[{"g":"to seem","l":"sembrare"},{"g":"everything, all"},null]}]}