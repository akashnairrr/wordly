{"id":"agio","lemma":"agio","pos":"noun","rank":1815,"glosses":["ease, comfort","luxury, comfort"],"ipa":"/ˈa.d͡ʒo/","gender":"m","forms":{"plural":"agi"},"examples":[{"text":"Mi sento a mio agio.","en":"I feel comfortable.","words":[{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"to / at"},{"g":"mine"},null]},{"text":"Voglio vivere nell'agio.","en":"I want to live in comfort.","words":[{"g":"to want","l":"volere"},{"g":"to live"},null,null]},{"text":"Non sembri molto a tuo agio.","en":"You don't look very comfortable.","words":[{"g":"not"},{"g":"to seem","l":"sembrare"},{"g":"very / a lot"},{"g":"to / at"},{"g":"yours"},null]},{"text":"Spero che sarai a tuo agio qui.","en":"I hope you'll be comfortable here.","words":[{"g":"to hope","l":"sperare"},{"g":"that / what"},{"g":"to be","l":"essere"},{"g":"to / at"},{"g":"yours"},null,{"g":"here"}]},{"text":"Eravamo a nostro agio.","en":"We were comfortable.","words":[{"g":"to be","l":"essere"},{"g":"to / at"},{"g":"our"},null]}]}