{"id":"ingiusto","lemma":"ingiusto","pos":"adj","rank":3545,"glosses":["unjust, unfair, wrong","unjustified, underserved"],"ipa":"/inˈd͡ʒus.to/","forms":{"feminine":"ingiusta","masculinePlural":"ingiusti","femininePlural":"ingiuste"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/49/LL-Q652_%28ita%29-LangPao-ingiusto.wav","examples":[{"text":"Questo sembra ingiusto.","en":"This seems unfair.","words":[{"g":"this"},{"g":"to seem","l":"sembrare"},null]},{"text":"Sembra un po' ingiusta.","en":"It seems a bit unfair.","words":[{"g":"to seem","l":"sembrare"},{"g":"a"},null,null]},{"text":"La vita è così ingiusta.","en":"Life is so unfair.","words":[{"g":"the / her"},{"g":"life"},{"g":"is","l":"essere"},{"g":"so"},null]},{"text":"Sarebbe ingiusto.","en":"That would be unfair.","words":[{"g":"to be","l":"essere"},null]},{"text":"Siete ingiuste.","en":"You're unfair.","words":[{"g":"to be","l":"essere"},null]}]}