{"id":"rischio","lemma":"rischio","pos":"noun","rank":854,"glosses":["risk, chance, hazard, peril, danger","threat, jeopardy"],"ipa":"/ˈris.kjo/","gender":"m","forms":{"plural":"rischi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q652_%28ita%29-LangPao-rischio.wav","examples":[{"text":"Questo è un rischio serio.","en":"This is a serious risk.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"serious"}]},{"text":"Il rischio è troppo grande.","en":"The risk is too great.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"too much"},{"g":"adult, grownup"}]},{"text":"Non vale il rischio.","en":"It's not worth the risk.","words":[{"g":"not"},{"g":"to be worth","l":"valere"},{"g":"the"},null]},{"text":"Siamo tutti a rischio.","en":"We're all at risk.","words":[{"g":"to be","l":"essere"},{"g":"all"},{"g":"to / at"},null]},{"text":"Perché correre il rischio?","en":"Why take the risk?","words":[{"g":"why / because"},{"g":"to run [auxiliary…"},{"g":"the"},null]}]}