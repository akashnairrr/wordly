{"id":"silenzio","lemma":"silenzio","pos":"noun","rank":673,"glosses":["silence, quiet"],"ipa":"/siˈlɛn.t͡sjo/","gender":"m","forms":{"plural":"silenzi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q652_%28ita%29-LangPao-silenzio.wav","examples":[{"text":"Facciamo un momento di silenzio.","en":"Let's have a moment of silence.","words":[{"g":"to do","l":"fare"},{"g":"a"},{"g":"moment"},{"g":"of"},null]},{"text":"Silenzio, per piacere.","en":"Quiet, please.","words":[null,null,null],"phrases":[[1,3,"please"]]},{"text":"Hai paura del silenzio?","en":"Are you afraid of silence?","words":[{"g":"have","l":"avere"},{"g":"fear"},{"g":"of the"},null]},{"text":"Il ragazzo era in silenzio.","en":"The boy was silent.","words":[{"g":"the"},{"g":"boy, young man"},{"g":"to be","l":"essere"},{"g":"in"},null]},{"text":"Hanno rotto il silenzio.","en":"They broke the silence.","words":[{"g":"to have","l":"avere"},{"g":"broken"},{"g":"the"},null]}]}