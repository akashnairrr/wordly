{"id":"prossimo","lemma":"prossimo","pos":"adj","rank":430,"glosses":["very near, near, close","next (following in time or space)"],"ipa":"/ˈprɔs.si.mo/","forms":{"feminine":"prossima","masculinePlural":"prossimi","femininePlural":"prossime"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e5/LL-Q652_%28ita%29-LangPao-prossimo.wav","examples":[{"text":"Quanto è lontano dalla prossima città?","en":"How far is it to the next town?","words":[{"g":"how much, however much"},{"g":"is","l":"essere"},{"g":"far"},null,null,{"g":"town, city"}]},{"text":"Chi è il prossimo nella lista?","en":"Who's next on the list?","words":[{"g":"who"},{"g":"is","l":"essere"},{"g":"the"},null,{"g":"in the"},{"g":"list, pile"}]},{"text":"Chi sarà il nostro prossimo presidente?","en":"Who'll be our next president?","words":[{"g":"who"},{"g":"to be","l":"essere"},{"g":"the"},{"g":"our"},null,{"g":"president"}]},{"text":"Non ci sarà una prossima volta.","en":"There won't be a next time.","words":[{"g":"not"},{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"a","l":"uno"},null,{"g":"time"}]},{"text":"Siamo prossimi a una soluzione.","en":"We're close to a solution.","words":[{"g":"to be","l":"essere"},null,{"g":"to / at"},{"g":"a","l":"uno"},{"g":"solution"}]}]}