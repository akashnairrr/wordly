{"id":"venerdi_","lemma":"venerdì","pos":"noun","rank":2152,"glosses":["Friday"],"ipa":"/ve.nerˈdi/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q652_%28ita%29-XANA000-venerd%C3%AC.wav","examples":[{"text":"Oggi è venerdì?","en":"Is today Friday?","words":[{"g":"today"},{"g":"is","l":"essere"},null]},{"text":"Chi vuole lavorare un venerdì notte?","en":"Who wants to work on a Friday night?","words":[{"g":"who"},{"g":"to want","l":"volere"},{"g":"to work"},{"g":"a"},null,{"g":"night"}]},{"text":"Cosa farai venerdì?","en":"What will you do on Friday?","words":[{"g":"thing"},{"g":"to do","l":"fare"},null]},{"text":"Abbiamo pesce per cena ogni venerdì.","en":"We have fish for dinner every Friday.","words":[{"g":"to have","l":"avere"},{"g":"fish"},{"g":"for"},{"g":"dinner"},{"g":"each, every"},null]},{"text":"Ho un appuntamento venerdì.","en":"I have a date on Friday.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"appointment"},null]}]}