{"id":"incontro","lemma":"incontro","pos":"noun","rank":574,"glosses":["encounter, meeting","match","junction (of roads)"],"ipa":"/inˈkon.tro/","gender":"m","forms":{"plural":"incontri"},"examples":[{"text":"L'incontro è domani.","en":"The meeting is tomorrow.","words":[null,null,{"g":"is","l":"essere"},{"g":"tomorrow"}]},{"text":"Incontro persone come te ogni giorno.","en":"I meet people like you every day.","words":[null,{"g":"person","l":"persona"},{"g":"how / like"},{"g":"you, thee"},null,null],"phrases":[[4,6,"daily"]]},{"text":"La incontro una volta alla settimana.","en":"I meet her once a week.","words":[{"g":"the / her"},null,null,null,{"g":"to the"},{"g":"week"}],"phrases":[[2,4,"one time, once"]]},{"text":"Ogni volta che vado lì la incontro.","en":"Every time I go there, I meet her.","words":[{"g":"each, every"},{"g":"time"},{"g":"that / what"},{"g":"to go","l":"andare"},{"g":"there"},{"g":"the / her"},null]},{"text":"Non lo incontro così spesso.","en":"I don't meet him so often.","words":[{"g":"not"},{"g":"the / it"},null,{"g":"so"},{"g":"thick"}]}]}