{"id":"niente","lemma":"niente","pos":"pron","rank":70,"glosses":["nothing","anything"],"ipa":"/ˈnjɛn.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q652_%28ita%29-LangPao-niente.wav","examples":[{"text":"Niente è perfetto.","en":"Nothing is perfect.","words":[null,{"g":"is","l":"essere"},{"g":"perfect"}]},{"text":"Niente è davvero facile.","en":"Nothing is really easy.","words":[null,{"g":"is","l":"essere"},{"g":"really, in fact"},{"g":"easy"}]},{"text":"Niente resta lo stesso.","en":"Nothing stays the same.","words":[null,{"g":"to stay, to remain","l":"restare"},null,null],"phrases":[[2,4,"all the same"]]},{"text":"Senza aria, niente potrebbe vivere.","en":"Without air, nothing could live.","words":[{"g":"without, -less"},{"g":"air"},null,{"g":"can, could","l":"potere"},{"g":"to live"}]},{"text":"Niente sembra reale.","en":"Nothing seems real.","words":[null,{"g":"to seem","l":"sembrare"},{"g":"real"}]}]}