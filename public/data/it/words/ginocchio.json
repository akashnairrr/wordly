{"id":"ginocchio","lemma":"ginocchio","pos":"noun","rank":1578,"glosses":["knee"],"ipa":"/d͡ʒiˈnɔk.kjo/","gender":"m","forms":{"femininePlural":"ginocchia","masculinePlural":"ginocchi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q652_%28ita%29-LangPao-ginocchio.wav","examples":[{"text":"La tua mano è sul mio ginocchio.","en":"Your hand is on my knee.","words":[{"g":"the / her"},{"g":"yours","l":"tuo"},{"g":"hand"},{"g":"is","l":"essere"},null,{"g":"mine"},null]},{"text":"Vieni, siediti sulle mie ginocchia.","en":"Come, sit on my lap.","words":[{"g":"to come","l":"venire"},{"g":"to sit","l":"sedersi"},{"g":"plant of the genus Sulla","l":"sulla"},{"g":"mine","l":"mio"},null]},{"text":"Mi fa ancora male il ginocchio.","en":"My knee still hurts.","words":[{"g":"me / myself"},{"g":"to do","l":"fare"},{"g":"still / again"},{"g":"evil, harm"},{"g":"the"},null]},{"text":"Le mie ginocchia sono a posto ora.","en":"My knees are fine now.","words":[{"g":"the / to her"},{"g":"mine","l":"mio"},null,{"g":"am / are","l":"essere"},null,null,{"g":"now"}],"phrases":[[4,6,"in order"]]},{"text":"Mi sono fatto male al ginocchio.","en":"I hurt my knee.","words":[{"g":"me / myself"},{"g":"am / are","l":"essere"},{"g":"to do","l":"fare"},{"g":"evil, harm"},{"g":"to the"},null]}]}