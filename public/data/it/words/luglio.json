{"id":"luglio","lemma":"luglio","pos":"noun","rank":2628,"glosses":["July"],"ipa":"/ˈluʎ.ʎo/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8b/LL-Q652_%28ita%29-LangPao-luglio.wav","examples":[{"text":"Avrà un bambino in luglio.","en":"She's going to have a baby in July.","words":[{"g":"to have","l":"avere"},{"g":"a"},{"g":"child"},{"g":"in"},null]},{"text":"Non sono a casa da luglio.","en":"I haven't been home since July.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"to / at"},{"g":"house"},{"g":"from"},null]},{"text":"Saranno sfrattate a luglio.","en":"They will be evicted in July.","words":[{"g":"to be","l":"essere"},null,{"g":"to / at"},null]},{"text":"È nato il 28 luglio 1888.","en":"He was born on July 28th, 1888.","words":[{"g":"is","l":"essere"},{"g":"born"},{"g":"the"},null]},{"text":"Molti americani vogliono sposarsi il quattro luglio.","en":"Many Americans want to get married on the fourth of July.","words":[{"g":"much, very much, a lot","l":"molto"},{"g":"American","l":"americano"},{"g":"to want","l":"volere"},{"g":"to marry"},{"g":"the"},{"g":"four"},null]}]}