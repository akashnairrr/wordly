{"id":"degno","lemma":"degno","pos":"adj","rank":3143,"glosses":["worthy, deserving","eligible, suitable","admirable, respectable"],"ipa":"/ˈdeɲ.ɲo/","forms":{"feminine":"degna","masculinePlural":"degni","femininePlural":"degne"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q652_%28ita%29-LangPao-degno.wav","examples":[{"text":"Questo libro è degno di attenzione.","en":"This book is worthy of attention.","words":[{"g":"this"},{"g":"book"},{"g":"is","l":"essere"},null,{"g":"of"},{"g":"watch out!"}]},{"text":"Non sono degna.","en":"I'm not worthy.","words":[{"g":"not"},{"g":"am / are","l":"essere"},null]},{"text":"Il suo comportamento è degno di rispetto.","en":"His behavior is worthy of respect.","words":[{"g":"the"},{"g":"his, hers, its"},{"g":"behaviour/behavior"},{"g":"is","l":"essere"},null,{"g":"of"},{"g":"respect, deference"}]},{"text":"Siete degni di fiducia.","en":"You're trustworthy.","words":[{"g":"to be","l":"essere"},null,null,null],"phrases":[[2,4,"trusted"]]},{"text":"Ha una memoria degna di nota.","en":"He has a remarkable memory.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},{"g":"memory, recall"},null,{"g":"of"},{"g":"note"}]}]}