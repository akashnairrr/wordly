{"id":"combattuto","lemma":"combattuto","pos":"adj","rank":2229,"glosses":["embattled (troubled by battles or controversy)","uncertain, undecided, torn","hard-fought"],"ipa":"/kom.batˈtu.to/","forms":{"feminine":"combattuta","masculinePlural":"combattuti","femininePlural":"combattute"},"examples":[{"text":"Hanno combattuto fino alla fine.","en":"They fought until the end.","words":[{"g":"to have","l":"avere"},null,null,null,null],"phrases":[[2,5,"until the very end"]]},{"text":"Ho sempre combattuto per sopravvivere.","en":"I've always fought to survive.","words":[{"g":"have","l":"avere"},{"g":"always"},null,{"g":"for"},{"g":"to survive"}]},{"text":"Loro hanno combattuto il nemico.","en":"They fought against the enemy.","words":[{"g":"they"},{"g":"to have","l":"avere"},null,{"g":"the"},{"g":"enemy"}]},{"text":"Hanno combattuto per noi.","en":"They fought for us.","words":[{"g":"to have","l":"avere"},null,{"g":"for"},{"g":"we"}]},{"text":"Abbiamo combattuto duramente per la vittoria.","en":"We fought hard for victory.","words":[{"g":"to have","l":"avere"},null,{"g":"harshly"},{"g":"for"},{"g":"the / her"},{"g":"victory"}]}]}