{"id":"commissione","lemma":"commissione","pos":"noun","rank":1599,"glosses":["commission, committee, board (body of officials)","commission, fee, charge (fee)","commission (of a crime etc.)"],"ipa":"/kom.misˈsjo.ne/","gender":"f","forms":{"plural":"commissioni"},"examples":[{"text":"Ho qualche commissione.","en":"I have a few errands.","words":[{"g":"have","l":"avere"},{"g":"few"},null]},{"text":"Ho alcune commissioni da fare.","en":"I have some errands to run.","words":[{"g":"have","l":"avere"},{"g":"some, a few","l":"alcuno"},null,{"g":"from"},{"g":"to do"}]},{"text":"Il ragazzo fa spesso delle commissioni.","en":"The boy often runs errands.","words":[{"g":"the"},{"g":"boy, young man"},{"g":"to do","l":"fare"},{"g":"thick"},null,null]},{"text":"La commissione lo elesse presidente.","en":"The committee elected him chairperson.","words":[{"g":"the / her"},null,{"g":"the / it"},null,{"g":"president"}]},{"text":"Devo ancora fare delle commissioni.","en":"I still have to run errands.","words":[{"g":"to owe","l":"dovere"},{"g":"still / again"},{"g":"to do"},null,null]}]}