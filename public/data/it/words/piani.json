{"id":"piani","lemma":"piani","pos":"noun","rank":1107,"glosses":["plans (arrangements)"],"gender":"m","examples":[{"text":"Quindi quali sono i tuoi piani?","en":"So what are your plans?","words":[{"g":"so"},{"g":"what?","l":"quale"},{"g":"am / are","l":"essere"},{"g":"the","l":"la"},{"g":"\"your parents\""},null]},{"text":"Ho altri piani per te.","en":"I have other plans for you.","words":[{"g":"have","l":"avere"},{"g":"other","l":"altro"},null,{"g":"for"},{"g":"you, thee"}]},{"text":"Hai dei piani per stasera?","en":"Do you have plans for tonight?","words":[{"g":"have","l":"avere"},{"g":"some"},null,{"g":"for"},{"g":"this evening, tonight"}]},{"text":"Avete dei piani per domani sera?","en":"Do you have any plans for tomorrow evening?","words":[{"g":"to have","l":"avere"},{"g":"some"},null,{"g":"for"},{"g":"tomorrow"},{"g":"evening"}]},{"text":"La casa ha tre piani.","en":"The house has three floors.","words":[{"g":"the / her"},{"g":"house"},{"g":"has","l":"avere"},{"g":"three"},null]}]}