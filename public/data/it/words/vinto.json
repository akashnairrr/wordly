{"id":"vinto","lemma":"vinto","pos":"adj","rank":671,"glosses":["defeated, beaten"],"ipa":"/ˈvin.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/22/LL-Q652_%28ita%29-LangPao-vinto.wav/LL-Q652_%28ita%29-LangPao-vinto.wav.mp3","forms":{"feminine":"vinta","masculinePlural":"vinti","femininePlural":"vinte"},"examples":[{"text":"Le ragazze hanno vinto.","en":"The girls won.","audio":"https://tatoeba.org/en/audio/download/1000292","words":[{"g":"the / to her"},{"g":"girl, young woman","l":"ragazza"},{"g":"to have","l":"avere"},null]},{"text":"Chi ha vinto la guerra?","en":"Who won the war?","words":[{"g":"who"},{"g":"has","l":"avere"},null,{"g":"the / her"},{"g":"war, warfare"}]},{"text":"Abbiamo vinto ancora.","en":"We have won again.","words":[{"g":"to have","l":"avere"},null,{"g":"still / again"}]},{"text":"Abbiamo vinto quella guerra.","en":"We won that war.","words":[{"g":"to have","l":"avere"},null,{"g":"that one","l":"quello"},{"g":"war, warfare"}]},{"text":"Vuol sempre averla vinta.","en":"He always wants to have his own way.","words":[null,{"g":"always"},{"g":"to have","l":"avere"},null]}]}