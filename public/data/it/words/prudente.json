{"id":"prudente","lemma":"prudente","pos":"adj","rank":3471,"glosses":["prudent (sagacious in adapting means to ends)"],"ipa":"/pruˈdɛn.te/","forms":{"plural":"prudenti"},"examples":[{"text":"È molto prudente.","en":"He is very careful.","words":[{"g":"is","l":"essere"},{"g":"very / a lot"},null]},{"text":"Siate molto prudenti lì fuori.","en":"Be very careful out there.","words":[{"g":"to be","l":"essere"},{"g":"very / a lot"},null,{"g":"there"},{"g":"out, outside, outwards"}]},{"text":"Voglio essere prudente.","en":"I want to be careful.","words":[{"g":"to want","l":"volere"},{"g":"to be"},null]},{"text":"Siate prudenti con quello.","en":"Be careful with that.","words":[{"g":"to be","l":"essere"},null,{"g":"with"},{"g":"that"}]},{"text":"Non sono prudente.","en":"I'm not conservative.","audio":"https://tatoeba.org/en/audio/download/1006517","words":[{"g":"not"},{"g":"am / are","l":"essere"},null]}]}