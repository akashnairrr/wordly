{"id":"riso","lemma":"riso","pos":"noun","rank":1835,"glosses":["laughter, laugh"],"ipa":"/ˈri.zo/","gender":"m","forms":{"femininePlural":"risa"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q652_%28ita%29-XANA000-riso.wav","examples":[{"text":"Non abbiamo più riso.","en":"We have no more rice.","audio":"https://tatoeba.org/en/audio/download/1006547","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"more"},null]},{"text":"Le ragazze hanno riso tutte.","en":"The girls all laughed.","words":[{"g":"the / to her"},{"g":"girl, young woman","l":"ragazza"},{"g":"to have","l":"avere"},null,{"g":"everything, all","l":"tutto"}]},{"text":"Che tipo di riso è questo?","en":"What kind of rice is this?","words":[{"g":"that / what"},{"g":"indicating…"},{"g":"of"},null,{"g":"is","l":"essere"},{"g":"this"}]},{"text":"Qualcuno ha riso.","en":"Somebody laughed.","words":[{"g":"someone, somebody"},{"g":"has","l":"avere"},null]},{"text":"Gli studenti hanno riso tutti.","en":"The students all laughed.","words":[{"g":"the / to him"},{"g":"student","l":"studente"},{"g":"to have","l":"avere"},null,{"g":"all"}]}]}