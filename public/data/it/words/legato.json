{"id":"legato","lemma":"legato","pos":"adj","rank":1810,"glosses":["awkward, stiff","linked, connected, tied","close, attached, involved"],"ipa":"/leˈɡa.to/","forms":{"feminine":"legata","masculinePlural":"legati","femininePlural":"legate"},"examples":[{"text":"Il cane è legato?","en":"Is the dog chained?","words":[{"g":"the"},{"g":"dog"},{"g":"is","l":"essere"},null]},{"text":"Io e mio fratello erano molto legati.","en":"My brother and I were very close.","words":[{"g":"I"},{"g":"and"},{"g":"mine"},{"g":"brother, sibling"},{"g":"to be","l":"essere"},{"g":"very / a lot"},null]},{"text":"Il ladro fu legato mani e piedi.","en":"The thief was bound hand and foot.","words":[{"g":"the"},{"g":"thief, lift"},{"g":"deceased, late"},null,{"g":"manes"},{"g":"and"},{"g":"foot","l":"piede"}]},{"text":"I lacci sono legati insieme.","en":"The strings are tied together.","words":[{"g":"the","l":"la"},{"g":"lace","l":"laccio"},{"g":"am / are","l":"essere"},null,{"g":"together"}]},{"text":"Era legato all'albero con una corda.","en":"He was tied to the tree with a rope.","words":[{"g":"to be","l":"essere"},null,null,{"g":"tree"},{"g":"with"},{"g":"a","l":"uno"},{"g":"rope"}]}]}