{"id":"affidamento","lemma":"affidamento","pos":"noun","rank":3078,"glosses":["trust, confidence","reliability, dependability, trustworthiness","a bank's granting of a credit line to a customer"],"ipa":"/af.fi.daˈmen.to/","gender":"m","forms":{"plural":"affidamenti"},"examples":[{"text":"Fa sempre affidamento sugli altri.","en":"He always relies on other people.","words":[{"g":"to do","l":"fare"},{"g":"always"},null,null,{"g":"other","l":"altro"}]},{"text":"Si può fare affidamento su di lui.","en":"He can be relied on.","audio":"https://tatoeba.org/en/audio/download/1004723","words":[{"g":"oneself"},{"g":"can, could","l":"potere"},{"g":"to do"},null,{"g":"on"},{"g":"of"},{"g":"he"}]},{"text":"Abbiamo l'affidamento congiunto.","en":"We have joint custody.","words":[{"g":"to have","l":"avere"},null,null,{"g":"joined, conjoined"}]},{"text":"Puoi sempre fare affidamento su Tom.","en":"You can always count on Tom.","words":[{"g":"can, could","l":"potere"},{"g":"always"},{"g":"to do"},null,{"g":"on"},null]},{"text":"Tom è cresciuto in affidamento.","en":"Tom grew up in foster care.","words":[null,{"g":"is","l":"essere"},{"g":"grown-up"},{"g":"in"},null]}]}