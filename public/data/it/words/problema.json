{"id":"problema","lemma":"problema","pos":"noun","rank":175,"glosses":["problem","glitch, bug"],"ipa":"/proˈblɛ.ma/","gender":"m","forms":{"plural":"problemi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q652_%28ita%29-LangPao-problema.wav","examples":[{"text":"È un problema?","en":"Is it a problem?","words":[{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Ci sono alcuni problemi.","en":"There are some problems.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"some, a few","l":"alcuno"},null]},{"text":"È questo il problema?","en":"Is this the problem?","words":[{"g":"is","l":"essere"},{"g":"this"},{"g":"the"},null]},{"text":"Hai molti problemi.","en":"You have a lot of problems.","words":[{"g":"have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Quello sarà un problema?","en":"Will that be a problem?","words":[{"g":"that"},{"g":"to be","l":"essere"},{"g":"a"},null]}]}