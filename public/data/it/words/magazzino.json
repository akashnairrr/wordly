{"id":"magazzino","lemma":"magazzino","pos":"noun","rank":1598,"glosses":["warehouse, store","stock (of goods)","department store"],"ipa":"/ma.ɡadˈd͡zi.no/","gender":"m","forms":{"plural":"magazzini"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q652_%28ita%29-DivoLetto-magazzino.wav","examples":[{"text":"C'era un magazzino qui.","en":"There used to be a warehouse here.","words":[null,{"g":"to be","l":"essere"},{"g":"a"},null,{"g":"here"}]},{"text":"Il magazzino è vuoto.","en":"The warehouse is empty.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"gap"}]},{"text":"Non abbiamo quel modello in magazzino.","en":"We don't have that model in stock.","words":[{"g":"not"},{"g":"to have","l":"avere"},null,{"g":"model"},{"g":"in"},null]},{"text":"Questo grande magazzino è chiuso alle sette.","en":"This department store is closed at seven.","words":[{"g":"this"},{"g":"adult, grownup"},null,{"g":"is","l":"essere"},{"g":"closed"},null,{"g":"seven"}]},{"text":"Sei richiesta nel magazzino.","en":"You're needed in the warehouse.","words":[{"g":"are","l":"essere"},{"g":"request"},{"g":"in the"},null]}]}