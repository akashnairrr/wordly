{"id":"alzato","lemma":"alzato","pos":"adj","rank":1028,"glosses":["raised (arms)","up (out of bed)"],"ipa":"/alˈt͡sa.to/","forms":{"feminine":"alzata","masculinePlural":"alzati","femininePlural":"alzate"},"examples":[{"text":"Posso stare alzato finché voglio.","en":"I can stay up as late as I want.","words":[{"g":"can, could","l":"potere"},{"g":"to stay, remain"},null,{"g":"as long as, while"},{"g":"to want","l":"volere"}]},{"text":"Si è alzato il sole?","en":"Is the sun up?","words":[{"g":"oneself"},{"g":"is","l":"essere"},null,{"g":"the"},{"g":"sun"}]},{"text":"Perché sei alzato così presto?","en":"Why are you up so early?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,{"g":"so"},{"g":"soon"}]},{"text":"Ti sei alzato tardi?","en":"Did you get up late?","words":[{"g":"you"},{"g":"are","l":"essere"},null,{"g":"late"}]},{"text":"Stava spesso alzato fino a tardi.","en":"He often used to stay up until late at night.","words":[{"g":"to stay, remain","l":"stare"},{"g":"thick"},null,null,null,{"g":"late"}],"phrases":[[3,5,"up to"]]}]}