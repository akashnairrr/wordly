{"id":"ambiente","lemma":"ambiente","pos":"noun","rank":1753,"glosses":["environment","sphere or circle (of friends, etc.)","room"],"ipa":"/amˈbjɛn.te/","gender":"m","forms":{"plural":"ambienti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q652_%28ita%29-LangPao-ambiente.wav","examples":[{"text":"Dobbiamo provare a proteggere l'ambiente.","en":"We must try to protect the environment.","words":[{"g":"to owe","l":"dovere"},{"g":"to try"},{"g":"to / at"},{"g":"to shield or protect"},null,null]},{"text":"Il nostro ambiente di lavoro era buono.","en":"Our working environment was good.","words":[{"g":"the"},{"g":"our"},null,{"g":"of"},{"g":"work"},{"g":"to be","l":"essere"},{"g":"righteous, moral"}]},{"text":"È un ambiente ostile.","en":"It's a hostile environment.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"hostile"}]},{"text":"Ha creato un ambiente pericoloso.","en":"It created an unsafe environment.","words":[{"g":"has","l":"avere"},{"g":"creation"},{"g":"a"},null,{"g":"dangerous"}]},{"text":"L'ambiente deve essere protetto.","en":"The environment must be protected.","words":[null,null,{"g":"to owe","l":"dovere"},{"g":"to be"},{"g":"protected, sheltered"}]}]}