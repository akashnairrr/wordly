{"id":"malvagio","lemma":"malvagio","pos":"adj","rank":2899,"glosses":["wicked, malign","malicious","bad"],"ipa":"/malˈva.d͡ʒo/","forms":{"feminine":"malvagia","masculinePlural":"malvagi","femininePlural":"malvagie"},"examples":[{"text":"È un uomo malvagio.","en":"He is an evil man.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},null]},{"text":"La guerra è malvagia.","en":"War is evil.","words":[{"g":"the / her"},{"g":"war, warfare"},{"g":"is","l":"essere"},null]},{"text":"Non ha un aspetto troppo malvagio.","en":"It doesn't look too bad.","words":[{"g":"not"},{"g":"has","l":"avere"},{"g":"a"},{"g":"look"},{"g":"too much"},null]},{"text":"Voi siete malvagi.","en":"You're evil.","words":[{"g":"you (pl.)"},{"g":"to be","l":"essere"},null]},{"text":"Loro sono malvagie.","en":"They're evil.","words":[{"g":"they"},{"g":"am / are","l":"essere"},null]}]}