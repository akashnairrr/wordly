{"id":"punta","lemma":"punta","pos":"noun","rank":1588,"glosses":["point, head, tip, top, peak, end","toe (of a shoe)","pinch, touch, hint (small quantity)"],"ipa":"/ˈpun.ta/","gender":"f","forms":{"plural":"punte"},"examples":[{"text":"Ho la parola sulla punta della lingua.","en":"The word is on the tip of my tongue.","words":[{"g":"have","l":"avere"},{"g":"the / her"},{"g":"word"},{"g":"plant of the genus Sulla"},null,{"g":"of the"},{"g":"tongue"}]},{"text":"La punta della chiave si è rotta.","en":"The tip of the key broke.","words":[{"g":"the / her"},null,{"g":"of the"},{"g":"key"},{"g":"oneself"},{"g":"is","l":"essere"},{"g":"defeat, rout"}]},{"text":"Un'ape mi ha punta.","en":"A bee stung me.","words":[{"g":"a"},{"g":"bee"},{"g":"me / myself"},{"g":"has","l":"avere"},null]},{"text":"È l'ora di punta.","en":"It's rush hour.","words":[{"g":"is","l":"essere"},null,{"g":"now"},{"g":"of"},null]},{"text":"Tom ha le doppie punte.","en":"Tom has split ends.","words":[null,{"g":"has","l":"avere"},{"g":"the / to her"},{"g":"two","l":"doppio"},null]}]}