{"id":"grano","lemma":"grano","pos":"noun","rank":3368,"glosses":["wheat, corn","grain (of cereal, or small piece of something)","bead (of the rosary)"],"ipa":"/ˈɡra.no/","gender":"m","forms":{"plural":"grani"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q652_%28ita%29-XANA000-grano.wav","examples":[{"text":"Il pane è fatto con il grano.","en":"Bread is made from wheat.","words":[{"g":"the"},{"g":"bread"},{"g":"is","l":"essere"},{"g":"to do","l":"fare"},{"g":"with"},{"g":"the"},null]},{"text":"Alcune persone sono allergiche al grano.","en":"Some people are allergic to wheat.","words":[{"g":"some, a few","l":"alcuno"},{"g":"person","l":"persona"},{"g":"am / are","l":"essere"},{"g":"allergic","l":"allergico"},{"g":"to the"},null]},{"text":"Il grano è pronto per essere raccolto.","en":"The wheat is ready for harvest.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"ready, prepared"},{"g":"for"},{"g":"to be"},{"g":"thoughtful, wrapped up"}]},{"text":"I granai sono pieni di grano.","en":"The barns are full of grain.","words":[{"g":"the","l":"la"},null,{"g":"am / are","l":"essere"},{"g":"full","l":"pieno"},{"g":"of"},null]},{"text":"È un venditore di grano.","en":"He deals in grain.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"seller"},{"g":"of"},null]}]}