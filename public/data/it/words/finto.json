{"id":"finto","lemma":"finto","pos":"adj","rank":1945,"glosses":["false; fake; intended to mislead or distract","insincere; feigned","hypocritical"],"ipa":"/ˈfin.to/","forms":{"feminine":"finta","masculinePlural":"finti","femininePlural":"finte"},"examples":[{"text":"Ho finto di essere felice.","en":"I pretended to be happy.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"to be"},{"g":"happy"}]},{"text":"Ho finto che stavo dormendo.","en":"I pretended that I was sleeping.","words":[{"g":"have","l":"avere"},null,{"g":"that / what"},{"g":"to stay, remain","l":"stare"},{"g":"to sleep","l":"dormire"}]},{"text":"Loro sono finti.","en":"They're fake.","words":[{"g":"they"},{"g":"am / are","l":"essere"},null]},{"text":"Ho finto di non aver capito.","en":"I pretended I didn't understand.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"not"},null,{"g":"to understand","l":"capire"}]},{"text":"Lui ha finto di non vedermi.","en":"He pretended not to see me.","words":[{"g":"he"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"not"},null]}]}