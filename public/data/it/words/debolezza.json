{"id":"debolezza","lemma":"debolezza","pos":"noun","rank":2952,"glosses":["weakness"],"ipa":"/de.boˈlet.t͡sa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/92/LL-Q652_%28ita%29-LangPao-debolezza.wav/LL-Q652_%28ita%29-LangPao-debolezza.wav.mp3","gender":"f","forms":{"plural":"debolezze"},"examples":[{"text":"Quali sono le tue debolezze?","en":"What are your weaknesses?","words":[{"g":"what?","l":"quale"},{"g":"am / are","l":"essere"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null]},{"text":"Ho una debolezza.","en":"I have one weakness.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Tutti hanno delle debolezze.","en":"Everybody has weaknesses.","words":[{"g":"all"},{"g":"to have","l":"avere"},null,null]},{"text":"Ti stai approfittando della sua debolezza.","en":"You're taking advantage of her weakness.","words":[{"g":"you"},{"g":"to stay, remain","l":"stare"},{"g":"to make use","l":"approfittare"},{"g":"of the"},{"g":"his, hers, its","l":"suo"},null]},{"text":"È una delle mie debolezze.","en":"That's one of my weaknesses.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"mine","l":"mio"},null]}]}