{"id":"attorno","lemma":"attorno","pos":"adv","rank":1422,"glosses":["around"],"ipa":"/atˈtor.no/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/LL-Q652_%28ita%29-LangPao-attorno.wav/LL-Q652_%28ita%29-LangPao-attorno.wav.mp3","examples":[{"text":"È pericoloso giocare attorno al fuoco.","en":"It's dangerous to play around the fire.","words":[{"g":"is","l":"essere"},{"g":"dangerous"},{"g":"to play a game"},null,{"g":"to the"},{"g":"fire"}]},{"text":"Guardati attorno.","en":"Look around.","words":[{"g":"to look at oneself","l":"guardarsi"},null]},{"text":"Si guardi attorno.","en":"Look around.","words":[{"g":"oneself"},{"g":"to look at","l":"guardare"},null]},{"text":"La terra gira attorno al sole.","en":"The earth goes around the sun.","words":[null,null,{"g":"to turn","l":"girare"},null,{"g":"to the"},{"g":"sun"}],"phrases":[[0,2,"a surname"]]},{"text":"Mi sono guardato attorno.","en":"I looked around.","words":[{"g":"me / myself"},{"g":"am / are","l":"essere"},{"g":"to look at","l":"guardare"},null]}]}