{"id":"staccato","lemma":"staccato","pos":"adj","rank":3929,"glosses":["disjointed, disunited, separate","loose (pages in a book)","outdistanced"],"ipa":"/stakˈka.to/","forms":{"feminine":"staccata","masculinePlural":"staccati","femininePlural":"staccate"},"examples":[{"text":"Hai staccato il gas?","en":"Did you turn off the gas?","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"gas"}]},{"text":"È stata staccata l'acqua.","en":"The water has been cut off.","words":[{"g":"is","l":"essere"},{"g":"state","l":"stato"},null,null,{"g":"water"}]},{"text":"Hanno staccato l'acqua.","en":"The water has been cut off.","words":[{"g":"to have","l":"avere"},null,null,{"g":"water"}]},{"text":"Mi son staccato da lui sulla strada.","en":"I parted from him on the street.","words":[{"g":"me / myself"},null,null,{"g":"from"},{"g":"he"},{"g":"plant of the genus Sulla"},{"g":"road, way, street"}]},{"text":"Ha staccato il gas?","en":"Did you turn off the gas?","words":[{"g":"has","l":"avere"},null,{"g":"the"},{"g":"gas"}]}]}