{"id":"tratto","lemma":"tratto","pos":"noun","rank":1667,"glosses":["stroke, line (of a pen, etc.)","feature, trait, characteristic","stretch (of road, river, etc.)"],"ipa":"/ˈtrat.to/","gender":"m","forms":{"plural":"tratti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q652_%28ita%29-DivoLetto-tratto.wav","examples":[{"text":"Il dado è tratto.","en":"The die is cast.","words":[{"g":"the"},{"g":"die, dice"},{"g":"is","l":"essere"},null]},{"text":"Tutto ad un tratto ci fu un'esplosione.","en":"All at once there was an explosion.","words":[{"g":"everything, all"},null,{"g":"a"},null,{"g":"us / there"},{"g":"deceased, late"},{"g":"a"},{"g":"explosion"}]},{"text":"Tratto bene Tom.","en":"I treat Tom well.","words":[null,{"g":"well"},null]},{"text":"Non mi tratti come un bambino.","en":"Don't treat me like a child.","words":[{"g":"not"},{"g":"me / myself"},null,{"g":"how / like"},{"g":"a"},{"g":"child"}]},{"text":"Questo è un tratto davvero solitario di costa.","en":"This is a really lonely stretch of shoreline.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"really, in fact"},{"g":"solitary"},{"g":"of"},{"g":"to cost","l":"costare"}]}]}