{"id":"manzo","lemma":"manzo","pos":"noun","rank":3955,"glosses":["beef","ox, steer","A large, strong and uncouth man."],"ipa":"/ˈman.d͡zo/","gender":"m","forms":{"plural":"manzi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e4/LL-Q652_%28ita%29-LangPao-manzo.wav","examples":[{"text":"Questo è manzo o maiale?","en":"Is this beef or pork?","words":[{"g":"this"},{"g":"is","l":"essere"},null,{"g":"or"},{"g":"pig"}]},{"text":"Amo il manzo.","en":"I love beef.","words":[{"g":"to love, to like","l":"amare"},{"g":"the"},null]},{"text":"Voglio del manzo.","en":"I want beef.","words":[{"g":"to want","l":"volere"},{"g":"of the"},null]},{"text":"Ti piace il manzo?","en":"Do you like beef?","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the"},null]},{"text":"Questo è del manzo davvero buono.","en":"This is really good beef.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"of the"},null,{"g":"really, in fact"},{"g":"righteous, moral"}]}]}