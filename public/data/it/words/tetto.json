{"id":"tetto","lemma":"tetto","pos":"noun","rank":1195,"glosses":["roof","cap (artificial upper limit)"],"ipa":"/ˈtet.to/","gender":"m","forms":{"plural":"tetti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q652_%28ita%29-LangPao-tetto.wav","examples":[{"text":"Sarò sul tetto.","en":"I'll be up on the roof.","words":[{"g":"to be","l":"essere"},null,null]},{"text":"Il tetto è molto basso.","en":"The roof is very low.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"very / a lot"},{"g":"low"}]},{"text":"Perché eri sul tetto?","en":"Why were you on the roof?","words":[{"g":"why / because"},{"g":"to be","l":"essere"},null,null]},{"text":"Ha messo una luce sul tetto.","en":"He put a light on the roof.","words":[{"g":"has","l":"avere"},{"g":"to put","l":"mettere"},{"g":"a","l":"uno"},{"g":"light (visible…"},null,null]},{"text":"Il tetto della casa è rosso.","en":"The roof of the house is red.","words":[{"g":"the"},null,{"g":"of the"},{"g":"house"},{"g":"is","l":"essere"},{"g":"red"}]}]}