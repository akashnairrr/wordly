{"id":"punto","lemma":"punto","pos":"noun","rank":254,"glosses":["point (all senses), jot, iota","full stop, period","dot"],"ipa":"/ˈpun.to/","gender":"m","forms":{"plural":"punti"},"examples":[{"text":"Penso che sia il punto.","en":"I think that's the point.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"both ... and .."},{"g":"the"},null]},{"text":"Quello è esattamente il punto.","en":"That's exactly the point.","words":[{"g":"that"},{"g":"is","l":"essere"},{"g":"exactly"},{"g":"the"},null]},{"text":"Quindi qual è il tuo punto?","en":"So what's your point?","words":[{"g":"so"},null,{"g":"is","l":"essere"},{"g":"the"},{"g":"yours"},null]},{"text":"Era sul punto di uscire.","en":"She was on the point of going out.","words":[{"g":"to be","l":"essere"},null,null,{"g":"of"},{"g":"to go out, leave, exit"}]},{"text":"A questo punto, è arrivato.","en":"At this point, he arrived.","words":[{"g":"to / at"},{"g":"this"},null,{"g":"is","l":"essere"},{"g":"successful"}]}]}