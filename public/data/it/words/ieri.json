{"id":"ieri","lemma":"ieri","pos":"adv","rank":299,"glosses":["yesterday"],"ipa":"/ˈjɛ.ri/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q652_%28ita%29-LangPao-ieri.wav","examples":[{"text":"Grazie per ieri.","en":"Thanks for yesterday.","words":[{"g":"thanks, thank-you"},{"g":"for"},null]},{"text":"Perché sei andato lì ieri?","en":"Why did you go there yesterday?","words":[{"g":"why / because"},{"g":"are","l":"essere"},{"g":"to go","l":"andare"},{"g":"there"},null]},{"text":"Eri a scuola ieri?","en":"Were you at school yesterday?","words":[{"g":"to be","l":"essere"},{"g":"to / at"},{"g":"school"},null]},{"text":"Ieri era domenica.","en":"Yesterday was Sunday.","audio":"https://tatoeba.org/en/audio/download/1006380","words":[null,{"g":"to be","l":"essere"},{"g":"Sunday"}]},{"text":"Ieri faceva freddo.","en":"It was cold yesterday.","audio":"https://tatoeba.org/en/audio/download/1010025","words":[null,{"g":"to do","l":"fare"},{"g":"the cold"}]}]}