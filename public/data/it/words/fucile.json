{"id":"fucile","lemma":"fucile","pos":"noun","rank":1383,"glosses":["long gun, rifle"],"ipa":"/fuˈt͡ʃi.le/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/64/LL-Q652_%28ita%29-LangPao-fucile.wav/LL-Q652_%28ita%29-LangPao-fucile.wav.mp3","gender":"m","forms":{"plural":"fucili"},"examples":[{"text":"Metti giù il fucile.","en":"Put down the rifle.","words":[{"g":"to put","l":"mettere"},{"g":"down"},{"g":"the"},null]},{"text":"Hai un fucile, vero?","en":"You have a rifle, don't you?","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"true"}]},{"text":"Gli ha sparato con un fucile.","en":"She shot him with a rifle.","words":[{"g":"the / to him"},{"g":"has","l":"avere"},{"g":"the collar of a men's…"},{"g":"with"},{"g":"a"},null]},{"text":"Si sono armati di fucili.","en":"They armed themselves with rifles.","words":[{"g":"oneself"},{"g":"am / are","l":"essere"},{"g":"armed","l":"armato"},{"g":"of"},null]},{"text":"Va sempre in giro con un fucile.","en":"He always walks with a rifle.","words":[{"g":"to go","l":"andare"},{"g":"always"},null,null,{"g":"with"},{"g":"a"},null],"phrases":[[2,4,"on the go"]]}]}