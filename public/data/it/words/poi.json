{"id":"poi","lemma":"poi","pos":"adv","rank":93,"glosses":["then","later"],"ipa":"/ˈpɔj/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q652_%28ita%29-XANA000-POI.wav","examples":[{"text":"E poi che faccio?","en":"Then what do I do?","words":[{"g":"and"},null,{"g":"that / what"},{"g":"to do","l":"fare"}]},{"text":"E poi cosa succede?","en":"And then what happens?","words":[{"g":"and"},null,{"g":"thing"},{"g":"to take the place","l":"succedere"}]},{"text":"Non è poi tanto strano.","en":"It's not so strange.","words":[{"g":"not"},{"g":"is","l":"essere"},null,{"g":"so much"},{"g":"strange, odd, dodgy"}]},{"text":"Prima o poi lo faremo.","en":"Sooner or later, we'll do it.","words":[{"g":"before"},{"g":"or"},null,{"g":"the / it"},{"g":"to do","l":"fare"}]},{"text":"Poi dove andiamo?","en":"Where are we going next?","words":[null,{"g":"where"},{"g":"to go","l":"andare"}]}]}