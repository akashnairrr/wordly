{"id":"precedente","lemma":"precedente","pos":"adj","rank":766,"glosses":["preceding, previous, foregoing, earlier","former"],"ipa":"/pre.t͡ʃeˈdɛn.te/","forms":{"plural":"precedenti"},"examples":[{"text":"Avevo un appuntamento precedente.","en":"I had a previous appointment.","words":[{"g":"to have","l":"avere"},{"g":"a"},{"g":"appointment"},null]},{"text":"Questo articolo è più interessante del precedente.","en":"This article is more interesting than the previous one.","words":[{"g":"this"},{"g":"article"},{"g":"is","l":"essere"},{"g":"more"},{"g":"interesting"},{"g":"of the"},null]},{"text":"Vedi l'esempio precedente.","en":"See the example given above.","words":[{"g":"to see","l":"vedere"},null,{"g":"example"},null]},{"text":"Lo avevo comprato la settimana precedente.","en":"I'd bought it the week before.","words":[{"g":"the / it"},{"g":"to have","l":"avere"},{"g":"to buy","l":"comprare"},{"g":"the / her"},{"g":"week"},null]},{"text":"I precedenti inquilini sono stati sfrattati.","en":"The previous tenants were evicted.","words":[{"g":"the","l":"la"},null,{"g":"tenant, occupant","l":"inquilino"},{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},null]}]}