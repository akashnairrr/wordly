{"id":"matrimonio","lemma":"matrimonio","pos":"noun","rank":397,"glosses":["marriage","wedding (ceremony)"],"ipa":"/ma.triˈmɔ.njo/","gender":"m","forms":{"plural":"matrimoni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q652_%28ita%29-LangPao-matrimonio.wav","examples":[{"text":"Chiami quello matrimonio?","en":"You call that a marriage?","words":[{"g":"to call","l":"chiamare"},{"g":"that"},null]},{"text":"Abbiamo un matrimonio forte.","en":"We have a strong marriage.","words":[{"g":"to have","l":"avere"},{"g":"a"},null,{"g":"strong"}]},{"text":"Hai qualcosa contro i matrimoni?","en":"Do you have something against weddings?","words":[{"g":"have","l":"avere"},{"g":"something"},{"g":"against"},{"g":"the","l":"la"},null]},{"text":"Lei chiama quello matrimonio?","en":"You call that a marriage?","words":[{"g":"she / you (formal)"},{"g":"to call","l":"chiamare"},{"g":"that"},null]},{"text":"Il matrimonio è fuori questione.","en":"Marriage is out of the question.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"out, outside, outwards"},{"g":"question"}]}]}