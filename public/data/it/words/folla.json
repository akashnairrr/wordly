{"id":"folla","lemma":"folla","pos":"noun","rank":1948,"glosses":["crowd; mob","multitude, host"],"ipa":"/ˈfɔl.la/","gender":"f","forms":{"plural":"folle"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q652_%28ita%29-LangPao-folla.wav","formAudio":{"folle":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q652_%28ita%29-LangPao-folle.wav"},"examples":[{"text":"Mi ero perso nella folla.","en":"I was lost in the crowd.","words":[{"g":"me / myself"},{"g":"to be","l":"essere"},{"g":"lost, wasted"},{"g":"in the"},null]},{"text":"La folla fu fantastica.","en":"The crowd was fantastic.","words":[{"g":"the / her"},null,{"g":"deceased, late"},{"g":"fantastic","l":"fantastico"}]},{"text":"C'era una grande folla lì.","en":"There was a large crowd there.","words":[null,{"g":"to be","l":"essere"},{"g":"a","l":"uno"},{"g":"adult, grownup"},null,{"g":"there"}]},{"text":"È scomparso nella folla.","en":"He disappeared into the crowd.","words":[{"g":"is","l":"essere"},{"g":"lost"},{"g":"in the"},null]},{"text":"La folla sta ancora urlando.","en":"The crowd is still yelling.","words":[{"g":"the / her"},null,{"g":"to stay, remain","l":"stare"},{"g":"still / again"},{"g":"to scream, to yell","l":"urlare"}]}]}