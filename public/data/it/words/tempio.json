{"id":"tempio","lemma":"tempio","pos":"noun","rank":2249,"glosses":["temple","temple, capital, seat","the sky/heaven/paradise as a temple"],"ipa":"/ˈtem.pjo/","gender":"m","forms":{"plural":"templi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q652_%28ita%29-LangPao-tempio.wav","examples":[{"text":"Quando fu costruito questo tempio?","en":"When was this temple built?","words":[{"g":"when"},{"g":"deceased, late"},{"g":"to build, construct","l":"costruire"},{"g":"this"},null]},{"text":"Quanti anni ha questo tempio?","en":"How old is this temple?","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"has","l":"avere"},{"g":"this"},null]},{"text":"Non conosco il nome di quel tempio.","en":"I don't know the name of that temple.","words":[{"g":"not"},{"g":"to know","l":"conoscere"},{"g":"the"},{"g":"name"},{"g":"of"},null,null]},{"text":"Guarda quell'edificio. È un tempio?","en":"Look at that building. Is it a temple?","words":[{"g":"to look at","l":"guardare"},null,{"g":"building"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Distruggete questo tempio.","en":"Destroy this temple.","audio":"https://tatoeba.org/en/audio/download/1004685","words":[{"g":"to destroy","l":"distruggere"},{"g":"this"},null]}]}