{"id":"campione","lemma":"campione","pos":"noun","rank":1120,"glosses":["champion, ace, master","sample, specimen","freebie"],"ipa":"/kamˈpjo.ne/","gender":"m","forms":{"plural":"campioni","feminine":"campionessa"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-campione.wav","examples":[{"text":"Mi sento come un campione.","en":"I feel like a champion.","words":[{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"how / like"},{"g":"a"},null]},{"text":"Non siamo i campioni.","en":"We're not the champions.","words":[{"g":"not"},{"g":"to be","l":"essere"},{"g":"the","l":"la"},null]},{"text":"È una campionessa di calcio.","en":"She's a soccer champion.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"of"},{"g":"a kick"}]},{"text":"Sei il campione, non è vero?","en":"You're the champion, aren't you?","words":[{"g":"are","l":"essere"},{"g":"the"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"true"}]},{"text":"È stato il campione per tre anni.","en":"He was the champion for three years.","words":[{"g":"is","l":"essere"},{"g":"to be","l":"essere"},{"g":"the"},null,{"g":"for"},{"g":"three"},{"g":"year","l":"anno"}]}]}