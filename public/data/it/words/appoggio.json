{"id":"appoggio","lemma":"appoggio","pos":"noun","rank":3113,"glosses":["support"],"ipa":"/apˈpɔd.d͡ʒo/","gender":"m","forms":{"plural":"appoggi"},"examples":[{"text":"Appoggio quella decisione.","en":"I support that decision.","words":[null,{"g":"that one","l":"quello"},{"g":"decision"}]},{"text":"Lo appoggi contro il muro.","en":"Lean it against the wall.","words":[{"g":"the / it"},null,{"g":"against"},{"g":"the"},{"g":"wall"}]},{"text":"Abbiamo bisogno del tuo appoggio.","en":"We need your support.","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of the"},{"g":"yours"},null]},{"text":"Appoggi il libro sul tavolo.","en":"Lay the book on the table.","words":[null,{"g":"the"},{"g":"book"},null,{"g":"table, board, desk"}]},{"text":"Non si appoggi contro questo muro.","en":"Don't lean against this wall.","words":[{"g":"not"},{"g":"oneself"},null,{"g":"against"},{"g":"this"},{"g":"wall"}]}]}