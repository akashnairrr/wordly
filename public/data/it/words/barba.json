{"id":"barba","lemma":"barba","pos":"noun","rank":2004,"glosses":["beard","root, rootlet","barb"],"ipa":"/ˈbar.ba/","gender":"f","forms":{"plural":"barbe"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q652_%28ita%29-LangPao-barba.wav","examples":[{"text":"Ha la barba.","en":"He has a beard.","audio":"https://tatoeba.org/en/audio/download/1000243","words":[{"g":"has","l":"avere"},{"g":"the / her"},null]},{"text":"Amo la tua barba.","en":"I love your beard.","words":[{"g":"to love, to like","l":"amare"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Ho la barba lunga.","en":"I have a long beard.","words":[{"g":"have","l":"avere"},{"g":"the / her"},null,{"g":"long"}]},{"text":"Voglio farmi crescere la barba.","en":"I want to grow a beard.","words":[{"g":"to want","l":"volere"},null,{"g":"to grow"},{"g":"the / her"},null]},{"text":"Ti stai facendo crescere la barba?","en":"Are you growing a beard?","words":[{"g":"you"},{"g":"to stay, remain","l":"stare"},{"g":"to do","l":"fare"},{"g":"to grow"},{"g":"the / her"},null]}]}