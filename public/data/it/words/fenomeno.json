{"id":"fenomeno","lemma":"fenomeno","pos":"noun","rank":3388,"glosses":["phenomenon (all meanings)"],"ipa":"/feˈnɔ.me.no/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a1/LL-Q652_%28ita%29-LangPao-fenomeno.wav/LL-Q652_%28ita%29-LangPao-fenomeno.wav.mp3","gender":"m","forms":{"plural":"fenomeni"},"examples":[{"text":"Questo non è un fenomeno nuovo.","en":"This is not a new phenomenon.","words":[{"g":"this"},{"g":"not"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"new"}]},{"text":"Questo fenomeno non è niente di nuovo.","en":"This phenomenon is nothing new.","words":[{"g":"this"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"nothing"},null,null],"phrases":[[5,7,"goodbye"]]},{"text":"Questo fenomeno non è nulla di nuovo.","en":"This phenomenon is nothing new.","words":[{"g":"this"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"nothing, anything"},null,null],"phrases":[[5,7,"goodbye"]]},{"text":"La pioggia acida non è un fenomeno naturale.","en":"Acid rain is not a natural phenomenon.","words":[{"g":"the / her"},null,null,{"g":"not"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"natural"}],"phrases":[[1,3,"acid rain"]]},{"text":"Un arcobaleno è un fenomeno naturale.","en":"A rainbow is a natural phenomenon.","words":[{"g":"a"},{"g":"multicolored"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"natural"}]}]}