{"id":"sforzo","lemma":"sforzo","pos":"noun","rank":2467,"glosses":["effort, endeavour/endeavor","stress, strain"],"ipa":"/ˈsfɔr.t͡so/","gender":"m","forms":{"plural":"sforzi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q652_%28ita%29-LangPao-sforzo.wav","examples":[{"text":"Grazie per i tuoi sforzi.","en":"Thank you for your efforts.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the","l":"la"},{"g":"\"your parents\""},null]},{"text":"Semplicemente non ne vale lo sforzo.","en":"It's just not worth the effort.","words":[{"g":"simply, plainly, plain"},{"g":"not"},{"g":"of it"},{"g":"to be worth","l":"valere"},{"g":"the / it"},null]},{"text":"È importante che facciamo uno sforzo.","en":"It is important that we make an effort.","words":[{"g":"is","l":"essere"},{"g":"important"},{"g":"that / what"},{"g":"to do","l":"fare"},{"g":"a / one"},null]},{"text":"Apprezzo i vostri sforzi.","en":"I appreciate your efforts.","words":[{"g":"to appreciate","l":"apprezzare"},{"g":"the","l":"la"},{"g":"yours","l":"vostro"},null]},{"text":"Era uno sforzo di gruppo.","en":"It was a group effort.","words":[{"g":"to be","l":"essere"},{"g":"a / one"},null,{"g":"of"},{"g":"group"}]}]}