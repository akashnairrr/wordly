{"id":"valle","lemma":"valle","pos":"noun","rank":2704,"glosses":["valley"],"ipa":"/ˈval.le/","gender":"f","forms":{"plural":"valli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q652_%28ita%29-XANA000-Valle.wav","examples":[{"text":"Tom vive in questa valle.","en":"Tom lives in this valley.","words":[null,{"g":"to live","l":"vivere"},{"g":"in"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Un fiume scorre attraverso la valle.","en":"A river flows through the valley.","words":[{"g":"a"},{"g":"river"},{"g":"to run","l":"scorrere"},{"g":"through"},{"g":"the / her"},null]},{"text":"Ha guardato la valle sottostante.","en":"He looked down at the valley below.","words":[{"g":"has","l":"avere"},{"g":"to look at","l":"guardare"},{"g":"the / her"},null,{"g":"lower"}]},{"text":"Il fiume scorre attraverso la valle.","en":"The river runs through the valley.","words":[{"g":"the"},{"g":"river"},{"g":"to run","l":"scorrere"},{"g":"through"},{"g":"the / her"},null]},{"text":"La loro capanna è situata nella valle.","en":"Their hut is situated in the valley.","words":[{"g":"the / her"},{"g":"they"},{"g":"hut"},{"g":"is","l":"essere"},{"g":"situated","l":"situato"},{"g":"in the"},null]}]}