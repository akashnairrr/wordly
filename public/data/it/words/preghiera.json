{"id":"preghiera","lemma":"preghiera","pos":"noun","rank":2689,"glosses":["prayer","request","entreaty"],"ipa":"/preˈɡjɛ.ra/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/10/LL-Q652_%28ita%29-LangPao-preghiera.wav/LL-Q652_%28ita%29-LangPao-preghiera.wav.mp3","gender":"f","forms":{"plural":"preghiere"},"examples":[{"text":"Sono la risposta alla tua preghiera.","en":"I'm the answer to your prayer.","words":[{"g":"am / are","l":"essere"},{"g":"the / her"},{"g":"answer"},{"g":"to the"},{"g":"yours","l":"tuo"},null]},{"text":"Hai detto le tue preghiere?","en":"Did you say your prayers?","words":[{"g":"have","l":"avere"},{"g":"to utter with one's…","l":"dire"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null]},{"text":"Chi ti ha insegnato questa preghiera?","en":"Who taught you this prayer?","words":[{"g":"who"},{"g":"you"},{"g":"has","l":"avere"},{"g":"to teach","l":"insegnare"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Di' le tue preghiere prima di mangiare.","en":"Say your prayers before you eat.","words":[{"g":"of"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null,{"g":"before"},{"g":"of"},{"g":"to eat"}]},{"text":"Sono la risposta alla vostra preghiera.","en":"I'm the answer to your prayer.","words":[{"g":"am / are","l":"essere"},{"g":"the / her"},{"g":"answer"},{"g":"to the"},{"g":"yours","l":"vostro"},null]}]}