{"id":"avanzi","lemma":"avanzi","pos":"noun","rank":4896,"glosses":["leftovers"],"ipa":"/aˈvan.t͡si/","gender":"m","examples":[{"text":"Non voglio mangiare avanzi.","en":"I don't want to eat leftovers.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to eat"},null]},{"text":"Quelli sono gli avanzi del pranzo.","en":"Those are the leftovers from lunch.","words":[{"g":"Old Italian form of…"},{"g":"am / are","l":"essere"},{"g":"the / to him"},null,{"g":"of the"},{"g":"lunch or dinner"}]},{"text":"Non volevo andare degli avanzi.","en":"I didn't want to eat leftovers.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to go"},{"g":"a, an","l":"uno"},null]},{"text":"Ci sono alcuni avanzi nel frigo.","en":"There are some leftovers in the fridge.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"some, a few","l":"alcuno"},null,{"g":"in the"},{"g":"fridge, refrigerator"}]},{"text":"Ho mangiato degli avanzi per pranzo.","en":"I ate leftovers for lunch.","words":[{"g":"have","l":"avere"},{"g":"to eat","l":"mangiare"},{"g":"a, an","l":"uno"},null,{"g":"for"},{"g":"lunch or dinner"}]}]}