{"id":"villaggio","lemma":"villaggio","pos":"noun","rank":1158,"glosses":["village, hamlet"],"ipa":"/vilˈlad.d͡ʒo/","gender":"m","forms":{"plural":"villaggi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q652_%28ita%29-XANA000-Villaggio.wav","examples":[{"text":"Il villaggio ha una lunga storia.","en":"The village has a long history.","words":[{"g":"the"},null,{"g":"has","l":"avere"},{"g":"a","l":"uno"},{"g":"long"},{"g":"history"}]},{"text":"Domani vado al villaggio.","en":"I'm going to the village tomorrow.","words":[{"g":"tomorrow"},{"g":"to go","l":"andare"},{"g":"to the"},null]},{"text":"Odio questo villaggio.","en":"I hate this village.","words":[{"g":"hatred"},{"g":"this"},null]},{"text":"La gente viveva in villaggi.","en":"People lived in villages.","words":[{"g":"the / her"},null,{"g":"to live","l":"vivere"},{"g":"in"},null]},{"text":"Vengono dallo stesso villaggio.","en":"They come from the same village.","words":[{"g":"to come","l":"venire"},null,{"g":"same"},null]}]}