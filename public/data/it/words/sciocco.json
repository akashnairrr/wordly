{"id":"sciocco","lemma":"sciocco","pos":"adj","rank":1943,"glosses":["silly, foolish, stupid, daft","tasteless, insipid, saltless, unsalted"],"ipa":"/ˈʃɔk.ko/","forms":{"feminine":"sciocca","masculinePlural":"sciocchi","femininePlural":"sciocche"},"examples":[{"text":"Ho una domanda sciocca.","en":"I have a silly question.","words":[null,null,null,null],"phrases":[[0,3,"I have a question"]]},{"text":"Era un errore sciocco.","en":"That was a silly mistake.","words":[{"g":"to be","l":"essere"},{"g":"a"},{"g":"mistake"},null]},{"text":"Fa sempre delle domande sciocche.","en":"He's always asking silly questions.","words":[{"g":"to do","l":"fare"},{"g":"always"},null,{"g":"question","l":"domanda"},null]},{"text":"È così sciocco.","en":"That's so silly.","words":[{"g":"is","l":"essere"},{"g":"so"},null]},{"text":"Lo so che sembra sciocca.","en":"I know it sounds silly.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},{"g":"that / what"},{"g":"to seem","l":"sembrare"},null]}]}