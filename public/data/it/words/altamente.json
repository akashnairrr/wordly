{"id":"altamente","lemma":"altamente","pos":"adv","rank":3681,"glosses":["highly","extremely"],"ipa":"/al.taˈmen.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q652_%28ita%29-XANA000-altamente.wav","examples":[{"text":"Lo trovo altamente sospetto.","en":"I find it highly suspicious.","words":[{"g":"the / it"},{"g":"to find","l":"trovare"},null,{"g":"suspicious"}]},{"text":"Questo è altamente irregolare.","en":"This is highly irregular.","words":[{"g":"this"},{"g":"is","l":"essere"},null,{"g":"irregular"}]},{"text":"Sembra altamente improbabile.","en":"That seems highly unlikely.","words":[{"g":"to seem","l":"sembrare"},null,{"g":"improbable, unlikely"}]},{"text":"Penso che sia altamente improbabile.","en":"I think that's highly unlikely.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"both ... and .."},null,{"g":"improbable, unlikely"}]},{"text":"Quello è altamente soggettivo.","en":"That's highly subjective.","words":[{"g":"that"},{"g":"is","l":"essere"},null,{"g":"subjective"}]}]}