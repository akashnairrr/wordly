{"id":"raramente","lemma":"raramente","pos":"adv","rank":3980,"glosses":["rarely; seldom"],"ipa":"/ra.raˈmen.te/","examples":[{"text":"Questo capita raramente.","en":"This rarely happens.","words":[{"g":"this"},{"g":"to happen","l":"capitare"},null]},{"text":"Parlo raramente al telefono.","en":"I rarely talk on the phone.","words":[{"g":"to talk, to speak","l":"parlare"},null,{"g":"to the"},{"g":"telephone, phone"}]},{"text":"I miei bambini vanno fuori raramente.","en":"My children rarely go outside.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"child","l":"bambino"},{"g":"to go","l":"andare"},{"g":"out, outside, outwards"},null]},{"text":"Lo vedo raramente.","en":"I seldom see him.","audio":"https://tatoeba.org/en/audio/download/1001285","words":[{"g":"the / it"},{"g":"to see","l":"vedere"},null]},{"text":"Ascolto raramente la radio.","en":"I rarely listen to the radio.","words":[{"g":"listening"},null,{"g":"the / her"},{"g":"radius"}]}]}