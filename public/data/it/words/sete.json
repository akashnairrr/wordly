{"id":"sete","lemma":"sete","pos":"noun","rank":2209,"glosses":["thirst"],"ipa":"/ˈse.te/","gender":"f","forms":{"plural":"seti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-sete.wav","examples":[{"text":"Ho ancora sete.","en":"I'm still thirsty.","audio":"https://tatoeba.org/en/audio/download/1003285","words":[{"g":"have","l":"avere"},{"g":"still / again"},null]},{"text":"Egli aveva sete.","en":"He was thirsty.","audio":"https://tatoeba.org/en/audio/download/1000280","words":[{"g":"he"},{"g":"to have","l":"avere"},null]},{"text":"Non hai sete?","en":"Aren't you thirsty?","audio":"https://tatoeba.org/en/audio/download/1003911","words":[{"g":"not"},{"g":"have","l":"avere"},null]},{"text":"Non ho sete al momento.","en":"I'm not thirsty at the moment.","words":[{"g":"not"},{"g":"have","l":"avere"},null,null,null],"phrases":[[3,5,"at the moment"]]},{"text":"Il ragazzo ha sete.","en":"The boy is thirsty.","words":[{"g":"the"},{"g":"boy, young man"},{"g":"has","l":"avere"},null]}]}