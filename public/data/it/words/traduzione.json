{"id":"traduzione","lemma":"traduzione","pos":"noun","rank":294,"glosses":["translation"],"ipa":"/tra.du(t)ˈt͡sjo.ne/","gender":"f","forms":{"plural":"traduzioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q652_%28ita%29-DiplomaticBadger-traduzione.wav","examples":[{"text":"Grazie per la tua traduzione.","en":"Thank you for your translation.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Hai davvero talento per la traduzione.","en":"You really have a talent for translation.","words":[{"g":"have","l":"avere"},{"g":"really, in fact"},null,{"g":"for"},{"g":"the / her"},null]},{"text":"Ho bisogno di una traduzione.","en":"I need a translation.","words":[{"g":"have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a","l":"uno"},null]},{"text":"Ho preparato due traduzioni del testo.","en":"I prepared two translations of the text.","words":[{"g":"have","l":"avere"},{"g":"prepared"},{"g":"two"},null,{"g":"of the"},{"g":"text"}]},{"text":"Mi serve una traduzione.","en":"I need a translation.","words":[{"g":"me / myself"},{"g":"slave","l":"servo"},{"g":"a","l":"uno"},null]}]}