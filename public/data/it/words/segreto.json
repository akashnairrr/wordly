{"id":"segreto","lemma":"segreto","pos":"adj","rank":541,"glosses":["secret"],"ipa":"/seˈɡre.to/","forms":{"feminine":"segreta","masculinePlural":"segreti","femininePlural":"segrete"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/93/LL-Q652_%28ita%29-LangPao-segreto.wav","examples":[{"text":"Posso dirti un segreto?","en":"Can I tell you a secret?","words":[{"g":"can, could","l":"potere"},null,{"g":"a"},null]},{"text":"Abbiamo tutti i nostri segreti.","en":"We all have our secrets.","words":[{"g":"to have","l":"avere"},{"g":"all"},{"g":"the","l":"la"},{"g":"our","l":"nostro"},null]},{"text":"Questo è un segreto.","en":"This is a secret.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Sei bravo a mantenere i segreti?","en":"Are you good at keeping secrets?","words":[{"g":"are","l":"essere"},{"g":"good, well-behaved"},{"g":"to / at"},{"g":"to maintain, to keep"},{"g":"the","l":"la"},null]},{"text":"Sa il segreto.","en":"He knows the secret.","words":[{"g":"to know","l":"sapere"},{"g":"the"},null]}]}