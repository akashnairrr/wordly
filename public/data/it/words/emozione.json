{"id":"emozione","lemma":"emozione","pos":"noun","rank":1821,"glosses":["emotion","excitement"],"ipa":"/e.motˈt͡sjo.ne/","gender":"f","forms":{"plural":"emozioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q652_%28ita%29-LangPao-emozione.wav","examples":[{"text":"Controlla le tue emozioni.","en":"Control your emotions.","words":[{"g":"to check","l":"controllare"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null]},{"text":"Ha mostrato segni di grande emozione.","en":"He showed signs of great emotion.","words":[{"g":"has","l":"avere"},{"g":"to show","l":"mostrare"},{"g":"sign","l":"segno"},{"g":"of"},{"g":"adult, grownup"},null]},{"text":"Non si emozioni troppo.","en":"Don't get too excited.","words":[{"g":"not"},{"g":"oneself"},null,{"g":"too much"}]},{"text":"Non mostra le sue emozioni.","en":"He doesn't show his feelings.","words":[{"g":"not"},{"g":"exhibition, show"},null,null,null],"phrases":[[2,4,"his"]]},{"text":"Che emozione!","en":"How exciting!","words":[{"g":"that / what"},null]}]}