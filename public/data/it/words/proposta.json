{"id":"proposta","lemma":"proposta","pos":"noun","rank":1454,"glosses":["proposal"],"ipa":"/proˈpos.ta/","gender":"f","forms":{"plural":"proposte"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q652_%28ita%29-LangPao-proposta.wav","examples":[{"text":"Ho una proposta.","en":"I have a proposal.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Sono a favore della tua proposta.","en":"I am in favor of your proposal.","words":[{"g":"am / are","l":"essere"},{"g":"to / at"},{"g":"favour/favor"},{"g":"of the"},{"g":"yours","l":"tuo"},null]},{"text":"La sua proposta è fuori questione.","en":"His proposal is out of the question.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null,{"g":"is","l":"essere"},{"g":"out, outside, outwards"},{"g":"question"}]},{"text":"Hanno accettato la proposta.","en":"They accepted the proposition.","words":[{"g":"to have","l":"avere"},{"g":"to accept, to admit","l":"accettare"},{"g":"the / her"},null]},{"text":"Sei favorevole alla proposta?","en":"Are you in favor of the proposal?","words":[{"g":"are","l":"essere"},{"g":"favourable/favorable"},{"g":"to the"},null]}]}