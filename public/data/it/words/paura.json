{"id":"paura","lemma":"paura","pos":"noun","rank":222,"glosses":["fear","worry, anxiety","a (bad) feeling"],"ipa":"/paˈu.ra/","gender":"f","forms":{"plural":"paure"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q652_%28ita%29-LangPao-paura.wav","examples":[{"text":"La gente ha paura della guerra.","en":"The people fear war.","words":[{"g":"the / her"},null,{"g":"has","l":"avere"},null,{"g":"of the"},{"g":"war, warfare"}]},{"text":"Perché abbiamo paura della morte?","en":"Why do we fear death?","words":[{"g":"why / because"},{"g":"to have","l":"avere"},null,{"g":"of the"},{"g":"death"}]},{"text":"Di chi hai così paura?","en":"Who are you so afraid of?","words":[{"g":"of"},{"g":"who"},{"g":"have","l":"avere"},{"g":"so"},null]},{"text":"Perché ha paura di me?","en":"Why are you scared of me?","words":[{"g":"why / because"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"me"}]},{"text":"Non ho paura.","en":"I'm not afraid.","audio":"https://tatoeba.org/en/audio/download/1000235","words":[{"g":"not"},{"g":"have","l":"avere"},null]}]}