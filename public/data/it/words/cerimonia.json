{"id":"cerimonia","lemma":"cerimonia","pos":"noun","rank":1849,"glosses":["ceremony, ritual","service","fuss, ceremony"],"ipa":"/t͡ʃe.riˈmɔ.nja/","gender":"f","forms":{"plural":"cerimonie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q652_%28ita%29-DivoLetto-cerimonia.wav","examples":[{"text":"Era presente alla cerimonia.","en":"He was present at the ceremony.","words":[{"g":"to be","l":"essere"},{"g":"present tense"},{"g":"to the"},null]},{"text":"Prenderai parte alla cerimonia?","en":"Will you take part in the ceremony?","words":[{"g":"to take","l":"prendere"},{"g":"part"},{"g":"to the"},null]},{"text":"La cerimonia avrà luogo domani.","en":"The ceremony will take place tomorrow.","words":[{"g":"the / her"},null,{"g":"to have","l":"avere"},{"g":"place (location"},{"g":"tomorrow"}]},{"text":"Era una cerimonia molto tradizionale.","en":"It was a very traditional ceremony.","words":[{"g":"to be","l":"essere"},{"g":"a","l":"uno"},null,{"g":"very / a lot"},{"g":"traditional, customary"}]},{"text":"Non voglio partecipare alla cerimonia.","en":"I don't want to participate in the ceremony.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to take part in"},{"g":"to the"},null]}]}