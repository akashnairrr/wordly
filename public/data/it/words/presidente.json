{"id":"presidente","lemma":"presidente","pos":"noun","rank":413,"glosses":["president (head of state of a republic)","chairperson, chair (head of a corporate board)"],"ipa":"/pre.siˈdɛn.te/","gender":"mf","forms":{"plural":"presidenti","feminine":"presidentessa"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q652_%28ita%29-LangPao-presidente.wav","examples":[{"text":"Il presidente è fuori ora.","en":"The president is out now.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"out, outside, outwards"},{"g":"now"}]},{"text":"Il presidente sembrava forte.","en":"The president seemed strong.","words":[{"g":"the"},null,{"g":"to seem","l":"sembrare"},{"g":"strong"}]},{"text":"Chi sarà il nostro prossimo presidente?","en":"Who'll be our next president?","words":[{"g":"who"},{"g":"to be","l":"essere"},{"g":"the"},{"g":"our"},{"g":"very near, near, close"},null]},{"text":"È presidente solo di nome.","en":"He is the president in name only.","words":[{"g":"is","l":"essere"},null,{"g":"only, just"},null,null],"phrases":[[3,5,"in name"]]},{"text":"La elessero presidentessa.","en":"They elected her chairperson.","words":[{"g":"the / her"},null,null]}]}