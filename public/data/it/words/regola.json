{"id":"regola","lemma":"regola","pos":"noun","rank":713,"glosses":["rule, norm, code, principle, order","moderation, restraint","menstruation, period"],"ipa":"/ˈrɛ.ɡo.la/","gender":"f","forms":{"plural":"regole"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q652_%28ita%29-LangPao-regola.wav","examples":[{"text":"Conosci le regole.","en":"You know the rules.","audio":"https://tatoeba.org/en/audio/download/1004785","words":[{"g":"to know","l":"conoscere"},{"g":"the / to her"},null]},{"text":"Questa è una regola.","en":"This is a rule.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"Quali sono le regole?","en":"What are the rules?","words":[{"g":"what?","l":"quale"},{"g":"am / are","l":"essere"},{"g":"the / to her"},null]},{"text":"Capisco la regola.","en":"I understand the rule.","words":[{"g":"to understand","l":"capire"},{"g":"the / her"},null]},{"text":"Abbiamo delle regole.","en":"We have rules.","words":[{"g":"to have","l":"avere"},null,null]}]}