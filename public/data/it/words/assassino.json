{"id":"assassino","lemma":"assassino","pos":"adj","rank":548,"glosses":["murderous","demanding yet scarcely profitable (of a task)","seductive, provocative"],"ipa":"/as.sasˈsi.no/","forms":{"feminine":"assassina","masculinePlural":"assassini","femininePlural":"assassine"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q652_%28ita%29-DivoLetto-assassino.wav","examples":[{"text":"Sei un assassino.","en":"You're a murderer.","words":[{"g":"are","l":"essere"},{"g":"a"},null]},{"text":"Posso provare chi è l'assassino.","en":"I can prove who the murderer is.","words":[{"g":"can, could","l":"potere"},{"g":"to try"},{"g":"who"},{"g":"is","l":"essere"},null,null]},{"text":"Non siamo le assassine.","en":"We aren't the murderers.","words":[{"g":"not"},{"g":"to be","l":"essere"},{"g":"the / to her"},null]},{"text":"È il presunto assassino.","en":"He is allegedly the murderer.","words":[{"g":"is","l":"essere"},{"g":"the"},{"g":"to guess","l":"presumere"},null]},{"text":"L'assassino è ancora a piede libero.","en":"The murderer is still at large.","words":[null,null,{"g":"is","l":"essere"},{"g":"still / again"},null,null,null],"phrases":[[4,7,"out on bail"]]}]}