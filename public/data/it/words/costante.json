{"id":"costante","lemma":"costante","pos":"adj","rank":3273,"glosses":["constant, persistent, consistent","uniform, even","steadfast"],"ipa":"/kosˈtan.te/","forms":{"plural":"costanti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q652_%28ita%29-LangPao-costante.wav","examples":[{"text":"Sono in pericolo costante.","en":"I'm in constant danger.","words":[{"g":"am / are","l":"essere"},{"g":"in"},{"g":"peril, danger"},null]},{"text":"Io sono in pericolo costante.","en":"I'm in constant danger.","words":[{"g":"I"},{"g":"am / are","l":"essere"},{"g":"in"},{"g":"peril, danger"},null]},{"text":"Questo richiederà un lungo sforzo costante.","en":"This is going to require a long steady effort.","words":[{"g":"this"},{"g":"to ask for","l":"richiedere"},{"g":"a"},{"g":"along"},{"g":"effort"},null]},{"text":"L'unica cosa costante in questo mondo è il cambiamento.","en":"The only thing constant in this world is change.","words":[null,{"g":"only thing"},{"g":"thing"},null,{"g":"in"},{"g":"this"},{"g":"world"},{"g":"is","l":"essere"},{"g":"the"},{"g":"a change or shift"}]},{"text":"Le lingue sono soggette a cambiamenti costanti.","en":"Languages are subject to constant change.","words":[{"g":"the / to her"},{"g":"tongue","l":"lingua"},{"g":"am / are","l":"essere"},null,{"g":"to / at"},{"g":"a change or shift","l":"cambiamento"},null]}]}