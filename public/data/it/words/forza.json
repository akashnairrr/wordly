{"id":"forza","lemma":"forza","pos":"intj","rank":172,"glosses":["cheer up!","come on!","hurry up!"],"ipa":"/ˈfɔr.t͡sa/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q652_%28ita%29-XANA000-forza.wav","examples":[{"text":"Dio è la nostra forza.","en":"God is our strength.","words":[{"g":"god, deity"},{"g":"is","l":"essere"},{"g":"the / her"},{"g":"our","l":"nostro"},null]},{"text":"La musica mi dà forza.","en":"Music gives me strength.","words":[{"g":"the / her"},{"g":"music"},{"g":"me / myself"},{"g":"to give","l":"dare"},null]},{"text":"Non ho la tua forza.","en":"I don't have your strength.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Glielo prese con la forza.","en":"He took it from her by force.","words":[{"g":"it to him, her or them"},{"g":"busy","l":"preso"},{"g":"with"},{"g":"the / her"},null]},{"text":"Trova forza nella sua religione.","en":"He finds strength in his religion.","words":[{"g":"to find","l":"trovare"},null,{"g":"in the"},{"g":"his, hers, its","l":"suo"},{"g":"religion"}]}]}