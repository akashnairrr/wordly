{"id":"cerchio","lemma":"cerchio","pos":"noun","rank":987,"glosses":["circle","hoop of a barrel"],"ipa":"/ˈt͡ʃer.kjo/","gender":"m","forms":{"plural":"cerchi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-cerchio.wav","examples":[{"text":"Facciamo un grande cerchio.","en":"Let's make a big circle.","words":[{"g":"to do","l":"fare"},{"g":"a"},{"g":"adult, grownup"},null]},{"text":"Disegna un piccolo cerchio.","en":"Draw a small circle.","words":[{"g":"to draw","l":"disegnare"},{"g":"a"},{"g":"small"},null]},{"text":"Loro formarono un cerchio.","en":"They formed a circle.","words":[{"g":"they"},{"g":"to form","l":"formare"},{"g":"a"},null]},{"text":"Sedevano in cerchio.","en":"They sat in a circle.","words":[{"g":"to sit","l":"sedere"},{"g":"in"},null]},{"text":"Erano seduti in cerchio.","en":"They sat in a circle.","words":[{"g":"to be","l":"essere"},{"g":"sitting, seated","l":"seduto"},{"g":"in"},null]}]}