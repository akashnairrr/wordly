{"id":"notizia","lemma":"notizia","pos":"noun","rank":602,"glosses":["item of news","piece of information"],"ipa":"/noˈtit.t͡sja/","gender":"f","forms":{"plural":"notizie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q652_%28ita%29-LangPao-notizia.wav","examples":[{"text":"Ho delle brutte notizie.","en":"I have bad news.","audio":"https://tatoeba.org/en/audio/download/1001468","words":[{"g":"have","l":"avere"},null,{"g":"ugly, bad, nasty","l":"brutto"},null]},{"text":"Può essere vera questa notizia?","en":"Can this news be true?","words":[{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"wedding ring"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Hai sentito le notizie?","en":"Did you hear the news?","audio":"https://tatoeba.org/en/audio/download/1006418","words":[{"g":"have","l":"avere"},{"g":"sincere"},{"g":"the / to her"},null]},{"text":"Come ha preso la notizia?","en":"How did he take the news?","words":[{"g":"how / like"},{"g":"has","l":"avere"},{"g":"to take","l":"prendere"},{"g":"the / her"},null]},{"text":"Abbiamo notizie per te.","en":"We've got news for you.","words":[{"g":"to have","l":"avere"},null,{"g":"for"},{"g":"you, thee"}]}]}