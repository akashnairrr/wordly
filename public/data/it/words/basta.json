{"id":"basta","lemma":"basta","pos":"intj","rank":180,"glosses":["enough!"],"ipa":"/ˈbas.ta/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q652_%28ita%29-XANA000-basta.wav","examples":[{"text":"Perché non lo fai e basta?","en":"Why can't you just do it?","words":[{"g":"why / because"},{"g":"not"},{"g":"the / it"},{"g":"to do","l":"fare"},{"g":"and"},null]},{"text":"Ora ascolta e basta.","en":"Now just listen.","words":[{"g":"now"},{"g":"to listen to","l":"ascoltare"},{"g":"and"},null]},{"text":"Facciamo questo e basta.","en":"Let's just do this.","words":[{"g":"to do","l":"fare"},{"g":"this"},{"g":"and"},null]},{"text":"Mi dia una mano e basta.","en":"Just give me a hand.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"a","l":"uno"},{"g":"hand"},{"g":"and"},null]},{"text":"Perché non puoi essere normale e basta?","en":"Why can't you just be normal?","words":[{"g":"why / because"},{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"normal"},{"g":"and"},null]}]}