{"id":"guancia","lemma":"guancia","pos":"noun","rank":4661,"glosses":["cheek (the soft skin on each side of the face)"],"ipa":"/ˈɡwan.t͡ʃa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/LL-Q652_%28ita%29-LangPao-guancia.wav/LL-Q652_%28ita%29-LangPao-guancia.wav.mp3","gender":"f","forms":{"plural":"guance"},"examples":[{"text":"La baciò sulla guancia.","en":"He kissed her on the cheek.","words":[{"g":"the / her"},{"g":"to kiss","l":"baciare"},{"g":"plant of the genus Sulla"},null]},{"text":"Le sue guance erano rosse.","en":"Her cheeks were red.","words":[null,null,null,{"g":"to be","l":"essere"},{"g":"red","l":"rosso"}],"phrases":[[0,2,"his"]]},{"text":"L'ha baciato sulla guancia.","en":"She kissed him on the cheek.","words":[null,{"g":"has","l":"avere"},{"g":"to kiss","l":"baciare"},{"g":"plant of the genus Sulla"},null]},{"text":"Due lacrime scesero dalle sue guance.","en":"Two tears fell down her cheeks.","words":[{"g":"two"},{"g":"tear","l":"lacrima"},{"g":"to descend","l":"scendere"},null,{"g":"his, hers, its","l":"suo"},null]},{"text":"La ragazza baciò suo padre sulla guancia.","en":"The girl kissed her father on the cheek.","words":[{"g":"the / her"},{"g":"girl, young woman"},{"g":"to kiss","l":"baciare"},{"g":"his, hers, its"},{"g":"father"},{"g":"plant of the genus Sulla"},null]}]}