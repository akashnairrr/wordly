{"id":"cimitero","lemma":"cimitero","pos":"noun","rank":2446,"glosses":["cemetery, graveyard"],"ipa":"/t͡ʃi.miˈtɛ.ro/","gender":"m","forms":{"plural":"cimiteri"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q652_%28ita%29-LangPao-cimitero.wav","examples":[{"text":"La città ha tre cimiteri.","en":"The town has three cemeteries.","words":[{"g":"the / her"},{"g":"town, city"},{"g":"has","l":"avere"},{"g":"three"},null]},{"text":"Ho paura di andare vicino al cimitero.","en":"I'm scared to go near the cemetery.","words":[{"g":"have","l":"avere"},{"g":"fear"},{"g":"of"},{"g":"to go"},{"g":"near"},{"g":"to the"},null]},{"text":"Odio i cimiteri.","en":"I hate cemeteries.","words":[{"g":"hatred"},{"g":"the","l":"la"},null]},{"text":"È stato sepolto in questo cimitero.","en":"He was buried in this graveyard.","words":[{"g":"is","l":"essere"},{"g":"to be","l":"essere"},{"g":"buried"},{"g":"in"},{"g":"this"},null]},{"text":"Io odio i cimiteri.","en":"I hate cemeteries.","words":[{"g":"I"},{"g":"hatred"},{"g":"the","l":"la"},null]}]}