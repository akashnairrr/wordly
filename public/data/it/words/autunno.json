{"id":"autunno","lemma":"autunno","pos":"noun","rank":3123,"glosses":["autumn, (US) fall"],"ipa":"/awˈtun.no/","gender":"m","forms":{"plural":"autunni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q652_%28ita%29-XANA000-autunno.wav","examples":[{"text":"Amo l'autunno.","en":"I love fall.","words":[{"g":"to love, to like","l":"amare"},null,null]},{"text":"L'autunno è qui.","en":"Autumn is here.","words":[null,null,{"g":"is","l":"essere"},{"g":"here"}]},{"text":"Ti piace l'autunno?","en":"Do you like autumn?","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},null,null]},{"text":"In autunno la luna è davvero bella.","en":"In autumn, the moon is really beautiful.","words":[{"g":"in"},null,{"g":"the / her"},{"g":"a natural satellite"},{"g":"is","l":"essere"},{"g":"really, in fact"},{"g":"beauty, belle"}]},{"text":"Si sposa questo autunno.","en":"She is getting married this fall.","words":[{"g":"oneself"},{"g":"bride, wife"},{"g":"this"},null]}]}