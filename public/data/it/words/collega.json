{"id":"collega","lemma":"collega","pos":"noun","rank":1256,"glosses":["colleague"],"ipa":"/kolˈlɛ.ɡa/","gender":"mf","forms":{"masculinePlural":"colleghi","femininePlural":"colleghe"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q652_%28ita%29-LangPao-collega.wav","examples":[{"text":"Questa strada collega le due città.","en":"This road connects the two cities.","words":[{"g":"this, this one, these","l":"questo"},{"g":"road, way, street"},null,{"g":"the / to her"},{"g":"two"},{"g":"town, city"}]},{"text":"È il mio collega.","en":"He is my colleague.","words":[{"g":"is","l":"essere"},{"g":"the"},{"g":"mine"},null]},{"text":"Sarete mie colleghe.","en":"You'll be my co-workers.","words":[{"g":"to be","l":"essere"},{"g":"mine","l":"mio"},null]},{"text":"Sono un collega di Tom.","en":"I'm a colleague of Tom's.","words":[{"g":"am / are","l":"essere"},{"g":"a"},null,{"g":"of"},null]},{"text":"Il ponte collega le due città.","en":"The bridge connects the two cities.","words":[{"g":"the"},{"g":"bridge"},null,{"g":"the / to her"},{"g":"two"},{"g":"town, city"}]}]}