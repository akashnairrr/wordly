{"id":"visitatore","lemma":"visitatore","pos":"noun","rank":3998,"glosses":["visitor, caller"],"ipa":"/vi.zi.taˈto.re/","gender":"m","forms":{"plural":"visitatori","feminine":"visitatrice"},"examples":[{"text":"Hai un visitatore.","en":"You've got a visitor.","audio":"https://tatoeba.org/en/audio/download/1006514","words":[{"g":"have","l":"avere"},{"g":"a"},null]},{"text":"I nostri visitatori sono sulla porta.","en":"Our visitors are at the door.","words":[{"g":"the","l":"la"},{"g":"our","l":"nostro"},null,{"g":"am / are","l":"essere"},{"g":"plant of the genus Sulla"},{"g":"gate"}]},{"text":"Abbiamo dei visitatori.","en":"We have visitors.","words":[{"g":"to have","l":"avere"},{"g":"some"},null]},{"text":"Non voglio visitatori.","en":"I don't want visitors.","words":[{"g":"not"},{"g":"to want","l":"volere"},null]},{"text":"Dovresti preparare una stanza per il visitatore.","en":"You should prepare a room for the visitor.","words":[{"g":"to owe","l":"dovere"},{"g":"to prepare"},{"g":"a","l":"uno"},{"g":"room"},{"g":"for"},{"g":"the"},null]}]}