{"id":"scontato","lemma":"scontato","pos":"adj","rank":2882,"glosses":["discounted (price etc.)","granted"],"ipa":"/skonˈta.to/","forms":{"feminine":"scontata","masculinePlural":"scontati","femininePlural":"scontate"},"examples":[{"text":"Il prezzo può essere scontato?","en":"Can the price be discounted?","words":[{"g":"the"},{"g":"price"},{"g":"can, could","l":"potere"},{"g":"to be"},null]},{"text":"Dà tutto per scontato.","en":"She takes everything for granted.","words":[{"g":"to give","l":"dare"},{"g":"everything, all"},{"g":"for"},null]},{"text":"Prendiamo i biglietti scontati.","en":"Let's get discount tickets.","words":[{"g":"to take","l":"prendere"},{"g":"the","l":"la"},{"g":"ticket","l":"biglietto"},null]},{"text":"È una conclusione scontata.","en":"It's a foregone conclusion.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"conclusion"},null]},{"text":"Ho dato per scontato che sarebbe venuta.","en":"I took it for granted that you'd come.","words":[{"g":"have","l":"avere"},{"g":"datum"},{"g":"for"},null,{"g":"that / what"},{"g":"to be","l":"essere"},{"g":"coming, arrival"}]}]}