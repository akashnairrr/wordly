{"id":"trattato","lemma":"trattato","pos":"noun","rank":1693,"glosses":["treaty","treatise"],"ipa":"/tratˈta.to/","gender":"m","forms":{"plural":"trattati"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q652_%28ita%29-DiplomaticBadger-trattato.wav","examples":[{"text":"Lo ha trattato come un re.","en":"She treated him like a king.","words":[{"g":"the / it"},{"g":"has","l":"avere"},null,{"g":"how / like"},{"g":"a"},{"g":"king"}]},{"text":"Gli animali vengono trattati bene.","en":"The animals are treated well.","words":[{"g":"the / to him"},{"g":"animal","l":"animale"},{"g":"to come","l":"venire"},null,{"g":"well"}]},{"text":"Merito di essere trattato con rispetto.","en":"I deserve to be treated with respect.","words":[null,null,{"g":"to be"},null,{"g":"with"},{"g":"respect, deference"}],"phrases":[[0,2,"thanks to"]]},{"text":"Fu firmato un trattato.","en":"A treaty was signed.","words":[{"g":"deceased, late"},{"g":"to sign","l":"firmare"},{"g":"a"},null]},{"text":"Ci hanno trattati come persone di famiglia.","en":"They treated us like family.","words":[{"g":"us / there"},{"g":"to have","l":"avere"},null,{"g":"how / like"},{"g":"person","l":"persona"},{"g":"of"},{"g":"family"}]}]}