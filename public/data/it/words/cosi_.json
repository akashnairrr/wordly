{"id":"cosi_","lemma":"così","pos":"adv","rank":76,"glosses":["so","like this/that","thus"],"ipa":"/koˈzi/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q652_%28ita%29-XANA000-cos%C3%AC.wav","examples":[{"text":"Perché sei così felice?","en":"Why are you so happy?","audio":"https://tatoeba.org/en/audio/download/1006427","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,{"g":"happy"}]},{"text":"Chi la pensa così?","en":"Who thinks so?","audio":"https://tatoeba.org/en/audio/download/1000271","words":[{"g":"who"},{"g":"the / her"},{"g":"to think","l":"pensare"},null]},{"text":"Sono così diverso?","en":"Am I so different?","words":[{"g":"am / are","l":"essere"},null,{"g":"different, diverse"}]},{"text":"Non è così.","en":"It is not so.","words":[{"g":"not"},{"g":"is","l":"essere"},null]},{"text":"Questo è così facile.","en":"This is so easy.","words":[{"g":"this"},{"g":"is","l":"essere"},null,{"g":"easy"}]}]}