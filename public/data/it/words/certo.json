{"id":"certo","lemma":"certo","pos":"adj","rank":91,"glosses":["certain, sure","reliable","real, true"],"ipa":"/ˈt͡ʃɛr.to/","forms":{"feminine":"certa","masculinePlural":"certi","femininePlural":"certe"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q652_%28ita%29-XANA000-certo.wav","formAudio":{"certa":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q652_%28ita%29-XANA000-certa.wav","certi":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q652_%28ita%29-XANA000-certi.wav","certe":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q652_%28ita%29-XANA000-certe.wav"},"examples":[{"text":"Lo so per certo.","en":"I know it for sure.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},{"g":"for"},null]},{"text":"Sono certa del tuo successo.","en":"I'm certain of your success.","words":[{"g":"am / are","l":"essere"},null,{"g":"of the"},{"g":"yours"},{"g":"success"}]},{"text":"\"Posso entrare?\" \"Sì, certo.\"","en":"\"May I come in?\" \"Yes, certainly.\"","words":[{"g":"can, could","l":"potere"},{"g":"to enter, to go in"},{"g":"yes"},null]},{"text":"È vero in un certo senso.","en":"It is true in a sense.","words":[{"g":"is","l":"essere"},{"g":"true"},{"g":"in"},{"g":"a"},null,{"g":"sense"}]},{"text":"Quella canzone mi ricorda una certa ragazza.","en":"That song reminds me of a certain girl.","words":[{"g":"that one","l":"quello"},{"g":"song"},{"g":"me / myself"},{"g":"to remember","l":"ricordare"},{"g":"a","l":"uno"},null,{"g":"girl, young woman"}]}]}