{"id":"adesso","lemma":"adesso","pos":"adv","rank":110,"glosses":["now"],"ipa":"/aˈdɛs.so/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q652_%28ita%29-XANA000-adesso.wav","examples":[{"text":"Dove sono adesso?","en":"Where am I now?","audio":"https://tatoeba.org/en/audio/download/1000286","words":[{"g":"where"},{"g":"am / are","l":"essere"},null]},{"text":"Posso parlare adesso?","en":"Can I talk now?","words":[{"g":"can, could","l":"potere"},{"g":"to talk, to speak"},null]},{"text":"È sicuro adesso?","en":"Is it safe now?","words":[{"g":"is","l":"essere"},{"g":"safe"},null]},{"text":"Adesso non puoi andare.","en":"You can't go now.","audio":"https://tatoeba.org/en/audio/download/1003332","words":[null,{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to go"}]},{"text":"Vieni fuori adesso.","en":"Come out now.","words":[{"g":"to come","l":"venire"},{"g":"out, outside, outwards"},null]}]}