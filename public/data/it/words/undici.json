{"id":"undici","lemma":"undici","pos":"num","rank":2557,"glosses":["eleven"],"ipa":"/ˈun.di.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q652_%28ita%29-XANA000-undici.wav","examples":[{"text":"Vado a letto alle undici.","en":"I go to bed at eleven.","words":[{"g":"to go","l":"andare"},null,null,null,null],"phrases":[[1,3,"in bed"]]},{"text":"Undici è un numero primo.","en":"Eleven is a prime number.","words":[null,{"g":"is","l":"essere"},{"g":"a"},null,null],"phrases":[[3,5,"prime number"]]},{"text":"Studio dalle otto alle undici.","en":"I study from eight to eleven.","words":[{"g":"study"},null,{"g":"eight"},null,null]},{"text":"Sono già le undici.","en":"It's already eleven.","words":[{"g":"am / are","l":"essere"},{"g":"already"},{"g":"the / to her"},null]},{"text":"Questa casa ha undici stanze.","en":"This house has eleven rooms.","words":[{"g":"this, this one, these","l":"questo"},{"g":"house"},{"g":"has","l":"avere"},null,{"g":"room","l":"stanza"}]}]}