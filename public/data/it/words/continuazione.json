{"id":"continuazione","lemma":"continuazione","pos":"noun","rank":3071,"glosses":["continuation, sequel"],"ipa":"/kon.ti.nu.atˈt͡sjo.ne/","gender":"f","forms":{"plural":"continuazioni"},"examples":[{"text":"Questa roba succede in continuazione.","en":"This stuff happens all the time.","words":[{"g":"this, this one, these","l":"questo"},{"g":"things, stuff"},{"g":"to take the place","l":"succedere"},{"g":"in"},null]},{"text":"Le ragazze lo dicono in continuazione.","en":"Girls say that all the time.","words":[{"g":"the / to her"},{"g":"girl, young woman","l":"ragazza"},{"g":"the / it"},{"g":"to utter with one's…","l":"dire"},{"g":"in"},null]},{"text":"Ne parliamo in continuazione.","en":"We talk about it all the time.","words":[{"g":"of it"},{"g":"to talk, to speak","l":"parlare"},{"g":"in"},null]},{"text":"Loro parlano in continuazione.","en":"They talk all the time.","words":[{"g":"they"},{"g":"to talk, to speak","l":"parlare"},{"g":"in"},null]},{"text":"Io penso a lui in continuazione.","en":"I think about him all the time.","words":[{"g":"I"},{"g":"to think","l":"pensare"},{"g":"to / at"},{"g":"he"},{"g":"in"},null]}]}