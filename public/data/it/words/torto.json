{"id":"torto","lemma":"torto","pos":"adj","rank":1965,"glosses":["twisted, bent, crooked"],"ipa":"/ˈtɔr.to/","forms":{"feminine":"torta","masculinePlural":"torti","femininePlural":"torte"},"formAudio":{"torta":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q652_%28ita%29-LangPao-torta.wav"},"examples":[{"text":"Chi aveva torto?","en":"Who was wrong?","words":[{"g":"who"},{"g":"to have","l":"avere"},null]},{"text":"Devi ammettere che sei nel torto.","en":"You must admit that you are in the wrong.","words":[{"g":"to owe","l":"dovere"},{"g":"to admit"},{"g":"that / what"},{"g":"are","l":"essere"},{"g":"in the"},null]},{"text":"Forse non hai tutti i torti.","en":"Maybe you have a point.","words":[{"g":"maybe"},{"g":"not"},{"g":"have","l":"avere"},{"g":"all"},{"g":"the","l":"la"},null]},{"text":"Due torti non fanno una ragione.","en":"Two wrongs don't make a right.","words":[{"g":"two"},null,{"g":"not"},{"g":"to do","l":"fare"},{"g":"a","l":"uno"},{"g":"reason, intellect"}]},{"text":"Hai torto in questo caso.","en":"You're wrong in this case.","words":[{"g":"have","l":"avere"},null,{"g":"in"},{"g":"this"},{"g":"chance, fate"}]}]}