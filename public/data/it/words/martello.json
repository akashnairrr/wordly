{"id":"martello","lemma":"martello","pos":"noun","rank":2870,"glosses":["hammer","malleus, hammer","gavel (tool)"],"ipa":"/marˈtɛl.lo/","gender":"m","forms":{"plural":"martelli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q652_%28ita%29-LangPao-martello.wav","examples":[{"text":"Perché ti serve un martello?","en":"Why do you need a hammer?","words":[{"g":"why / because"},{"g":"you"},{"g":"slave","l":"servo"},{"g":"a"},null]},{"text":"Dove ho messo il martello?","en":"Where did I put the hammer?","words":[{"g":"where"},{"g":"have","l":"avere"},{"g":"to put","l":"mettere"},{"g":"the"},null]},{"text":"Mi dia un martello.","en":"Give me a hammer.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"a"},null]},{"text":"Perché hai bisogno di un martello?","en":"Why do you need a hammer?","words":[{"g":"why / because"},{"g":"have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a"},null]},{"text":"Non posso farlo senza un martello.","en":"I can't do it without a hammer.","words":[{"g":"not"},{"g":"can, could","l":"potere"},null,{"g":"without, -less"},{"g":"a"},null]}]}