{"id":"instabile","lemma":"instabile","pos":"adj","rank":3636,"glosses":["unstable, unsteady, precarious, unreliable","changeable, unsettled","rocky, shaky"],"ipa":"/insˈta.bi.le/","forms":{"plural":"instabili"},"examples":[{"text":"È troppo instabile.","en":"It's too unstable.","words":[{"g":"is","l":"essere"},{"g":"too much"},null]},{"text":"Mi sto sentendo molto instabile.","en":"I'm feeling very shaky.","words":[{"g":"me / myself"},{"g":"to stay, remain","l":"stare"},{"g":"to feel","l":"sentire"},{"g":"very / a lot"},null]},{"text":"Penso che Tom sia instabile.","en":"I think Tom is unstable.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},null,{"g":"both ... and .."},null]},{"text":"L'antimateria è altamente instabile.","en":"Antimatter is highly unstable.","words":[null,{"g":"antimatter"},{"g":"is","l":"essere"},{"g":"highly"},null]},{"text":"Tom è instabile, vero?","en":"Tom is temperamental, isn't he?","words":[null,{"g":"is","l":"essere"},null,{"g":"true"}]}]}