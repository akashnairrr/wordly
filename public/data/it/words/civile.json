{"id":"civile","lemma":"civile","pos":"adj","rank":1823,"glosses":["civil","civilian","civilized, polite"],"ipa":"/t͡ʃiˈvi.le/","forms":{"plural":"civili"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q652_%28ita%29-DivoLetto-civile.wav","examples":[{"text":"Sono un civile.","en":"I'm a civilian.","words":[{"g":"am / are","l":"essere"},{"g":"a"},null]},{"text":"Alcuni civili sono stati uccisi.","en":"Some civilians were killed.","words":[{"g":"some, a few","l":"alcuno"},null,{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},{"g":"to kill","l":"uccidere"}]},{"text":"Tieni un tono civile.","en":"Keep a civil tone.","words":[{"g":"to hold","l":"tenere"},{"g":"a"},{"g":"tone"},null]},{"text":"Tre civili furono feriti.","en":"Three civilians were wounded.","words":[{"g":"three"},null,{"g":"to be","l":"essere"},{"g":"a wounded or injured…","l":"ferito"}]},{"text":"Quanti civili sono stati uccisi o feriti?","en":"How many civilians have been killed or wounded?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},{"g":"to kill","l":"uccidere"},{"g":"or"},{"g":"a wounded or injured…","l":"ferito"}]}]}