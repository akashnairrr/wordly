{"id":"indiano","lemma":"indiano","pos":"adj","rank":2797,"glosses":["Indian (of, from or relating to India)","Indian (relating to Native Americans)"],"ipa":"/inˈdja.no/","forms":{"feminine":"indiana","masculinePlural":"indiani","femininePlural":"indiane"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q652_%28ita%29-LangPao-indiano.wav","examples":[{"text":"Hai mai mangiato cibo indiano?","en":"Have you ever eaten Indian food?","words":[{"g":"have","l":"avere"},{"g":"never"},{"g":"to eat","l":"mangiare"},{"g":"food"},null]},{"text":"Sembra un'indiana.","en":"She looks like an Indian.","words":[{"g":"to seem","l":"sembrare"},{"g":"a"},null]},{"text":"Mi piace il cibo indiano.","en":"I like Indian food.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the"},{"g":"food"},null]},{"text":"Gli indiani non erano felici di questo accordo.","en":"The Indians were not happy with this agreement.","words":[{"g":"the / to him"},null,{"g":"not"},{"g":"to be","l":"essere"},{"g":"happy","l":"felice"},{"g":"of"},{"g":"this"},{"g":"accord"}]},{"text":"Mio nonno era in parte indiano.","en":"My grandfather was part Indian.","words":[{"g":"mine"},{"g":"grandfather"},{"g":"to be","l":"essere"},null,null,null],"phrases":[[3,5,"in part, partly, part"]]}]}