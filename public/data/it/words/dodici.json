{"id":"dodici","lemma":"dodici","pos":"num","rank":1778,"glosses":["twelve"],"ipa":"/ˈdo.di.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q652_%28ita%29-XANA000-dodici.wav","examples":[{"text":"Un anno ha dodici mesi.","en":"A year has twelve months.","words":[{"g":"a"},{"g":"year"},{"g":"has","l":"avere"},null,{"g":"month","l":"mese"}]},{"text":"\"Quanti anni ha?\" \"Ha dodici anni.\"","en":"\"How old is she?\" \"She is twelve years old.\"","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"has","l":"avere"},{"g":"has","l":"avere"},null,{"g":"year","l":"anno"}]},{"text":"Hanno dodici figli.","en":"They have twelve children.","words":[{"g":"to have","l":"avere"},null,{"g":"son","l":"figlio"}]},{"text":"A dodici anni un cane è vecchio.","en":"Twelve years old is old for a dog.","words":[{"g":"to / at"},null,{"g":"year","l":"anno"},{"g":"a"},{"g":"dog"},{"g":"is","l":"essere"},{"g":"old, outworn"}]},{"text":"Dodici anni sono tanti per un cane.","en":"Twelve years is old for a dog.","words":[null,{"g":"year","l":"anno"},{"g":"am / are","l":"essere"},{"g":"so much","l":"tanto"},{"g":"for"},{"g":"a"},{"g":"dog"}]}]}