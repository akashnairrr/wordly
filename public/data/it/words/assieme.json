{"id":"assieme","lemma":"assieme","pos":"adv","rank":1355,"glosses":["together; along"],"ipa":"/asˈsjɛ.me/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q652_%28ita%29-XANA000-assieme.wav","examples":[{"text":"Volete andare assieme?","en":"Do you want to go together?","words":[{"g":"to want","l":"volere"},{"g":"to go"},null]},{"text":"Lo faremo assieme.","en":"We'll do it together.","words":[{"g":"the / it"},{"g":"to do","l":"fare"},null]},{"text":"Andiamo tutti assieme.","en":"Let's all go together.","words":[{"g":"to go","l":"andare"},{"g":"all"},null]},{"text":"Facciamo questo assieme.","en":"Let's do this together.","words":[{"g":"to do","l":"fare"},{"g":"this"},null]},{"text":"Ora possiamo essere assieme.","en":"Now we can be together.","words":[{"g":"now"},null,{"g":"to be"},null]}]}