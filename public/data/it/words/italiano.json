{"id":"italiano","lemma":"italiano","pos":"adj","rank":2153,"glosses":["Italian (of, from or relating to Italy)"],"ipa":"/i.taˈlja.no/","forms":{"feminine":"italiana","masculinePlural":"italiani","femininePlural":"italiane"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q652_%28ita%29-XANA000-italiano.wav","formAudio":{"italiana":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q652_%28ita%29-XANA000-italiana.wav","italiani":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q652_%28ita%29-XANA000-Italiani.wav"},"examples":[{"text":"Sua madre parla italiano.","en":"His mother speaks Italian.","words":[{"g":"his, hers, its","l":"suo"},{"g":"mother"},{"g":"to talk, to speak","l":"parlare"},null]},{"text":"Conosco un buon ristorante italiano.","en":"I know a good Italian restaurant.","words":[{"g":"to know","l":"conoscere"},{"g":"a"},null,{"g":"restaurant"},null]},{"text":"Amo il cibo italiano.","en":"I love Italian food.","words":[{"g":"to love, to like","l":"amare"},{"g":"the"},{"g":"food"},null]},{"text":"La pasta italiana è buona.","en":"Italian pasta is good.","words":[{"g":"the / her"},{"g":"paste"},null,{"g":"is","l":"essere"},{"g":"righteous, moral","l":"buono"}]},{"text":"Come si dice questo in italiano?","en":"How do you say that in Italian?","words":[{"g":"how / like"},{"g":"oneself"},{"g":"to utter with one's…","l":"dire"},{"g":"this"},{"g":"in"},null]}]}