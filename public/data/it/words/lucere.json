{"id":"lucere","lemma":"lucere","pos":"verb","rank":1183,"glosses":["to shine","to stand out, to be resplendent (due to fame, honor, beauty, etc.)"],"ipa":"/ˈlu.t͡ʃe.re/","conjugation":{"indicative":{"present":{"3s":"luce","3p":"lucono"},"imperfect":{"3s":"luceva","3p":"lucevano"}},"subjunctive":{"imperfect":{"3s":"lucesse","3p":"lucessero"}}},"nonFinite":{"gerund":"lucendo"},"formAudio":{"luce":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q652_%28ita%29-LangPao-luce.wav"},"examples":[{"text":"Posso vedere la luce.","en":"I can see the light.","audio":"https://tatoeba.org/en/audio/download/1004702","words":[{"g":"can, could","l":"potere"},{"g":"to see"},{"g":"the / her"},null]},{"text":"Vedo una luce.","en":"I see a light.","words":[{"g":"to see","l":"vedere"},{"g":"a","l":"uno"},null]},{"text":"La luce è rossa.","en":"The light is red.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"red","l":"rosso"}]},{"text":"La luce non funziona.","en":"The light doesn't work.","words":[{"g":"the / her"},null,{"g":"not"},{"g":"to function, to work","l":"funzionare"}]},{"text":"Ha messo una luce sul tetto.","en":"He put a light on the roof.","words":[{"g":"has","l":"avere"},{"g":"to put","l":"mettere"},{"g":"a","l":"uno"},null,null,{"g":"roof"}]}]}