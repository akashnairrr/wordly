{"id":"prego","lemma":"prego","pos":"intj","rank":155,"glosses":["you're welcome, don't mention it etc.","yes, of course","after you, please, you first"],"ipa":"/ˈprɛ.ɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q652_%28ita%29-XANA000-prego.wav","examples":[{"text":"Prego per un futuro migliore.","en":"I pray for a better future.","words":[null,{"g":"for"},{"g":"a"},{"g":"future"},{"g":"better"}]},{"text":"Prego ogni notte.","en":"I pray every night.","words":[null,{"g":"each, every"},{"g":"night"}]},{"text":"\"Grazie.\" \"Prego.\"","en":"\"Thanks.\" \"You're welcome.\"","words":[{"g":"thanks, thank-you"},null]},{"text":"Ti prego, non piangere.","en":"Please don't cry.","audio":"https://tatoeba.org/en/audio/download/1001282","words":[{"g":"you"},null,{"g":"not"},{"g":"to weep, cry"}]},{"text":"È quello per cui prego.","en":"That's what I pray for.","words":[{"g":"is","l":"essere"},{"g":"that"},null,null,null],"phrases":[[2,4,"so"]]}]}