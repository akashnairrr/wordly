{"id":"festa","lemma":"festa","pos":"noun","rank":335,"glosses":["feast","holiday (civil)","holidays (British), vacation (US)"],"ipa":"/ˈfɛs.ta/","gender":"f","forms":{"plural":"feste"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q652_%28ita%29-LangPao-festa.wav","examples":[{"text":"Domani è festa.","en":"Tomorrow is a holiday.","audio":"https://tatoeba.org/en/audio/download/1009983","words":[{"g":"tomorrow"},{"g":"is","l":"essere"},null]},{"text":"Ci sarà una festa stasera?","en":"Is there going to be a party tonight?","words":[{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"a","l":"uno"},null,{"g":"this evening, tonight"}]},{"text":"È vero che odia le feste?","en":"Is it true that you hate parties?","words":[{"g":"is","l":"essere"},{"g":"true"},{"g":"that / what"},{"g":"to hate","l":"odiare"},{"g":"the / to her"},null]},{"text":"Puoi venire alla festa?","en":"Can you come to the party?","words":[{"g":"can, could","l":"potere"},{"g":"to come"},{"g":"to the"},null]},{"text":"Mi piacciono sempre le feste.","en":"I always enjoy parties.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"always"},{"g":"the / to her"},null]}]}