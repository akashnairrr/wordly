{"id":"fabbrica","lemma":"fabbrica","pos":"noun","rank":1695,"glosses":["factory, plant"],"ipa":"/ˈfab.bri.ka/","gender":"f","forms":{"plural":"fabbriche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q652_%28ita%29-LangPao-fabbrica.wav","examples":[{"text":"Lavoro in una fabbrica.","en":"I work in a factory.","words":[{"g":"work"},{"g":"in"},{"g":"a","l":"uno"},null]},{"text":"La fabbrica ha chiuso ieri.","en":"The factory closed yesterday.","words":[{"g":"the / her"},null,{"g":"has","l":"avere"},{"g":"closed"},{"g":"yesterday"}]},{"text":"Hanno aperto molte nuove fabbriche.","en":"Many new factories have opened.","words":[{"g":"to have","l":"avere"},{"g":"open"},{"g":"much, very much, a lot","l":"molto"},{"g":"new","l":"nuovo"},null]},{"text":"Lui vuole lavorare in una fabbrica.","en":"He wants to work in a factory.","words":[{"g":"he"},{"g":"to want","l":"volere"},{"g":"to work"},{"g":"in"},{"g":"a","l":"uno"},null]},{"text":"Odio le fabbriche.","en":"I hate factories.","words":[{"g":"hatred"},{"g":"the / to her"},null]}]}