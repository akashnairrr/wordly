{"id":"maniera","lemma":"maniera","pos":"noun","rank":1384,"glosses":["manner, way","style","manners"],"ipa":"/maˈnjɛ.ra/","gender":"f","forms":{"plural":"maniere"},"examples":[{"text":"Tutti la pensano alla stessa maniera.","en":"Everyone thinks the same way.","words":[{"g":"all"},{"g":"the / her"},{"g":"to think","l":"pensare"},{"g":"to the"},{"g":"same","l":"stesso"},null]},{"text":"Perché stai parlando in maniera così divertente?","en":"Why are you talking so funny?","words":[{"g":"why / because"},{"g":"to stay, remain","l":"stare"},{"g":"to talk, to speak","l":"parlare"},{"g":"in"},null,{"g":"so"},{"g":"funny"}]},{"text":"Qualsiasi maniera mi va bene.","en":"Either way's fine with me.","words":[{"g":"any"},null,{"g":"me / myself"},null,null],"phrases":[[3,5,"ok!, okay!, all right!"]]},{"text":"L'ho fatto alla vecchia maniera.","en":"I did it the old fashioned way.","words":[null,{"g":"have","l":"avere"},{"g":"to do","l":"fare"},{"g":"to the"},{"g":"an old woman"},null]},{"text":"Io mi sentivo alla stessa maniera.","en":"I felt the same way.","words":[{"g":"I"},{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"to the"},{"g":"same","l":"stesso"},null]}]}