{"id":"chiuso","lemma":"chiuso","pos":"adj","rank":609,"glosses":["closed"],"ipa":"/ˈkju.zo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4c/LL-Q652_%28ita%29-LangPao-chiuso.wav/LL-Q652_%28ita%29-LangPao-chiuso.wav.mp3","forms":{"feminine":"chiusa","masculinePlural":"chiusi","femininePlural":"chiuse"},"examples":[{"text":"Il caso è chiuso.","en":"The case is closed.","audio":"https://tatoeba.org/en/audio/download/1003998","words":[{"g":"the"},{"g":"chance, fate"},{"g":"is","l":"essere"},null]},{"text":"Mi sono chiuso fuori.","en":"I locked myself out.","audio":"https://tatoeba.org/en/audio/download/1004712","words":[{"g":"me / myself"},{"g":"am / are","l":"essere"},null,{"g":"out, outside, outwards"}]},{"text":"Il negozio sarà chiuso domani.","en":"The store will be closed tomorrow.","words":[{"g":"the"},{"g":"shop, a store"},{"g":"to be","l":"essere"},null,{"g":"tomorrow"}]},{"text":"Ho chiuso il libro.","en":"I closed the book.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"book"}]},{"text":"Chi ha chiuso la porta?","en":"Who closed the door?","words":[{"g":"who"},{"g":"has","l":"avere"},null,null,null],"phrases":[[3,5,"a surname"]]}]}