{"id":"caldo","lemma":"caldo","pos":"noun","rank":808,"glosses":["heat","fervour, ardour"],"ipa":"/ˈkal.do/","gender":"m","forms":{"plural":"caldi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q652_%28ita%29-LangPao-caldo.wav","examples":[{"text":"Il caldo è terribile oggi.","en":"The heat is terrible today.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"terrible"},{"g":"today"}]},{"text":"Oggi fa molto caldo.","en":"Today is very warm.","audio":"https://tatoeba.org/en/audio/download/1004694","words":[{"g":"today"},{"g":"to do","l":"fare"},{"g":"very / a lot"},null]},{"text":"I miei piedi sono caldi.","en":"My feet are warm.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"foot","l":"piede"},{"g":"am / are","l":"essere"},null]},{"text":"Fa sempre così caldo qui?","en":"Is it always so hot here?","words":[{"g":"to do","l":"fare"},{"g":"always"},{"g":"so"},null,{"g":"here"}]},{"text":"Avete degli asciugamani caldi?","en":"Do you have hot towels?","audio":"https://tatoeba.org/en/audio/download/1010081","words":[{"g":"to have","l":"avere"},{"g":"a, an","l":"uno"},{"g":"hand towel","l":"asciugamano"},null]}]}