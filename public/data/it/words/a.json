{"id":"a","lemma":"a","pos":"prep","rank":7,"glosses":["to, at"],"ipa":"/a/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q652_%28ita%29-XANA000-A.wav","examples":[{"text":"Studio a scuola.","en":"I study at school.","audio":"https://tatoeba.org/en/audio/download/1003193","words":[{"g":"study"},null,{"g":"school"}]},{"text":"Sei ancora a scuola?","en":"Are you still at school?","words":[{"g":"are","l":"essere"},{"g":"still / again"},null,{"g":"school"}]},{"text":"I bambini sono a scuola?","en":"Are the children at school?","words":[{"g":"the","l":"la"},{"g":"child","l":"bambino"},{"g":"am / are","l":"essere"},null,{"g":"school"}]},{"text":"Perché sei così bravo a farlo?","en":"Why are you so good at doing that?","words":[{"g":"why / because"},{"g":"are","l":"essere"},{"g":"so"},{"g":"good, well-behaved"},null,null]},{"text":"Penso a te.","en":"I'm thinking of you.","audio":"https://tatoeba.org/en/audio/download/1004704","words":[{"g":"to think","l":"pensare"},null,{"g":"you, thee"}]}]}