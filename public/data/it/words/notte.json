{"id":"notte","lemma":"notte","pos":"noun","rank":193,"glosses":["night"],"ipa":"/ˈnɔt.te/","gender":"f","forms":{"plural":"notti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q652_%28ita%29-XANA000-notte.wav","examples":[{"text":"Posso passare la notte?","en":"Can I spend the night?","audio":"https://tatoeba.org/en/audio/download/1006525","words":[{"g":"can, could","l":"potere"},{"g":"to pass"},{"g":"the / her"},null]},{"text":"Vogliamo una stanza per quattro notti.","en":"We want a room for four nights.","words":[{"g":"to want","l":"volere"},{"g":"a","l":"uno"},{"g":"room"},{"g":"for"},{"g":"four"},null]},{"text":"La notte è giovane.","en":"The night is young.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"young"}]},{"text":"Vorrei stare per tre notti.","en":"I'd like to stay for three nights.","words":[{"g":"to want","l":"volere"},null,null,{"g":"three"},null],"phrases":[[1,3,"to be about to"]]},{"text":"Sogno ogni notte.","en":"I dream every night.","words":[{"g":"dream"},{"g":"each, every"},null]}]}