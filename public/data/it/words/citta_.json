{"id":"citta_","lemma":"città","pos":"noun","rank":414,"glosses":["town, city"],"ipa":"/t͡ʃitˈta/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q652_%28ita%29-XANA000-citt%C3%A0.wav","examples":[{"text":"Vivo in città.","en":"I live in town.","audio":"https://tatoeba.org/en/audio/download/1000161","words":[{"g":"alive, live"},{"g":"in"},null]},{"text":"Perché sei in città?","en":"Why are you in town?","words":[{"g":"why / because"},{"g":"are","l":"essere"},{"g":"in"},null]},{"text":"Potresti vivere in questa città?","en":"Could you live in this city?","words":[{"g":"can, could","l":"potere"},{"g":"to live"},{"g":"in"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Sarò fuori città.","en":"I'll be out of town.","words":[{"g":"to be","l":"essere"},{"g":"out, outside, outwards"},null]},{"text":"Conosco bene questa città.","en":"I know this city well.","words":[{"g":"to know","l":"conoscere"},{"g":"well"},{"g":"this, this one, these","l":"questo"},null]}]}