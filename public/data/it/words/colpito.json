{"id":"colpito","lemma":"colpito","pos":"adj","rank":741,"glosses":["struck","stricken","impressed"],"ipa":"/kolˈpi.to/","forms":{"feminine":"colpita","masculinePlural":"colpiti","femininePlural":"colpite"},"examples":[{"text":"Mi ha colpito sulla testa.","en":"He hit me on the head.","audio":"https://tatoeba.org/en/audio/download/1010077","words":[{"g":"me / myself"},{"g":"has","l":"avere"},null,{"g":"plant of the genus Sulla"},{"g":"head"}]},{"text":"Dove li hai colpiti?","en":"Where did you hit them?","words":[{"g":"where"},{"g":"them"},{"g":"have","l":"avere"},null]},{"text":"È stata colpita da un'auto.","en":"She was hit by a car.","audio":"https://tatoeba.org/en/audio/download/1006449","words":[{"g":"is","l":"essere"},{"g":"state","l":"stato"},null,{"g":"from"},{"g":"a"},{"g":"auto"}]},{"text":"Chi ti ha colpito?","en":"Who hit you?","words":[{"g":"who"},{"g":"you"},{"g":"has","l":"avere"},null]},{"text":"Sono stata colpita da una ragazza.","en":"I got hit by a girl.","words":[{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},null,{"g":"from"},{"g":"a","l":"uno"},{"g":"girl, young woman"}]}]}