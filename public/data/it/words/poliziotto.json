{"id":"poliziotto","lemma":"poliziotto","pos":"noun","rank":668,"glosses":["policeman, police officer, cop, copper, rozzer, bobby"],"ipa":"/po.litˈt͡sjɔt.to/","gender":"m","forms":{"plural":"poliziotti","feminine":"poliziotta"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q652_%28ita%29-XANA000-poliziotto.wav","examples":[{"text":"Sei un poliziotto?","en":"Are you a cop?","words":[{"g":"are","l":"essere"},{"g":"a"},null]},{"text":"Quanti poliziotti ci sono?","en":"How many cops are there?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"us / there"},{"g":"am / are","l":"essere"}]},{"text":"Perché sei diventata una poliziotta?","en":"Why did you become a policewoman?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,{"g":"a","l":"uno"},null]},{"text":"Chiedi al poliziotto.","en":"Ask the policeman.","words":[{"g":"to ask","l":"chiedere"},{"g":"to the"},null]},{"text":"Chiama i poliziotti.","en":"Call the cops.","words":[{"g":"to call","l":"chiamare"},{"g":"the","l":"la"},null]}]}