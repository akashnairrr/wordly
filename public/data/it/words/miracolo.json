{"id":"miracolo","lemma":"miracolo","pos":"noun","rank":1561,"glosses":["miracle","marvel, wonder"],"ipa":"/miˈra.ko.lo/","gender":"m","forms":{"plural":"miracoli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q652_%28ita%29-LangPao-miracolo.wav","examples":[{"text":"Questo è un miracolo.","en":"This is a miracle.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Credo nei miracoli.","en":"I believe in miracles.","words":[{"g":"to believe","l":"credere"},{"g":"mole","l":"neo"},null]},{"text":"Penso che sia un miracolo.","en":"I think it's a miracle.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"both ... and .."},{"g":"a"},null]},{"text":"I miracoli capitano davvero ogni giorno.","en":"Miracles do happen every day.","words":[{"g":"the","l":"la"},null,{"g":"captain"},{"g":"really, in fact"},null,null],"phrases":[[4,6,"daily"]]},{"text":"Mi serve un miracolo.","en":"I need a miracle.","words":[{"g":"me / myself"},{"g":"slave","l":"servo"},{"g":"a"},null]}]}