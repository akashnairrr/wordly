{"id":"tesoro","lemma":"tesoro","pos":"noun","rank":196,"glosses":["valuable things, treasure","term of endearment, treasure","treasury, exchequer (sometimes capitalized)"],"ipa":"/teˈzɔ.ro/","gender":"m","forms":{"plural":"tesori"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q652_%28ita%29-LangPao-tesoro.wav","examples":[{"text":"Ho una sorpresa per te, tesoro.","en":"I have a surprise for you, sweetheart.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},{"g":"surprise"},{"g":"for"},{"g":"you, thee"},null]},{"text":"Questo è un vero tesoro.","en":"This is a real treasure.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},{"g":"true"},null]},{"text":"Tesoro, sei lì?","en":"Honey, are you here?","words":[null,{"g":"are","l":"essere"},{"g":"there"}]},{"text":"Ho trovato il tesoro.","en":"I found the treasure.","words":[{"g":"have","l":"avere"},{"g":"discovery"},{"g":"the"},null]},{"text":"Tesoro, stai bene?","en":"Honey, are you OK?","words":[null,{"g":"to stay, remain","l":"stare"},{"g":"well"}]}]}