{"id":"disturbo","lemma":"disturbo","pos":"noun","rank":1354,"glosses":["trouble, bother, inconvenience","disturbance, interference, noise"],"ipa":"/disˈtur.bo/","gender":"m","forms":{"plural":"disturbi"},"examples":[{"text":"Odio essere un disturbo.","en":"I hate to be a nuisance.","words":[{"g":"hatred"},{"g":"to be"},{"g":"a"},null]},{"text":"Spero di non essere un disturbo.","en":"I hope I'm not being a nuisance.","words":[{"g":"to hope","l":"sperare"},{"g":"of"},{"g":"not"},{"g":"to be"},{"g":"a"},null]},{"text":"Ti disturbo se accendo la radio?","en":"Will it bother you if I turn on the radio?","words":[{"g":"you"},null,{"g":"if"},{"g":"to light","l":"accendere"},{"g":"the / her"},{"g":"radius"}]},{"text":"Perché prendersi il disturbo?","en":"Why bother?","words":[{"g":"why / because"},{"g":"to grab or take hold"},{"g":"the"},null]},{"text":"Non mi disturbi.","en":"Don't bug me.","words":[{"g":"not"},{"g":"me / myself"},null]}]}