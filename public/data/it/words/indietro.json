{"id":"indietro","lemma":"indietro","pos":"adv","rank":288,"glosses":["back, behind, backwards"],"ipa":"/inˈdjɛ.tro/","examples":[{"text":"Posso tornare indietro ora?","en":"Can I go back now?","words":[{"g":"can, could","l":"potere"},{"g":"to return"},null,{"g":"now"}]},{"text":"Non torna indietro?","en":"Are you not going back?","words":[{"g":"not"},{"g":"to return","l":"tornare"},null]},{"text":"Hai preso indietro i libri?","en":"Did you take back the books?","words":[{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},null,{"g":"the","l":"la"},{"g":"book","l":"libro"}]},{"text":"Voglio tornare indietro adesso.","en":"I want to go back now.","words":[{"g":"to want","l":"volere"},{"g":"to return"},null,{"g":"now"}]},{"text":"Stai indietro.","en":"Stay back.","words":[{"g":"to stay, remain","l":"stare"},null]}]}