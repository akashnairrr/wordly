{"id":"tosse","lemma":"tosse","pos":"noun","rank":4182,"glosses":["cough (condition that causes one to cough)"],"ipa":"/ˈtos.se/","gender":"f","forms":{"plural":"tossi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q652_%28ita%29-LangPao-tosse.wav","examples":[{"text":"Ho la tosse.","en":"I have a cough.","words":[{"g":"have","l":"avere"},{"g":"the / her"},null]},{"text":"La tua tosse mi preoccupa.","en":"Your cough worries me.","words":[{"g":"the / her"},{"g":"yours","l":"tuo"},null,{"g":"me / myself"},{"g":"to worry","l":"preoccupare"}]},{"text":"Non so perché ho la tosse.","en":"I don't know why I have a cough.","words":[{"g":"not"},{"g":"to know","l":"sapere"},{"g":"why / because"},{"g":"have","l":"avere"},{"g":"the / her"},null]},{"text":"Ho una tosse secca.","en":"I have a dry cough.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null,{"g":"shoal, sandbank"}]},{"text":"Ho il mal di testa e la tosse.","en":"I have a headache and I am suffering from a cough.","words":[{"g":"have","l":"avere"},{"g":"the"},null,null,null,{"g":"and"},{"g":"the / her"},null],"phrases":[[2,5,"headache"]]}]}