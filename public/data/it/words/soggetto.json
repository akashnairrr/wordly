{"id":"soggetto","lemma":"soggetto","pos":"noun","rank":2033,"glosses":["subject, matter, theme, topic","subject","fellow, person, individual, lot, sort"],"ipa":"/sodˈd͡ʒɛt.to/","gender":"m","forms":{"plural":"soggetti"},"examples":[{"text":"È un soggetto complicato.","en":"It's a complicated subject.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"complicated"}]},{"text":"Cambia il soggetto.","en":"Change the subject.","words":[{"g":"to exchange","l":"cambiare"},{"g":"the"},null]},{"text":"Siamo soggetti alle leggi della natura.","en":"We are subject to the laws of nature.","words":[{"g":"to be","l":"essere"},null,null,{"g":"law","l":"legge"},{"g":"of the"},{"g":"nature"}]},{"text":"Non provare a cambiare il soggetto.","en":"Don't try to change the subject.","words":[{"g":"not"},{"g":"to try"},{"g":"to / at"},{"g":"to exchange"},{"g":"the"},null]},{"text":"Perché hai scelto quel soggetto particolare?","en":"Why did you choose that particular subject?","words":[{"g":"why / because"},{"g":"have","l":"avere"},{"g":"chosen"},null,null,{"g":"particular"}]}]}