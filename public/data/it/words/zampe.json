{"id":"zampe","lemma":"zampe","pos":"noun","rank":3458,"glosses":["crow's feet around the eyes"],"gender":"f","examples":[{"text":"Un cane ha quattro zampe.","en":"A dog has four legs.","audio":"https://tatoeba.org/en/audio/download/1004674","words":[{"g":"a"},{"g":"dog"},{"g":"has","l":"avere"},{"g":"four"},null]},{"text":"Tutti gli insetti hanno sei zampe.","en":"All insects have six legs.","words":[{"g":"all"},{"g":"the / to him"},{"g":"insect, bug","l":"insetto"},{"g":"to have","l":"avere"},{"g":"are","l":"essere"},null]},{"text":"I ragni hanno otto zampe.","en":"Spiders have eight legs.","words":[{"g":"the","l":"la"},{"g":"spider","l":"ragno"},{"g":"to have","l":"avere"},{"g":"eight"},null]},{"text":"Il gatto si stava leccando le zampe.","en":"The cat was licking its paws.","words":[{"g":"the"},{"g":"cat"},{"g":"oneself"},{"g":"to stay, remain","l":"stare"},{"g":"to lick","l":"leccare"},{"g":"the / to her"},null]},{"text":"Un ragno ha otto zampe.","en":"A spider has eight legs.","words":[{"g":"a"},{"g":"spider"},{"g":"has","l":"avere"},{"g":"eight"},null]}]}