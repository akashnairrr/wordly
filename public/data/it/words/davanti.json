{"id":"davanti","lemma":"davanti","pos":"adv","rank":394,"glosses":["at the front; in front"],"ipa":"/daˈvan.ti/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q652_%28ita%29-XANA000-davanti.wav","examples":[{"text":"Vieni davanti alla classe.","en":"Come to the front of the classroom.","words":[{"g":"to come","l":"venire"},null,{"g":"to the"},{"g":"class"}]},{"text":"Il giardino è davanti alla casa.","en":"The garden is in front of the house.","words":[{"g":"the"},{"g":"garden"},{"g":"is","l":"essere"},null,{"g":"to the"},{"g":"house"}]},{"text":"Guarda davanti a te.","en":"Look in front of you.","words":[{"g":"to look at","l":"guardare"},null,{"g":"to / at"},{"g":"you, thee"}]},{"text":"Guardate davanti a voi.","en":"Look in front of you.","words":[{"g":"to look at","l":"guardare"},null,{"g":"to / at"},{"g":"you (pl.)"}]},{"text":"Eri proprio davanti a me.","en":"You were right in front of me.","words":[{"g":"to be","l":"essere"},{"g":"really, quite, indeed"},null,{"g":"to / at"},{"g":"me"}]}]}