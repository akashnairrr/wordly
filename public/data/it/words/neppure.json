{"id":"neppure","lemma":"neppure","pos":"conj","rank":1431,"glosses":["not even"],"ipa":"/nepˈpu.re/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q652_%28ita%29-XANA000-neppure.wav","examples":[{"text":"Non ho neppure una casa.","en":"I don't even have a house.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"a","l":"uno"},{"g":"house"}]},{"text":"Forse non è neppure possibile.","en":"Maybe it's not even possible.","words":[{"g":"maybe"},{"g":"not"},{"g":"is","l":"essere"},null,{"g":"possible"}]},{"text":"Non so neppure perché sono qui.","en":"I don't even know why I'm here.","words":[{"g":"not"},{"g":"to know","l":"sapere"},null,{"g":"why / because"},{"g":"am / are","l":"essere"},{"g":"here"}]},{"text":"Non mi disse neppure una parola.","en":"She didn't say even one word to me.","words":[{"g":"not"},{"g":"me / myself"},{"g":"to utter with one's…","l":"dire"},null,{"g":"a","l":"uno"},{"g":"word"}]},{"text":"Non lo provi neppure.","en":"Don't even try it.","words":[{"g":"not"},{"g":"the / it"},{"g":"to try","l":"provare"},null]}]}