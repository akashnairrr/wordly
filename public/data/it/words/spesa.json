{"id":"spesa","lemma":"spesa","pos":"noun","rank":1603,"glosses":["expense; expenditure; spending; cost; charge","shopping; purchase; buy","groceries"],"ipa":"/ˈspe.za/","gender":"f","forms":{"plural":"spese"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q652_%28ita%29-LangPao-spesa.wav","examples":[{"text":"Faccio la spesa ogni mattina.","en":"I do the shopping every morning.","words":[{"g":"to do","l":"fare"},{"g":"the / her"},null,{"g":"each, every"},{"g":"morning"}]},{"text":"Vai a fare la spesa ogni giorno?","en":"Do you go shopping every day?","words":[{"g":"to go","l":"andare"},{"g":"to / at"},{"g":"to do"},{"g":"the / her"},null,null,null],"phrases":[[5,7,"daily"]]},{"text":"Non mi importa la spesa.","en":"I don't care about the expense.","words":[{"g":"not"},{"g":"me / myself"},{"g":"to be important","l":"importare"},{"g":"the / her"},null]},{"text":"Vuole andare a fare la spesa con me?","en":"Do you want to go shopping with me?","words":[{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to / at"},{"g":"to do"},{"g":"the / her"},null,{"g":"with"},{"g":"me"}]},{"text":"Questo si aggiunge alla spesa.","en":"This adds to the expense.","words":[{"g":"this"},{"g":"oneself"},{"g":"to add, to append","l":"aggiungere"},{"g":"to the"},null]}]}