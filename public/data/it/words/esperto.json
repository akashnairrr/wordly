{"id":"esperto","lemma":"esperto","pos":"adj","rank":1611,"glosses":["experienced, expert, skilled"],"ipa":"/esˈpɛr.to/","forms":{"feminine":"esperta","masculinePlural":"esperti","femininePlural":"esperte"},"examples":[{"text":"Non sono esperto come te.","en":"I'm not as expert as you are.","words":[{"g":"not"},{"g":"am / are","l":"essere"},null,{"g":"how / like"},{"g":"you, thee"}]},{"text":"Lo lasci agli esperti.","en":"Leave that to the experts.","words":[{"g":"the / it"},{"g":"to leave","l":"lasciare"},{"g":"garlic","l":"aglio"},null]},{"text":"Hai chiesto ad un esperto?","en":"Have you asked an expert?","words":[{"g":"have","l":"avere"},{"g":"to ask","l":"chiedere"},null,{"g":"a"},null]},{"text":"Io non sono esperta come voi.","en":"I'm not as expert as you are.","words":[{"g":"I"},{"g":"not"},{"g":"am / are","l":"essere"},null,{"g":"how / like"},{"g":"you (pl.)"}]},{"text":"Abbiamo bisogno di esperti.","en":"We need experts.","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of"},null]}]}