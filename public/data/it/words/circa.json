{"id":"circa","lemma":"circa","pos":"prep","rank":515,"glosses":["regarding, concerning"],"ipa":"/ˈt͡ʃir.ka/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q652_%28ita%29-XANA000-circa.wav","examples":[{"text":"Studio circa due ore ogni giorno.","en":"I study about two hours every day.","words":[{"g":"study"},null,{"g":"two"},{"g":"now","l":"ora"},null,null],"phrases":[[4,6,"daily"]]},{"text":"\"Quanto ci vorrà?\" \"Circa due settimane.\"","en":"\"How long will it take?\" \"About two weeks.\"","words":[{"g":"how much, however much"},{"g":"us / there"},{"g":"to want","l":"volere"},null,{"g":"two"},{"g":"week","l":"settimana"}]},{"text":"Circa quante ore dormi a notte?","en":"About how many hours do you sleep every night?","words":[null,{"g":"how much, however much","l":"quanto"},{"g":"now","l":"ora"},{"g":"to sleep","l":"dormire"},{"g":"to / at"},{"g":"night"}]},{"text":"Sono circa le dieci?","en":"Is it about ten o'clock?","words":[{"g":"am / are","l":"essere"},null,{"g":"the / to her"},{"g":"ten"}]},{"text":"Abbiamo circa la stessa età.","en":"We're about the same age.","words":[{"g":"to have","l":"avere"},null,{"g":"the / her"},{"g":"same","l":"stesso"},{"g":"age"}]}]}