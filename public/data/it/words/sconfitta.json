{"id":"sconfitta","lemma":"sconfitta","pos":"noun","rank":3194,"glosses":["defeat, overthrow, elimination"],"ipa":"/skonˈfit.ta/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/49/LL-Q652_%28ita%29-LangPao-sconfitta.wav/LL-Q652_%28ita%29-LangPao-sconfitta.wav.mp3","gender":"f","forms":{"plural":"sconfitte"},"examples":[{"text":"Non sono mai stata sconfitta.","en":"I've never been defeated.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"never"},{"g":"state","l":"stato"},null]},{"text":"Ammisi la sconfitta.","en":"I admitted defeat.","words":[{"g":"to admit","l":"ammettere"},{"g":"the / her"},null]},{"text":"Ha ammesso la sua sconfitta.","en":"He admitted his defeat.","words":[{"g":"has","l":"avere"},{"g":"to admit","l":"ammettere"},{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null]},{"text":"La sconfitta fu una delusione.","en":"The loss was a disappointment.","words":[{"g":"the / her"},null,{"g":"deceased, late"},{"g":"a","l":"uno"},{"g":"disappointment"}]},{"text":"Io sono stata sconfitta due volte.","en":"I've been beaten twice.","words":[{"g":"I"},{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},null,{"g":"two"},{"g":"time","l":"volta"}]}]}