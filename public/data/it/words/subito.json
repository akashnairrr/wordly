{"id":"subito","lemma":"subito","pos":"adv","rank":184,"glosses":["at once, immediately, as soon as possible, shortly"],"ipa":"/ˈsu.bi.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q652_%28ita%29-LangPao-subito.wav","examples":[{"text":"Voglio che venga subito.","en":"I want you to come at once.","words":[{"g":"to want","l":"volere"},{"g":"that / what"},{"g":"to come","l":"venire"},null]},{"text":"Lo faccia subito.","en":"Do it at once.","words":[{"g":"the / it"},{"g":"face"},null]},{"text":"Devo andare subito.","en":"I must go at once.","words":[{"g":"to owe","l":"dovere"},{"g":"to go"},null]},{"text":"Vai subito, altrimenti farai tardi.","en":"Go at once, otherwise you will be late.","words":[{"g":"to go","l":"andare"},null,{"g":"otherwise, or else"},{"g":"to do","l":"fare"},{"g":"late"}]},{"text":"Devi andare a casa subito.","en":"You must go home at once.","words":[{"g":"to owe","l":"dovere"},{"g":"to go"},{"g":"to / at"},{"g":"house"},null]}]}