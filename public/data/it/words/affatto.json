{"id":"affatto","lemma":"affatto","pos":"adv","rank":740,"glosses":["completely"],"ipa":"/afˈfat.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q652_%28ita%29-XANA000-affatto.wav","examples":[{"text":"\"Sei stanco?\" \"No, affatto.\"","en":"\"Are you tired?\" \"No, not at all.\"","words":[{"g":"are","l":"essere"},{"g":"tired"},{"g":"no"},null]},{"text":"La domanda non è affatto facile.","en":"The question is by no means easy.","words":[{"g":"the / her"},{"g":"question"},{"g":"not"},{"g":"is","l":"essere"},null,{"g":"easy"}]},{"text":"\"Ti dispiace aprire la finestra?\" \"Affatto.\"","en":"\"Do you mind opening the window?\" \"Not at all.\"","words":[{"g":"you"},{"g":"to upset, displease","l":"dispiacere"},{"g":"to open"},{"g":"the / her"},{"g":"window"},null]},{"text":"Non ho affatto paura.","en":"I'm not at all afraid.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"fear"}]},{"text":"Non fa affatto freddo.","en":"It isn't a bit cold.","words":[{"g":"not"},{"g":"to do","l":"fare"},null,{"g":"the cold"}]}]}