{"id":"paio","lemma":"paio","pos":"noun","rank":362,"glosses":["pair"],"ipa":"/ˈpa.jo/","gender":"m","forms":{"femininePlural":"paia"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q652_%28ita%29-LangPao-paio.wav","examples":[{"text":"Ho un paio di scarpe.","en":"I have a pair of shoes.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"of"},{"g":"shoe","l":"scarpa"}]},{"text":"Posso chiedere un paio di domande?","en":"May I ask a couple of questions?","words":[{"g":"can, could","l":"potere"},{"g":"to ask"},{"g":"a"},null,{"g":"of"},{"g":"question","l":"domanda"}]},{"text":"Mi dia un paio di giorni.","en":"Give me a couple days.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"a"},null,{"g":"of"},{"g":"days"}]},{"text":"Mi serve un nuovo paio di scarpe.","en":"I need a pair of new shoes.","words":[{"g":"me / myself"},{"g":"slave","l":"servo"},{"g":"a"},{"g":"new"},null,{"g":"of"},{"g":"shoe","l":"scarpa"}]},{"text":"Sono stato là un paio di volte.","en":"I've been there a couple of times.","words":[{"g":"am / are","l":"essere"},{"g":"to be","l":"essere"},{"g":"there"},{"g":"a"},null,{"g":"of"},{"g":"time","l":"volta"}]}]}