{"id":"deciso","lemma":"deciso","pos":"adj","rank":456,"glosses":["determined, resolute, firm"],"ipa":"/deˈt͡ʃi.zo/","forms":{"feminine":"decisa","masculinePlural":"decisi","femininePlural":"decise"},"examples":[{"text":"Avete deciso dove andare?","en":"Have you all decided where to go?","words":[{"g":"to have","l":"avere"},null,{"g":"where"},{"g":"to go"}]},{"text":"Beh, hai deciso?","en":"Well, have you decided?","words":[{"g":"well"},{"g":"have","l":"avere"},null]},{"text":"Ti sei decisa?","en":"Did you make up your mind?","words":[{"g":"you"},{"g":"are","l":"essere"},null]},{"text":"Ho deciso di essere un avvocato.","en":"I decided to be a lawyer.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"to be"},{"g":"a"},{"g":"lawyer"}]},{"text":"Non ho ancora deciso che comprare.","en":"I still haven't decided what to buy.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"still / again"},null,{"g":"that / what"},{"g":"to buy"}]}]}