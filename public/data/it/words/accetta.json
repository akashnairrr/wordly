{"id":"accetta","lemma":"accetta","pos":"noun","rank":2310,"glosses":["hatchet"],"ipa":"/atˈt͡ʃet.ta/","gender":"f","forms":{"plural":"accette"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q652_%28ita%29-DivoLetto-accetta.wav","examples":[{"text":"Questo ristorante accetta solo contanti.","en":"This restaurant only accepts cash.","words":[{"g":"this"},{"g":"restaurant"},null,{"g":"only, just"},{"g":"cash, money"}]},{"text":"Perché non lo accetta?","en":"Why don't you accept that?","words":[{"g":"why / because"},{"g":"not"},{"g":"the / it"},null]},{"text":"Accetta le cose per come sono.","en":"Take things as they are.","words":[null,{"g":"the / to her"},{"g":"thing","l":"cosa"},{"g":"for"},{"g":"how / like"},{"g":"am / are","l":"essere"}]},{"text":"Per piacere, accetta le mie scuse.","en":"Please accept my apologies.","words":[null,null,null,{"g":"the / to her"},{"g":"mine","l":"mio"},{"g":"apology, excuse","l":"scusa"}],"phrases":[[0,2,"please"]]},{"text":"Accetta la spiegazione?","en":"Do you accept the explanation?","words":[null,{"g":"the / her"},{"g":"explanation"}]}]}