{"id":"aprile","lemma":"aprile","pos":"noun","rank":2857,"glosses":["April"],"ipa":"/aˈpri.le/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q652_%28ita%29-LangPao-aprile.wav","examples":[{"text":"È sempre così terribile ad aprile?","en":"Is it always so awful in April?","words":[{"g":"is","l":"essere"},{"g":"always"},{"g":"so"},{"g":"terrible"},null,null]},{"text":"La scuola comincia in aprile.","en":"School begins in April.","words":[{"g":"the / her"},{"g":"school"},{"g":"to begin","l":"cominciare"},{"g":"in"},null]},{"text":"La scuola inizia il dieci aprile.","en":"School begins on April the tenth.","words":[{"g":"the / her"},{"g":"school"},{"g":"to begin, to set about","l":"iniziare"},{"g":"the"},{"g":"ten"},null]},{"text":"Il quarto mese si chiama aprile.","en":"The fourth month is called April.","words":[{"g":"the"},{"g":"quarter"},{"g":"month"},{"g":"oneself"},{"g":"to call","l":"chiamare"},null]},{"text":"È il primo di aprile.","en":"It's April first.","words":[{"g":"is","l":"essere"},{"g":"the"},{"g":"first"},{"g":"of"},null]}]}