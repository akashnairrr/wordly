{"id":"noce","lemma":"noce","pos":"noun","rank":4328,"glosses":["walnut (fruit)","nut","nut lock (part of a crossbow)"],"ipa":"/ˈno.t͡ʃe/","gender":"f","forms":{"plural":"noci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/92/LL-Q652_%28ita%29-LangPao-noce.wav","examples":[{"text":"Questa è una noce di cocco.","en":"This is a coconut.","audio":"https://tatoeba.org/en/audio/download/1004053","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,null,null],"phrases":[[4,6,"a surname"]]},{"text":"Le noci sono nutrienti.","en":"Nuts are nutritious.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"nutritious","l":"nutriente"}]},{"text":"Ha rotto la noce con i suoi denti.","en":"He cracked the walnut with his teeth.","words":[{"g":"has","l":"avere"},{"g":"broken"},{"g":"the / her"},null,{"g":"with"},null,null,{"g":"tooth","l":"dente"}],"phrases":[[5,7,"his"]]},{"text":"Mi piacciono le noci di macadamia.","en":"I like macadamia nuts.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the / to her"},null,{"g":"of"},null]},{"text":"Stanno raccogliendo noci.","en":"They are gathering nuts.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to pick up, glean","l":"raccogliere"},null]}]}