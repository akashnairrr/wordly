{"id":"dieci","lemma":"dieci","pos":"noun","rank":459,"glosses":["ten"],"ipa":"/ˈdjɛ.t͡ʃi/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q652_%28ita%29-XANA000-dieci.wav","examples":[{"text":"Conta da uno a dieci.","en":"Count from one to ten.","audio":"https://tatoeba.org/en/audio/download/1006394","words":[{"g":"count, counting"},{"g":"from"},{"g":"a / one"},{"g":"to / at"},null]},{"text":"Ci possiamo vedere alle dieci domani?","en":"Can I see you at ten tomorrow?","words":[{"g":"us / there"},null,{"g":"to see"},null,null,{"g":"tomorrow"}]},{"text":"Dieci anni sono molto tempo.","en":"Ten years is a long time.","words":[null,{"g":"year","l":"anno"},{"g":"am / are","l":"essere"},{"g":"very / a lot"},{"g":"time"}]},{"text":"Posso essere là in dieci minuti.","en":"I can be there in ten minutes.","words":[{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"there"},{"g":"in"},null,{"g":"tiny","l":"minuto"}]},{"text":"Viene a casa alle dieci.","en":"He comes home at ten.","words":[{"g":"to come","l":"venire"},{"g":"to / at"},{"g":"house"},null,null]}]}