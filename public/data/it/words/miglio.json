{"id":"miglio","lemma":"miglio","pos":"noun","rank":1730,"glosses":["the Italian mile, a traditional unit of length derived from the Roman mile","the international mile and other \"mile\" unit"],"ipa":"/ˈmiʎ.ʎo/","gender":"m","forms":{"femininePlural":"miglia"},"examples":[{"text":"Sono circa due miglia.","en":"It's about two miles.","words":[{"g":"am / are","l":"essere"},{"g":"regarding, concerning"},{"g":"two"},null]},{"text":"Il ponte è lungo circa un miglio.","en":"The bridge is approximately a mile long.","words":[{"g":"the"},{"g":"bridge"},{"g":"is","l":"essere"},{"g":"along"},{"g":"regarding, concerning"},{"g":"a"},null]},{"text":"Ho corso tre miglia.","en":"I've run three miles.","words":[{"g":"have","l":"avere"},{"g":"course"},{"g":"three"},null]},{"text":"Può nuotare per un miglio.","en":"He can swim a mile.","words":[{"g":"can, could","l":"potere"},{"g":"to swim"},{"g":"for"},{"g":"a"},null]},{"text":"Da qui al parco sono due miglia.","en":"It is two miles from here to the park.","words":[{"g":"from"},{"g":"here"},{"g":"to the"},{"g":"frugal"},{"g":"am / are","l":"essere"},{"g":"two"},null]}]}