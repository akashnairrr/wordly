{"id":"discorso","lemma":"discorso","pos":"noun","rank":925,"glosses":["speech, address, discourse","talk, conversation","subject, matter"],"ipa":"/disˈkor.so/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/96/LL-Q652_%28ita%29-LangPao-discorso.wav/LL-Q652_%28ita%29-LangPao-discorso.wav.mp3","gender":"m","forms":{"plural":"discorsi"},"examples":[{"text":"Chi farà il discorso principale?","en":"Who's giving the main speech?","words":[{"g":"who"},{"g":"to do","l":"fare"},{"g":"the"},null,{"g":"main, principal"}]},{"text":"Ho un discorso da scrivere.","en":"I have a speech to write.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"from"},{"g":"to write"}]},{"text":"Questi discorsi non mi piacciono.","en":"I don't like these remarks.","words":[{"g":"this, this one, these","l":"questo"},null,{"g":"not"},{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"}]},{"text":"Devi tenere un discorso?","en":"Do you have to make a speech?","words":[{"g":"to owe","l":"dovere"},{"g":"to hold"},{"g":"a"},null]},{"text":"Non hai un discorso da fare?","en":"Don't you have a speech to make?","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"a"},null,{"g":"from"},{"g":"to do"}]}]}