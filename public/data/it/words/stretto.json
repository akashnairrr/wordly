{"id":"stretto","lemma":"stretto","pos":"adj","rank":1851,"glosses":["narrow","tight","strict"],"ipa":"/ˈstret.to/","forms":{"feminine":"stretta","masculinePlural":"stretti","femininePlural":"strette"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q652_%28ita%29-LangPao-stretto.wav","examples":[{"text":"Quanti amici stretti hai?","en":"How many close friends do you have?","words":[{"g":"how much, however much","l":"quanto"},{"g":"friend","l":"amico"},null,{"g":"have","l":"avere"}]},{"text":"Le ho stretto la mano.","en":"I shook hands with her.","words":[{"g":"the / to her"},{"g":"have","l":"avere"},null,{"g":"the / her"},{"g":"hand"}]},{"text":"Ha stretto la mano al sindaco.","en":"He shook hands with the mayor.","words":[{"g":"has","l":"avere"},null,{"g":"the / her"},{"g":"hand"},{"g":"to the"},{"g":"mayor"}]},{"text":"Il sentiero era stretto.","en":"The path was narrow.","words":[{"g":"the"},{"g":"path, trail"},{"g":"to be","l":"essere"},null]},{"text":"Quei pantaloni sono un po' troppo stretti di vita.","en":"Those pants are a little too tight in the waist.","words":[{"g":"Old Italian form of…"},{"g":"pants, trousers"},{"g":"am / are","l":"essere"},{"g":"a"},null,{"g":"too much"},null,null,null],"phrases":[[7,9,"a surname"]]}]}