{"id":"popolo","lemma":"popolo","pos":"noun","rank":1184,"glosses":["people"],"ipa":"/ˈpɔ.po.lo/","gender":"m","forms":{"plural":"popoli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q652_%28ita%29-LangPao-popolo.wav","examples":[{"text":"Il popolo merita di meglio.","en":"The people deserve better.","words":[{"g":"the"},null,{"g":"to deserve, merit","l":"meritare"},{"g":"of"},{"g":"better"}]},{"text":"Sono un popolo amante della pace.","en":"They are a peace-loving people.","words":[{"g":"am / are","l":"essere"},{"g":"a"},null,{"g":"lover, paramour"},{"g":"of the"},{"g":"peace be with you"}]},{"text":"Il re opprimeva il suo popolo.","en":"The king oppressed his people.","words":[{"g":"the"},{"g":"king"},null,{"g":"the"},{"g":"his, hers, its"},null]},{"text":"Ci sono molti popoli diversi in Europa.","en":"There are a lot of different people in Europe.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"several things/people"},{"g":"in"},null]},{"text":"Il popolo si ribellò contro il re.","en":"The people rebelled against the king.","words":[{"g":"the"},null,{"g":"oneself"},null,{"g":"against"},{"g":"the"},{"g":"king"}]}]}