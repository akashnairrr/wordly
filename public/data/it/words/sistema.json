{"id":"sistema","lemma":"sistema","pos":"noun","rank":520,"glosses":["system","method, process"],"ipa":"/sisˈtɛ.ma/","gender":"m","forms":{"plural":"sistemi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q652_%28ita%29-LangPao-sistema.wav","examples":[{"text":"Conosco il sistema.","en":"I know the system.","words":[{"g":"to know","l":"conoscere"},{"g":"the"},null]},{"text":"Il vecchio sistema funziona.","en":"The old system works.","words":[{"g":"the"},{"g":"old, outworn"},null,{"g":"to function, to work","l":"funzionare"}]},{"text":"Questo è un buon sistema.","en":"This is a good system.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null,null]},{"text":"Lo so come funziona il sistema.","en":"I know how the system works.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},{"g":"how / like"},{"g":"to function, to work","l":"funzionare"},{"g":"the"},null]},{"text":"Non ho un sistema.","en":"I don't have a system.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"a"},null]}]}