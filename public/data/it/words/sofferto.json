{"id":"sofferto","lemma":"sofferto","pos":"adj","rank":2562,"glosses":["hard-fought","painful"],"ipa":"/sofˈfɛr.to/","forms":{"feminine":"sofferta","masculinePlural":"sofferti","femininePlural":"sofferte"},"examples":[{"text":"Abbiamo sofferto abbastanza.","en":"We have suffered enough.","words":[{"g":"to have","l":"avere"},null,{"g":"enough, sufficiently"}]},{"text":"Non ho sofferto abbastanza?","en":"Haven't I suffered enough?","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"enough, sufficiently"}]},{"text":"Abbiamo sofferto molti danni.","en":"We suffered a lot of damage.","words":[{"g":"to have","l":"avere"},null,{"g":"much, very much, a lot","l":"molto"},{"g":"damage, harm, injury","l":"danno"}]},{"text":"Hanno sofferto molto durante gli anni della guerra.","en":"They suffered a lot during the war years.","words":[{"g":"to have","l":"avere"},null,{"g":"very / a lot"},{"g":"during"},{"g":"the / to him"},{"g":"year","l":"anno"},{"g":"of the"},{"g":"war, warfare"}]},{"text":"Noi abbiamo sofferto tutti.","en":"We all suffered.","words":[{"g":"we"},{"g":"to have","l":"avere"},null,{"g":"all"}]}]}