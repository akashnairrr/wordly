{"id":"tedesco","lemma":"tedesco","pos":"adj","rank":1777,"glosses":["German (of, from or relating to Germany)"],"ipa":"/teˈdes.ko/","forms":{"feminine":"tedesca","masculinePlural":"tedeschi","femininePlural":"tedesche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q652_%28ita%29-LangPao-tedesco.wav","examples":[{"text":"Parla tedesco.","en":"She speaks German.","words":[{"g":"to talk, to speak","l":"parlare"},null]},{"text":"Poi i tedeschi hanno colpito ancora.","en":"Then the Germans struck again.","words":[{"g":"then"},{"g":"the","l":"la"},null,{"g":"to have","l":"avere"},{"g":"struck"},{"g":"still / again"}]},{"text":"La mia macchina è tedesca.","en":"My car is German.","audio":"https://tatoeba.org/en/audio/download/1001331","words":[{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"machine"},{"g":"is","l":"essere"},null]},{"text":"Non capisco il tedesco.","en":"I don't understand German.","words":[null,null,{"g":"the"},null],"phrases":[[0,2,"I don't understand"]]},{"text":"Non riesco a farmi capire in tedesco.","en":"I can't make myself understood in German.","words":[{"g":"not"},{"g":"to manage","l":"riuscire"},{"g":"to / at"},null,{"g":"to understand"},{"g":"in"},null]}]}