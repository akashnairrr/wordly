{"id":"invito","lemma":"invito","pos":"noun","rank":1585,"glosses":["invitation","request, call","bevelled or chamfered hole"],"ipa":"/inˈvi.to/","gender":"m","forms":{"plural":"inviti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q652_%28ita%29-LangPao-invito.wav","examples":[{"text":"Grazie per l'invito.","en":"Thanks for the invite.","words":[{"g":"thanks, thank-you"},{"g":"for"},null,null]},{"text":"Hai accettato il suo invito?","en":"Did you accept his invitation?","words":[{"g":"have","l":"avere"},{"g":"to accept, to admit","l":"accettare"},{"g":"the"},{"g":"his, hers, its"},null]},{"text":"Ho ricevuto un invito.","en":"I received an invitation.","words":[{"g":"have","l":"avere"},{"g":"to receive","l":"ricevere"},{"g":"a"},null]},{"text":"Non posso accettare il tuo invito.","en":"I can't accept your invitation.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to accept, to admit"},{"g":"the"},{"g":"yours"},null]},{"text":"Sto ancora aspettando un invito.","en":"I'm still waiting for an invitation.","words":[{"g":"to stay, remain","l":"stare"},{"g":"still / again"},{"g":"to wait for","l":"aspettare"},{"g":"a"},null]}]}