{"id":"incendio","lemma":"incendio","pos":"noun","rank":1379,"glosses":["fire, blaze"],"ipa":"/inˈt͡ʃɛn.djo/","gender":"m","forms":{"plural":"incendi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q652_%28ita%29-LangPao-incendio.wav","examples":[{"text":"L'incendio era al primo piano.","en":"The fire was on the first floor.","words":[null,null,{"g":"to be","l":"essere"},{"g":"to the"},null,null],"phrases":[[4,6,"first floor"]]},{"text":"Gli incendi stanno ancora bruciando?","en":"Are the fires still burning?","words":[{"g":"the / to him"},null,{"g":"to stay, remain","l":"stare"},{"g":"still / again"},{"g":"to burn","l":"bruciare"}]},{"text":"In caso di incendio rompere questa finestra.","en":"In case of fire, break this window.","words":[null,null,{"g":"of"},null,{"g":"to break"},{"g":"this, this one, these","l":"questo"},{"g":"window"}],"phrases":[[0,2,"in case"]]},{"text":"Ci sono molti incendi in inverno.","en":"There are a lot of fires in the winter.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"in"},{"g":"winter"}]},{"text":"L'incendio è spento.","en":"The fire is out.","words":[null,null,{"g":"is","l":"essere"},{"g":"out"}]}]}