{"id":"dietro","lemma":"dietro","pos":"prep","rank":323,"glosses":["behind","after, next"],"ipa":"/ˈdjɛ.tro/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q652_%28ita%29-XANA000-dietro.wav","examples":[{"text":"Mi stia dietro.","en":"Stay behind me.","words":[{"g":"me / myself"},{"g":"to stay, remain","l":"stare"},null]},{"text":"Il giardino è dietro la casa.","en":"The garden is behind the house.","words":[{"g":"the"},{"g":"garden"},{"g":"is","l":"essere"},null,{"g":"the / her"},{"g":"house"}]},{"text":"Guarda dietro di te.","en":"Look behind you.","words":[{"g":"to look at","l":"guardare"},null,{"g":"of"},{"g":"you, thee"}]},{"text":"Ha gli occhi dietro la testa.","en":"He has eyes at the back of his head.","words":[{"g":"has","l":"avere"},{"g":"the / to him"},{"g":"look out! watch out!","l":"occhio"},null,{"g":"the / her"},{"g":"head"}]},{"text":"Qualcuno è dietro di me.","en":"Someone's behind me.","words":[{"g":"someone, somebody"},{"g":"is","l":"essere"},null,{"g":"of"},{"g":"me"}]}]}