{"id":"cenere","lemma":"cenere","pos":"noun","rank":3708,"glosses":["ash, cinder"],"ipa":"/ˈt͡ʃe.ne.re/","gender":"f","forms":{"plural":"ceneri"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a7/LL-Q652_%28ita%29-LangPao-cenere.wav","examples":[{"text":"La casa era ridotta in cenere.","en":"The house burned down completely.","words":[{"g":"the / her"},{"g":"house"},{"g":"to be","l":"essere"},{"g":"fort, redoubt"},{"g":"in"},null]},{"text":"Il castello fu ridotto in cenere.","en":"The castle was burned to ashes.","words":[{"g":"the"},{"g":"castle"},{"g":"deceased, late"},{"g":"reduced"},{"g":"in"},null]},{"text":"La nostra scuola è stata ridotta in cenere.","en":"Our school was reduced to ashes.","words":[{"g":"the / her"},{"g":"our","l":"nostro"},{"g":"school"},{"g":"is","l":"essere"},{"g":"state","l":"stato"},{"g":"fort, redoubt"},{"g":"in"},null]},{"text":"Le sue ceneri sono sepolte qui.","en":"His ashes are buried here.","words":[null,null,null,{"g":"am / are","l":"essere"},{"g":"buried","l":"sepolto"},{"g":"here"}],"phrases":[[0,2,"his"]]},{"text":"Il castello è stato ridotto in cenere.","en":"The castle was burned to ashes.","words":[{"g":"the"},{"g":"castle"},{"g":"is","l":"essere"},{"g":"to be","l":"essere"},{"g":"reduced"},{"g":"in"},null]}]}