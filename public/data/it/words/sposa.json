{"id":"sposa","lemma":"sposa","pos":"noun","rank":1242,"glosses":["bride, wife (when in reference to the wedding day or the period of time immediately after the wedding)"],"ipa":"/ˈspɔ.za/","gender":"f","forms":{"plural":"spose","masculine":"sposo"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-sposa.wav","formAudio":{"sposo":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-sposo.wav"},"examples":[{"text":"La sposa sembrava molto bella.","en":"The bride looked very beautiful.","words":[{"g":"the / her"},null,{"g":"to seem","l":"sembrare"},{"g":"very / a lot"},{"g":"beauty, belle"}]},{"text":"Non conosco la sposa.","en":"I don't know the bride.","words":[{"g":"not"},{"g":"to know","l":"conoscere"},{"g":"the / her"},null]},{"text":"Perché si sposa?","en":"Why are you getting married?","words":[{"g":"why / because"},{"g":"oneself"},null]},{"text":"Quanti figli vuole avere quando si sposa?","en":"How many children do you want to have when you get married?","words":[{"g":"how much, however much","l":"quanto"},{"g":"son","l":"figlio"},{"g":"to want","l":"volere"},{"g":"to have"},{"g":"when"},{"g":"oneself"},null]},{"text":"Posso baciare la sposa?","en":"May I kiss the bride?","words":[{"g":"can, could","l":"potere"},{"g":"to kiss"},{"g":"the / her"},null]}]}