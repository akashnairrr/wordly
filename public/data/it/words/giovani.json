{"id":"giovani","lemma":"giovani","pos":"noun","rank":977,"glosses":["The young - young people"],"ipa":"/ˈd͡ʒo.va.ni/","gender":"m","examples":[{"text":"I miei genitori sono ancora giovani.","en":"My parents are still young.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"parent","l":"genitore"},{"g":"am / are","l":"essere"},{"g":"still / again"},null]},{"text":"Siete ovviamente troppo giovani per bere.","en":"You're obviously too young to be drinking.","words":[{"g":"to be","l":"essere"},{"g":"obviously"},{"g":"too much"},null,{"g":"for"},{"g":"to drink"}]},{"text":"Erano così giovani.","en":"They were so young.","words":[{"g":"to be","l":"essere"},{"g":"so"},null]},{"text":"Allora eravamo giovani.","en":"We were young then.","words":[{"g":"then"},{"g":"to be","l":"essere"},null]},{"text":"Ho tre sorelle più giovani.","en":"I have three younger sisters.","words":[{"g":"have","l":"avere"},{"g":"three"},{"g":"sister","l":"sorella"},{"g":"more"},null]}]}