{"id":"cosa","lemma":"cosa","pos":"noun","rank":17,"glosses":["thing","what? (cosa?)"],"ipa":"/ˈkɔ.za/","gender":"f","forms":{"plural":"cose"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a6/LL-Q652_%28ita%29-XANA000-cosa.wav","examples":[{"text":"Che cosa fa?","en":"What does he do?","audio":"https://tatoeba.org/en/audio/download/1001366","words":[{"g":"that / what"},null,{"g":"to do","l":"fare"}]},{"text":"Perché vuoi tutte queste cose?","en":"Why do you want all these things?","words":[{"g":"why / because"},{"g":"to want","l":"volere"},{"g":"everything, all","l":"tutto"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Cosa abbiamo qui?","en":"What have we here?","audio":"https://tatoeba.org/en/audio/download/1004063","words":[null,{"g":"to have","l":"avere"},{"g":"here"}]},{"text":"Ho delle cose da fare.","en":"I have things to do.","audio":"https://tatoeba.org/en/audio/download/1004812","words":[{"g":"have","l":"avere"},null,null,{"g":"from"},{"g":"to do"}]},{"text":"Amo questa cosa.","en":"I love this thing.","words":[{"g":"to love, to like","l":"amare"},{"g":"this, this one, these","l":"questo"},null]}]}