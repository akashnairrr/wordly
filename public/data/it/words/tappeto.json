{"id":"tappeto","lemma":"tappeto","pos":"noun","rank":2019,"glosses":["carpet, rug, mat","treadmill"],"ipa":"/tapˈpe.to/","gender":"m","forms":{"plural":"tappeti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q652_%28ita%29-LangPao-tappeto.wav","examples":[{"text":"Vogliamo un tappeto nuovo.","en":"We want a new carpet.","words":[{"g":"to want","l":"volere"},{"g":"a"},null,{"g":"new"}]},{"text":"Che brutto tappeto!","en":"What an ugly carpet!","words":[{"g":"that / what"},{"g":"ugly, bad, nasty"},null]},{"text":"Il gatto è sul tappeto.","en":"The cat is on the mat.","words":[{"g":"the"},{"g":"cat"},{"g":"is","l":"essere"},null,null]},{"text":"Odio questo tappeto.","en":"I hate this rug.","words":[{"g":"hatred"},{"g":"this"},null]},{"text":"I tappeti assorbono il suono.","en":"Rugs absorb sound.","words":[{"g":"the","l":"la"},null,{"g":"to absorb, soak up","l":"assorbire"},{"g":"the"},{"g":"sound"}]}]}