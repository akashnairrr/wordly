{"id":"cotto","lemma":"cotto","pos":"adj","rank":4950,"glosses":["cooked","smitten","exhausted"],"ipa":"/ˈkɔt.to/","forms":{"feminine":"cotta","masculinePlural":"cotti","femininePlural":"cotte"},"examples":[{"text":"Mia madre ha cotto dieci uova.","en":"My mother has cooked ten eggs.","words":[{"g":"mine","l":"mio"},{"g":"mother"},{"g":"has","l":"avere"},null,{"g":"ten"},{"g":"egg","l":"uovo"}]},{"text":"Questo pollo è cotto troppo.","en":"This chicken is overcooked.","words":[{"g":"this"},{"g":"sucker"},{"g":"is","l":"essere"},null,{"g":"too much"}]},{"text":"Il pollo non è cotto abbastanza.","en":"The chicken is undercooked.","words":[{"g":"the"},{"g":"sucker"},{"g":"not"},{"g":"is","l":"essere"},null,{"g":"enough, sufficiently"}]},{"text":"Ho cotto il pane.","en":"I baked bread.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"bread"}]},{"text":"Ho cotto troppo la pasta.","en":"I overcooked the pasta.","words":[{"g":"have","l":"avere"},null,{"g":"too much"},{"g":"the / her"},{"g":"paste"}]}]}