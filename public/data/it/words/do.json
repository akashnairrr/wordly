{"id":"do","lemma":"do","pos":"noun","rank":597,"glosses":["do (musical note)","C (musical note or key)"],"ipa":"/ˈdɔ/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q652_%28ita%29-LangPao-do.wav","examples":[{"text":"Ti do la mia parola.","en":"I give you my word.","audio":"https://tatoeba.org/en/audio/download/1003878","words":[{"g":"you"},null,{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"word"}]},{"text":"Perché non ti do un passaggio?","en":"Why don't I drive you?","words":[{"g":"why / because"},{"g":"not"},{"g":"you"},null,{"g":"a"},{"g":"passage, passing, gap"}]},{"text":"Ti do un giorno per pensarci su.","en":"I'll give you a day to think about it.","words":[{"g":"you"},null,{"g":"a"},{"g":"day"},{"g":"for"},null,null],"phrases":[[5,7,"to sleep on it"]]},{"text":"Do sempre qualcosa ai mendicanti.","en":"I always give something to the beggars.","words":[null,{"g":"always"},{"g":"something"},null,{"g":"begging, mendicant","l":"mendicante"}]},{"text":"Gliele do domani.","en":"I'm giving them to her tomorrow.","words":[{"g":"them to him"},null,{"g":"tomorrow"}]}]}