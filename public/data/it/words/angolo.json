{"id":"angolo","lemma":"angolo","pos":"noun","rank":1082,"glosses":["angle, corner"],"ipa":"/ˈan.ɡo.lo/","gender":"m","forms":{"plural":"angoli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q652_%28ita%29-LangPao-angolo.wav","examples":[{"text":"La casa all'angolo è nostra.","en":"The house on the corner is ours.","words":[{"g":"the / her"},{"g":"house"},null,null,{"g":"is","l":"essere"},{"g":"our","l":"nostro"}]},{"text":"Un quadrato ha quattro angoli.","en":"A square has four angles.","words":[{"g":"a"},{"g":"square"},{"g":"has","l":"avere"},{"g":"four"},null]},{"text":"Gira a destra al prossimo angolo.","en":"Turn right at the next corner.","words":[{"g":"to turn","l":"girare"},{"g":"to / at"},{"g":"right"},{"g":"to the"},{"g":"very near, near, close"},null]},{"text":"È giusto dietro l'angolo.","en":"It's just around the corner.","words":[{"g":"is","l":"essere"},{"g":"just, exactly"},{"g":"behind"},null,null]},{"text":"Potremmo avere un tavolo nell'angolo?","en":"Could we have a table in the corner?","words":[{"g":"can, could","l":"potere"},{"g":"to have"},{"g":"a"},{"g":"table, board, desk"},null,null]}]}