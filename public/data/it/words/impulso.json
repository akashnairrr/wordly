{"id":"impulso","lemma":"impulso","pos":"noun","rank":3270,"glosses":["impulse, drive, urge, boost","impulse, pulse, also archaic for momentum"],"ipa":"/imˈpul.so/","gender":"m","forms":{"plural":"impulsi"},"examples":[{"text":"Capiamo l'impulso.","en":"We understand the impulse.","words":[{"g":"to understand","l":"capire"},null,null]},{"text":"Noi comprendiamo l'impulso.","en":"We understand the impulse.","words":[{"g":"we"},{"g":"to comprise","l":"comprendere"},null,null]},{"text":"Sentivo l'impulso di urlare forte.","en":"I felt an impulse to cry out loud.","words":[{"g":"to feel","l":"sentire"},null,null,{"g":"of"},{"g":"to scream, to yell"},{"g":"strong"}]},{"text":"Noi capiamo l'impulso.","en":"We understand the impulse.","words":[{"g":"we"},{"g":"to understand","l":"capire"},null,null]},{"text":"Comprendiamo l'impulso.","en":"We understand the impulse.","words":[{"g":"to comprise","l":"comprendere"},null,null]}]}