{"id":"sentirsi","lemma":"sentirsi","pos":"verb","rank":2238,"glosses":["to hear from each other, be in touch","to feel, to be","to feel like, feel up to, be up to"],"ipa":"/senˈtir.si/","conjugation":{"indicative":{"present":{"1s":"mi sento","2s":"ti senti","3s":"si sente","1p":"ci sentiamo","2p":"vi sentite","3p":"si sentono"},"imperfect":{"1s":"mi sentivo","2s":"ti sentivi","3s":"si sentiva","1p":"ci sentivamo","2p":"vi sentivate","3p":"si sentivano"},"preterite":{"1s":"mi sentii","2s":"ti sentisti","3s":"si sentì","1p":"ci sentimmo","2p":"vi sentiste","3p":"si sentirono"},"future":{"1s":"mi sentirò","2s":"ti sentirai","3s":"si sentirà","1p":"ci sentiremo","2p":"vi sentirete","3p":"si sentiranno"},"conditional":{"1s":"mi sentirei","2s":"ti sentiresti","3s":"si sentirebbe","1p":"ci sentiremmo","2p":"vi sentireste","3p":"si sentirebbero"},"perfect":{"1s":"sono sentitosi","2s":"sei sentitosi","3s":"è sentitosi","1p":"siamo sentitosi","2p":"siete sentitosi","3p":"sono sentitosi"}},"subjunctive":{"present":{"1s":"mi senta","2s":"ti senta","3s":"si senta","1p":"ci sentiamo","2p":"vi sentiate","3p":"si sentano"},"imperfect":{"1s":"mi sentissi","2s":"ti sentissi","3s":"si sentisse","1p":"ci sentissimo","2p":"vi sentiste","3p":"si sentissero"}},"imperative":{"affirmative":{"2s":"sentiti","1p":"sentiamoci","2p":"sentitevi"},"negative":{"2s":"sentirti","1p":"sentiamoci","2p":"sentitevi"}}},"nonFinite":{"gerund":"sentendosi","participle":"sentitosi"},"examples":[{"text":"Posso ancora sentirti.","en":"I can still hear you.","words":[{"g":"can, could","l":"potere"},{"g":"still / again"},null]},{"text":"Non voglio sentirti parlare.","en":"I don't want to hear you speak.","words":[{"g":"not"},{"g":"to want","l":"volere"},null,{"g":"to talk, to speak"}]},{"text":"Gli uomini vogliono sentirsi importanti.","en":"Men want to feel important.","words":[{"g":"the / to him"},{"g":"person, man","l":"uomo"},{"g":"to want","l":"volere"},null,{"g":"important","l":"importante"}]},{"text":"No