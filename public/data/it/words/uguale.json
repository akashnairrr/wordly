{"id":"uguale","lemma":"uguale","pos":"adj","rank":1577,"glosses":["equal, identical, alike, like, same","equal (intended for voices of one kind only, either all male or all female)","even; level"],"ipa":"/uˈɡwa.le/","forms":{"plural":"uguali"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q652_%28ita%29-LangPao-uguale.wav","examples":[{"text":"Sono tutti uguali?","en":"Are they all the same?","audio":"https://tatoeba.org/en/audio/download/1006410","words":[{"g":"am / are","l":"essere"},{"g":"all"},null]},{"text":"Resta tutto uguale.","en":"Everything stays the same.","words":[{"g":"to stay, to remain","l":"restare"},{"g":"everything, all"},null]},{"text":"Siamo tutti uguali qui.","en":"We're all equal here.","words":[{"g":"to be","l":"essere"},{"g":"all"},null,{"g":"here"}]},{"text":"Tutto è uguale a prima.","en":"Everything's the same as before.","words":[{"g":"everything, all"},{"g":"is","l":"essere"},null,{"g":"to / at"},{"g":"before"}]},{"text":"Queste case sono tutte uguali.","en":"These houses are all the same.","words":[{"g":"this, this one, these","l":"questo"},{"g":"house","l":"casa"},{"g":"am / are","l":"essere"},{"g":"everything, all","l":"tutto"},null]}]}