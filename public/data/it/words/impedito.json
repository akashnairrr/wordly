{"id":"impedito","lemma":"impedito","pos":"adj","rank":3676,"glosses":["clumsy, awkward, hampered, encumbered"],"ipa":"/im.peˈdi.to/","forms":{"feminine":"impedita","masculinePlural":"impediti","femininePlural":"impedite"},"examples":[{"text":"Cosa ti ha impedito di lavorare?","en":"What prevented you from working?","words":[{"g":"thing"},{"g":"you"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"to work"}]},{"text":"Poteva essere impedito.","en":"That could've been prevented.","words":[{"g":"can, could","l":"potere"},{"g":"to be"},null]},{"text":"La neve ci ha impedito di uscire.","en":"The snow kept us from going out.","words":[{"g":"the / her"},{"g":"snow"},{"g":"us / there"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"to go out, leave, exit"}]},{"text":"Cosa vi ha impedito di venire ieri?","en":"What prevented you from coming yesterday?","words":[{"g":"thing"},{"g":"you"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"to come"},{"g":"yesterday"}]},{"text":"La pioggia mi ha impedito di andare.","en":"The rain prevented me from going.","words":[{"g":"the / her"},{"g":"rain"},{"g":"me / myself"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"to go"}]}]}