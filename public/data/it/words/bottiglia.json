{"id":"bottiglia","lemma":"bottiglia","pos":"noun","rank":1146,"glosses":["bottle"],"ipa":"/botˈtiʎ.ʎa/","gender":"f","forms":{"plural":"bottiglie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q652_%28ita%29-LangPao-bottiglia.wav","examples":[{"text":"Hai quella bottiglia?","en":"Do you have that bottle?","words":[{"g":"have","l":"avere"},{"g":"that one","l":"quello"},null]},{"text":"Due bottiglie piccole, per piacere.","en":"Two small bottles, please.","words":[{"g":"two"},null,{"g":"a small glass of beer","l":"piccola"},null,null],"phrases":[[3,5,"please"]]},{"text":"Apri la bottiglia.","en":"Open the bottle.","words":[{"g":"to open","l":"aprire"},{"g":"the / her"},null]},{"text":"Quante bottiglie di birra hai comprato?","en":"How many bottles of beer did you buy?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"of"},{"g":"beer"},{"g":"have","l":"avere"},{"g":"to buy","l":"comprare"}]},{"text":"Mi dia la bottiglia.","en":"Give me the bottle.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"the / her"},null]}]}