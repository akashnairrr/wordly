{"id":"banale","lemma":"banale","pos":"adj","rank":4340,"glosses":["banal, cliché, trite","trivial, unimportant, mere, ordinary, common","dull, uninteresting (of person)"],"ipa":"/baˈna.le/","forms":{"plural":"banali"},"examples":[{"text":"La soluzione è banale.","en":"The solution is banal.","words":[{"g":"the / her"},{"g":"solution"},{"g":"is","l":"essere"},null]},{"text":"Quella canzone è banale.","en":"That song is corny.","words":[{"g":"that one","l":"quello"},{"g":"song"},{"g":"is","l":"essere"},null]},{"text":"È una questione banale.","en":"It is a trivial matter.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"question"},null]},{"text":"Come fai a sopportare le battute banali di Tom?","en":"How can you put up with Tom's corny jokes?","words":[{"g":"how / like"},{"g":"to do","l":"fare"},{"g":"to / at"},{"g":"to bear"},{"g":"the / to her"},{"g":"beaten, struck","l":"battuto"},null,{"g":"of"},null]}]}