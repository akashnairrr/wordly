{"id":"ella","lemma":"ella","pos":"pron","rank":2743,"glosses":["she"],"ipa":"/ˈɛl.la/","forms":{"plural":"elle"},"examples":[{"text":"Ella verrà presto.","en":"She will come soon.","words":[null,{"g":"to come","l":"venire"},{"g":"soon"}]},{"text":"Ella dichiarò che aveva ragione.","en":"She declared that she was right.","words":[null,{"g":"to declare","l":"dichiarare"},{"g":"that / what"},{"g":"to have","l":"avere"},{"g":"reason, intellect"}]},{"text":"A volte ella arriva in ritardo a scuola.","en":"She's sometimes late for school.","words":[null,null,null,{"g":"to arrive","l":"arrivare"},null,null,{"g":"to / at"},{"g":"school"}],"phrases":[[0,2,"sometimes, at times"],[4,6,"late"]]},{"text":"Ella ha braccia e gambe lunghe.","en":"She has long arms and legs.","words":[null,{"g":"has","l":"avere"},{"g":"arm","l":"braccio"},{"g":"and"},{"g":"leg","l":"gamba"},{"g":"along","l":"lungo"}]},{"text":"Suonarono un certo numero di canzoni di Ella Fitzgerald.","en":"They played quite a few Ella Fitzgerald songs.","words":[{"g":"to play","l":"suonare"},{"g":"a"},{"g":"certain, sure"},{"g":"number"},{"g":"of"},{"g":"song","l":"canzone"},{"g":"of"},null,null]}]}