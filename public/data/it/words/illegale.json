{"id":"illegale","lemma":"illegale","pos":"adj","rank":1785,"glosses":["illegal, unlawful, lawless, false"],"ipa":"/il.leˈɡa.le/","forms":{"plural":"illegali"},"examples":[{"text":"Questo è illegale.","en":"This is illegal.","words":[{"g":"this"},{"g":"is","l":"essere"},null]},{"text":"Non sono illegali.","en":"They're not illegal.","words":[{"g":"not"},{"g":"am / are","l":"essere"},null]},{"text":"Lo so che illegale.","en":"I know it's illegal.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},{"g":"that / what"},null]},{"text":"Quello è già illegale.","en":"That's already illegal.","words":[{"g":"that"},{"g":"is","l":"essere"},{"g":"already"},null]},{"text":"Molti dei voti erano illegali.","en":"Many of the votes were illegal.","words":[{"g":"much, very much, a lot","l":"molto"},{"g":"some"},{"g":"to vote [with per ‘for’","l":"votare"},{"g":"to be","l":"essere"},null]}]}