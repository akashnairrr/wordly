{"id":"mattina","lemma":"mattina","pos":"noun","rank":519,"glosses":["morning"],"ipa":"/matˈti.na/","gender":"f","forms":{"plural":"mattine"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q652_%28ita%29-LangPao-mattina.wav","examples":[{"text":"Vieni domani mattina.","en":"Come tomorrow morning.","words":[{"g":"to come","l":"venire"},{"g":"tomorrow"},null]},{"text":"Lavoro la mattina.","en":"I work in the morning.","words":[{"g":"work"},{"g":"the / her"},null]},{"text":"Legge il giornale tutte le mattine.","en":"She reads the newspaper every morning.","words":[{"g":"law"},{"g":"the"},{"g":"newspaper"},{"g":"everything, all","l":"tutto"},{"g":"the / to her"},null]},{"text":"Ho tempo domani mattina.","en":"I have time tomorrow morning.","words":[{"g":"have","l":"avere"},{"g":"time"},{"g":"tomorrow"},null]},{"text":"Che hai fatto questa mattina?","en":"What did you do this morning?","words":[{"g":"that / what"},{"g":"have","l":"avere"},{"g":"to do","l":"fare"},{"g":"this, this one, these","l":"questo"},null]}]}