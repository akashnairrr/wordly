{"id":"disprezzo","lemma":"disprezzo","pos":"noun","rank":4487,"glosses":["scorn","contempt"],"ipa":"/disˈprɛt.t͡so/","gender":"m","forms":{"plural":"disprezzi"},"examples":[{"text":"Non disprezzi gli altri.","en":"Don't look down on others.","words":[{"g":"not"},null,{"g":"the / to him"},{"g":"other","l":"altro"}]},{"text":"Io disprezzo Tom.","en":"I despise Tom.","words":[{"g":"I"},null,null]},{"text":"Tu disprezzi Tom, vero?","en":"You despise Tom, don't you?","words":[{"g":"you"},null,null,{"g":"true"}]},{"text":"La familiarità genera disprezzo.","en":"Familiarity breeds contempt.","words":[{"g":"the / her"},{"g":"familiarity"},{"g":"to procreate","l":"generare"},null]},{"text":"Non ho che disprezzo per un comportamento tanto disonesto.","en":"I feel nothing but contempt for such dishonest behavior.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"that / what"},null,{"g":"for"},{"g":"a"},{"g":"behaviour/behavior"},{"g":"so much"},{"g":"dishonest"}]}]}