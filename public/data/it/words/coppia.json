{"id":"coppia","lemma":"coppia","pos":"noun","rank":968,"glosses":["couple (people)","pair","torque"],"ipa":"/ˈkɔp.pja/","gender":"f","forms":{"plural":"coppie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q652_%28ita%29-LangPao-coppia.wav","examples":[{"text":"La vecchia coppia sembrava felice.","en":"The old couple seemed happy.","words":[null,null,null,{"g":"to seem","l":"sembrare"},{"g":"happy"}],"phrases":[[0,2,"a surname"]]},{"text":"Sono una bella coppia.","en":"They are a good couple.","words":[{"g":"am / are","l":"essere"},{"g":"a","l":"uno"},{"g":"beauty, belle"},null]},{"text":"Abbiamo invitato dieci coppie alla festa.","en":"We invited ten couples to the party.","words":[{"g":"to have","l":"avere"},{"g":"guest"},{"g":"ten"},null,{"g":"to the"},{"g":"feast"}]},{"text":"C'è una coppia qui.","en":"There's a couple here.","words":[null,{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"here"}]},{"text":"La città era piena di giovani coppie.","en":"The city was full of young couples.","words":[{"g":"the / her"},{"g":"town, city"},{"g":"to be","l":"essere"},{"g":"flood, spate"},{"g":"of"},{"g":"The young - young people"},null]}]}