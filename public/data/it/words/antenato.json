{"id":"antenato","lemma":"antenato","pos":"noun","rank":3614,"glosses":["ancestor, forefather"],"ipa":"/an.teˈna.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d9/LL-Q652_%28ita%29-LangPao-antenato.wav/LL-Q652_%28ita%29-LangPao-antenato.wav.mp3","gender":"m","forms":{"plural":"antenati","feminine":"antenata"},"examples":[{"text":"Il mio nome mi collega con i miei antenati.","en":"My name links me with my ancestors.","words":[{"g":"the"},{"g":"mine"},{"g":"name"},{"g":"me / myself"},{"g":"colleague"},{"g":"with"},{"g":"the","l":"la"},{"g":"\"my parents\""},null]},{"text":"Quella tribù venera i propri antenati.","en":"That tribe worships its ancestors.","words":[{"g":"that one","l":"quello"},{"g":"tribe"},{"g":"to venerate, revere","l":"venerare"},{"g":"the","l":"la"},{"g":"really, quite, indeed","l":"proprio"},null]},{"text":"I suoi antenati sono andati lì dall'Irlanda.","en":"His ancestors went there from Ireland.","words":[null,null,null,{"g":"am / are","l":"essere"},null,{"g":"there"},null,null],"phrases":[[0,2,"his"]]},{"text":"Gli antenati di Tom provenivano dall'Africa.","en":"Tom's ancestors came from Africa.","words":[{"g":"the / to him"},null,{"g":"of"},null,{"g":"to come","l":"provenire"},null,{"g":"African","l":"africo"}]},{"text":"I suoi antenati andarono lì dall'Irlanda.","en":"His ancestors went there from Ireland.","words":[null,null,null,{"g":"to go","l":"andare"},{"g":"there"},null,null],"phrases":[[0,2,"his"]]}]}