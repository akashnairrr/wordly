{"id":"orgoglio","lemma":"orgoglio","pos":"noun","rank":2043,"glosses":["pride"],"ipa":"/orˈɡoʎ.ʎo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0b/LL-Q652_%28ita%29-LangPao-orgoglio.wav/LL-Q652_%28ita%29-LangPao-orgoglio.wav.mp3","gender":"m","forms":{"plural":"orgogli"},"examples":[{"text":"È una questione di orgoglio.","en":"It's a matter of pride.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"question"},{"g":"of"},null]},{"text":"Il mio orgoglio non è ferito.","en":"My pride's not hurt.","words":[{"g":"the"},{"g":"mine"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"a wounded or injured…"}]},{"text":"Devi ingoiare il tuo orgoglio.","en":"You need to swallow your pride.","words":[{"g":"to owe","l":"dovere"},{"g":"to swallow"},{"g":"the"},{"g":"yours"},null]},{"text":"Il nuovo parco è l'orgoglio della nostra città.","en":"The new park is the pride of our city.","words":[{"g":"the"},{"g":"new"},{"g":"frugal"},{"g":"is","l":"essere"},null,null,{"g":"of the"},{"g":"our","l":"nostro"},{"g":"town, city"}]},{"text":"Voi dovete ingoiare il vostro orgoglio.","en":"You need to swallow your pride.","words":[{"g":"you (pl.)"},{"g":"to owe","l":"dovere"},{"g":"to swallow"},{"g":"the"},{"g":"yours"},null]}]}