{"id":"vantaggio","lemma":"vantaggio","pos":"noun","rank":1602,"glosses":["advantage, vantage","favour/favor, plus, benefit, edge"],"ipa":"/vanˈtad.d͡ʒo/","gender":"m","forms":{"plural":"vantaggi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q652_%28ita%29-LangPao-vantaggio.wav","examples":[{"text":"Che vantaggio hanno?","en":"What advantage do they have?","words":[{"g":"that / what"},null,{"g":"to have","l":"avere"}]},{"text":"Questi sono i vantaggi.","en":"These are the advantages.","words":[{"g":"this, this one, these","l":"questo"},{"g":"am / are","l":"essere"},{"g":"the","l":"la"},null]},{"text":"Ha un piccolo vantaggio.","en":"He has a small advantage.","words":[{"g":"has","l":"avere"},{"g":"a"},{"g":"small"},null]},{"text":"Quali sarebbero i vantaggi?","en":"What would the advantages be?","words":[{"g":"what?","l":"quale"},{"g":"to be","l":"essere"},{"g":"the","l":"la"},null]},{"text":"Abbiamo un vantaggio enorme.","en":"We have a huge advantage.","words":[{"g":"to have","l":"avere"},{"g":"a"},null,{"g":"huge"}]}]}