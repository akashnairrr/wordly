{"id":"mezzogiorno","lemma":"mezzogiorno","pos":"noun","rank":2527,"glosses":["midday, noon","south"],"ipa":"/ˌmɛd.d͡zoˈd͡ʒor.no/","gender":"m","forms":{"plural":"mezzogiorni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q652_%28ita%29-LangPao-mezzogiorno.wav","examples":[{"text":"Vieni a mezzogiorno.","en":"Come at noon.","words":[{"g":"to come","l":"venire"},{"g":"to / at"},null]},{"text":"Sarò qui fino a mezzogiorno.","en":"I'm going to be here until noon.","words":[{"g":"to be","l":"essere"},{"g":"here"},null,null,null],"phrases":[[2,4,"up to"]]},{"text":"Lui viene a mezzogiorno.","en":"He comes at noon.","words":[{"g":"he"},{"g":"to come","l":"venire"},{"g":"to / at"},null]},{"text":"Il pranzo è a mezzogiorno.","en":"Lunch is at noon.","words":[{"g":"the"},{"g":"lunch or dinner"},{"g":"is","l":"essere"},{"g":"to / at"},null]},{"text":"Ero a casa fino a mezzogiorno ieri.","en":"I was at home until noon yesterday.","words":[{"g":"to be","l":"essere"},{"g":"to / at"},{"g":"house"},null,null,null,{"g":"yesterday"}],"phrases":[[3,5,"up to"]]}]}