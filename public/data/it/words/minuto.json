{"id":"minuto","lemma":"minuto","pos":"adj","rank":267,"glosses":["tiny, minute, emaciated, thin","fine, delicate, detailed"],"ipa":"/miˈnu.to/","forms":{"feminine":"minuta","masculinePlural":"minuti","femininePlural":"minute"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q652_%28ita%29-LangPao-minuto.wav","examples":[{"text":"Mi puoi dare un minuto?","en":"Can you give me a minute?","words":[{"g":"me / myself"},{"g":"can, could","l":"potere"},{"g":"to give"},{"g":"a"},null]},{"text":"Posso essere là in dieci minuti.","en":"I can be there in ten minutes.","words":[{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"there"},{"g":"in"},{"g":"ten"},null]},{"text":"Ti posso parlare per un minuto?","en":"Can I talk to you for a minute?","words":[{"g":"you"},{"g":"can, could","l":"potere"},{"g":"to talk, to speak"},{"g":"for"},{"g":"a"},null]},{"text":"Ho le minute della riunione.","en":"I have the minutes of the meeting.","words":[{"g":"have","l":"avere"},{"g":"the / to her"},null,{"g":"of the"},{"g":"meeting"}]},{"text":"Ci dia tre minuti.","en":"Give us three minutes.","words":[{"g":"us / there"},{"g":"to give","l":"dare"},{"g":"three"},null]}]}