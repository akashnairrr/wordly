{"id":"uscita","lemma":"uscita","pos":"noun","rank":620,"glosses":["exit, way out","loophole","outing, trip"],"ipa":"/uʃˈʃi.ta/","gender":"f","forms":{"plural":"uscite"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q652_%28ita%29-LangPao-uscita.wav","examples":[{"text":"Quando sei uscita di prigione?","en":"When did you get out of jail?","words":[{"g":"when"},{"g":"are","l":"essere"},null,{"g":"of"},{"g":"jail, prison"}]},{"text":"È uscita senza dire una parola.","en":"She went out without saying a word.","words":[{"g":"is","l":"essere"},null,{"g":"without, -less"},{"g":"to utter with one's…"},{"g":"a","l":"uno"},{"g":"word"}]},{"text":"Perché è uscita di fretta?","en":"Why did she go out in a hurry?","words":[{"g":"why / because"},{"g":"is","l":"essere"},null,{"g":"of"},{"g":"hurry, haste, rush"}]},{"text":"L'uscita è sulla sinistra.","en":"The exit is on the left.","words":[null,null,{"g":"is","l":"essere"},{"g":"plant of the genus Sulla"},{"g":"left"}]},{"text":"È uscita dalla stanza.","en":"She went out of the room.","words":[{"g":"is","l":"essere"},null,null,{"g":"room"}]}]}