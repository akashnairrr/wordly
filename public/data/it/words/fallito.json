{"id":"fallito","lemma":"fallito","pos":"adj","rank":1608,"glosses":["bankrupt","unsuccessful"],"ipa":"/falˈli.to/","forms":{"feminine":"fallita","masculinePlural":"falliti","femininePlural":"fallite"},"examples":[{"text":"Perché abbiamo fallito?","en":"Why have we failed?","words":[{"g":"why / because"},{"g":"to have","l":"avere"},null]},{"text":"Senza il tuo aiuto, avrei fallito.","en":"Without your help, I would have failed.","words":[{"g":"without, -less"},{"g":"the"},{"g":"yours"},{"g":"help, assistance, aid"},{"g":"to have","l":"avere"},null]},{"text":"Che fallita!","en":"What a loser!","words":[{"g":"that / what"},null]},{"text":"Ho fallito tre volte.","en":"I failed three times.","words":[{"g":"have","l":"avere"},null,{"g":"three"},{"g":"time","l":"volta"}]},{"text":"Tutti i nostri tentativi sono falliti.","en":"All of our attempts failed.","words":[{"g":"all"},{"g":"the","l":"la"},{"g":"our","l":"nostro"},{"g":"attempt","l":"tentativo"},{"g":"am / are","l":"essere"},null]}]}