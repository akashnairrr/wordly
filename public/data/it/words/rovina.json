{"id":"rovina","lemma":"rovina","pos":"noun","rank":2347,"glosses":["ruin, destruction, downfall, collapse","ruins, remains, debris","bane"],"ipa":"/roˈvi.na/","gender":"f","forms":{"plural":"rovine"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q652_%28ita%29-LangPao-rovina.wav","examples":[{"text":"Il castello ora è in rovina.","en":"The castle is now in ruins.","words":[{"g":"the"},{"g":"castle"},{"g":"now"},{"g":"is","l":"essere"},{"g":"in"},null]},{"text":"Queste sono le rovine di un castello.","en":"These are the ruins of a castle.","words":[{"g":"this, this one, these","l":"questo"},{"g":"am / are","l":"essere"},{"g":"the / to her"},null,{"g":"of"},{"g":"a"},{"g":"castle"}]},{"text":"Il bere fu la sua rovina.","en":"Drinking was his ruin.","words":[{"g":"the"},{"g":"to drink"},{"g":"deceased, late"},{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null]},{"text":"Tom rovina tutto.","en":"Tom ruins everything.","words":[null,null,{"g":"everything, all"}]},{"text":"Le rovine meritano una visita.","en":"The ruins are worth visiting.","words":[{"g":"the / to her"},null,{"g":"to deserve, merit","l":"meritare"},{"g":"a","l":"uno"},{"g":"visit"}]}]}