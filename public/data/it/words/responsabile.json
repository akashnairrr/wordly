{"id":"responsabile","lemma":"responsabile","pos":"noun","rank":845,"glosses":["person responsible, manager","person in charge","culprit"],"ipa":"/res.ponˈsa.bi.le/","gender":"mf","forms":{"plural":"responsabili"},"examples":[{"text":"Ne è responsabile.","en":"He is responsible for it.","words":[{"g":"of it"},{"g":"is","l":"essere"},null]},{"text":"Ne siamo in parte responsabili.","en":"We are in part responsible for it.","words":[{"g":"of it"},{"g":"to be","l":"essere"},null,null,null],"phrases":[[2,4,"in part, partly, part"]]},{"text":"Chi è esattamente il responsabile?","en":"Who exactly is responsible?","words":[{"g":"who"},{"g":"is","l":"essere"},{"g":"exactly"},{"g":"the"},null]},{"text":"Siete responsabili della morte del bambino.","en":"You are responsible for the death of the child.","words":[{"g":"to be","l":"essere"},null,{"g":"of the"},{"g":"death"},{"g":"of the"},{"g":"child"}]},{"text":"Voglio parlare col responsabile.","en":"I want to speak to the person in charge.","words":[{"g":"to want","l":"volere"},{"g":"to talk, to speak"},null,null]}]}