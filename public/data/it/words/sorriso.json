{"id":"sorriso","lemma":"sorriso","pos":"noun","rank":1443,"glosses":["smile"],"ipa":"/sorˈri.zo/","gender":"m","forms":{"plural":"sorrisi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q652_%28ita%29-LangPao-sorriso.wav","examples":[{"text":"Hai un bel sorriso.","en":"You have a nice smile.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"nice","l":"bello"},null]},{"text":"La ragazza mi ha sorriso.","en":"The girl smiled at me.","words":[{"g":"the / her"},{"g":"girl, young woman"},{"g":"me / myself"},{"g":"has","l":"avere"},null]},{"text":"Amo il tuo sorriso.","en":"I love your smile.","words":[{"g":"to love, to like","l":"amare"},{"g":"the"},{"g":"yours"},null]},{"text":"Hanno sorriso tutte.","en":"They all smiled.","words":[{"g":"to have","l":"avere"},null,{"g":"everything, all","l":"tutto"}]},{"text":"Un sorriso non costa nulla.","en":"A smile doesn't cost anything.","words":[{"g":"a"},null,{"g":"not"},{"g":"to cost","l":"costare"},{"g":"nothing, anything"}]}]}