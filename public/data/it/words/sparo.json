{"id":"sparo","lemma":"sparo","pos":"noun","rank":1487,"glosses":["shot, gunshot (from a gun)","the sound of a shot","silver bream (Blicca bjoerkna, syn. Abramis bjoerkna)"],"ipa":"/ˈspa.ro/","gender":"m","forms":{"plural":"spari"},"examples":[{"text":"Fermo o sparo.","en":"Stop or I'll shoot.","words":[{"g":"act of stopping or…"},{"g":"or"},null]},{"text":"Qualcuno ha sentito lo sparo?","en":"Did anyone hear the gun shot?","words":[{"g":"someone, somebody"},{"g":"has","l":"avere"},{"g":"sincere"},{"g":"the / it"},null]},{"text":"Abbiamo sentito uno sparo.","en":"We heard a gunshot.","words":[{"g":"to have","l":"avere"},{"g":"sincere"},{"g":"a / one"},null]},{"text":"A che ora ha sentito lo sparo?","en":"At what time did you hear the gunshot?","words":[{"g":"to / at"},{"g":"that / what"},{"g":"now"},{"g":"has","l":"avere"},{"g":"sincere"},{"g":"the / it"},null]},{"text":"Gli sparo.","en":"I will shoot him.","words":[{"g":"the / to him"},null]}]}