{"id":"dolce","lemma":"dolce","pos":"adj","rank":628,"glosses":["sweet","gentle, mild","luscious, sooth"],"ipa":"/ˈdol.t͡ʃe/","forms":{"plural":"dolci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q652_%28ita%29-LangPao-dolce.wav","examples":[{"text":"La vita è dolce.","en":"Life is sweet.","audio":"https://tatoeba.org/en/audio/download/1000268","words":[{"g":"the / her"},{"g":"life"},{"g":"is","l":"essere"},null]},{"text":"Tutto lo zucchero è dolce.","en":"All sugar is sweet.","audio":"https://tatoeba.org/en/audio/download/1003927","words":[{"g":"everything, all"},{"g":"the / it"},{"g":"sugar"},{"g":"is","l":"essere"},null]},{"text":"Siete molto dolci.","en":"You're very sweet.","words":[{"g":"to be","l":"essere"},{"g":"very / a lot"},null]},{"text":"Ha una voce dolce.","en":"He has a sweet voice.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},{"g":"voice"},null]},{"text":"Quanti dolci hai comprato?","en":"How much candy did you buy?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"have","l":"avere"},{"g":"to buy","l":"comprare"}]}]}