{"id":"volta","lemma":"volta","pos":"noun","rank":108,"glosses":["time, instance, occasion","turn","vault"],"ipa":"/ˈvɔl.ta/","gender":"f","forms":{"plural":"volte"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q652_%28ita%29-LangPao-volta.wav","examples":[{"text":"Funziona ogni volta.","en":"It works every time.","words":[{"g":"to function, to work","l":"funzionare"},{"g":"each, every"},null]},{"text":"Farò meglio questa volta.","en":"I'll do better this time.","words":[{"g":"to do","l":"fare"},{"g":"better"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Devi fare questo ogni volta?","en":"Must you do this every time?","words":[{"g":"to owe","l":"dovere"},{"g":"to do"},{"g":"this"},{"g":"each, every"},null]},{"text":"Ora è la tua volta.","en":"Now is your time.","words":[{"g":"now"},{"g":"is","l":"essere"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Questa è l'ultima volta.","en":"This is the last time.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},null,{"g":"last","l":"ultimo"},null]}]}