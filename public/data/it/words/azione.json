{"id":"azione","lemma":"azione","pos":"noun","rank":1060,"glosses":["action, deed","share (finance)"],"ipa":"/atˈt͡sjo.ne/","gender":"f","forms":{"plural":"azioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q652_%28ita%29-LangPao-azione.wav","examples":[{"text":"È un uomo d'azione.","en":"He is a man of action.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},null,null]},{"text":"Un uomo è responsabile delle sue azioni.","en":"A man is responsible for his deeds.","words":[{"g":"a"},{"g":"person, man"},{"g":"is","l":"essere"},{"g":"person responsible"},null,{"g":"his, hers, its","l":"suo"},null]},{"text":"Vogliamo azione.","en":"We want action.","words":[{"g":"to want","l":"volere"},null]},{"text":"Ogni azione ha le sue conseguenze.","en":"Every action has its consequence.","words":[{"g":"each, every"},null,{"g":"has","l":"avere"},null,null,{"g":"consequence","l":"conseguenza"}],"phrases":[[3,5,"his"]]},{"text":"Le azioni sono più importanti delle parole.","en":"Actions are more important than words.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"more"},{"g":"important","l":"importante"},null,{"g":"lyrics, words"}]}]}