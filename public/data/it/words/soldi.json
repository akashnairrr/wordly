{"id":"soldi","lemma":"soldi","pos":"noun","rank":159,"glosses":["money"],"ipa":"/ˈsɔl.di/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/It-i_soldi.ogg/It-i_soldi.ogg.mp3","gender":"m","examples":[{"text":"Hai i soldi?","en":"Do you have the money?","words":[{"g":"have","l":"avere"},{"g":"the","l":"la"},null]},{"text":"Posso avere i soldi ora?","en":"Can I have the money now?","words":[{"g":"can, could","l":"potere"},{"g":"to have"},{"g":"the","l":"la"},null,{"g":"now"}]},{"text":"Avete molti soldi?","en":"Do you have a lot of money?","words":[{"g":"to have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Prendi questi soldi.","en":"Take this money.","words":[{"g":"to take","l":"prendere"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Voglio più soldi.","en":"I want more money.","words":[{"g":"to want","l":"volere"},{"g":"more"},null]}]}