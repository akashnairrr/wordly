{"id":"teoria","lemma":"teoria","pos":"noun","rank":1162,"glosses":["theory"],"ipa":"/te.oˈri.a/","gender":"f","forms":{"plural":"teorie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q652_%28ita%29-Jennum-teoria.wav","examples":[{"text":"Hai una teoria?","en":"Do you have a theory?","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Ho qualche teoria.","en":"I have a few theories.","words":[{"g":"have","l":"avere"},{"g":"few"},null]},{"text":"Non è solo una teoria.","en":"It's not just a theory.","words":[{"g":"not"},{"g":"is","l":"essere"},{"g":"only, just"},{"g":"a","l":"uno"},null]},{"text":"Che teoria interessante!","en":"What an interesting theory!","words":[{"g":"that / what"},null,{"g":"interesting"}]},{"text":"Non credo a queste teorie del complotto.","en":"I don't believe these conspiracy theories.","words":[{"g":"not"},{"g":"to believe","l":"credere"},{"g":"to / at"},{"g":"this, this one, these","l":"questo"},null,{"g":"of the"},{"g":"plot, conspiracy"}]}]}