{"id":"ragionevole","lemma":"ragionevole","pos":"adj","rank":2442,"glosses":["rational (capable of reasoning)","sensible (acting with or showing good judgement)","reasonable (agreeable to reason)"],"ipa":"/ra.d͡ʒoˈne.vo.le/","forms":{"plural":"ragionevoli"},"examples":[{"text":"Mi sembra ragionevole.","en":"That seems reasonable to me.","words":[{"g":"me / myself"},{"g":"to seem","l":"sembrare"},null]},{"text":"Queste regole sono ragionevoli.","en":"These rules are reasonable.","words":[{"g":"this, this one, these","l":"questo"},{"g":"rule","l":"regola"},{"g":"am / are","l":"essere"},null]},{"text":"Il prezzo è ragionevole.","en":"The price is reasonable.","words":[{"g":"the"},{"g":"price"},{"g":"is","l":"essere"},null]},{"text":"Ora siate ragionevoli.","en":"Now be reasonable.","words":[{"g":"now"},{"g":"to be","l":"essere"},null]},{"text":"Ora sii ragionevole.","en":"Now be reasonable.","words":[{"g":"now"},{"g":"to be","l":"essere"},null]}]}