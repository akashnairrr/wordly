{"id":"processo","lemma":"processo","pos":"noun","rank":769,"glosses":["trial, action, lawsuit, suit, proceedings","process, course, method","process"],"ipa":"/proˈt͡ʃɛs.so/","gender":"m","forms":{"plural":"processi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q652_%28ita%29-DiplomaticBadger-processo.wav","examples":[{"text":"Ci fu un processo.","en":"There was a trial.","words":[{"g":"us / there"},{"g":"deceased, late"},{"g":"a"},null]},{"text":"È un processo molto semplice.","en":"It's a very simple process.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"very / a lot"},{"g":"simple"}]},{"text":"Il processo non è perfetto.","en":"The process isn't perfect.","words":[{"g":"the"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"perfect"}]},{"text":"Questo è un processo in corso.","en":"This is an ongoing process.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null,null,null],"phrases":[[4,6,"ongoing"]]},{"text":"Il processo era piuttosto chiaro.","en":"The process was pretty clear.","words":[{"g":"the"},null,{"g":"to be","l":"essere"},{"g":"rather than"},{"g":"bright, shiny"}]}]}