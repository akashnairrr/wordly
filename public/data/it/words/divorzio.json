{"id":"divorzio","lemma":"divorzio","pos":"noun","rank":1491,"glosses":["divorce"],"ipa":"/diˈvɔr.t͡sjo/","gender":"m","forms":{"plural":"divorzi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q652_%28ita%29-LangPao-divorzio.wav","examples":[{"text":"Stai seriamente pensando al divorzio?","en":"Are you seriously thinking about divorce?","words":[{"g":"to stay, remain","l":"stare"},{"g":"seriously"},{"g":"to think","l":"pensare"},{"g":"to the"},null]},{"text":"Era solo dopo il suo divorzio.","en":"He was lonely after his divorce.","words":[{"g":"to be","l":"essere"},{"g":"only, just"},{"g":"next, after, following"},{"g":"the"},{"g":"his, hers, its"},null]},{"text":"Ho chiesto il divorzio.","en":"I've asked for a divorce.","words":[{"g":"have","l":"avere"},{"g":"to ask","l":"chiedere"},{"g":"the"},null]},{"text":"Non si vedono dal divorzio.","en":"They haven't seen each other since the divorce.","words":[{"g":"not"},{"g":"oneself"},{"g":"to see","l":"vedere"},{"g":"since"},null]},{"text":"Il divorzio è stressante.","en":"Divorce is stressful.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"stressful"}]}]}