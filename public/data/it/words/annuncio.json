{"id":"annuncio","lemma":"annuncio","pos":"noun","rank":2058,"glosses":["act of announcing, announcement","announcement, notice, news","advertisement, ad, advert"],"ipa":"/anˈnun.t͡ʃo/","gender":"m","forms":{"plural":"annunci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q652_%28ita%29-LangPao-annuncio.wav","examples":[{"text":"Ecco un annuncio importante.","en":"Here's an important announcement.","words":[{"g":"here is, there is"},{"g":"a"},null,{"g":"important"}]},{"text":"Ho un grande annuncio da fare.","en":"I have a big announcement to make.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"adult, grownup"},null,{"g":"from"},{"g":"to do"}]},{"text":"Ho visto l'annuncio.","en":"I saw the announcement.","words":[{"g":"have","l":"avere"},{"g":"visa"},null,null]},{"text":"L'annuncio è molto ingannevole.","en":"The announcement is very deceiving.","words":[null,null,{"g":"is","l":"essere"},{"g":"very / a lot"},{"g":"deceptive, misleading"}]},{"text":"Il primo ministro farà un annuncio domani.","en":"The prime minister will make an announcement tomorrow.","words":[{"g":"the"},null,null,{"g":"to do","l":"fare"},{"g":"a"},null,{"g":"tomorrow"}],"phrases":[[1,3,"prime minister"]]}]}