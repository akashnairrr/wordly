{"id":"indosso","lemma":"indosso","pos":"adv","rank":2995,"glosses":["on (especially with reference to clothes or jewelry etc.)"],"ipa":"/inˈdɔs.so/","examples":[{"text":"Non ho indosso nulla per oggi.","en":"I have nothing on for today.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"nothing, anything"},{"g":"for"},{"g":"today"}]},{"text":"Non indosso mai una giacca.","en":"I never wear a jacket.","words":[{"g":"not"},null,{"g":"never"},{"g":"a","l":"uno"},{"g":"jacket, coat"}]},{"text":"Non indosso questo da anni.","en":"I haven't worn this in years.","words":[{"g":"not"},null,{"g":"this"},{"g":"from"},{"g":"year","l":"anno"}]},{"text":"Stai bene senza occhiali indosso.","en":"You look good without your glasses on.","words":[{"g":"to stay, remain","l":"stare"},{"g":"well"},{"g":"without, -less"},{"g":"glasses"},null]},{"text":"Indosso sempre una camicia bianca.","en":"I always wear a white shirt.","words":[null,{"g":"always"},{"g":"a","l":"uno"},{"g":"shirt, dress shirt"},{"g":"cue ball"}]}]}