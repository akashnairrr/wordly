{"id":"intero","lemma":"intero","pos":"adj","rank":830,"glosses":["whole, entire","intact","complete, full, total"],"ipa":"/inˈtɛ.ro/","forms":{"feminine":"intera","masculinePlural":"interi","femininePlural":"intere"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q652_%28ita%29-LangPao-intero.wav","examples":[{"text":"Questo è latte intero.","en":"This is whole milk.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"milk"},null]},{"text":"L'intera nazione vuole la pace.","en":"The whole nation wants peace.","words":[null,null,{"g":"nation"},{"g":"to want","l":"volere"},{"g":"the / her"},{"g":"peace be with you"}]},{"text":"Hai letto il libro per intero?","en":"Did you read the whole book?","words":[{"g":"have","l":"avere"},{"g":"bed"},{"g":"the"},{"g":"book"},{"g":"for"},null]},{"text":"Voglio sentire la storia intera.","en":"I want to hear the whole story.","words":[{"g":"to want","l":"volere"},{"g":"to feel"},{"g":"the / her"},{"g":"history"},null]},{"text":"Il mondo intero è nelle nostre mani.","en":"The whole world's in our hands.","words":[{"g":"the"},{"g":"world"},null,{"g":"is","l":"essere"},null,{"g":"our","l":"nostro"},{"g":"manes"}]}]}