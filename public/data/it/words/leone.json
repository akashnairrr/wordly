{"id":"leone","lemma":"leone","pos":"noun","rank":2349,"glosses":["lion","Leo, the Zodiac sign for the lion, covering July 23 - August 22"],"ipa":"/leˈo.ne/","gender":"m","forms":{"plural":"leoni","feminine":"leonessa"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q652_%28ita%29-XANA000-leone.wav","formAudio":{"leoni":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q652_%28ita%29-XANA000-Leoni.wav","leonessa":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q652_%28ita%29-DivoLetto-leonessa.wav"},"examples":[{"text":"Vedo un leone.","en":"I see a lion.","audio":"https://tatoeba.org/en/audio/download/994224","words":[{"g":"to see","l":"vedere"},{"g":"a"},null]},{"text":"Questo è un leone.","en":"This is a lion.","audio":"https://tatoeba.org/en/audio/download/1000281","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Voglio vedere il leone.","en":"I want to see the lion.","words":[{"g":"to want","l":"volere"},{"g":"to see"},{"g":"the"},null]},{"text":"Dove sono i leoni e le tigri?","en":"Where are the lions and tigers?","words":[{"g":"where"},{"g":"am / are","l":"essere"},{"g":"the","l":"la"},null,{"g":"and"},{"g":"the / to her"},{"g":"tiger","l":"tigre"}]},{"text":"Hai mai visto un leone?","en":"Have you ever seen a lion?","words":[{"g":"have","l":"avere"},{"g":"never"},{"g":"visa"},{"g":"a"},null]}]}