{"id":"braccio","lemma":"braccio","pos":"noun","rank":749,"glosses":["arm","upper arm","fathom"],"ipa":"/ˈbrat.t͡ʃo/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q652_%28ita%29-LangPao-braccio.wav","examples":[{"text":"Ti sei rotto il braccio.","en":"You broke your arm.","audio":"https://tatoeba.org/en/audio/download/1004772","words":[{"g":"you"},{"g":"are","l":"essere"},{"g":"broken"},{"g":"the"},null]},{"text":"Il braccio mi fa ancora male.","en":"My arm still hurts.","audio":"https://tatoeba.org/en/audio/download/1003960","words":[{"g":"the"},null,{"g":"me / myself"},{"g":"to do","l":"fare"},{"g":"still / again"},{"g":"evil, harm"}]},{"text":"Ha un libro sotto il braccio.","en":"She has a book under her arm.","words":[{"g":"has","l":"avere"},{"g":"a"},{"g":"book"},{"g":"down"},{"g":"the"},null]},{"text":"Ho un dolore al braccio.","en":"I have an ache in my arm.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"ache, pain"},{"g":"to the"},null]},{"text":"Mi ha preso per il braccio.","en":"He caught me by the arm.","words":[{"g":"me / myself"},{"g":"has","l":"avere"},{"g":"to take","l":"prendere"},{"g":"for"},{"g":"the"},null]}]}