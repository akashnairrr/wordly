{"id":"sedile","lemma":"sedile","pos":"noun","rank":2789,"glosses":["seat (in a vehicle)","bench"],"ipa":"/seˈdi.le/","gender":"m","forms":{"plural":"sedili"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q652_%28ita%29-LangPao-sedile.wav","examples":[{"text":"Scambieresti sedile con me?","en":"Will you switch seats with me?","words":[{"g":"to exchange","l":"scambiare"},null,{"g":"with"},{"g":"me"}]},{"text":"Non posso fissare il sedile.","en":"I can't fix the seat.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to fasten, fix, secure"},{"g":"the"},null]},{"text":"I sedili erano comodi.","en":"The seats were comfortable.","words":[{"g":"the","l":"la"},null,{"g":"to be","l":"essere"},{"g":"convenient, handy","l":"comodo"}]},{"text":"Ero sul sedile anteriore.","en":"I was in the front seat.","words":[{"g":"to be","l":"essere"},null,null,{"g":"front, fore in space"}]},{"text":"Non riesco a riparare il sedile.","en":"I can't fix the seat.","words":[{"g":"not"},{"g":"to manage","l":"riuscire"},{"g":"to / at"},{"g":"to repair"},{"g":"the"},null]}]}