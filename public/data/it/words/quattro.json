{"id":"quattro","lemma":"quattro","pos":"noun","rank":338,"glosses":["four"],"ipa":"/ˈkwat.tro/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q652_%28ita%29-XANA000-quattro.wav","examples":[{"text":"Siamo una famiglia di quattro persone.","en":"We are a family of four.","words":[{"g":"to be","l":"essere"},{"g":"a","l":"uno"},{"g":"family"},{"g":"of"},null,{"g":"person","l":"persona"}]},{"text":"Il libro costa quattro dollari.","en":"The book costs 4 dollars.","words":[{"g":"the"},{"g":"book"},{"g":"to cost","l":"costare"},null,{"g":"dollar","l":"dollaro"}]},{"text":"Mia madre ha quattro fratelli.","en":"My mother has four brothers.","words":[{"g":"mine","l":"mio"},{"g":"mother"},{"g":"has","l":"avere"},null,{"g":"brother, sibling","l":"fratello"}]},{"text":"Due più due fa quattro.","en":"Two plus two makes four.","words":[{"g":"two"},{"g":"more"},{"g":"two"},{"g":"to do","l":"fare"},null]},{"text":"Sarà qui per le quattro.","en":"He'll be here around four o'clock.","words":[{"g":"to be","l":"essere"},{"g":"here"},{"g":"for"},{"g":"the / to her"},null]}]}