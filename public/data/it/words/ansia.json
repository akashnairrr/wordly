{"id":"ansia","lemma":"ansia","pos":"noun","rank":2506,"glosses":["anxiety, apprehension","eagerness"],"ipa":"/ˈan.sja/","gender":"f","forms":{"plural":"ansie"},"examples":[{"text":"Sono in ansia per il vostro aiuto.","en":"They are anxious for your help.","words":[{"g":"am / are","l":"essere"},{"g":"in"},null,{"g":"for"},{"g":"the"},{"g":"yours"},{"g":"help, assistance, aid"}]},{"text":"È in ansia per la sua sicurezza.","en":"She is anxious about his safety.","words":[{"g":"is","l":"essere"},{"g":"in"},null,{"g":"for"},{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"safety, security"}]},{"text":"Tutti erano in ansia.","en":"Everyone was apprehensive.","words":[{"g":"all"},{"g":"to be","l":"essere"},{"g":"in"},null]},{"text":"Quello mi fa venire l'ansia.","en":"That gives me the heebie jeebies.","words":[{"g":"that"},{"g":"me / myself"},{"g":"to do","l":"fare"},{"g":"to come"},null,null]},{"text":"Causò molta ansia ai suoi genitori.","en":"He caused his parents a lot of anxiety.","words":[{"g":"to cause","l":"causare"},{"g":"much, very much, a lot","l":"molto"},null,null,{"g":"\"his/her parents\""},{"g":"parent","l":"genitore"}]}]}