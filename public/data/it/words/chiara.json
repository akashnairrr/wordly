{"id":"chiara","lemma":"chiara","pos":"noun","rank":1908,"glosses":["egg white"],"ipa":"/ˈkja.ra/","gender":"f","forms":{"plural":"chiare"},"examples":[{"text":"È chiara ora?","en":"Is it clear now?","words":[{"g":"is","l":"essere"},null,{"g":"now"}]},{"text":"La legge è molto chiara.","en":"The law is very clear.","words":[{"g":"the / her"},{"g":"law"},{"g":"is","l":"essere"},{"g":"very / a lot"},null]},{"text":"Voglio solo una risposta chiara.","en":"I just want a clear answer.","words":[{"g":"to want","l":"volere"},{"g":"only, just"},{"g":"a","l":"uno"},{"g":"answer"},null]},{"text":"Credo che la scelta sia chiara.","en":"I believe the choice is clear.","words":[{"g":"to believe","l":"credere"},{"g":"that / what"},{"g":"the / her"},{"g":"choice"},{"g":"both ... and .."},null]},{"text":"La causa non era chiara.","en":"The cause was unclear.","words":[{"g":"the / her"},{"g":"cause"},{"g":"not"},{"g":"to be","l":"essere"},null]}]}