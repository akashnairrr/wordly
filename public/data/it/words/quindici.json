{"id":"quindici","lemma":"quindici","pos":"num","rank":2057,"glosses":["fifteen"],"ipa":"/ˈkwin.di.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/60/LL-Q652_%28ita%29-XANA000-quindici.wav","examples":[{"text":"Ha non più di quindici dollari.","en":"She has no more than fifteen dollars.","words":[{"g":"has","l":"avere"},{"g":"not"},{"g":"more"},{"g":"of"},null,{"g":"dollar","l":"dollaro"}]},{"text":"Mia figlia ha appena quindici anni.","en":"My daughter is barely fifteen.","words":[{"g":"mine","l":"mio"},{"g":"daughter"},{"g":"has","l":"avere"},{"g":"barely, hardly"},null,{"g":"year","l":"anno"}]},{"text":"L'autobus parte ogni quindici minuti.","en":"The bus leaves every fifteen minutes.","words":[null,{"g":"bus"},{"g":"part"},{"g":"each, every"},null,{"g":"tiny","l":"minuto"}]},{"text":"C'è un autobus ogni quindici minuti.","en":"There is a bus every fifteen minutes.","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"bus"},{"g":"each, every"},null,{"g":"tiny","l":"minuto"}]},{"text":"Costerà circa quindici dollari.","en":"It will cost around fifteen dollars.","words":[{"g":"to cost","l":"costare"},{"g":"regarding, concerning"},null,{"g":"dollar","l":"dollaro"}]}]}