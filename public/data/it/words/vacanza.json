{"id":"vacanza","lemma":"vacanza","pos":"noun","rank":1302,"glosses":["holiday (UK), vacation (US) (official holiday period)"],"ipa":"/vaˈkan.t͡sa/","gender":"f","forms":{"plural":"vacanze"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q652_%28ita%29-LangPao-vacanza.wav","examples":[{"text":"Quante settimane di vacanza hai?","en":"How many weeks of vacation do you have?","words":[{"g":"how much, however much","l":"quanto"},{"g":"week","l":"settimana"},{"g":"of"},null,{"g":"have","l":"avere"}]},{"text":"Sono qui solo per le vacanze.","en":"I'm here just for the holidays.","words":[{"g":"am / are","l":"essere"},{"g":"here"},{"g":"only, just"},{"g":"for"},{"g":"the / to her"},null]},{"text":"Domani è vacanza.","en":"Tomorrow is a holiday.","words":[{"g":"tomorrow"},{"g":"is","l":"essere"},null]},{"text":"Cosa hai fatto durante le vacanze?","en":"What did you do during the holidays?","words":[{"g":"thing"},{"g":"have","l":"avere"},{"g":"to do","l":"fare"},{"g":"during"},{"g":"the / to her"},null]},{"text":"Quando vai in vacanza?","en":"When do you go on vacation?","words":[{"g":"when"},{"g":"to go","l":"andare"},{"g":"in"},null]}]}