{"id":"attimo","lemma":"attimo","pos":"noun","rank":340,"glosses":["moment, instant, second","bit"],"ipa":"/ˈat.ti.mo/","gender":"m","forms":{"plural":"attimi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q652_%28ita%29-LangPao-attimo.wav","examples":[{"text":"Puoi rimanere un attimo?","en":"Can you stay for a bit?","words":[{"g":"can, could","l":"potere"},{"g":"to stay"},{"g":"a"},null]},{"text":"Può restare un attimo?","en":"Can you stay for a bit?","words":[{"g":"can, could","l":"potere"},{"g":"to stay, to remain"},{"g":"a"},null]},{"text":"Solo un attimo, per piacere.","en":"Just a moment, please.","words":[{"g":"only, just"},{"g":"a"},null,null,null],"phrases":[[3,5,"please"]]},{"text":"Posso parlarti un attimo nel mio ufficio?","en":"Can I see you a moment in my office?","words":[{"g":"can, could","l":"potere"},null,{"g":"a"},null,{"g":"in the"},{"g":"mine"},{"g":"office"}]},{"text":"Mi ci faccia pensare un attimo.","en":"Let me think for a while.","words":[{"g":"me / myself"},{"g":"us / there"},{"g":"face"},{"g":"to think"},{"g":"a"},null]}]}