{"id":"neve","lemma":"neve","pos":"noun","rank":1537,"glosses":["snow","snow (cocaine)"],"ipa":"/ˈne.ve/","gender":"f","forms":{"plural":"nevi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q652_%28ita%29-XANA000-neve.wav","examples":[{"text":"Ti piace la neve?","en":"Do you like snow?","audio":"https://tatoeba.org/en/audio/download/1001455","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the / her"},null]},{"text":"Ehi, guarda la neve.","en":"Hey, look at the snow.","words":[{"g":"hey!"},{"g":"to look at","l":"guardare"},{"g":"the / her"},null]},{"text":"Hai un gatto delle nevi?","en":"Do you have a snowmobile?","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"cat"},null,null]},{"text":"Hai molta neve nel tuo paese?","en":"Do you have much snow in your country?","words":[{"g":"have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"in the"},{"g":"yours"},{"g":"country"}]},{"text":"Ci sarà la neve domani.","en":"There will be snow tomorrow.","words":[{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"the / her"},null,{"g":"tomorrow"}]}]}