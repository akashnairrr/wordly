{"id":"avviso","lemma":"avviso","pos":"noun","rank":2513,"glosses":["notice (publication or document)","warning, advice, reminder","announcement, advertisement, sign"],"ipa":"/avˈvi.so/","gender":"m","forms":{"plural":"avvisi"},"examples":[{"text":"Probabilmente è un avviso.","en":"It's probably a warning.","words":[{"g":"probably"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Non ho ricevuto alcun avviso che sta arrivando.","en":"I haven't received any notice that she's coming.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"to receive","l":"ricevere"},null,null,{"g":"that / what"},{"g":"to stay, remain","l":"stare"},{"g":"to arrive","l":"arrivare"}]},{"text":"Abbiamo ricevuto un avviso di sfratto.","en":"We received an eviction notice.","words":[{"g":"to have","l":"avere"},{"g":"to receive","l":"ricevere"},{"g":"a"},null,{"g":"of"},{"g":"notice to quit"}]},{"text":"Siamo chiusi fino a nuovo avviso.","en":"We are closed until further notice.","words":[{"g":"to be","l":"essere"},{"g":"closed","l":"chiuso"},null,null,{"g":"new"},null],"phrases":[[2,4,"up to"]]},{"text":"Non prestò attenzione al mio avviso.","en":"He paid no attention to my warning.","words":[{"g":"not"},{"g":"to lend","l":"prestare"},{"g":"watch out!"},{"g":"to the"},{"g":"mine"},null]}]}