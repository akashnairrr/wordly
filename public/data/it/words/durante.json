{"id":"durante","lemma":"durante","pos":"prep","rank":427,"glosses":["during"],"ipa":"/duˈran.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q652_%28ita%29-LangPao-durante.wav","examples":[{"text":"Lavoro durante la giornata.","en":"I work during the day.","words":[{"g":"work"},null,{"g":"the / her"},{"g":"day"}]},{"text":"Era un soldato durante la guerra.","en":"He was a soldier during the war.","words":[{"g":"to be","l":"essere"},{"g":"a"},{"g":"soldier"},null,{"g":"the / her"},{"g":"war, warfare"}]},{"text":"Nostro figlio è morto durante la guerra.","en":"Our son died during the war.","words":[{"g":"our"},{"g":"son"},{"g":"is","l":"essere"},{"g":"dead man"},null,{"g":"the / her"},{"g":"war, warfare"}]},{"text":"Ero impegnato durante la settimana.","en":"I was busy during the week.","words":[{"g":"to be","l":"essere"},{"g":"pawned"},null,{"g":"the / her"},{"g":"week"}]},{"text":"Cosa hai fatto durante le vacanze?","en":"What did you do during the holidays?","words":[{"g":"thing"},{"g":"have","l":"avere"},{"g":"to do","l":"fare"},null,{"g":"the / to her"},{"g":"holiday , vacation","l":"vacanza"}]}]}