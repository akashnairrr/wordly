{"id":"passeggero","lemma":"passeggero","pos":"adj","rank":2678,"glosses":["passing","transient"],"ipa":"/pas.sedˈd͡ʒɛ.ro/","forms":{"feminine":"passeggera","masculinePlural":"passeggeri","femininePlural":"passeggere"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q652_%28ita%29-LangPao-passeggero.wav","examples":[{"text":"I passeggeri sono tutti a bordo?","en":"Are all the passengers aboard?","words":[{"g":"the","l":"la"},null,{"g":"am / are","l":"essere"},{"g":"all"},null,null],"phrases":[[4,6,"aboard, on board"]]},{"text":"Il treno era pieno di passeggeri.","en":"The train was full of passengers.","words":[{"g":"the"},{"g":"train"},{"g":"to be","l":"essere"},{"g":"full"},{"g":"of"},null]},{"text":"Siete passeggere?","en":"Are you passengers?","words":[{"g":"to be","l":"essere"},null]},{"text":"Era solo un'infatuazione passeggera.","en":"It was just a passing infatuation.","words":[{"g":"to be","l":"essere"},{"g":"only, just"},{"g":"a"},{"g":"infatuation"},null]},{"text":"I passeggeri stanno aspettando.","en":"The passengers are waiting.","words":[{"g":"the","l":"la"},null,{"g":"to stay, remain","l":"stare"},{"g":"to wait for","l":"aspettare"}]}]}