{"id":"cuori","lemma":"cuori","pos":"noun","rank":2272,"glosses":["hearts (suit of playing cards)"],"ipa":"/ˈkwɔ.ri/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q652_%28ita%29-DivoLetto-cuori.wav","examples":[{"text":"Ho l'asso di cuori.","en":"I have the ace of hearts.","words":[{"g":"have","l":"avere"},null,{"g":"ace"},{"g":"of"},null]},{"text":"Aprite i vostri cuori.","en":"Open your hearts.","words":[{"g":"to open","l":"aprire"},{"g":"the","l":"la"},{"g":"yours","l":"vostro"},null]},{"text":"Tom sarà per sempre nei nostri cuori.","en":"Tom will forever be in our hearts.","words":[null,{"g":"to be","l":"essere"},null,null,{"g":"mole","l":"neo"},{"g":"our","l":"nostro"},null],"phrases":[[2,4,"forever"]]},{"text":"Il tempo guarisce i cuori infranti.","en":"Time heals broken hearts.","words":[{"g":"the"},{"g":"time"},{"g":"to recover","l":"guarire"},{"g":"the","l":"la"},null,{"g":"broken","l":"infranto"}]},{"text":"Io ho l'asso di cuori.","en":"I have the ace of hearts.","words":[{"g":"I"},{"g":"have","l":"avere"},null,{"g":"ace"},{"g":"of"},null]}]}