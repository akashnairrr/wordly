{"id":"delegato","lemma":"delegato","pos":"adj","rank":4136,"glosses":["delegating"],"ipa":"/de.leˈɡa.to/","forms":{"feminine":"delegata","masculinePlural":"delegati","femininePlural":"delegate"},"examples":[{"text":"I delegati votarono sei volte.","en":"The delegates voted six times.","words":[{"g":"the","l":"la"},null,{"g":"to vote [with per ‘for’","l":"votare"},{"g":"are","l":"essere"},{"g":"time","l":"volta"}]},{"text":"Come si chiama il nostro amministratore delegato?","en":"What's the name of our CEO?","words":[null,null,null,{"g":"the"},{"g":"our"},{"g":"administrator, manager"},null],"phrases":[[0,3,"what's your name?"]]},{"text":"Finalmente i delegati hanno votato.","en":"Finally, the delegates voted.","words":[{"g":"at last"},{"g":"the","l":"la"},null,{"g":"to have","l":"avere"},{"g":"that has been voted on…"}]},{"text":"Diversi delegati erano in disaccordo.","en":"Several delegates disagreed.","words":[{"g":"several things/people"},null,{"g":"to be","l":"essere"},null,null],"phrases":[[3,5,"at sixes and sevens"]]},{"text":"Sono l'amministratore delegato.","en":"I'm the CEO.","words":[{"g":"am / are","l":"essere"},null,{"g":"administrator, manager"},null]}]}