{"id":"entro","lemma":"entro","pos":"prep","rank":700,"glosses":["within, by, no later than"],"ipa":"/ˈen.tro/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q652_%28ita%29-LangPao-entro.wav","examples":[{"text":"Ti spiace se entro?","en":"Do you mind if I come in?","words":[{"g":"you"},null,{"g":"if"},null]},{"text":"Ne ho bisogno entro domani.","en":"I need it by tomorrow.","words":[{"g":"of it"},{"g":"have","l":"avere"},{"g":"need"},null,{"g":"tomorrow"}]},{"text":"Tornerà entro una settimana.","en":"She will be back within a week.","words":[{"g":"to return","l":"tornare"},null,{"g":"a","l":"uno"},{"g":"week"}]},{"text":"Sarà di ritorno entro una settimana.","en":"She will be back within a week.","words":[{"g":"to be","l":"essere"},null,null,null,{"g":"a","l":"uno"},{"g":"week"}],"phrases":[[1,3,"having come back"]]},{"text":"Questo lavoro deve essere finito entro domani.","en":"This work must be finished by tomorrow.","words":[{"g":"this"},{"g":"work"},{"g":"to owe","l":"dovere"},{"g":"to be"},{"g":"finished"},null,{"g":"tomorrow"}]}]}