{"id":"mare","lemma":"mare","pos":"noun","rank":770,"glosses":["sea"],"ipa":"/ˈma.re/","gender":"m","forms":{"plural":"mari"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q652_%28ita%29-XANA000-mare.wav","examples":[{"text":"Amo il mare.","en":"I love the sea.","words":[{"g":"to love, to like","l":"amare"},{"g":"the"},null]},{"text":"Voglio vivere sul mare.","en":"I want to live by the sea.","words":[{"g":"to want","l":"volere"},{"g":"to live"},null,null]},{"text":"Ha una casa sul mare.","en":"She has a house by the sea.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},{"g":"house"},null,null]},{"text":"Il mare è blu.","en":"The sea is blue.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"blue"}]},{"text":"Lo abbiamo cercato per mari e monti.","en":"We looked for it high and low.","words":[{"g":"the / it"},{"g":"to have","l":"avere"},{"g":"to look for","l":"cercare"},{"g":"for"},null,{"g":"and"},{"g":"mountain, mount","l":"monte"}]}]}