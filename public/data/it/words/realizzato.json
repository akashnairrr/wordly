{"id":"realizzato","lemma":"realizzato","pos":"adj","rank":2710,"glosses":["realized","fulfilled"],"forms":{"feminine":"realizzata","masculinePlural":"realizzati","femininePlural":"realizzate"},"examples":[{"text":"Come hai realizzato questo video?","en":"How did you make this video?","words":[{"g":"how / like"},{"g":"have","l":"avere"},null,{"g":"this"},{"g":"video"}]},{"text":"Ho appena realizzato quanto sono stupido.","en":"I just realized how stupid I am.","words":[{"g":"have","l":"avere"},{"g":"barely, hardly"},null,{"g":"how much, however much"},{"g":"am / are","l":"essere"},{"g":"stupid, daft"}]},{"text":"Non ha realizzato il suo proprio errore.","en":"He has not realized his own mistake.","words":[{"g":"not"},{"g":"has","l":"avere"},null,{"g":"the"},{"g":"his, hers, its"},{"g":"really, quite, indeed"},{"g":"mistake"}]},{"text":"Lo abbiamo realizzato oggi.","en":"We realized that today.","words":[{"g":"the / it"},{"g":"to have","l":"avere"},null,{"g":"today"}]},{"text":"Il piano fu realizzato.","en":"The plan was carried out.","words":[{"g":"the"},{"g":"plane"},{"g":"deceased, late"},null]}]}