{"id":"ramo","lemma":"ramo","pos":"noun","rank":4155,"glosses":["branch","ramus, branch","fork"],"ipa":"/ˈra.mo/","gender":"m","forms":{"plural":"rami"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q652_%28ita%29-LangPao-ramo.wav","examples":[{"text":"Non rompere i rami.","en":"Don't break the branches.","words":[{"g":"not"},{"g":"to break"},{"g":"the","l":"la"},null]},{"text":"Molti uccelli sono sul ramo.","en":"Many birds are on the branch.","words":[{"g":"much, very much, a lot","l":"molto"},{"g":"bird","l":"uccello"},{"g":"am / are","l":"essere"},null,null]},{"text":"Ho tagliato un ramo dall'albero.","en":"I cut a branch from the tree.","words":[{"g":"have","l":"avere"},{"g":"per bend sinister"},{"g":"a"},null,null,{"g":"tree"}]},{"text":"Il gatto si è nascosto tra i rami.","en":"The cat hid among the branches.","words":[{"g":"the"},{"g":"cat"},{"g":"oneself"},{"g":"is","l":"essere"},{"g":"hidden"},{"g":"between"},{"g":"the","l":"la"},null]},{"text":"Ha tagliato alcuni rami dell'albero.","en":"He cut some branches off the tree.","words":[{"g":"has","l":"avere"},{"g":"per bend sinister"},{"g":"some, a few","l":"alcuno"},null,null,{"g":"tree"}]}]}