{"id":"universo","lemma":"universo","pos":"noun","rank":1238,"glosses":["universe"],"ipa":"/u.niˈvɛr.so/","gender":"m","forms":{"plural":"universi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/06/LL-Q652_%28ita%29-LangPao-universo.wav","examples":[{"text":"L'universo è pieno di segreti.","en":"The universe is full of secrets.","words":[null,null,{"g":"is","l":"essere"},{"g":"full"},{"g":"of"},{"g":"secret","l":"segreto"}]},{"text":"Quanti anni ha l'universo?","en":"How old is the universe?","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"has","l":"avere"},null,null]},{"text":"Ci sono milioni di stelle nell'universo.","en":"There are millions of stars in the universe.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"million","l":"milione"},{"g":"of"},{"g":"star","l":"stella"},null,null]},{"text":"Dio creò l'universo.","en":"God made the universe.","words":[{"g":"god, deity"},{"g":"to create","l":"creare"},null,null]},{"text":"Siamo soli nell'universo?","en":"Are we alone in the universe?","words":[{"g":"to be","l":"essere"},{"g":"sun","l":"sole"},null,null]}]}