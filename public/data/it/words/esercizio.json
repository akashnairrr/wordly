{"id":"esercizio","lemma":"esercizio","pos":"noun","rank":2774,"glosses":["exercise (also military)"],"ipa":"/e.zerˈt͡ʃit.t͡sjo/","gender":"m","forms":{"plural":"esercizi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q652_%28ita%29-LangPao-esercizio.wav","examples":[{"text":"Questo è un esercizio facile.","en":"This is an easy exercise.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null,{"g":"easy"}]},{"text":"Non faccio mai esercizio.","en":"I never do any exercise.","words":[{"g":"not"},{"g":"to do","l":"fare"},{"g":"never"},null]},{"text":"Devi fare più esercizi.","en":"You need to exercise more.","words":[{"g":"to owe","l":"dovere"},{"g":"to do"},{"g":"more"},null]},{"text":"Camminare è il miglior esercizio.","en":"Walking is the best exercise.","words":[{"g":"to walk"},{"g":"is","l":"essere"},{"g":"the"},null,null]},{"text":"Ha finito i suoi esercizi nel tempo dato.","en":"She finished her exercises in the given time.","words":[{"g":"has","l":"avere"},{"g":"finished"},null,null,null,{"g":"in the"},{"g":"time"},{"g":"datum"}],"phrases":[[2,4,"his"]]}]}