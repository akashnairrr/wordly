{"id":"questione","lemma":"questione","pos":"noun","rank":634,"glosses":["question, issue, matter, point","argument, quarrel"],"ipa":"/kwesˈtjo.ne/","gender":"f","forms":{"plural":"questioni"},"examples":[{"text":"Il matrimonio è fuori questione.","en":"Marriage is out of the question.","words":[{"g":"the"},{"g":"marriage"},{"g":"is","l":"essere"},{"g":"out, outside, outwards"},null]},{"text":"È una questione morale.","en":"It's a moral question.","audio":"https://tatoeba.org/en/audio/download/1010019","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"morals"}]},{"text":"Vorrei affrontare due questioni.","en":"I would like to address two questions.","words":[{"g":"to want","l":"volere"},{"g":"to face or confront"},{"g":"two"},null]},{"text":"È solo questione di tempo ora.","en":"It's only a question of time now.","words":[{"g":"is","l":"essere"},{"g":"only, just"},null,{"g":"of"},{"g":"time"},{"g":"now"}]},{"text":"Abbiamo questioni più importanti da discutere.","en":"We have more important matters to discuss.","words":[{"g":"to have","l":"avere"},null,{"g":"more"},{"g":"important","l":"importante"},{"g":"from"},{"g":"to discuss"}]}]}