{"id":"luna","lemma":"luna","pos":"noun","rank":818,"glosses":["a natural satellite","silver","a full moon (as opposed to a crescent)"],"ipa":"/ˈlu.na/","gender":"f","forms":{"plural":"lune"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q652_%28ita%29-XANA000-luna.wav","examples":[{"text":"Che bella luna!","en":"What a beautiful moon!","words":[{"g":"that / what"},{"g":"beauty, belle"},null]},{"text":"Voglio andare sulla luna.","en":"I want to go to the moon.","words":[{"g":"to want","l":"volere"},{"g":"to go"},{"g":"plant of the genus Sulla"},null]},{"text":"La luna è già sorta.","en":"The moon is already out.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"already"},{"g":"sort, type, kind"}]},{"text":"Non c'è vita sulla luna.","en":"There is no life on the moon.","words":[{"g":"not"},null,{"g":"is","l":"essere"},{"g":"life"},{"g":"plant of the genus Sulla"},null]},{"text":"Venere non ha lune.","en":"Venus doesn’t have any moons.","words":[{"g":"a beautiful woman"},{"g":"not"},{"g":"has","l":"avere"},null]}]}