{"id":"felicita_","lemma":"felicità","pos":"noun","rank":2108,"glosses":["happiness"],"ipa":"/fe.li.t͡ʃiˈta/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-felicit%C3%A0.wav","examples":[{"text":"I soldi possono comprare la felicità?","en":"Can money buy happiness?","words":[{"g":"the","l":"la"},{"g":"money"},{"g":"can, could","l":"potere"},{"g":"to buy"},{"g":"the / her"},null]},{"text":"La felicità è nelle piccole cose.","en":"Happiness is in the little things.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},null,{"g":"a small glass of beer","l":"piccola"},{"g":"thing","l":"cosa"}]},{"text":"Ho trovato la felicità.","en":"I have found happiness.","words":[{"g":"have","l":"avere"},{"g":"discovery"},{"g":"the / her"},null]},{"text":"Parliamo di felicità.","en":"Let's talk about happiness.","words":[{"g":"to talk, to speak","l":"parlare"},{"g":"of"},null]},{"text":"Il denaro porta la felicità?","en":"Does money bring happiness?","words":[{"g":"the"},{"g":"money"},{"g":"gate"},{"g":"the / her"},null]}]}