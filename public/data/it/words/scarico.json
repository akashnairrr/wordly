{"id":"scarico","lemma":"scarico","pos":"adj","rank":3434,"glosses":["unloaded","empty","run-down (having the spring unwound) (of a clock, watch)"],"ipa":"/ˈska.ri.ko/","forms":{"feminine":"scarica","masculinePlural":"scarichi","femininePlural":"scariche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q652_%28ita%29-LangPao-scarico.wav","examples":[{"text":"Sembri abbastanza scarico.","en":"You look quite run down.","words":[{"g":"to seem","l":"sembrare"},{"g":"enough, sufficiently"},null]},{"text":"Odio quando i capelli intasano lo scarico.","en":"I hate it when hair clogs the drain.","words":[{"g":"hatred"},{"g":"when"},{"g":"the","l":"la"},{"g":"a single hair","l":"capello"},null,{"g":"the / it"},null]},{"text":"Sembra abbastanza scarico.","en":"You look quite run down.","words":[{"g":"to seem","l":"sembrare"},{"g":"enough, sufficiently"},null]},{"text":"Lo scarico delle fabbriche inquina l'aria.","en":"Exhaust from factories pollutes the air.","words":[{"g":"the / it"},null,null,{"g":"factory, plant","l":"fabbrica"},null,null,{"g":"air"}]},{"text":"La batteria è scarica.","en":"The battery is dead.","words":[{"g":"the / her"},{"g":"battery"},{"g":"is","l":"essere"},null]}]}