{"id":"palestra","lemma":"palestra","pos":"noun","rank":1783,"glosses":["gym, gymnasium"],"ipa":"/paˈlɛs.tra/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a2/LL-Q652_%28ita%29-LangPao-palestra.wav/LL-Q652_%28ita%29-LangPao-palestra.wav.mp3","gender":"f","forms":{"plural":"palestre"},"examples":[{"text":"Sono in palestra?","en":"Are they in the gym?","audio":"https://tatoeba.org/en/audio/download/1004722","words":[{"g":"am / are","l":"essere"},{"g":"in"},null]},{"text":"Vuoi andare in palestra con me?","en":"Do you want to go to the gym with me?","words":[{"g":"to want","l":"volere"},{"g":"to go"},{"g":"in"},null,{"g":"with"},{"g":"me"}]},{"text":"Non posso andare in palestra stasera.","en":"I can't go to the gym tonight.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to go"},{"g":"in"},null,{"g":"this evening, tonight"}]},{"text":"Vai in palestra oggi?","en":"Are you going to the gym today?","words":[{"g":"to go","l":"andare"},{"g":"in"},null,{"g":"today"}]},{"text":"Questo albergo ha palestra e piscina.","en":"This hotel has a gym and a swimming pool.","words":[{"g":"this"},{"g":"hotel, inn"},{"g":"has","l":"avere"},null,{"g":"and"},{"g":"swimming pool"}]}]}