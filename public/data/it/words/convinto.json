{"id":"convinto","lemma":"convinto","pos":"adj","rank":1118,"glosses":["fervent, keen, sure, true blue","convinced, persuaded"],"ipa":"/konˈvin.to/","forms":{"feminine":"convinta","masculinePlural":"convinti","femininePlural":"convinte"},"examples":[{"text":"Potrei essere convinto ad aiutare.","en":"I could be persuaded to help.","words":[{"g":"can, could","l":"potere"},{"g":"to be"},null,null,{"g":"to help, assist"}]},{"text":"Non sono ancora completamente convinta.","en":"I'm still not completely convinced.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"still / again"},{"g":"completely, fully"},null]},{"text":"Non sono così convinto.","en":"I'm not so convinced.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"so"},null]},{"text":"Beh, mi hai convinta.","en":"Well, you've convinced me.","words":[{"g":"well"},{"g":"me / myself"},{"g":"have","l":"avere"},null]},{"text":"Non siamo ancora convinti.","en":"We're not convinced yet.","words":[{"g":"not"},{"g":"to be","l":"essere"},{"g":"still / again"},null]}]}