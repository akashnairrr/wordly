{"id":"vite","lemma":"vite","pos":"noun","rank":873,"glosses":["screw"],"ipa":"/ˈvi.te/","gender":"f","forms":{"plural":"viti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q652_%28ita%29-XANA000-vite.wav","examples":[{"text":"Un gatto ha nove vite.","en":"A cat has nine lives.","words":[{"g":"a"},{"g":"cat"},{"g":"has","l":"avere"},{"g":"nine"},null]},{"text":"Le nostre vite sono in pericolo.","en":"Our lives are in danger.","words":[{"g":"the / to her"},{"g":"our","l":"nostro"},null,{"g":"am / are","l":"essere"},{"g":"in"},{"g":"peril, danger"}]},{"text":"Internet ha cambiato le nostre vite.","en":"The internet has changed our lives.","words":[{"g":"web, internet"},{"g":"has","l":"avere"},{"g":"to exchange","l":"cambiare"},{"g":"the / to her"},{"g":"our","l":"nostro"},null]},{"text":"Vai alla ferramenta a prendere delle viti.","en":"Go to the hardware store and get screws.","words":[{"g":"to go","l":"andare"},{"g":"to the"},{"g":"hardware"},{"g":"to / at"},{"g":"to take"},null,null]},{"text":"Questo potrebbe salvare molte vite.","en":"This could save many lives.","words":[{"g":"this"},{"g":"can, could","l":"potere"},{"g":"to save"},{"g":"much, very much, a lot","l":"molto"},null]}]}