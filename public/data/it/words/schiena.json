{"id":"schiena","lemma":"schiena","pos":"noun","rank":1092,"glosses":["back (the rear of the body)"],"ipa":"/ˈskjɛ.na/","gender":"f","forms":{"plural":"schiene"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-schiena.wav","examples":[{"text":"Ho un brutto dolore alla schiena.","en":"I have a bad pain in my back.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"ugly, bad, nasty"},{"g":"ache, pain"},{"g":"to the"},null]},{"text":"È ancora sulla schiena.","en":"He is still on his back.","words":[{"g":"is","l":"essere"},{"g":"still / again"},{"g":"plant of the genus Sulla"},null]},{"text":"Ho il mal di schiena.","en":"I have a backache.","words":[{"g":"have","l":"avere"},{"g":"the"},null,{"g":"of"},null]},{"text":"Mi fa ancora male la schiena.","en":"My back still hurts.","words":[{"g":"me / myself"},{"g":"to do","l":"fare"},{"g":"still / again"},{"g":"evil, harm"},{"g":"the / her"},null]},{"text":"Io ho dei problemi alla schiena.","en":"I have back problems.","words":[{"g":"I"},{"g":"have","l":"avere"},{"g":"some"},{"g":"problem","l":"problema"},{"g":"to the"},null]}]}