{"id":"avanzata","lemma":"avanzata","pos":"noun","rank":4410,"glosses":["advance, approach","advance"],"ipa":"/a.vanˈt͡sa.ta/","gender":"f","forms":{"plural":"avanzate"},"examples":[{"text":"È morto l'anno scorso in età avanzata.","en":"He died last year of old age.","words":[{"g":"is","l":"essere"},{"g":"dead man"},null,{"g":"year"},{"g":"misprint"},{"g":"in"},{"g":"age"},null]},{"text":"La loro attrezzatura è estremamente avanzata.","en":"Their equipment is extremely advanced.","words":[{"g":"the / her"},{"g":"they"},{"g":"equipment"},{"g":"is","l":"essere"},{"g":"extremely"},null]},{"text":"Tom ha mangiato la pizza avanzata per colazione.","en":"Tom ate the leftover pizza for breakfast.","words":[null,{"g":"has","l":"avere"},{"g":"to eat","l":"mangiare"},{"g":"the / her"},{"g":"pizza"},null,{"g":"for"},{"g":"breakfast"}]},{"text":"Sono avanzate fino al fiume.","en":"They advanced to the river.","words":[{"g":"am / are","l":"essere"},null,{"g":"till, until, as far as"},{"g":"to the"},{"g":"river"}]},{"text":"Avanzate di due passi.","en":"Advance two steps.","words":[null,{"g":"of"},null,null],"phrases":[[2,4,"a very short distance"]]}]}