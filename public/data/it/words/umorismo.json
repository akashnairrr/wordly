{"id":"umorismo","lemma":"umorismo","pos":"noun","rank":2902,"glosses":["humour/humor (something funny)"],"ipa":"/u.moˈriz.mo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/6d/LL-Q652_%28ita%29-LangPao-umorismo.wav/LL-Q652_%28ita%29-LangPao-umorismo.wav.mp3","gender":"m","forms":{"plural":"umorismi"},"examples":[{"text":"Hai un buon senso dell'umorismo.","en":"You have a good sense of humor.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"sense"},null,null]},{"text":"Non capisco l'umorismo britannico.","en":"I don't understand British humor.","words":[null,null,null,null,{"g":"British, Britannic"}],"phrases":[[0,2,"I don't understand"]]},{"text":"Ha un senso dell'umorismo molto buono.","en":"He has a very good sense of humor.","words":[{"g":"has","l":"avere"},{"g":"a"},{"g":"sense"},null,null,{"g":"very / a lot"},{"g":"righteous, moral"}]},{"text":"Ammiro il suo umorismo.","en":"I admire his wit.","words":[{"g":"to admire","l":"ammirare"},{"g":"the"},{"g":"his, hers, its"},null]},{"text":"Io ho il senso dell'umorismo.","en":"I have a sense of humor.","words":[{"g":"I"},{"g":"have","l":"avere"},{"g":"the"},{"g":"sense"},null,null]}]}