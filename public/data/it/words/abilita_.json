{"id":"abilita_","lemma":"abilità","pos":"noun","rank":2894,"glosses":["ability, skill","cleverness"],"ipa":"/a.bi.liˈta/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q652_%28ita%29-Jennum-abilit%C3%A0.wav","examples":[{"text":"È un uomo di grande abilità.","en":"He is a man of great ability.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},{"g":"of"},{"g":"adult, grownup"},null]},{"text":"Ho molte abilità.","en":"I have many abilities.","words":[{"g":"have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Ci vuole abilità.","en":"That takes skill.","words":[{"g":"us / there"},{"g":"to want","l":"volere"},null]},{"text":"Hai le abilità necessarie.","en":"You have the necessary skills.","words":[{"g":"have","l":"avere"},{"g":"the / to her"},null,{"g":"necessary","l":"necessario"}]},{"text":"L'uomo ha l'abilità di parlare.","en":"Man has the ability to talk.","words":[null,{"g":"person, man"},{"g":"has","l":"avere"},null,null,{"g":"of"},{"g":"to talk, to speak"}]}]}