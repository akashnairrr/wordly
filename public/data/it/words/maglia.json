{"id":"maglia","lemma":"maglia","pos":"noun","rank":2937,"glosses":["stitch","link (of a chain)","mesh"],"ipa":"/ˈmaʎ.ʎa/","gender":"f","forms":{"plural":"maglie"},"examples":[{"text":"Questa maglia costa dieci dollari.","en":"This shirt costs ten dollars.","words":[{"g":"this, this one, these","l":"questo"},null,{"g":"to cost","l":"costare"},{"g":"ten"},{"g":"dollar","l":"dollaro"}]},{"text":"Si provi addosso quella maglia.","en":"Try on that shirt.","words":[{"g":"oneself"},{"g":"to try","l":"provare"},{"g":"on, next to"},{"g":"that one","l":"quello"},null]},{"text":"Mi piace la tua maglia.","en":"I like your shirt.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Vuole che queste maglie vengano lavate.","en":"He wants these shirts washed.","words":[{"g":"to want","l":"volere"},{"g":"that / what"},{"g":"this, this one, these","l":"questo"},null,{"g":"to come","l":"venire"},{"g":"to wash","l":"lavare"}]},{"text":"Lavoro a maglia.","en":"I knit.","words":[{"g":"work"},{"g":"to / at"},null]}]}