{"id":"praticamente","lemma":"praticamente","pos":"adv","rank":957,"glosses":["practically (all senses)","almost"],"ipa":"/pra.ti.kaˈmen.te/","examples":[{"text":"È praticamente morto.","en":"He is practically dead.","words":[{"g":"is","l":"essere"},null,{"g":"dead man"}]},{"text":"Il posto è praticamente vuoto.","en":"The place is practically empty.","words":[{"g":"the"},{"g":"place, spot"},{"g":"is","l":"essere"},null,{"g":"gap"}]},{"text":"Siamo praticamente una famiglia.","en":"We're practically family.","words":[{"g":"to be","l":"essere"},null,{"g":"a","l":"uno"},{"g":"family"}]},{"text":"Questa pizza è praticamente perfetta.","en":"This pizza is nearly perfect.","words":[{"g":"this, this one, these","l":"questo"},{"g":"pizza"},{"g":"is","l":"essere"},null,{"g":"perfect","l":"perfetto"}]},{"text":"Non abbiamo praticamente niente in comune.","en":"We have next to nothing in common.","words":[{"g":"not"},{"g":"to have","l":"avere"},null,{"g":"nothing"},null,null],"phrases":[[4,6,"in common"]]}]}