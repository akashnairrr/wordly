{"id":"ombra","lemma":"ombra","pos":"noun","rank":1509,"glosses":["shade, shadow","a glass of wine (corresponding to one eighth of a liter of wine)"],"ipa":"/ˈom.bra/","gender":"f","forms":{"plural":"ombre"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q652_%28ita%29-LangPao-ombra.wav","examples":[{"text":"Ti vuoi sedere all'ombra?","en":"Do you want to sit in the shade?","words":[{"g":"you"},{"g":"to want","l":"volere"},{"g":"to sit"},null,null]},{"text":"Ha paura della sua stessa ombra.","en":"He is afraid of his own shadow.","words":[{"g":"has","l":"avere"},{"g":"fear"},{"g":"of the"},{"g":"his, hers, its","l":"suo"},{"g":"same","l":"stesso"},null]},{"text":"Non c'è luce senza ombra.","en":"There's no light without a shadow.","words":[{"g":"not"},null,{"g":"is","l":"essere"},{"g":"light (visible…"},{"g":"without, -less"},null]},{"text":"La mia ombra è dietro di me.","en":"My shadow is behind me.","words":[{"g":"the / her"},{"g":"mine","l":"mio"},null,{"g":"is","l":"essere"},{"g":"behind"},{"g":"of"},{"g":"me"}]},{"text":"Vuole sedersi all'ombra?","en":"Do you want to sit in the shade?","words":[{"g":"to want","l":"volere"},{"g":"to sit"},null,null]}]}