{"id":"salto","lemma":"salto","pos":"noun","rank":1501,"glosses":["jump, leap, spring, bound","change, jump, leap, rise, drop","short call, short distance, hop"],"ipa":"/ˈsal.to/","gender":"m","forms":{"plural":"salti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q652_%28ita%29-LangPao-salto.wav","examples":[{"text":"Perché non fai un salto?","en":"Why don't you drop in?","words":[{"g":"why / because"},{"g":"not"},{"g":"to do","l":"fare"},{"g":"a"},null]},{"text":"Facciamo un salto a casa sua.","en":"Let's drop by his house.","words":[{"g":"to do","l":"fare"},{"g":"a"},null,{"g":"to / at"},{"g":"house"},{"g":"his, hers, its","l":"suo"}]},{"text":"Farò un salto domani.","en":"I'll stop by tomorrow.","words":[{"g":"to do","l":"fare"},{"g":"a"},null,{"g":"tomorrow"}]},{"text":"Salto spesso la colazione.","en":"I often skip breakfast.","words":[null,{"g":"thick"},{"g":"the / her"},{"g":"breakfast"}]},{"text":"Perché non facciamo un salto a trovarla?","en":"Why don't we drop by to see her?","words":[{"g":"why / because"},{"g":"not"},{"g":"to do","l":"fare"},{"g":"a"},null,{"g":"to / at"},null]}]}