{"id":"destinato","lemma":"destinato","pos":"adj","rank":3689,"glosses":["destined"],"ipa":"/des.tiˈna.to/","forms":{"feminine":"destinata","masculinePlural":"destinati","femininePlural":"destinate"},"examples":[{"text":"Il piano è destinato ad avere successo.","en":"The plan is bound to succeed.","words":[{"g":"the"},{"g":"plane"},{"g":"is","l":"essere"},null,null,null,null],"phrases":[[5,7,"to succeed"]]},{"text":"Siamo tutti destinati a morire.","en":"We're all bound to die.","words":[{"g":"to be","l":"essere"},{"g":"all"},null,{"g":"to / at"},{"g":"to die"}]},{"text":"Eravamo destinati a stare insieme.","en":"We were meant to be together.","words":[{"g":"to be","l":"essere"},null,{"g":"to / at"},null,null],"phrases":[[3,5,"to be together"]]},{"text":"È destinato a dimenticare.","en":"He's bound to forget.","words":[{"g":"is","l":"essere"},null,{"g":"to / at"},{"g":"to forget"}]},{"text":"Sei davvero destinata a durare?","en":"Are you really here to stay?","words":[{"g":"are","l":"essere"},{"g":"really, in fact"},null,{"g":"to / at"},{"g":"to last"}]}]}