{"id":"compassione","lemma":"compassione","pos":"noun","rank":2955,"glosses":["compassion, pity"],"ipa":"/kom.pasˈsjo.ne/","gender":"f","forms":{"plural":"compassioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q652_%28ita%29-DivoLetto-compassione.wav","examples":[{"text":"Non voglio compassione.","en":"I don't want sympathy.","words":[{"g":"not"},{"g":"to want","l":"volere"},null]},{"text":"Cerca di avere un po' di compassione.","en":"Try to have some compassion.","words":[{"g":"search"},{"g":"of"},{"g":"to have"},{"g":"a"},null,{"g":"of"},null]},{"text":"Mai confondere la compassione con l'amore.","en":"Never confuse pity with love.","words":[{"g":"never"},{"g":"to mix up"},{"g":"the / her"},null,{"g":"with"},null,{"g":"love"}]},{"text":"Io non voglio compassione.","en":"I don't want sympathy.","words":[{"g":"I"},{"g":"not"},{"g":"to want","l":"volere"},null]},{"text":"Dov'è la tua compassione?","en":"Where is your compassion?","words":[null,{"g":"is","l":"essere"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]}]}