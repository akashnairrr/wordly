{"id":"guaio","lemma":"guaio","pos":"noun","rank":2978,"glosses":["hardship, misfortune","trouble, difficulty, mess, pickle, fix, woe, jam"],"ipa":"/ˈɡwa.jo/","gender":"m","forms":{"plural":"guai"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q652_%28ita%29-LangPao-guaio.wav","formAudio":{"guai":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q652_%28ita%29-XANA000-guai.wav"},"examples":[{"text":"Il guaio è che mio figlio non vuole andare a scuola.","en":"The trouble is that my son does not want to go to school.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"that / what"},{"g":"mine"},{"g":"son"},{"g":"not"},{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to / at"},{"g":"school"}]},{"text":"Sei nei guai con la legge?","en":"Are you in trouble with the law?","words":[{"g":"are","l":"essere"},{"g":"mole","l":"neo"},null,{"g":"with"},{"g":"the / her"},{"g":"law"}]},{"text":"Stai fuori dai guai.","en":"Stay out of trouble.","words":[{"g":"to stay, remain","l":"stare"},{"g":"out, outside, outwards"},{"g":"an expression of…"},null]},{"text":"Tom ti ha coinvolto in un guaio, non è così?","en":"Tom got you in trouble, didn't he?","words":[null,{"g":"you"},{"g":"has","l":"avere"},{"g":"involved or implicated"},{"g":"in"},{"g":"a"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"so"}]},{"text":"Perché sono nei guai?","en":"Why am I in trouble?","words":[{"g":"why / because"},{"g":"am / are","l":"essere"},{"g":"mole","l":"neo"},null]}]}