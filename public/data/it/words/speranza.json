{"id":"speranza","lemma":"speranza","pos":"noun","rank":853,"glosses":["hope"],"ipa":"/speˈran.t͡sa/","gender":"f","forms":{"plural":"speranze"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9b/LL-Q652_%28ita%29-LangPao-speranza.wav","examples":[{"text":"C'è speranza?","en":"Is there any hope?","words":[null,{"g":"is","l":"essere"},null]},{"text":"Mi dà speranza.","en":"That gives me hope.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},null]},{"text":"Abbiamo grandi speranze.","en":"We have high expectations.","words":[{"g":"to have","l":"avere"},{"g":"adult, grownup","l":"grande"},null]},{"text":"Questa è la nostra unica speranza.","en":"This is our only hope.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"the / her"},{"g":"our","l":"nostro"},{"g":"only thing"},null]},{"text":"Un nuovo anno porta speranza.","en":"A new year brings hope.","words":[{"g":"a"},{"g":"new"},{"g":"year"},{"g":"gate"},null]}]}