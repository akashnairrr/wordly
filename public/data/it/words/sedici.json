{"id":"sedici","lemma":"sedici","pos":"num","rank":3385,"glosses":["sixteen"],"ipa":"/ˈse.di.t͡ʃi/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q652_%28ita%29-XANA000-sedici.wav","examples":[{"text":"\"Quanti anni hai?\" \"Sedici.\"","en":"\"How old are you?\" \"Sixteen years old\".","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"have","l":"avere"},null]},{"text":"Il mio prossimo compleanno farò sedici anni.","en":"I'll be sixteen on my next birthday.","words":[{"g":"the"},{"g":"mine"},{"g":"very near, near, close"},{"g":"birthday"},{"g":"to do","l":"fare"},null,{"g":"year","l":"anno"}]},{"text":"\"Quanti anni hai?\" \"Ho sedici anni.\"","en":"\"How old are you?\" \"I'm sixteen.\"","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"have","l":"avere"},{"g":"have","l":"avere"},null,{"g":"year","l":"anno"}]},{"text":"Avrò sedici anni a maggio.","en":"I will be sixteen in May.","words":[{"g":"to have","l":"avere"},null,{"g":"year","l":"anno"},{"g":"to / at"},{"g":"May"}]},{"text":"Per ulteriori informazioni, consulta la pagina sedici.","en":"For further information, see page 16.","words":[{"g":"for"},{"g":"further","l":"ulteriore"},{"g":"information","l":"informazione"},null,{"g":"the / her"},{"g":"page"},null]}]}