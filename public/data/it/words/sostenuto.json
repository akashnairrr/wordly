{"id":"sostenuto","lemma":"sostenuto","pos":"adj","rank":4997,"glosses":["fast, steady, high","reserved, distant","sostenuto"],"ipa":"/sos.teˈnu.to/","forms":{"feminine":"sostenuta","masculinePlural":"sostenuti","femininePlural":"sostenute"},"examples":[{"text":"Ha sostenuto l'esame di ingresso ieri.","en":"She took the entrance exam yesterday.","words":[{"g":"has","l":"avere"},null,null,{"g":"examination, test"},{"g":"of"},{"g":"entrance, hall"},{"g":"yesterday"}]},{"text":"Hanno sostenuto molti oneri.","en":"They made many charges.","words":[{"g":"to have","l":"avere"},null,{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Ha sostenuto la riduzione delle tasse.","en":"He advocated the reduction of taxes.","words":[{"g":"has","l":"avere"},null,{"g":"the / her"},{"g":"reduction"},null,{"g":"tax, duty, dues","l":"tassa"}]},{"text":"Ha sostenuto l'esame d'ingresso ieri.","en":"She took the entrance exam yesterday.","words":[{"g":"has","l":"avere"},null,null,{"g":"examination, test"},null,{"g":"entrance, hall"},{"g":"yesterday"}]},{"text":"Hanno sostenuto molti costi.","en":"They made many charges.","words":[{"g":"to have","l":"avere"},null,{"g":"much, very much, a lot","l":"molto"},{"g":"to cost","l":"costare"}]}]}