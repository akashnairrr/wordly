{"id":"regolarmente","lemma":"regolarmente","pos":"adv","rank":4362,"glosses":["regularly","punctually","duly"],"ipa":"/re.ɡo.larˈmen.te/","examples":[{"text":"Vado regolarmente a letto alle nove.","en":"I regularly go to bed at nine.","words":[{"g":"to go","l":"andare"},null,null,null,null,{"g":"nine"}],"phrases":[[2,4,"in bed"]]},{"text":"Bisogna mangiare regolarmente.","en":"You have to eat regularly.","words":[{"g":"thing, matter, affair"},{"g":"to eat"},null]},{"text":"Lo usiamo regolarmente.","en":"We use it regularly.","words":[{"g":"the / it"},{"g":"to use","l":"usare"},null]},{"text":"La utilizziamo regolarmente.","en":"We use it regularly.","words":[{"g":"the / her"},{"g":"to use","l":"utilizzare"},null]},{"text":"Noi lo utilizziamo regolarmente.","en":"We use it regularly.","words":[{"g":"we"},{"g":"the / it"},{"g":"to use","l":"utilizzare"},null]}]}