{"id":"piuttosto","lemma":"piuttosto","pos":"prep","rank":452,"glosses":["rather than, instead of"],"ipa":"/pjutˈtɔs.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q652_%28ita%29-LangPao-piuttosto.wav","examples":[{"text":"Questo posto è piuttosto carino.","en":"This place is quite nice.","words":[{"g":"this"},{"g":"place, spot"},{"g":"is","l":"essere"},null,{"g":"nice"}]},{"text":"La ragione è piuttosto semplice.","en":"The reason is pretty simple.","words":[{"g":"the / her"},{"g":"reason, intellect"},{"g":"is","l":"essere"},null,{"g":"simple"}]},{"text":"Questo funziona piuttosto bene.","en":"This works pretty well.","words":[{"g":"this"},{"g":"to function, to work","l":"funzionare"},null,{"g":"well"}]},{"text":"Sembra piuttosto facile.","en":"It seems pretty easy.","words":[{"g":"to seem","l":"sembrare"},null,{"g":"easy"}]},{"text":"Sembri piuttosto felice.","en":"You seem quite happy.","words":[{"g":"to seem","l":"sembrare"},null,{"g":"happy"}]}]}