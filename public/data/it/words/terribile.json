{"id":"terribile","lemma":"terribile","pos":"adj","rank":610,"glosses":["terrible, terrifying, fearful","horrible, awful, dreadful","terrific"],"ipa":"/terˈri.bi.le/","forms":{"plural":"terribili"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q652_%28ita%29-LangPao-terribile.wav","examples":[{"text":"È davvero così terribile?","en":"Is it really so terrible?","words":[{"g":"is","l":"essere"},{"g":"really, in fact"},{"g":"so"},null]},{"text":"Queste cose sono terribili.","en":"These things are terrible.","words":[{"g":"this, this one, these","l":"questo"},{"g":"thing","l":"cosa"},{"g":"am / are","l":"essere"},null]},{"text":"Il cibo è terribile.","en":"The food is terrible.","words":[{"g":"the"},{"g":"food"},{"g":"is","l":"essere"},null]},{"text":"Questa strada è terribile.","en":"This road is terrible.","words":[{"g":"this, this one, these","l":"questo"},{"g":"road, way, street"},{"g":"is","l":"essere"},null]},{"text":"I soldi sono terribili.","en":"The money is terrible.","words":[{"g":"the","l":"la"},{"g":"money"},{"g":"am / are","l":"essere"},null]}]}