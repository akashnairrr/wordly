{"id":"appena","lemma":"appena","pos":"adv","rank":158,"glosses":["barely, hardly","just, recently, newly","as soon as"],"ipa":"/apˈpe.na/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q652_%28ita%29-XANA000-appena.wav","examples":[{"text":"Chi ha appena chiamato?","en":"Who just called?","words":[{"g":"who"},{"g":"has","l":"avere"},null,{"g":"to call","l":"chiamare"}]},{"text":"Mi hai appena chiamato?","en":"Did you just call me?","words":[{"g":"me / myself"},{"g":"have","l":"avere"},null,{"g":"to call","l":"chiamare"}]},{"text":"Mi ha appena chiamata?","en":"Did you just call me?","words":[{"g":"me / myself"},{"g":"has","l":"avere"},null,{"g":"call"}]},{"text":"Avete tutti appena perso il gioco.","en":"You all just lost the game.","words":[{"g":"to have","l":"avere"},{"g":"all"},null,{"g":"lost, wasted"},{"g":"the"},{"g":"game"}]},{"text":"Ho appena parlato con il capitano.","en":"I just spoke with the captain.","words":[{"g":"have","l":"avere"},null,{"g":"spoken"},{"g":"with"},{"g":"the"},{"g":"captain"}]}]}