{"id":"bene","lemma":"bene","pos":"adv","rank":28,"glosses":["well","good, fine"],"ipa":"/ˈbɛ.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q652_%28ita%29-XANA000-bene.wav","examples":[{"text":"Tutto bene.","en":"All is well.","audio":"https://tatoeba.org/en/audio/download/993438","words":[{"g":"everything, all"},null]},{"text":"Parla bene.","en":"He talks well.","audio":"https://tatoeba.org/en/audio/download/1000177","words":[{"g":"to talk, to speak","l":"parlare"},null]},{"text":"La conosco bene.","en":"I know her well.","words":[{"g":"the / her"},{"g":"to know","l":"conoscere"},null]},{"text":"Voglio fare bene.","en":"I want to do well.","words":[{"g":"to want","l":"volere"},{"g":"to do"},null]},{"text":"Hai dormito bene?","en":"Did you sleep well?","audio":"https://tatoeba.org/en/audio/download/1004017","words":[{"g":"have","l":"avere"},{"g":"to sleep","l":"dormire"},null]}]}