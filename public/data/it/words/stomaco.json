{"id":"stomaco","lemma":"stomaco","pos":"noun","rank":1409,"glosses":["stomach, tummy"],"ipa":"/ˈstɔ.ma.ko/","gender":"m","forms":{"plural":"stomaci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q652_%28ita%29-LangPao-stomaco.wav","examples":[{"text":"Dottore, ho dolore allo stomaco.","en":"I have a stomachache, doctor.","words":[{"g":"doctor"},{"g":"have","l":"avere"},{"g":"ache, pain"},null,null]},{"text":"Ho lo stomaco pieno.","en":"My stomach's full.","words":[{"g":"have","l":"avere"},{"g":"the / it"},null,{"g":"full"}]},{"text":"Avete male allo stomaco?","en":"Does your stomach hurt?","words":[{"g":"to have","l":"avere"},{"g":"evil, harm"},null,null]},{"text":"Hai lo stomaco grande.","en":"You have a large stomach.","words":[{"g":"have","l":"avere"},{"g":"the / it"},null,{"g":"adult, grownup"}]},{"text":"Hai il mal di stomaco?","en":"Do you have a stomachache?","words":[{"g":"have","l":"avere"},{"g":"the"},null,{"g":"of"},null]}]}