{"id":"motivo","lemma":"motivo","pos":"noun","rank":376,"glosses":["reason, ground","motive","motif, melody, aria"],"ipa":"/moˈti.vo/","gender":"m","forms":{"plural":"motivi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q652_%28ita%29-DivoLetto-motivo.wav","examples":[{"text":"Mi dia un motivo.","en":"Give me a reason.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"a"},null]},{"text":"Il motivo è chiaro.","en":"The reason is clear.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"bright, shiny"}]},{"text":"Non sapevo il motivo.","en":"I didn't know the reason.","words":[{"g":"not"},{"g":"to know","l":"sapere"},{"g":"the"},null]},{"text":"Vorrei sapere il motivo.","en":"I'd like to know the reason.","words":[{"g":"to want","l":"volere"},{"g":"to know"},{"g":"the"},null]},{"text":"Il motivo di questo è semplice.","en":"The reason for this is plain.","words":[{"g":"the"},null,{"g":"of"},{"g":"this"},{"g":"is","l":"essere"},{"g":"simple"}]}]}