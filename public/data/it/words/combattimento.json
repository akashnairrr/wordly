{"id":"combattimento","lemma":"combattimento","pos":"noun","rank":1984,"glosses":["battle, fight","match (boxing)"],"ipa":"/kom.bat.tiˈmen.to/","gender":"m","forms":{"plural":"combattimenti"},"examples":[{"text":"Non abbiamo paura di un combattimento.","en":"We're not afraid of a fight.","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"fear"},{"g":"of"},{"g":"a"},null]},{"text":"Ho vinto il combattimento.","en":"I won the fight.","words":[{"g":"have","l":"avere"},{"g":"defeated, beaten"},{"g":"the"},null]},{"text":"Il combattimento durò una settimana.","en":"The fighting lasted one week.","words":[{"g":"the"},null,{"g":"to last","l":"durare"},{"g":"a","l":"uno"},{"g":"week"}]},{"text":"Il combattimento è terminato.","en":"The fight is over.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"to end","l":"terminare"}]},{"text":"Che inizi il combattimento.","en":"Let the fight begin.","words":[{"g":"that / what"},{"g":"beginning","l":"inizio"},{"g":"the"},null]}]}