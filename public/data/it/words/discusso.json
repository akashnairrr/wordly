{"id":"discusso","lemma":"discusso","pos":"adj","rank":3135,"glosses":["controversial"],"ipa":"/disˈkus.so/","forms":{"feminine":"discussa","masculinePlural":"discussi","femininePlural":"discusse"},"examples":[{"text":"Questo punto sarà discusso domani.","en":"This point will be discussed tomorrow.","words":[{"g":"this"},{"g":"point , jot, iota"},{"g":"to be","l":"essere"},null,{"g":"tomorrow"}]},{"text":"Quello sarà discusso più tardi.","en":"That will be discussed later.","words":[{"g":"that"},{"g":"to be","l":"essere"},null,{"g":"more"},{"g":"late"}]},{"text":"Non l'abbiamo ancora discussa.","en":"We haven't discussed it yet.","words":[{"g":"not"},null,{"g":"to have","l":"avere"},{"g":"still / again"},null]},{"text":"Hanno discusso il problema.","en":"They discussed the problem.","words":[{"g":"to have","l":"avere"},null,{"g":"the"},{"g":"problem"}]},{"text":"Ne abbiamo già discusso.","en":"We've already discussed it.","words":[{"g":"of it"},{"g":"to have","l":"avere"},{"g":"already"},null]}]}