{"id":"disposizione","lemma":"disposizione","pos":"noun","rank":1979,"glosses":["disposal","disposition, arrangement, placing","order, direction, instruction, regulation, provision"],"ipa":"/dis.po.zitˈt͡sjo.ne/","gender":"f","forms":{"plural":"disposizioni"},"examples":[{"text":"Ho molti soldi a mia disposizione.","en":"I have a lot of money at my disposal.","words":[{"g":"have","l":"avere"},{"g":"much, very much, a lot","l":"molto"},{"g":"money"},{"g":"to / at"},{"g":"mine","l":"mio"},null]},{"text":"Sono a tua disposizione.","en":"I'm at your disposal.","words":[{"g":"am / are","l":"essere"},{"g":"to / at"},{"g":"yours","l":"tuo"},null]},{"text":"Amo questa disposizione.","en":"I love this arrangement.","words":[{"g":"to love, to like","l":"amare"},{"g":"this, this one, these","l":"questo"},null]},{"text":"La mia macchina è a tua disposizione.","en":"My car is at your disposal.","words":[{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"machine"},{"g":"is","l":"essere"},{"g":"to / at"},{"g":"yours","l":"tuo"},null]},{"text":"Non ho molto denaro a disposizione.","en":"I don't have much ready money.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"very / a lot"},{"g":"money"},{"g":"to / at"},null]}]}