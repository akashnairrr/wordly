{"id":"gioia","lemma":"gioia","pos":"noun","rank":1382,"glosses":["joy, delight","synonym of gioiello (“jewel”)"],"ipa":"/ˈd͡ʒɔ.ja/","gender":"f","forms":{"plural":"gioie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q652_%28ita%29-LangPao-gioia.wav","examples":[{"text":"Mi dà gioia.","en":"That gives me joy.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},null]},{"text":"Oggi è un giorno pieno di gioia.","en":"Today is a day full of joy.","words":[{"g":"today"},{"g":"is","l":"essere"},{"g":"a"},{"g":"day"},{"g":"full"},{"g":"of"},null]},{"text":"Sono lacrime di gioia.","en":"They're tears of joy.","words":[{"g":"am / are","l":"essere"},{"g":"tear","l":"lacrima"},{"g":"of"},null]},{"text":"Saltai dalla gioia.","en":"I jumped for joy.","words":[{"g":"to jump","l":"saltare"},null,null]},{"text":"Era piena di gioia.","en":"She was full of joy.","words":[{"g":"to be","l":"essere"},{"g":"flood, spate"},{"g":"of"},null]}]}