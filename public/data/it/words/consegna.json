{"id":"consegna","lemma":"consegna","pos":"noun","rank":1837,"glosses":["delivery, handover, consignment","orders, confinement to barracks","confusion, mix up"],"ipa":"/konˈseɲ.ɲa/","gender":"f","forms":{"plural":"consegne"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q652_%28ita%29-LangPao-consegna.wav","examples":[{"text":"Consegna questo messaggio.","en":"Deliver this message.","words":[null,{"g":"this"},{"g":"message"}]},{"text":"Ho una consegna per te.","en":"I have a delivery for you.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null,{"g":"for"},{"g":"you, thee"}]},{"text":"Hai firmato per la consegna.","en":"You signed for the delivery.","words":[{"g":"have","l":"avere"},{"g":"to sign","l":"firmare"},{"g":"for"},{"g":"the / her"},null]},{"text":"Consegna giornali.","en":"He delivers newspapers.","words":[null,{"g":"newspaper","l":"giornale"}]},{"text":"Tom non effettuerà consegne oggi.","en":"Tom won't be making any deliveries today.","words":[null,{"g":"not"},null,null,{"g":"today"}]}]}