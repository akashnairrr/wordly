{"id":"incrociato","lemma":"incrociato","pos":"adj","rank":4749,"glosses":["cross; crossed","crossover","crossbred"],"forms":{"feminine":"incrociata","masculinePlural":"incrociati","femininePlural":"incrociate"},"examples":[{"text":"Ho incrociato tuo padre ieri.","en":"I ran into your father yesterday.","words":[{"g":"have","l":"avere"},null,{"g":"yours"},{"g":"father"},{"g":"yesterday"}]},{"text":"Tieni le dita incrociate.","en":"Keep your fingers crossed.","words":[{"g":"to hold","l":"tenere"},{"g":"the / to her"},{"g":"finger","l":"dito"},null]},{"text":"Ho incrociato un vecchio amico.","en":"I ran into an old friend.","words":[{"g":"have","l":"avere"},null,{"g":"a"},{"g":"old, outworn"},{"g":"friend"}]},{"text":"Le nostre strade si sono incrociate.","en":"Our paths have crossed.","words":[{"g":"the / to her"},{"g":"our","l":"nostro"},{"g":"road, way, street","l":"strada"},{"g":"oneself"},{"g":"am / are","l":"essere"},null]},{"text":"Ha incrociato le gambe.","en":"He crossed his legs.","words":[{"g":"has","l":"avere"},null,{"g":"the / to her"},{"g":"leg","l":"gamba"}]}]}