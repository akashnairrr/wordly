{"id":"livello","lemma":"livello","pos":"noun","rank":759,"glosses":["level","level, tier","level, standard"],"ipa":"/liˈvɛl.lo/","gender":"m","forms":{"plural":"livelli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q652_%28ita%29-LangPao-livello.wav","examples":[{"text":"Il livello del fiume è alto.","en":"The river level is high.","words":[{"g":"the"},null,{"g":"of the"},{"g":"river"},{"g":"is","l":"essere"},{"g":"high, tall"}]},{"text":"Siamo tutti a livelli diversi.","en":"We are all at different levels.","words":[{"g":"to be","l":"essere"},{"g":"all"},{"g":"to / at"},null,{"g":"several things/people"}]},{"text":"Non mi abbasserò al suo livello.","en":"I won't lower myself to his level.","words":[{"g":"not"},{"g":"me / myself"},{"g":"to lower","l":"abbassare"},{"g":"to the"},{"g":"his, hers, its"},null]},{"text":"È un problema a livello mondiale.","en":"It's a worldwide problem.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"problem"},{"g":"to / at"},null,{"g":"world, worldwide"}]},{"text":"Siamo tutte a livelli diversi.","en":"We are all at different levels.","words":[{"g":"to be","l":"essere"},{"g":"everything, all","l":"tutto"},{"g":"to / at"},null,{"g":"several things/people"}]}]}