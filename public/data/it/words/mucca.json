{"id":"mucca","lemma":"mucca","pos":"noun","rank":2964,"glosses":["a dairy cow"],"ipa":"/ˈmuk.ka/","gender":"f","forms":{"plural":"mucche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q652_%28ita%29-XANA000-mucca.wav","examples":[{"text":"Hai una mucca?","en":"Do you have a cow?","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Ha dieci mucche.","en":"He has ten cows.","audio":"https://tatoeba.org/en/audio/download/1001336","words":[{"g":"has","l":"avere"},{"g":"ten"},null]},{"text":"Non ho una mucca.","en":"I don't have a cow.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Quante mucche hai?","en":"How many cows do you have?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"have","l":"avere"}]},{"text":"Una mucca è un animale utile.","en":"A cow is a useful animal.","words":[{"g":"a","l":"uno"},null,{"g":"is","l":"essere"},{"g":"a"},{"g":"animal"},{"g":"useful"}]}]}