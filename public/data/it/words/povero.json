{"id":"povero","lemma":"povero","pos":"adj","rank":1017,"glosses":["poor (with little or no possessions or money)","poor (to be pitied)"],"ipa":"/ˈpɔ.ve.ro/","forms":{"feminine":"povera","masculinePlural":"poveri","femininePlural":"povere"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q652_%28ita%29-LangPao-povero.wav","examples":[{"text":"Non sono povero.","en":"I'm not poor.","audio":"https://tatoeba.org/en/audio/download/994234","words":[{"g":"not"},{"g":"am / are","l":"essere"},null]},{"text":"Dove vive questa gente povera?","en":"Where do these poor people live?","words":[{"g":"where"},{"g":"to live","l":"vivere"},{"g":"this, this one, these","l":"questo"},null,null]},{"text":"È povero ma felice.","en":"He is poor, but happy.","words":[{"g":"is","l":"essere"},null,{"g":"but"},{"g":"happy"}]},{"text":"Dove vivono queste persone povere?","en":"Where do these poor people live?","words":[{"g":"where"},{"g":"to live","l":"vivere"},{"g":"this, this one, these","l":"questo"},{"g":"person","l":"persona"},null]},{"text":"Non siamo poveri.","en":"We're not poor.","words":[{"g":"not"},{"g":"to be","l":"essere"},null]}]}