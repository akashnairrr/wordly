{"id":"peccato","lemma":"peccato","pos":"noun","rank":633,"glosses":["sin","bummer, pity"],"ipa":"/pekˈka.to/","gender":"m","forms":{"plural":"peccati"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q652_%28ita%29-XANA000-peccato.wav","examples":[{"text":"È sempre un peccato mentire?","en":"Is it always a sin to tell a lie?","words":[{"g":"is","l":"essere"},{"g":"always"},{"g":"a"},null,{"g":"to lie"}]},{"text":"Penso che sia un vero peccato.","en":"I do think that it's a pity.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"both ... and .."},{"g":"a"},{"g":"true"},null]},{"text":"È un peccato che non possa venire.","en":"It is a pity that he can't come.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"that / what"},{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to come"}]},{"text":"È un peccato quando qualcuno muore.","en":"It's a pity when somebody dies.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"when"},{"g":"someone, somebody"},{"g":"to die","l":"morire"}]},{"text":"Ho peccato.","en":"I have sinned.","words":[{"g":"have","l":"avere"},null]}]}