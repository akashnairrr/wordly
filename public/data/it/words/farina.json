{"id":"farina","lemma":"farina","pos":"noun","rank":4447,"glosses":["flour, meal"],"ipa":"/faˈri.na/","gender":"f","forms":{"plural":"farine"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-farina.wav","examples":[{"text":"Abbiamo abbastanza farina?","en":"Do we have enough flour?","words":[{"g":"to have","l":"avere"},{"g":"enough, sufficiently"},null]},{"text":"Sto cercando la farina.","en":"I'm looking for the flour.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to look for","l":"cercare"},{"g":"the / her"},null]},{"text":"Abbiamo bisogno di più farina.","en":"We need more flour.","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"more"},null]},{"text":"Ci serve più farina.","en":"We need more flour.","words":[{"g":"us / there"},{"g":"slave","l":"servo"},{"g":"more"},null]},{"text":"Ci servono farina e zucchero.","en":"We need flour and sugar.","words":[{"g":"us / there"},{"g":"to serve","l":"servire"},null,{"g":"and"},{"g":"sugar"}]}]}