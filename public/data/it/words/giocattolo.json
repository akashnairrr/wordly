{"id":"giocattolo","lemma":"giocattolo","pos":"noun","rank":3019,"glosses":["toy","puppet (person who can be easily manipulated)"],"ipa":"/d͡ʒoˈkat.to.lo/","gender":"m","forms":{"plural":"giocattoli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q652_%28ita%29-LangPao-giocattolo.wav","examples":[{"text":"Questo giocattolo costa molto.","en":"This toy costs a lot.","words":[{"g":"this"},null,{"g":"to cost","l":"costare"},{"g":"very / a lot"}]},{"text":"Metti via i tuoi giocattoli.","en":"Put away your toys.","words":[{"g":"to put","l":"mettere"},{"g":"street, path"},{"g":"the","l":"la"},{"g":"\"your parents\""},null]},{"text":"È solo un giocattolo.","en":"It's just a toy.","words":[{"g":"is","l":"essere"},{"g":"only, just"},{"g":"a"},null]},{"text":"Vivo accanto al negozio di giocattoli.","en":"I live next door to the toy shop.","words":[{"g":"alive, live"},{"g":"beside"},{"g":"to the"},{"g":"shop, a store"},{"g":"of"},null]},{"text":"Il mio giocattolo è rotto.","en":"My toy is broken.","words":[{"g":"the"},{"g":"mine"},null,{"g":"is","l":"essere"},{"g":"broken"}]}]}