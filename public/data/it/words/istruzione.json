{"id":"istruzione","lemma":"istruzione","pos":"noun","rank":2102,"glosses":["education, schooling","teaching","instruction (in education, and in a CPU)"],"ipa":"/is.trutˈt͡sjo.ne/","gender":"f","forms":{"plural":"istruzioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q652_%28ita%29-DivoLetto-istruzione.wav","examples":[{"text":"L'istruzione è la chiave.","en":"Education is the key.","words":[null,null,{"g":"is","l":"essere"},{"g":"the / her"},{"g":"key"}]},{"text":"Hai letto le istruzioni?","en":"Have you read the instructions?","words":[{"g":"have","l":"avere"},{"g":"bed"},{"g":"the / to her"},null]},{"text":"Perché non legge le istruzioni?","en":"Why don't you read the instructions?","words":[{"g":"why / because"},{"g":"not"},{"g":"law"},{"g":"the / to her"},null]},{"text":"Ha ricevuto una buona istruzione.","en":"He received a good education.","words":[{"g":"has","l":"avere"},{"g":"to receive","l":"ricevere"},{"g":"a","l":"uno"},{"g":"righteous, moral","l":"buono"},null]},{"text":"Ecco le tue istruzioni.","en":"Here are your instructions.","words":[{"g":"here is, there is"},{"g":"the / to her"},{"g":"yours","l":"tuo"},null]}]}