{"id":"esibizione","lemma":"esibizione","pos":"noun","rank":3976,"glosses":["performance, pageantry","exhibition, showing off","presentation (of a document)"],"ipa":"/e.zi.bitˈt͡sjo.ne/","gender":"f","forms":{"plural":"esibizioni"},"examples":[{"text":"Vedremo l'esibizione domani.","en":"We'll see the exhibit tomorrow.","words":[{"g":"to see","l":"vedere"},null,null,{"g":"tomorrow"}]},{"text":"Hai dei biglietti per l'esibizione di oggi?","en":"Do you have any tickets for today's performance?","words":[{"g":"have","l":"avere"},{"g":"some"},{"g":"ticket","l":"biglietto"},{"g":"for"},null,null,{"g":"of"},{"g":"today"}]},{"text":"Ti è piaciuta l'esibizione?","en":"Did you enjoy the exhibition?","words":[{"g":"you"},{"g":"is","l":"essere"},null,null,null]},{"text":"L'esibizione inizierà alle otto.","en":"The performance will begin at 8:00.","words":[null,null,{"g":"to begin, to set about","l":"iniziare"},null,{"g":"eight"}]},{"text":"L'esibizione era molto impressionante.","en":"The exhibition was very impressive.","words":[null,null,{"g":"to be","l":"essere"},{"g":"very / a lot"},{"g":"striking"}]}]}