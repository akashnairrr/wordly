{"id":"affrontato","lemma":"affrontato","pos":"adj","rank":3125,"glosses":["facing each other"],"ipa":"/af.fronˈta.to/","forms":{"feminine":"affrontata","masculinePlural":"affrontati","femininePlural":"affrontate"},"examples":[{"text":"Ho affrontato il problema.","en":"I dealt with the problem.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"problem"}]},{"text":"Come ha affrontato la questione?","en":"How did you deal with the matter?","words":[{"g":"how / like"},{"g":"has","l":"avere"},null,{"g":"the / her"},{"g":"question"}]},{"text":"Questi problemi vanno affrontati con cautela.","en":"These problems must be dealt with carefully.","words":[{"g":"this, this one, these","l":"questo"},{"g":"problem","l":"problema"},{"g":"to go","l":"andare"},null,{"g":"with"},{"g":"caution, care"}]},{"text":"Abbiamo affrontato la morte.","en":"We faced death.","words":[{"g":"to have","l":"avere"},null,{"g":"the / her"},{"g":"death"}]},{"text":"Tom ha già affrontato quel problema.","en":"Tom has already dealt with that problem.","words":[null,{"g":"has","l":"avere"},{"g":"already"},null,null,{"g":"problem"}]}]}