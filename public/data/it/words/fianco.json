{"id":"fianco","lemma":"fianco","pos":"noun","rank":1027,"glosses":["flank, haunch (part of the body)","side","the whole body"],"ipa":"/ˈfjan.ko/","gender":"m","forms":{"plural":"fianchi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6a/LL-Q652_%28ita%29-DivoLetto-fianco.wav","examples":[{"text":"Ha un dolore nel fianco.","en":"He has a pain in his side.","words":[{"g":"has","l":"avere"},{"g":"a"},{"g":"ache, pain"},{"g":"in the"},null]},{"text":"Vivo di fianco ad un negozio.","en":"I live next to a shop.","words":[{"g":"alive, live"},{"g":"of"},null,null,{"g":"a"},{"g":"shop, a store"}]},{"text":"Sono al tuo fianco.","en":"I'm on your side.","words":[{"g":"am / are","l":"essere"},{"g":"to the"},{"g":"yours"},null]},{"text":"Vive di fianco a me.","en":"He lives next to me.","words":[{"g":"to live","l":"vivere"},{"g":"of"},null,{"g":"to / at"},{"g":"me"}]},{"text":"Il tuo posto è al mio fianco.","en":"Your place is by my side.","words":[{"g":"the"},{"g":"yours"},{"g":"place, spot"},{"g":"is","l":"essere"},{"g":"to the"},{"g":"mine"},null]}]}