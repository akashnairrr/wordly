{"id":"freno","lemma":"freno","pos":"noun","rank":3928,"glosses":["brake","check, curb, control, restraint","bit (of a horse)"],"ipa":"/ˈfre.no/","gender":"m","forms":{"plural":"freni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q652_%28ita%29-DivoLetto-freno.wav","examples":[{"text":"Il freno non ha funzionato.","en":"The brake didn't work.","words":[{"g":"the"},null,{"g":"not"},{"g":"has","l":"avere"},{"g":"to function, to work","l":"funzionare"}]},{"text":"Il freno ha smesso di funzionare.","en":"The brake stopped working.","words":[{"g":"the"},null,{"g":"has","l":"avere"},{"g":"cast-off"},{"g":"of"},{"g":"to function, to work"}]},{"text":"Tieni a freno la lingua!","en":"Hold your tongue!","words":[{"g":"to hold","l":"tenere"},{"g":"to / at"},null,{"g":"the / her"},{"g":"tongue"}]},{"text":"Devi imparare a tenere a freno la lingua.","en":"You've got to learn to hold your tongue.","words":[{"g":"to owe","l":"dovere"},{"g":"to learn"},{"g":"to / at"},{"g":"to hold"},{"g":"to / at"},null,{"g":"the / her"},{"g":"tongue"}]},{"text":"Lui schiacciò il pedale del freno.","en":"He pressed the brake pedal.","words":[{"g":"he"},null,{"g":"the"},{"g":"pedal"},{"g":"of the"},null]}]}