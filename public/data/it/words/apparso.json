{"id":"apparso","lemma":"apparso","pos":"adj","rank":4603,"glosses":["appeared"],"ipa":"/apˈpar.so/","forms":{"feminine":"apparsa","masculinePlural":"apparsi","femininePlural":"apparse"},"examples":[{"text":"È apparso un uomo sulla porta.","en":"A man appeared at the door.","words":[{"g":"is","l":"essere"},null,{"g":"a"},{"g":"person, man"},{"g":"plant of the genus Sulla"},{"g":"gate"}]},{"text":"È apparsa una donna da dietro un albero.","en":"A woman appeared from behind a tree.","words":[{"g":"is","l":"essere"},null,{"g":"a","l":"uno"},{"g":"woman"},{"g":"from"},{"g":"behind"},{"g":"a"},{"g":"tree"}]},{"text":"È apparso del fumo.","en":"Smoke appeared.","words":[{"g":"is","l":"essere"},null,{"g":"of the"},{"g":"smoke"}]},{"text":"Una ragazza apparse di fronte a me.","en":"A girl appeared before me.","words":[{"g":"a","l":"uno"},{"g":"girl, young woman"},null,null,null,{"g":"to / at"},{"g":"me"}],"phrases":[[3,5,"opposite"]]},{"text":"Non è ancora apparso.","en":"He hasn't appeared yet.","words":[{"g":"not"},{"g":"is","l":"essere"},{"g":"still / again"},null]}]}