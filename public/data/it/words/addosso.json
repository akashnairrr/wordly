{"id":"addosso","lemma":"addosso","pos":"prep","rank":591,"glosses":["on, next to"],"ipa":"/adˈdɔs.so/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q652_%28ita%29-XANA000-addosso.wav","examples":[{"text":"Non ho addosso nulla per oggi.","en":"I have nothing on for today.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"nothing, anything"},{"g":"for"},{"g":"today"}]},{"text":"Lo posso provare addosso?","en":"May I try that on?","words":[{"g":"the / it"},{"g":"can, could","l":"potere"},{"g":"to try"},null]},{"text":"Perché non provi addosso questo cappello?","en":"Why don't you try on this hat?","words":[{"g":"why / because"},{"g":"not"},{"g":"to try","l":"provare"},null,{"g":"this"},{"g":"hat"}]},{"text":"Se lo provi addosso.","en":"Try it on.","words":[{"g":"if"},{"g":"the / it"},{"g":"to try","l":"provare"},null]},{"text":"Dorme con addosso le scarpe.","en":"He sleeps with his shoes on.","words":[{"g":"to sleep","l":"dormire"},{"g":"with"},null,{"g":"the / to her"},{"g":"shoe","l":"scarpa"}]}]}