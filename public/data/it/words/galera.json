{"id":"galera","lemma":"galera","pos":"noun","rank":1579,"glosses":["prison, jail, jug","galley (long ship propelled primarily by oars)"],"ipa":"/ɡaˈlɛ.ra/","gender":"f","forms":{"plural":"galere"},"examples":[{"text":"Mio marito è in galera.","en":"My husband is in jail.","words":[{"g":"mine"},{"g":"husband"},{"g":"is","l":"essere"},{"g":"in"},null]},{"text":"Potrei andare in galera.","en":"I could go to jail.","words":[{"g":"can, could","l":"potere"},{"g":"to go"},{"g":"in"},null]},{"text":"La galera lo ha cambiato?","en":"Has prison changed him?","words":[{"g":"the / her"},null,{"g":"the / it"},{"g":"has","l":"avere"},{"g":"to exchange","l":"cambiare"}]},{"text":"Le galere non bastano.","en":"Prisons aren't enough.","words":[{"g":"the / to her"},null,{"g":"not"},{"g":"to be enough","l":"bastare"}]},{"text":"Non voglio finire in galera.","en":"I don't want to end up in jail.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to finish"},{"g":"in"},null]}]}