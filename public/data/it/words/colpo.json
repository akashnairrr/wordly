{"id":"colpo","lemma":"colpo","pos":"noun","rank":542,"glosses":["blow, knock, shock","punch, hit, pound","shot (of a gun)"],"ipa":"/ˈkol.po/","gender":"m","forms":{"plural":"colpi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q652_%28ita%29-LangPao-colpo.wav","examples":[{"text":"Ho ancora un colpo.","en":"I still have a shot.","words":[{"g":"have","l":"avere"},{"g":"still / again"},{"g":"a"},null]},{"text":"Era un colpo basso.","en":"It was a low blow.","words":[{"g":"to be","l":"essere"},{"g":"a"},null,{"g":"low"}]},{"text":"Ho sentito tre colpi.","en":"I heard three shots.","words":[{"g":"have","l":"avere"},{"g":"sincere"},{"g":"three"},null]},{"text":"Che colpo di fortuna!","en":"What a stroke of luck!","words":[{"g":"that / what"},null,null,null],"phrases":[[2,4,"makeshift"]]},{"text":"Fu un colpo di genio.","en":"It was a stroke of genius.","words":[{"g":"deceased, late"},{"g":"a"},null,{"g":"of"},{"g":"genius"}]}]}