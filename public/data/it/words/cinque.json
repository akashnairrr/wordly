{"id":"cinque","lemma":"cinque","pos":"noun","rank":332,"glosses":["five"],"ipa":"/ˈt͡ʃin.kwe/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q652_%28ita%29-XANA000-cinque.wav","examples":[{"text":"Hai cinque dollari?","en":"Do you have five dollars?","words":[{"g":"have","l":"avere"},null,{"g":"dollar","l":"dollaro"}]},{"text":"Ti devo cinque dollari.","en":"I owe you five dollars.","words":[{"g":"you"},{"g":"to owe","l":"dovere"},null,{"g":"dollar","l":"dollaro"}]},{"text":"Sarò lì alle cinque.","en":"I'll be there at five p.m.","words":[{"g":"to be","l":"essere"},{"g":"there"},null,null]},{"text":"Dove ti vedi tra cinque anni?","en":"Where do you see yourself in five years?","words":[{"g":"where"},{"g":"you"},{"g":"to see","l":"vedere"},{"g":"between"},null,{"g":"year","l":"anno"}]},{"text":"Mi dia cinque giorni.","en":"Give me five days.","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},null,{"g":"days"}]}]}