{"id":"segnale","lemma":"segnale","pos":"noun","rank":927,"glosses":["signal, sign"],"ipa":"/seɲˈɲa.le/","gender":"m","forms":{"plural":"segnali"},"examples":[{"text":"Dovrei dare il segnale?","en":"Should I give the signal?","words":[{"g":"to owe","l":"dovere"},{"g":"to give"},{"g":"the"},null]},{"text":"Il segnale era rosso.","en":"The signal was red.","words":[{"g":"the"},null,{"g":"to be","l":"essere"},{"g":"red"}]},{"text":"Ci ha dato il segnale per iniziare.","en":"He gave us the signal to begin.","words":[{"g":"us / there"},{"g":"has","l":"avere"},{"g":"datum"},{"g":"the"},null,{"g":"for"},{"g":"to begin, to set about"}]},{"text":"Noi aspetteremo il segnale.","en":"We'll wait for the signal.","words":[{"g":"we"},{"g":"to wait for","l":"aspettare"},{"g":"the"},null]},{"text":"Non colse il segnale.","en":"He didn't catch the signal.","words":[{"g":"not"},{"g":"to pick, to gather","l":"cogliere"},{"g":"the"},null]}]}