{"id":"accado","lemma":"accado","pos":"adj","rank":1832,"glosses":["Akkadian"],"ipa":"/akˈka.do/","forms":{"feminine":"accada","masculinePlural":"accadi","femininePlural":"accade"},"examples":[{"text":"Questo è dove tutto accade.","en":"This is where it all happens.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"where"},{"g":"everything, all"},null]},{"text":"Potrei davvero far sì che accada.","en":"I could really make that happen.","words":[{"g":"can, could","l":"potere"},{"g":"really, in fact"},null,null,null,null],"phrases":[[2,5,"to ensure that"]]},{"text":"Non voglio vedere che accada.","en":"I don't want to see that happen.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to see"},{"g":"that / what"},null]},{"text":"Non posso permettere che quello accada.","en":"I can't allow that to happen.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to allow"},{"g":"that / what"},{"g":"that"},null]},{"text":"Spero che accada qualcosa di interessante.","en":"I hope something interesting happens.","words":[{"g":"to hope","l":"sperare"},{"g":"that / what"},null,{"g":"something"},{"g":"of"},{"g":"interesting"}]}]}