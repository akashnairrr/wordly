{"id":"epoca","lemma":"epoca","pos":"noun","rank":1562,"glosses":["epoch, era, age, period","epoch","time, days"],"ipa":"/ˈɛ.po.ka/","gender":"f","forms":{"plural":"epoche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q652_%28ita%29-LangPao-epoca.wav","examples":[{"text":"Ero giovane e forte all'epoca.","en":"I was young and strong back then.","words":[{"g":"to be","l":"essere"},{"g":"young"},{"g":"and"},{"g":"strong"},null,null]},{"text":"Non lo sapevo all'epoca.","en":"I didn't know that at the time.","words":[{"g":"not"},{"g":"the / it"},{"g":"to know","l":"sapere"},null,null]},{"text":"Quanti anni aveva all'epoca?","en":"How old were you at that time?","words":[{"g":"how much, however much","l":"quanto"},{"g":"year","l":"anno"},{"g":"to have","l":"avere"},null,null]},{"text":"Perché non hai fatto così all'epoca?","en":"Why didn't you do so at that time?","words":[{"g":"why / because"},{"g":"not"},{"g":"have","l":"avere"},{"g":"to do","l":"fare"},{"g":"so"},null,null]},{"text":"Era qui all'epoca.","en":"He was here at that time.","words":[{"g":"to be","l":"essere"},{"g":"here"},null,null]}]}