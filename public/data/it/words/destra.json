{"id":"destra","lemma":"destra","pos":"noun","rank":817,"glosses":["right (hand, direction)"],"ipa":"/ˈdɛs.tra/","gender":"f","forms":{"plural":"destre"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-destra.wav","examples":[{"text":"L'uscita è sulla destra.","en":"The exit is on the right.","words":[null,{"g":"exit, way out"},{"g":"is","l":"essere"},{"g":"plant of the genus Sulla"},null]},{"text":"Gira la chiave verso destra.","en":"Turn the key to the right.","words":[{"g":"to turn","l":"girare"},{"g":"the / her"},{"g":"key"},{"g":"in the direction of"},null]},{"text":"Prendi la strada a destra.","en":"Take the road on the right.","words":[{"g":"to take","l":"prendere"},{"g":"the / her"},{"g":"road, way, street"},{"g":"to / at"},null]},{"text":"Gira a destra lì.","en":"Turn right there.","words":[{"g":"to turn","l":"girare"},{"g":"to / at"},null,{"g":"there"}]},{"text":"Puoi vedere il mare alla tua destra.","en":"You can see the sea on your right.","words":[{"g":"can, could","l":"potere"},{"g":"to see"},{"g":"the"},{"g":"sea"},{"g":"to the"},{"g":"yours","l":"tuo"},null]}]}