{"id":"dubbio","lemma":"dubbio","pos":"adj","rank":936,"glosses":["doubtful, uncertain, dubious, questionable"],"ipa":"/ˈdub.bjo/","forms":{"feminine":"dubbia","masculinePlural":"dubbi","femininePlural":"dubbie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q652_%28ita%29-LangPao-dubbio.wav","examples":[{"text":"Ho ancora dei dubbi.","en":"I still have some doubts.","words":[{"g":"have","l":"avere"},{"g":"still / again"},{"g":"some"},null]},{"text":"Hanno qualche dubbio.","en":"They have some doubts.","words":[{"g":"to have","l":"avere"},{"g":"few"},null]},{"text":"Ho i miei dubbi.","en":"I have my doubts.","words":[{"g":"have","l":"avere"},{"g":"the","l":"la"},{"g":"\"my parents\""},null]},{"text":"Senza dubbio hai sentito la notizia.","en":"Doubtless you've heard the news.","words":[{"g":"without, -less"},null,{"g":"have","l":"avere"},{"g":"sincere"},{"g":"the / her"},{"g":"item of news"}]},{"text":"Ho dubbi sul suo successo.","en":"I have doubts about his career.","words":[{"g":"have","l":"avere"},null,null,{"g":"his, hers, its"},{"g":"success"}]}]}