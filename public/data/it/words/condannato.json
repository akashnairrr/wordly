{"id":"condannato","lemma":"condannato","pos":"adj","rank":2237,"glosses":["convicted","condemned"],"ipa":"/kon.danˈna.to/","forms":{"feminine":"condannata","masculinePlural":"condannati","femininePlural":"condannate"},"examples":[{"text":"Fu condannato a morte.","en":"He was condemned to death.","words":[{"g":"deceased, late"},null,null,null],"phrases":[[2,4,"so as to cause death"]]},{"text":"Sono stata condannata a morte.","en":"I've been sentenced to death.","words":[{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},null,null,null],"phrases":[[3,5,"so as to cause death"]]},{"text":"Il giudice lo ha condannato a morte.","en":"The judge condemned him to death.","words":[{"g":"the"},{"g":"judge, magistrate"},{"g":"the / it"},{"g":"has","l":"avere"},null,null,null],"phrases":[[5,7,"so as to cause death"]]},{"text":"Venne condannato in prigione per un anno.","en":"He was sentenced to prison for one year.","words":[{"g":"to come","l":"venire"},null,{"g":"in"},{"g":"jail, prison"},{"g":"for"},{"g":"a"},{"g":"year"}]},{"text":"Tre sono stati condannati all'ergastolo.","en":"Three were sentenced to life in prison.","words":[{"g":"three"},{"g":"am / are","l":"essere"},{"g":"state","l":"stato"},null,null,{"g":"workhouse for offenders"}]}]}