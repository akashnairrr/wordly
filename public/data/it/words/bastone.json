{"id":"bastone","lemma":"bastone","pos":"noun","rank":2292,"glosses":["stick, cane, staff, pole, rod","club","bat"],"ipa":"/basˈto.ne/","gender":"m","forms":{"plural":"bastoni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q652_%28ita%29-LangPao-bastone.wav","examples":[{"text":"Mi ha colpito con un bastone.","en":"He struck at me with a stick.","words":[{"g":"me / myself"},{"g":"has","l":"avere"},{"g":"struck"},{"g":"with"},{"g":"a"},null]},{"text":"Il cane annusò il bastone.","en":"The dog sniffed the stick.","words":[{"g":"the"},{"g":"dog"},null,{"g":"the"},null]},{"text":"Non uso più un bastone.","en":"I don't use a cane anymore.","words":[{"g":"not"},{"g":"use"},{"g":"more"},{"g":"a"},null]},{"text":"Uccisi il ratto con un bastone.","en":"I killed the rat with a stick.","words":[{"g":"to kill","l":"uccidere"},{"g":"the"},null,{"g":"with"},{"g":"a"},null]},{"text":"Sai come fare un fuoco usando solo bastoni di legno?","en":"Do you know how to start a fire using just sticks of wood?","words":[{"g":"to know","l":"sapere"},{"g":"how / like"},{"g":"to do"},{"g":"a"},{"g":"fire"},{"g":"to use","l":"usare"},{"g":"only, just"},null,{"g":"of"},{"g":"wood"}]}]}