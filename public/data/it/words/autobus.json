{"id":"autobus","lemma":"autobus","pos":"noun","rank":1211,"glosses":["bus"],"ipa":"/ˈaw.to.bus/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q652_%28ita%29-LangPao-autobus.wav","examples":[{"text":"Prendi un autobus.","en":"Take a bus.","words":[{"g":"to take","l":"prendere"},{"g":"a"},null]},{"text":"Ogni autobus è pieno.","en":"Every bus is full.","words":[{"g":"each, every"},null,{"g":"is","l":"essere"},{"g":"full"}]},{"text":"Prendo sempre un autobus.","en":"I always take a bus.","words":[{"g":"to take","l":"prendere"},{"g":"always"},{"g":"a"},null]},{"text":"Questo autobus va alla spiaggia?","en":"Does this bus go to the beach?","words":[{"g":"this"},null,{"g":"to go","l":"andare"},{"g":"to the"},{"g":"beach"}]},{"text":"Vedo l'autobus.","en":"I see the bus.","words":[{"g":"to see","l":"vedere"},null,null]}]}