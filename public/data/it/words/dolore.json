{"id":"dolore","lemma":"dolore","pos":"noun","rank":587,"glosses":["ache, pain","sorrow, grief"],"ipa":"/doˈlo.re/","gender":"m","forms":{"plural":"dolori"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q652_%28ita%29-LangPao-dolore.wav","examples":[{"text":"Sento un dolore qui.","en":"I feel a pain here.","words":[{"g":"to feel","l":"sentire"},{"g":"a"},null,{"g":"here"}]},{"text":"Quanto è grande il dolore?","en":"How bad is the pain?","words":[{"g":"how much, however much"},{"g":"is","l":"essere"},{"g":"adult, grownup"},{"g":"the"},null]},{"text":"Non sento nessun dolore.","en":"I don't feel any pain.","audio":"https://tatoeba.org/en/audio/download/1010168","words":[{"g":"not"},{"g":"to feel","l":"sentire"},null,null]},{"text":"Avevo forti dolori.","en":"I was in serious pain.","words":[{"g":"to have","l":"avere"},{"g":"strong","l":"forte"},null]},{"text":"Non ne vale il dolore.","en":"It's not worth the pain.","words":[{"g":"not"},{"g":"of it"},{"g":"to be worth","l":"valere"},{"g":"the"},null]}]}