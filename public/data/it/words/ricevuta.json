{"id":"ricevuta","lemma":"ricevuta","pos":"noun","rank":3043,"glosses":["receipt"],"ipa":"/ri.t͡ʃeˈvu.ta/","gender":"f","forms":{"plural":"ricevute"},"examples":[{"text":"Ho una ricevuta.","en":"I have a receipt.","audio":"https://tatoeba.org/en/audio/download/1001417","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Hai perso la ricevuta?","en":"Have you lost the receipt?","words":[{"g":"have","l":"avere"},{"g":"lost, wasted"},{"g":"the / her"},null]},{"text":"Posso vedere la tua ricevuta?","en":"Can I see your receipt?","words":[{"g":"can, could","l":"potere"},{"g":"to see"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Ti servono queste vecchie ricevute?","en":"Do you need these old receipts?","words":[{"g":"you"},{"g":"to serve","l":"servire"},{"g":"this, this one, these","l":"questo"},{"g":"old, outworn","l":"vecchio"},null]},{"text":"Vorrei una ricevuta, per piacere.","en":"I'd like a receipt, please.","words":[{"g":"to want","l":"volere"},{"g":"a","l":"uno"},null,null,null],"phrases":[[3,5,"please"]]}]}