{"id":"religione","lemma":"religione","pos":"noun","rank":2535,"glosses":["religion"],"ipa":"/re.liˈd͡ʒo.ne/","gender":"f","forms":{"plural":"religioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q652_%28ita%29-LangPao-religione.wav","examples":[{"text":"Trova forza nella sua religione.","en":"He finds strength in his religion.","words":[{"g":"to find","l":"trovare"},{"g":"cheer up!"},{"g":"in the"},{"g":"his, hers, its","l":"suo"},null]},{"text":"Non credo nella religione.","en":"I don't believe in religion.","words":[{"g":"not"},{"g":"to believe","l":"credere"},{"g":"in the"},null]},{"text":"Vogliono parlare di religione.","en":"They want to talk about religion.","words":[{"g":"to want","l":"volere"},{"g":"to talk, to speak"},{"g":"of"},null]},{"text":"Dovresti pensare alle loro religioni.","en":"You should think of their religions.","words":[{"g":"to owe","l":"dovere"},{"g":"to think"},null,{"g":"they"},null]},{"text":"Non parliamo di religione, OK?","en":"Let's not talk about religion, OK?","words":[{"g":"not"},{"g":"to talk, to speak","l":"parlare"},{"g":"of"},null,null]}]}