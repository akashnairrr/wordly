{"id":"umore","lemma":"umore","pos":"noun","rank":1829,"glosses":["temper, temperament","mood, humour/humor","humour/humor (supposed set of bodily fluids; fluid of the eye; etc.)"],"ipa":"/uˈmo.re/","gender":"m","forms":{"plural":"umori"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q652_%28ita%29-LangPao-umore.wav","examples":[{"text":"Hai un umore strano oggi.","en":"You're in a strange mood today.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"strange, odd, dodgy"},{"g":"today"}]},{"text":"Sei di cattivo umore?","en":"Are you in a bad mood?","words":[{"g":"are","l":"essere"},{"g":"of"},{"g":"bad"},null]},{"text":"Sono di umore migliore adesso.","en":"I'm in a better mood now.","words":[{"g":"am / are","l":"essere"},{"g":"of"},null,{"g":"better"},{"g":"now"}]},{"text":"È di buon umore oggi.","en":"She's in a good mood today.","words":[{"g":"is","l":"essere"},{"g":"of"},null,null,{"g":"today"}]},{"text":"Sei dell'umore per della pizza?","en":"Are you in the mood for some pizza?","words":[{"g":"are","l":"essere"},null,null,{"g":"for"},{"g":"of the"},{"g":"pizza"}]}]}