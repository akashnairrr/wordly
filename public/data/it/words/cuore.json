{"id":"cuore","lemma":"cuore","pos":"noun","rank":296,"glosses":["muscular organ that pumps blood","emotion, kindness, moral effort, or spirit","center, essence, or core"],"ipa":"/ˈkwɔ.re/","gender":"m","forms":{"plural":"cuori"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q652_%28ita%29-LangPao-cuore.wav","formAudio":{"cuori":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q652_%28ita%29-DivoLetto-cuori.wav"},"examples":[{"text":"Oh, abbia un cuore.","en":"Oh, have a heart.","words":[{"g":"oh"},{"g":"to have","l":"avere"},{"g":"a"},null]},{"text":"Ha un cuore gentile.","en":"She has a kind heart.","words":[{"g":"has","l":"avere"},{"g":"a"},null,{"g":"kind, courteous"}]},{"text":"Il cuore è un muscolo.","en":"The heart is a muscle.","audio":"https://tatoeba.org/en/audio/download/1010097","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"a"},{"g":"muscle"}]},{"text":"Hai un buon cuore.","en":"You have a good heart.","words":[{"g":"have","l":"avere"},{"g":"a"},null,null]},{"text":"Ti amo con tutto il cuore.","en":"I love you with all my heart.","words":[null,null,{"g":"with"},{"g":"everything, all"},{"g":"the"},null],"phrases":[[0,2,"I love you"]]}]}