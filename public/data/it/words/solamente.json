{"id":"solamente","lemma":"solamente","pos":"adv","rank":1441,"glosses":["only, just, but, alone, merely"],"ipa":"/so.laˈmen.te/","examples":[{"text":"Voglio solamente parlare.","en":"I only want to talk.","words":[{"g":"to want","l":"volere"},null,{"g":"to talk, to speak"}]},{"text":"È solamente troppo vero.","en":"It is only too true.","words":[{"g":"is","l":"essere"},null,{"g":"too much"},{"g":"true"}]},{"text":"Conosco solamente qualche parola.","en":"I only know a few words.","words":[{"g":"to know","l":"conoscere"},null,{"g":"few"},{"g":"word"}]},{"text":"Ho solamente tre dollari.","en":"I only have three dollars.","words":[{"g":"have","l":"avere"},null,{"g":"three"},{"g":"dollar","l":"dollaro"}]},{"text":"Volevo solamente essere solo.","en":"I only wanted to be alone.","words":[{"g":"to want","l":"volere"},null,{"g":"to be"},{"g":"only, just"}]}]}