{"id":"pagina","lemma":"pagina","pos":"noun","rank":1245,"glosses":["page (of a book, etc.)"],"ipa":"/ˈpa.d͡ʒi.na/","gender":"f","forms":{"plural":"pagine"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q652_%28ita%29-LangPao-pagina.wav","examples":[{"text":"Questo libro ha molte pagine.","en":"This book has a lot of pages.","words":[{"g":"this"},{"g":"book"},{"g":"has","l":"avere"},{"g":"much, very much, a lot","l":"molto"},null]},{"text":"Firma ogni pagina.","en":"Sign each page.","words":[{"g":"signature"},{"g":"each, every"},null]},{"text":"Siamo alla stessa pagina ora.","en":"We're on the same page now.","words":[{"g":"to be","l":"essere"},{"g":"to the"},{"g":"same","l":"stesso"},null,{"g":"now"}]},{"text":"Ho altre tre pagine da fare.","en":"I have three more pages to go.","words":[{"g":"have","l":"avere"},{"g":"other","l":"altro"},{"g":"three"},null,{"g":"from"},{"g":"to do"}]},{"text":"Per piacere, gira la pagina.","en":"Please turn the page.","words":[null,null,{"g":"to turn","l":"girare"},{"g":"the / her"},null],"phrases":[[0,2,"please"]]}]}