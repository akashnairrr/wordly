{"id":"ghiaccio","lemma":"ghiaccio","pos":"noun","rank":1144,"glosses":["ice (water in solid form)","used to indicate a very cold place"],"ipa":"/ˈɡjat.t͡ʃo/","gender":"m","forms":{"plural":"ghiacci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q652_%28ita%29-LangPao-ghiaccio.wav","examples":[{"text":"Il ghiaccio è molto spesso.","en":"The ice is very thick.","audio":"https://tatoeba.org/en/audio/download/1010004","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"very / a lot"},{"g":"thick"}]},{"text":"Lo voglio con molto ghiaccio.","en":"I want it with a lot of ice.","words":[{"g":"the / it"},{"g":"to want","l":"volere"},{"g":"with"},{"g":"very / a lot"},null]},{"text":"Vuoi del ghiaccio?","en":"Would you like ice?","audio":"https://tatoeba.org/en/audio/download/1004681","words":[{"g":"to want","l":"volere"},{"g":"of the"},null]},{"text":"Vuole altro ghiaccio?","en":"Do you want more ice?","words":[{"g":"to want","l":"volere"},{"g":"other"},null]},{"text":"Ho bisogno di ghiaccio.","en":"I need ice.","words":[{"g":"have","l":"avere"},{"g":"need"},{"g":"of"},null]}]}