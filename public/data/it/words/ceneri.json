{"id":"ceneri","lemma":"ceneri","pos":"noun","rank":3745,"glosses":["ashes, cinders"],"ipa":"/ˈt͡ʃe.ne.ri/","gender":"f","examples":[{"text":"Le sue ceneri sono sepolte qui.","en":"His ashes are buried here.","words":[null,null,null,{"g":"am / are","l":"essere"},{"g":"buried","l":"sepolto"},{"g":"here"}],"phrases":[[0,2,"his"]]},{"text":"Le ceneri stavano ancora fumando.","en":"The cinders were still smoking.","words":[{"g":"the / to her"},null,{"g":"to stay, remain","l":"stare"},{"g":"still / again"},{"g":"to smoke","l":"fumare"}]},{"text":"Le ceneri della nonna sono in un'urna nel tempio.","en":"Grandmother's ashes are in an urn at the temple.","words":[{"g":"the / to her"},null,{"g":"of the"},{"g":"grandmother, granny"},{"g":"am / are","l":"essere"},{"g":"in"},{"g":"a"},{"g":"urn, pot"},{"g":"in the"},{"g":"temple"}]}]}