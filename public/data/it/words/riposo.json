{"id":"riposo","lemma":"riposo","pos":"noun","rank":1631,"glosses":["rest, repose, break","sleep, rest","retirement"],"ipa":"/riˈpɔ.zo/","gender":"m","forms":{"plural":"riposi"},"examples":[{"text":"Penso di aver bisogno di riposo.","en":"I think I need a rest.","words":[{"g":"to think","l":"pensare"},{"g":"of"},null,{"g":"need"},{"g":"of"},null]},{"text":"La domenica mi riposo.","en":"On Sundays I rest.","words":[{"g":"the / her"},{"g":"Sunday"},{"g":"me / myself"},null]},{"text":"Hai semplicemente bisogno di un buon riposo.","en":"You just need a good rest.","words":[{"g":"have","l":"avere"},{"g":"simply, plainly, plain"},{"g":"need"},{"g":"of"},{"g":"a"},null,null]},{"text":"Un po' di riposo ci farebbe molto bene.","en":"A little rest would do us a lot of good.","words":[{"g":"a"},null,{"g":"of"},null,{"g":"us / there"},{"g":"to do","l":"fare"},{"g":"very / a lot"},{"g":"well"}]},{"text":"Riposi in pace.","en":"Rest in peace.","words":[null,null,null],"phrases":[[1,3,"in peace"]]}]}