{"id":"sangue","lemma":"sangue","pos":"noun","rank":290,"glosses":["blood (vital liquid)","blood (temper of mind)","blood (family relation)"],"ipa":"/ˈsan.ɡwe/","gender":"m","forms":{"plural":"sangui"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q652_%28ita%29-LangPao-sangue.wav","examples":[{"text":"È sangue?","en":"Is that blood?","words":[{"g":"is","l":"essere"},null]},{"text":"Ho perso molto sangue.","en":"I lost a lot of blood.","words":[{"g":"have","l":"avere"},{"g":"lost, wasted"},{"g":"very / a lot"},null]},{"text":"Ci sono tracce di sangue qui.","en":"There are traces of blood here.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"sign","l":"traccia"},{"g":"of"},null,{"g":"here"}]},{"text":"Era sorpreso alla vista del sangue.","en":"He was surprised at the sight of blood.","words":[{"g":"to be","l":"essere"},{"g":"surprised"},{"g":"to the"},{"g":"sight"},{"g":"of the"},null]},{"text":"Il sangue è rosso.","en":"Blood is red.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"red"}]}]}