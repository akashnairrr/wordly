{"id":"onesto","lemma":"onesto","pos":"adj","rank":1586,"glosses":["honest, honourable/honorable, honorable, upright","fair, just, decent, reasonable","honest, chaste, virtuous"],"ipa":"/oˈnɛs.to/","forms":{"feminine":"onesta","masculinePlural":"onesti","femininePlural":"oneste"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9b/LL-Q652_%28ita%29-DivoLetto-onesto.wav","examples":[{"text":"È molto onesto.","en":"He is very honest.","audio":"https://tatoeba.org/en/audio/download/1003223","words":[{"g":"is","l":"essere"},{"g":"very / a lot"},null]},{"text":"Sarò molto onesta con te.","en":"I'm going to be very honest with you.","words":[{"g":"to be","l":"essere"},{"g":"very / a lot"},null,{"g":"with"},{"g":"you, thee"}]},{"text":"Essere sempre onesti non è facile.","en":"To be always honest is not easy.","words":[{"g":"to be"},{"g":"always"},null,{"g":"not"},{"g":"is","l":"essere"},{"g":"easy"}]},{"text":"Sembra essere onesto.","en":"He seems to be honest.","words":[{"g":"to seem","l":"sembrare"},{"g":"to be"},null]},{"text":"Siate oneste con me.","en":"Be honest with me.","words":[{"g":"to be","l":"essere"},null,{"g":"with"},{"g":"me"}]}]}