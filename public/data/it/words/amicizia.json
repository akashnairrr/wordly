{"id":"amicizia","lemma":"amicizia","pos":"noun","rank":1351,"glosses":["friendship","friends"],"ipa":"/a.miˈt͡ʃit.t͡sja/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f6/LL-Q652_%28ita%29-LangPao-amicizia.wav/LL-Q652_%28ita%29-LangPao-amicizia.wav.mp3","gender":"f","forms":{"plural":"amicizie"},"examples":[{"text":"Grazie per la tua amicizia.","en":"Thank you for your friendship.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Voglio farmi delle nuove amicizie.","en":"I want to make new friends.","words":[{"g":"to want","l":"volere"},null,null,{"g":"new","l":"nuovo"},null]},{"text":"Voglio fare amicizia con tua sorella.","en":"I want to make friends with your sister.","words":[{"g":"to want","l":"volere"},{"g":"to do"},null,{"g":"with"},{"g":"yours","l":"tuo"},{"g":"sister"}]},{"text":"Stai facendo delle amicizie qui?","en":"Are you making friends here?","words":[{"g":"to stay, remain","l":"stare"},{"g":"to do","l":"fare"},null,null,{"g":"here"}]},{"text":"Sai quanto apprezzo la nostra amicizia.","en":"You know how much I value our friendship.","words":[{"g":"to know","l":"sapere"},{"g":"how much, however much"},{"g":"to appreciate","l":"apprezzare"},{"g":"the / her"},{"g":"our","l":"nostro"},null]}]}