{"id":"topi","lemma":"topi","pos":"noun","rank":2509,"glosses":["topi (Damaliscus lunatus jimela)"],"ipa":"/ˈtɔ.pi/","gender":"m","examples":[{"text":"Ci sono molti topi sulla nave.","en":"There are many rats on the ship.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"plant of the genus Sulla"},{"g":"ship"}]},{"text":"Uccisi i topi.","en":"I killed the mice.","words":[{"g":"to kill","l":"uccidere"},{"g":"the","l":"la"},null]},{"text":"Ho ucciso i topi.","en":"I killed the mice.","words":[{"g":"have","l":"avere"},{"g":"victim"},{"g":"the","l":"la"},null]},{"text":"Ci sono dei topi in quel negozio.","en":"There are mice in that shop.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"some"},null,{"g":"in"},null,{"g":"shop, a store"}]},{"text":"Hai paura dei topi?","en":"Are you afraid of mice?","words":[{"g":"have","l":"avere"},{"g":"fear"},{"g":"some"},null]}]}