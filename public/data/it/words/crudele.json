{"id":"crudele","lemma":"crudele","pos":"adj","rank":1885,"glosses":["cruel"],"ipa":"/kruˈdɛ.le/","forms":{"plural":"crudeli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q652_%28ita%29-DivoLetto-crudele.wav","examples":[{"text":"È un mondo crudele là fuori.","en":"It's a cruel world out there.","words":[{"g":"is","l":"essere"},null,null,null,{"g":"there"},{"g":"out, outside, outwards"}],"phrases":[[1,3,"a lot"]]},{"text":"I bambini possono essere crudeli.","en":"Children can be cruel.","words":[{"g":"the","l":"la"},{"g":"child","l":"bambino"},{"g":"can, could","l":"potere"},{"g":"to be"},null]},{"text":"Sei un uomo crudele.","en":"You're a cruel man.","words":[{"g":"are","l":"essere"},{"g":"a"},{"g":"person, man"},null]},{"text":"Non voglio essere crudele.","en":"I don't want to be cruel.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to be"},null]},{"text":"Gli uomini sono crudeli.","en":"Men are cruel.","words":[{"g":"the / to him"},{"g":"person, man","l":"uomo"},{"g":"am / are","l":"essere"},null]}]}