{"id":"marinaio","lemma":"marinaio","pos":"noun","rank":3585,"glosses":["sailor, mariner, seaman","tarpaulin, tar"],"ipa":"/ma.riˈna.jo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/21/LL-Q652_%28ita%29-LangPao-marinaio.wav/LL-Q652_%28ita%29-LangPao-marinaio.wav.mp3","gender":"m","forms":{"plural":"marinai","feminine":"marinaia"},"examples":[{"text":"Non sono un marinaio.","en":"I'm not a sailor.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"a"},null]},{"text":"È diventato un marinaio.","en":"He became a sailor.","words":[{"g":"is","l":"essere"},{"g":"to become","l":"diventare"},{"g":"a"},null]},{"text":"I marinai erano in balia del tempo.","en":"The sailors were at the mercy of the weather.","words":[{"g":"the","l":"la"},null,{"g":"to be","l":"essere"},{"g":"in"},{"g":"wet nurse"},{"g":"of the"},{"g":"time"}]},{"text":"Sta considerando di diventare un marinaio.","en":"He's considering becoming a sailor.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to consider","l":"considerare"},{"g":"of"},{"g":"to become"},{"g":"a"},null]},{"text":"Tom era un marinaio?","en":"Was Tom a sailor?","words":[null,{"g":"to be","l":"essere"},{"g":"a"},null]}]}