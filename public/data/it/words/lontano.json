{"id":"lontano","lemma":"lontano","pos":"adv","rank":475,"glosses":["far"],"ipa":"/lonˈta.no/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q652_%28ita%29-LangPao-lontano.wav","examples":[{"text":"Quanto è lontano?","en":"How far is it?","words":[{"g":"how much, however much"},{"g":"is","l":"essere"},null]},{"text":"È lontano da qui?","en":"Is it far from here?","words":[{"g":"is","l":"essere"},null,{"g":"from"},{"g":"here"}]},{"text":"Non andare troppo lontano.","en":"Don't go too far away.","audio":"https://tatoeba.org/en/audio/download/1006495","words":[{"g":"not"},{"g":"to go"},{"g":"too much"},null]},{"text":"Vivo lontano da qua.","en":"I live far away from here.","words":[{"g":"alive, live"},null,{"g":"from"},{"g":"here"}]},{"text":"Quanto è lontano dalla prossima città?","en":"How far is it to the next town?","words":[{"g":"how much, however much"},{"g":"is","l":"essere"},null,null,{"g":"very near, near, close","l":"prossimo"},{"g":"town, city"}]}]}