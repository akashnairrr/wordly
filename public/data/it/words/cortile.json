{"id":"cortile","lemma":"cortile","pos":"noun","rank":2463,"glosses":["courtyard","forecourt","farmyard"],"ipa":"/korˈti.le/","gender":"m","forms":{"plural":"cortili"},"examples":[{"text":"Ci sono tre alberi nel cortile.","en":"There are three trees in the yard.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"three"},{"g":"tree","l":"albero"},{"g":"in the"},null]},{"text":"Il cortile della scuola era molto piccolo.","en":"The schoolyard was very small.","words":[{"g":"the"},null,{"g":"of the"},{"g":"school"},{"g":"to be","l":"essere"},{"g":"very / a lot"},{"g":"small"}]},{"text":"Ci sono alcuni studenti nel cortile della scuola.","en":"There are some students in the schoolyard.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"some, a few","l":"alcuno"},{"g":"student","l":"studente"},{"g":"in the"},null,{"g":"of the"},{"g":"school"}]},{"text":"C'è un pavone in cortile.","en":"There's a peacock in the courtyard.","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"peacock, peafowl"},{"g":"in"},null]},{"text":"C'è qualcuno nel cortile posteriore.","en":"There's someone in the backyard.","words":[null,{"g":"is","l":"essere"},{"g":"someone, somebody"},{"g":"in the"},null,{"g":"back"}]}]}