{"id":"macellaio","lemma":"macellaio","pos":"noun","rank":3912,"glosses":["butcher"],"ipa":"/ma.t͡ʃelˈla.jo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/7e/LL-Q652_%28ita%29-LangPao-macellaio.wav/LL-Q652_%28ita%29-LangPao-macellaio.wav.mp3","gender":"m","forms":{"plural":"macellai","feminine":"macellaia"},"examples":[{"text":"È un macellaio.","en":"He's a butcher.","words":[{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Questo macellaio ha la carne migliore.","en":"This butcher has the best meat.","words":[{"g":"this"},null,{"g":"has","l":"avere"},{"g":"the / her"},{"g":"meat, flesh"},{"g":"better"}]},{"text":"Noi siamo macellai.","en":"We're butchers.","words":[{"g":"we"},{"g":"to be","l":"essere"},null]},{"text":"Sono già andato dal macellaio stamattina.","en":"I already went to the butcher's shop this morning.","words":[{"g":"am / are","l":"essere"},{"g":"already"},{"g":"to go","l":"andare"},{"g":"since"},null,{"g":"this morning"}]},{"text":"Sono già andata dal macellaio questa mattina.","en":"I already went to the butcher's shop this morning.","words":[{"g":"am / are","l":"essere"},{"g":"already"},{"g":"outward journey"},{"g":"since"},null,{"g":"this, this one, these","l":"questo"},{"g":"morning"}]}]}