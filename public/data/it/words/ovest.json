{"id":"ovest","lemma":"ovest","pos":"noun","rank":1594,"glosses":["west"],"ipa":"/ˈɔ.vest/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q652_%28ita%29-LangPao-ovest.wav","examples":[{"text":"Stiamo andando ad ovest.","en":"We're going west.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to go","l":"andare"},null,null]},{"text":"Ha iniziato il suo viaggio verso ovest.","en":"He began his trip to the West.","words":[{"g":"has","l":"avere"},{"g":"initiated"},{"g":"the"},{"g":"his, hers, its"},{"g":"journey"},{"g":"in the direction of"},null]},{"text":"Ti suggerisco di andare ad ovest.","en":"I suggest you go west.","words":[{"g":"you"},{"g":"to suggest","l":"suggerire"},{"g":"of"},{"g":"to go"},null,null]},{"text":"La nave sta salpando verso ovest.","en":"The ship is sailing to the west.","words":[{"g":"the / her"},{"g":"ship"},{"g":"to stay, remain","l":"stare"},null,{"g":"in the direction of"},null]},{"text":"Il sole tramonta sempre ad ovest.","en":"The sun always sets in the west.","words":[{"g":"the"},{"g":"sun"},{"g":"to set","l":"tramontare"},{"g":"always"},null,null]}]}