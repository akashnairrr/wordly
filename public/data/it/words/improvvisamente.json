{"id":"improvvisamente","lemma":"improvvisamente","pos":"adv","rank":1923,"glosses":["suddenly, all of a sudden, unexpectedly, short, out of the blue, cold turkey"],"ipa":"/im.prov.vi.zaˈmen.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q652_%28ita%29-LangPao-improvvisamente.wav","examples":[{"text":"Era improvvisamente molto felice.","en":"He was suddenly very happy.","words":[{"g":"to be","l":"essere"},null,{"g":"very / a lot"},{"g":"happy"}]},{"text":"Un vecchio uomo mi ha parlato improvvisamente.","en":"An old man spoke to me suddenly.","words":[{"g":"a"},{"g":"old, outworn"},{"g":"person, man"},{"g":"me / myself"},{"g":"has","l":"avere"},{"g":"spoken"},null]},{"text":"Perché sei improvvisamente aggressivo?","en":"Why are you suddenly aggressive?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,{"g":"aggressive"}]},{"text":"Il tempo è cambiato improvvisamente.","en":"The weather changed suddenly.","words":[{"g":"the"},{"g":"time"},{"g":"is","l":"essere"},{"g":"to exchange","l":"cambiare"},null]},{"text":"Ho improvvisamente perso peso.","en":"I've suddenly lost weight.","words":[{"g":"have","l":"avere"},null,{"g":"lost, wasted"},{"g":"heavy"}]}]}