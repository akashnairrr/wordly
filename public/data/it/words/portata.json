{"id":"portata","lemma":"portata","pos":"noun","rank":883,"glosses":["course, plate (of a meal)","carrying capacity (of a vehicle)","the amount of traffic that can develop on a specific railway/railroad line"],"ipa":"/porˈta.ta/","gender":"f","forms":{"plural":"portate"},"examples":[{"text":"Grazie per avermi portata qui.","en":"Thanks for bringing me here.","words":[{"g":"thanks, thank-you"},{"g":"for"},null,null,{"g":"here"}]},{"text":"Te ne ho portata una nuova.","en":"I brought you a new one.","words":[{"g":"you, thee"},{"g":"of it"},{"g":"have","l":"avere"},null,{"g":"a","l":"uno"},{"g":"news"}]},{"text":"Lo metta a portata di mano.","en":"Put it within reach.","words":[{"g":"the / it"},{"g":"to put","l":"mettere"},{"g":"to / at"},null,{"g":"of"},{"g":"hand"}]},{"text":"L'hanno portata via.","en":"They have taken her away.","words":[null,{"g":"to have","l":"avere"},null,{"g":"street, path"}]},{"text":"La casa fu portata via dalla piena.","en":"The house was carried away by the flood.","words":[{"g":"the / her"},{"g":"house"},{"g":"deceased, late"},null,{"g":"street, path"},null,{"g":"flood, spate"}]}]}