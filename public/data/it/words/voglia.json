{"id":"voglia","lemma":"voglia","pos":"noun","rank":406,"glosses":["wish, will, desire, longing","birthmark"],"ipa":"/ˈvɔʎ.ʎa/","gender":"f","forms":{"plural":"voglie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q652_%28ita%29-LangPao-voglia.wav","examples":[{"text":"Puoi portare chiunque voglia venire.","en":"You may bring whoever wants to come.","words":[{"g":"can, could","l":"potere"},{"g":"to bring"},{"g":"whoever"},null,{"g":"to come"}]},{"text":"Ho voglia di uscire oggi.","en":"I feel like going out today.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"to go out, leave, exit"},{"g":"today"}]},{"text":"Ho voglia di bere una birra.","en":"I feel like drinking a beer.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"to drink"},{"g":"a","l":"uno"},{"g":"beer"}]},{"text":"Avevo voglia di parlare con qualcuno.","en":"I felt like talking to someone.","words":[{"g":"to have","l":"avere"},null,{"g":"of"},{"g":"to talk, to speak"},{"g":"with"},{"g":"someone, somebody"}]},{"text":"Non ho davvero voglia di parlare.","en":"I really don't feel like talking.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"really, in fact"},null,{"g":"of"},{"g":"to talk, to speak"}]}]}