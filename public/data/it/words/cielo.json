{"id":"cielo","lemma":"cielo","pos":"noun","rank":462,"glosses":["sky","heaven"],"ipa":"/ˈt͡ʃɛ.lo/","gender":"m","forms":{"plural":"cieli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q652_%28ita%29-LangPao-cielo.wav","examples":[{"text":"Guarda il cielo.","en":"Look at the sky.","words":[{"g":"to look at","l":"guardare"},{"g":"the"},null]},{"text":"Perché il cielo è blu?","en":"Why is the sky blue?","words":[{"g":"why / because"},{"g":"the"},null,{"g":"is","l":"essere"},{"g":"blue"}]},{"text":"Il cielo è pieno di stelle.","en":"The sky is full of stars.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"full"},{"g":"of"},{"g":"star","l":"stella"}]},{"text":"I cieli non saranno puliti.","en":"The skies won't be clear.","words":[{"g":"the","l":"la"},null,{"g":"not"},{"g":"to be","l":"essere"},{"g":"clean, neat, tidy","l":"pulito"}]},{"text":"Perché ci sono delle stelle nel cielo?","en":"Why are there stars in the sky?","words":[{"g":"why / because"},{"g":"us / there"},{"g":"am / are","l":"essere"},null,{"g":"star","l":"stella"},{"g":"in the"},null]}]}