{"id":"gentilezza","lemma":"gentilezza","pos":"noun","rank":3206,"glosses":["kindness, courtesy","delicacy, grace"],"ipa":"/d͡ʒen.tiˈlet.t͡sa/","gender":"f","forms":{"plural":"gentilezze"},"examples":[{"text":"Grazie per la vostra gentilezza.","en":"Thank you for your kindness.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the / her"},{"g":"yours","l":"vostro"},null]},{"text":"Ti ringrazio per la tua gentilezza.","en":"I thank you for your kindness.","words":[{"g":"you"},{"g":"to thank","l":"ringraziare"},{"g":"for"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Non posso dimenticare la sua gentilezza.","en":"I can't forget his kindness.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to forget"},{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null]},{"text":"Lo ha fatto tutto per gentilezza.","en":"He did it all out of kindness.","words":[{"g":"the / it"},{"g":"has","l":"avere"},{"g":"to do","l":"fare"},{"g":"everything, all"},{"g":"for"},null]},{"text":"Lo faccia con gentilezza.","en":"Do it gently.","words":[{"g":"the / it"},{"g":"face"},{"g":"with"},null]}]}