{"id":"riconosciuto","lemma":"riconosciuto","pos":"adj","rank":2181,"glosses":["recognized","acknowledged"],"ipa":"/ri.ko.noʃˈʃu.to/","forms":{"feminine":"riconosciuta","masculinePlural":"riconosciuti","femininePlural":"riconosciute"},"examples":[{"text":"Hai riconosciuto quella donna?","en":"Did you recognize that woman?","words":[{"g":"have","l":"avere"},null,{"g":"that one","l":"quello"},{"g":"woman"}]},{"text":"Ho riconosciuto il nome.","en":"I recognized the name.","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"name"}]},{"text":"Non l'ho riconosciuta.","en":"I didn't recognize it.","words":[{"g":"not"},null,{"g":"have","l":"avere"},null]},{"text":"Il mondo non l'ha riconosciuto.","en":"The world did not recognize him.","words":[{"g":"the"},{"g":"world"},{"g":"not"},null,{"g":"has","l":"avere"},null]},{"text":"Siamo stati riconosciuti.","en":"We've been spotted.","words":[{"g":"to be","l":"essere"},{"g":"state","l":"stato"},null]}]}