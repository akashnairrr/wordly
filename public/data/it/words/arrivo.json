{"id":"arrivo","lemma":"arrivo","pos":"noun","rank":478,"glosses":["arrival","finish, finish line"],"ipa":"/arˈri.vo/","gender":"m","forms":{"plural":"arrivi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q652_%28ita%29-LangPao-arrivo.wav","examples":[{"text":"Quando ci arrivo?","en":"When do I get there?","words":[{"g":"when"},{"g":"us / there"},null]},{"text":"Come arrivo a casa tua?","en":"How do I get to your house?","words":[{"g":"how / like"},null,{"g":"to / at"},{"g":"house"},{"g":"yours","l":"tuo"}]},{"text":"Ti farò sapere appena arrivo lì.","en":"I'll let you know as soon as I get there.","words":[{"g":"you"},{"g":"to do","l":"fare"},{"g":"to know"},{"g":"barely, hardly"},null,{"g":"there"}]},{"text":"La pizza è in arrivo.","en":"Pizza is on the way.","words":[{"g":"the / her"},{"g":"pizza"},{"g":"is","l":"essere"},{"g":"in"},null]},{"text":"Dovremmo aspettare fino all'arrivo della polizia.","en":"We should wait until the police arrive.","words":[{"g":"to owe","l":"dovere"},{"g":"to wait for"},{"g":"till, until, as far as"},null,null,{"g":"of the"},{"g":"police"}]}]}