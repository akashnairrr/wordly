{"id":"cervo","lemma":"cervo","pos":"noun","rank":3808,"glosses":["deer","stag"],"ipa":"/ˈt͡ʃɛr.vo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/07/LL-Q652_%28ita%29-LangPao-cervo.wav/LL-Q652_%28ita%29-LangPao-cervo.wav.mp3","gender":"m","forms":{"plural":"cervi","feminine":"cerva"},"examples":[{"text":"È un cervo?","en":"Is it a deer?","words":[{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Non abbiamo visto molti cervi nella foresta.","en":"We didn't see many deer in the forest.","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"visa"},{"g":"much, very much, a lot","l":"molto"},null,{"g":"in the"},{"g":"forest"}]},{"text":"Il cacciatore ha sparato a un cervo.","en":"The hunter shot at a deer.","words":[{"g":"the"},{"g":"hunter, huntsman"},{"g":"has","l":"avere"},{"g":"the collar of a men's…"},{"g":"to / at"},{"g":"a"},null]},{"text":"L'arciere ha ucciso il cervo.","en":"The archer killed the deer.","words":[null,{"g":"archer"},{"g":"has","l":"avere"},{"g":"victim"},{"g":"the"},null]},{"text":"Cacciavano cervi e volpi.","en":"They hunted deer and foxes.","words":[{"g":"to hunt, to prey on","l":"cacciare"},null,{"g":"and"},{"g":"fox, vixen","l":"volpe"}]}]}