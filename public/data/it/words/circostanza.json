{"id":"circostanza","lemma":"circostanza","pos":"noun","rank":1882,"glosses":["circumstance"],"ipa":"/t͡ʃir.kosˈtan.t͡sa/","gender":"f","forms":{"plural":"circostanze"},"examples":[{"text":"Quali erano le circostanze?","en":"What were the circumstances?","words":[{"g":"what?","l":"quale"},{"g":"to be","l":"essere"},{"g":"the / to her"},null]},{"text":"Dipende dalle circostanze.","en":"It depends on the circumstances.","words":[{"g":"to depend","l":"dipendere"},null,null]},{"text":"Queste sono circostanze speciali.","en":"These are special circumstances.","words":[{"g":"this, this one, these","l":"questo"},{"g":"am / are","l":"essere"},null,{"g":"special","l":"speciale"}]},{"text":"Le circostanze sono diverse ora.","en":"The circumstances are different now.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"different, diverse","l":"diverso"},{"g":"now"}]},{"text":"Devi capire le circostanze.","en":"You have to understand the circumstances.","words":[{"g":"to owe","l":"dovere"},{"g":"to understand"},{"g":"the / to her"},null]}]}