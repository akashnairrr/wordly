{"id":"sette","lemma":"sette","pos":"noun","rank":640,"glosses":["seven"],"ipa":"/ˈsɛt.te/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q652_%28ita%29-XANA000-sette.wav","examples":[{"text":"Una settimana ha sette giorni.","en":"A week has seven days.","words":[{"g":"a","l":"uno"},{"g":"week"},{"g":"has","l":"avere"},null,{"g":"days"}]},{"text":"Vado a lavorare alle sette.","en":"I go to work at seven o'clock.","words":[{"g":"to go","l":"andare"},{"g":"to / at"},{"g":"to work"},null,null]},{"text":"Vieni alle sei o alle sette?","en":"Are you coming at six or at seven?","words":[{"g":"to come","l":"venire"},null,{"g":"are","l":"essere"},{"g":"or"},null,null]},{"text":"Lei ha sette figli.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/1003963","words":[{"g":"she / you (formal)"},{"g":"has","l":"avere"},null,{"g":"son","l":"figlio"}]},{"text":"Sono arrivato a casa alle sette.","en":"I got home at seven.","audio":"https://tatoeba.org/en/audio/download/1004752","words":[{"g":"am / are","l":"essere"},{"g":"successful"},{"g":"to / at"},{"g":"house"},null,null]}]}