{"id":"detto","lemma":"detto","pos":"adj","rank":4788,"glosses":["known as, called","above-mentioned, aforementioned, said"],"ipa":"/ˈdet.to/","forms":{"feminine":"detta","masculinePlural":"detti","femininePlural":"dette"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q652_%28ita%29-XANA000-detto.wav","examples":[{"text":"Ti ho detto quanto ti amo?","en":"Have I told you how much I love you?","words":[{"g":"you"},{"g":"have","l":"avere"},null,{"g":"how much, however much"},null,null],"phrases":[[4,6,"I love you"]]},{"text":"Mi hai detto tutto?","en":"Have you told me everything?","words":[{"g":"me / myself"},{"g":"have","l":"avere"},null,{"g":"everything, all"}]},{"text":"Quando ho detto una bugia?","en":"When have I told a lie?","words":[{"g":"when"},{"g":"have","l":"avere"},null,{"g":"a","l":"uno"},{"g":"lie, untruth"}]},{"text":"Come ho detto, abbiamo un problema.","en":"Like I said, we have a problem.","words":[{"g":"how / like"},{"g":"have","l":"avere"},null,{"g":"to have","l":"avere"},{"g":"a"},{"g":"problem"}]},{"text":"È ciò che ho detto.","en":"That's what I said.","audio":"https://tatoeba.org/en/audio/download/1004022","words":[{"g":"is","l":"essere"},{"g":"this"},{"g":"that / what"},{"g":"have","l":"avere"},null]}]}