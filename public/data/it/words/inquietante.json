{"id":"inquietante","lemma":"inquietante","pos":"adj","rank":2190,"glosses":["disturbing, disquieting, alarming","perturbing, exciting"],"ipa":"/in.kwjeˈtan.te/","forms":{"plural":"inquietanti"},"examples":[{"text":"Questa casa è inquietante.","en":"This house is creepy.","words":[{"g":"this, this one, these","l":"questo"},{"g":"house"},{"g":"is","l":"essere"},null]},{"text":"Ho appena sentito una voce inquietante.","en":"I've just heard a disturbing rumor.","words":[{"g":"have","l":"avere"},{"g":"barely, hardly"},{"g":"sincere"},{"g":"a","l":"uno"},{"g":"voice"},null]},{"text":"C'era un silenzio inquietante.","en":"There was an eerie silence.","words":[null,{"g":"to be","l":"essere"},{"g":"a"},{"g":"silence, quiet"},null]},{"text":"Sono sicuro che deve essere stato molto inquietante.","en":"I'm sure it must've been very disturbing.","words":[{"g":"am / are","l":"essere"},{"g":"safe"},{"g":"that / what"},{"g":"to owe","l":"dovere"},{"g":"to be"},{"g":"to be","l":"essere"},{"g":"very / a lot"},null]},{"text":"È una melodia inquietante.","en":"That's an eerie melody.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"melody, tune"},null]}]}