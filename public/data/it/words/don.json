{"id":"don","lemma":"don","pos":"noun","rank":996,"glosses":["Father (a title given to priests)","A title of respect to a man (historically, also the title of the lowest ranked nobles in Southern Italy): sir"],"ipa":"/ˈdɔn/","gender":"m","forms":{"feminine":"donna"},"formAudio":{"donna":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q652_%28ita%29-XANA000-donna.wav"},"examples":[{"text":"Sei una donna?","en":"Are you a woman?","words":[{"g":"are","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"Quella è una donna?","en":"Is that a woman?","words":[{"g":"that one","l":"quello"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"È un uomo o una donna?","en":"Is that a man or a woman?","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},{"g":"or"},{"g":"a","l":"uno"},null]},{"text":"Conosco questa donna.","en":"I know this woman.","words":[{"g":"to know","l":"conoscere"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Ascolta la donna.","en":"Listen to the woman.","words":[{"g":"to listen to","l":"ascoltare"},{"g":"the / her"},null]}]}