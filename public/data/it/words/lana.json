{"id":"lana","lemma":"lana","pos":"noun","rank":2340,"glosses":["wool"],"ipa":"/ˈla.na/","gender":"f","forms":{"plural":"lane"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q652_%28ita%29-LangPao-lana.wav","examples":[{"text":"La lana si tinge bene.","en":"Wool dyes nicely.","words":[{"g":"the / her"},null,{"g":"oneself"},null,{"g":"well"}]},{"text":"Vestiva un abito di lana.","en":"She was dressed in wool.","words":[{"g":"to dress","l":"vestire"},{"g":"a"},{"g":"garment"},{"g":"of"},null]},{"text":"Otteniamo la lana dalle pecore.","en":"Sheep provide us with wool.","words":[{"g":"to obtain","l":"ottenere"},{"g":"the / her"},null,null,{"g":"sheep","l":"pecora"}]},{"text":"Le pecore ci forniscono la lana.","en":"Sheep provide us with wool.","words":[{"g":"the / to her"},{"g":"sheep","l":"pecora"},{"g":"us / there"},{"g":"to supply","l":"fornire"},{"g":"the / her"},null]},{"text":"I prezzi della lana stanno diminuendo.","en":"Wool prices are falling.","words":[{"g":"the","l":"la"},{"g":"price","l":"prezzo"},{"g":"of the"},null,{"g":"to stay, remain","l":"stare"},{"g":"to diminish","l":"diminuire"}]}]}