{"id":"bistecca","lemma":"bistecca","pos":"noun","rank":3244,"glosses":["beefsteak","steak, chop, cut"],"ipa":"/bisˈtek.ka/","gender":"f","forms":{"plural":"bistecche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q652_%28ita%29-LangPao-bistecca.wav","examples":[{"text":"Voglio mangiare una bistecca.","en":"I want to eat a steak.","words":[{"g":"to want","l":"volere"},{"g":"to eat"},{"g":"a","l":"uno"},null]},{"text":"Come vuoi la tua bistecca?","en":"How do you want your steak?","words":[{"g":"how / like"},{"g":"to want","l":"volere"},{"g":"the / her"},{"g":"yours","l":"tuo"},null]},{"text":"Non ci sono bistecche lì.","en":"There's no steak there.","words":[{"g":"not"},{"g":"us / there"},{"g":"am / are","l":"essere"},null,{"g":"there"}]},{"text":"Ci ha ordinato delle bistecche.","en":"He ordered us steaks.","words":[{"g":"us / there"},{"g":"has","l":"avere"},{"g":"ordered"},null,null]},{"text":"Volevo mangiare della bistecca.","en":"I wanted to eat steak.","words":[{"g":"to want","l":"volere"},{"g":"to eat"},{"g":"of the"},null]}]}