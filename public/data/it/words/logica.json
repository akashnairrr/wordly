{"id":"logica","lemma":"logica","pos":"noun","rank":2851,"glosses":["logic"],"ipa":"/ˈlɔ.d͡ʒi.ka/","gender":"f","forms":{"plural":"logiche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q652_%28ita%29-LangPao-logica.wav","examples":[{"text":"Mi sembra logica.","en":"It seems logical to me.","words":[{"g":"me / myself"},{"g":"to seem","l":"sembrare"},null]},{"text":"Sarebbe la scelta logica.","en":"That would be the logical choice.","words":[{"g":"to be","l":"essere"},{"g":"the / her"},{"g":"choice"},null]},{"text":"Non è logica.","en":"It's not logical.","words":[{"g":"not"},{"g":"is","l":"essere"},null]},{"text":"È la cosa logica da fare.","en":"It's the logical thing to do.","words":[{"g":"is","l":"essere"},{"g":"the / her"},{"g":"thing"},null,{"g":"from"},{"g":"to do"}]},{"text":"La sua risposta era logica.","en":"His reply was logical.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"answer"},{"g":"to be","l":"essere"},null]}]}