{"id":"decisamente","lemma":"decisamente","pos":"adv","rank":1122,"glosses":["decidedly, definitely, positively, strongly, indeed","decisively, resolutely"],"ipa":"/de.t͡ʃi.zaˈmen.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q652_%28ita%29-XANA000-decisamente.wav","examples":[{"text":"Abbiamo decisamente troppo lavoro da fare.","en":"We have far too much work to do.","words":[{"g":"to have","l":"avere"},null,{"g":"too much"},{"g":"work"},{"g":"from"},{"g":"to do"}]},{"text":"Sono ancora decisamente troppo giovane.","en":"I'm still way too young.","words":[{"g":"am / are","l":"essere"},{"g":"still / again"},null,{"g":"too much"},{"g":"young"}]},{"text":"Era decisamente troppo tardi.","en":"It was far too late.","words":[{"g":"to be","l":"essere"},null,{"g":"too much"},{"g":"late"}]},{"text":"L'affitto è decisamente troppo alto.","en":"The rent is far too high.","words":[null,{"g":"renting, hiring"},{"g":"is","l":"essere"},null,{"g":"too much"},{"g":"high, tall"}]},{"text":"Poteva andare decisamente peggio.","en":"It could've been much worse.","words":[{"g":"can, could","l":"potere"},{"g":"to go"},null,{"g":"worse"}]}]}