{"id":"disagio","lemma":"disagio","pos":"noun","rank":2188,"glosses":["discomfort, usually mental rather than physical","inconvenience, trouble","hardships, poverty"],"ipa":"/diˈza.d͡ʒo/","gender":"m","forms":{"plural":"disagi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/28/LL-Q652_%28ita%29-LangPao-disagio.wav","examples":[{"text":"Mi sento a disagio.","en":"I feel queasy.","words":[{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"to / at"},null]},{"text":"Io mi sento a disagio con lei.","en":"I feel ill at ease with her.","words":[{"g":"I"},{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"to / at"},null,{"g":"with"},{"g":"she / you (formal)"}]},{"text":"Tutti sembrano a disagio.","en":"Everyone looks uncomfortable.","words":[{"g":"all"},{"g":"to seem","l":"sembrare"},{"g":"to / at"},null]},{"text":"Ci scusiamo per qualsiasi disagio.","en":"We apologize for any inconvenience.","words":[{"g":"us / there"},{"g":"to excuse","l":"scusare"},{"g":"for"},{"g":"any"},null]},{"text":"La sua lettera mi fa sentire a disagio.","en":"His letter makes me uneasy.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"letter"},{"g":"me / myself"},{"g":"to do","l":"fare"},{"g":"to feel"},{"g":"to / at"},null]}]}