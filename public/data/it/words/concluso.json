{"id":"concluso","lemma":"concluso","pos":"adj","rank":3034,"glosses":["concluded, closed, made, settled","included, including"],"ipa":"/konˈklu.zo/","forms":{"feminine":"conclusa","masculinePlural":"conclusi","femininePlural":"concluse"},"examples":[{"text":"La giornata non è ancora conclusa.","en":"The day isn't over yet.","words":[{"g":"the / her"},{"g":"day"},{"g":"not"},{"g":"is","l":"essere"},{"g":"still / again"},null]},{"text":"Vorrei che questo lavoro fosse concluso.","en":"I wish this job was over.","words":[{"g":"to want","l":"volere"},{"g":"that / what"},{"g":"this"},{"g":"work"},{"g":"to be","l":"essere"},null]},{"text":"Ha concluso il pranzo col caffè.","en":"She finished up lunch with coffee.","words":[{"g":"has","l":"avere"},null,{"g":"the"},{"g":"lunch or dinner"},null,{"g":"coffee"}]},{"text":"La mia pausa pranzo è quasi conclusa.","en":"My lunch break's almost over.","words":[{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"pause"},{"g":"lunch or dinner"},{"g":"is","l":"essere"},{"g":"as if"},null]},{"text":"Sembra che il mio lavoro sia concluso.","en":"It looks like my job's done.","words":[{"g":"to seem","l":"sembrare"},{"g":"that / what"},{"g":"the"},{"g":"mine"},{"g":"work"},{"g":"both ... and .."},null]}]}