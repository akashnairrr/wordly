{"id":"fienile","lemma":"fienile","pos":"noun","rank":4072,"glosses":["hayloft","barn"],"gender":"m","forms":{"plural":"fienili"},"examples":[{"text":"Il fienile era piccolo, però era forte.","en":"The barn was small, but it was strong.","words":[{"g":"the"},null,{"g":"to be","l":"essere"},{"g":"small"},{"g":"yet"},{"g":"to be","l":"essere"},{"g":"strong"}]},{"text":"Il fienile è stato distrutto.","en":"The barn was destroyed.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"to be","l":"essere"},{"g":"distraught"}]},{"text":"Il fienile è in fiamme.","en":"The barn's on fire.","words":[{"g":"the"},null,{"g":"is","l":"essere"},null,null],"phrases":[[3,5,"in flames, aflame"]]},{"text":"Ammucchiavamo il fieno nel fienile.","en":"We stored the hay in the barn.","words":[null,{"g":"the"},{"g":"hay"},{"g":"in the"},null]},{"text":"\"E cosa c'è nel palazzo sul lato opposto del cortile?\" \"Ci sono delle stalle al piano terra e dei fienili sopra di esse.\"","en":"\"And what's in the building on the other side of the yard?\" \"There are stables on the ground floor and haylofts above them.\"","words":[{"g":"and"},{"g":"thing"},null,{"g":"is","l":"essere"},{"g":"in the"},{"g":"a royal palace"},null,{"g":"broad"},{"g":"opposite"},{"g":"of the"},{"g":"courtyard"},{"g":"us / there"},{"g":"am / are","l":"essere"},null,{"g":"cowshed","l":"stalla"},{"g":"to the"},null,null,{"g":"and"},{"g":"some"},null,{"g":"over"},{"g":"of"},null],"phrases":[[16,18,"ground floor"]]}]}