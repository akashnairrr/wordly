{"id":"entusiasta","lemma":"entusiasta","pos":"adj","rank":2596,"glosses":["enthusiastic"],"ipa":"/en.tuˈzjas.ta/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/04/LL-Q652_%28ita%29-LangPao-entusiasta.wav/LL-Q652_%28ita%29-LangPao-entusiasta.wav.mp3","forms":{"masculinePlural":"entusiasti","femininePlural":"entusiaste"},"examples":[{"text":"Non sembri troppo entusiasta.","en":"You don't seem too enthusiastic.","words":[{"g":"not"},{"g":"to seem","l":"sembrare"},{"g":"too much"},null]},{"text":"Sono entrambi molto entusiasti.","en":"They are both very excited.","words":[{"g":"am / are","l":"essere"},{"g":"both"},{"g":"very / a lot"},null]},{"text":"I ragazzi erano entusiasti della musica.","en":"The boys were enthusiastic about the music.","words":[{"g":"the","l":"la"},{"g":"boy, young man","l":"ragazzo"},{"g":"to be","l":"essere"},null,{"g":"of the"},{"g":"music"}]},{"text":"Noi siamo entusiaste.","en":"We're enthusiastic.","words":[{"g":"we"},{"g":"to be","l":"essere"},null]},{"text":"Sono sempre entusiasta.","en":"I'm always eager.","words":[{"g":"am / are","l":"essere"},{"g":"always"},null]}]}