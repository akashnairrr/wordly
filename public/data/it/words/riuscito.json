{"id":"riuscito","lemma":"riuscito","pos":"adj","rank":652,"glosses":["that has had a certain outcome or result","successful"],"ipa":"/ri.uʃˈʃi.to/","forms":{"feminine":"riuscita","masculinePlural":"riusciti","femininePlural":"riuscite"},"examples":[{"text":"Sei riuscito ad arrivare in tempo?","en":"Were you able to get there in time?","words":[{"g":"are","l":"essere"},null,null,{"g":"to arrive"},null,null],"phrases":[[4,6,"in time, on time"]]},{"text":"Siete riusciti a dormire?","en":"Did you manage to sleep?","words":[{"g":"to be","l":"essere"},null,{"g":"to / at"},{"g":"to sleep"}]},{"text":"Sono riuscito a finire il lavoro.","en":"I managed to finish the work.","words":[{"g":"am / are","l":"essere"},null,{"g":"to / at"},{"g":"to finish"},{"g":"the"},{"g":"work"}]},{"text":"Sei riuscito a dormire?","en":"Did you get any sleep?","words":[{"g":"are","l":"essere"},null,{"g":"to / at"},{"g":"to sleep"}]},{"text":"Sono riuscito ad entrare.","en":"I managed to get in.","words":[{"g":"am / are","l":"essere"},null,null,{"g":"to enter, to go in"}]}]}