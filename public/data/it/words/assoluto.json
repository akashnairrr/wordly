{"id":"assoluto","lemma":"assoluto","pos":"adj","rank":2687,"glosses":["absolute (all senses)","nonnegative","complete, total, utter"],"ipa":"/as.soˈlu.to/","forms":{"feminine":"assoluta","masculinePlural":"assoluti","femininePlural":"assolute"},"examples":[{"text":"Voglio la verità assoluta.","en":"I want the absolute truth.","words":[{"g":"to want","l":"volere"},{"g":"the / her"},{"g":"truth"},null]},{"text":"Ha potere assoluto.","en":"He has absolute power.","words":[{"g":"has","l":"avere"},{"g":"can, could"},null]},{"text":"I miei ordini sono assoluti.","en":"My orders are absolute.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"order","l":"ordine"},{"g":"am / are","l":"essere"},null]},{"text":"Ho assoluta fiducia in te.","en":"I have absolute trust in you.","words":[{"g":"have","l":"avere"},null,{"g":"trust, faith"},{"g":"in"},{"g":"you, thee"}]},{"text":"Quella è l'assoluta verità!","en":"That's the absolute truth.","words":[{"g":"that one","l":"quello"},{"g":"is","l":"essere"},null,null,{"g":"truth"}]}]}