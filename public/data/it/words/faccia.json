{"id":"faccia","lemma":"faccia","pos":"noun","rank":182,"glosses":["face (of a person or an animal)","countenance, expression, face","side"],"ipa":"/ˈfat.t͡ʃa/","gender":"f","forms":{"plural":"facce","masculine":"faccino"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q652_%28ita%29-LangPao-faccia.wav","examples":[{"text":"Mi faccia un favore, OK?","en":"Do me a favor, will you?","words":[{"g":"me / myself"},null,{"g":"a"},{"g":"favour/favor"},null]},{"text":"Che vuoi che faccia?","en":"What do you want me to do?","words":[{"g":"that / what"},{"g":"to want","l":"volere"},{"g":"that / what"},null]},{"text":"Ha fatto delle facce a quella donna.","en":"She made faces at that woman.","words":[{"g":"has","l":"avere"},{"g":"to do","l":"fare"},null,null,{"g":"to / at"},{"g":"that one","l":"quello"},{"g":"woman"}]},{"text":"Ci faccia sapere cosa pensa.","en":"Let us know what you think.","words":[{"g":"us / there"},null,{"g":"to know"},{"g":"thing"},{"g":"to think","l":"pensare"}]},{"text":"Non fare facce.","en":"Don't make faces.","words":[{"g":"not"},{"g":"to do"},null]}]}