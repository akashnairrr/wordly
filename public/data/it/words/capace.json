{"id":"capace","lemma":"capace","pos":"adj","rank":1102,"glosses":["large, capacious","able, capable, clever"],"ipa":"/kaˈpa.t͡ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f2/LL-Q652_%28ita%29-LangPao-capace.wav/LL-Q652_%28ita%29-LangPao-capace.wav.mp3","forms":{"plural":"capaci"},"examples":[{"text":"Sei capace di farlo?","en":"Are you capable of doing that?","words":[{"g":"are","l":"essere"},null,{"g":"of"},null]},{"text":"Siete capaci di farlo?","en":"Are you capable of doing that?","words":[{"g":"to be","l":"essere"},null,{"g":"of"},null]},{"text":"Suo fratello è un dottore molto capace.","en":"His brother is a very capable doctor.","words":[{"g":"his, hers, its"},{"g":"brother, sibling"},{"g":"is","l":"essere"},{"g":"a"},{"g":"doctor"},{"g":"very / a lot"},null]},{"text":"È capace di farla.","en":"He's capable of doing it.","words":[{"g":"is","l":"essere"},null,{"g":"of"},{"g":"to make a fool of"}]},{"text":"Sono studenti capaci.","en":"They're able students.","words":[{"g":"am / are","l":"essere"},{"g":"student","l":"studente"},null]}]}