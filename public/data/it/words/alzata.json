{"id":"alzata","lemma":"alzata","pos":"noun","rank":3839,"glosses":["lifting, raising","top (of piece of furniture)","cake stand"],"ipa":"/alˈt͡sa.ta/","gender":"f","forms":{"plural":"alzate"},"examples":[{"text":"Posso stare alzata finché voglio.","en":"I can stay up as late as I want.","words":[{"g":"can, could","l":"potere"},{"g":"to stay, remain"},null,{"g":"as long as, while"},{"g":"to want","l":"volere"}]},{"text":"Perché sei alzata così presto?","en":"Why are you up so early?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,{"g":"so"},{"g":"soon"}]},{"text":"Ti sei alzata tardi?","en":"Did you get up late?","words":[{"g":"you"},{"g":"are","l":"essere"},null,{"g":"late"}]},{"text":"Ti sei alzata presto questa mattina?","en":"Did you get up early this morning?","words":[{"g":"you"},{"g":"are","l":"essere"},null,{"g":"soon"},{"g":"this, this one, these","l":"questo"},{"g":"morning"}]},{"text":"Sto sempre alzata fino a tardi.","en":"I always stay up late.","words":[{"g":"to stay, remain","l":"stare"},{"g":"always"},null,null,null,{"g":"late"}],"phrases":[[3,5,"up to"]]}]}