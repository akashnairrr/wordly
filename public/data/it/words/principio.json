{"id":"principio","lemma":"principio","pos":"noun","rank":2622,"glosses":["beginning, start, inception","first part; first paragraph, first subsection","beginning"],"ipa":"/prinˈt͡ʃi.pjo/","gender":"m","forms":{"plural":"principi"},"examples":[{"text":"Non capisce il principio della cosa.","en":"He doesn't understand the principle of the thing.","words":[{"g":"not"},{"g":"to understand","l":"capire"},{"g":"the"},null,{"g":"of the"},{"g":"thing"}]},{"text":"Lo sapevo fin dal principio.","en":"I knew it all along.","words":[{"g":"the / it"},{"g":"to know","l":"sapere"},null,{"g":"since"},null]},{"text":"È una questione di principio.","en":"It's a matter of principle.","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"question"},{"g":"of"},null]},{"text":"La sapevo fin dal principio.","en":"I knew it all along.","words":[{"g":"the / her"},{"g":"to know","l":"sapere"},null,{"g":"since"},null]},{"text":"Va contro ai miei principi.","en":"It's against my principles.","words":[{"g":"to go","l":"andare"},{"g":"against"},null,{"g":"\"my parents\""},null]}]}