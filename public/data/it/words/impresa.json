{"id":"impresa","lemma":"impresa","pos":"noun","rank":2158,"glosses":["enterprise, undertaking, exploit, feat, endeavour/endeavor","company, firm, business, concern"],"ipa":"/imˈpre.za/","gender":"f","forms":{"plural":"imprese"},"examples":[{"text":"L'impresa è in rosso.","en":"The company is in the red.","words":[null,null,{"g":"is","l":"essere"},{"g":"in"},{"g":"red"}]},{"text":"Lavoro per una impresa marittima.","en":"I work for a shipping company.","words":[{"g":"work"},{"g":"for"},{"g":"a","l":"uno"},null,{"g":"maritime","l":"marittimo"}]},{"text":"Ha lasciato l'impresa.","en":"She quit the company.","words":[{"g":"has","l":"avere"},{"g":"to leave","l":"lasciare"},null,null]},{"text":"Era un'impresa pericolosa.","en":"It was a dangerous venture.","words":[{"g":"to be","l":"essere"},{"g":"a"},null,{"g":"dangerous","l":"pericoloso"}]},{"text":"La sua impresa non sopravvisse alla crisi.","en":"His company didn't survive the crisis.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null,{"g":"not"},{"g":"to survive","l":"sopravvivere"},{"g":"to the"},{"g":"crisis"}]}]}