{"id":"sospetto","lemma":"sospetto","pos":"adj","rank":1316,"glosses":["suspicious, suspect, questionable","suspected","smelly"],"ipa":"/sosˈpɛt.to/","forms":{"feminine":"sospetta","masculinePlural":"sospetti","femininePlural":"sospette"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q652_%28ita%29-DivoLetto-sospetto.wav","examples":[{"text":"Qualcosa sembra sospetto?","en":"Does something seem suspicious?","words":[{"g":"something"},{"g":"to seem","l":"sembrare"},null]},{"text":"Questo è sospetto.","en":"This is suspicious.","words":[{"g":"this"},{"g":"is","l":"essere"},null]},{"text":"Non sembra un po' sospetto?","en":"Doesn't that seem a little suspicious?","words":[{"g":"not"},{"g":"to seem","l":"sembrare"},{"g":"a"},null,null]},{"text":"Hai qualche sospetto?","en":"Do you have any suspects?","words":[{"g":"have","l":"avere"},{"g":"few"},null]},{"text":"Non sembrate così sospette.","en":"Don't look so suspicious.","words":[{"g":"not"},{"g":"to seem","l":"sembrare"},{"g":"so"},null]}]}