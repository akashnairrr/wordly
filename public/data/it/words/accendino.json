{"id":"accendino","lemma":"accendino","pos":"noun","rank":4821,"glosses":["lighter (for cigarettes or cigars)"],"ipa":"/at.t͡ʃenˈdi.no/","gender":"m","forms":{"plural":"accendini"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q652_%28ita%29-DivoLetto-accendino.wav","examples":[{"text":"Hai un accendino?","en":"Do you have a lighter?","words":[{"g":"have","l":"avere"},{"g":"a"},null]},{"text":"Ce l'hai un accendino?","en":"Do you have a lighter?","words":[{"g":"reinforcing particle"},null,{"g":"have","l":"avere"},{"g":"a"},null]},{"text":"Signore, ha lasciato il suo accendino sul tavolo.","en":"Sir, you have left your lighter on the table.","words":[{"g":"Lord, God"},{"g":"has","l":"avere"},{"g":"to leave","l":"lasciare"},{"g":"the"},{"g":"his, hers, its"},null,null,{"g":"table, board, desk"}]},{"text":"Potrei scroccare una sigaretta e un accendino?","en":"Could I bum a cigarette and a light?","words":[{"g":"can, could","l":"potere"},{"g":"to scrounge"},{"g":"a","l":"uno"},{"g":"cigarette"},{"g":"and"},{"g":"a"},null]},{"text":"Tom ha tenuto il mio accendino.","en":"Tom kept my lighter.","words":[null,{"g":"has","l":"avere"},{"g":"obliged"},{"g":"the"},{"g":"mine"},null]}]}