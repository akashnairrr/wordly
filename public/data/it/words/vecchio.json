{"id":"vecchio","lemma":"vecchio","pos":"adj","rank":351,"glosses":["old, outworn","old-fashioned, out-of-date","mature, ripe"],"ipa":"/ˈvɛk.kjo/","forms":{"feminine":"vecchia","masculinePlural":"vecchi","femininePlural":"vecchie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q652_%28ita%29-XANA000-vecchio.wav","formAudio":{"vecchia":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q652_%28ita%29-XANA000-vecchia.wav"},"examples":[{"text":"Questo libro è vecchio.","en":"This book is old.","audio":"https://tatoeba.org/en/audio/download/1003203","words":[{"g":"this"},{"g":"book"},{"g":"is","l":"essere"},null]},{"text":"Sono molto vecchi.","en":"They are very old.","words":[{"g":"am / are","l":"essere"},{"g":"very / a lot"},null]},{"text":"No, grazie, vecchio.","en":"No, thanks, old man.","words":[{"g":"no"},{"g":"thanks, thank-you"},null]},{"text":"Siamo vecchi amici.","en":"We're old friends.","audio":"https://tatoeba.org/en/audio/download/1003916","words":[{"g":"to be","l":"essere"},null,{"g":"friend","l":"amico"}]},{"text":"Il vecchio sistema funziona.","en":"The old system works.","words":[{"g":"the"},null,{"g":"system"},{"g":"to function, to work","l":"funzionare"}]}]}