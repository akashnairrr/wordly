{"id":"legalmente","lemma":"legalmente","pos":"adv","rank":3598,"glosses":["legally, lawfully"],"ipa":"/le.ɡalˈmen.te/","examples":[{"text":"Non è legalmente vincolante.","en":"It's not legally binding.","words":[{"g":"not"},{"g":"is","l":"essere"},null,{"g":"binding"}]},{"text":"Tom è legalmente morto.","en":"Tom is legally dead.","words":[null,{"g":"is","l":"essere"},null,{"g":"dead man"}]},{"text":"Un contratto è un accordo legalmente vincolante.","en":"A contract is a legally binding agreement.","words":[{"g":"a"},{"g":"contracted"},{"g":"is","l":"essere"},{"g":"a"},{"g":"accord"},null,{"g":"binding"}]},{"text":"Tom è ancora legalmente sposato.","en":"Tom is still legally married.","words":[null,{"g":"is","l":"essere"},{"g":"still / again"},null,{"g":"married, wedded"}]},{"text":"Siamo legalmente obbligati a pagare le tasse.","en":"We have a legal obligation to pay our taxes.","words":[{"g":"to be","l":"essere"},null,{"g":"obliged","l":"obbligato"},{"g":"to / at"},{"g":"to pay"},{"g":"the / to her"},{"g":"tax, duty, dues","l":"tassa"}]}]}