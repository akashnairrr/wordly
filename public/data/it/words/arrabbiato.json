{"id":"arrabbiato","lemma":"arrabbiato","pos":"adj","rank":894,"glosses":["mad, rabid (of an animal)","mad, angry (of a person)"],"ipa":"/ar.rabˈbja.to/","forms":{"feminine":"arrabbiata","masculinePlural":"arrabbiati","femininePlural":"arrabbiate"},"examples":[{"text":"Quanto sei arrabbiato?","en":"How mad are you?","words":[{"g":"how much, however much"},{"g":"are","l":"essere"},null]},{"text":"Sono ancora arrabbiati?","en":"Are they still mad?","words":[{"g":"am / are","l":"essere"},{"g":"still / again"},null]},{"text":"Perché sarei arrabbiato?","en":"Why would I be mad?","words":[{"g":"why / because"},{"g":"to be","l":"essere"},null]},{"text":"Tuo fratello è molto arrabbiato.","en":"Your brother is very angry.","words":[{"g":"yours"},{"g":"brother, sibling"},{"g":"is","l":"essere"},{"g":"very / a lot"},null]},{"text":"Siete sempre arrabbiati con me.","en":"You're always mad at me.","words":[{"g":"to be","l":"essere"},{"g":"always"},null,{"g":"with"},{"g":"me"}]}]}