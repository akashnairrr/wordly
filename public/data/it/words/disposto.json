{"id":"disposto","lemma":"disposto","pos":"adj","rank":1756,"glosses":["ready, prepared, willing, inclined, disposed, open"],"ipa":"/disˈpos.to/","forms":{"feminine":"disposta","masculinePlural":"disposti","femininePlural":"disposte"},"examples":[{"text":"Sei davvero disposto ad aiutare?","en":"Are you really willing to help?","words":[{"g":"are","l":"essere"},{"g":"really, in fact"},null,null,{"g":"to help, assist"}]},{"text":"Sei disposta ad imparare?","en":"Are you willing to learn?","words":[{"g":"are","l":"essere"},null,null,{"g":"to learn"}]},{"text":"Sono disposti ad andarsene?","en":"Are they willing to leave?","words":[{"g":"am / are","l":"essere"},null,null,{"g":"to go away, leave"}]},{"text":"Sarei disposto a mentire per te.","en":"I'd be willing to lie for you.","words":[{"g":"to be","l":"essere"},null,{"g":"to / at"},{"g":"to lie"},{"g":"for"},{"g":"you, thee"}]},{"text":"Non sono disposta ad aiutare.","en":"I'm not willing to help.","words":[{"g":"not"},{"g":"am / are","l":"essere"},null,null,{"g":"to help, assist"}]}]}