{"id":"abituato","lemma":"abituato","pos":"adj","rank":2623,"glosses":["used (to)"],"ipa":"/a.bi.tuˈa.to/","forms":{"feminine":"abituata","masculinePlural":"abituati","femininePlural":"abituate"},"examples":[{"text":"Sono abituato al dolore ora.","en":"I'm used to the pain now.","words":[{"g":"am / are","l":"essere"},null,{"g":"to the"},{"g":"ache, pain"},{"g":"now"}]},{"text":"Non sono abituata ad aspettare.","en":"I'm not used to waiting.","words":[{"g":"not"},{"g":"am / are","l":"essere"},null,null,{"g":"to wait for"}]},{"text":"È abituato al lavoro.","en":"He is accustomed to the work.","words":[{"g":"is","l":"essere"},null,{"g":"to the"},{"g":"work"}]},{"text":"Vi ci abituate.","en":"You get used to it.","words":[{"g":"you"},{"g":"us / there"},null]},{"text":"Non sono ancora abituata a questo.","en":"I'm still not used to this.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"still / again"},null,{"g":"to / at"},{"g":"this"}]}]}