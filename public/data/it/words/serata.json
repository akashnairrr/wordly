{"id":"serata","lemma":"serata","pos":"noun","rank":654,"glosses":["evening, night"],"ipa":"/seˈra.ta/","gender":"f","forms":{"plural":"serate"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q652_%28ita%29-LangPao-serata.wav","examples":[{"text":"Grazie per la serata.","en":"Thank you for the evening.","words":[{"g":"thanks, thank-you"},{"g":"for"},{"g":"the / her"},null]},{"text":"Questa è una serata molto speciale.","en":"This is a very special night.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"very / a lot"},{"g":"special"}]},{"text":"Era una bella serata.","en":"It was a beautiful evening.","words":[{"g":"to be","l":"essere"},{"g":"a","l":"uno"},{"g":"beauty, belle"},null]},{"text":"Hai passato una buona serata?","en":"Did you have a nice evening?","words":[{"g":"have","l":"avere"},{"g":"past"},{"g":"a","l":"uno"},{"g":"righteous, moral","l":"buono"},null]},{"text":"Ricordo quella serata.","en":"I remember that evening.","words":[{"g":"memory"},{"g":"that one","l":"quello"},null]}]}