{"id":"colto","lemma":"colto","pos":"adj","rank":3389,"glosses":["cultivated (of land)","cultured, well-educated, cultivated (of people)","cultured, refined (e.g. of speech, writing)"],"ipa":"/ˈkol.to/","forms":{"feminine":"colta","masculinePlural":"colti","femininePlural":"colte"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q652_%28ita%29-LangPao-colto.wav","examples":[{"text":"Mi ha colto di sorpresa.","en":"It took me by surprise.","words":[{"g":"me / myself"},{"g":"has","l":"avere"},null,{"g":"of"},{"g":"surprise"}]},{"text":"Io sono colta.","en":"I'm cultured.","words":[{"g":"I"},{"g":"am / are","l":"essere"},null]},{"text":"Noi siamo colti.","en":"We're cultured.","words":[{"g":"we"},{"g":"to be","l":"essere"},null]},{"text":"Le ho colte sul fatto.","en":"I caught them in the act.","words":[{"g":"the / to her"},{"g":"have","l":"avere"},null,null,null],"phrases":[[3,5,"in the act"]]},{"text":"Non ha colto lo scherzo.","en":"He didn't get the joke.","words":[{"g":"not"},{"g":"has","l":"avere"},null,{"g":"the / it"},{"g":"joke"}]}]}