{"id":"centinaio","lemma":"centinaio","pos":"noun","rank":1521,"glosses":["hundred, about a hundred, about one hundred","hundreds, dozens (a great number)"],"ipa":"/t͡ʃen.tiˈna.jo/","gender":"m","forms":{"femininePlural":"centinaia"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q652_%28ita%29-LangPao-centinaio.wav","examples":[{"text":"Ho centinaia di amici.","en":"I have hundreds of friends.","words":[{"g":"have","l":"avere"},null,{"g":"of"},{"g":"friend","l":"amico"}]},{"text":"Ha centinaia di libri.","en":"She has hundreds of books.","words":[{"g":"has","l":"avere"},null,{"g":"of"},{"g":"book","l":"libro"}]},{"text":"C'erano centinaia di persone lì.","en":"There were hundreds of people there.","words":[null,{"g":"to be","l":"essere"},null,{"g":"of"},{"g":"person","l":"persona"},{"g":"there"}]},{"text":"C'erano centinaia di auto nella strada.","en":"There were hundreds of cars on the street.","words":[null,{"g":"to be","l":"essere"},null,{"g":"of"},{"g":"auto"},{"g":"in the"},{"g":"road, way, street"}]},{"text":"Centinaia di città hanno subito dei danni.","en":"Hundreds of cities and towns suffered damage.","words":[null,{"g":"of"},{"g":"town, city"},{"g":"to have","l":"avere"},{"g":"at once"},{"g":"some"},{"g":"damage, harm, injury","l":"danno"}]}]}