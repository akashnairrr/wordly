{"id":"contro","lemma":"contro","pos":"prep","rank":251,"glosses":["against"],"ipa":"/ˈkon.tro/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5e/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-contro.wav","examples":[{"text":"È contro la legge?","en":"Is that against the law?","words":[{"g":"is","l":"essere"},null,{"g":"the / her"},{"g":"law"}]},{"text":"Sono contro la guerra.","en":"I'm against the war.","audio":"https://tatoeba.org/en/audio/download/1004711","words":[{"g":"am / are","l":"essere"},null,{"g":"the / her"},{"g":"war, warfare"}]},{"text":"Sono contro il matrimonio.","en":"I'm against the marriage.","words":[{"g":"am / are","l":"essere"},null,{"g":"the"},{"g":"marriage"}]},{"text":"È contro le regole.","en":"It's against the rules.","words":[{"g":"is","l":"essere"},null,{"g":"the / to her"},{"g":"rule","l":"regola"}]},{"text":"Non vorrei fare nulla contro la legge.","en":"I wouldn't want to do anything against the law.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to do"},{"g":"nothing, anything"},null,{"g":"the / her"},{"g":"law"}]}]}