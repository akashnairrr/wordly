{"id":"vicenda","lemma":"vicenda","pos":"noun","rank":1563,"glosses":["affair, event, story"],"ipa":"/viˈt͡ʃɛn.da/","gender":"f","forms":{"plural":"vicende"},"examples":[{"text":"Ci potremmo aiutare a vicenda.","en":"We could help each other.","words":[{"g":"us / there"},{"g":"can, could","l":"potere"},{"g":"to help, assist"},{"g":"to / at"},null]},{"text":"Vi amate a vicenda?","en":"Do you love each other?","words":[{"g":"you"},{"g":"to love, to like","l":"amare"},{"g":"to / at"},null]},{"text":"Noi possiamo aiutarci a vicenda.","en":"We can help each other.","words":[{"g":"we"},null,null,{"g":"to / at"},null]},{"text":"Non approvo tali vicende.","en":"I don't approve of such goings-on.","words":[{"g":"not"},{"g":"to approve","l":"approvare"},{"g":"such","l":"tale"},null]},{"text":"Si sorrisero a vicenda.","en":"They smiled at each other.","words":[{"g":"oneself"},{"g":"to smile, to grin","l":"sorridere"},{"g":"to / at"},null]}]}