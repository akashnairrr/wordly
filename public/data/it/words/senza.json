{"id":"senza","lemma":"senza","pos":"prep","rank":128,"glosses":["without, -less"],"ipa":"/ˈsɛn.t͡sa/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q652_%28ita%29-LangPao-senza.wav","examples":[{"text":"Senza aria, nulla potrebbe vivere.","en":"Without air, nothing could live.","words":[null,{"g":"air"},{"g":"nothing, anything"},{"g":"can, could","l":"potere"},{"g":"to live"}]},{"text":"Come sarebbe il mondo senza donne?","en":"How would the world be without women?","words":[{"g":"how / like"},{"g":"to be","l":"essere"},{"g":"the"},{"g":"world"},null,{"g":"woman","l":"donna"}]},{"text":"Ci vai senza di me.","en":"You go there without me.","words":[{"g":"us / there"},{"g":"to go","l":"andare"},null,{"g":"of"},{"g":"me"}]},{"text":"Se vuole, vada senza di me.","en":"If you want, go without me.","words":[{"g":"if"},{"g":"to want","l":"volere"},{"g":"to go","l":"andare"},null,{"g":"of"},{"g":"me"}]},{"text":"L'uomo può vivere senza amici.","en":"Man can live without friends.","words":[null,{"g":"person, man"},{"g":"can, could","l":"potere"},{"g":"to live"},null,{"g":"friend","l":"amico"}]}]}