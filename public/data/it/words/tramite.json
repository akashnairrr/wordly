{"id":"tramite","lemma":"tramite","pos":"noun","rank":2005,"glosses":["intermediary, link","way, means, vehicle"],"ipa":"/ˈtra.mi.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/31/LL-Q652_%28ita%29-LangPao-tramite.wav/LL-Q652_%28ita%29-LangPao-tramite.wav.mp3","gender":"m","forms":{"plural":"tramiti"},"examples":[{"text":"Ci siamo conosciuti tramite un amico comune.","en":"We met through a mutual friend.","words":[{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"known","l":"conosciuto"},null,{"g":"a"},{"g":"friend"},{"g":"a form of city-based…"}]},{"text":"Tom ha parlato tramite un interprete.","en":"Tom spoke through an interpreter.","words":[null,{"g":"has","l":"avere"},{"g":"spoken"},null,{"g":"a"},{"g":"interpreter"}]},{"text":"Potresti confermare il prezzo tramite fax, per piacere?","en":"Could you please confirm the price by fax?","words":[{"g":"can, could","l":"potere"},{"g":"to confirm"},{"g":"the"},{"g":"price"},null,{"g":"fax"},null,null],"phrases":[[6,8,"please"]]},{"text":"Il villaggio è collegato alla nostra città tramite un ponte.","en":"The village is connected with our town by a bridge.","words":[{"g":"the"},{"g":"village, hamlet"},{"g":"is","l":"essere"},{"g":"connected, linked"},{"g":"to the"},{"g":"our","l":"nostro"},{"g":"town, city"},null,{"g":"a"},{"g":"bridge"}]},{"text":"Spedirai questo tramite pacco postale?","en":"Are you going to send this by parcel post?","words":[{"g":"to send","l":"spedire"},{"g":"this"},null,{"g":"parcel, package"},{"g":"packet, mail boat"}]}]}