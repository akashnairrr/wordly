{"id":"desiderio","lemma":"desiderio","pos":"noun","rank":1178,"glosses":["wish, desire, longing"],"ipa":"/de.ziˈdɛ.rjo/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d4/LL-Q652_%28ita%29-LangPao-desiderio.wav/LL-Q652_%28ita%29-LangPao-desiderio.wav.mp3","gender":"m","forms":{"plural":"desideri"},"examples":[{"text":"Hai un desiderio di cambiare lavoro?","en":"Do you have a desire to change jobs?","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"of"},{"g":"to exchange"},{"g":"work"}]},{"text":"Ho solo un desiderio.","en":"I have but one wish.","words":[{"g":"have","l":"avere"},{"g":"only, just"},{"g":"a"},null]},{"text":"Questo è il mio terzo desiderio.","en":"This is my third wish.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"the"},{"g":"mine"},{"g":"third"},null]},{"text":"Si è avverato il tuo desiderio?","en":"Did you get your wish?","audio":"https://tatoeba.org/en/audio/download/1006445","words":[{"g":"oneself"},{"g":"is","l":"essere"},{"g":"to make true or real","l":"avverare"},{"g":"the"},{"g":"yours"},null]},{"text":"Non avevo il desiderio di farlo.","en":"I had no desire to do that.","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"the"},null,{"g":"of"},null]}]}