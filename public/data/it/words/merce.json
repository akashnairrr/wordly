{"id":"merce","lemma":"merce","pos":"noun","rank":2537,"glosses":["goods, wares, merchandise, products, commodities"],"ipa":"/ˈmɛr.t͡ʃe/","gender":"f","forms":{"plural":"merci"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q652_%28ita%29-LangPao-merce.wav","examples":[{"text":"Le merci arrivano via mare.","en":"The goods arrive by sea.","words":[{"g":"the / to her"},null,{"g":"to arrive","l":"arrivare"},{"g":"street, path"},{"g":"sea"}]},{"text":"Le merci sono arrivate ieri.","en":"The goods arrived yesterday.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"to arrive","l":"arrivare"},{"g":"yesterday"}]},{"text":"La merce è arrivata intatta.","en":"The goods arrived undamaged.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"successful","l":"arrivato"},{"g":"intact","l":"intatto"}]},{"text":"Le merci arrivarono integre.","en":"The goods arrived undamaged.","words":[{"g":"the / to her"},null,{"g":"to arrive","l":"arrivare"},null]},{"text":"I prezzi delle merci stavano aumentando.","en":"Commodity prices were rising.","words":[{"g":"the","l":"la"},{"g":"price","l":"prezzo"},null,null,{"g":"to stay, remain","l":"stare"},{"g":"to increase","l":"aumentare"}]}]}