{"id":"liscio","lemma":"liscio","pos":"adj","rank":3454,"glosses":["smooth, sleek, polished","simple","neat, straight (of an alcoholic beverage)"],"ipa":"/ˈliʃ.ʃo/","forms":{"feminine":"liscia","masculinePlural":"lisci","femininePlural":"lisce"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q652_%28ita%29-XANA000-liscio.wav","examples":[{"text":"La sua pelle è liscia.","en":"Her skin is smooth.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"skin"},{"g":"is","l":"essere"},null]},{"text":"È andato tutto liscio.","en":"Everything went smoothly.","words":[{"g":"is","l":"essere"},{"g":"to go","l":"andare"},{"g":"everything, all"},null]},{"text":"Non te la farò passare liscia.","en":"I'm not going to let you get away with this.","words":[{"g":"not"},{"g":"you, thee"},{"g":"the / her"},{"g":"to do","l":"fare"},{"g":"to pass"},null]},{"text":"È andata via liscia.","en":"It went off smoothly.","words":[{"g":"is","l":"essere"},{"g":"outward journey"},{"g":"street, path"},null]},{"text":"Tom ha i capelli lisci.","en":"Tom has straight hair.","words":[null,{"g":"has","l":"avere"},{"g":"the","l":"la"},{"g":"a single hair","l":"capello"},null]}]}