{"id":"continuato","lemma":"continuato","pos":"adj","rank":2546,"glosses":["continued, continuous"],"ipa":"/kon.ti.nuˈa.to/","forms":{"feminine":"continuata","masculinePlural":"continuati","femininePlural":"continuate"},"examples":[{"text":"Il rumore è continuato.","en":"The noise continued.","words":[{"g":"the"},{"g":"noise, sound"},{"g":"is","l":"essere"},null]},{"text":"Ho continuato a lavorare.","en":"I continued working.","words":[{"g":"have","l":"avere"},null,{"g":"to / at"},{"g":"to work"}]},{"text":"Il gruppo ha continuato a camminare.","en":"The group continued walking.","words":[{"g":"the"},{"g":"group"},{"g":"has","l":"avere"},null,{"g":"to / at"},{"g":"to walk"}]},{"text":"I colloqui sono continuati per due giorni.","en":"The talks continued for two days.","words":[{"g":"the","l":"la"},{"g":"talk, conversation","l":"colloquio"},{"g":"am / are","l":"essere"},null,{"g":"for"},{"g":"two"},{"g":"days"}]},{"text":"Ha continuato a leggere un libro.","en":"He kept reading a book.","words":[{"g":"has","l":"avere"},null,{"g":"to / at"},{"g":"to read"},{"g":"a"},{"g":"book"}]}]}