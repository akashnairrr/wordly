{"id":"gene","lemma":"gene","pos":"noun","rank":2854,"glosses":["gene"],"ipa":"/ˈd͡ʒɛ.ne/","gender":"m","forms":{"plural":"geni"},"examples":[{"text":"Siamo dei geni.","en":"We're geniuses.","words":[{"g":"to be","l":"essere"},{"g":"some"},null]},{"text":"Tutti i bambini sono potenziali geni.","en":"All children are potential geniuses.","words":[{"g":"all"},{"g":"the","l":"la"},{"g":"child","l":"bambino"},{"g":"am / are","l":"essere"},{"g":"potential","l":"potenziale"},null]},{"text":"Voi ragazzi siete dei geni.","en":"You guys are geniuses.","words":[{"g":"you (pl.)"},{"g":"boy, young man","l":"ragazzo"},{"g":"to be","l":"essere"},{"g":"some"},null]},{"text":"I geni la pensano allo stesso modo.","en":"Geniuses think alike.","words":[{"g":"the","l":"la"},null,{"g":"the / her"},{"g":"to think","l":"pensare"},null,{"g":"same"},{"g":"manner, way"}]},{"text":"I geni a volte possono essere maleducati.","en":"A genius can sometimes have rude manners.","words":[{"g":"the","l":"la"},null,null,null,{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"ill-bred","l":"maleducato"}],"phrases":[[2,4,"sometimes, at times"]]}]}