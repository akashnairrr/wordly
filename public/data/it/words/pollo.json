{"id":"pollo","lemma":"pollo","pos":"noun","rank":1215,"glosses":["sucker, chump, dupe or patsy","pushover or weakling"],"ipa":"/ˈpol.lo/","gender":"m","forms":{"plural":"polli","feminine":"polla"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-pollo.wav","examples":[{"text":"Questa carne è pollo.","en":"This meat is chicken.","words":[{"g":"this, this one, these","l":"questo"},{"g":"meat, flesh"},{"g":"is","l":"essere"},null]},{"text":"Siete tutti dei polli?","en":"Are you all chicken?","words":[{"g":"to be","l":"essere"},{"g":"all"},{"g":"some"},null]},{"text":"Quanto pollo hai comprato?","en":"How much chicken did you buy?","words":[{"g":"how much, however much"},null,{"g":"have","l":"avere"},{"g":"to buy","l":"comprare"}]},{"text":"Non vedo polli.","en":"I don't see any chickens.","words":[{"g":"not"},{"g":"to see","l":"vedere"},null]},{"text":"Non posso mangiare il pollo.","en":"I can't eat chicken.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to eat"},{"g":"the"},null]}]}