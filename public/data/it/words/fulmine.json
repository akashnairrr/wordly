{"id":"fulmine","lemma":"fulmine","pos":"noun","rank":3497,"glosses":["lightning"],"ipa":"/ˈful.mi.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/LL-Q652_%28ita%29-LangPao-fulmine.wav/LL-Q652_%28ita%29-LangPao-fulmine.wav.mp3","gender":"m","forms":{"plural":"fulmini"},"examples":[{"text":"Non ho paura dei fulmini.","en":"I'm not afraid of lightning.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"fear"},{"g":"some"},null]},{"text":"Ho visto un fulmine cadere sulla casa.","en":"I saw the house struck by lightning.","words":[{"g":"have","l":"avere"},{"g":"visa"},{"g":"a"},null,{"g":"to fall"},{"g":"plant of the genus Sulla"},{"g":"house"}]},{"text":"I fulmini possono essere pericolosi.","en":"Lightning can be dangerous.","words":[{"g":"the","l":"la"},null,{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"dangerous","l":"pericoloso"}]},{"text":"Un fulmine ha colpito la torre.","en":"Lightning struck the tower.","words":[{"g":"a"},null,{"g":"has","l":"avere"},{"g":"struck"},null,null],"phrases":[[4,6,"a surname"]]},{"text":"L'aereo fu colpito da un fulmine.","en":"The plane was struck by lightning.","words":[null,{"g":"aerial"},{"g":"deceased, late"},{"g":"struck"},{"g":"from"},{"g":"a"},null]}]}