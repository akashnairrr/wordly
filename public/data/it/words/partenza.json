{"id":"partenza","lemma":"partenza","pos":"noun","rank":1771,"glosses":["departure, leaving, starting","start","sailing (of a boat)"],"ipa":"/parˈtɛn.t͡sa/","gender":"f","forms":{"plural":"partenze"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q652_%28ita%29-LangPao-partenza.wav","examples":[{"text":"Mi informò della sua partenza.","en":"She informed me of her departure.","words":[{"g":"me / myself"},{"g":"to inform","l":"informare"},{"g":"of the"},{"g":"his, hers, its","l":"suo"},null]},{"text":"Siamo in partenza.","en":"We're leaving.","words":[{"g":"to be","l":"essere"},{"g":"in"},null]},{"text":"La sua partenza significa che ci sarà pace in casa.","en":"His departure means that there will be peace in the house.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null,{"g":"to mean, to signify","l":"significare"},{"g":"that / what"},{"g":"us / there"},{"g":"to be","l":"essere"},{"g":"peace be with you"},{"g":"in"},{"g":"house"}]},{"text":"Dobbiamo posticipare la nostra partenza.","en":"We have to postpone our departure.","words":[{"g":"to owe","l":"dovere"},{"g":"to postpone, to defer"},{"g":"the / her"},{"g":"our","l":"nostro"},null]},{"text":"Potresti cambiare la data di partenza per questo biglietto?","en":"Could you change the departure date for this ticket?","words":[{"g":"can, could","l":"potere"},{"g":"to exchange"},{"g":"the / her"},{"g":"date"},{"g":"of"},null,null,null,{"g":"ticket"}],"phrases":[[6,8,"for this reason"]]}]}