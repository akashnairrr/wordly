{"id":"tanto","lemma":"tanto","pos":"det","rank":143,"glosses":["so much; so many","much; many","such"],"ipa":"/ˈtan.to/","forms":{"feminine":"tanta","masculinePlural":"tanti","femininePlural":"tante"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q652_%28ita%29-XANA000-tanto.wav","examples":[{"text":"Come puoi mangiare così tanto?","en":"How can you eat so much?","words":[{"g":"how / like"},{"g":"can, could","l":"potere"},{"g":"to eat"},{"g":"so"},null]},{"text":"Perché ci sono così tante persone?","en":"Why are there so many people?","words":[{"g":"why / because"},{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"so"},null,{"g":"person","l":"persona"}]},{"text":"Perché vuoi farlo così tanto?","en":"Why do you want to do that so much?","words":[{"g":"why / because"},{"g":"to want","l":"volere"},null,{"g":"so"},null]},{"text":"Ho così tante idee.","en":"I have so many ideas.","words":[{"g":"have","l":"avere"},{"g":"so"},null,{"g":"idea","l":"idea"}]},{"text":"Non mangiare così tanta carne.","en":"Don't eat so much meat.","words":[{"g":"not"},{"g":"to eat"},{"g":"so"},null,{"g":"meat, flesh"}]}]}