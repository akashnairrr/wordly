{"id":"soltanto","lemma":"soltanto","pos":"adv","rank":525,"glosses":["only, just, but, alone, merely"],"ipa":"/solˈtan.to/","examples":[{"text":"Voglio soltanto parlare.","en":"I only want to talk.","words":[{"g":"to want","l":"volere"},null,{"g":"to talk, to speak"}]},{"text":"È soltanto troppo vero.","en":"It is only too true.","words":[{"g":"is","l":"essere"},null,{"g":"too much"},{"g":"true"}]},{"text":"Conosco soltanto qualche parola.","en":"I only know a few words.","words":[{"g":"to know","l":"conoscere"},null,{"g":"few"},{"g":"word"}]},{"text":"Ho soltanto tre dollari.","en":"I only have three dollars.","words":[{"g":"have","l":"avere"},null,{"g":"three"},{"g":"dollar","l":"dollaro"}]},{"text":"Volevo soltanto essere solo.","en":"I only wanted to be alone.","words":[{"g":"to want","l":"volere"},null,{"g":"to be"},{"g":"only, just"}]}]}