{"id":"invece","lemma":"invece","pos":"prep","rank":258,"glosses":["rather than","instead of"],"ipa":"/inˈve.t͡ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q652_%28ita%29-LangPao-invece.wav","examples":[{"text":"Potremmo parlare in francese invece?","en":"Could we speak French instead?","words":[{"g":"can, could","l":"potere"},{"g":"to talk, to speak"},{"g":"in"},{"g":"French"},null]},{"text":"Provi questo invece.","en":"Try this instead.","words":[{"g":"to try","l":"provare"},{"g":"this"},null]},{"text":"Cosa dovrei fare invece?","en":"What should I do instead?","words":[{"g":"thing"},{"g":"to owe","l":"dovere"},{"g":"to do"},null]},{"text":"Sono rimasto a casa invece di uscire.","en":"I stayed at home instead of going out.","words":[{"g":"am / are","l":"essere"},{"g":"to stay","l":"rimanere"},{"g":"to / at"},{"g":"house"},null,{"g":"of"},{"g":"to go out, leave, exit"}]},{"text":"Posso pagarla domani invece che oggi?","en":"Can I pay you tomorrow instead of today?","words":[{"g":"can, could","l":"potere"},{"g":"to pay"},{"g":"tomorrow"},null,{"g":"that / what"},{"g":"today"}]}]}