{"id":"concerto","lemma":"concerto","pos":"noun","rank":1636,"glosses":["concert, recital","concerto","agreement, concert"],"ipa":"/konˈt͡ʃɛr.to/","gender":"m","forms":{"plural":"concerti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q652_%28ita%29-DiplomaticBadger-concerto.wav","examples":[{"text":"Dove sarà il concerto?","en":"Where will the concert be?","words":[{"g":"where"},{"g":"to be","l":"essere"},{"g":"the"},null]},{"text":"Sarai al concerto stasera?","en":"Will you be at the concert tonight?","words":[{"g":"to be","l":"essere"},{"g":"to the"},null,{"g":"this evening, tonight"}]},{"text":"Ti piace andare ai concerti?","en":"Do you like going to concerts?","words":[{"g":"you"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"to go"},null,null]},{"text":"Volevo andare al concerto.","en":"I wanted to go to the concert.","words":[{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to the"},null]},{"text":"Che gran concerto!","en":"What a great concert!","words":[{"g":"that / what"},null,null]}]}