{"id":"capitano","lemma":"capitano","pos":"noun","rank":378,"glosses":["captain"],"ipa":"/ka.piˈta.no/","gender":"m","forms":{"plural":"capitani"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q652_%28ita%29-LangPao-capitano.wav","examples":[{"text":"Il capitano vuole vederti.","en":"The captain wants to see you.","words":[{"g":"the"},null,{"g":"to want","l":"volere"},null]},{"text":"Chi era il capitano?","en":"Who was the captain?","words":[{"g":"who"},{"g":"to be","l":"essere"},{"g":"the"},null]},{"text":"Mi chiamano capitano.","en":"They call me captain.","words":[{"g":"me / myself"},{"g":"to call","l":"chiamare"},null]},{"text":"Sono il capitano di questa nave.","en":"I'm the captain of this ship.","words":[{"g":"am / are","l":"essere"},{"g":"the"},null,{"g":"of"},{"g":"this, this one, these","l":"questo"},{"g":"ship"}]},{"text":"È il capitano della squadra.","en":"He is the captain of the team.","words":[{"g":"is","l":"essere"},{"g":"the"},null,{"g":"of the"},{"g":"set square, triangle"}]}]}