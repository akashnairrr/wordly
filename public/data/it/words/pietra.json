{"id":"pietra","lemma":"pietra","pos":"noun","rank":1477,"glosses":["stone"],"ipa":"/ˈpjɛ.tra/","gender":"f","forms":{"plural":"pietre"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q652_%28ita%29-LangPao-pietra.wav","examples":[{"text":"La casa è fatta di pietra.","en":"The house is made of stone.","words":[{"g":"the / her"},{"g":"house"},{"g":"is","l":"essere"},{"g":"type, kind"},{"g":"of"},null]},{"text":"Il ponte è fatto di pietra.","en":"The bridge is made of stone.","words":[{"g":"the"},{"g":"bridge"},{"g":"is","l":"essere"},{"g":"to do","l":"fare"},{"g":"of"},null]},{"text":"Le pietre sono bianche.","en":"The stones are white.","words":[{"g":"the / to her"},null,{"g":"am / are","l":"essere"},{"g":"white","l":"bianco"}]},{"text":"Vivi sotto una pietra?","en":"Do you live under a rock?","words":[{"g":"to live","l":"vivere"},{"g":"down"},{"g":"a","l":"uno"},null]},{"text":"Questo ponte è costruito in pietra.","en":"This bridge is built of stone.","words":[{"g":"this"},{"g":"bridge"},{"g":"is","l":"essere"},{"g":"to build, construct","l":"costruire"},{"g":"in"},null]}]}