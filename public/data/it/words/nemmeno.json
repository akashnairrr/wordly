{"id":"nemmeno","lemma":"nemmeno","pos":"adv","rank":235,"glosses":["not even","not … either"],"ipa":"/nemˈme.no/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q652_%28ita%29-XANA000-nemmeno.wav","examples":[{"text":"Non ho nemmeno una casa.","en":"I don't even have a house.","words":[{"g":"not"},{"g":"have","l":"avere"},null,{"g":"a","l":"uno"},{"g":"house"}]},{"text":"Forse non è nemmeno possibile.","en":"Maybe it's not even possible.","words":[{"g":"maybe"},{"g":"not"},{"g":"is","l":"essere"},null,{"g":"possible"}]},{"text":"Non so nemmeno perché sono qui.","en":"I don't even know why I'm here.","words":[{"g":"not"},{"g":"to know","l":"sapere"},null,{"g":"why / because"},{"g":"am / are","l":"essere"},{"g":"here"}]},{"text":"Non lo provi nemmeno.","en":"Don't even try it.","words":[{"g":"not"},{"g":"the / it"},{"g":"to try","l":"provare"},null]},{"text":"Non conosco nemmeno il tizio.","en":"I don't even know the guy.","words":[{"g":"not"},{"g":"to know","l":"conoscere"},null,{"g":"the"},{"g":"man"}]}]}