{"id":"ognuno","lemma":"ognuno","pos":"pron","rank":1069,"glosses":["each one, all","everyone, everybody"],"ipa":"/ˌoɲˈɲu.no/","forms":{"feminine":"ognuna"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ce/LL-Q652_%28ita%29-LangPao-ognuno.wav","examples":[{"text":"Ognuno pensa la stessa cosa.","en":"Everyone thinks the same thing.","words":[null,{"g":"to think","l":"pensare"},{"g":"the / her"},{"g":"same","l":"stesso"},{"g":"thing"}]},{"text":"A ognuno il suo.","en":"To each his own.","words":[{"g":"to / at"},null,{"g":"the"},{"g":"his, hers, its"}]},{"text":"Ognuno deve proteggere la sua famiglia.","en":"Everyone must protect their own family.","words":[null,{"g":"to owe","l":"dovere"},{"g":"to shield or protect"},{"g":"the / her"},{"g":"his, hers, its","l":"suo"},{"g":"family"}]},{"text":"Ognuno di loro ha ricevuto un regalo.","en":"They each received a present.","words":[null,{"g":"of"},{"g":"they"},{"g":"has","l":"avere"},{"g":"to receive","l":"ricevere"},{"g":"a"},{"g":"present, gift"}]},{"text":"Ognuno si merita una seconda occasione.","en":"Everyone deserves a second chance.","words":[null,{"g":"oneself"},{"g":"to deserve, merit","l":"meritare"},{"g":"a","l":"uno"},{"g":"second"},{"g":"opportunity"}]}]}