{"id":"parecchio","lemma":"parecchio","pos":"pron","rank":1110,"glosses":["quite a lot, rather a lot, a fair bit","several, quite a lot, quite a few"],"ipa":"/paˈrek.kjo/","forms":{"feminine":"parecchia","masculinePlural":"parecchi","femininePlural":"parecchie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q652_%28ita%29-LangPao-parecchio.wav","examples":[{"text":"Ha bevuto parecchio ieri.","en":"He drank a lot yesterday.","words":[{"g":"has","l":"avere"},{"g":"drunk, drunken"},null,{"g":"yesterday"}]},{"text":"Pare che abbia parecchi amici.","en":"She appears to have many friends.","words":[{"g":"crepe rubber","l":"para"},{"g":"that / what"},{"g":"to have","l":"avere"},null,{"g":"friend","l":"amico"}]},{"text":"Pare che lei abbia parecchie amiche.","en":"She appears to have many friends.","words":[{"g":"crepe rubber","l":"para"},{"g":"that / what"},{"g":"she / you (formal)"},{"g":"to have","l":"avere"},null,{"g":"friend","l":"amico"}]},{"text":"Sta già succedendo da parecchi decenni.","en":"This has already been happening for several decades.","words":[{"g":"to stay, remain","l":"stare"},{"g":"already"},{"g":"to take the place","l":"succedere"},{"g":"from"},null,{"g":"decade","l":"decennio"}]},{"text":"Tom è parecchio indietro.","en":"Tom is way behind.","words":[null,{"g":"is","l":"essere"},null,{"g":"back"}]}]}