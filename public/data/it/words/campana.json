{"id":"campana","lemma":"campana","pos":"noun","rank":3539,"glosses":["bell","hopscotch"],"ipa":"/kamˈpa.na/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b9/LL-Q652_%28ita%29-LangPao-campana.wav/LL-Q652_%28ita%29-LangPao-campana.wav.mp3","gender":"f","forms":{"plural":"campane"},"examples":[{"text":"Abbiamo sentito le campane della chiesa.","en":"We heard the church bells.","words":[{"g":"to have","l":"avere"},{"g":"sincere"},{"g":"the / to her"},null,{"g":"of the"},{"g":"church"}]},{"text":"Suona la campana in un'emergenza.","en":"Ring the bell in an emergency.","words":[{"g":"to play","l":"suonare"},{"g":"the / her"},null,{"g":"in"},{"g":"a"},{"g":"emergency"}]},{"text":"Arrivò dopo il suono della campana.","en":"He arrived after the bell rang.","words":[{"g":"to arrive","l":"arrivare"},{"g":"next, after, following"},{"g":"the"},{"g":"sound"},{"g":"of the"},null]},{"text":"La campana della chiesa sta suonando.","en":"The church bell is ringing.","words":[{"g":"the / her"},null,{"g":"of the"},{"g":"church"},{"g":"to stay, remain","l":"stare"},{"g":"to play","l":"suonare"}]},{"text":"La campana della chiesa suonava alle tre.","en":"The church bell used to ring at three.","words":[{"g":"the / her"},null,{"g":"of the"},{"g":"church"},{"g":"to play","l":"suonare"},null,{"g":"three"}]}]}