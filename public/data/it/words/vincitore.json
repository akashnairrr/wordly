{"id":"vincitore","lemma":"vincitore","pos":"adj","rank":2437,"glosses":["winning, victorious","defeating, vanquishing"],"ipa":"/vin.t͡ʃiˈto.re/","forms":{"feminine":"vincitrice","masculinePlural":"vincitori","femininePlural":"vincitrici"},"examples":[{"text":"Chi era il vincitore?","en":"Who was the winner?","words":[{"g":"who"},{"g":"to be","l":"essere"},{"g":"the"},null]},{"text":"È buono essere una vincitrice.","en":"It is good to be a winner.","words":[{"g":"is","l":"essere"},{"g":"righteous, moral"},{"g":"to be"},{"g":"a","l":"uno"},null]},{"text":"Penso che abbiamo un vincitore.","en":"I think we have a winner.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"to have","l":"avere"},{"g":"a"},null]},{"text":"Questo ci rende vincitori.","en":"This makes us winners.","words":[{"g":"this"},{"g":"us / there"},{"g":"to give back","l":"rendere"},null]},{"text":"Siamo delle vincitrici.","en":"We're winners.","words":[{"g":"to be","l":"essere"},null,null]}]}