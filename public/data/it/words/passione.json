{"id":"passione","lemma":"passione","pos":"noun","rank":1673,"glosses":["passion, love, addiction","fervour, enthusiasm","suffering, grief, (religion) passion"],"ipa":"/pasˈsjo.ne/","gender":"f","forms":{"plural":"passioni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q652_%28ita%29-LangPao-passione.wav","examples":[{"text":"Avevamo la passione.","en":"We had the passion.","words":[{"g":"to have","l":"avere"},{"g":"the / her"},null]},{"text":"Dobbiamo controllare le nostre passioni.","en":"We must control our passions.","words":[{"g":"to owe","l":"dovere"},{"g":"to check"},{"g":"the / to her"},{"g":"our","l":"nostro"},null]},{"text":"La musica è la mia passione.","en":"Music is my passion.","words":[{"g":"the / her"},{"g":"music"},{"g":"is","l":"essere"},{"g":"the / her"},{"g":"mine","l":"mio"},null]},{"text":"Ha una passione per le torte.","en":"She has a passion for cake.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},null,{"g":"for"},{"g":"the / to her"},{"g":"pie","l":"torta"}]},{"text":"Questo sa di frutto della passione.","en":"This tastes like passion fruit.","words":[{"g":"this"},{"g":"to know","l":"sapere"},{"g":"of"},{"g":"fruit"},{"g":"of the"},null]}]}