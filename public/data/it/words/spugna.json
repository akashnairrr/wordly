{"id":"spugna","lemma":"spugna","pos":"noun","rank":4576,"glosses":["sponge","winesop, wino, drunkard"],"ipa":"/ˈspuɲ.ɲa/","gender":"f","forms":{"plural":"spugne"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q652_%28ita%29-LangPao-spugna.wav","examples":[{"text":"Mi passi una spugna.","en":"Hand me a sponge.","words":[{"g":"me / myself"},{"g":"to pass","l":"passare"},{"g":"a","l":"uno"},null]},{"text":"Una spugna assorbe l'acqua.","en":"A sponge absorbs water.","audio":"https://tatoeba.org/en/audio/download/1010022","words":[{"g":"a","l":"uno"},null,{"g":"to absorb, soak up","l":"assorbire"},null,{"g":"water"}]},{"text":"Avrò bisogno di una spugna.","en":"I'm going to need a sponge.","words":[{"g":"to have","l":"avere"},{"g":"need"},{"g":"of"},{"g":"a","l":"uno"},null]},{"text":"Beve come una spugna.","en":"He drinks like a fish.","words":[{"g":"to drink","l":"bere"},{"g":"how / like"},{"g":"a","l":"uno"},null]},{"text":"Non gettare la spugna.","en":"Don't throw in the towel.","words":[{"g":"not"},{"g":"to throw"},{"g":"the / her"},null]}]}