{"id":"pavimento","lemma":"pavimento","pos":"noun","rank":1435,"glosses":["floor"],"ipa":"/pa.viˈmen.to/","gender":"m","forms":{"plural":"pavimenti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q652_%28ita%29-DiplomaticBadger-pavimento.wav","examples":[{"text":"Perché sei seduto sul pavimento?","en":"Why are you sitting on the floor?","words":[{"g":"why / because"},{"g":"are","l":"essere"},{"g":"sitting, seated"},null,null]},{"text":"Il pavimento è freddo.","en":"The floor is cold.","words":[{"g":"the"},null,{"g":"is","l":"essere"},{"g":"the cold"}]},{"text":"Il pavimento deve essere molto pulito.","en":"The floor must be very clean.","words":[{"g":"the"},null,{"g":"to owe","l":"dovere"},{"g":"to be"},{"g":"very / a lot"},{"g":"clean, neat, tidy"}]},{"text":"I pavimenti erano puliti.","en":"The floors were clean.","words":[{"g":"the","l":"la"},null,{"g":"to be","l":"essere"},{"g":"clean, neat, tidy","l":"pulito"}]},{"text":"Ho visto del sangue sul pavimento.","en":"I saw blood on the floor.","words":[{"g":"have","l":"avere"},{"g":"visa"},{"g":"of the"},{"g":"blood"},null,null]}]}