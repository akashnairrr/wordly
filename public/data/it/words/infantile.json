{"id":"infantile","lemma":"infantile","pos":"adj","rank":3792,"glosses":["infantile (relating to children or babies)","infantile puerile, childish, babyish"],"ipa":"/in.fanˈti.le/","forms":{"plural":"infantili"},"examples":[{"text":"Non è un po' infantile?","en":"Isn't that a little juvenile?","words":[{"g":"not"},{"g":"is","l":"essere"},{"g":"a"},null,null]},{"text":"Non siate infantili.","en":"Don't be childish.","words":[{"g":"not"},{"g":"to be","l":"essere"},null]},{"text":"Sembri così infantile.","en":"You sound so childish.","words":[{"g":"to seem","l":"sembrare"},{"g":"so"},null]},{"text":"Il suo modo di pensare è molto infantile.","en":"His way of thinking is very childish.","words":[{"g":"the"},{"g":"his, hers, its"},{"g":"manner, way"},{"g":"of"},{"g":"to think"},{"g":"is","l":"essere"},{"g":"very / a lot"},null]},{"text":"Sembrate così infantili.","en":"You sound so childish.","words":[{"g":"to seem","l":"sembrare"},{"g":"so"},null]}]}