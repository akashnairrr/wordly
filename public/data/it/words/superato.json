{"id":"superato","lemma":"superato","pos":"adj","rank":1654,"glosses":["overtaken","outmoded"],"ipa":"/su.peˈra.to/","forms":{"feminine":"superata","masculinePlural":"superati","femininePlural":"superate"},"examples":[{"text":"Abbiamo tutti superato il test.","en":"We all have passed the test.","words":[{"g":"to have","l":"avere"},{"g":"all"},null,{"g":"the"},{"g":"test"}]},{"text":"Pensiamo di aver superato il peggio.","en":"We think we are over the worst.","words":[{"g":"to think","l":"pensare"},{"g":"of"},null,null,{"g":"the"},{"g":"worse"}]},{"text":"Hai superato il tuo esame?","en":"Did you pass your exam?","words":[{"g":"have","l":"avere"},null,{"g":"the"},{"g":"yours"},{"g":"examination, test"}]},{"text":"Abbiamo tutte superato l'esame.","en":"We all have passed the test.","words":[{"g":"to have","l":"avere"},{"g":"everything, all","l":"tutto"},null,null,{"g":"examination, test"}]},{"text":"Mi ha superata in astuzia.","en":"He outsmarted me.","words":[{"g":"me / myself"},{"g":"has","l":"avere"},null,{"g":"in"},{"g":"astuteness, shrewdness"}]}]}