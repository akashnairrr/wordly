{"id":"fede","lemma":"fede","pos":"noun","rank":1064,"glosses":["faith, belief","creed, convictions","faith, loyalty"],"ipa":"/ˈfe.de/","gender":"f","forms":{"plural":"fedi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q652_%28ita%29-LangPao-fede.wav","examples":[{"text":"Ho fede in te.","en":"I have faith in you.","words":[{"g":"have","l":"avere"},null,{"g":"in"},{"g":"you, thee"}]},{"text":"È un uomo di fede.","en":"He is a man of faith.","words":[{"g":"is","l":"essere"},{"g":"a"},{"g":"person, man"},{"g":"of"},null]},{"text":"Ha perso la fede nel dottore.","en":"He has lost faith in the doctor.","words":[{"g":"has","l":"avere"},{"g":"lost, wasted"},{"g":"the / her"},null,{"g":"in the"},{"g":"doctor"}]},{"text":"La nostra fede è molto forte.","en":"Our faith is very strong.","words":[{"g":"the / her"},{"g":"our","l":"nostro"},null,{"g":"is","l":"essere"},{"g":"very / a lot"},{"g":"strong"}]},{"text":"Abbia fede.","en":"Have faith.","words":[{"g":"to have","l":"avere"},null]}]}