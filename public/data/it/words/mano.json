{"id":"mano","lemma":"mano","pos":"noun","rank":236,"glosses":["hand","front foot","means of execution of an action or a job; ability, skill, dexterity, labor"],"ipa":"/ˈma.no/","gender":"f","forms":{"plural":"mani"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q652_%28ita%29-LangPao-mano.wav","examples":[{"text":"Avanti, dammi una mano.","en":"Come on, give me a hand.","words":[{"g":"come in!"},null,{"g":"a","l":"uno"},null]},{"text":"Ho una pistola in mano.","en":"I have a gun in my hand.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},{"g":"pistol, handgun"},{"g":"in"},null]},{"text":"Potresti darmi una mano?","en":"Could you give me a hand?","words":[{"g":"can, could","l":"potere"},null,{"g":"a","l":"uno"},null]},{"text":"Mi dia una mano, OK?","en":"Give me a hand, will you?","words":[{"g":"me / myself"},{"g":"to give","l":"dare"},{"g":"a","l":"uno"},null,null]},{"text":"Ha qualcosa in mano.","en":"She has something in her hand.","words":[{"g":"has","l":"avere"},{"g":"something"},{"g":"in"},null]}]}