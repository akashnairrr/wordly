{"id":"motore","lemma":"motore","pos":"noun","rank":1445,"glosses":["engine, motor","mover, motive, drive"],"ipa":"/moˈto.re/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/ad/LL-Q652_%28ita%29-LangPao-motore.wav/LL-Q652_%28ita%29-LangPao-motore.wav.mp3","gender":"m","forms":{"plural":"motori"},"examples":[{"text":"Il motore funziona bene.","en":"The engine works well.","words":[{"g":"the"},null,{"g":"to function, to work","l":"funzionare"},{"g":"well"}]},{"text":"Il treno ha due motori.","en":"The train has two engines.","words":[{"g":"the"},{"g":"train"},{"g":"has","l":"avere"},{"g":"two"},null]},{"text":"C'è un problema col motore?","en":"Is there a problem with the motor?","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"problem"},null,null]},{"text":"La macchina ha un motore nuovo.","en":"The car has a new engine.","words":[{"g":"the / her"},{"g":"machine"},{"g":"has","l":"avere"},{"g":"a"},null,{"g":"new"}]},{"text":"Lascia andare il motore.","en":"Leave the engine running.","words":[{"g":"to leave","l":"lasciare"},{"g":"to go"},{"g":"the"},null]}]}