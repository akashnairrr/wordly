{"id":"finta","lemma":"finta","pos":"noun","rank":875,"glosses":["affectation, simulation","feint, dummy"],"ipa":"/ˈfin.ta/","gender":"f","forms":{"plural":"finte"},"examples":[{"text":"Fa finta di sapere tutto.","en":"He pretends to know everything.","words":[{"g":"to do","l":"fare"},null,{"g":"of"},{"g":"to know"},{"g":"everything, all"}]},{"text":"Faceva finta di essere un uomo stupido.","en":"He pretended to be a stupid man.","words":[{"g":"to do","l":"fare"},null,{"g":"of"},{"g":"to be"},{"g":"a"},{"g":"person, man"},{"g":"stupid, daft"}]},{"text":"È una barba finta, vero?","en":"That's a fake beard, isn't it?","words":[{"g":"is","l":"essere"},{"g":"a","l":"uno"},{"g":"beard"},null,{"g":"true"}]},{"text":"Facciamo finta di non averlo sentito.","en":"Let's pretend we didn't hear that.","words":[{"g":"to do","l":"fare"},null,{"g":"of"},{"g":"not"},null,{"g":"sincere"}]},{"text":"Facciamo finta che siamo pirati.","en":"Let's make believe that we're pirates.","words":[{"g":"to do","l":"fare"},null,{"g":"that / what"},{"g":"to be","l":"essere"},{"g":"pirate","l":"pirata"}]}]}