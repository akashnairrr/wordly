{"id":"prete","lemma":"prete","pos":"noun","rank":1679,"glosses":["priest, clergyman, minister, pastor"],"ipa":"/ˈprɛ.te/","gender":"m","forms":{"plural":"preti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q652_%28ita%29-LangPao-prete.wav","examples":[{"text":"Sei un prete?","en":"Are you a priest?","words":[{"g":"are","l":"essere"},{"g":"a"},null]},{"text":"Sono, dopo tutto, un prete.","en":"I am, after all, a priest.","words":[{"g":"am / are","l":"essere"},null,null,{"g":"a"},null],"phrases":[[1,3,"after all"]]},{"text":"Voglio diventare un prete.","en":"I want to become a priest.","words":[{"g":"to want","l":"volere"},{"g":"to become"},{"g":"a"},null]},{"text":"Quale era il nome del prete?","en":"What was the priest's name?","words":[{"g":"what?"},{"g":"to be","l":"essere"},{"g":"the"},{"g":"name"},{"g":"of the"},null]},{"text":"È davvero un prete?","en":"Are you really a priest?","words":[{"g":"is","l":"essere"},{"g":"really, in fact"},{"g":"a"},null]}]}