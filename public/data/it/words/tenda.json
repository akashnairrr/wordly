{"id":"tenda","lemma":"tenda","pos":"noun","rank":2276,"glosses":["tent","curtain, blind, shade","awning, sunshade, sunblind"],"ipa":"/ˈtɛn.da/","gender":"f","forms":{"plural":"tende"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-tenda.wav","examples":[{"text":"Vivono in tende.","en":"They live in tents.","words":[{"g":"to live","l":"vivere"},{"g":"in"},null]},{"text":"Posso aprire la tenda?","en":"Can I open the curtain?","words":[{"g":"can, could","l":"potere"},{"g":"to open"},{"g":"the / her"},null]},{"text":"Tende a parlare troppo.","en":"He tends to talk too much.","words":[null,{"g":"to / at"},{"g":"to talk, to speak"},{"g":"too much"}]},{"text":"Abbiamo dormito in una tenda.","en":"We slept in a tent.","words":[{"g":"to have","l":"avere"},{"g":"to sleep","l":"dormire"},{"g":"in"},{"g":"a","l":"uno"},null]},{"text":"Tende a fare molte domande.","en":"He tends to ask a lot of questions.","words":[null,{"g":"to / at"},{"g":"to do"},{"g":"much, very much, a lot","l":"molto"},{"g":"question","l":"domanda"}]}]}