{"id":"ruota","lemma":"ruota","pos":"noun","rank":2211,"glosses":["wheel"],"ipa":"/ˈrwɔ.ta/","gender":"f","forms":{"plural":"ruote","masculine":"rotino"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q652_%28ita%29-XANA000-ruota.wav","examples":[{"text":"Non mi vuoi vedere fare una ruota?","en":"Don't you want to see me do a cartwheel?","words":[{"g":"not"},{"g":"me / myself"},{"g":"to want","l":"volere"},{"g":"to see"},{"g":"to do"},{"g":"a","l":"uno"},null]},{"text":"Entrambi hanno le ruote.","en":"Both have wheels.","words":[{"g":"both"},{"g":"to have","l":"avere"},{"g":"the / to her"},null]},{"text":"Ha inventato la ruota.","en":"He invented the wheel.","words":[{"g":"has","l":"avere"},{"g":"invented"},{"g":"the / her"},null]},{"text":"L'acqua fa girare la ruota.","en":"The water makes the wheel turn.","words":[null,{"g":"water"},{"g":"to do","l":"fare"},{"g":"to turn"},{"g":"the / her"},null]},{"text":"Un'automobile ha quattro ruote.","en":"An automobile has four wheels.","words":[{"g":"a"},{"g":"automobile"},{"g":"has","l":"avere"},{"g":"four"},null]}]}