{"id":"incubo","lemma":"incubo","pos":"noun","rank":1616,"glosses":["nightmare, incubus"],"ipa":"/ˈin.ku.bo/","gender":"m","forms":{"plural":"incubi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q652_%28ita%29-LangPao-incubo.wav","examples":[{"text":"Questo è un incubo.","en":"This is a nightmare.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Hai gli incubi?","en":"Do you have nightmares?","words":[{"g":"have","l":"avere"},{"g":"the / to him"},null]},{"text":"Era solo un incubo.","en":"It was only a nightmare.","words":[{"g":"to be","l":"essere"},{"g":"only, just"},{"g":"a"},null]},{"text":"Ho ancora degli incubi.","en":"I still have nightmares.","words":[{"g":"have","l":"avere"},{"g":"still / again"},{"g":"a, an","l":"uno"},null]},{"text":"Che incubo!","en":"What a nightmare!","words":[{"g":"that / what"},null]}]}