{"id":"olio","lemma":"olio","pos":"noun","rank":1893,"glosses":["oil"],"ipa":"/ˈɔ.ljo/","gender":"m","forms":{"plural":"oli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q652_%28ita%29-LangPao-olio.wav","examples":[{"text":"Questo è olio.","en":"This is oil.","words":[{"g":"this"},{"g":"is","l":"essere"},null]},{"text":"Stiamo cercando olio.","en":"We're looking for oil.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to look for","l":"cercare"},null]},{"text":"Aggiungi un po' d'olio.","en":"Add a little oil.","words":[{"g":"to add, to append","l":"aggiungere"},{"g":"a"},null,null,null]},{"text":"Dovresti cambiare l'olio.","en":"You should change the oil.","words":[{"g":"to owe","l":"dovere"},{"g":"to exchange"},null,null]},{"text":"Mi scusi, mi controlli l'olio.","en":"Excuse me, please check the oil.","words":[null,null,{"g":"me / myself"},{"g":"check","l":"controllo"},null,null],"phrases":[[0,2,"sorry"]]}]}