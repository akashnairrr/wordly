{"id":"costantemente","lemma":"costantemente","pos":"adv","rank":3993,"glosses":["constantly","steadfastly"],"ipa":"/kos.tan.teˈmen.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q652_%28ita%29-XANA000-costantemente.wav","examples":[{"text":"Il vento soffia costantemente.","en":"The wind blows constantly.","words":[{"g":"the"},{"g":"wind"},{"g":"to blow","l":"soffiare"},null]},{"text":"Scrive costantemente delle lettere.","en":"She is constantly writing letters.","words":[{"g":"to write","l":"scrivere"},null,null,{"g":"letter","l":"lettera"}]},{"text":"Era costantemente bullizzato a scuola.","en":"He was constantly bullied at school.","words":[{"g":"to be","l":"essere"},null,null,{"g":"to / at"},{"g":"school"}]},{"text":"Mio zio causa costantemente dei problemi alla sua famiglia.","en":"My uncle constantly causes his family trouble.","words":[{"g":"mine"},{"g":"uncle"},{"g":"cause"},null,{"g":"some"},{"g":"problem","l":"problema"},{"g":"to the"},{"g":"his, hers, its","l":"suo"},{"g":"family"}]},{"text":"Dimentico costantemente i nomi delle persone.","en":"I am constantly forgetting people's names.","words":[{"g":"to forget","l":"dimenticare"},null,{"g":"the","l":"la"},{"g":"name","l":"nome"},null,{"g":"person","l":"persona"}]}]}