{"id":"tumore","lemma":"tumore","pos":"noun","rank":2399,"glosses":["tumour, tumor"],"ipa":"/tuˈmo.re/","gender":"m","forms":{"plural":"tumori"},"examples":[{"text":"Il vecchio è morto di tumore.","en":"The old man died of cancer.","words":[{"g":"the"},{"g":"old, outworn"},{"g":"is","l":"essere"},{"g":"dead man"},{"g":"of"},null]},{"text":"Potrei avere un tumore.","en":"I could have cancer.","words":[{"g":"can, could","l":"potere"},{"g":"to have"},{"g":"a"},null]},{"text":"Ho un tumore alla gola.","en":"I have throat cancer.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"to the"},{"g":"throat"}]},{"text":"Non morì di tumore.","en":"He did not die of cancer.","words":[{"g":"not"},{"g":"to die","l":"morire"},{"g":"of"},null]},{"text":"Tu hai un tumore.","en":"You've got cancer.","words":[{"g":"you"},{"g":"have","l":"avere"},{"g":"a"},null]}]}