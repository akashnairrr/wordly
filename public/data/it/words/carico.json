{"id":"carico","lemma":"carico","pos":"adj","rank":1331,"glosses":["loaded, laden","loaded (of a gun, etc.)","charged (of a battery, etc.)"],"ipa":"/ˈka.ri.ko/","forms":{"feminine":"carica","masculinePlural":"carichi","femininePlural":"cariche"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q652_%28ita%29-DivoLetto-carico.wav","examples":[{"text":"È già arrivato il carico?","en":"Has the shipment arrived yet?","words":[{"g":"is","l":"essere"},{"g":"already"},{"g":"successful"},{"g":"the"},null]},{"text":"Non dovrai farti carico di quello.","en":"You won't have to take charge of that.","words":[{"g":"not"},{"g":"to owe","l":"dovere"},null,null,{"g":"of"},{"g":"that"}]},{"text":"Dobbiamo alleggerire il carico.","en":"We have to lighten the load.","words":[{"g":"to owe","l":"dovere"},{"g":"to lighten"},{"g":"the"},null]},{"text":"Io sono carico.","en":"I'm psyched.","words":[{"g":"I"},{"g":"am / are","l":"essere"},null]},{"text":"Il carico della nave fu caricato.","en":"The ship's cargo was unloaded.","words":[{"g":"the"},null,{"g":"of the"},{"g":"ship"},{"g":"deceased, late"},{"g":"loaded"}]}]}