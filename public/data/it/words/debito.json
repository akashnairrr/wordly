{"id":"debito","lemma":"debito","pos":"adj","rank":1474,"glosses":["due, proper"],"ipa":"/ˈde.bi.to/","forms":{"feminine":"debita","masculinePlural":"debiti","femininePlural":"debite"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-debito.wav","examples":[{"text":"Gli devo un debito.","en":"I owe him a debt.","words":[{"g":"the / to him"},{"g":"to owe","l":"dovere"},{"g":"a"},null]},{"text":"Non abbiamo altri debiti.","en":"We have no other debt.","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"other","l":"altro"},null]},{"text":"Dovresti pagare i tuoi debiti.","en":"You should pay your debts.","words":[{"g":"to owe","l":"dovere"},{"g":"to pay"},{"g":"the","l":"la"},{"g":"\"your parents\""},null]},{"text":"Ho un debito da ripagare.","en":"I have a debt to pay.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"from"},{"g":"to pay again"}]},{"text":"Io non ho debiti.","en":"I have no debt.","words":[{"g":"I"},{"g":"not"},{"g":"have","l":"avere"},null]}]}