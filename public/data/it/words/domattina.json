{"id":"domattina","lemma":"domattina","pos":"adv","rank":1301,"glosses":["tomorrow morning"],"ipa":"/do.matˈti.na/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q652_%28ita%29-XANA000-domattina.wav","examples":[{"text":"Ho tempo domattina.","en":"I have time tomorrow morning.","words":[{"g":"have","l":"avere"},{"g":"time"},null]},{"text":"Non puoi andare domattina?","en":"Can't you go tomorrow morning?","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to go"},null]},{"text":"Mi chiami alle nove domattina.","en":"Call me at nine tomorrow morning.","words":[{"g":"me / myself"},{"g":"to call","l":"chiamare"},null,{"g":"nine"},null]},{"text":"Vogliamo essere sul primo autobus domattina.","en":"We want to be on the first bus tomorrow morning.","words":[{"g":"to want","l":"volere"},{"g":"to be"},null,{"g":"first"},{"g":"bus"},null]},{"text":"Aspetta fino a domattina.","en":"Wait until tomorrow morning.","words":[{"g":"to wait for","l":"aspettare"},null,null,null],"phrases":[[1,3,"up to"]]}]}