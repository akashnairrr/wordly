{"id":"lassu_","lemma":"lassù","pos":"adv","rank":1883,"glosses":["up there","up above, in heaven","up north"],"ipa":"/lasˈsu/","examples":[{"text":"Perché sei lassù?","en":"Why are you up there?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null]},{"text":"Come ti vanno le cose lassù?","en":"How are things for you up there?","words":[{"g":"how / like"},{"g":"you"},{"g":"to go","l":"andare"},{"g":"the / to her"},{"g":"thing","l":"cosa"},null]},{"text":"Non voglio andare lassù.","en":"I don't want to go up there.","words":[{"g":"not"},{"g":"to want","l":"volere"},{"g":"to go"},null]},{"text":"Fai attenzione lassù.","en":"Be careful up there.","audio":"https://tatoeba.org/en/audio/download/1004826","words":[{"g":"to do","l":"fare"},{"g":"watch out!"},null]},{"text":"Ho sentito un rumore lassù.","en":"I heard a noise up there.","words":[{"g":"have","l":"avere"},{"g":"sincere"},{"g":"a"},{"g":"noise, sound"},null]}]}