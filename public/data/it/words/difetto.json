{"id":"difetto","lemma":"difetto","pos":"noun","rank":4078,"glosses":["defect, fault, blemish, flaw","deficiency, lack, shortage"],"ipa":"/diˈfɛt.to/","gender":"m","forms":{"plural":"difetti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q652_%28ita%29-LangPao-difetto.wav","examples":[{"text":"Abbiamo tutti i nostri difetti.","en":"We all have our flaws.","words":[{"g":"to have","l":"avere"},{"g":"all"},{"g":"the","l":"la"},{"g":"our","l":"nostro"},null]},{"text":"Tutti hanno qualche difetto.","en":"Everybody has some faults.","words":[{"g":"all"},{"g":"to have","l":"avere"},{"g":"few"},null]},{"text":"Questo sistema ha degli ovvi difetti.","en":"This system has obvious defects.","words":[{"g":"this"},{"g":"system"},{"g":"has","l":"avere"},{"g":"a, an","l":"uno"},{"g":"obvious","l":"ovvio"},null]},{"text":"Tutti hanno dei difetti.","en":"Everyone has faults.","words":[{"g":"all"},{"g":"to have","l":"avere"},{"g":"some"},null]},{"text":"Abbiamo tutte i nostri difetti.","en":"We all have our flaws.","words":[{"g":"to have","l":"avere"},{"g":"everything, all","l":"tutto"},{"g":"the","l":"la"},{"g":"our","l":"nostro"},null]}]}