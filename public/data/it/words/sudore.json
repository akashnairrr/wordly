{"id":"sudore","lemma":"sudore","pos":"noun","rank":3778,"glosses":["sweat, perspiration"],"ipa":"/suˈdo.re/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/57/LL-Q652_%28ita%29-LangPao-sudore.wav/LL-Q652_%28ita%29-LangPao-sudore.wav.mp3","gender":"m","forms":{"plural":"sudori"},"examples":[{"text":"Perché il sudore è salato?","en":"Why is sweat salty?","words":[{"g":"why / because"},{"g":"the"},null,{"g":"is","l":"essere"},{"g":"salty, salted"}]},{"text":"Si asciugò il sudore dalla fronte.","en":"He wiped the sweat from his brow.","words":[{"g":"oneself"},null,{"g":"the"},null,null,{"g":"forehead, brow"}]},{"text":"Era ricoperto di sudore.","en":"He was covered with sweat.","words":[{"g":"to be","l":"essere"},{"g":"covered"},{"g":"of"},null]},{"text":"Eravamo tutti inzuppati dal sudore.","en":"We were all drenched with perspiration.","words":[{"g":"to be","l":"essere"},{"g":"all"},null,{"g":"since"},null]},{"text":"I suoi capelli sono bagnati di sudore.","en":"Her hair is wet with sweat.","words":[null,null,{"g":"a single hair","l":"capello"},{"g":"am / are","l":"essere"},{"g":"wet, moist","l":"bagnato"},{"g":"of"},null],"phrases":[[0,2,"his"]]}]}