{"id":"farci","lemma":"farci","pos":"verb","rank":607,"glosses":["to simulate; to act; to pretend"],"ipa":"/ˈfar.t͡ʃi/","examples":[{"text":"Non farci nessun favore.","en":"Don't do us any favors.","audio":"https://tatoeba.org/en/audio/download/1010108","words":[{"g":"not"},null,null,{"g":"favour/favor"}]},{"text":"Non possono farci andare.","en":"They can't make us go.","words":[{"g":"not"},{"g":"can, could","l":"potere"},null,{"g":"to go"}]},{"text":"Puoi farci un esempio?","en":"Can you give us an example?","words":[{"g":"can, could","l":"potere"},null,{"g":"a"},{"g":"example"}]},{"text":"Potresti farci un esempio, per piacere?","en":"Could you give us an example, please?","words":[{"g":"can, could","l":"potere"},null,{"g":"a"},{"g":"example"},null,null],"phrases":[[4,6,"please"]]},{"text":"Andiamo a farci una birra.","en":"Let's go for a beer.","words":[{"g":"to go","l":"andare"},{"g":"to / at"},null,{"g":"a","l":"uno"},{"g":"beer"}]}]}