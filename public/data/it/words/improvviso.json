{"id":"improvviso","lemma":"improvviso","pos":"adj","rank":1026,"glosses":["unexpected, sudden, unforeseen, untimely"],"ipa":"/im.provˈvi.zo/","forms":{"feminine":"improvvisa","masculinePlural":"improvvisi","femininePlural":"improvvise"},"examples":[{"text":"Questo è piuttosto improvviso, vero?","en":"This is kind of sudden, isn't it?","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"rather than"},null,{"g":"true"}]},{"text":"Il tempo è cambiato all'improvviso.","en":"The weather changed suddenly.","words":[{"g":"the"},{"g":"time"},{"g":"is","l":"essere"},{"g":"to exchange","l":"cambiare"},null,null]},{"text":"Un vecchio uomo mi ha parlato all'improvviso.","en":"An old man spoke to me suddenly.","words":[{"g":"a"},{"g":"old, outworn"},{"g":"person, man"},{"g":"me / myself"},{"g":"has","l":"avere"},{"g":"spoken"},null,null]},{"text":"Non frenare all'improvviso.","en":"Don't brake suddenly.","words":[{"g":"not"},{"g":"to brake"},null,null]},{"text":"Il nostro treno si è fermato all'improvviso.","en":"Our train stopped suddenly.","words":[{"g":"the"},{"g":"our"},{"g":"train"},{"g":"oneself"},{"g":"is","l":"essere"},{"g":"to stop, arrest","l":"fermare"},null,null]}]}