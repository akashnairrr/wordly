{"id":"appunto","lemma":"appunto","pos":"noun","rank":2090,"glosses":["note (brief piece of writing intended to assist the memory)","reproach","clipboard, scratchpad"],"ipa":"/apˈpun.to/","gender":"m","forms":{"plural":"appunti"},"examples":[{"text":"Voglio prendere appunti.","en":"I want to take notes.","words":[{"g":"to want","l":"volere"},{"g":"to take"},null]},{"text":"C'era un appunto?","en":"Was there a note?","words":[null,{"g":"to be","l":"essere"},{"g":"a"},null]},{"text":"Prende sempre appunti.","en":"He always takes notes.","words":[{"g":"to take","l":"prendere"},{"g":"always"},null]},{"text":"Perché non mi hai lasciato un appunto?","en":"Why didn't you leave me a note?","words":[{"g":"why / because"},{"g":"not"},{"g":"me / myself"},{"g":"have","l":"avere"},{"g":"to leave","l":"lasciare"},{"g":"a"},null]},{"text":"Avresti potuto prendere appunti.","en":"You could've taken notes.","words":[{"g":"to have","l":"avere"},{"g":"can, could","l":"potere"},{"g":"to take"},null]}]}