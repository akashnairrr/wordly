{"id":"gliela","lemma":"gliela","pos":"pron","rank":2246,"glosses":["it to him, her or them"],"ipa":"/ˌʎe.la/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q652_%28ita%29-XANA000-gliela.wav","examples":[{"text":"Gliela volevo mostrare.","en":"I wanted to show it to you.","words":[null,{"g":"to want","l":"volere"},{"g":"to show"}]},{"text":"Non gliela posso dare.","en":"I can't give it to you.","words":[{"g":"not"},null,{"g":"can, could","l":"potere"},{"g":"to give"}]},{"text":"Gliela darò gratis.","en":"I'll give it to you for free.","words":[null,{"g":"to give","l":"dare"},{"g":"for free, gratis"}]},{"text":"Gliela farò pagare per questo.","en":"I'll make you pay for this.","words":[null,{"g":"to do","l":"fare"},{"g":"to pay"},null,null],"phrases":[[3,5,"for this reason"]]},{"text":"Gliela dia.","en":"Give it to her.","words":[null,{"g":"to give","l":"dare"}]}]}