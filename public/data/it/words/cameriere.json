{"id":"cameriere","lemma":"cameriere","pos":"noun","rank":2290,"glosses":["waiter","valet, manservant, footman, lackey"],"ipa":"/ka.meˈrjɛ.re/","gender":"m","forms":{"plural":"camerieri","feminine":"cameriera"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q652_%28ita%29-XANA000-cameriere.wav","examples":[{"text":"Non sei un cameriere, vero?","en":"You're not a waiter, are you?","words":[{"g":"not"},{"g":"are","l":"essere"},{"g":"a"},null,{"g":"true"}]},{"text":"Hai chiesto il conto al cameriere?","en":"Did you ask the waiter for the bill?","words":[{"g":"have","l":"avere"},{"g":"to ask","l":"chiedere"},{"g":"the"},{"g":"calculation"},{"g":"to the"},null]},{"text":"Stai ancora lavorando cameriere?","en":"Are you still working as a waiter?","words":[{"g":"to stay, remain","l":"stare"},{"g":"still / again"},{"g":"to work","l":"lavorare"},null]},{"text":"Siamo camerieri.","en":"We're waiters.","words":[{"g":"to be","l":"essere"},null]},{"text":"Sarò il tuo cameriere stasera.","en":"I'll be your server tonight.","words":[{"g":"to be","l":"essere"},{"g":"the"},{"g":"yours"},null,{"g":"this evening, tonight"}]}]}