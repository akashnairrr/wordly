{"id":"cena","lemma":"cena","pos":"noun","rank":389,"glosses":["dinner (evening meal)"],"ipa":"/ˈt͡ʃe.na/","gender":"f","forms":{"plural":"cene"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q652_%28ita%29-LangPao-cena.wav","examples":[{"text":"È pronta la cena?","en":"Is dinner ready?","audio":"https://tatoeba.org/en/audio/download/1001370","words":[{"g":"is","l":"essere"},{"g":"ready, prepared","l":"pronto"},{"g":"the / her"},null]},{"text":"Vuoi venire per cena stasera?","en":"Do you want to come over for dinner tonight?","words":[{"g":"to want","l":"volere"},{"g":"to come"},{"g":"for"},null,{"g":"this evening, tonight"}]},{"text":"Ha ordinato tre cene.","en":"He ordered three dinners.","words":[{"g":"has","l":"avere"},{"g":"ordered"},{"g":"three"},null]},{"text":"Ti devo una cena.","en":"I owe you a dinner.","words":[{"g":"you"},{"g":"to owe","l":"dovere"},{"g":"a","l":"uno"},null]},{"text":"Cena con me.","en":"Have dinner with me.","words":[null,{"g":"with"},{"g":"me"}]}]}