{"id":"illusione","lemma":"illusione","pos":"noun","rank":3506,"glosses":["illusion, delusion"],"ipa":"/il.luˈzjo.ne/","gender":"f","forms":{"plural":"illusioni"},"examples":[{"text":"La giustizia è un'illusione.","en":"Justice is a delusion.","words":[{"g":"the / her"},{"g":"justice"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Era tutto un'illusione?","en":"Was it all an illusion?","words":[{"g":"to be","l":"essere"},{"g":"everything, all"},{"g":"a"},null]},{"text":"Non è una illusione.","en":"That isn't an illusion.","words":[{"g":"not"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"La sicurezza è un'illusione.","en":"Safety is an illusion.","words":[{"g":"the / her"},{"g":"safety, security"},{"g":"is","l":"essere"},{"g":"a"},null]},{"text":"Forse è solo un'illusione.","en":"Maybe it's just an illusion.","words":[{"g":"maybe"},{"g":"is","l":"essere"},{"g":"only, just"},{"g":"a"},null]}]}