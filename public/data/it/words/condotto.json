{"id":"condotto","lemma":"condotto","pos":"adj","rank":2531,"glosses":["municipal","mercenary"],"ipa":"/konˈdot.to/","forms":{"feminine":"condotta","masculinePlural":"condotti","femininePlural":"condotte"},"examples":[{"text":"La coppia ha condotto una vita felice.","en":"The couple led a happy life.","words":[{"g":"the / her"},{"g":"couple"},{"g":"has","l":"avere"},null,{"g":"a","l":"uno"},{"g":"life"},{"g":"happy"}]},{"text":"Tom ci ha condotti in una trappola.","en":"Tom led us into a trap.","words":[null,{"g":"us / there"},{"g":"has","l":"avere"},null,{"g":"in"},{"g":"a","l":"uno"},{"g":"trap, snare, catch"}]},{"text":"I miei sforzi non hanno condotto ad alcun risultato.","en":"My efforts produced no results.","words":[{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"effort","l":"sforzo"},{"g":"not"},{"g":"to have","l":"avere"},null,null,null,{"g":"result, outcome, issue"}]},{"text":"La tua condotta è triste.","en":"Your conduct is sad.","words":[{"g":"the / her"},{"g":"yours","l":"tuo"},null,{"g":"is","l":"essere"},{"g":"sad, unhappy, bleak"}]},{"text":"La sua condotta era ammirevole.","en":"His conduct was admirable.","words":[{"g":"the / her"},{"g":"his, hers, its","l":"suo"},null,{"g":"to be","l":"essere"},{"g":"admirable"}]}]}