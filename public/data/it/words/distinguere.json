s":[{"g":"has","l":"avere"},{"g":"to do","l":"fare"},{"g":"of the"},{"g":"boy, young man"},{"g":"a"},{"g":"person, man"},null]},{"text":"Distinguere il giusto dallo sbagliato è difficile.","en":"To distinguish right from wrong is difficult.","words":[null,{"g":"the"},{"g":"just, exactly"},null,{"g":"wrong"},{"g":"is","l":"essere"},{"g":"difficult, hard"}]},{"text":"È facile distinguere il bene dal male.","en":"It's easy to distinguish good from evil.","words":[{"g":"is","l":"essere"},{"g":"easy"},null,{"g":"the"},{"g":"well"},{"g":"since"},{"g":"evil, harm"}]}]}