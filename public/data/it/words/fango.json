{"id":"fango","lemma":"fango","pos":"noun","rank":2588,"glosses":["mud","sludge"],"ipa":"/ˈfan.ɡo/","gender":"m","forms":{"plural":"fanghi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-fango.wav","examples":[{"text":"Sono caduto nel fango.","en":"I fell into the mud.","words":[{"g":"am / are","l":"essere"},{"g":"fallen"},{"g":"in the"},null]},{"text":"I ragazzi giocavano nel fango.","en":"The boys played in the mud.","words":[{"g":"the","l":"la"},{"g":"boy, young man","l":"ragazzo"},{"g":"to play a game","l":"giocare"},{"g":"in the"},null]},{"text":"Perché ai maiali piace il fango?","en":"Why do pigs like mud?","words":[{"g":"why / because"},null,{"g":"pig","l":"maiale"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the"},null]},{"text":"Era ricoperto di fango.","en":"He was covered with mud.","words":[{"g":"to be","l":"essere"},{"g":"covered"},{"g":"of"},null]},{"text":"Il tuo cane è coperto di fango.","en":"Your dog is covered in mud.","words":[{"g":"the"},{"g":"yours"},{"g":"dog"},{"g":"is","l":"essere"},{"g":"covered"},{"g":"of"},null]}]}