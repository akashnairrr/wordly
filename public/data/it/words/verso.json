{"id":"verso","lemma":"verso","pos":"prep","rank":346,"glosses":["in the direction of","in relation to","in the vicinity of; near; by"],"ipa":"/ˈvɛr.so/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q652_%28ita%29-XANA000-verso.wav","examples":[{"text":"Guarda sempre verso il futuro.","en":"He is always looking to the future.","words":[{"g":"to look at","l":"guardare"},{"g":"always"},null,{"g":"the"},{"g":"future"}]},{"text":"Gira la chiave verso destra.","en":"Turn the key to the right.","words":[{"g":"to turn","l":"girare"},{"g":"the / her"},{"g":"key"},null,{"g":"right"}]},{"text":"Sarà qui verso le quattro.","en":"He'll be here around four o'clock.","words":[{"g":"to be","l":"essere"},{"g":"here"},null,{"g":"the / to her"},{"g":"four"}]},{"text":"Vieni verso di me.","en":"Come to me.","words":[{"g":"to come","l":"venire"},null,{"g":"of"},{"g":"me"}]},{"text":"Verso che ora?","en":"About what time?","words":[null,{"g":"that / what"},{"g":"now"}]}]}