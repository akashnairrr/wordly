{"id":"comunque","lemma":"comunque","pos":"adv","rank":233,"glosses":["anyhow, in any case, regardless","anyway, but, though"],"ipa":"/koˈmun.kwe/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q652_%28ita%29-XANA000-comunque.wav","examples":[{"text":"Che giorno è, comunque?","en":"What day is it, anyway?","words":[{"g":"that / what"},{"g":"day"},{"g":"is","l":"essere"},null]},{"text":"Perché importa comunque?","en":"Why does it matter anyhow?","words":[{"g":"why / because"},{"g":"to be important","l":"importare"},null]},{"text":"Di dove sei comunque?","en":"Where are you from anyway?","words":[{"g":"of"},{"g":"where"},{"g":"are","l":"essere"},null]},{"text":"Comunque, cominciamo.","en":"Anyhow, let's begin.","words":[null,{"g":"to begin","l":"cominciare"}]},{"text":"Comunque, iniziamo.","en":"Anyhow, let's begin.","words":[null,{"g":"to begin, to set about","l":"iniziare"}]}]}