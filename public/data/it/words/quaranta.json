{"id":"quaranta","lemma":"quaranta","pos":"num","rank":3962,"glosses":["forty"],"ipa":"/kwaˈran.ta/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q652_%28ita%29-XANA000-quaranta.wav","examples":[{"text":"C'era abbastanza cibo per quaranta giorni.","en":"There was enough food for forty days.","words":[null,{"g":"to be","l":"essere"},{"g":"enough, sufficiently"},{"g":"food"},{"g":"for"},null,{"g":"days"}]},{"text":"Ci sono quaranta studenti nella nostra classe.","en":"There are forty students in our class.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},null,{"g":"student","l":"studente"},{"g":"in the"},{"g":"our","l":"nostro"},{"g":"class"}]},{"text":"Quaranta persone erano presenti.","en":"Forty people were present.","words":[null,{"g":"person","l":"persona"},{"g":"to be","l":"essere"},{"g":"present tense","l":"presente"}]},{"text":"Deve avere quaranta anni o giù di lì.","en":"She must be forty or so.","words":[{"g":"to owe","l":"dovere"},{"g":"to have"},null,{"g":"year","l":"anno"},{"g":"or"},null,null,null],"phrases":[[5,8,"about"]]},{"text":"Questo libro contiene quaranta fotografie.","en":"This book contains forty photographs.","words":[{"g":"this"},{"g":"book"},{"g":"to contain","l":"contenere"},null,{"g":"photography","l":"fotografia"}]}]}