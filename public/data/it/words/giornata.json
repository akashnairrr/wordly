{"id":"giornata","lemma":"giornata","pos":"noun","rank":451,"glosses":["day"],"ipa":"/d͡ʒorˈna.ta/","gender":"f","forms":{"plural":"giornate"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q652_%28ita%29-LangPao-giornata.wav","examples":[{"text":"Ogni giornata è la stessa.","en":"Every day is the same.","words":[{"g":"each, every"},null,{"g":"is","l":"essere"},{"g":"the / her"},{"g":"same","l":"stesso"}]},{"text":"Lavoro durante la giornata.","en":"I work during the day.","words":[{"g":"work"},{"g":"during"},{"g":"the / her"},null]},{"text":"Abbiamo tutti brutte giornate.","en":"We all have bad days.","words":[{"g":"to have","l":"avere"},{"g":"all"},{"g":"ugly, bad, nasty","l":"brutto"},null]},{"text":"Oggi è una giornata speciale.","en":"Today is a special day.","words":[{"g":"today"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null,{"g":"special"}]},{"text":"Hai finito per la giornata?","en":"Are you finished for the day?","words":[{"g":"have","l":"avere"},{"g":"finished"},{"g":"for"},{"g":"the / her"},null]}]}