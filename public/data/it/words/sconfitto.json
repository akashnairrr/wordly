{"id":"sconfitto","lemma":"sconfitto","pos":"adj","rank":3280,"glosses":["defeated, beaten, overthrown"],"ipa":"/skonˈfit.to/","forms":{"feminine":"sconfitta","masculinePlural":"sconfitti","femininePlural":"sconfitte"},"formAudio":{"sconfitta":"https://upload.wikimedia.org/wikipedia/commons/4/49/LL-Q652_%28ita%29-LangPao-sconfitta.wav"},"examples":[{"text":"Abbiamo sconfitto il nemico.","en":"We defeated the enemy.","words":[{"g":"to have","l":"avere"},null,{"g":"the"},{"g":"enemy"}]},{"text":"Non li abbiamo sconfitti.","en":"We didn't beat them.","words":[{"g":"not"},{"g":"them"},{"g":"to have","l":"avere"},null]},{"text":"Non sono mai stato sconfitto.","en":"I've never been defeated.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"never"},{"g":"to be","l":"essere"},null]},{"text":"Io sono stato sconfitto due volte.","en":"I've been beaten twice.","words":[{"g":"I"},{"g":"am / are","l":"essere"},{"g":"to be","l":"essere"},null,{"g":"two"},{"g":"time","l":"volta"}]},{"text":"Li abbiamo sconfitti a baseball.","en":"We defeated them in baseball.","words":[{"g":"them"},{"g":"to have","l":"avere"},null,{"g":"to / at"},{"g":"baseball"}]}]}