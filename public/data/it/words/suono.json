{"id":"suono","lemma":"suono","pos":"noun","rank":1198,"glosses":["sound (that is heard)"],"ipa":"/ˈswɔ.no/","gender":"m","forms":{"plural":"suoni"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c2/LL-Q652_%28ita%29-LangPao-suono.wav","examples":[{"text":"Conosco quel suono.","en":"I know that sound.","words":[{"g":"to know","l":"conoscere"},null,null]},{"text":"Da dove viene quel suono?","en":"Where's that sound coming from?","words":[null,null,null,null,null],"phrases":[[0,3,"where are you from?"]]},{"text":"È un suono felice.","en":"That's a happy sound.","words":[{"g":"is","l":"essere"},{"g":"a"},null,{"g":"happy"}]},{"text":"Quando hai sentito il suono?","en":"When did you hear the sound?","words":[{"g":"when"},{"g":"have","l":"avere"},{"g":"sincere"},{"g":"the"},null]},{"text":"Odio il suono della mia voce.","en":"I hate the sound of my voice.","words":[{"g":"hatred"},{"g":"the"},null,{"g":"of the"},{"g":"mine","l":"mio"},{"g":"voice"}]}]}