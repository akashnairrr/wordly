{"id":"controllo","lemma":"controllo","pos":"noun","rank":390,"glosses":["check, control, verification, examination, inspection","test, check, checkup, visit","surveillance, watch"],"ipa":"/konˈtrɔl.lo/","gender":"m","forms":{"plural":"controlli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q652_%28ita%29-LangPao-controllo.wav","examples":[{"text":"Il fuoco è sotto controllo.","en":"The fire is under control.","words":[{"g":"the"},{"g":"fire"},{"g":"is","l":"essere"},{"g":"down"},null]},{"text":"Non controllo mai i miei messaggi.","en":"I never check my messages.","words":[{"g":"not"},null,{"g":"never"},{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"message","l":"messaggio"}]},{"text":"Ho preso il controllo della situazione.","en":"I took control of the situation.","words":[{"g":"have","l":"avere"},{"g":"to take","l":"prendere"},{"g":"the"},null,{"g":"of the"},{"g":"situation"}]},{"text":"Abbiamo tutto sotto controllo.","en":"We have everything under control.","words":[{"g":"to have","l":"avere"},{"g":"everything, all"},{"g":"down"},null]},{"text":"È fuori dal tuo controllo.","en":"That's out of your control.","words":[{"g":"is","l":"essere"},{"g":"out, outside, outwards"},{"g":"since"},{"g":"yours"},null]}]}