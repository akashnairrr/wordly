{"id":"chi","lemma":"chi","pos":"pron","rank":55,"glosses":["he/she/they who, those who, the ones who; (archaic) whom","whoever, who","some, ... others, etc."],"ipa":"/ki/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q652_%28ita%29-LangPao-chi.wav","examples":[{"text":"Chi c'è lì?","en":"Who is there?","audio":"https://tatoeba.org/en/audio/download/993496","words":[null,null,{"g":"is","l":"essere"},{"g":"there"}]},{"text":"Chi sono i miei genitori?","en":"Who are my parents?","audio":"https://tatoeba.org/en/audio/download/1004833","words":[null,{"g":"am / are","l":"essere"},{"g":"the","l":"la"},{"g":"\"my parents\""},{"g":"parent","l":"genitore"}]},{"text":"Chi la pensa così?","en":"Who thinks so?","audio":"https://tatoeba.org/en/audio/download/1000271","words":[null,{"g":"the / her"},{"g":"to think","l":"pensare"},{"g":"so"}]},{"text":"So chi sei.","en":"I know who you are.","words":[{"g":"to know","l":"sapere"},null,{"g":"are","l":"essere"}]},{"text":"La domanda è chi.","en":"The question is who.","words":[{"g":"the / her"},{"g":"question"},{"g":"is","l":"essere"},null]}]}