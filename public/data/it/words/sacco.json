{"id":"sacco","lemma":"sacco","pos":"noun","rank":331,"glosses":["sack, bag","sack, sackful, bag, bagful (the contents of one full bag)","sac"],"ipa":"/ˈsak.ko/","gender":"m","forms":{"plural":"sacchi","femininePlural":"sacca"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9c/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-sacco.wav","examples":[{"text":"Abbiamo un sacco di cibo.","en":"We have a lot of food.","words":[{"g":"to have","l":"avere"},{"g":"a"},null,{"g":"of"},{"g":"food"}]},{"text":"Che c'è nel sacco?","en":"What's in the sack?","words":[{"g":"that / what"},null,{"g":"is","l":"essere"},{"g":"in the"},null]},{"text":"Ho ancora un sacco di tempo.","en":"I still have plenty of time.","words":[{"g":"have","l":"avere"},{"g":"still / again"},{"g":"a"},null,{"g":"of"},{"g":"time"}]},{"text":"Mio zio ha un sacco di soldi.","en":"My uncle has a ton of money.","words":[{"g":"mine"},{"g":"uncle"},{"g":"has","l":"avere"},{"g":"a"},null,{"g":"of"},{"g":"money"}]},{"text":"Hanno un sacco d'acqua.","en":"They have plenty of water.","words":[{"g":"to have","l":"avere"},{"g":"a"},null,null,{"g":"water"}]}]}