{"id":"moglie","lemma":"moglie","pos":"noun","rank":205,"glosses":["wife"],"ipa":"/ˈmoʎ.ʎe/","gender":"f","forms":{"plural":"mogli"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q652_%28ita%29-LangPao-moglie.wav","examples":[{"text":"È tua moglie?","en":"Is that your wife?","words":[{"g":"is","l":"essere"},{"g":"yours","l":"tuo"},null]},{"text":"Hai una moglie?","en":"Do you have a wife?","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null]},{"text":"Vostra moglie lavora?","en":"Does your wife work?","words":[{"g":"yours","l":"vostro"},null,{"g":"to work","l":"lavorare"}]},{"text":"Ho una moglie e una famiglia.","en":"I have a wife and family.","words":[{"g":"have","l":"avere"},{"g":"a","l":"uno"},null,{"g":"and"},{"g":"a","l":"uno"},{"g":"family"}]},{"text":"Noi mogli dobbiamo stare insieme.","en":"We wives have to stick together.","words":[{"g":"we"},null,{"g":"to owe","l":"dovere"},null,null],"phrases":[[3,5,"to be together"]]}]}