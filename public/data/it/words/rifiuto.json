{"id":"rifiuto","lemma":"rifiuto","pos":"noun","rank":2212,"glosses":["refusal, declination, rejection, denial","waste, refuse, rubbish, garbage (useless products)"],"ipa":"/riˈfju.to/","gender":"m","forms":{"plural":"rifiuti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q652_%28ita%29-LangPao-rifiuto.wav","examples":[{"text":"Mi rifiuto di permettere questo.","en":"I refuse to allow this.","words":[{"g":"me / myself"},null,{"g":"of"},{"g":"to allow"},{"g":"this"}]},{"text":"Mi rifiuto di rispondere a quello.","en":"I refuse to answer that.","words":[{"g":"me / myself"},null,{"g":"of"},{"g":"to answer"},{"g":"to / at"},{"g":"that"}]},{"text":"Il rifiuto fa male.","en":"Rejection hurts.","words":[{"g":"the"},null,{"g":"to do","l":"fare"},{"g":"evil, harm"}]},{"text":"Mi rifiuto di sentire le tue scuse.","en":"I refuse to listen to your excuses.","words":[{"g":"me / myself"},null,{"g":"of"},{"g":"to feel"},{"g":"the / to her"},{"g":"yours","l":"tuo"},{"g":"apology, excuse","l":"scusa"}]},{"text":"Io mi rifiuto di sedermi lì.","en":"I refuse to sit there.","words":[{"g":"I"},{"g":"me / myself"},null,{"g":"of"},null,{"g":"there"}]}]}