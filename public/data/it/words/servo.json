{"id":"servo","lemma":"servo","pos":"noun","rank":195,"glosses":["slave","servant"],"ipa":"/ˈsɛr.vo/","gender":"m","forms":{"plural":"servi","feminine":"serva"},"examples":[{"text":"Non sono il vostro servo.","en":"I'm not your servant.","words":[{"g":"not"},{"g":"am / are","l":"essere"},{"g":"the"},{"g":"yours"},null]},{"text":"Ha ancora tre servi.","en":"He still has three servants.","words":[{"g":"has","l":"avere"},{"g":"still / again"},{"g":"three"},null]},{"text":"Se ti comporti come un servo, sarai trattato come un servo.","en":"If you behave like a servant, you'll be treated like a servant.","words":[{"g":"if"},{"g":"you"},{"g":"to entail","l":"comportare"},{"g":"how / like"},{"g":"a"},null,{"g":"to be","l":"essere"},{"g":"treaty"},{"g":"how / like"},{"g":"a"},null]},{"text":"Penso che ci serva più acqua.","en":"I think we need more water.","words":[{"g":"to think","l":"pensare"},{"g":"that / what"},{"g":"us / there"},null,{"g":"more"},{"g":"water"}]},{"text":"Cosa servi oggi?","en":"What are you serving today?","words":[{"g":"thing"},null,{"g":"today"}]}]}