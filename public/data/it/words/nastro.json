{"id":"nastro","lemma":"nastro","pos":"noun","rank":1904,"glosses":["ribbon","tape"],"ipa":"/ˈnas.tro/","gender":"m","forms":{"plural":"nastri"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q652_%28ita%29-LangPao-nastro.wav","examples":[{"text":"Dobbiamo distruggere questo nastro.","en":"We need to destroy this tape.","words":[{"g":"to owe","l":"dovere"},{"g":"to destroy"},{"g":"this"},null]},{"text":"Ho bisogno di quel nastro.","en":"I need that tape.","words":[{"g":"have","l":"avere"},{"g":"need"},{"g":"of"},null,null]},{"text":"Mi serve quel nastro.","en":"I need that tape.","words":[{"g":"me / myself"},{"g":"slave","l":"servo"},null,null]},{"text":"Il gatto aveva un nastro intorno al collo.","en":"The cat had a ribbon around its neck.","words":[{"g":"the"},{"g":"cat"},{"g":"to have","l":"avere"},{"g":"a"},null,{"g":"around, round"},{"g":"to the"},{"g":"neck"}]},{"text":"Hai del nastro adesivo?","en":"Do you have any tape?","words":[{"g":"have","l":"avere"},{"g":"of the"},null,{"g":"adhesive"}]}]}