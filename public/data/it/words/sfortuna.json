{"id":"sfortuna","lemma":"sfortuna","pos":"noun","rank":2581,"glosses":["misfortune, bad luck"],"ipa":"/sforˈtu.na/","gender":"f","forms":{"plural":"sfortune"},"examples":[{"text":"Ho avuto una serie di sfortune da allora.","en":"I have had a series of misfortunes since then.","words":[{"g":"have","l":"avere"},{"g":"to have","l":"avere"},{"g":"a","l":"uno"},{"g":"series"},{"g":"of"},null,{"g":"from"},{"g":"then"}]},{"text":"La nostra sfortuna era temporanea.","en":"Our bad luck was temporary.","words":[{"g":"the / her"},{"g":"our","l":"nostro"},null,{"g":"to be","l":"essere"},{"g":"temporary","l":"temporaneo"}]},{"text":"La sfortuna non arriva mai da sola.","en":"Misfortunes rarely come singly.","words":[{"g":"the / her"},null,{"g":"not"},{"g":"to arrive","l":"arrivare"},{"g":"never"},{"g":"from"},{"g":"the only one"}]},{"text":"Abbiamo avuto troppa sfortuna.","en":"We've had too much bad luck.","words":[{"g":"to have","l":"avere"},{"g":"to have","l":"avere"},{"g":"too much","l":"troppo"},null]},{"text":"Io ho avuto una serie di sfortune da allora.","en":"I have had a series of misfortunes since then.","words":[{"g":"I"},{"g":"have","l":"avere"},{"g":"to have","l":"avere"},{"g":"a","l":"uno"},{"g":"series"},{"g":"of"},null,{"g":"from"},{"g":"then"}]}]}