{"id":"caccia","lemma":"caccia","pos":"noun","rank":710,"glosses":["hunting; shooting","look out","pursuit"],"ipa":"/ˈkat.t͡ʃa/","gender":"f","forms":{"plural":"cacce"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q652_%28ita%29-LangPao-caccia.wav","examples":[{"text":"Chi vuole andare a caccia?","en":"Who wants to go hunting?","words":[{"g":"who"},{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to / at"},null]},{"text":"Voglio andare a caccia con te.","en":"I want to go hunting with you.","words":[{"g":"to want","l":"volere"},{"g":"to go"},{"g":"to / at"},null,{"g":"with"},{"g":"you, thee"}]},{"text":"La caccia è finita.","en":"The hunt is over.","words":[{"g":"the / her"},null,{"g":"is","l":"essere"},{"g":"finished","l":"finito"}]},{"text":"Vai a caccia questa settimana?","en":"Are you going hunting this week?","words":[{"g":"to go","l":"andare"},{"g":"to / at"},null,{"g":"this, this one, these","l":"questo"},{"g":"week"}]},{"text":"Sto andando a caccia.","en":"I'm going hunting.","words":[{"g":"to stay, remain","l":"stare"},{"g":"to go","l":"andare"},{"g":"to / at"},null]}]}