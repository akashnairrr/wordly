{"id":"spirito","lemma":"spirito","pos":"noun","rank":950,"glosses":["spirit, mind","sparkle, wit, esprit","alcohol"],"ipa":"/ˈspi.ri.to/","gender":"m","forms":{"plural":"spiriti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q652_%28ita%29-XANA000-spirito.wav","examples":[{"text":"Non ho il tuo spirito.","en":"I don't have your wit.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"the"},{"g":"yours"},null]},{"text":"La casa è infestata dagli spiriti.","en":"The house is haunted.","words":[{"g":"the / her"},{"g":"house"},{"g":"is","l":"essere"},null,null,null]},{"text":"Ammiro il suo spirito.","en":"I admire his wit.","words":[{"g":"to admire","l":"ammirare"},{"g":"the"},{"g":"his, hers, its"},null]},{"text":"Non ho il vostro spirito.","en":"I don't have your wit.","words":[{"g":"not"},{"g":"have","l":"avere"},{"g":"the"},{"g":"yours"},null]},{"text":"Il mio corpo è vecchio, ma il mio spirito è giovane.","en":"My body is old, but my spirit is young.","words":[{"g":"the"},{"g":"mine"},{"g":"body"},{"g":"is","l":"essere"},{"g":"old, outworn"},{"g":"but"},{"g":"the"},{"g":"mine"},null,{"g":"is","l":"essere"},{"g":"young"}]}]}