{"id":"sasso","lemma":"sasso","pos":"noun","rank":3826,"glosses":["stone, rock","stone, rock, boulder, pebble"],"ipa":"/ˈsas.so/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/LL-Q652_%28ita%29-LangPao-sasso.wav/LL-Q652_%28ita%29-LangPao-sasso.wav.mp3","gender":"m","forms":{"plural":"sassi"},"examples":[{"text":"Raccolse un sasso.","en":"He picked up a stone.","words":[{"g":"to pick up, glean","l":"raccogliere"},{"g":"a"},null]},{"text":"Ha tirato un sasso nel lago.","en":"He threw a stone into the lake.","words":[{"g":"has","l":"avere"},{"g":"to pull","l":"tirare"},{"g":"a"},null,{"g":"in the"},{"g":"lake"}]},{"text":"Ho un sasso nella scarpa.","en":"There's a rock in my shoe.","words":[{"g":"have","l":"avere"},{"g":"a"},null,{"g":"in the"},{"g":"shoe"}]},{"text":"Alcune persone hanno iniziato a lanciare sassi.","en":"Some people started throwing rocks.","words":[{"g":"some, a few","l":"alcuno"},{"g":"person","l":"persona"},{"g":"to have","l":"avere"},{"g":"initiated"},{"g":"to / at"},{"g":"to throw"},null]},{"text":"Lei inciampò sul sasso.","en":"She tripped on the stone.","words":[{"g":"she / you (formal)"},null,null,null]}]}