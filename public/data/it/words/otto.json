{"id":"otto","lemma":"otto","pos":"noun","rank":659,"glosses":["eight"],"ipa":"/ˈɔt.to/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q652_%28ita%29-XANA000-otto.wav","examples":[{"text":"Sarò a casa tua alle otto.","en":"I will be at your house at eight.","words":[{"g":"to be","l":"essere"},{"g":"to / at"},{"g":"house"},{"g":"yours","l":"tuo"},null,null]},{"text":"Suo figlio ha otto anni.","en":"His son is eight years old.","words":[{"g":"his, hers, its"},{"g":"son"},{"g":"has","l":"avere"},null,{"g":"year","l":"anno"}]},{"text":"La nostra scuola comincia alle otto.","en":"Our school begins at eight.","words":[{"g":"the / her"},{"g":"our","l":"nostro"},{"g":"school"},{"g":"to begin","l":"cominciare"},null,null]},{"text":"Ho otto fratelli e sorelle.","en":"I have eight brothers and sisters.","words":[{"g":"have","l":"avere"},null,{"g":"brother, sibling","l":"fratello"},{"g":"and"},{"g":"sister","l":"sorella"}]},{"text":"Otto più due fa dieci.","en":"Eight plus two is ten.","words":[null,{"g":"more"},{"g":"two"},{"g":"to do","l":"fare"},{"g":"ten"}]}]}