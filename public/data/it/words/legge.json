{"id":"legge","lemma":"legge","pos":"noun","rank":568,"glosses":["law"],"ipa":"/ˈled.d͡ʒe/","gender":"f","forms":{"plural":"leggi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cc/LL-Q652_%28ita%29-LangPao-legge.wav","examples":[{"text":"È contro la legge?","en":"Is that against the law?","words":[{"g":"is","l":"essere"},{"g":"against"},{"g":"the / her"},null]},{"text":"Questa è una legge.","en":"This is a law.","words":[{"g":"this, this one, these","l":"questo"},{"g":"is","l":"essere"},{"g":"a","l":"uno"},null]},{"text":"Conosco la legge meglio di te.","en":"I know the law better than you.","words":[{"g":"to know","l":"conoscere"},{"g":"the / her"},null,{"g":"better"},{"g":"of"},{"g":"you, thee"}]},{"text":"Sei nei guai con la legge?","en":"Are you in trouble with the law?","words":[{"g":"are","l":"essere"},{"g":"mole","l":"neo"},{"g":"woe!"},{"g":"with"},{"g":"the / her"},null]},{"text":"Perché non legge un libro?","en":"Why don't you read a book?","words":[{"g":"why / because"},{"g":"not"},null,{"g":"a"},{"g":"book"}]}]}