{"id":"corso","lemma":"corso","pos":"noun","rank":687,"glosses":["course (of a river, of a university, etc.)","stream, waterway","avenue (especially in the names of streets)"],"ipa":"/ˈkor.so/","gender":"m","forms":{"plural":"corsi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q652_%28ita%29-XANA000-corso.wav","examples":[{"text":"Ho finito il corso.","en":"I have finished the course.","words":[{"g":"have","l":"avere"},{"g":"finished"},{"g":"the"},null]},{"text":"Questo è un lavoro in corso.","en":"This is a work in progress.","words":[{"g":"this"},{"g":"is","l":"essere"},{"g":"a"},{"g":"work"},{"g":"in"},null]},{"text":"Perché sei corso via da me?","en":"Why did you run from me?","words":[{"g":"why / because"},{"g":"are","l":"essere"},null,null,null,{"g":"me"}],"phrases":[[3,5,"away from"]]},{"text":"Chi ha corso?","en":"Who ran?","words":[{"g":"who"},{"g":"has","l":"avere"},null]},{"text":"Il cane ha corso.","en":"The dog ran.","words":[{"g":"the"},{"g":"dog"},{"g":"has","l":"avere"},null]}]}