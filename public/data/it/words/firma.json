{"id":"firma","lemma":"firma","pos":"noun","rank":1642,"glosses":["signature (a person's name, written by that person, used as identification or to signify approval of accompanying material, such as a legal contract)","signature (an act of signing one's name)"],"ipa":"/ˈfir.ma/","gender":"f","forms":{"plural":"firme"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q652_%28ita%29-Crunchy_Cloaky_Crackdown-firma.wav","examples":[{"text":"Firma ogni pagina.","en":"Sign each page.","words":[null,{"g":"each, every"},{"g":"page"}]},{"text":"Firma su questa linea.","en":"Sign on this line.","words":[null,{"g":"on"},{"g":"this, this one, these","l":"questo"},{"g":"line"}]},{"text":"Paragoni le firme.","en":"Compare the signatures.","words":[{"g":"to compare","l":"paragonare"},{"g":"the / to her"},null]},{"text":"Firma il contratto.","en":"Sign the contract.","words":[null,{"g":"the"},{"g":"contracted"}]},{"text":"Per piacere firma qui.","en":"Please sign here.","words":[null,null,null,{"g":"here"}],"phrases":[[0,2,"please"]]}]}