{"id":"stranamente","lemma":"stranamente","pos":"adv","rank":3427,"glosses":["strangely, oddly","curiously, weirdly"],"ipa":"/stra.naˈmen.te/","examples":[{"text":"La casa sembrava stranamente calma.","en":"The house seemed strangely quiet.","words":[{"g":"the / her"},{"g":"house"},{"g":"to seem","l":"sembrare"},null,{"g":"calm"}]},{"text":"La casa sembrava stranamente tranquilla.","en":"The house seemed strangely quiet.","words":[{"g":"the / her"},{"g":"house"},{"g":"to seem","l":"sembrare"},null,{"g":"calm, sober, tranquil","l":"tranquillo"}]},{"text":"Le strade sono stranamente silenziose.","en":"The streets are eerily quiet.","words":[{"g":"the / to her"},{"g":"road, way, street","l":"strada"},{"g":"am / are","l":"essere"},null,{"g":"silent","l":"silenzioso"}]},{"text":"Ha iniziato a comportarsi stranamente.","en":"He has started acting strangely.","words":[{"g":"has","l":"avere"},{"g":"initiated"},{"g":"to / at"},{"g":"to behave, act"},null]},{"text":"Lui ha iniziato a comportarsi stranamente.","en":"He has started acting strangely.","words":[{"g":"he"},{"g":"has","l":"avere"},{"g":"initiated"},{"g":"to / at"},{"g":"to behave, act"},null]}]}