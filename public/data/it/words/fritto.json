{"id":"fritto","lemma":"fritto","pos":"adj","rank":4050,"glosses":["fried"],"ipa":"/ˈfrit.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c8/LL-Q652_%28ita%29-LangPao-fritto.wav/LL-Q652_%28ita%29-LangPao-fritto.wav.mp3","forms":{"feminine":"fritta","masculinePlural":"fritti","femininePlural":"fritte"},"examples":[{"text":"Mi piace il cibo fritto.","en":"I like fried food.","words":[{"g":"me / myself"},{"g":"pleasure, enjoyment","l":"piacere"},{"g":"the"},{"g":"food"},null]},{"text":"Amo le banane fritte.","en":"I love fried bananas.","words":[{"g":"to love, to like","l":"amare"},{"g":"the / to her"},{"g":"banana","l":"banana"},null]},{"text":"Non cucino mai cibo fritto.","en":"I never cook fried food.","words":[{"g":"not"},{"g":"to cook","l":"cucinare"},{"g":"never"},{"g":"food"},null]},{"text":"Perché hai fritto solo un uovo?","en":"Why did you fry only one egg?","words":[{"g":"why / because"},{"g":"have","l":"avere"},null,{"g":"only, just"},{"g":"a"},{"g":"egg"}]},{"text":"Due uova fritte e un caffè, per piacere.","en":"Two fried eggs and coffee, please.","words":[{"g":"two"},{"g":"egg","l":"uovo"},null,{"g":"and"},{"g":"a"},{"g":"coffee"},null,null],"phrases":[[6,8,"please"]]}]}