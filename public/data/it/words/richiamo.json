{"id":"richiamo","lemma":"richiamo","pos":"noun","rank":1847,"glosses":["recall, recalling (act of calling back to a specific place, station etc.)","call, invitation","reprimand, rebuke"],"ipa":"/riˈkja.mo/","gender":"m","forms":{"plural":"richiami"},"examples":[{"text":"Ti richiamo più tardi.","en":"I'll call you back later.","words":[{"g":"you"},null,{"g":"more"},{"g":"late"}]},{"text":"La richiamo più tardi.","en":"I'll call you back later.","words":[{"g":"the / her"},null,{"g":"more"},{"g":"late"}]},{"text":"Ti richiamo quando arrivo alla fermata dell'autobus.","en":"I'll call you back when I get to the bus stop.","words":[{"g":"you"},null,{"g":"when"},{"g":"arrival"},{"g":"to the"},{"g":"stop"},null,{"g":"bus"}]},{"text":"Mi richiami fra due giorni.","en":"Call me again in two days.","words":[{"g":"me / myself"},null,{"g":"between"},{"g":"two"},{"g":"days"}]},{"text":"Per piacere, mi richiami.","en":"Please call me back.","words":[null,null,{"g":"me / myself"},null],"phrases":[[0,2,"please"]]}]}