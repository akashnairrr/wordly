{"id":"sepolto","lemma":"sepolto","pos":"adj","rank":2828,"glosses":["buried"],"ipa":"/seˈpol.to/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/53/LL-Q652_%28ita%29-LangPao-sepolto.wav/LL-Q652_%28ita%29-LangPao-sepolto.wav.mp3","forms":{"feminine":"sepolta","masculinePlural":"sepolti","femininePlural":"sepolte"},"examples":[{"text":"È morto e sepolto ora.","en":"He is dead and buried now.","words":[{"g":"is","l":"essere"},{"g":"dead man"},{"g":"and"},null,{"g":"now"}]},{"text":"L'ho sepolta.","en":"I buried it.","words":[null,{"g":"have","l":"avere"},null]},{"text":"È dove è sepolto il tesoro.","en":"That's where the treasure's buried.","words":[{"g":"is","l":"essere"},{"g":"where"},{"g":"is","l":"essere"},null,{"g":"the"},{"g":"valuable things"}]},{"text":"Quando muoio, voglio essere sepolta qui.","en":"When I die, I want to be buried here.","words":[{"g":"when"},{"g":"to die","l":"morire"},{"g":"to want","l":"volere"},{"g":"to be"},null,{"g":"here"}]},{"text":"Le sue ceneri sono sepolte qui.","en":"His ashes are buried here.","words":[null,null,{"g":"ashes, cinders"},{"g":"am / are","l":"essere"},null,{"g":"here"}],"phrases":[[0,2,"his"]]}]}