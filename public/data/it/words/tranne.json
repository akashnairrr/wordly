{"id":"tranne","lemma":"tranne","pos":"prep","rank":933,"glosses":["except, but, apart from"],"ipa":"/ˈtran.ne/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q652_%28ita%29-LangPao-tranne.wav","examples":[{"text":"Odio tutti tranne te.","en":"I hate everyone except you.","words":[{"g":"hatred"},{"g":"all"},null,{"g":"you, thee"}]},{"text":"Lavoro ogni giorno tranne la domenica.","en":"I work every day but Sunday.","words":[{"g":"work"},null,null,null,{"g":"the / her"},{"g":"Sunday"}],"phrases":[[1,3,"daily"]]},{"text":"Non aveva fame nessuno tranne me.","en":"Nobody was hungry except me.","words":[{"g":"not"},{"g":"to have","l":"avere"},{"g":"hunger"},{"g":"none"},null,{"g":"me"}]},{"text":"Ti darò tutto tranne questo.","en":"I'll give you anything but this.","words":[{"g":"you"},{"g":"to give","l":"dare"},{"g":"everything, all"},null,{"g":"this"}]},{"text":"Questa gente è tutto tranne innocente.","en":"These people are anything but innocent.","words":[{"g":"this, this one, these","l":"questo"},null,{"g":"is","l":"essere"},{"g":"everything, all"},null,{"g":"innocent"}]}]}