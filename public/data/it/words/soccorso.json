{"id":"soccorso","lemma":"soccorso","pos":"noun","rank":1504,"glosses":["help, aid, rescue, succour, assistance, relief","aid"],"ipa":"/sokˈkor.so/","gender":"m","forms":{"plural":"soccorsi"},"examples":[{"text":"Grazie per avermi soccorso.","en":"Thanks for rescuing me.","words":[{"g":"thanks, thank-you"},{"g":"for"},null,null]},{"text":"Ho bisogno del primo soccorso.","en":"I need first aid.","words":[{"g":"have","l":"avere"},{"g":"need"},{"g":"of the"},{"g":"first"},null]},{"text":"Sono dovuto andare al pronto soccorso.","en":"I had to go to the emergency room.","words":[{"g":"am / are","l":"essere"},{"g":"owing, owed"},{"g":"to go"},{"g":"to the"},{"g":"ready, prepared"},null]},{"text":"Nessuno è venuto in mio soccorso.","en":"Nobody came to help me.","words":[{"g":"none"},{"g":"is","l":"essere"},{"g":"coming"},{"g":"in"},{"g":"mine"},null]},{"text":"Siamo andati in suo soccorso.","en":"We went to her rescue.","words":[{"g":"to be","l":"essere"},null,{"g":"in"},{"g":"his, hers, its"},null]}]}