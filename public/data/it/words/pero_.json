{"id":"pero_","lemma":"però","pos":"conj","rank":408,"glosses":["yet, but, however, nevertheless"],"ipa":"/peˈrɔ/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q652_%28ita%29-XANA000-per%C3%B2.wav","examples":[{"text":"Voglio mangiare, però non qui.","en":"I want to eat, but not here.","words":[{"g":"to want","l":"volere"},{"g":"to eat"},null,{"g":"not"},{"g":"here"}]},{"text":"Mi scusi, però mi sento male.","en":"Excuse me, but I feel sick.","words":[null,null,null,{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"evil, harm"}],"phrases":[[0,2,"sorry"]]},{"text":"Ballo, però non molto bene.","en":"I dance, but not very well.","words":[{"g":"dance, ball"},null,{"g":"not"},{"g":"very / a lot"},{"g":"well"}]},{"text":"Però cosa può essere fatto?","en":"But what can be done?","words":[null,{"g":"thing"},{"g":"can, could","l":"potere"},{"g":"to be"},{"g":"to do","l":"fare"}]},{"text":"È difficile, però non impossibile.","en":"It's difficult but not impossible.","words":[{"g":"is","l":"essere"},{"g":"difficult, hard"},null,{"g":"not"},{"g":"impossible"}]}]}