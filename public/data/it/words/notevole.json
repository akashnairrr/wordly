{"id":"notevole","lemma":"notevole","pos":"adj","rank":2395,"glosses":["notable, noteworthy, remarkable","considerable, sizeable"],"ipa":"/noˈte.vo.le/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/LL-Q652_%28ita%29-LangPao-notevole.wav/LL-Q652_%28ita%29-LangPao-notevole.wav.mp3","forms":{"plural":"notevoli"},"examples":[{"text":"Questo è notevole.","en":"This is outstanding.","words":[{"g":"this"},{"g":"is","l":"essere"},null]},{"text":"Ha una memoria notevole.","en":"He has a remarkable memory.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},{"g":"memory, recall"},null]},{"text":"Ha una notevole esperienza di guida.","en":"He has quite a lot of experience in driving.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},null,{"g":"experience"},{"g":"of"},{"g":"guide"}]},{"text":"Ha fatto notevoli progressi in inglese.","en":"He made remarkable progress in English.","words":[{"g":"has","l":"avere"},{"g":"to do","l":"fare"},null,{"g":"progress","l":"progresso"},{"g":"in"},{"g":"Englishman"}]},{"text":"Ha una notevole attitudine per la musica.","en":"He has a remarkable aptitude for music.","words":[{"g":"has","l":"avere"},{"g":"a","l":"uno"},null,{"g":"aptitude, flair, bent"},{"g":"for"},{"g":"the / her"},{"g":"music"}]}]}