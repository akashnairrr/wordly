{"id":"anticipo","lemma":"anticipo","pos":"noun","rank":1565,"glosses":["advance, prepayment, deposit, down payment (of a payment)","early (adv.), time ahead (of time)"],"ipa":"/anˈti.t͡ʃi.po/","gender":"m","forms":{"plural":"anticipi"},"examples":[{"text":"Grazie in anticipo.","en":"Thanks in advance.","words":[{"g":"thanks, thank-you"},{"g":"in"},null]},{"text":"Devo pagare in anticipo?","en":"Do I have to pay in advance?","words":[{"g":"to owe","l":"dovere"},{"g":"to pay"},{"g":"in"},null]},{"text":"Perché sei sempre così in anticipo?","en":"Why are you always so early?","words":[{"g":"why / because"},{"g":"are","l":"essere"},{"g":"always"},{"g":"so"},{"g":"in"},null]},{"text":"Te lo farò sapere in anticipo.","en":"I'll let you know in advance.","words":[{"g":"you, thee"},{"g":"the / it"},{"g":"to do","l":"fare"},{"g":"to know"},{"g":"in"},null]},{"text":"Ho pagato in anticipo.","en":"I paid in advance.","words":[{"g":"have","l":"avere"},{"g":"paid"},{"g":"in"},null]}]}