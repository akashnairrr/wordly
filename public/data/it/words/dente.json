{"id":"dente","lemma":"dente","pos":"noun","rank":1043,"glosses":["tooth","cog, prong"],"ipa":"/ˈdɛn.te/","gender":"m","forms":{"plural":"denti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q652_%28ita%29-LangPao-dente.wav","examples":[{"text":"Ho un brutto mal di denti.","en":"I have a bad toothache.","words":[{"g":"have","l":"avere"},{"g":"a"},{"g":"ugly, bad, nasty"},null,{"g":"of"},null]},{"text":"Occhio per occhio, dente per dente.","en":"An eye for an eye, a tooth for a tooth.","words":[null,null,null,null,{"g":"for"},null],"phrases":[[0,3,"an eye for an eye…"]]},{"text":"Quanti denti ha un cavallo?","en":"How many teeth does a horse have?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"has","l":"avere"},{"g":"a"},{"g":"horse"}]},{"text":"Questo dente fa male.","en":"This tooth hurts.","words":[{"g":"this"},null,{"g":"to do","l":"fare"},{"g":"evil, harm"}]},{"text":"I suoi denti erano bianchi.","en":"His teeth were white.","words":[null,null,null,{"g":"to be","l":"essere"},{"g":"white","l":"bianco"}],"phrases":[[0,2,"his"]]}]}