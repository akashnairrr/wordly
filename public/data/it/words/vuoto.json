{"id":"vuoto","lemma":"vuoto","pos":"noun","rank":1212,"glosses":["gap","vacancy","vacuum"],"ipa":"/ˈvwɔ.to/","gender":"m","forms":{"plural":"vuoti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q652_%28ita%29-LangPao-vuoto.wav","examples":[{"text":"Il posto è completamente vuoto.","en":"The place is completely deserted.","words":[{"g":"the"},{"g":"place, spot"},{"g":"is","l":"essere"},{"g":"completely, fully"},null]},{"text":"Gli alberi saranno presto vuoti.","en":"The trees will soon be bare.","words":[{"g":"the / to him"},{"g":"tree","l":"albero"},{"g":"to be","l":"essere"},{"g":"soon"},null]},{"text":"Perché mi sento così vuoto?","en":"Why do I feel so empty?","words":[{"g":"why / because"},{"g":"me / myself"},{"g":"to feel","l":"sentire"},{"g":"so"},null]},{"text":"Questo bicchiere è vuoto.","en":"This glass is empty.","words":[{"g":"this"},{"g":"glass , cup, tumbler"},{"g":"is","l":"essere"},null]},{"text":"Ci sono ancora dei posti vuoti.","en":"There are still empty seats.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"still / again"},{"g":"some"},{"g":"place, spot","l":"posto"},null]}]}