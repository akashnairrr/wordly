{"id":"gratitudine","lemma":"gratitudine","pos":"noun","rank":3723,"glosses":["gratitude"],"ipa":"/ɡra.tiˈtu.di.ne/","gender":"f","forms":{"plural":"gratitudini"},"examples":[{"text":"Hai la mia eterna gratitudine.","en":"You have my eternal gratitude.","words":[{"g":"have","l":"avere"},{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"eternal, everlasting","l":"eterno"},null]},{"text":"Non so come esprimere la mia gratitudine.","en":"I don't know how to express my gratitude.","words":[{"g":"not"},{"g":"to know","l":"sapere"},{"g":"how / like"},{"g":"to express"},{"g":"the / her"},{"g":"mine","l":"mio"},null]},{"text":"Io vorrei esprimerle la mia gratitudine.","en":"I would like to express my gratitude to her.","words":[{"g":"I"},{"g":"to want","l":"volere"},null,{"g":"the / her"},{"g":"mine","l":"mio"},null]},{"text":"Avete la mia eterna gratitudine.","en":"You have my eternal gratitude.","words":[{"g":"to have","l":"avere"},{"g":"the / her"},{"g":"mine","l":"mio"},{"g":"eternal, everlasting","l":"eterno"},null]},{"text":"Vorrei esprimerle la mia gratitudine.","en":"I would like to express my gratitude to her.","words":[{"g":"to want","l":"volere"},null,{"g":"the / her"},{"g":"mine","l":"mio"},null]}]}