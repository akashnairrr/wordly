{"id":"poesia","lemma":"poesia","pos":"noun","rank":2161,"glosses":["poetry","poem","illusion, daydream"],"ipa":"/po.eˈzi.a/","gender":"f","forms":{"plural":"poesie"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q652_%28ita%29-XANA000-poesia.wav","examples":[{"text":"Amo la poesia.","en":"I love poetry.","words":[{"g":"to love, to like","l":"amare"},{"g":"the / her"},null]},{"text":"Amo le poesie.","en":"I love the poems.","words":[{"g":"to love, to like","l":"amare"},{"g":"the / to her"},null]},{"text":"Sai chi ha scritto questa poesia?","en":"Do you know who wrote this poem?","words":[{"g":"to know","l":"sapere"},{"g":"who"},{"g":"has","l":"avere"},{"g":"written"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Di chi è quella poesia?","en":"Who's that poem by?","words":[{"g":"of"},{"g":"who"},{"g":"is","l":"essere"},{"g":"that one","l":"quello"},null]},{"text":"Ha scritto molte poesie.","en":"She wrote a lot of poems.","words":[{"g":"has","l":"avere"},{"g":"written"},{"g":"much, very much, a lot","l":"molto"},null]}]}