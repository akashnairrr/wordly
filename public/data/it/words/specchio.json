{"id":"specchio","lemma":"specchio","pos":"noun","rank":1767,"glosses":["mirror","table, chart"],"ipa":"/ˈspɛk.kjo/","gender":"m","forms":{"plural":"specchi"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q652_%28ita%29-LangPao-specchio.wav","examples":[{"text":"Guarda nello specchio.","en":"Look in the mirror.","words":[{"g":"to look at","l":"guardare"},null,null]},{"text":"Guardati allo specchio.","en":"Look at yourself in the mirror.","words":[{"g":"to look at oneself","l":"guardarsi"},null,null]},{"text":"Non sembra uno specchio?","en":"Doesn't it look like a mirror?","words":[{"g":"not"},{"g":"to seem","l":"sembrare"},{"g":"a / one"},null]},{"text":"Ti sei visto allo specchio?","en":"Have you seen yourself in the mirror?","words":[{"g":"you"},{"g":"are","l":"essere"},{"g":"visa"},null,null]},{"text":"C'è uno specchio.","en":"There's a mirror.","words":[null,{"g":"is","l":"essere"},{"g":"a / one"},null]}]}