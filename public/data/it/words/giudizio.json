{"id":"giudizio","lemma":"giudizio","pos":"noun","rank":1741,"glosses":["judgment, wisdom, sense","trial, proceedings, judgment, verdict","opinion, judgement"],"ipa":"/d͡ʒuˈdit.t͡sjo/","gender":"m","forms":{"plural":"giudizi"},"examples":[{"text":"Il giorno del giudizio è arrivato.","en":"The day of judgment has arrived.","words":[{"g":"the"},{"g":"day"},{"g":"of the"},null,{"g":"is","l":"essere"},{"g":"successful"}]},{"text":"Era una chiamata di giudizio.","en":"It was a judgment call.","words":[{"g":"to be","l":"essere"},{"g":"a","l":"uno"},{"g":"call"},{"g":"of"},null]},{"text":"Gli manca il giudizio.","en":"He lacks judgement.","words":[{"g":"the / to him"},{"g":"to be lacking","l":"mancare"},{"g":"the"},null]},{"text":"Lascio la questione al tuo giudizio.","en":"I leave the matter to your judgement.","words":[{"g":"to leave","l":"lasciare"},{"g":"the / her"},{"g":"question"},{"g":"to the"},{"g":"yours"},null]},{"text":"I giudizi rapidi sono pericolosi.","en":"Quick judgements are dangerous.","words":[{"g":"the","l":"la"},null,{"g":"quick, fast, rapid","l":"rapido"},{"g":"am / are","l":"essere"},{"g":"dangerous","l":"pericoloso"}]}]}