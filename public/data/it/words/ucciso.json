{"id":"ucciso","lemma":"ucciso","pos":"noun","rank":229,"glosses":["victim (killed person)","the dead"],"ipa":"/utˈt͡ʃi.zo/","gender":"m","forms":{"plural":"uccisi","feminine":"uccisa"},"examples":[{"text":"Se dico la verità, sarò ucciso.","en":"If I tell the truth, I'll be killed.","words":[{"g":"if"},{"g":"to utter with one's…","l":"dire"},{"g":"the / her"},{"g":"truth"},{"g":"to be","l":"essere"},null]},{"text":"Non posso essere uccisa così facilmente.","en":"I can't be killed so easily.","words":[{"g":"not"},{"g":"can, could","l":"potere"},{"g":"to be"},null,{"g":"so"},{"g":"easily"}]},{"text":"Il cavallo deve essere ucciso?","en":"Does the horse have to be killed?","words":[{"g":"the"},{"g":"horse"},{"g":"to owe","l":"dovere"},{"g":"to be"},null]},{"text":"Chi hai ucciso?","en":"Who did you kill?","words":[{"g":"who"},{"g":"have","l":"avere"},null]},{"text":"Una donna fu uccisa.","en":"One woman was killed.","words":[{"g":"a","l":"uno"},{"g":"woman"},{"g":"deceased, late"},null]}]}