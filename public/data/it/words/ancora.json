{"id":"ancora","lemma":"ancora","pos":"adv","rank":75,"glosses":["still","again","more"],"ipa":"/anˈko.ra/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q652_%28ita%29-XANA000-ancora.wav","examples":[{"text":"Sei ancora lì?","en":"Are you still there?","audio":"https://tatoeba.org/en/audio/download/1004755","words":[{"g":"are","l":"essere"},null,{"g":"there"}]},{"text":"È ancora qui?","en":"Is he still here?","words":[{"g":"is","l":"essere"},null,{"g":"here"}]},{"text":"Posso vederti ancora?","en":"Can I see you again?","words":[{"g":"can, could","l":"potere"},null,null]},{"text":"Lo amo ancora.","en":"I still love it.","words":[{"g":"the / it"},{"g":"to love, to like","l":"amare"},null]},{"text":"OK, grazie ancora.","en":"OK, thanks again.","words":[null,{"g":"thanks, thank-you"},null]}]}