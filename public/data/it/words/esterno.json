{"id":"esterno","lemma":"esterno","pos":"adj","rank":1634,"glosses":["outside, outdoor; external, outer, outside, out","away"],"ipa":"/esˈtɛr.no/","forms":{"feminine":"esterna","masculinePlural":"esterni","femininePlural":"esterne"},"examples":[{"text":"Una guardia è all'esterno.","en":"A guard is outside.","words":[{"g":"a","l":"uno"},{"g":"guard"},{"g":"is","l":"essere"},null,null]},{"text":"Sono ancora all'esterno.","en":"I'm still outside.","words":[{"g":"am / are","l":"essere"},{"g":"still / again"},null,null]},{"text":"Darò un'occhiata all'esterno.","en":"I'm going to take a look outside.","words":[{"g":"to give","l":"dare"},{"g":"a"},{"g":"look, glance, gander"},null,null]},{"text":"I bambini dovrebbero giocare all'esterno.","en":"Children should play outside.","words":[{"g":"the","l":"la"},{"g":"child","l":"bambino"},{"g":"to owe","l":"dovere"},{"g":"to play a game"},null,null]},{"text":"Ho sentito delle voci all'esterno.","en":"I heard voices outside.","words":[{"g":"have","l":"avere"},{"g":"sincere"},null,{"g":"voice","l":"voce"},null,null]}]}