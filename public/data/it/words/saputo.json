{"id":"saputo","lemma":"saputo","pos":"adj","rank":522,"glosses":["knowledgeable","experienced; wise","that acts like a know-it-all"],"ipa":"/saˈpu.to/","forms":{"feminine":"saputa","masculinePlural":"saputi","femininePlural":"sapute"},"examples":[{"text":"Come hai saputo che è sposato?","en":"How did you know that he is married?","words":[{"g":"how / like"},{"g":"have","l":"avere"},null,{"g":"that / what"},{"g":"is","l":"essere"},{"g":"married, wedded"}]},{"text":"Come l'avete saputo?","en":"How did you know?","words":[{"g":"how / like"},null,{"g":"to have","l":"avere"},null]},{"text":"L'ho sempre saputo.","en":"I've always known that.","words":[null,{"g":"have","l":"avere"},{"g":"always"},null]},{"text":"Se solo l'avessi saputo prima!","en":"If I had only known before!","words":[{"g":"if"},{"g":"only, just"},null,{"g":"to have","l":"avere"},null,{"g":"before"}]},{"text":"Lo avessi saputo, non sarei venuto.","en":"Had I known that, I wouldn't have come.","words":[{"g":"the / it"},{"g":"to have","l":"avere"},null,{"g":"not"},{"g":"to be","l":"essere"},{"g":"coming"}]}]}