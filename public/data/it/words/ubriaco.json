{"id":"ubriaco","lemma":"ubriaco","pos":"adj","rank":1180,"glosses":["drunk (intoxicated)","blotto"],"ipa":"/u.briˈa.ko/","forms":{"feminine":"ubriaca","masculinePlural":"ubriachi","femininePlural":"ubriache"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q652_%28ita%29-DiplomaticBadger-ubriaco.wav","examples":[{"text":"Quanto sei ubriaco?","en":"How drunk are you?","words":[{"g":"how much, however much"},{"g":"are","l":"essere"},null]},{"text":"È ubriaco o pazzo.","en":"He is either drunk or mad.","words":[{"g":"is","l":"essere"},null,{"g":"or"},{"g":"crazy, insane, mad"}]},{"text":"Quanto siete ubriache?","en":"How drunk are you?","words":[{"g":"how much, however much"},{"g":"to be","l":"essere"},null]},{"text":"Siamo troppo ubriache.","en":"We're too drunk.","words":[{"g":"to be","l":"essere"},{"g":"too much"},null]},{"text":"Sono così ubriaco.","en":"I'm so drunk.","words":[{"g":"am / are","l":"essere"},{"g":"so"},null]}]}