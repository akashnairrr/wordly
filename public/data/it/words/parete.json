{"id":"parete","lemma":"parete","pos":"noun","rank":2961,"glosses":["wall","side, surface, wall (surface)","paries, wall"],"ipa":"/paˈre.te/","gender":"f","forms":{"plural":"pareti"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q652_%28ita%29-LangPao-parete.wav","examples":[{"text":"La mappa è sulla parete.","en":"The map is on the wall.","words":[{"g":"the / her"},{"g":"map"},{"g":"is","l":"essere"},{"g":"plant of the genus Sulla"},null]},{"text":"Odio il colore di queste pareti.","en":"I hate the color of these walls.","words":[{"g":"hatred"},{"g":"the"},{"g":"color/colour"},{"g":"of"},{"g":"this, this one, these","l":"questo"},null]},{"text":"Grazie per aver costruito questa parete.","en":"Thank you for building this wall.","words":[{"g":"thanks, thank-you"},{"g":"for"},null,{"g":"to build, construct","l":"costruire"},{"g":"this, this one, these","l":"questo"},null]},{"text":"C'è un orologio sulla parete.","en":"There is a clock on the wall.","words":[null,{"g":"is","l":"essere"},{"g":"a"},{"g":"clock, watch"},{"g":"plant of the genus Sulla"},null]},{"text":"Cosa c'è dietro alla parete?","en":"What's behind the wall?","words":[{"g":"thing"},null,{"g":"is","l":"essere"},{"g":"behind"},{"g":"to the"},null]}]}