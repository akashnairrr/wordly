{"id":"estremamente","lemma":"estremamente","pos":"adv","rank":1846,"glosses":["extremely, in the extreme"],"ipa":"/es.tre.maˈmen.te/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q652_%28ita%29-LangPao-estremamente.wav","examples":[{"text":"La stanza è estremamente piccola.","en":"The room is extremely small.","words":[{"g":"the / her"},{"g":"room"},{"g":"is","l":"essere"},null,{"g":"a small glass of beer"}]},{"text":"Questo è estremamente importante.","en":"This is extremely important.","words":[{"g":"this"},{"g":"is","l":"essere"},null,{"g":"important"}]},{"text":"Tutto è estremamente semplice.","en":"Everything is extremely simple.","words":[{"g":"everything, all"},{"g":"is","l":"essere"},null,{"g":"simple"}]},{"text":"Il gatto sembra estremamente felice.","en":"The cat seems extremely happy.","words":[{"g":"the"},{"g":"cat"},{"g":"to seem","l":"sembrare"},null,{"g":"happy"}]},{"text":"Lo fai estremamente bene.","en":"You do that extremely well.","words":[{"g":"the / it"},{"g":"to do","l":"fare"},null,{"g":"well"}]}]}