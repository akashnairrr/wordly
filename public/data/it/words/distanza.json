{"id":"distanza","lemma":"distanza","pos":"noun","rank":1234,"glosses":["distance, interval"],"ipa":"/disˈtan.t͡sa/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/33/LL-Q652_%28ita%29-LangPao-distanza.wav/LL-Q652_%28ita%29-LangPao-distanza.wav.mp3","gender":"f","forms":{"plural":"distanze"},"examples":[{"text":"Sono a tre ore di distanza.","en":"I'm three hours away.","words":[{"g":"am / are","l":"essere"},{"g":"to / at"},{"g":"three"},{"g":"now","l":"ora"},{"g":"of"},null]},{"text":"Mantieni le distanze.","en":"Keep your distance.","words":[{"g":"to maintain, to keep","l":"mantenere"},{"g":"the / to her"},null]},{"text":"Quella città è a due miglia di distanza.","en":"That town is two miles away.","words":[{"g":"that one","l":"quello"},{"g":"town, city"},{"g":"is","l":"essere"},null,null,{"g":"the Italian mile","l":"miglio"},{"g":"of"},null],"phrases":[[3,5,"\"for two\""]]},{"text":"Si tenga a distanza.","en":"Keep away.","words":[{"g":"oneself"},{"g":"to hold","l":"tenere"},{"g":"to / at"},null]},{"text":"Quanta distanza abbiamo coperto?","en":"How much distance have we covered?","words":[{"g":"how much, however much","l":"quanto"},null,{"g":"to have","l":"avere"},{"g":"covered"}]}]}