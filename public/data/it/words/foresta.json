{"id":"foresta","lemma":"foresta","pos":"noun","rank":1685,"glosses":["forest"],"ipa":"/foˈrɛs.ta/","gender":"f","forms":{"plural":"foreste"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q652_%28ita%29-LangPao-foresta.wav","examples":[{"text":"Siamo nella foresta.","en":"We're in the forest.","words":[{"g":"to be","l":"essere"},{"g":"in the"},null]},{"text":"Il vecchio si è perso nella foresta?","en":"Did the old man get lost in the forest?","words":[{"g":"the"},{"g":"old, outworn"},{"g":"oneself"},{"g":"is","l":"essere"},{"g":"lost, wasted"},{"g":"in the"},null]},{"text":"Gli animali nella foresta sono morti.","en":"The animals in the forest died off.","words":[{"g":"the / to him"},{"g":"animal","l":"animale"},{"g":"in the"},null,{"g":"am / are","l":"essere"},{"g":"death","l":"morte"}]},{"text":"Vive da solo nella foresta.","en":"He lives in the forest alone.","words":[{"g":"to live","l":"vivere"},null,null,{"g":"in the"},null],"phrases":[[1,3,"by oneself"]]},{"text":"Ci sono molti alberi in questa foresta.","en":"There are many trees in this forest.","words":[{"g":"us / there"},{"g":"am / are","l":"essere"},{"g":"much, very much, a lot","l":"molto"},{"g":"tree","l":"albero"},{"g":"in"},{"g":"this, this one, these","l":"questo"},null]}]}