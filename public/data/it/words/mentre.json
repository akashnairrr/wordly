{"id":"mentre","lemma":"mentre","pos":"conj","rank":217,"glosses":["while; as (during the same time that)","while; whilst; whereas (in contrast)"],"ipa":"/ˈmen.tre/","audio":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/76/LL-Q652_%28ita%29-LangPao-mentre.wav/LL-Q652_%28ita%29-LangPao-mentre.wav.mp3","examples":[{"text":"Ascolta mentre parlo.","en":"Listen while I talk.","words":[{"g":"to listen to","l":"ascoltare"},null,{"g":"to talk, to speak","l":"parlare"}]},{"text":"Cosa vuoi vedere mentre sei qui?","en":"What do you want to see while you're here?","words":[{"g":"thing"},{"g":"to want","l":"volere"},{"g":"to see"},null,{"g":"are","l":"essere"},{"g":"here"}]},{"text":"Ascolto la musica mentre lavoro.","en":"I listen to music while I work.","words":[{"g":"listening"},{"g":"the / her"},{"g":"music"},null,{"g":"work"}]},{"text":"Ha chiamato mentre ero fuori.","en":"She called while I was out.","words":[{"g":"has","l":"avere"},{"g":"to call","l":"chiamare"},null,{"g":"to be","l":"essere"},{"g":"out, outside, outwards"}]},{"text":"Non mi parli mentre sto lavorando.","en":"Don't talk to me while I'm working.","words":[{"g":"not"},{"g":"me / myself"},{"g":"to talk, to speak","l":"parlare"},null,{"g":"to stay, remain","l":"stare"},{"g":"to work","l":"lavorare"}]}]}