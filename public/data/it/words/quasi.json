{"id":"quasi","lemma":"quasi","pos":"conj","rank":250,"glosses":["as if"],"ipa":"/ˈkwa.zi/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/28/LL-Q652_%28ita%29-LangPao-quasi.wav","examples":[{"text":"Sei quasi qui?","en":"Are you almost here?","words":[{"g":"are","l":"essere"},null,{"g":"here"}]},{"text":"Facciamo questo quasi ogni settimana.","en":"We do this almost every week.","words":[{"g":"to do","l":"fare"},{"g":"this"},null,{"g":"each, every"},{"g":"week"}]},{"text":"Quasi ti credo.","en":"I almost believe you.","words":[null,{"g":"you"},{"g":"to believe","l":"credere"}]},{"text":"Sembri quasi felice.","en":"You seem almost happy.","words":[{"g":"to seem","l":"sembrare"},null,{"g":"happy"}]},{"text":"Faccio un bagno quasi ogni giorno.","en":"I take a bath almost every day.","words":[{"g":"to do","l":"fare"},{"g":"a"},{"g":"bath"},null,null,null],"phrases":[[4,6,"daily"]]}]}