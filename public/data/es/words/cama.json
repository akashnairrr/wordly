{"id":"cama","lemma":"cama","pos":"noun","rank":373,"glosses":["bed"],"ipa":"/ˈkama/","gender":"f","forms":{"plural":"camas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-AdrianAbdulBaha-cama.wav","formAudio":{"camas":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q1321_%28spa%29-Wikipedian-walker-camas.wav"},"examples":[{"text":"Vete a la cama.","en":"Go to bed.","audio":"https://tatoeba.org/en/audio/download/438696"},{"text":"Dígale a la muchacha que haga las camas.","en":"Tell the maid to make the beds.","audio":"https://tatoeba.org/en/audio/download/594642"},{"text":"Vuelve a la cama.","en":"Go back to bed.","audio":"https://tatoeba.org/en/audio/download/128162"},{"text":"Tenemos espacio para dos camas.","en":"We have space for two beds."},{"text":"Vámonos a la cama.","en":"Let's go to bed.","audio":"https://tatoeba.org/en/audio/download/441874"}]}