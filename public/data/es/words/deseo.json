{"id":"deseo","lemma":"deseo","pos":"noun","rank":641,"glosses":["desire, wish"],"ipa":"/deˈseo/","gender":"m","forms":{"plural":"deseos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-deseo.wav","examples":[{"text":"Les deseo suerte.","en":"I wish them luck.","audio":"https://tatoeba.org/en/audio/download/277417","words":[{"g":"them"},null,{"g":"luck, fortune"}]},{"text":"Te deseo buena suerte.","en":"I wish you good luck.","audio":"https://tatoeba.org/en/audio/download/453318","words":[{"g":"you"},null,null,null],"phrases":[[2,4,"good luck"]]},{"text":"Te deseo un feliz cumpleaños.","en":"I wish you a happy birthday.","audio":"https://tatoeba.org/en/audio/download/552737","words":[{"g":"you"},null,{"g":"a"},null,null],"phrases":[[3,5,"happy birthday"]]},{"text":"No vayas contra sus deseos.","en":"Don't go against his wishes.","words":[{"g":"no / not"},{"g":"what a ...","l":"vaya"},{"g":"antidote"},{"g":"his, her, its, their"},null]},{"text":"¿Cuál es tu deseo?","en":"What's your wish?","audio":"https://tatoeba.org/en/audio/download/444357","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null]}]}