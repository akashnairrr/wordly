{"id":"deseo","lemma":"deseo","pos":"noun","rank":641,"glosses":["desire, wish"],"ipa":"/deˈseo/","gender":"m","forms":{"plural":"deseos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-deseo.wav","examples":[{"text":"¿Cuál es tu deseo?","en":"What's your wish?","audio":"https://tatoeba.org/en/audio/download/444357","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"No te deseo.","en":"I don't want you.","audio":"https://tatoeba.org/en/audio/download/442500","words":[{"g":"no / not"},{"g":"you"},null]},{"text":"Sus deseos son órdenes.","en":"Your wish is my command.","words":[{"g":"his, her, its, their"},null,{"g":"to be","l":"ser"},{"g":"order","l":"orden"}]},{"text":"Eso es lo que yo deseo.","en":"That's what I wish.","audio":"https://tatoeba.org/en/audio/download/448846","words":[null,null,null,null,{"g":"I"},null],"phrases":[[0,2,"that's it"],[2,4,"what, that which"]]},{"text":"No vayas contra sus deseos.","en":"Don't go against his wishes.","words":[{"g":"no / not"},{"g":"what a ...","l":"vaya"},{"g":"antidote"},{"g":"his, her, its, their"},null]}]}