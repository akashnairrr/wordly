{"id":"deseo","lemma":"deseo","pos":"noun","rank":644,"glosses":["desire, wish"],"ipa":"/deˈseo/","gender":"m","forms":{"plural":"deseos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-deseo.wav","examples":[{"text":"¿Cuál es tu deseo?","en":"What's your wish?","audio":"https://tatoeba.org/en/audio/download/444357"},{"text":"Sus deseos son órdenes.","en":"Your wish is my command."},{"text":"Deseo que salga bien.","en":"I hope it goes well.","audio":"https://tatoeba.org/en/audio/download/298921"},{"text":"No vayas contra sus deseos.","en":"Don't go against his wishes."},{"text":"Te deseo buena suerte.","en":"I wish you good luck.","audio":"https://tatoeba.org/en/audio/download/453318"}]}