{"id":"casa","lemma":"casa","pos":"noun","rank":71,"glosses":["house"],"ipa":"/ˈkasa/","gender":"f","forms":{"plural":"casas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Precision27-casa.wav","formAudio":{"casas":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Eavqwiki-casas.wav"},"examples":[{"text":"Corre, vete a casa.","en":"Hurry home.","audio":"https://tatoeba.org/en/audio/download/438937"},{"text":"Esas casas son grandes.","en":"Those houses are big.","audio":"https://tatoeba.org/en/audio/download/455319"},{"text":"Tom está en casa.","en":"Tom's home.","audio":"https://tatoeba.org/en/audio/download/798964"},{"text":"Las casas se están quemando.","en":"The houses are burning.","audio":"https://tatoeba.org/en/audio/download/77770"},{"text":"¿Hay alguien en casa?","en":"Anyone home?","audio":"https://tatoeba.org/en/audio/download/438273"}]}