{"id":"tonto","lemma":"tonto","pos":"adj","rank":567,"glosses":["stupid","silly, foolish"],"ipa":"/ˈtonto/","forms":{"feminine":"tonta","masculinePlural":"tontos","femininePlural":"tontas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-Rodrigo5260-tonto.wav","examples":[{"text":"No hagas el tonto.","en":"Don't play dumb!","audio":"https://tatoeba.org/en/audio/download/637172"},{"text":"Es una pregunta tonta.","en":"That's a stupid question.","audio":"https://tatoeba.org/en/audio/download/552055"},{"text":"Ustedes dos son ridículamente tontos.","en":"You two are ridiculously silly."},{"text":"Él siempre hace preguntas tontas.","en":"He's always asking silly questions."},{"text":"Tom no es tonto.","en":"Tom is not dumb.","audio":"https://tatoeba.org/en/audio/download/800029"}]}