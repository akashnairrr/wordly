{"id":"metido","lemma":"metido","pos":"adj","rank":1228,"glosses":["nosy"],"ipa":"/meˈtido/","forms":{"feminine":"metida","masculinePlural":"metidos","femininePlural":"metidas"},"examples":[{"text":"Sé que estaba ahí metido.","en":"I know I packed it.","audio":"https://tatoeba.org/en/audio/download/448471"},{"text":"¿Qué se te ha metido?","en":"What's gotten into you?","audio":"https://tatoeba.org/en/audio/download/459465"},{"text":"Te has metido en una trampa.","en":"You've walked into a trap.","audio":"https://tatoeba.org/en/audio/download/803614"},{"text":"Él está ahora metido en un lío.","en":"He is in trouble now.","audio":"https://tatoeba.org/en/audio/download/453883"},{"text":"Él está metido en un gran lío.","en":"He is in great trouble.","audio":"https://tatoeba.org/en/audio/download/461518"}]}