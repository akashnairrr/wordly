{"id":"ciento","lemma":"ciento","pos":"noun","rank":1334,"glosses":["hundred (100 units of something)","hundreds (an indefinite number consisting of several hundred)"],"ipa":"/ˈθjento/","gender":"m","forms":{"plural":"cientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/08/LL-Q1321_%28spa%29-AdrianAbdulBaha-ciento.wav","examples":[{"text":"Ella tiene cientos de libros.","en":"She has hundreds of books.","audio":"https://tatoeba.org/en/audio/download/551559","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"book","l":"libro"}]},{"text":"Estoy de acuerdo al cien por ciento.","en":"I agree one hundred percent.","audio":"https://tatoeba.org/en/audio/download/586131","words":[{"g":"to be","l":"estar"},null,null,null,null,{"g":"for / by"},null],"phrases":[[1,3,"agreed"],[3,5,"one hundred percent"]]},{"text":"Hay cientos de libros en su estudio.","en":"There are hundreds of books in his studio.","audio":"https://tatoeba.org/en/audio/download/34794","words":[{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"book","l":"libro"},{"g":"in / on"},{"g":"his / her / your"},{"g":"study"}]},{"text":"Tom ha escrito cientos de canciones.","en":"Tom has written hundreds of songs.","words":[null,{"g":"to have","l":"haber"},{"g":"a writing, a writ"},null,{"g":"of / from"},{"g":"song","l":"canción"}]},{"text":"Más vale pájaro en mano que ciento volando.","en":"A bird in the hand is worth two in the bush.","words":[{"g":"more"},{"g":"a voucher"},{"g":"bird"},{"g":"in / on"},{"g":"hand"},{"g":"that"},null,{"g":"in flight"}]}]}