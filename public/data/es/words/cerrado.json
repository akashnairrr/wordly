{"id":"cerrado","lemma":"cerrado","pos":"adj","rank":1208,"glosses":["shut, closed","closed off (personality trait)"],"ipa":"/θeˈrado/","forms":{"feminine":"cerrada","masculinePlural":"cerrados","femininePlural":"cerradas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-Marreromarco-cerrado.wav","examples":[{"text":"El bar está cerrado.","en":"The bar is closed.","audio":"https://tatoeba.org/en/audio/download/449682"},{"text":"La tapa está cerrada.","en":"The lid is closed.","audio":"https://tatoeba.org/en/audio/download/449136"},{"text":"Los colegios están cerrados.","en":"Schools are closed.","audio":"https://tatoeba.org/en/audio/download/450566"},{"text":"Las puertas están cerradas.","en":"The doors are shut.","audio":"https://tatoeba.org/en/audio/download/501660"},{"text":"El banco está cerrado.","en":"The bank is closed.","audio":"https://tatoeba.org/en/audio/download/501419"}]}