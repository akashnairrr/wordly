{"id":"ojo","lemma":"ojo","pos":"noun","rank":270,"glosses":["eye","keyhole","caution"],"ipa":"/ˈoxo/","gender":"m","forms":{"plural":"ojos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-Rodelar-ojo.wav","formAudio":{"ojos":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-Eavqwiki-ojos.wav"},"examples":[{"text":"Tom guiñó el ojo.","en":"Tom winked.","audio":"https://tatoeba.org/en/audio/download/799676"},{"text":"¡Me duelen los ojos!","en":"My eyes hurt.","audio":"https://tatoeba.org/en/audio/download/519332"},{"text":"Tengo un ojo morado.","en":"I have a black eye.","audio":"https://tatoeba.org/en/audio/download/74675"},{"text":"Tiene los ojos rojos.","en":"His eyes are red.","audio":"https://tatoeba.org/en/audio/download/65114"},{"text":"Tenía un ojo vago.","en":"She had a lazy eye.","audio":"https://tatoeba.org/en/audio/download/930526"}]}