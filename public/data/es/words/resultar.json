"},{"g":"accident"}]},{"text":"Resulta que hoy es mi cumpleaños.","en":"It so happens that today is my birthday.","audio":"https://tatoeba.org/en/audio/download/689150","words":[null,{"g":"that"},{"g":"today, tonight"},{"g":"to be","l":"ser"},{"g":"my"},{"g":"birthday"}]},{"text":"Te resultará fácil.","en":"You'll find it easy.","audio":"https://tatoeba.org/en/audio/download/567688","words":[{"g":"you"},null,{"g":"easy, facile, simple"}]},{"text":"Alguien quizás podría resultar herido.","en":"Someone might get hurt.","audio":"https://tatoeba.org/en/audio/download/804445","words":[{"g":"someone, somebody"},null,{"g":"to be able to, can","l":"poder"},null,{"g":"hurt, injured"}]}]}