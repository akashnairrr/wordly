{"id":"primavera","lemma":"primavera","pos":"noun","rank":1704,"glosses":["spring (season)","year of age","primrose"],"ipa":"/pɾimaˈbeɾa/","gender":"f","forms":{"plural":"primaveras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f3/LL-Q1321_%28spa%29-AdrianAbdulBaha-primavera.wav","examples":[{"text":"Yo amo la primavera.","en":"I love spring.","audio":"https://tatoeba.org/en/audio/download/440330"},{"text":"Hoy ella cumple diez primaveras.","en":"Today she turns ten years old."},{"text":"Ha llegado la primavera.","en":"Spring has come.","audio":"https://tatoeba.org/en/audio/download/68116"},{"text":"La primavera ha llegado.","en":"Spring has come.","audio":"https://tatoeba.org/en/audio/download/442030"},{"text":"La primavera se acerca.","en":"Spring is coming.","audio":"https://tatoeba.org/en/audio/download/442883"}]}