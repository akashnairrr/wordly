{"id":"pieza","lemma":"pieza","pos":"noun","rank":1431,"glosses":["piece, part","room","ordinary"],"ipa":"/ˈpjeθa/","gender":"f","forms":{"plural":"piezas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Marreromarco-pieza.wav","examples":[{"text":"La pieza estaba cálida.","en":"The room was warm.","audio":"https://tatoeba.org/en/audio/download/449114"},{"text":"¿Cuantas piezas de equipaje tienes?","en":"How many pieces of baggage do you have?","audio":"https://tatoeba.org/en/audio/download/932981"},{"text":"¿Dónde está tu pieza?","en":"Where is your room?","audio":"https://tatoeba.org/en/audio/download/449657"},{"text":"Este rompecabezas tiene 500 piezas.","en":"This puzzle has 500 pieces."},{"text":"Ella limpió la pieza.","en":"She cleaned the room.","audio":"https://tatoeba.org/en/audio/download/735507"}]}