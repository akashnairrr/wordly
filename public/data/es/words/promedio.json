{"id":"promedio","lemma":"promedio","pos":"noun","rank":3421,"glosses":["average"],"ipa":"/pɾoˈmedjo/","gender":"m","forms":{"plural":"promedios"},"examples":[{"text":"Ellos son estudiantes promedio.","en":"They're average students.","words":[{"g":"they","l":"él"},{"g":"to be","l":"ser"},{"g":"student","l":"estudiante"},null]},{"text":"El promedio de 7,10 y 16 es 11.","en":"The average of 7, 10, and 16 is 11.","words":[{"g":"the"},null,{"g":"of / from"},{"g":"and"},{"g":"to be","l":"ser"}]},{"text":"¿Cuál es la temperatura promedio aquí?","en":"What's the average temperature here?","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"temperature"},null,{"g":"here"}]},{"text":"Duermo seis horas por día en promedio.","en":"I sleep six hours a day on average.","audio":"https://tatoeba.org/en/audio/download/581725","words":[{"g":"to sleep","l":"dormir"},{"g":"six"},{"g":"hour","l":"hora"},{"g":"for / by"},{"g":"day"},{"g":"in / on"},null]},{"text":"Una persona de inteligencia promedio lo entendería.","en":"A person with average intelligence would understand that.","audio":"https://tatoeba.org/en/audio/download/937821","words":[{"g":"a"},{"g":"person (an individual"},{"g":"of / from"},{"g":"intelligence"},null,{"g":"it / him"},{"g":"to understand","l":"entender"}]}]}