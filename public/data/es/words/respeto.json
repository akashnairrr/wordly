{"id":"respeto","lemma":"respeto","pos":"noun","rank":791,"glosses":["respect"],"ipa":"/resˈpeto/","gender":"m","forms":{"plural":"respetos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-Marreromarco-respeto.wav","examples":[{"text":"Tom, yo te respeto.","en":"I respect you, Tom.","audio":"https://tatoeba.org/en/audio/download/135890"},{"text":"Yo quiero tu respeto.","en":"I want your respect.","audio":"https://tatoeba.org/en/audio/download/448185"},{"text":"Yo quiero su respeto.","en":"I want your respect.","audio":"https://tatoeba.org/en/audio/download/448186"},{"text":"Yo quiero vuestro respeto.","en":"I want your respect.","audio":"https://tatoeba.org/en/audio/download/448188"},{"text":"Tienes que mostrar respeto.","en":"You need to show respect.","audio":"https://tatoeba.org/en/audio/download/567298"}]}