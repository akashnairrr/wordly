{"id":"vivido","lemma":"vivido","pos":"adj","rank":1675,"glosses":["living, existing","worldly","vivid"],"ipa":"/biˈbido/","forms":{"feminine":"vivida","masculinePlural":"vividos","femininePlural":"vividas"},"examples":[{"text":"¿Has vivido aquí antes?","en":"Did you live here before?","audio":"https://tatoeba.org/en/audio/download/69225"},{"text":"He vivido aquí mucho tiempo.","en":"I have lived here a long time.","audio":"https://tatoeba.org/en/audio/download/355260"},{"text":"Nunca he vivido en el extranjero.","en":"I've never lived abroad.","audio":"https://tatoeba.org/en/audio/download/871899"},{"text":"Ha vivido allí toda su vida.","en":"He's lived there all his life.","audio":"https://tatoeba.org/en/audio/download/641792"},{"text":"He vivido aquí toda mi vida.","en":"I've lived here my entire life.","audio":"https://tatoeba.org/en/audio/download/567766"}]}