{"id":"cura","lemma":"cura","pos":"noun","rank":1367,"glosses":["cure (something that restores good health)","drunkenness"],"ipa":"/ˈkuɾa/","gender":"f","forms":{"plural":"curas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-cura.wav","examples":[{"text":"No hay cura.","en":"There's no cure.","audio":"https://tatoeba.org/en/audio/download/442105","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null]},{"text":"El tiempo lo cura todo.","en":"Time heals all wounds.","audio":"https://tatoeba.org/en/audio/download/461514","words":[{"g":"the"},{"g":"time"},{"g":"it / him"},null,{"g":"all"}]},{"text":"Mi hermano se ha hecho cura.","en":"My brother has become a priest.","audio":"https://tatoeba.org/en/audio/download/522005","words":[{"g":"my"},{"g":"brother"},{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"done, completed"},null]},{"text":"El cura nos bendijo.","en":"The priest blessed us.","audio":"https://tatoeba.org/en/audio/download/636484","words":[{"g":"the"},null,{"g":"us"},{"g":"to bless","l":"bendecir"}]},{"text":"No hay cura para la estupidez.","en":"There's no cure for stupidity.","audio":"https://tatoeba.org/en/audio/download/590016","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"for"},{"g":"the / her"},{"g":"stupidity"}]}]}