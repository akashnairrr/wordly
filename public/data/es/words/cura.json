{"id":"cura","lemma":"cura","pos":"noun","rank":1370,"glosses":["cure (something that restores good health)","drunkenness"],"ipa":"/ˈkuɾa/","gender":"f","forms":{"plural":"curas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-cura.wav","examples":[{"text":"El cura nos bendijo.","en":"The priest blessed us.","audio":"https://tatoeba.org/en/audio/download/636484"},{"text":"Los curas no tienen esposas.","en":"Priests don't have wives."},{"text":"El tiempo lo cura todo.","en":"Time heals all wounds.","audio":"https://tatoeba.org/en/audio/download/461514"},{"text":"Tú no pareces un cura.","en":"You don't look like a priest.","audio":"https://tatoeba.org/en/audio/download/642053"},{"text":"No hay cura para la estupidez.","en":"There's no cure for stupidity.","audio":"https://tatoeba.org/en/audio/download/590016"}]}