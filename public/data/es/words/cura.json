{"id":"cura","lemma":"cura","pos":"noun","rank":1367,"glosses":["cure (something that restores good health)","drunkenness"],"ipa":"/ˈkuɾa/","gender":"f","forms":{"plural":"curas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-cura.wav","examples":[{"text":"Tú no pareces un cura.","en":"You don't look like a priest.","audio":"https://tatoeba.org/en/audio/download/642053","words":[{"g":"you"},{"g":"no / not"},{"g":"to seem, to see fit","l":"parecer"},{"g":"a"},null]},{"text":"Mi hermano se ha hecho cura.","en":"My brother has become a priest.","audio":"https://tatoeba.org/en/audio/download/522005","words":[{"g":"my"},{"g":"brother"},{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"done, completed"},null]},{"text":"Tom es cura.","en":"Tom is a priest.","audio":"https://tatoeba.org/en/audio/download/79810","words":[null,{"g":"to be","l":"ser"},null]},{"text":"Los curas no tienen esposas.","en":"Priests don't have wives.","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"handcuffs"}]},{"text":"El tiempo lo cura todo.","en":"Time heals all wounds.","audio":"https://tatoeba.org/en/audio/download/461514","words":[{"g":"the"},{"g":"time"},{"g":"it / him"},null,{"g":"all"}]}]}