{"id":"acto","lemma":"acto","pos":"noun","rank":1258,"glosses":["act (something done)","act","ceremony, function"],"ipa":"/ˈaɡto/","gender":"m","forms":{"plural":"actos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-AdrianAbdulBaha-acto.wav","examples":[{"text":"Fue un acto de valor.","en":"It was an act of courage.","audio":"https://tatoeba.org/en/audio/download/515925"},{"text":"Me arrepiento de mis actos.","en":"I regret my actions.","audio":"https://tatoeba.org/en/audio/download/630270"},{"text":"El suicidio es un acto de desesperación.","en":"Suicide is a desperate act.","audio":"https://tatoeba.org/en/audio/download/703746"},{"text":"No me arrepiento de mis actos.","en":"I don't regret my actions.","audio":"https://tatoeba.org/en/audio/download/705829"},{"text":"Ahora va a empezar el tercer acto.","en":"The third act is about to begin.","audio":"https://tatoeba.org/en/audio/download/594609"}]}