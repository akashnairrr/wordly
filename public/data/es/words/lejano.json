{"id":"lejano","lemma":"lejano","pos":"adj","rank":3642,"glosses":["far, faraway"],"ipa":"/leˈxano/","forms":{"feminine":"lejana","masculinePlural":"lejanos","femininePlural":"lejanas"},"order":3645,"audio":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-Marreromarco-lejano.wav","examples":[{"text":"Vi una luz lejana.","en":"I saw a light far away.","audio":"https://tatoeba.org/en/audio/download/458610","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"light"},null]},{"text":"Tomás es pariente lejano mío.","en":"Tom is a distant relative of mine.","words":[{"g":"to take","l":"tomar"},{"g":"to be","l":"ser"},{"g":"relative, relation"},null,{"g":"mine"}]},{"text":"El viejo profesor empezó a hablar de los buenos días ya lejanos.","en":"The old teacher began to talk about the good old days.","audio":"https://tatoeba.org/en/audio/download/693058","words":[{"g":"the"},{"g":"old person"},{"g":"professor"},{"g":"to start","l":"empezar"},{"g":"to"},{"g":"to talk"},{"g":"of / from"},{"g":"the / them"},null,null,{"g":"now"},null],"phrases":[[8,10,"good morning"]]}]}