{"id":"garganta","lemma":"garganta","pos":"noun","rank":1697,"glosses":["throat","gorge"],"ipa":"/ɡaɾˈɡanta/","gender":"f","forms":{"plural":"gargantas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-AdrianAbdulBaha-garganta.wav","examples":[{"text":"Me duele la garganta.","en":"My throat hurts.","audio":"https://tatoeba.org/en/audio/download/453076"},{"text":"Mi garganta está seca.","en":"My throat is dry.","audio":"https://tatoeba.org/en/audio/download/443026"},{"text":"Tengo dolor de garganta.","en":"I have a sore throat.","audio":"https://tatoeba.org/en/audio/download/519640"},{"text":"¿Te duele la garganta?","en":"Does your throat hurt?","audio":"https://tatoeba.org/en/audio/download/454698"},{"text":"Él se aclaró la garganta.","en":"He cleared his throat.","audio":"https://tatoeba.org/en/audio/download/454066"}]}