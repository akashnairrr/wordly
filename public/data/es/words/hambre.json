{"id":"hambre","lemma":"hambre","pos":"noun","rank":568,"glosses":["hunger"],"ipa":"/ˈambɾe/","gender":"f","forms":{"plural":"hambres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-AdrianAbdulBaha-hambre.wav","examples":[{"text":"¡Me muero de hambre!","en":"I'm starved.","audio":"https://tatoeba.org/en/audio/download/1530"},{"text":"Estoy muerto de hambre.","en":"I'm starved.","audio":"https://tatoeba.org/en/audio/download/39062"},{"text":"Yo no tengo hambre.","en":"I'm not hungry.","audio":"https://tatoeba.org/en/audio/download/506447"},{"text":"Estamos muertos de hambre.","en":"We're famished.","audio":"https://tatoeba.org/en/audio/download/412505"},{"text":"Nos morimos de hambre.","en":"We're starving.","audio":"https://tatoeba.org/en/audio/download/435847"}]}