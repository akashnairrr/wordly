{"id":"hambre","lemma":"hambre","pos":"noun","rank":565,"glosses":["hunger"],"ipa":"/ˈambɾe/","gender":"f","forms":{"plural":"hambres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-AdrianAbdulBaha-hambre.wav","examples":[{"text":"¿Quién tiene hambre?","en":"Who's hungry?","audio":"https://tatoeba.org/en/audio/download/437947","words":[{"g":"who"},{"g":"to have","l":"tener"},null]},{"text":"¿Ahora tienes hambre?","en":"Are you hungry now?","audio":"https://tatoeba.org/en/audio/download/35738","words":[{"g":"now"},{"g":"to have","l":"tener"},null]},{"text":"Si tienes hambre, come algo.","en":"If you're hungry, have something to eat.","audio":"https://tatoeba.org/en/audio/download/703918","words":[{"g":"if, whether"},{"g":"to have","l":"tener"},null,{"g":"to eat","l":"comer"},{"g":"something, anything"}]},{"text":"Ahora no tengo hambre.","en":"I'm not hungry now.","audio":"https://tatoeba.org/en/audio/download/65189","words":[{"g":"now"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Me dijo que tenía hambre.","en":"He told me that he was hungry.","audio":"https://tatoeba.org/en/audio/download/642275","words":[{"g":"me"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to have","l":"tener"},null]}]}