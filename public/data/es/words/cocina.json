{"id":"cocina","lemma":"cocina","pos":"noun","rank":695,"glosses":["kitchen","stove, cooker, range","cuisine"],"ipa":"/koˈθina/","gender":"f","forms":{"plural":"cocinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-cocina.wav","formAudio":{"cocinas":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-Marreromarco-cocinas.wav"},"examples":[{"text":"Ella cocina para él.","en":"She cooks for him.","audio":"https://tatoeba.org/en/audio/download/444318"},{"text":"¿Por qué nunca cocinas?","en":"Why don't you ever cook?"},{"text":"Estoy en la cocina.","en":"I'm in the kitchen.","audio":"https://tatoeba.org/en/audio/download/448805"},{"text":"Cubre la olla mientras cocinas.","en":"Cover the pot while you cook."},{"text":"Mi esposa cocina bien.","en":"My wife cooks well.","audio":"https://tatoeba.org/en/audio/download/450525"}]}