{"id":"encanto","lemma":"encanto","pos":"noun","rank":1971,"glosses":["charm, captivation","spell, enchantment","apparition, otherworldly entity"],"ipa":"/enˈkanto/","gender":"m","forms":{"plural":"encantos"},"order":2004,"audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-AdrianAbdulBaha-encanto.wav","examples":[{"text":"Las fotos en blanco y negro tienen un encanto especial.","en":"Black and white photos have a special charm.","audio":"https://tatoeba.org/en/audio/download/692441","words":[{"g":"the / them"},{"g":"photo, photograph","l":"foto"},null,null,null,null,{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"special"}],"phrases":[[2,6,"in black and white"]]},{"text":"¡Qué encanto!","en":"How cute!","audio":"https://tatoeba.org/en/audio/download/38584","words":[{"g":"what"},null]},{"text":"La vieja cabaña tiene un cierto encanto.","en":"The old cottage has a certain charm about it.","words":[null,null,{"g":"cabin, cottage, hut"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"a certain, a specific"},null],"phrases":[[0,2,"A three-note melody"]]}]}