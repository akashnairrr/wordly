{"id":"descuidado","lemma":"descuidado","pos":"adj","rank":4778,"glosses":["neglected","careless, sloppy, slipshod","remiss, neglectful, lax"],"ipa":"/deskwiˈdado/","forms":{"feminine":"descuidada","masculinePlural":"descuidados","femininePlural":"descuidadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-descuidado.wav","examples":[{"text":"Él es descuidado en todo.","en":"He is careless in everything.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"all"}]},{"text":"¡No seas tan descuidado!","en":"Don't be so careless!","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"so, as"},null]},{"text":"No seas tan descuidado en tu trabajo.","en":"Don't be careless in your work.","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"so, as"},null,{"g":"in / on"},{"g":"your"},{"g":"work, job"}]},{"text":"Fue descuidado de tu parte perder la llave.","en":"It was careless of you to lose the key.","words":[{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"your"},{"g":"part"},{"g":"to lose"},{"g":"the / her"},{"g":"key"}]},{"text":"La conducción descuidada provoca accidentes.","en":"Careless driving causes accidents.","audio":"https://tatoeba.org/en/audio/download/538143","words":[{"g":"the / her"},{"g":"driving"},null,{"g":"to cause or provoke","l":"provocar"},{"g":"accident","l":"accidente"}]}]}