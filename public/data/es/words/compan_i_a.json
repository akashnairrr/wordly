{"id":"compan_i_a","lemma":"compañía","pos":"noun","rank":541,"glosses":["company, enterprise, business, firm"],"ipa":"/kompaˈɲia/","gender":"f","forms":{"plural":"compañías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-Florenciac-compa%C3%B1%C3%ADa.wav","examples":[{"text":"Me gusta la compañía.","en":"I like the company.","audio":"https://tatoeba.org/en/audio/download/422557"},{"text":"Intenta evitar las malas compañías.","en":"Try to avoid bad company.","audio":"https://tatoeba.org/en/audio/download/46252"},{"text":"Disfruto de tu compañía.","en":"I enjoy being with you.","audio":"https://tatoeba.org/en/audio/download/422561"},{"text":"Las compañías de servivios suministran electricidad.","en":"Utility companies supply electricity."},{"text":"Necesito una pequeña compañía.","en":"I need a little company.","audio":"https://tatoeba.org/en/audio/download/804278"}]}