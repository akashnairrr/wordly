{"id":"hombro","lemma":"hombro","pos":"noun","rank":1929,"glosses":["shoulder","shoulder (verge to the side of a road)"],"ipa":"/ˈombɾo/","gender":"m","forms":{"plural":"hombros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-AdrianAbdulBaha-hombro.wav","examples":[{"text":"Me duele el hombro derecho.","en":"My right shoulder hurts.","audio":"https://tatoeba.org/en/audio/download/594173","words":[{"g":"me"},{"g":"to hurt","l":"doler"},{"g":"the"},null,{"g":"right"}]},{"text":"Ella le tocó el hombro.","en":"She touched him on the shoulder.","audio":"https://tatoeba.org/en/audio/download/354103","words":[{"g":"she"},{"g":"him / her"},{"g":"to touch","l":"tocar"},{"g":"the"},null]},{"text":"Él tiene hombros anchos.","en":"He has broad shoulders.","audio":"https://tatoeba.org/en/audio/download/461576","words":[{"g":"he"},{"g":"to have","l":"tener"},null,{"g":"wide","l":"ancho"}]},{"text":"Él puso su mano sobre mi hombro.","en":"He rested his hand on my shoulder.","audio":"https://tatoeba.org/en/audio/download/937787","words":[{"g":"he"},{"g":"to put, to place","l":"poner"},{"g":"his / her / your"},{"g":"hand"},{"g":"envelope"},{"g":"my"},null]},{"text":"Ella tiene el pelo hasta los hombros.","en":"She has shoulder-length hair.","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"the"},{"g":"hair"},{"g":"until"},{"g":"the / them"},null]}]}