{"id":"hombro","lemma":"hombro","pos":"noun","rank":1930,"glosses":["shoulder","shoulder (verge to the side of a road)"],"ipa":"/ˈombɾo/","gender":"m","forms":{"plural":"hombros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-AdrianAbdulBaha-hombro.wav","examples":[{"text":"Me duele el hombro.","en":"My shoulder hurts.","audio":"https://tatoeba.org/en/audio/download/47739","words":[{"g":"me"},null,{"g":"the"},null]},{"text":"Me puso la mano en el hombro.","en":"He placed his hand on my shoulder.","audio":"https://tatoeba.org/en/audio/download/568225","words":[{"g":"me"},{"g":"to put, to place","l":"poner"},{"g":"the / her"},{"g":"hand"},{"g":"in / on"},{"g":"the"},null]},{"text":"Ella tiene el pelo hasta los hombros.","en":"She has shoulder-length hair.","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"the"},{"g":"hair"},{"g":"until"},{"g":"the / them"},null]},{"text":"Él puso su mano sobre mi hombro.","en":"He rested his hand on my shoulder.","audio":"https://tatoeba.org/en/audio/download/937787","words":[{"g":"he"},{"g":"to put, to place","l":"poner"},{"g":"his / her / your"},{"g":"hand"},{"g":"envelope"},{"g":"my"},null]},{"text":"El pelo le llega a los hombros.","en":"Her hair comes to her shoulders.","words":[{"g":"the"},{"g":"hair"},{"g":"him / her"},{"g":"to arrive, get","l":"llegar"},{"g":"to"},{"g":"the / them"},null]}]}