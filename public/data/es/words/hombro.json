{"id":"hombro","lemma":"hombro","pos":"noun","rank":1933,"glosses":["shoulder","shoulder (verge to the side of a road)"],"ipa":"/ˈombɾo/","gender":"m","forms":{"plural":"hombros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-AdrianAbdulBaha-hombro.wav","examples":[{"text":"Me duele el hombro.","en":"My shoulder hurts.","audio":"https://tatoeba.org/en/audio/download/47739"},{"text":"Él tiene hombros anchos.","en":"He has broad shoulders.","audio":"https://tatoeba.org/en/audio/download/461576"},{"text":"Me tocó el hombro.","en":"He touched my shoulder.","audio":"https://tatoeba.org/en/audio/download/637100"},{"text":"Tom se encogió de hombros.","en":"Tom shrugged.","audio":"https://tatoeba.org/en/audio/download/799639"},{"text":"Me duele el hombro derecho.","en":"My right shoulder hurts.","audio":"https://tatoeba.org/en/audio/download/594173"}]}