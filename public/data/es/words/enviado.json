{"id":"enviado","lemma":"enviado","pos":"noun","rank":1301,"glosses":["delegate, envoy, emissary"],"ipa":"/emˈbjado/","gender":"m","forms":{"plural":"enviados","feminine":"enviada","femininePlural":"enviadas"},"examples":[{"text":"Mi madre me ha enviado un regalo de cumpleaños.","en":"My mother sent me a birthday present.","audio":"https://tatoeba.org/en/audio/download/764972","words":[{"g":"my"},{"g":"mother"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"a"},{"g":"present, gift"},{"g":"of / from"},{"g":"birthday"}]},{"text":"Todos fueron enviados a casa.","en":"Everybody got sent back home.","words":[{"g":"all","l":"todo"},{"g":"to go","l":"ir"},null,null,null],"phrases":[[3,5,"home"]]},{"text":"No recuerdo haber enviado este mensaje de texto.","en":"I don't remember sending that text message.","audio":"https://tatoeba.org/en/audio/download/518902","words":[{"g":"no / not"},{"g":"memory"},{"g":"to have"},null,{"g":"this"},null,null,null],"phrases":[[5,8,"text message"]]},{"text":"Los libros ya fueron enviados a los alumnos.","en":"The books were delivered to the students.","audio":"https://tatoeba.org/en/audio/download/770020","words":[{"g":"the / them"},{"g":"book","l":"libro"},{"g":"now"},{"g":"to go","l":"ir"},null,{"g":"to"},{"g":"the / them"},{"g":"pupil","l":"alumno"}]},{"text":"No debí haber enviado ese e-mail.","en":"I shouldn't have sent that email.","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"that"},{"g":"and"},{"g":"email"}]}]}