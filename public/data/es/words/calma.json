{"id":"calma","lemma":"calma","pos":"noun","rank":779,"glosses":["calm, stillness, peacefulness","tranquility, peace and quiet"],"ipa":"/ˈkalma/","gender":"f","forms":{"plural":"calmas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-Rodrigo5260-calma.wav","examples":[{"text":"Todo está en calma.","en":"All is quiet.","audio":"https://tatoeba.org/en/audio/download/438322"},{"text":"Tom esperó con calma.","en":"Tom waited calmly.","audio":"https://tatoeba.org/en/audio/download/799527"},{"text":"Debemos mantener la calma.","en":"We must keep calm.","audio":"https://tatoeba.org/en/audio/download/450356"},{"text":"Intentad mantener la calma.","en":"Try to remain calm.","audio":"https://tatoeba.org/en/audio/download/850211"},{"text":"Deberías actuar con calma.","en":"You should act more calmly.","audio":"https://tatoeba.org/en/audio/download/586533"}]}