{"id":"miel","lemma":"miel","pos":"noun","rank":1599,"glosses":["honey"],"ipa":"/ˈmjel/","gender":"f","forms":{"plural":"mieles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-AdrianAbdulBaha-miel.wav","formAudio":{"mieles":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1321_%28spa%29-Rdrg109-mieles.wav"},"examples":[{"text":"Me gusta la miel.","en":"I like honey.","audio":"https://tatoeba.org/en/audio/download/438171"},{"text":"Las abejas hacen miel.","en":"Bees make honey.","audio":"https://tatoeba.org/en/audio/download/441358"},{"text":"Él usó mucha miel.","en":"He used a lot of honey.","audio":"https://tatoeba.org/en/audio/download/735568"},{"text":"Estamos de luna de miel.","en":"We're honeymooning.","audio":"https://tatoeba.org/en/audio/download/501339"},{"text":"Las abejas nos dan miel.","en":"Bees provide us with honey.","audio":"https://tatoeba.org/en/audio/download/705819"}]}