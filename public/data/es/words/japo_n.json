{"id":"japo_n","lemma":"japón","pos":"adj","rank":1951,"glosses":["Japanese"],"forms":{"feminine":"japona","masculinePlural":"japones","femininePlural":"japonas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Millars-Jap%C3%B3n.wav","examples":[{"text":"Esto es el Japón.","en":"This is Japan.","audio":"https://tatoeba.org/en/audio/download/501083"},{"text":"Japón queda en Asia.","en":"Japan is in Asia.","audio":"https://tatoeba.org/en/audio/download/442665"},{"text":"Japón está en Asia.","en":"Japan is in Asia.","audio":"https://tatoeba.org/en/audio/download/104110"},{"text":"Yo vengo de Japón.","en":"I come from Japan.","audio":"https://tatoeba.org/en/audio/download/444273"},{"text":"Ella volvió a Japón.","en":"She returned to Japan.","audio":"https://tatoeba.org/en/audio/download/637016"}]}