{"id":"lengua","lemma":"lengua","pos":"noun","rank":1268,"glosses":["tongue (organ)","language (a body of words, and set of methods of combining them (called a grammar), understood by a community and used as a form of communication)","Spanish (subject taught in schools)"],"ipa":"/ˈlenɡwa/","gender":"f","forms":{"plural":"lenguas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-Rodelar-lengua.wav","examples":[{"text":"¿En qué lengua piensas?","en":"What language do you think in?","audio":"https://tatoeba.org/en/audio/download/845841","words":[{"g":"in / on"},{"g":"what"},null,{"g":"to think, ponder","l":"pensar"}]},{"text":"A ver su lengua.","en":"Let me see your tongue.","audio":"https://tatoeba.org/en/audio/download/458631","words":[null,null,{"g":"his / her / your"},null],"phrases":[[0,2,"show me!"]]},{"text":"¿Qué lenguas sabes?","en":"What languages do you know?","words":[{"g":"what"},null,{"g":"to know, to understand","l":"saber"}]},{"text":"Él habla cinco lenguas.","en":"He can speak five languages.","audio":"https://tatoeba.org/en/audio/download/35377","words":[{"g":"he"},{"g":"speech"},{"g":"a five"},null]},{"text":"Conozco tu lengua.","en":"I know your language.","audio":"https://tatoeba.org/en/audio/download/800925","words":[{"g":"to know","l":"conocer"},{"g":"your"},null]}]}