{"id":"ama","lemma":"ama","pos":"noun","rank":876,"glosses":["lady of the house","proprietress","landlady"],"ipa":"/ˈama/","gender":"f","forms":{"plural":"amas","masculine":"amo","masculinePlural":"amos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-AdrianAbdulBaha-ama.wav","formAudio":{"amas":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-Marreromarco-amas.wav","amo":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q1321_%28spa%29-AdrianAbdulBaha-amo.wav"},"examples":[{"text":"Tom ama a Mary.","en":"Tom loves Mary.","audio":"https://tatoeba.org/en/audio/download/101560"},{"text":"Di que me amas.","en":"Say you love me.","audio":"https://tatoeba.org/en/audio/download/442117"},{"text":"Yo sí te amo.","en":"I do love you.","audio":"https://tatoeba.org/en/audio/download/440052"},{"text":"Los perros tienen amos, los gatos, sirvientes.","en":"Dogs have masters. Cats have servants."},{"text":"Él ama los trenes.","en":"He loves trains.","audio":"https://tatoeba.org/en/audio/download/441518"}]}