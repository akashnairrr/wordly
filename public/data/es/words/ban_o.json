{"id":"ban_o","lemma":"baño","pos":"noun","rank":494,"glosses":["bath (act of taking a bath)","bathroom","toilet"],"ipa":"/ˈbaɲo/","gender":"m","forms":{"plural":"baños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-AdrianAbdulBaha-ba%C3%B1o.wav","examples":[{"text":"Estoy en el baño.","en":"I'm in the toilet.","audio":"https://tatoeba.org/en/audio/download/534678"},{"text":"Esta casa tiene dos baños.","en":"This house has two bathrooms.","audio":"https://tatoeba.org/en/audio/download/590192"},{"text":"¿Está listo el baño?","en":"Is the bath ready?","audio":"https://tatoeba.org/en/audio/download/444384"},{"text":"Esta casa tiene tres baños.","en":"This house has three bathrooms.","audio":"https://tatoeba.org/en/audio/download/600194"},{"text":"El baño está listo.","en":"The bath is ready.","audio":"https://tatoeba.org/en/audio/download/450022"}]}