{"id":"lleno","lemma":"lleno","pos":"adj","rank":787,"glosses":["full"],"ipa":"/ˈʝeno/","forms":{"feminine":"llena","masculinePlural":"llenos","femininePlural":"llenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Rodelar-lleno.wav","formAudio":{"llena":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Emanuelps27-llena.wav"},"examples":[{"text":"El mundo está lleno de problemas.","en":"The world is full of problems.","audio":"https://tatoeba.org/en/audio/download/518772","words":[{"g":"the"},{"g":"world, earth"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"problem","l":"problema"}]},{"text":"Esta caja está llena de libros.","en":"This box is full of books.","audio":"https://tatoeba.org/en/audio/download/594974","words":[{"g":"this","l":"este"},{"g":"box, case"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"book","l":"libro"}]},{"text":"El niño estaba lleno.","en":"The boy was full.","audio":"https://tatoeba.org/en/audio/download/444140","words":[null,null,{"g":"to be","l":"estar"},null],"phrases":[[0,2,"the Christ child"]]},{"text":"La habitación estaba llena de humo.","en":"The room was full of smoke.","audio":"https://tatoeba.org/en/audio/download/590179","words":[{"g":"the / her"},{"g":"room"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"smoke"}]},{"text":"Lo lamento, hoy estamos llenos.","en":"Sorry, we're full today.","audio":"https://tatoeba.org/en/audio/download/58173","words":[{"g":"it / him"},{"g":"lament"},{"g":"today, tonight"},{"g":"to be","l":"estar"},null]}]}