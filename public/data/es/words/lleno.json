{"id":"lleno","lemma":"lleno","pos":"adj","rank":787,"glosses":["full"],"ipa":"/ˈʝeno/","forms":{"feminine":"llena","masculinePlural":"llenos","femininePlural":"llenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Rodelar-lleno.wav","formAudio":{"llena":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Emanuelps27-llena.wav"},"examples":[{"text":"El mundo está lleno de problemas.","en":"The world is full of problems.","audio":"https://tatoeba.org/en/audio/download/518772","words":[{"g":"the"},{"g":"world, earth"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"problem","l":"problema"}]},{"text":"El niño estaba lleno.","en":"The boy was full.","audio":"https://tatoeba.org/en/audio/download/444140","words":[null,null,{"g":"to be","l":"estar"},null],"phrases":[[0,2,"the Christ child"]]},{"text":"Lo lamento, hoy estamos llenos.","en":"Sorry, we're full today.","audio":"https://tatoeba.org/en/audio/download/58173","words":[{"g":"it / him"},{"g":"lament"},{"g":"today, tonight"},{"g":"to be","l":"estar"},null]},{"text":"No, gracias, estoy lleno.","en":"No thank you, I'm full.","audio":"https://tatoeba.org/en/audio/download/553866","words":[{"g":"no / not"},{"g":"thank you, thanks"},{"g":"to be","l":"estar"},null]},{"text":"El parque estaba lleno de gente.","en":"The park was full of people.","audio":"https://tatoeba.org/en/audio/download/330628","words":[{"g":"the"},{"g":"park"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"people"}]}]}