{"id":"sabio","lemma":"sabio","pos":"adj","rank":1843,"glosses":["learned","prudent; wise"],"ipa":"/ˈsabjo/","forms":{"feminine":"sabia","masculinePlural":"sabios","femininePlural":"sabias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Marreromarco-sabio.wav","examples":[{"text":"Fue una sabia decisión.","en":"It was a wise decision.","audio":"https://tatoeba.org/en/audio/download/460840","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"decision"}]},{"text":"Él es un hombre sabio.","en":"He is a man of wisdom.","audio":"https://tatoeba.org/en/audio/download/636609","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},null]},{"text":"Es mayor, pero no más sabio.","en":"He's older, but no wiser.","audio":"https://tatoeba.org/en/audio/download/639758","words":[{"g":"to be","l":"ser"},{"g":"of age"},{"g":"but"},null,null,null],"phrases":[[3,5,"only, just"]]},{"text":"¿Quién es la persona más sabia que conoces?","en":"Who is the wisest person you know?","audio":"https://tatoeba.org/en/audio/download/687616","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"person (an individual"},{"g":"more"},null,{"g":"that"},{"g":"to know","l":"conocer"}]},{"text":"No todos los hombres son sabios.","en":"Not all men are wise.","words":[{"g":"no / not"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"man","l":"hombre"},{"g":"to be","l":"ser"},null]}]}