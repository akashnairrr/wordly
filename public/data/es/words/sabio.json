{"id":"sabio","lemma":"sabio","pos":"adj","rank":1846,"glosses":["learned","prudent; wise"],"ipa":"/ˈsabjo/","forms":{"feminine":"sabia","masculinePlural":"sabios","femininePlural":"sabias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Marreromarco-sabio.wav","examples":[{"text":"Eres muy sabio, Tomás.","en":"You're very wise, Tom.","audio":"https://tatoeba.org/en/audio/download/461659"},{"text":"Fue una sabia decisión.","en":"It was a wise decision.","audio":"https://tatoeba.org/en/audio/download/460840"},{"text":"No todos los hombres son sabios.","en":"Not all men are wise."},{"text":"Él es un hombre sabio.","en":"He is a man of wisdom.","audio":"https://tatoeba.org/en/audio/download/636609"},{"text":"Tomaste una sabia decisión.","en":"You made a wise decision.","audio":"https://tatoeba.org/en/audio/download/740948"}]}