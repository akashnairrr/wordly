{"id":"juez","lemma":"juez","pos":"noun","rank":807,"glosses":["judge","umpire; referee; official"],"ipa":"/ˈxweθ/","gender":"mf","forms":{"plural":"jueces","feminine":"juez","femininePlural":"jueces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-AdrianAbdulBaha-juez.wav","examples":[{"text":"No me gustaría ser juez.","en":"I wouldn't like being a judge.","audio":"https://tatoeba.org/en/audio/download/553669","words":[{"g":"no / not"},{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"to be"},null]},{"text":"Ambos son unos jueces muy competentes.","en":"They are both very competent judges.","audio":"https://tatoeba.org/en/audio/download/733494","words":[{"g":"both"},{"g":"to be","l":"ser"},{"g":"about, approximately"},null,null,{"g":"competent","l":"competente"}]},{"text":"El juez me interrogó.","en":"The judge questioned me.","audio":"https://tatoeba.org/en/audio/download/439897","words":[{"g":"the"},null,{"g":"me"},{"g":"to interrogate","l":"interrogar"}]},{"text":"Su vida depende de la decisión del juez.","en":"His life hangs on the judge's decision.","audio":"https://tatoeba.org/en/audio/download/689527","words":[{"g":"his / her / your"},{"g":"life"},{"g":"to depend","l":"depender"},null,null,{"g":"decision"},{"g":"of the"},null],"phrases":[[3,5,"of the"]]},{"text":"El juez lo condenó a muerte.","en":"The judge condemned him to death.","words":[{"g":"the"},null,{"g":"it / him"},{"g":"to condemn","l":"condenar"},null,null],"phrases":[[4,6,"to death"]]}]}