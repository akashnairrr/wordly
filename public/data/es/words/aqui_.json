{"id":"aqui_","lemma":"aquí","pos":"adv","rank":33,"glosses":["here (in the speaker's location)"],"ipa":"/aˈki/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Rodelar-aqu%C3%AD.wav","examples":[{"text":"Llévate estos de aquí.","en":"Take these.","audio":"https://tatoeba.org/en/audio/download/799725"},{"text":"Aquí tienes un bolígrafo.","en":"Here's a pen.","audio":"https://tatoeba.org/en/audio/download/439225"},{"text":"Yo no estoy aquí.","en":"I'm not here.","audio":"https://tatoeba.org/en/audio/download/799260"},{"text":"Quédate aquí con nosotros.","en":"Stay with us.","audio":"https://tatoeba.org/en/audio/download/44711"},{"text":"Quedaos aquí con nosotros.","en":"Stay with us.","audio":"https://tatoeba.org/en/audio/download/44712"}]}