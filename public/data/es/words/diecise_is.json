{"id":"diecise_is","lemma":"dieciséis","pos":"num","rank":4956,"glosses":["sixteen"],"ipa":"/djeθiˈseis/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q1321_%28spa%29-AdrianAbdulBaha-diecis%C3%A9is.wav","examples":[{"text":"Tengo dieciséis años.","en":"I am sixteen years old.","audio":"https://tatoeba.org/en/audio/download/39163","words":[{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Tendré dieciséis años el próximo año.","en":"I will be sixteen years old next year.","audio":"https://tatoeba.org/en/audio/download/635384","words":[{"g":"to have","l":"tener"},null,{"g":"year","l":"año"},{"g":"the"},{"g":"near"},{"g":"year"}]},{"text":"Dejé la escuela secundaria cuando tenía dieciséis años.","en":"I dropped out of high school when I was sixteen.","audio":"https://tatoeba.org/en/audio/download/300831","words":[{"g":"to leave","l":"dejar"},{"g":"the / her"},{"g":"school"},{"g":"secondary school"},{"g":"when"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Ella cumplió dieciséis años.","en":"She turned 16 years old.","words":[{"g":"she"},{"g":"to fulfil","l":"cumplir"},null,{"g":"year","l":"año"}]},{"text":"Cumpliré dieciséis en mi próximo cumpleaños.","en":"I'll be sixteen on my next birthday.","words":[{"g":"to fulfil","l":"cumplir"},null,{"g":"in / on"},{"g":"my"},{"g":"near"},{"g":"birthday"}]}]}