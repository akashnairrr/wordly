{"id":"comercial","lemma":"comercial","pos":"adj","rank":1677,"glosses":["commercial"],"ipa":"/komeɾˈθjal/","forms":{"femininePlural":"comerciales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-Marreromarco-comercial.wav","examples":[{"text":"El centro comercial está desierto.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/453931"},{"text":"Tom cambia de canal durante los comerciales.","en":"Tom changes channels during commercials."},{"text":"He estado en el centro comercial.","en":"I've been to the mall.","audio":"https://tatoeba.org/en/audio/download/58169"},{"text":"Los centros comerciales son populares entre los adolescentes.","en":"Shopping malls are popular among teenagers."},{"text":"¿Algún autobús va al centro comercial?","en":"Is there a bus that goes to the mall?","audio":"https://tatoeba.org/en/audio/download/34477"}]}