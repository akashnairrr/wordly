{"id":"restaurante","lemma":"restaurante","pos":"noun","rank":967,"glosses":["restaurant"],"ipa":"/restauˈɾante/","gender":"m","forms":{"plural":"restaurantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-AdrianAbdulBaha-restaurante.wav","examples":[{"text":"Estoy en el restaurante.","en":"I'm at the restaurant.","audio":"https://tatoeba.org/en/audio/download/454619"},{"text":"Conozco un montón de buenos restaurantes.","en":"I know a lot of good restaurants.","audio":"https://tatoeba.org/en/audio/download/523516"},{"text":"Es un restaurante barato.","en":"It's a cheap restaurant.","audio":"https://tatoeba.org/en/audio/download/600205"},{"text":"Estoy harto de comer en restaurantes.","en":"I'm fed up with eating in restaurants.","audio":"https://tatoeba.org/en/audio/download/689122"},{"text":"Hay un restaurante aquí.","en":"There's a restaurant here.","audio":"https://tatoeba.org/en/audio/download/519277"}]}