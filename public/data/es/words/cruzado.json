{"id":"cruzado","lemma":"cruzado","pos":"adj","rank":3255,"glosses":["crossed"],"ipa":"/kɾuˈθado/","forms":{"feminine":"cruzada","masculinePlural":"cruzados","femininePlural":"cruzadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-Marreromarco-cruzado.wav","formAudio":{"cruzada":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q1321_%28spa%29-Rodrigo5260-cruzada.wav"},"examples":[{"text":"Mantén los dedos cruzados.","en":"Keep your fingers crossed.","audio":"https://tatoeba.org/en/audio/download/585904","words":[{"g":"to keep","l":"mantener"},{"g":"the / them"},{"g":"digit: finger or toe","l":"dedo"},null]},{"text":"¿Alguna vez has cruzado un río tan grande como este?","en":"Have you ever crossed a river as big as this one?","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"a"},{"g":"river"},{"g":"so, as"},{"g":"big, large"},{"g":"as"},{"g":"this"}],"phrases":[[0,2,"ever"]]},{"text":"Estaba de pie con los brazos cruzados.","en":"He was standing with his arms folded.","audio":"https://tatoeba.org/en/audio/download/930580","words":[{"g":"to be","l":"estar"},null,null,{"g":"with"},{"g":"the / them"},{"g":"arm","l":"brazo"},null],"phrases":[[1,3,"standing"]]},{"text":"Había un guardia sentado de piernas cruzadas.","en":"A watchman sat with his legs crossed.","words":[{"g":"makes pluperfect to…"},{"g":"a"},{"g":"watch"},{"g":"seated"},{"g":"of / from"},{"g":"leg","l":"pierna"},null]},{"text":"Él se sentó con las piernas cruzadas.","en":"He sat with his legs crossed.","words":[{"g":"he"},{"g":"oneself"},{"g":"to seat","l":"sentar"},{"g":"with"},{"g":"the / them"},{"g":"leg","l":"pierna"},null]}]}