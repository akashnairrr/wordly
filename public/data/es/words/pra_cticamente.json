{"id":"pra_cticamente","lemma":"prácticamente","pos":"adv","rank":1896,"glosses":["practically"],"ipa":"/ˌpɾaɡtikaˈmente/","order":1932,"examples":[{"text":"Él ha terminado prácticamente el trabajo.","en":"He has all but finished the work.","audio":"https://tatoeba.org/en/audio/download/704435","words":[{"g":"he"},{"g":"to have","l":"haber"},{"g":"finished"},null,{"g":"the"},{"g":"work, job"}]},{"text":"Somos prácticamente de la familia.","en":"We're practically family.","audio":"https://tatoeba.org/en/audio/download/64474","words":[{"g":"to be","l":"ser"},null,null,null,{"g":"family"}],"phrases":[[2,4,"of the"]]},{"text":"Prácticamente todas las familias tienen televisión.","en":"Practically every family has a TV.","audio":"https://tatoeba.org/en/audio/download/352857","words":[null,{"g":"all","l":"todo"},{"g":"the / them"},{"g":"family","l":"familia"},{"g":"to have","l":"tener"},{"g":"television"}]}]}