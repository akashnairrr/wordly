{"id":"cobarde","lemma":"cobarde","pos":"adj","rank":1507,"glosses":["cowardly, craven, gutless, spineless, dastardly","yellow (easily frightened)"],"ipa":"/koˈbaɾde/","forms":{"femininePlural":"cobardes"},"order":1566,"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-cobarde.wav","examples":[{"text":"Él me llamó cobarde.","en":"He called me a coward.","audio":"https://tatoeba.org/en/audio/download/519189","words":[{"g":"he"},{"g":"me"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"Sé que sois todos unos cobardes.","en":"I know that you all are cowards.","audio":"https://tatoeba.org/en/audio/download/611749","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"all","l":"todo"},{"g":"about, approximately"},null]},{"text":"Soy un cobarde.","en":"I'm a coward.","audio":"https://tatoeba.org/en/audio/download/516604","words":[{"g":"to be","l":"ser"},{"g":"a"},null]}]}