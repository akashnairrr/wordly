{"id":"cobarde","lemma":"cobarde","pos":"adj","rank":1506,"glosses":["cowardly, craven, gutless, spineless, dastardly","yellow (easily frightened)"],"ipa":"/koˈbaɾde/","forms":{"femininePlural":"cobardes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-cobarde.wav","examples":[{"text":"Él me llamó cobarde.","en":"He called me a coward.","audio":"https://tatoeba.org/en/audio/download/519189","words":[{"g":"he"},{"g":"me"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"Él es un gran cobarde.","en":"He's a big coward.","audio":"https://tatoeba.org/en/audio/download/444281","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Sé que sois todos unos cobardes.","en":"I know that you all are cowards.","audio":"https://tatoeba.org/en/audio/download/611749","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"all","l":"todo"},{"g":"about, approximately"},null]},{"text":"No seas cobarde.","en":"Don't be a coward.","audio":"https://tatoeba.org/en/audio/download/443882","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Yo soy un cobarde.","en":"I'm a coward.","audio":"https://tatoeba.org/en/audio/download/519348","words":[{"g":"I"},{"g":"to be","l":"ser"},{"g":"a"},null]}]}