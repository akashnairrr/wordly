{"id":"cobarde","lemma":"cobarde","pos":"adj","rank":1509,"glosses":["cowardly, craven, gutless, spineless, dastardly","yellow (easily frightened)"],"ipa":"/koˈbaɾde/","forms":{"femininePlural":"cobardes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-cobarde.wav","examples":[{"text":"Yo soy un cobarde.","en":"I'm a coward.","audio":"https://tatoeba.org/en/audio/download/519348"},{"text":"No tolero a los cobardes.","en":"I can't stand cowards.","audio":"https://tatoeba.org/en/audio/download/453477"},{"text":"Él me llamó cobarde.","en":"He called me a coward.","audio":"https://tatoeba.org/en/audio/download/519189"},{"text":"No soporto a los cobardes.","en":"I can't stand cowards.","audio":"https://tatoeba.org/en/audio/download/453669"},{"text":"Ellos le llamaron cobarde.","en":"They called him a coward.","audio":"https://tatoeba.org/en/audio/download/734371"}]}