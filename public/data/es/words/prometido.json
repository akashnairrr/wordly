{"id":"prometido","lemma":"prometido","pos":"adj","rank":1785,"glosses":["engaged","promised"],"ipa":"/pɾomeˈtido/","forms":{"feminine":"prometida","masculinePlural":"prometidos","femininePlural":"prometidas"},"examples":[{"text":"Estoy prometido a ella.","en":"I am engaged to her.","audio":"https://tatoeba.org/en/audio/download/526586","words":[{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"she"}]},{"text":"Él hizo lo que había prometido hacer.","en":"He did what he promised to do.","audio":"https://tatoeba.org/en/audio/download/642143","words":[{"g":"he"},{"g":"to do","l":"hacer"},null,null,{"g":"makes pluperfect to…"},null,{"g":"to do"}],"phrases":[[2,4,"what, that which"]]},{"text":"Yo ya he prometido hacer eso.","en":"I've already pledged to do that.","audio":"https://tatoeba.org/en/audio/download/506288","words":[{"g":"I"},{"g":"now"},{"g":"to have","l":"haber"},null,{"g":"to do"},{"g":"that","l":"ése"}]},{"text":"No recuerdo haberte prometido eso.","en":"I don't remember promising that.","audio":"https://tatoeba.org/en/audio/download/354716","words":[{"g":"no / not"},{"g":"memory"},{"g":"to have","l":"haber"},null,{"g":"that","l":"ése"}]},{"text":"No es bueno no cumplir lo prometido.","en":"It is not good for you to break your promise.","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"good"},{"g":"no / not"},{"g":"to fulfil"},{"g":"it / him"},null]}]}