{"id":"prometido","lemma":"prometido","pos":"adj","rank":1786,"glosses":["engaged","promised"],"ipa":"/pɾomeˈtido/","forms":{"feminine":"prometida","masculinePlural":"prometidos","femininePlural":"prometidas"},"examples":[{"text":"Yo ya he prometido hacer eso.","en":"I've already pledged to do that.","audio":"https://tatoeba.org/en/audio/download/506288","words":[{"g":"I"},{"g":"now"},{"g":"to have","l":"haber"},null,{"g":"to do"},{"g":"that","l":"ése"}]},{"text":"Mary es mi prometida.","en":"Mary is my fiancée.","audio":"https://tatoeba.org/en/audio/download/135408","words":[null,{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Mary y yo estamos prometidos.","en":"Mary and I are engaged.","audio":"https://tatoeba.org/en/audio/download/554802","words":[null,{"g":"and"},{"g":"I"},{"g":"to be","l":"estar"},null]},{"text":"Tom no nos ha prometido nada.","en":"Tom hasn't promised us anything.","audio":"https://tatoeba.org/en/audio/download/300858","words":[null,{"g":"no / not"},{"g":"us"},{"g":"to have","l":"haber"},null,{"g":"nothing"}]},{"text":"Estoy prometido a ella.","en":"I am engaged to her.","audio":"https://tatoeba.org/en/audio/download/526586","words":[{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"she"}]}]}