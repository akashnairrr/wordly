{"id":"prometido","lemma":"prometido","pos":"adj","rank":1789,"glosses":["engaged","promised"],"ipa":"/pɾomeˈtido/","forms":{"feminine":"prometida","masculinePlural":"prometidos","femininePlural":"prometidas"},"examples":[{"text":"Estoy prometido a ella.","en":"I am engaged to her.","audio":"https://tatoeba.org/en/audio/download/526586"},{"text":"Mary es mi prometida.","en":"Mary is my fiancée.","audio":"https://tatoeba.org/en/audio/download/135408"},{"text":"¿Cuánto tiempo lleváis prometidos?","en":"How long have you been engaged?","audio":"https://tatoeba.org/en/audio/download/300019"},{"text":"No recuerdo haberte prometido eso.","en":"I don't remember promising that.","audio":"https://tatoeba.org/en/audio/download/354716"},{"text":"La chica vestida de blanco es su prometida.","en":"The girl dressed in white is his fiancée."}]}