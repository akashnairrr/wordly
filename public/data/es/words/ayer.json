{"id":"ayer","lemma":"ayer","pos":"noun","rank":460,"glosses":["yesterday","days gone by; yesteryear; the past"],"ipa":"/aˈʝeɾ/","gender":"m","forms":{"plural":"ayeres"},"examples":[{"text":"Él la palmó ayer.","en":"He died yesterday.","audio":"https://tatoeba.org/en/audio/download/524836"},{"text":"Siento lo de ayer.","en":"Sorry about yesterday.","audio":"https://tatoeba.org/en/audio/download/98992"},{"text":"Ellos nos vieron ayer.","en":"They saw us yesterday.","audio":"https://tatoeba.org/en/audio/download/69238"},{"text":"Ayer recibí mi sueldo.","en":"I got my pay yesterday.","audio":"https://tatoeba.org/en/audio/download/462134"},{"text":"Me mudé aquí ayer.","en":"I moved here yesterday.","audio":"https://tatoeba.org/en/audio/download/68044"}]}