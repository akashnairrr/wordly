{"id":"desear","lemma":"desear","pos":"verb","rank":1076,"glosses":["to wish","to desire, to want, to hope for, to long for","to look forward to"],"ipa":"/deseˈaɾ/","conjugation":{"indicative":{"present":{"1s":"deseo","2s":"deseas","3s":"desea","1p":"deseamos","2p":"deseáis","3p":"desean"},"imperfect":{"1s":"deseaba","2s":"deseabas","3s":"deseaba","1p":"deseábamos","2p":"deseabais","3p":"deseaban"},"preterite":{"1s":"deseé","2s":"deseaste","3s":"deseó","1p":"deseamos","2p":"deseasteis","3p":"desearon"},"future":{"1s":"desearé","2s":"desearás","3s":"deseará","1p":"desearemos","2p":"desearéis","3p":"desearán"},"conditional":{"1s":"desearía","2s":"desearías","3s":"desearía","1p":"desearíamos","2p":"desearíais","3p":"desearían"}},"subjunctive":{"present":{"1s":"desee","2s":"desees","3s":"desee","1p":"deseemos","2p":"deseéis","3p":"deseen"},"imperfect":{"1s":"deseara","2s":"desearas","3s":"deseara","1p":"deseáramos","2p":"desearais","3p":"desearan"}},"imperative":{"affirmative":{"2s":"desea","3s":"desee","1p":"deseemos","2p":"desead","3p":"deseen"},"negative":{"2s":"desees","3s":"desee","1p":"deseemos","2p":"deseéis","3p":"deseen"}}},"nonFinite":{"gerund":"deseando","participle":"deseado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q1321_%28spa%29-AdrianAbdulBaha-desear.wav","formAudio":{"deseo":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-deseo.wav"},"examples":[{"text":"Para hacer dinero, uno debe primero desear el dinero.","en":"To make money one must want money.","audio":"https://tatoeba.org/en/audio/download/705864"},{"text":"Estoy deseando que llegue.","en":"I'm looking forward to it.","audio":"https://tatoeba.org/en/audio/download/615948"},{"text":"Esto es lo que siempre he deseado.","en":"This is what I've always wanted.","audio":"https://tatoeba.org/en/audio/download/296233"},{"text":"¿Cuál es tu deseo?","en":"What's your wish?","audio":"https://tatoeba.org/en/audio/download/444357"},{"text":"¿Desea