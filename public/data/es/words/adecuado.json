{"id":"adecuado","lemma":"adecuado","pos":"adj","rank":1761,"glosses":["adequate","appropriate, suitable"],"ipa":"/adeˈkwado/","forms":{"feminine":"adecuada","masculinePlural":"adecuados","femininePlural":"adecuadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-Marreromarco-adecuado.wav","examples":[{"text":"¿Eso es adecuado?","en":"Is that suitable?","audio":"https://tatoeba.org/en/audio/download/442800","words":[null,null,null],"phrases":[[0,2,"that's it"]]},{"text":"Estaba esperando el momento adecuado.","en":"I was waiting for the right moment.","audio":"https://tatoeba.org/en/audio/download/594842","words":[{"g":"to be","l":"estar"},{"g":"to hope","l":"esperar"},{"g":"the"},{"g":"moment, instant"},null]},{"text":"Tiene la sal adecuada.","en":"It has enough salt.","words":[{"g":"to have","l":"tener"},{"g":"the / her"},{"g":"salt"},null]},{"text":"¿Sería adecuado?","en":"Would that be suitable?","audio":"https://tatoeba.org/en/audio/download/459345","words":[{"g":"to be","l":"ser"},null]},{"text":"No quiero hacerlo sin las herramientas adecuadas.","en":"I don't want to do that without the proper tools.","audio":"https://tatoeba.org/en/audio/download/594948","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to do","l":"hacer"},{"g":"without"},{"g":"the / them"},{"g":"a tool, an implement","l":"herramienta"},null]}]}