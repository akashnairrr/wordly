{"id":"carretera","lemma":"carretera","pos":"noun","rank":1232,"glosses":["road, highway"],"ipa":"/kareˈteɾa/","gender":"f","forms":{"plural":"carreteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q1321_%28spa%29-AdrianAbdulBaha-carretera.wav","examples":[{"text":"Me salí de la carretera.","en":"I went off the road.","audio":"https://tatoeba.org/en/audio/download/417905","words":[{"g":"me"},{"g":"to go out","l":"salir"},null,null,null],"phrases":[[2,4,"of the"]]},{"text":"Esto es un mapa de carreteras.","en":"This is a road map.","audio":"https://tatoeba.org/en/audio/download/501364","words":[{"g":"this"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"map"},{"g":"of / from"},null]},{"text":"Vimos tu camión en la carretera.","en":"We saw your truck on the road.","audio":"https://tatoeba.org/en/audio/download/296026","words":[{"g":"to see, to spot","l":"ver"},{"g":"your"},{"g":"lorry"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"No seas un cerdo en la carretera.","en":"Don't hog the road.","audio":"https://tatoeba.org/en/audio/download/799871","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"pig, hog"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Vamos de viaje por carretera.","en":"Let's go on a road trip.","audio":"https://tatoeba.org/en/audio/download/606584","words":[{"g":"to go","l":"ir"},{"g":"of / from"},{"g":"voyage"},{"g":"for / by"},null]}]}