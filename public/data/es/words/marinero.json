{"id":"marinero","lemma":"marinero","pos":"adj","rank":3203,"glosses":["sailor, seaman; seafaring"],"ipa":"/maɾiˈneɾo/","forms":{"feminine":"marinera","masculinePlural":"marineros","femininePlural":"marineras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-Marreromarco-marinero.wav","examples":[{"text":"Soy un buen marinero.","en":"I'm a good sailor.","audio":"https://tatoeba.org/en/audio/download/636450","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Ellos mataron a más de tres mil marineros.","en":"They killed more than three thousand sailors.","audio":"https://tatoeba.org/en/audio/download/692945","words":[{"g":"they","l":"él"},{"g":"to kill, slay","l":"matar"},{"g":"to"},{"g":"more"},{"g":"of / from"},null,null,null],"phrases":[[5,7,"three thousand"]]},{"text":"Él salvó a un marinero.","en":"He saved a sailor.","audio":"https://tatoeba.org/en/audio/download/552724","words":[{"g":"he"},{"g":"to save","l":"salvar"},{"g":"to"},{"g":"a"},null]},{"text":"Los marineros vieron tierra firme.","en":"The sailors saw land.","words":[{"g":"the / them"},null,{"g":"to see, to spot","l":"ver"},{"g":"Earth"},{"g":"firm, steady, secure"}]},{"text":"Tom quería ser marinero.","en":"Tom wanted to be a sailor.","audio":"https://tatoeba.org/en/audio/download/798000","words":[null,{"g":"to desire","l":"querer"},{"g":"to be"},null]}]}