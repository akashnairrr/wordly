{"id":"patria","lemma":"patria","pos":"noun","rank":2998,"glosses":["homeland, fatherland, motherland"],"ipa":"/ˈpatɾja/","gender":"f","forms":{"plural":"patrias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-patria.wav","examples":[{"text":"Yo amo a mi patria.","en":"I love my country.","words":[{"g":"I"},{"g":"master"},{"g":"to"},{"g":"my"},null]},{"text":"Ellos abandonaron su patria.","en":"They abandoned their homeland.","words":[{"g":"they","l":"él"},{"g":"to abandon, to leave","l":"abandonar"},{"g":"his / her / your"},null]},{"text":"Echo de menos a mi familia y a mi patria.","en":"I miss my family and my country.","words":[{"g":"to throw","l":"echar"},{"g":"of / from"},{"g":"less, fewer"},{"g":"to"},{"g":"my"},{"g":"family"},{"g":"and"},{"g":"to"},{"g":"my"},null]},{"text":"Lucharemos hasta el último instante para proteger a nuestra patria.","en":"We'll fight to the end to protect our homeland.","words":[{"g":"to fight","l":"luchar"},{"g":"until"},{"g":"the"},{"g":"final"},{"g":"instant, moment"},{"g":"for"},{"g":"to protect, to defend"},{"g":"to"},{"g":"our, ours, to us","l":"nuestro"},null]}]}