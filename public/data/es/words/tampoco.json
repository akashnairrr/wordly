{"id":"tampoco","lemma":"tampoco","pos":"adv","rank":353,"glosses":["neither; nor; also not","either (as well, with implied negative)"],"ipa":"/tamˈpoko/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a7/LL-Q1321_%28spa%29-AdrianAbdulBaha-tampoco.wav","examples":[{"text":"Yo tampoco lo sé.","en":"I don't know either.","audio":"https://tatoeba.org/en/audio/download/197141"},{"text":"Yo tampoco puedo hacerlo.","en":"I can't do it either.","audio":"https://tatoeba.org/en/audio/download/857907"},{"text":"No lo entiendo tampoco.","en":"I don't get it either.","audio":"https://tatoeba.org/en/audio/download/454447"},{"text":"Yo tampoco consigo verle.","en":"I can't see him either.","audio":"https://tatoeba.org/en/audio/download/636744"},{"text":"Yo tampoco logro verlo.","en":"I can't see him either.","audio":"https://tatoeba.org/en/audio/download/636745"}]}