{"id":"tampoco","lemma":"tampoco","pos":"adv","rank":350,"glosses":["neither; nor; also not","either (as well, with implied negative)"],"ipa":"/tamˈpoko/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a7/LL-Q1321_%28spa%29-AdrianAbdulBaha-tampoco.wav","examples":[{"text":"Yo tampoco sé.","en":"I don't know either.","audio":"https://tatoeba.org/en/audio/download/449649","words":[{"g":"I"},null,{"g":"to know, to understand","l":"saber"}]},{"text":"Yo tampoco lo puedo hacer.","en":"I can't do it either.","audio":"https://tatoeba.org/en/audio/download/453646","words":[{"g":"I"},null,{"g":"it / him"},{"g":"to be able to, can","l":"poder"},{"g":"to do"}]},{"text":"Yo tampoco consigo verle.","en":"I can't see him either.","audio":"https://tatoeba.org/en/audio/download/636744","words":[{"g":"I"},null,{"g":"with himself"},{"g":"to see, to spot","l":"ver"}]},{"text":"A mí tampoco me gusta.","en":"I don't like it, either.","audio":"https://tatoeba.org/en/audio/download/460419","words":[{"g":"to"},{"g":"me"},null,null,null],"phrases":[[3,5,"like, thumbs up"]]},{"text":"Yo tampoco estoy casado.","en":"I'm not married, either.","audio":"https://tatoeba.org/en/audio/download/456662","words":[{"g":"I"},null,{"g":"to be","l":"estar"},{"g":"married"}]}]}