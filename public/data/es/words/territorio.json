{"id":"territorio","lemma":"territorio","pos":"noun","rank":1895,"glosses":["territory"],"ipa":"/teriˈtoɾjo/","gender":"m","forms":{"plural":"territorios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1321_%28spa%29-AdrianAbdulBaha-territorio.wav","examples":[{"text":"Esa isla es territorio americano.","en":"That island is American territory.","words":[{"g":"that","l":"ese"},{"g":"island"},{"g":"to be","l":"ser"},null,{"g":"American"}]},{"text":"En algunos territorios canadienses casi no hay personas.","en":"Some Canadian territories have almost no people.","words":[{"g":"in / on"},{"g":"someone","l":"alguno"},null,{"g":"Canadian","l":"canadiense"},{"g":"almost"},{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"person (an individual","l":"persona"}]},{"text":"Estás adentrándote en un territorio peligroso.","en":"You're stepping into dangerous territory.","words":[{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"a"},null,{"g":"perilous, dangerous"}]},{"text":"Estamos a punto de explorar territorio virgen.","en":"We're about to explore some uncharted territory.","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"to explore"},null,{"g":"virgin"}],"phrases":[[1,4,"about to"]]},{"text":"Conducíamos por territorio desconocido.","en":"We drove through unfamiliar territory.","words":[null,{"g":"for / by"},null,{"g":"unknown"}]}]}