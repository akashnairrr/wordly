{"id":"te","lemma":"te","pos":"pron","rank":18,"glosses":["yourself"],"ipa":"/te/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q1321_%28spa%29-AdrianAbdulBaha-te.wav","examples":[{"text":"Te echo de menos.","en":"I miss you.","audio":"https://tatoeba.org/en/audio/download/35031"},{"text":"Dije que te detuvieras.","en":"I said stop.","audio":"https://tatoeba.org/en/audio/download/425194"},{"text":"A ti te conocemos.","en":"We know you.","audio":"https://tatoeba.org/en/audio/download/424668"},{"text":"¿Quién te ha pegado?","en":"Who hit you?","audio":"https://tatoeba.org/en/audio/download/128198"},{"text":"Al fin te encuentro.","en":"Here you are.","audio":"https://tatoeba.org/en/audio/download/425171"}]}