{"id":"paciencia","lemma":"paciencia","pos":"noun","rank":1609,"glosses":["patience, forbearance (the quality of being patient)"],"ipa":"/paˈθjenθja/","gender":"f","forms":{"plural":"paciencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-paciencia.wav","examples":[{"text":"Por favor tenga paciencia.","en":"Please be patient.","audio":"https://tatoeba.org/en/audio/download/585880"},{"text":"Por favor ten paciencia.","en":"Please be patient.","audio":"https://tatoeba.org/en/audio/download/585882"},{"text":"Estoy perdiendo la paciencia.","en":"I'm losing patience.","audio":"https://tatoeba.org/en/audio/download/449402"},{"text":"Tom perdió la paciencia.","en":"Tom lost his temper.","audio":"https://tatoeba.org/en/audio/download/81865"},{"text":"No tengo mucha paciencia.","en":"I'm not very patient.","audio":"https://tatoeba.org/en/audio/download/454660"}]}