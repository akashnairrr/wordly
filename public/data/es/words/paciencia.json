{"id":"paciencia","lemma":"paciencia","pos":"noun","rank":1606,"glosses":["patience, forbearance (the quality of being patient)"],"ipa":"/paˈθjenθja/","gender":"f","forms":{"plural":"paciencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-paciencia.wav","examples":[{"text":"Ahora ten paciencia.","en":"Now be patient.","audio":"https://tatoeba.org/en/audio/download/441224","words":[{"g":"now"},{"g":"to have","l":"tener"},null]},{"text":"No tengo paciencia.","en":"I'm not patient.","audio":"https://tatoeba.org/en/audio/download/441842","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"La paciencia es la clave.","en":"Patience is the key.","audio":"https://tatoeba.org/en/audio/download/448564","words":[{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"key"}]},{"text":"Algunos no tienen paciencia.","en":"Some people have no patience.","words":[{"g":"someone","l":"alguno"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"No deberíamos perder la paciencia.","en":"We should not lose patience.","audio":"https://tatoeba.org/en/audio/download/806086","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to lose"},{"g":"the / her"},null]}]}