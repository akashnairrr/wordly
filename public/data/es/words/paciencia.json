{"id":"paciencia","lemma":"paciencia","pos":"noun","rank":1606,"glosses":["patience, forbearance (the quality of being patient)"],"ipa":"/paˈθjenθja/","gender":"f","forms":{"plural":"paciencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-paciencia.wav","examples":[{"text":"Se me ha acabado la paciencia.","en":"I have no more patience.","audio":"https://tatoeba.org/en/audio/download/459346","words":[{"g":"oneself"},{"g":"me"},{"g":"to have","l":"haber"},{"g":"worn-out"},{"g":"the / her"},null]},{"text":"Ten paciencia conmigo.","en":"Bear with me.","audio":"https://tatoeba.org/en/audio/download/439238","words":[{"g":"to have","l":"tener"},null,{"g":"with me"}]},{"text":"No tengo paciencia.","en":"I'm not patient.","audio":"https://tatoeba.org/en/audio/download/441842","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Por favor tenga paciencia.","en":"Please be patient.","audio":"https://tatoeba.org/en/audio/download/585880","words":[null,null,{"g":"to have","l":"tener"},null],"phrases":[[0,2,"please"]]},{"text":"Estoy perdiendo la paciencia.","en":"I'm losing patience.","audio":"https://tatoeba.org/en/audio/download/449402","words":[{"g":"to be","l":"estar"},{"g":"to lose","l":"perder"},{"g":"the / her"},null]}]}