{"id":"e_xito","lemma":"éxito","pos":"noun","rank":771,"glosses":["success","hit (something popular or well received)"],"ipa":"/ˈeɡsito/","gender":"m","forms":{"plural":"éxitos"},"examples":[{"text":"Quiero que tengas éxito.","en":"I want you to succeed.","audio":"https://tatoeba.org/en/audio/download/851375"},{"text":"Estamos celebrando nuestros éxitos.","en":"We're celebrating our successes.","audio":"https://tatoeba.org/en/audio/download/722641"},{"text":"Él habría tenido éxito.","en":"He would have succeeded.","audio":"https://tatoeba.org/en/audio/download/734395"},{"text":"Todas sus canciones se convirtieron en éxitos.","en":"All of her songs became hits.","audio":"https://tatoeba.org/en/audio/download/333100"},{"text":"Tom no tendrá éxito.","en":"Tom won't be successful.","audio":"https://tatoeba.org/en/audio/download/806408"}]}