{"id":"e_xito","lemma":"éxito","pos":"noun","rank":768,"glosses":["success","hit (something popular or well received)"],"ipa":"/ˈeɡsito/","gender":"m","forms":{"plural":"éxitos"},"examples":[{"text":"Te deseo éxito.","en":"I wish you success.","audio":"https://tatoeba.org/en/audio/download/448166","words":[{"g":"you"},{"g":"desire, wish"},null]},{"text":"Él habría tenido éxito.","en":"He would have succeeded.","audio":"https://tatoeba.org/en/audio/download/734395","words":[{"g":"he"},{"g":"to have","l":"haber"},{"g":"to have","l":"tener"},null]},{"text":"¿Cuál es el secreto del éxito?","en":"What's the secret to success?","audio":"https://tatoeba.org/en/audio/download/567930","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"a secret"},{"g":"of the"},null]},{"text":"Estamos celebrando nuestros éxitos.","en":"We're celebrating our successes.","audio":"https://tatoeba.org/en/audio/download/722641","words":[{"g":"to be","l":"estar"},{"g":"to celebrate","l":"celebrar"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"La fiesta fue un gran éxito.","en":"The party was a big success.","audio":"https://tatoeba.org/en/audio/download/553587","words":[{"g":"the / her"},{"g":"party"},{"g":"to be","l":"ser"},{"g":"a"},null,null]}]}