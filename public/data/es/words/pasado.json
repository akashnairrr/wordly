{"id":"pasado","lemma":"pasado","pos":"adj","rank":188,"glosses":["past","former","last"],"ipa":"/paˈsado/","forms":{"feminine":"pasada","masculinePlural":"pasados","femininePlural":"pasadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-AdrianAbdulBaha-pasado.wav","examples":[{"text":"El pasado, pasado está.","en":"The past is the past.","audio":"https://tatoeba.org/en/audio/download/637145","words":[{"g":"the"},null,null,{"g":"to be","l":"estar"}]},{"text":"¿Qué ha pasado allí exactamente?","en":"What exactly happened there?","audio":"https://tatoeba.org/en/audio/download/642030","words":[{"g":"what"},{"g":"to have","l":"haber"},null,{"g":"there"},{"g":"exactly"}]},{"text":"No se puede cambiar el pasado.","en":"The past can't be changed.","audio":"https://tatoeba.org/en/audio/download/871894","words":[{"g":"no / not"},null,null,{"g":"to change"},{"g":"the"},null],"phrases":[[1,3,"may I?"]]},{"text":"Esos zapatos están pasados de moda.","en":"Those shoes are old fashioned.","audio":"https://tatoeba.org/en/audio/download/306345","words":[{"g":"that","l":"ese"},{"g":"shoe","l":"zapato"},{"g":"to be","l":"estar"},null,null,null],"phrases":[[4,6,"in, in fashion"]]},{"text":"Ven pasado mañana.","en":"Come the day after tomorrow.","audio":"https://tatoeba.org/en/audio/download/734811","words":[{"g":"to come","l":"venir"},null,{"g":"tomorrow"}]}]}