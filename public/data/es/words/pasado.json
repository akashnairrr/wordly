{"id":"pasado","lemma":"pasado","pos":"adj","rank":190,"glosses":["past","former","last"],"ipa":"/paˈsado/","forms":{"feminine":"pasada","masculinePlural":"pasados","femininePlural":"pasadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-AdrianAbdulBaha-pasado.wav","examples":[{"text":"Fue el año pasado.","en":"It was last year.","audio":"https://tatoeba.org/en/audio/download/704157"},{"text":"Nos conocimos la semana pasada.","en":"We met last week.","audio":"https://tatoeba.org/en/audio/download/119085"},{"text":"Esos zapatos están pasados de moda.","en":"Those shoes are old fashioned.","audio":"https://tatoeba.org/en/audio/download/306345"},{"text":"A veces la mente nos juega malas pasadas.","en":"Sometimes our minds play tricks on us.","audio":"https://tatoeba.org/en/audio/download/1155970"},{"text":"¿Qué ha pasado ahora?","en":"Now what's wrong?","audio":"https://tatoeba.org/en/audio/download/443102"}]}