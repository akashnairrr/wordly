{"id":"difunto","lemma":"difunto","pos":"adj","rank":4009,"glosses":["deceased"],"ipa":"/diˈfunto/","forms":{"feminine":"difunta","masculinePlural":"difuntos","femininePlural":"difuntas"},"order":4010,"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6f/LL-Q1321_%28spa%29-Emanuelps27-difunto.wav","examples":[{"text":"¿Alguien sabe acaso el nombre del difunto?","en":"Does anyone know the name of the deceased?","words":[{"g":"someone, somebody"},{"g":"to know, to understand","l":"saber"},{"g":"even"},{"g":"the"},{"g":"name"},{"g":"of the"},null]},{"text":"Él vengó a su difunto padre.","en":"He avenged his dead father.","words":[{"g":"he"},{"g":"to avenge","l":"vengar"},{"g":"to"},{"g":"his / her / your"},null,{"g":"father, parent"}]},{"text":"La chica se parece mucho a mi difunta madre.","en":"The girl closely resembles my dead mother.","words":[{"g":"the / her"},{"g":"gal, chick"},{"g":"oneself"},{"g":"to seem, to see fit","l":"parecer"},{"g":"much"},{"g":"to"},{"g":"my"},null,{"g":"mother"}]}]}