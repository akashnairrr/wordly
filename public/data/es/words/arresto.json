{"id":"arresto","lemma":"arresto","pos":"noun","rank":1626,"glosses":["arrest","boldness"],"ipa":"/aˈresto/","gender":"m","forms":{"plural":"arrestos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-Akhram-arresto.wav","examples":[{"text":"Ellos están bajo arresto.","en":"They're under arrest.","audio":"https://tatoeba.org/en/audio/download/454392"},{"text":"La pelea se saldó con varios arrestos.","en":"The fight resulted in several arrests.","audio":"https://tatoeba.org/en/audio/download/704469"},{"text":"Usted está bajo arresto.","en":"You are under arrest.","audio":"https://tatoeba.org/en/audio/download/453348"},{"text":"No tuve los arrestos para decirle la verdad.","en":"I didn't have the courage to tell her the truth.","audio":"https://tatoeba.org/en/audio/download/514780"},{"text":"Ustedes tres están bajo arresto.","en":"The three of you are under arrest.","audio":"https://tatoeba.org/en/audio/download/587515"}]}