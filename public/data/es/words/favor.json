{"id":"favor","lemma":"favor","pos":"noun","rank":81,"glosses":["favor/favour"],"ipa":"/faˈboɾ/","gender":"m","forms":{"plural":"favores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q1321_%28spa%29-Marreromarco-favor.wav","examples":[{"text":"Un té, por favor.","en":"Tea, please.","audio":"https://tatoeba.org/en/audio/download/798863"},{"text":"Tom me hace muchos favores.","en":"Tom does me a lot of favors.","audio":"https://tatoeba.org/en/audio/download/801461"},{"text":"La cuenta, por favor.","en":"Check, please.","audio":"https://tatoeba.org/en/audio/download/1522"},{"text":"No necesito que me hagan favores.","en":"I don't need them to do me any favors."},{"text":"¡La cuenta, por favor!","en":"Check, please.","audio":"https://tatoeba.org/en/audio/download/525333"}]}