{"id":"convencido","lemma":"convencido","pos":"adj","rank":2215,"glosses":["convinced"],"ipa":"/kombenˈθido/","forms":{"feminine":"convencida","masculinePlural":"convencidos","femininePlural":"convencidas"},"order":2238,"examples":[{"text":"No estoy totalmente convencido de eso.","en":"I'm not one hundred percent convinced of that.","audio":"https://tatoeba.org/en/audio/download/692767","words":[{"g":"no / not"},{"g":"to be","l":"estar"},{"g":"totally"},null,{"g":"of / from"},{"g":"that","l":"ése"}]},{"text":"Estoy convencido de que tienes razón.","en":"I'm convinced that you're right.","audio":"https://tatoeba.org/en/audio/download/522149","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"to have","l":"tener"},{"g":"reason"}],"phrases":[[2,4,"that"]]},{"text":"Todos estamos convencidos de su inocencia.","en":"We are all convinced of his innocence.","audio":"https://tatoeba.org/en/audio/download/707276","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"his / her / your"},{"g":"innocence"}]}]}