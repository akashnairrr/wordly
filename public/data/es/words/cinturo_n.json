{"id":"cinturo_n","lemma":"cinturón","pos":"noun","rank":1979,"glosses":["belt","cincture","seat belt"],"ipa":"/θintuˈɾon/","gender":"m","forms":{"plural":"cinturones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Eavqwiki-cintur%C3%B3n.wav","formAudio":{"cinturones":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Eavqwiki-cinturones.wav"},"examples":[{"text":"Me abroché el cinturón.","en":"I fastened my seatbelt.","audio":"https://tatoeba.org/en/audio/download/437163"},{"text":"Por favor, abróchense los cinturones.","en":"Please fasten your seat belt.","audio":"https://tatoeba.org/en/audio/download/35035"},{"text":"No me abroché el cinturón.","en":"I didn't buckle up.","audio":"https://tatoeba.org/en/audio/download/437164"},{"text":"Abróchense sus cinturones, por favor.","en":"Please fasten your seatbelt."},{"text":"Siempre me pongo mi cinturón.","en":"I always wear my seatbelt.","audio":"https://tatoeba.org/en/audio/download/798359"}]}