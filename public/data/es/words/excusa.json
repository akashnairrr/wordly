{"id":"excusa","lemma":"excusa","pos":"noun","rank":1653,"glosses":["excuse, cop-out","pretext"],"ipa":"/eɡsˈkusa/","gender":"f","forms":{"plural":"excusas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-excusa.wav","examples":[{"text":"Siempre das una excusa.","en":"You always have an excuse.","audio":"https://tatoeba.org/en/audio/download/532387"},{"text":"No te quedan excusas.","en":"You're out of excuses."},{"text":"¿Debería inventar una excusa?","en":"Should I make something up?","audio":"https://tatoeba.org/en/audio/download/803595"},{"text":"No os quedan excusas.","en":"You're out of excuses."},{"text":"No hay excusa para su comportamiento.","en":"There's no excuse for his behavior.","audio":"https://tatoeba.org/en/audio/download/688911"}]}