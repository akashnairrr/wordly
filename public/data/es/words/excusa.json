{"id":"excusa","lemma":"excusa","pos":"noun","rank":1650,"glosses":["excuse, cop-out","pretext"],"ipa":"/eɡsˈkusa/","gender":"f","forms":{"plural":"excusas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-excusa.wav","examples":[{"text":"Mi excusa favorita.","en":"That's my favorite excuse.","audio":"https://tatoeba.org/en/audio/download/801190","words":[{"g":"my"},null,{"g":"favorite/favourite","l":"favorito"}]},{"text":"No hay excusa para su comportamiento.","en":"There's no excuse for his behavior.","audio":"https://tatoeba.org/en/audio/download/688911","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"for"},{"g":"his / her / your"},{"g":"behavior"}]},{"text":"No quiero oír más excusas.","en":"I don't want to hear any more excuses.","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to hear"},{"g":"more"},null]},{"text":"Esa es una buena excusa.","en":"That's a good excuse.","words":[{"g":"that","l":"ese"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"good","l":"bueno"},null]},{"text":"No te quedan excusas.","en":"You're out of excuses.","words":[{"g":"no / not"},{"g":"you"},{"g":"to be , to end up","l":"quedar"},null]}]}