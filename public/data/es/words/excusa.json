{"id":"excusa","lemma":"excusa","pos":"noun","rank":1651,"glosses":["excuse, cop-out","pretext"],"ipa":"/eɡsˈkusa/","gender":"f","forms":{"plural":"excusas"},"order":1701,"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-excusa.wav","examples":[{"text":"Mi excusa favorita.","en":"That's my favorite excuse.","audio":"https://tatoeba.org/en/audio/download/801190","words":[{"g":"my"},null,{"g":"favorite/favourite","l":"favorito"}]},{"text":"No hay excusa para su comportamiento.","en":"There's no excuse for his behavior.","audio":"https://tatoeba.org/en/audio/download/688911","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"for"},{"g":"his / her / your"},{"g":"behavior"}]},{"text":"No quiero oír más excusas.","en":"I don't want to hear any more excuses.","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to hear"},{"g":"more"},null]}]}