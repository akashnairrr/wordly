{"id":"perfectamente","lemma":"perfectamente","pos":"adv","rank":1186,"glosses":["perfectly"],"ipa":"/peɾˌfeɡtaˈmente/","examples":[{"text":"Es perfectamente normal.","en":"It's perfectly normal.","audio":"https://tatoeba.org/en/audio/download/461530","words":[{"g":"to be","l":"ser"},null,{"g":"normal"}]},{"text":"Todo es perfectamente legal.","en":"It's all perfectly legal.","audio":"https://tatoeba.org/en/audio/download/552179","words":[{"g":"all"},{"g":"to be","l":"ser"},null,{"g":"legal"}]},{"text":"Esa palabra lo describe perfectamente.","en":"That word describes it perfectly.","audio":"https://tatoeba.org/en/audio/download/1152194","words":[{"g":"that","l":"ese"},{"g":"word"},{"g":"it / him"},{"g":"to describe","l":"describir"},null]},{"text":"Sabes perfectamente lo que quiero decir.","en":"You know very well what I mean.","audio":"https://tatoeba.org/en/audio/download/435692","words":[{"g":"to know, to understand","l":"saber"},null,null,null,null,null],"phrases":[[2,4,"what, that which"],[4,6,"I mean"]]},{"text":"Desde allí se veía perfectamente.","en":"From there, one could see perfectly.","words":[{"g":"since"},{"g":"there"},{"g":"oneself"},{"g":"to see, to spot","l":"ver"},null]}]}