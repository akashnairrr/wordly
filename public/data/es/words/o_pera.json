{"id":"o_pera","lemma":"ópera","pos":"noun","rank":3045,"glosses":["opera"],"ipa":"/ˈopeɾa/","gender":"f","forms":{"plural":"óperas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Marreromarco-%C3%B3pera.wav","examples":[{"text":"Odio la ópera.","en":"I hate opera.","audio":"https://tatoeba.org/en/audio/download/438130","words":[{"g":"hate"},{"g":"the / her"},null]},{"text":"¿Te gusta la ópera?","en":"Do you like opera?","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},null]},{"text":"La ópera comienza a las siete.","en":"The opera starts at seven.","words":[{"g":"the / her"},null,{"g":"to begin, to commence","l":"comenzar"},{"g":"to"},{"g":"the / them"},{"g":"seven"}]},{"text":"¿Te espero mañana en frente de la ópera?","en":"Should I wait for you tomorrow in front of the opera house?","words":[{"g":"you"},{"g":"to hope","l":"esperar"},{"g":"tomorrow"},null,null,null,{"g":"the / her"},null],"phrases":[[3,6,"in front of"]]},{"text":"Es una ópera en cinco actos.","en":"This is an opera in five acts.","audio":"https://tatoeba.org/en/audio/download/707839","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"in / on"},{"g":"a five"},{"g":"act","l":"acto"}]}]}