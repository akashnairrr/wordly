{"id":"ensayar","lemma":"ensayar","pos":"verb","rank":4522,"glosses":["to rehearse, to practice, to run lines","to test, to try out, to pilot, to experiment","to assay"],"ipa":"/ensaˈʝaɾ/","conjugation":{"indicative":{"present":{"1s":"ensayo","2s":"ensayas","3s":"ensaya","1p":"ensayamos","2p":"ensayáis","3p":"ensayan"},"imperfect":{"1s":"ensayaba","2s":"ensayabas","3s":"ensayaba","1p":"ensayábamos","2p":"ensayabais","3p":"ensayaban"},"preterite":{"1s":"ensayé","2s":"ensayaste","3s":"ensayó","1p":"ensayamos","2p":"ensayasteis","3p":"ensayaron"},"future":{"1s":"ensayaré","2s":"ensayarás","3s":"ensayará","1p":"ensayaremos","2p":"ensayaréis","3p":"ensayarán"},"conditional":{"1s":"ensayaría","2s":"ensayarías","3s":"ensayaría","1p":"ensayaríamos","2p":"ensayaríais","3p":"ensayarían"}},"subjunctive":{"present":{"1s":"ensaye","2s":"ensayes","3s":"ensaye","1p":"ensayemos","2p":"ensayéis","3p":"ensayen"},"imperfect":{"1s":"ensayara","2s":"ensayaras","3s":"ensayara","1p":"ensayáramos","2p":"ensayarais","3p":"ensayaran"}},"imperative":{"affirmative":{"2s":"ensaya","3s":"ensaye","1p":"ensayemos","2p":"ensayad","3p":"ensayen"},"negative":{"2s":"ensayes","3s":"ensaye","1p":"ensayemos","2p":"ensayéis","3p":"ensayen"}}},"nonFinite":{"gerund":"ensayando","participle":"ensayado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-Marreromarco-ensayar.wav","formAudio":{"ensayo":"https://upload.wikimedia.org/wikipedia/commons/c/c2/LL-Q1321_%28spa%29-Marreromarco-ensayo.wav"},"examples":[{"text":"Vamos a ensayar la cuarta escena.","en":"Let's rehearse the fourth scene.","words":[{"g":"to go","l":"ir"},{"g":"to"},null,{"g":"the / her"},{"g":"quatorze"},{"g":"scene"}]},{"text":"Escribe un ensayo corto.","en":"Write a short essay.","audio":"https://tatoeba.org/en/audio/download/453404","words":[{"g":"to write","l":"escribir"},{"g":"a"},null,{"g":"short"}]},{"text":"Ellas no están peleando, sino que están ensayando una obra.","en":"They aren't quarreling, but are rehearsing a play.","words":[{"g":"they"},{"g":"no / not"},{"g":"to be","l":"estar"},{"g":"to fight","l":"pelear"},{"g":"but"},{"g":"that"},{"g":"to be","l":"estar"},null,{"g":"a"},{"g":"work"}]},{"text":"Puedes terminar tu ensayo ahora.","en":"You can finish your essay now.","words":[{"g":"to be able to, can","l":"poder"},{"g":"to finish"},{"g":"your"},null,{"g":"now"}]},{"text":"Hoy es el ensayo general.","en":"Today is the dress rehearsal.","audio":"https://tatoeba.org/en/audio/download/508471","words":[{"g":"today, tonight"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"general, overall"}]}]}