{"id":"mantenido","lemma":"mantenido","pos":"adj","rank":3295,"glosses":["sustained by alimony, kept","freeloading"],"ipa":"/manteˈnido/","forms":{"feminine":"mantenida","masculinePlural":"mantenidos","femininePlural":"mantenidas"},"examples":[{"text":"Deberías haber mantenido la boca cerrada.","en":"You should have kept your mouth shut.","audio":"https://tatoeba.org/en/audio/download/609721","words":[{"g":"to owe","l":"deber"},{"g":"to have"},null,null,null,{"g":"shut, closed","l":"cerrado"}],"phrases":[[3,5,"a district of Buenos…"]]},{"text":"Él fue mantenido en cautiverio.","en":"He was held in captivity.","audio":"https://tatoeba.org/en/audio/download/582632","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"captivity"}]},{"text":"Deberías haberlo mantenido en secreto.","en":"You should have kept it secret.","words":[{"g":"to owe","l":"deber"},{"g":"to have","l":"haber"},null,null,null],"phrases":[[3,5,"in secret, secretly"]]},{"text":"Tom debería haber mantenido sus promesas.","en":"Tom should've kept his promises.","words":[null,{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"his, her, its, their"},{"g":"promise","l":"promesa"}]},{"text":"Nuestro país siempre ha mantenido relaciones amistosas con el suyo.","en":"Our country has always had friendly relations with yours.","words":[{"g":"our, ours, to us"},{"g":"country"},{"g":"always"},{"g":"to have","l":"haber"},null,{"g":"relation","l":"relación"},{"g":"friendly","l":"amistoso"},{"g":"with"},{"g":"the"},{"g":"his, hers, its"}]}]}