{"id":"sobra","lemma":"sobra","pos":"noun","rank":2930,"glosses":["surplus, excess, extra; plentifulness","leftovers, leavings","rubbish, trash"],"ipa":"/ˈsobɾa/","gender":"f","forms":{"plural":"sobras"},"examples":[{"text":"Tenías tiempo de sobra.","en":"You had plenty of time.","audio":"https://tatoeba.org/en/audio/download/458985","words":[{"g":"to have","l":"tener"},{"g":"time"},{"g":"of / from"},null]},{"text":"Dale las sobras al perro.","en":"Give the scraps to the dog.","audio":"https://tatoeba.org/en/audio/download/804604","words":[{"g":"OK, okey dokey, right"},{"g":"the / them"},null,{"g":"to the"},{"g":"dog"}]},{"text":"Tengo dinero de sobra conmigo.","en":"I have plenty of money with me.","words":[{"g":"to have","l":"tener"},{"g":"money"},{"g":"of / from"},null,{"g":"with me"}]},{"text":"No quiero comer sobras.","en":"I don't want to eat leftovers.","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to eat"},null]},{"text":"Puse las sobras en el frigorífico.","en":"I put the leftovers in the fridge.","audio":"https://tatoeba.org/en/audio/download/871974","words":[{"g":"to put, to place","l":"poner"},{"g":"the / them"},null,{"g":"in / on"},{"g":"the"},{"g":"refrigerator"}]}]}