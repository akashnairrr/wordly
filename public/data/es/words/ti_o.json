{"id":"ti_o","lemma":"tío","pos":"noun","rank":244,"glosses":["uncle (the brother, brother-in-law, or male cousin or cousin-in-law of either parent)","unknown or any male person, dude, guy","friend, mate, pal, man, bro"],"ipa":"/ˈtio/","gender":"m","forms":{"plural":"tíos","feminine":"tía","femininePlural":"tías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADo.wav","formAudio":{"tía":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADa.wav"},"examples":[{"text":"Vivo con mi tío.","en":"I'm living with my uncle.","audio":"https://tatoeba.org/en/audio/download/519249","words":[{"g":"alive, living"},{"g":"with"},{"g":"my"},null]},{"text":"Mi tío me dio un libro.","en":"My uncle gave me a book.","audio":"https://tatoeba.org/en/audio/download/66787","words":[{"g":"my"},null,{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"book"}]},{"text":"¿Has oído de mi tío?","en":"Have you heard from my uncle?","words":[{"g":"to have","l":"haber"},{"g":"hearing"},{"g":"of / from"},{"g":"my"},null]},{"text":"Mi tío trabaja en esta oficina.","en":"My uncle works in this office.","audio":"https://tatoeba.org/en/audio/download/582348","words":[{"g":"my"},null,{"g":"to work","l":"trabajar"},{"g":"in / on"},{"g":"this","l":"este"},{"g":"office"}]},{"text":"Quiero hablar con tu tío.","en":"I want to talk with your uncle.","audio":"https://tatoeba.org/en/audio/download/551563","words":[{"g":"to desire","l":"querer"},{"g":"to talk"},{"g":"with"},{"g":"your"},null]}]}