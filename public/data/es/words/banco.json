{"id":"banco","lemma":"banco","pos":"noun","rank":747,"glosses":["bank (financial institution)","bench","pew"],"ipa":"/ˈbanko/","gender":"m","forms":{"plural":"bancos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q1321_%28spa%29-AdrianAbdulBaha-banco.wav","examples":[{"text":"Estoy en el banco.","en":"I'm at the bank.","audio":"https://tatoeba.org/en/audio/download/441731"},{"text":"Los bancos no abren los sábados.","en":"The banks aren't open on Saturdays.","audio":"https://tatoeba.org/en/audio/download/705053"},{"text":"¿Está abierto el banco?","en":"Is the bank open?","audio":"https://tatoeba.org/en/audio/download/442653"},{"text":"Hizo una mesa y dos bancos para nosotros.","en":"He made a desk and two benches for us.","audio":"https://tatoeba.org/en/audio/download/689525"},{"text":"¿Dónde está el banco?","en":"Where's the bank?","audio":"https://tatoeba.org/en/audio/download/444204"}]}