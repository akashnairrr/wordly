{"id":"hola","lemma":"hola","pos":"intj","rank":68,"glosses":["hello, hi, hey"],"ipa":"/ˈola/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q1321_%28spa%29-Nicolas_Lopez_de_Silanes_WMFr-hola.wav","examples":[{"text":"¡Hola! ¿Qué tal estás?","en":"Hi! How are you?","audio":"https://tatoeba.org/en/audio/download/39150"},{"text":"Tom nunca dice hola.","en":"Tom never says hello.","audio":"https://tatoeba.org/en/audio/download/353622"},{"text":"Hola, ¿cómo estás hoy?","en":"Hi, how are you today?","audio":"https://tatoeba.org/en/audio/download/741095"},{"text":"Hola, ¿hay alguien ahí?","en":"Hello, is anybody there?","audio":"https://tatoeba.org/en/audio/download/460826"},{"text":"Por favor, dile hola.","en":"Please say hello to her.","audio":"https://tatoeba.org/en/audio/download/549989"}]}