{"id":"vestido","lemma":"vestido","pos":"adj","rank":696,"glosses":["dressed","dressed up"],"ipa":"/besˈtido/","forms":{"feminine":"vestida","masculinePlural":"vestidos","femininePlural":"vestidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q1321_%28spa%29-AdrianAbdulBaha-vestido.wav","examples":[{"text":"Me encanta tu vestido.","en":"I love your dress.","audio":"https://tatoeba.org/en/audio/download/444027"},{"text":"Ella iba bien vestida.","en":"She was well-dressed.","audio":"https://tatoeba.org/en/audio/download/69904"},{"text":"Todos estaban vestidos de payaso.","en":"Everyone was dressed like a clown.","audio":"https://tatoeba.org/en/audio/download/730305"},{"text":"La habitación estaba llena de chicas vestidas de blanco.","en":"The room was full of girls in white."},{"text":"Su vestido estaba rasgado.","en":"Her dress was torn.","audio":"https://tatoeba.org/en/audio/download/735794"}]}