{"id":"dinero","lemma":"dinero","pos":"noun","rank":126,"glosses":["money","wealth"],"ipa":"/diˈneɾo/","gender":"m","forms":{"plural":"dineros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-AdrianAbdulBaha-dinero.wav","examples":[{"text":"El tiempo es dinero.","en":"Time is money.","audio":"https://tatoeba.org/en/audio/download/501209"},{"text":"Le gusta el dinero.","en":"He likes money.","audio":"https://tatoeba.org/en/audio/download/636967"},{"text":"La comida cuesta dinero.","en":"Food costs money.","audio":"https://tatoeba.org/en/audio/download/799939"},{"text":"Tom no tiene dinero.","en":"Tom has no money.","audio":"https://tatoeba.org/en/audio/download/800073"},{"text":"¿Dónde está mi dinero?","en":"Where's my money?","audio":"https://tatoeba.org/en/audio/download/95841"}]}