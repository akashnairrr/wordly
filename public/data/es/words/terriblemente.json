{"id":"terriblemente","lemma":"terriblemente","pos":"adv","rank":2869,"glosses":["terribly"],"ipa":"/teˌribleˈmente/","order":2874,"examples":[{"text":"Algo ha salido terriblemente mal.","en":"Something has gone terribly wrong.","words":[{"g":"something, anything"},{"g":"to have","l":"haber"},{"g":"sticking out"},null,{"g":"badly, poorly, ill"}]},{"text":"Él estaba terriblemente emocionado.","en":"He was very excited.","audio":"https://tatoeba.org/en/audio/download/449812","words":[{"g":"he"},{"g":"to be","l":"estar"},null,{"g":"excited"}]},{"text":"Estoy terriblemente cansada.","en":"I'm incredibly tired.","words":[{"g":"to be","l":"estar"},null,{"g":"tired, weary, wearied","l":"cansado"}]}]}