{"id":"parque","lemma":"parque","pos":"noun","rank":1061,"glosses":["park","parking lot","ammo"],"ipa":"/ˈpaɾke/","gender":"m","forms":{"plural":"parques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-AdrianAbdulBaha-parque.wav","examples":[{"text":"¿Dónde está el parque?","en":"Where's the park?","audio":"https://tatoeba.org/en/audio/download/92632"},{"text":"Nos gustan nuestros parques.","en":"We love our parks.","audio":"https://tatoeba.org/en/audio/download/550407"},{"text":"Corrimos en el parque.","en":"We ran in the park.","audio":"https://tatoeba.org/en/audio/download/45597"},{"text":"Hay muchos parques en nuestra ciudad.","en":"There are many parks in our town.","audio":"https://tatoeba.org/en/audio/download/594191"},{"text":"Caminamos por el parque.","en":"We walked in the park.","audio":"https://tatoeba.org/en/audio/download/462003"}]}