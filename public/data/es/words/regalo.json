{"id":"regalo","lemma":"regalo","pos":"noun","rank":624,"glosses":["present, gift"],"ipa":"/reˈɡalo/","gender":"m","forms":{"plural":"regalos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-regalo.wav","examples":[{"text":"Este es mi regalo.","en":"This is my treat.","audio":"https://tatoeba.org/en/audio/download/799445","words":[{"g":"this"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Tengo algunos regalos.","en":"I have some gifts.","audio":"https://tatoeba.org/en/audio/download/444101","words":[{"g":"to have","l":"tener"},{"g":"someone","l":"alguno"},null]},{"text":"Él me dio un regalo.","en":"He gave me a present.","audio":"https://tatoeba.org/en/audio/download/636699","words":[{"g":"he"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"Estos regalos son para ti.","en":"These gifts are for you.","audio":"https://tatoeba.org/en/audio/download/515258","words":[{"g":"this","l":"este"},null,{"g":"to be","l":"ser"},{"g":"for"},{"g":"you","l":"tú"}]},{"text":"Tengo un regalo para ustedes.","en":"I have a gift for you.","audio":"https://tatoeba.org/en/audio/download/455006","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"for"},{"g":"you all"}]}]}