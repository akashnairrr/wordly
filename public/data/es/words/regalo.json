{"id":"regalo","lemma":"regalo","pos":"noun","rank":627,"glosses":["present, gift"],"ipa":"/reˈɡalo/","gender":"m","forms":{"plural":"regalos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-regalo.wav","examples":[{"text":"Me encantó el regalo.","en":"I loved the gift.","audio":"https://tatoeba.org/en/audio/download/722646"},{"text":"Estos regalos son para ti.","en":"These gifts are for you.","audio":"https://tatoeba.org/en/audio/download/515258"},{"text":"Este es mi regalo.","en":"This is my treat.","audio":"https://tatoeba.org/en/audio/download/799445"},{"text":"Tengo algunos regalos para ti.","en":"I have some presents for you.","audio":"https://tatoeba.org/en/audio/download/450836"},{"text":"Me mandó un regalo.","en":"He sent me a present.","audio":"https://tatoeba.org/en/audio/download/519308"}]}