{"id":"regalo","lemma":"regalo","pos":"noun","rank":624,"glosses":["present, gift"],"ipa":"/reˈɡalo/","gender":"m","forms":{"plural":"regalos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-regalo.wav","examples":[{"text":"Tengo un regalo para ti.","en":"I have a gift for you.","audio":"https://tatoeba.org/en/audio/download/197085","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"for"},{"g":"you","l":"tú"}]},{"text":"Tengo algunos regalos.","en":"I have some gifts.","audio":"https://tatoeba.org/en/audio/download/444101","words":[{"g":"to have","l":"tener"},{"g":"someone","l":"alguno"},null]},{"text":"Él me dio un regalo.","en":"He gave me a present.","audio":"https://tatoeba.org/en/audio/download/636699","words":[{"g":"he"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"Estos son regalos para mis amigos.","en":"These are gifts for my friends.","audio":"https://tatoeba.org/en/audio/download/832963","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},null,{"g":"for"},{"g":"my"},{"g":"friend","l":"amigo"}]},{"text":"Te daré un regalo.","en":"I'll give you a present.","audio":"https://tatoeba.org/en/audio/download/139334","words":[{"g":"you"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]}]}