{"id":"madera","lemma":"madera","pos":"noun","rank":1540,"glosses":["wood","wooden plank, board","makings"],"ipa":"/maˈdeɾa/","gender":"f","forms":{"plural":"maderas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-AdrianAbdulBaha-madera.wav","examples":[{"text":"Las termitas comen madera.","en":"Termites eat wood.","audio":"https://tatoeba.org/en/audio/download/636406"},{"text":"Tom toca la flauta en la sección de maderas de la orquesta.","en":"Tom plays flute in the woodwind section of the orchestra."},{"text":"La madera es inflamable.","en":"Wood is flammable.","audio":"https://tatoeba.org/en/audio/download/449700"},{"text":"La madera se quema fácilmente.","en":"Wood burns easily.","audio":"https://tatoeba.org/en/audio/download/450230"},{"text":"Tengo un peine de madera.","en":"I have a wooden comb.","audio":"https://tatoeba.org/en/audio/download/453082"}]}