{"id":"feliz","lemma":"feliz","pos":"adj","rank":251,"glosses":["happy, merry (trait)","pleased, glad","joyous, merry, happy"],"ipa":"/feˈliθ/","forms":{"femininePlural":"felices"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-feliz.wav","examples":[{"text":"Yo no soy feliz.","en":"I'm not happy.","audio":"https://tatoeba.org/en/audio/download/451014"},{"text":"Ellos se ven felices.","en":"They seem happy.","audio":"https://tatoeba.org/en/audio/download/442044"},{"text":"Se le ve feliz.","en":"You look happy.","audio":"https://tatoeba.org/en/audio/download/424615"},{"text":"Todos nosotros somos felices.","en":"We're all happy.","audio":"https://tatoeba.org/en/audio/download/442242"},{"text":"Soy un hombre feliz.","en":"I'm a happy man.","audio":"https://tatoeba.org/en/audio/download/441793"}]}