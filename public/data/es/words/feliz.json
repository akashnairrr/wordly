{"id":"feliz","lemma":"feliz","pos":"adj","rank":248,"glosses":["happy, merry (trait)","pleased, glad","joyous, merry, happy"],"ipa":"/feˈliθ/","forms":{"femininePlural":"felices"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-feliz.wav","examples":[{"text":"Te deseo un feliz cumpleaños.","en":"I wish you a happy birthday.","audio":"https://tatoeba.org/en/audio/download/552737","words":[{"g":"you"},{"g":"desire, wish"},{"g":"a"},null,{"g":"birthday"}]},{"text":"Estamos felices de estar aquí.","en":"We're happy to be here.","audio":"https://tatoeba.org/en/audio/download/461252","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to be"},{"g":"here"}]},{"text":"¿Eres feliz o no?","en":"Are you happy or not?","audio":"https://tatoeba.org/en/audio/download/455115","words":[{"g":"to be","l":"ser"},null,{"g":"or"},{"g":"no / not"}]},{"text":"Ellos no son felices.","en":"They're not happy.","audio":"https://tatoeba.org/en/audio/download/449297","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"¿Qué te hace feliz?","en":"What makes you happy?","audio":"https://tatoeba.org/en/audio/download/453933","words":[{"g":"what"},{"g":"you"},{"g":"to do","l":"hacer"},null]}]}