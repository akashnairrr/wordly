{"id":"cambio","lemma":"cambio","pos":"noun","rank":440,"glosses":["change, shift","change (money given back)","gear (of a motor vehicle)"],"ipa":"/ˈkambjo/","gender":"m","forms":{"plural":"cambios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-cambio.wav","examples":[{"text":"El cambio lleva tiempo.","en":"Change takes time.","audio":"https://tatoeba.org/en/audio/download/768304"},{"text":"Quiero hacer algunos cambios.","en":"I want to make some changes.","audio":"https://tatoeba.org/en/audio/download/594344"},{"text":"Cuente usted el cambio.","en":"Count your change.","audio":"https://tatoeba.org/en/audio/download/443873"},{"text":"Necesitamos hacer algunos cambios.","en":"We need to make some changes.","audio":"https://tatoeba.org/en/audio/download/594889"},{"text":"Tom necesita un cambio.","en":"Tom needs a change.","audio":"https://tatoeba.org/en/audio/download/800317"}]}