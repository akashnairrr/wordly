{"id":"cambio","lemma":"cambio","pos":"noun","rank":437,"glosses":["change, shift","change (money given back)","gear (of a motor vehicle)"],"ipa":"/ˈkambjo/","gender":"m","forms":{"plural":"cambios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-cambio.wav","examples":[{"text":"Toma, tu cambio.","en":"Here is your change.","audio":"https://tatoeba.org/en/audio/download/448622","words":[{"g":"conquest"},{"g":"your"},null]},{"text":"Hicieron muchos cambios.","en":"They made many changes.","audio":"https://tatoeba.org/en/audio/download/538359","words":[{"g":"to do","l":"hacer"},{"g":"much","l":"mucho"},null]},{"text":"¿Cuál es el tipo de cambio de hoy?","en":"What's today's exchange rate?","audio":"https://tatoeba.org/en/audio/download/538059","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"kind"},{"g":"of / from"},null,{"g":"of / from"},{"g":"today, tonight"}]},{"text":"Quiero hacer algunos cambios.","en":"I want to make some changes.","audio":"https://tatoeba.org/en/audio/download/594344","words":[{"g":"to desire","l":"querer"},{"g":"to do"},{"g":"someone","l":"alguno"},null]},{"text":"¿Podría darme cambio?","en":"Could you give me some change?","audio":"https://tatoeba.org/en/audio/download/931383","words":[{"g":"to be able to, can","l":"poder"},{"g":"to give, to give out","l":"dar"},null]}]}