{"id":"cambio","lemma":"cambio","pos":"noun","rank":437,"glosses":["change, shift","change (money given back)","gear (of a motor vehicle)"],"ipa":"/ˈkambjo/","gender":"m","forms":{"plural":"cambios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-cambio.wav","examples":[{"text":"El cambio lleva tiempo.","en":"Change takes time.","audio":"https://tatoeba.org/en/audio/download/768304","words":[{"g":"the"},null,{"g":"to take somewhere","l":"llevar"},{"g":"time"}]},{"text":"Necesitamos hacer algunos cambios.","en":"We need to make some changes.","audio":"https://tatoeba.org/en/audio/download/594889","words":[{"g":"to need","l":"necesitar"},{"g":"to do"},{"g":"someone","l":"alguno"},null]},{"text":"Toma, tu cambio.","en":"Here is your change.","audio":"https://tatoeba.org/en/audio/download/448622","words":[{"g":"conquest"},{"g":"your"},null]},{"text":"¿Podría darme cambio?","en":"Could you give me some change?","audio":"https://tatoeba.org/en/audio/download/931383","words":[{"g":"to be able to, can","l":"poder"},{"g":"to give, to give out","l":"dar"},null]},{"text":"Hicieron muchos cambios.","en":"They made many changes.","audio":"https://tatoeba.org/en/audio/download/538359","words":[{"g":"to do","l":"hacer"},{"g":"much","l":"mucho"},null]}]}