{"id":"pasta","lemma":"pasta","pos":"noun","rank":1800,"glosses":["pasta","paste, dough","biscuit"],"ipa":"/ˈpasta/","gender":"f","forms":{"plural":"pastas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-Millars-pasta.wav","examples":[{"text":"Cociné demasiado la pasta.","en":"I overcooked the pasta.","audio":"https://tatoeba.org/en/audio/download/461969"},{"text":"¿Dónde está la pasta de dientes?","en":"Where's the toothpaste?","audio":"https://tatoeba.org/en/audio/download/35732"},{"text":"¿Dónde puedo encontrar pasta de dientes?","en":"Where can I find toothpaste?","audio":"https://tatoeba.org/en/audio/download/333116"},{"text":"Por favor, compra un tubo de pasta de dientes.","en":"Please buy a tube of toothpaste.","audio":"https://tatoeba.org/en/audio/download/645281"},{"text":"Tom olvidó comprar pasta dentífrica.","en":"Tom forgot to buy toothpaste."}]}