{"id":"testigo","lemma":"testigo","pos":"noun","rank":927,"glosses":["witness (someone who sees something)","witness (one who is called upon to witness an event or action)"],"ipa":"/tesˈtiɡo/","gender":"mf","forms":{"plural":"testigos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-AdrianAbdulBaha-testigo.wav","examples":[{"text":"Él fue testigo del accidente.","en":"He witnessed the accident.","audio":"https://tatoeba.org/en/audio/download/552770","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"of the"},{"g":"accident"}]},{"text":"No hubo testigos del crimen.","en":"There were no witnesses to the crime.","audio":"https://tatoeba.org/en/audio/download/689169","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of the"},{"g":"crime"}]},{"text":"¿Puedo llamar a mi primer testigo?","en":"May I call my first witness?","audio":"https://tatoeba.org/en/audio/download/567866","words":[{"g":"to be able to, can","l":"poder"},{"g":"to summon, to call"},{"g":"to"},{"g":"my"},null,null]},{"text":"Tenemos testigos.","en":"We have witnesses.","audio":"https://tatoeba.org/en/audio/download/821343","words":[{"g":"to have","l":"tener"},null]},{"text":"Él era el único testigo del accidente.","en":"He was the only witness of the accident.","audio":"https://tatoeba.org/en/audio/download/937824","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"only"},null,{"g":"of the"},{"g":"accident"}]}]}