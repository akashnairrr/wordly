{"id":"testigo","lemma":"testigo","pos":"noun","rank":930,"glosses":["witness (someone who sees something)","witness (one who is called upon to witness an event or action)"],"ipa":"/tesˈtiɡo/","gender":"mf","forms":{"plural":"testigos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-AdrianAbdulBaha-testigo.wav","examples":[{"text":"Fue testigo del accidente.","en":"He witnessed the accident.","audio":"https://tatoeba.org/en/audio/download/765077"},{"text":"¿Quiénes son los testigos?","en":"Who are the witnesses?","audio":"https://tatoeba.org/en/audio/download/459587"},{"text":"Llame a su siguiente testigo.","en":"Call your next witness.","audio":"https://tatoeba.org/en/audio/download/554944"},{"text":"Disponemos de tres testigos.","en":"We have three witnesses.","audio":"https://tatoeba.org/en/audio/download/1151872"},{"text":"Él fue testigo del asesinato.","en":"He witnessed the murder.","audio":"https://tatoeba.org/en/audio/download/461679"}]}