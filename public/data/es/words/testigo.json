{"id":"testigo","lemma":"testigo","pos":"noun","rank":928,"glosses":["witness (someone who sees something)","witness (one who is called upon to witness an event or action)"],"ipa":"/tesˈtiɡo/","gender":"mf","forms":{"plural":"testigos"},"order":1052,"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-AdrianAbdulBaha-testigo.wav","examples":[{"text":"Él fue testigo del accidente.","en":"He witnessed the accident.","audio":"https://tatoeba.org/en/audio/download/552770","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"of the"},{"g":"accident"}]},{"text":"No hubo testigos del crimen.","en":"There were no witnesses to the crime.","audio":"https://tatoeba.org/en/audio/download/689169","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of the"},{"g":"crime"}]},{"text":"Él era el único testigo del accidente.","en":"He was the only witness of the accident.","audio":"https://tatoeba.org/en/audio/download/937824","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"only"},null,{"g":"of the"},{"g":"accident"}]}]}