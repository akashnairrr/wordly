{"id":"testigo","lemma":"testigo","pos":"noun","rank":927,"glosses":["witness (someone who sees something)","witness (one who is called upon to witness an event or action)"],"ipa":"/tesˈtiɡo/","gender":"mf","forms":{"plural":"testigos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-AdrianAbdulBaha-testigo.wav","examples":[{"text":"¿Puedo llamar a mi primer testigo?","en":"May I call my first witness?","audio":"https://tatoeba.org/en/audio/download/567866","words":[{"g":"to be able to, can","l":"poder"},{"g":"to summon, to call"},{"g":"to"},{"g":"my"},null,null]},{"text":"¿Quiénes son los testigos?","en":"Who are the witnesses?","audio":"https://tatoeba.org/en/audio/download/459587","words":[{"g":"whom? (what person"},{"g":"to be","l":"ser"},{"g":"the / them"},null]},{"text":"¿Quién más fue testigo del accidente?","en":"Who else witnessed the accident?","audio":"https://tatoeba.org/en/audio/download/1152094","words":[{"g":"who"},{"g":"more"},{"g":"to be","l":"ser"},null,{"g":"of the"},{"g":"accident"}]},{"text":"No hay testigos.","en":"There are no witnesses.","audio":"https://tatoeba.org/en/audio/download/460342","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null]},{"text":"Llame a su siguiente testigo.","en":"Call your next witness.","audio":"https://tatoeba.org/en/audio/download/554944","words":[{"g":"to summon, to call","l":"llamar"},{"g":"to"},{"g":"his / her / your"},{"g":"following"},null]}]}