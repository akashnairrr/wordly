{"id":"unos","lemma":"unos","pos":"det","rank":201,"glosses":["about, approximately"],"ipa":"/ˈunos/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c2/LL-Q1321_%28spa%29-Marreromarco-unos.wav","examples":[{"text":"Él llevaba unos vaqueros.","en":"He had jeans on.","audio":"https://tatoeba.org/en/audio/download/525345"},{"text":"Él tiene unos 40 años.","en":"He is about forty.","audio":"https://tatoeba.org/en/audio/download/444073"},{"text":"Tengo unos cuantos libros.","en":"I have a few books.","audio":"https://tatoeba.org/en/audio/download/450283"},{"text":"Toma unos días libres.","en":"Take a few days off.","audio":"https://tatoeba.org/en/audio/download/448359"},{"text":"Tengo unos dolores terribles.","en":"I have a terrible pain.","audio":"https://tatoeba.org/en/audio/download/458975"}]}