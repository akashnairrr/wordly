{"id":"cuello","lemma":"cuello","pos":"noun","rank":869,"glosses":["neck (part of body connecting the head and the torso)","collar (part of a shirt fitting around the neck)"],"ipa":"/ˈkweʝo/","gender":"m","forms":{"plural":"cuellos"},"order":1002,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-Rodelar-cuello.wav","examples":[{"text":"Tengo un dolor en mi cuello.","en":"I have a pain in my neck.","audio":"https://tatoeba.org/en/audio/download/599172","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"pain"},{"g":"in / on"},{"g":"my"},null]},{"text":"Me duele el cuello un poco.","en":"My neck hurts a little.","audio":"https://tatoeba.org/en/audio/download/850141","words":[{"g":"me"},{"g":"to hurt","l":"doler"},{"g":"the"},null,null,null],"phrases":[[4,6,"a bit"]]},{"text":"Tiene un cuello muy largo.","en":"He has a long neck.","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"very"},{"g":"long"}]}]}