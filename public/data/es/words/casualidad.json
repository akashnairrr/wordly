{"id":"casualidad","lemma":"casualidad","pos":"noun","rank":1650,"glosses":["chance, coincidence, happenstance, fluke, accident"],"ipa":"/kaswaliˈdad/","gender":"f","forms":{"plural":"casualidades"},"order":1700,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Marreromarco-casualidad.wav","examples":[{"text":"Nada sucede por casualidad.","en":"Nothing happens by chance.","words":[{"g":"nothing"},{"g":"to happen","l":"suceder"},{"g":"for / by"},null]},{"text":"Encontré este restaurante por casualidad.","en":"I found this restaurant by chance.","audio":"https://tatoeba.org/en/audio/download/552806","words":[{"g":"to meet","l":"encontrar"},{"g":"this"},{"g":"restaurant"},{"g":"for / by"},null]},{"text":"¿Por casualidad sabes dónde vive ella?","en":"Do you happen to know where she lives?","audio":"https://tatoeba.org/en/audio/download/707834","words":[{"g":"for / by"},null,{"g":"to know, to understand","l":"saber"},{"g":"where"},{"g":"to applaud","l":"vivar"},{"g":"she"}]}]}