{"id":"consideracio_n","lemma":"consideración","pos":"noun","rank":4260,"glosses":["consideration","thoughtfulness"],"ipa":"/konsideɾaˈθjon/","gender":"f","forms":{"plural":"consideraciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q1321_%28spa%29-Marreromarco-consideraci%C3%B3n.wav","examples":[{"text":"He tomado todo en consideración.","en":"I've taken everything into consideration.","audio":"https://tatoeba.org/en/audio/download/514848","words":[{"g":"to have","l":"haber"},{"g":"drunk"},{"g":"all"},{"g":"in / on"},null]},{"text":"Debe ser tenido en consideración.","en":"It has to be taken into account.","words":[{"g":"to owe","l":"deber"},{"g":"to be"},{"g":"to have","l":"tener"},{"g":"in / on"},null]},{"text":"Eso es algo que debemos tomar en consideración.","en":"That's something we have to take into consideration.","words":[null,null,{"g":"something, anything"},{"g":"that"},{"g":"to owe","l":"deber"},{"g":"to take"},{"g":"in / on"},null],"phrases":[[0,2,"that's it"]]},{"text":"Lo perdonaré por consideración a ti.","en":"I will forgive him out of consideration for you.","words":[{"g":"it / him"},{"g":"to pardon","l":"perdonar"},{"g":"for / by"},null,{"g":"to"},{"g":"you","l":"tú"}]},{"text":"Tomé todo en consideración.","en":"I've taken everything into consideration.","words":[{"g":"to take","l":"tomar"},{"g":"all"},{"g":"in / on"},null]}]}