{"id":"herida","lemma":"herida","pos":"noun","rank":1118,"glosses":["wound"],"ipa":"/eˈɾida/","gender":"f","forms":{"plural":"heridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-AdrianAbdulBaha-herida.wav","examples":[{"text":"Es una herida menor.","en":"It's a minor wound.","audio":"https://tatoeba.org/en/audio/download/547998","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"minor"}]},{"text":"Mi amigo murió de una herida.","en":"My friend died from an injury.","audio":"https://tatoeba.org/en/audio/download/64696","words":[{"g":"my"},{"g":"friend"},{"g":"to die","l":"morir"},{"g":"of / from"},{"g":"a"},null]},{"text":"Estás herida.","en":"You're wounded.","audio":"https://tatoeba.org/en/audio/download/441403","words":[{"g":"to be","l":"estar"},null]},{"text":"La herida se curó.","en":"The wound healed.","audio":"https://tatoeba.org/en/audio/download/443879","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to cure, heal","l":"curar"}]},{"text":"La sangre fluía de la herida.","en":"Blood flowed from the wound.","words":[{"g":"the / her"},{"g":"blood"},{"g":"to flow","l":"fluir"},null,null,null],"phrases":[[3,5,"of the"]]}]}