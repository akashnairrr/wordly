{"id":"herida","lemma":"herida","pos":"noun","rank":1121,"glosses":["wound"],"ipa":"/eˈɾida/","gender":"f","forms":{"plural":"heridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-AdrianAbdulBaha-herida.wav","examples":[{"text":"La herida se curó.","en":"The wound healed.","audio":"https://tatoeba.org/en/audio/download/443879"},{"text":"Tres personas resultaron heridas.","en":"Three people were wounded.","audio":"https://tatoeba.org/en/audio/download/582564"},{"text":"Es una herida menor.","en":"It's a minor wound.","audio":"https://tatoeba.org/en/audio/download/547998"},{"text":"Le curó las heridas.","en":"She took care of his wound.","audio":"https://tatoeba.org/en/audio/download/1187385"},{"text":"La herida se infectó.","en":"The wound became infected.","audio":"https://tatoeba.org/en/audio/download/70234"}]}