{"id":"brazo","lemma":"brazo","pos":"noun","rank":897,"glosses":["arm","branch, limb (of a tree)"],"ipa":"/ˈbɾaθo/","gender":"m","forms":{"plural":"brazos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-AdrianAbdulBaha-brazo.wav","formAudio":{"brazos":"https://upload.wikimedia.org/wikipedia/commons/f/f3/LL-Q1321_%28spa%29-Akhram-brazos.wav"},"examples":[{"text":"¿Te duele el brazo?","en":"Does your arm hurt?","audio":"https://tatoeba.org/en/audio/download/273203","words":[{"g":"you"},null,{"g":"the"},null]},{"text":"Mantén los brazos en alto.","en":"Keep your hands up.","audio":"https://tatoeba.org/en/audio/download/448835","words":[{"g":"to keep","l":"mantener"},{"g":"the / them"},null,null,null],"phrases":[[3,5,"high up"]]},{"text":"Me he roto el brazo.","en":"I broke my arm.","audio":"https://tatoeba.org/en/audio/download/39827","words":[{"g":"me"},{"g":"to have","l":"haber"},{"g":"broken"},{"g":"the"},null]},{"text":"Tom murió en mis brazos.","en":"Tom died in my arms.","audio":"https://tatoeba.org/en/audio/download/273204","words":[null,{"g":"to die","l":"morir"},{"g":"in / on"},{"g":"my"},null]},{"text":"Se me ha dormido el brazo.","en":"My arm fell asleep.","audio":"https://tatoeba.org/en/audio/download/820318","words":[{"g":"oneself"},{"g":"me"},{"g":"to have","l":"haber"},{"g":"asleep, sleeping"},{"g":"the"},null]}]}