{"id":"lento","lemma":"lento","pos":"adj","rank":1794,"glosses":["slow"],"ipa":"/ˈlento/","forms":{"feminine":"lenta","masculinePlural":"lentos","femininePlural":"lentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-AdrianAbdulBaha-lento.wav","examples":[{"text":"El autobús es lento.","en":"The bus is slow.","audio":"https://tatoeba.org/en/audio/download/442079"},{"text":"Ella es una corredora lenta.","en":"She is a slow runner.","audio":"https://tatoeba.org/en/audio/download/453439"},{"text":"Los negocios son lentos.","en":"Business is slow.","audio":"https://tatoeba.org/en/audio/download/442997"},{"text":"\"Rápido\" es el contrario de \"lento\".","en":"\"Fast\" is the opposite of \"slow.\"","audio":"https://tatoeba.org/en/audio/download/37560"},{"text":"Quiero ver la escena a cámara lenta.","en":"I want to see the scene in slow motion."}]}