{"id":"concurso","lemma":"concurso","pos":"noun","rank":1957,"glosses":["concourse","competition","game show"],"ipa":"/konˈkuɾso/","gender":"m","forms":{"plural":"concursos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-Emanuelps27-concurso.wav","examples":[{"text":"Ella participó en el concurso.","en":"She took part in the contest.","audio":"https://tatoeba.org/en/audio/download/733741","words":[{"g":"she"},{"g":"to participate","l":"participar"},{"g":"in / on"},{"g":"the"},null]},{"text":"Pronto tendremos un concurso de música.","en":"We'll have a music contest soon.","words":[{"g":"prompt, on time"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"of / from"},{"g":"music"}]},{"text":"Hemos ganado el concurso.","en":"We won the contest.","audio":"https://tatoeba.org/en/audio/download/501505","words":[{"g":"heme","l":"hemo"},{"g":"livestock, cattle"},{"g":"the"},null]},{"text":"Ella ganó el concurso de belleza.","en":"She won the beauty contest.","words":[{"g":"she"},{"g":"to gain","l":"ganar"},{"g":"the"},null,{"g":"of / from"},{"g":"beauty"}]},{"text":"Él quiere participar en el concurso.","en":"He wants to participate in the contest.","words":[{"g":"he"},{"g":"to desire","l":"querer"},{"g":"to participate"},{"g":"in / on"},{"g":"the"},null]}]}