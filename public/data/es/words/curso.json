{"id":"curso","lemma":"curso","pos":"noun","rank":1355,"glosses":["course, trajectory, route, direction","class, course (learning program, as in a school)","(US) grade, (UK) year"],"ipa":"/ˈkuɾso/","gender":"m","forms":{"plural":"cursos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Marreromarco-curso.wav","examples":[{"text":"¿En qué curso va tu hermana?","en":"What grade is your sister in?","words":[{"g":"in / on"},{"g":"what"},null,{"g":"okay"},{"g":"your"},{"g":"sister"}]},{"text":"Seguimos el curso del río.","en":"We followed the course of the river.","audio":"https://tatoeba.org/en/audio/download/687930","words":[{"g":"to follow","l":"seguir"},{"g":"the"},null,{"g":"of the"},{"g":"river"}]},{"text":"Mi nuevo curso comienza hoy.","en":"My new class starts today.","words":[{"g":"my"},{"g":"new"},null,{"g":"to begin, to commence","l":"comenzar"},{"g":"today, tonight"}]},{"text":"Los cursos intensivos son siempre los más agotadores.","en":"Intensive courses are always the most exhausting.","audio":"https://tatoeba.org/en/audio/download/692573","words":[{"g":"the / them"},null,{"g":"intensive","l":"intensivo"},{"g":"to be","l":"ser"},{"g":"always"},null,null,null],"phrases":[[5,7,"most"]]},{"text":"Tom tomó un curso de control de la ira.","en":"Tom took a class to learn how to manage his anger.","audio":"https://tatoeba.org/en/audio/download/801508","words":[null,{"g":"to take","l":"tomar"},{"g":"a"},null,{"g":"of / from"},{"g":"control"},null,null,{"g":"anger, ire"}],"phrases":[[6,8,"of the"]]}]}