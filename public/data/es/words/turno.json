{"id":"turno","lemma":"turno","pos":"noun","rank":962,"glosses":["turn (chance to use (something) shared in sequence with others)","turn (chance to make a move in a game)","shift (set group of workers or period of working time)"],"ipa":"/ˈtuɾno/","gender":"m","forms":{"plural":"turnos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q1321_%28spa%29-Marreromarco-turno.wav","examples":[{"text":"¿Es mi turno?","en":"Is it my turn?","audio":"https://tatoeba.org/en/audio/download/39385","words":[{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Espera tu turno.","en":"Wait your turn.","audio":"https://tatoeba.org/en/audio/download/441262","words":[{"g":"wait"},{"g":"your"},null]},{"text":"Ahora sigue mi turno.","en":"It's my turn now.","audio":"https://tatoeba.org/en/audio/download/448988","words":[{"g":"now"},{"g":"to follow","l":"seguir"},{"g":"my"},null]},{"text":"Bebían de la fuente por turnos.","en":"They took turns drinking from the water fountain.","audio":"https://tatoeba.org/en/audio/download/451629","words":[{"g":"to drink","l":"beber"},null,null,null,{"g":"for / by"},null],"phrases":[[1,4,"a surname"]]},{"text":"Ahora es tu turno.","en":"It's now your turn.","audio":"https://tatoeba.org/en/audio/download/449058","words":[{"g":"now"},{"g":"to be","l":"ser"},{"g":"your"},null]}]}