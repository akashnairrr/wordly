{"id":"bote","lemma":"bote","pos":"noun","rank":1319,"glosses":["boat, dinghy","vessel, can, canister, container, jar, tin","jackpot, pot, pool (large cash prize)"],"ipa":"/ˈbote/","gender":"m","forms":{"plural":"botes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-AdrianAbdulBaha-bote.wav","examples":[{"text":"Estamos en el mismo bote.","en":"We're in the same boat.","audio":"https://tatoeba.org/en/audio/download/461054","words":[{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},{"g":"same"},null]},{"text":"Hay algunos botes en el lago.","en":"There are a few boats on the lake.","audio":"https://tatoeba.org/en/audio/download/615940","words":[{"g":"to have","l":"haber"},{"g":"someone","l":"alguno"},null,{"g":"in / on"},{"g":"the"},{"g":"lake"}]},{"text":"Estamos listos para meter el bote al agua.","en":"We're ready to put the boat in the water.","audio":"https://tatoeba.org/en/audio/download/77347","words":[{"g":"to be","l":"estar"},{"g":"clever, smart","l":"listo"},{"g":"for"},{"g":"to put in, insert"},{"g":"the"},null,{"g":"to the"},{"g":"water"}]},{"text":"No botes nada.","en":"Don't throw anything away.","words":[{"g":"no / not"},null,{"g":"nothing"}]},{"text":"Ese es un bote.","en":"That's a boat.","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]}]}