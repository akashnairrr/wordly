{"id":"pistola","lemma":"pistola","pos":"noun","rank":853,"glosses":["pistol, handgun","gun (a device operated by a trigger and acting in a manner similar to a firearm)"],"ipa":"/pisˈtola/","gender":"f","forms":{"plural":"pistolas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-pistola.wav","examples":[{"text":"Tom soltó la pistola.","en":"Tom put the gun down.","audio":"https://tatoeba.org/en/audio/download/305369"},{"text":"Se armaron con pistolas.","en":"They armed themselves with guns.","audio":"https://tatoeba.org/en/audio/download/687580"},{"text":"¿Tom siempre lleva pistola?","en":"Does Tom always carry a gun?","audio":"https://tatoeba.org/en/audio/download/69876"},{"text":"Guarden sus pistolas.","en":"Put your guns away.","audio":"https://tatoeba.org/en/audio/download/448175"},{"text":"Dale a Tom la pistola.","en":"Give Tom the gun.","audio":"https://tatoeba.org/en/audio/download/799224"}]}