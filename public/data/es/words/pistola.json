{"id":"pistola","lemma":"pistola","pos":"noun","rank":850,"glosses":["pistol, handgun","gun (a device operated by a trigger and acting in a manner similar to a firearm)"],"ipa":"/pisˈtola/","gender":"f","forms":{"plural":"pistolas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-AdrianAbdulBaha-pistola.wav","examples":[{"text":"Tengo una pistola.","en":"I have a gun.","audio":"https://tatoeba.org/en/audio/download/823778","words":[{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"Ella le disparó con una pistola.","en":"She shot him with a pistol.","audio":"https://tatoeba.org/en/audio/download/1195652","words":[{"g":"she"},{"g":"him / her"},{"g":"to shoot, to fire","l":"disparar"},{"g":"with"},{"g":"a"},null]},{"text":"Ten tu pistola a mano.","en":"Keep your gun handy.","audio":"https://tatoeba.org/en/audio/download/704165","words":[{"g":"to have","l":"tener"},{"g":"your"},null,null,null],"phrases":[[3,5,"by hand"]]},{"text":"Pon la pistola sobre la mesa.","en":"Put the gun on the table.","audio":"https://tatoeba.org/en/audio/download/587289","words":[{"g":"to put, to place","l":"poner"},{"g":"the / her"},null,{"g":"envelope"},{"g":"the / her"},{"g":"table"}]},{"text":"Se armaron con pistolas.","en":"They armed themselves with guns.","audio":"https://tatoeba.org/en/audio/download/687580","words":[{"g":"oneself"},{"g":"to arm","l":"armar"},{"g":"with"},null]}]}