{"id":"campo","lemma":"campo","pos":"noun","rank":519,"glosses":["countryside, country","field (large open area)","pitch, (US) field (field on which soccer, rugby or field hockey is played)"],"ipa":"/ˈkampo/","gender":"m","forms":{"plural":"campos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Rodrigo5260-campo.wav","examples":[{"text":"Ella vive en el campo.","en":"She lives in the country.","audio":"https://tatoeba.org/en/audio/download/639567","words":[{"g":"she"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the"},null]},{"text":"¿Te gusta vivir en el campo?","en":"Do you like to live in the country?","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"to live"},{"g":"in / on"},{"g":"the"},null]},{"text":"Mis padres viven en el campo.","en":"My parents live in the country.","audio":"https://tatoeba.org/en/audio/download/1153023","words":[{"g":"my"},{"g":"father, parent","l":"padre"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the"},null]},{"text":"Quiero ver el campo.","en":"I want to see the countryside.","words":[{"g":"to desire","l":"querer"},{"g":"to see, to spot"},{"g":"the"},null]},{"text":"Todos somos estúpidos, pero en diferentes campos.","en":"We're all stupid, just on different subjects.","audio":"https://tatoeba.org/en/audio/download/691589","words":[{"g":"all","l":"todo"},{"g":"to be","l":"ser"},{"g":"stupid","l":"estúpido"},{"g":"but"},{"g":"in / on"},{"g":"differently","l":"diferente"},null]}]}