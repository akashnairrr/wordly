{"id":"cierto","lemma":"cierto","pos":"det","rank":184,"glosses":["a certain, a specific"],"ipa":"/ˈθjeɾto/","forms":{"plural":"ciertos","feminine":"cierta","femininePlural":"ciertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Marreromarco-cierto.wav","examples":[{"text":"¿Está en lo cierto?","en":"Is he right?","audio":"https://tatoeba.org/en/audio/download/425279"},{"text":"¿Son ciertos estos datos?","en":"Is this data accurate?","audio":"https://tatoeba.org/en/audio/download/300731"},{"text":"¿Es cierta su historia?","en":"Is her story true?","audio":"https://tatoeba.org/en/audio/download/443806"},{"text":"Ambas historias son ciertas.","en":"Both stories are true.","audio":"https://tatoeba.org/en/audio/download/42607"},{"text":"Esto es muy cierto.","en":"It's all true.","audio":"https://tatoeba.org/en/audio/download/449017"}]}