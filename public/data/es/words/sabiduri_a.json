{"id":"sabiduri_a","lemma":"sabiduría","pos":"noun","rank":2868,"glosses":["wisdom","learning; knowledge"],"ipa":"/sabiduˈɾia/","gender":"f","forms":{"plural":"sabidurías"},"order":2873,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-Marreromarco-sabidur%C3%ADa.wav","examples":[{"text":"La sabiduría no viene automáticamente con los años.","en":"Wisdom does not automatically come with age.","audio":"https://tatoeba.org/en/audio/download/705422","words":[{"g":"the / her"},null,{"g":"no / not"},{"g":"to come","l":"venir"},{"g":"automatically"},{"g":"with"},{"g":"the / them"},{"g":"year","l":"año"}]},{"text":"Los proverbios están llenos de sabiduría.","en":"Proverbs are full of wisdom.","words":[{"g":"the / them"},{"g":"proverb","l":"proverbio"},{"g":"to be","l":"estar"},{"g":"full","l":"lleno"},{"g":"of / from"},null]},{"text":"Tom es un hombre de sabiduría y experiencia.","en":"Tom is a man of wisdom and experience.","words":[null,{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},{"g":"of / from"},null,{"g":"and"},{"g":"experience"}]}]}