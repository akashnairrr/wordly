{"id":"ducha","lemma":"ducha","pos":"noun","rank":1667,"glosses":["shower (device)","shower (act of having a shower)"],"ipa":"/ˈdut͡ʃa/","gender":"f","forms":{"plural":"duchas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-AdrianAbdulBaha-ducha.wav","formAudio":{"duchas":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q1321_%28spa%29-Wikipedian-walker-duchas.wav"},"examples":[{"text":"Está en la ducha.","en":"He's in the shower.","audio":"https://tatoeba.org/en/audio/download/77352"},{"text":"¿Dónde están las duchas?","en":"Where are the showers?","audio":"https://tatoeba.org/en/audio/download/1505"},{"text":"Estaba en la ducha.","en":"I was in the shower.","audio":"https://tatoeba.org/en/audio/download/449279"},{"text":"¿Te duchas todos los días?","en":"Do you shower every day?","audio":"https://tatoeba.org/en/audio/download/77101"},{"text":"La ducha está rota.","en":"The shower is broken.","audio":"https://tatoeba.org/en/audio/download/453328"}]}