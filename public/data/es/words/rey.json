{"id":"rey","lemma":"rey","pos":"noun","rank":401,"glosses":["king","darling, fellow"],"ipa":"/ˈrei/","gender":"m","forms":{"plural":"reyes","feminine":"reina","femininePlural":"reinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Rodrigo5260-rey.wav","formAudio":{"reina":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-AdrianAbdulBaha-reina.wav"},"examples":[{"text":"Fue un rey bueno.","en":"He was a good king.","audio":"https://tatoeba.org/en/audio/download/450399"},{"text":"Viviremos como reyes.","en":"We'll live like kings.","audio":"https://tatoeba.org/en/audio/download/458738"},{"text":"Recuerdo haber visto a la reina.","en":"I remember meeting the queen.","audio":"https://tatoeba.org/en/audio/download/610846"},{"text":"Hubo una época en que reyes y reinas dominaban el mundo.","en":"There was a time when kings and queens reigned over the world.","audio":"https://tatoeba.org/en/audio/download/930560"},{"text":"Fue un buen rey.","en":"He was a good king.","audio":"https://tatoeba.org/en/audio/download/450415"}]}