{"id":"apagado","lemma":"apagado","pos":"adj","rank":2999,"glosses":["switched off, shut down","faint, pale"],"ipa":"/apaˈɡado/","forms":{"feminine":"apagada","masculinePlural":"apagados","femininePlural":"apagadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Wikipedian-walker-apagado.wav","examples":[{"text":"¿Por qué has apagado la luz?","en":"Why did you turn off the light?","audio":"https://tatoeba.org/en/audio/download/425343","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"light"}],"phrases":[[0,2,"why, for what reason"]]},{"text":"La televisión está apagada.","en":"The television is off.","audio":"https://tatoeba.org/en/audio/download/1253482","words":[{"g":"the / her"},{"g":"television"},{"g":"to be","l":"estar"},null]},{"text":"Las luces están apagadas.","en":"The lights are out.","audio":"https://tatoeba.org/en/audio/download/501152","words":[{"g":"the / them"},{"g":"light","l":"luz"},{"g":"to be","l":"estar"},null]},{"text":"El fuego fue apagado inmediatamente.","en":"The fire was put out immediately.","audio":"https://tatoeba.org/en/audio/download/764850","words":[{"g":"the"},{"g":"fire"},{"g":"to be","l":"ser"},null,{"g":"immediately"}]},{"text":"Dormí con la luz apagada.","en":"I slept with the light off.","audio":"https://tatoeba.org/en/audio/download/1187375","words":[{"g":"to sleep","l":"dormir"},{"g":"with"},{"g":"the / her"},{"g":"light"},null]}]}