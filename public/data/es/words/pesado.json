{"id":"pesado","lemma":"pesado","pos":"adj","rank":1955,"glosses":["heavy in weight, weighty","annoying","stressful, exhausting"],"ipa":"/peˈsado/","forms":{"feminine":"pesada","masculinePlural":"pesados","femininePlural":"pesadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-Rodelar-pesado.wav","examples":[{"text":"Sé que es pesado.","en":"I know it's heavy.","audio":"https://tatoeba.org/en/audio/download/443909"},{"text":"La caja es pesada.","en":"The box is heavy.","audio":"https://tatoeba.org/en/audio/download/443786"},{"text":"Una grúa eleva materiales de construcción pesados.","en":"A crane raises heavy construction materials.","audio":"https://tatoeba.org/en/audio/download/692762"},{"text":"Siento las piernas pesadas.","en":"My legs feel heavy.","audio":"https://tatoeba.org/en/audio/download/449202"},{"text":"Ese libro es pesado.","en":"This book is heavy.","audio":"https://tatoeba.org/en/audio/download/501218"}]}