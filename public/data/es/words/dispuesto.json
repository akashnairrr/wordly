{"id":"dispuesto","lemma":"dispuesto","pos":"adj","rank":1288,"glosses":["willing, ready, game, down","willing to, ready to"],"ipa":"/disˈpwesto/","forms":{"feminine":"dispuesta","masculinePlural":"dispuestos","femininePlural":"dispuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-Marreromarco-dispuesto.wav","examples":[{"text":"Yo no estoy dispuesto a eso.","en":"I'm not ready for that.","audio":"https://tatoeba.org/en/audio/download/458620","words":[{"g":"I"},{"g":"no / not"},{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"that","l":"ése"}]},{"text":"¿Cuánto está usted dispuesta a pagar?","en":"How much are you willing to pay?","words":[{"g":"how much"},{"g":"to be","l":"estar"},{"g":"you (formal)"},null,{"g":"to"},{"g":"to pay"}]},{"text":"Estamos dispuestos a ayudarte.","en":"We're willing to help you.","audio":"https://tatoeba.org/en/audio/download/616335","words":[{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to help","l":"ayudar"}]},{"text":"¿Cuánto están ustedes dispuestas a pagar?","en":"How much are you willing to pay?","words":[{"g":"how much"},{"g":"to be","l":"estar"},{"g":"you all"},null,{"g":"to"},{"g":"to pay"}]},{"text":"Estoy dispuesto para ayudar.","en":"I'm here to help.","audio":"https://tatoeba.org/en/audio/download/442606","words":[{"g":"to be","l":"estar"},null,{"g":"for"},{"g":"to help"}]}]}