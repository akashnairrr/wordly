{"id":"dispuesto","lemma":"dispuesto","pos":"adj","rank":1291,"glosses":["willing, ready, game, down","willing to, ready to"],"ipa":"/disˈpwesto/","forms":{"feminine":"dispuesta","masculinePlural":"dispuestos","femininePlural":"dispuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-Marreromarco-dispuesto.wav","examples":[{"text":"Estoy dispuesto para ayudar.","en":"I'm here to help.","audio":"https://tatoeba.org/en/audio/download/442606"},{"text":"Ella estaba dispuesta a devolverle a él todo su dinero.","en":"She was ready to give him back all his money.","audio":"https://tatoeba.org/en/audio/download/598921"},{"text":"Estamos dispuestos a ayudarte.","en":"We're willing to help you.","audio":"https://tatoeba.org/en/audio/download/616335"},{"text":"¿Cuánto estáis dispuestas a pagar?","en":"How much are you willing to pay?"},{"text":"Estoy dispuesto a compartir.","en":"I'm willing to share.","audio":"https://tatoeba.org/en/audio/download/455249"}]}