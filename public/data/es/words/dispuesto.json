{"id":"dispuesto","lemma":"dispuesto","pos":"adj","rank":1288,"glosses":["willing, ready, game, down","willing to, ready to"],"ipa":"/disˈpwesto/","forms":{"feminine":"dispuesta","masculinePlural":"dispuestos","femininePlural":"dispuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-Marreromarco-dispuesto.wav","examples":[{"text":"No estoy dispuesto a hacerlo por ti.","en":"I'm not willing to do that for you.","audio":"https://tatoeba.org/en/audio/download/460381","words":[{"g":"no / not"},{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to do","l":"hacer"},{"g":"for / by"},{"g":"you","l":"tú"}]},{"text":"¿Cuánto estás dispuesta a pagar?","en":"How much are you willing to pay?","words":[{"g":"how much"},{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to pay"}]},{"text":"Ellos están dispuestos a ayudarnos.","en":"They are willing to help us out.","audio":"https://tatoeba.org/en/audio/download/684285","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to help","l":"ayudar"}]},{"text":"¿Estarías dispuesto a ayudar?","en":"Would you be willing to help?","words":[{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to help"}]},{"text":"¿Cuánto están ustedes dispuestas a pagar?","en":"How much are you willing to pay?","words":[{"g":"how much"},{"g":"to be","l":"estar"},{"g":"you all"},null,{"g":"to"},{"g":"to pay"}]}]}