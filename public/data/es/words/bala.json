{"id":"bala","lemma":"bala","pos":"noun","rank":1070,"glosses":["bullet"],"ipa":"/ˈbala/","gender":"f","forms":{"plural":"balas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-AdrianAbdulBaha-bala.wav","examples":[{"text":"No nos queda ninguna bala.","en":"We're out of bullets.","audio":"https://tatoeba.org/en/audio/download/454947"},{"text":"Ya no nos quedan balas.","en":"We're out of bullets.","audio":"https://tatoeba.org/en/audio/download/454946"},{"text":"Esa vez esquivamos la bala.","en":"We dodged a bullet on that one.","audio":"https://tatoeba.org/en/audio/download/722539"},{"text":"Tom usó todas sus balas.","en":"Tom used up all his bullets."},{"text":"La bala dio a su objetivo.","en":"The bullet found its mark.","audio":"https://tatoeba.org/en/audio/download/639315"}]}