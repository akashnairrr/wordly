{"id":"aburrido","lemma":"aburrido","pos":"adj","rank":1466,"glosses":["bored, fed up","boring, dull, tedious"],"ipa":"/abuˈrido/","forms":{"feminine":"aburrida","masculinePlural":"aburridos","femininePlural":"aburridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-AdrianAbdulBaha-aburrido.wav","examples":[{"text":"El golf es aburrido.","en":"Golf is boring.","audio":"https://tatoeba.org/en/audio/download/800348"},{"text":"Mi vida es aburrida.","en":"My life is boring.","audio":"https://tatoeba.org/en/audio/download/443531"},{"text":"Ustedes son tan aburridos.","en":"You guys are so boring.","audio":"https://tatoeba.org/en/audio/download/458862"},{"text":"Tom parece estar aburrido.","en":"Tom looks bored.","audio":"https://tatoeba.org/en/audio/download/799056"},{"text":"La fiesta estuvo aburrida.","en":"The party was boring.","audio":"https://tatoeba.org/en/audio/download/800923"}]}