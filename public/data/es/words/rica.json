{"id":"rica","lemma":"rica","pos":"noun","rank":1868,"glosses":["fenugreek (Trigonella foenum-graecum)"],"ipa":"/ˈrika/","gender":"f","forms":{"plural":"ricas"},"examples":[{"text":"Sé que eres rica.","en":"I know you are rich.","audio":"https://tatoeba.org/en/audio/download/125471"},{"text":"Las mandarinas son ricas en vitaminas.","en":"Mandarin oranges are rich in vitamins.","audio":"https://tatoeba.org/en/audio/download/412416"},{"text":"Mi madre es rica.","en":"My mother is well off.","audio":"https://tatoeba.org/en/audio/download/637086"},{"text":"Las naranjas son ricas en vitamina C.","en":"Oranges are rich in vitamin C.","audio":"https://tatoeba.org/en/audio/download/589683"},{"text":"No quiero ser rica.","en":"I don't want to be rich.","audio":"https://tatoeba.org/en/audio/download/83224"}]}