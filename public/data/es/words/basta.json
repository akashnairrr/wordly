{"id":"basta","lemma":"basta","pos":"intj","rank":391,"glosses":["stop!, enough!","just because!; none of your business!; no need to ask!; whatever!"],"ipa":"/ˈbasta/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q1321_%28spa%29-AdrianAbdulBaha-basta.wav","examples":[{"text":"Esto me basta.","en":"This'll do.","audio":"https://tatoeba.org/en/audio/download/412235","words":[{"g":"this"},{"g":"me"},null]},{"text":"Ya basta de llorar.","en":"Now stop crying.","audio":"https://tatoeba.org/en/audio/download/442021","words":[{"g":"now"},null,{"g":"of / from"},{"g":"to cry, to weep"}]},{"text":"Basta por hoy, estoy cansada.","en":"That's enough for today. I'm tired.","words":[null,null,null,{"g":"to be","l":"estar"},{"g":"tired, weary, wearied","l":"cansado"}],"phrases":[[1,3,"for now"]]},{"text":"A veces una palabra basta.","en":"One word is sometimes enough.","words":[null,null,{"g":"a"},{"g":"word"},null],"phrases":[[0,2,"sometimes"]]},{"text":"Ya, con eso basta.","en":"Knock it off, guys.","audio":"https://tatoeba.org/en/audio/download/448468","words":[{"g":"now"},{"g":"with"},{"g":"that","l":"ése"},null]}]}