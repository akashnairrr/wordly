{"id":"futuro","lemma":"futuro","pos":"noun","rank":492,"glosses":["future (the time ahead)","future, future tense"],"ipa":"/fuˈtuɾo/","gender":"m","forms":{"plural":"futuros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e4/LL-Q1321_%28spa%29-AdrianAbdulBaha-futuro.wav","examples":[{"text":"Piensa en tu futuro.","en":"Think of your future.","audio":"https://tatoeba.org/en/audio/download/131749"},{"text":"Nadie conoce el futuro.","en":"Nobody knows the future.","audio":"https://tatoeba.org/en/audio/download/582441"},{"text":"Tienes un futuro brillante.","en":"You have a bright future.","audio":"https://tatoeba.org/en/audio/download/519481"},{"text":"Estoy preocupado por mi futuro.","en":"I worry about my future.","audio":"https://tatoeba.org/en/audio/download/518770"},{"text":"Nos preocupamos por tu futuro.","en":"We worry about your future.","audio":"https://tatoeba.org/en/audio/download/732022"}]}