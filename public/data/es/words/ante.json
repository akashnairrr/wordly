{"id":"ante","lemma":"ante","pos":"noun","rank":680,"glosses":["elk","suede","tapir (large odd-toed ungulate with a long prehensile upper lip)"],"ipa":"/ˈante/","gender":"m","forms":{"plural":"antes","feminine":"anta","femininePlural":"antas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Precision27-ante.wav","formAudio":{"antes":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Precision27-antes.wav"},"examples":[{"text":"Una chica apareció ante mí.","en":"A girl appeared before me.","audio":"https://tatoeba.org/en/audio/download/639633","words":[{"g":"a"},{"g":"gal, chick"},{"g":"to appear","l":"aparecer"},null,{"g":"me"}]},{"text":"Todos somos iguales ante la ley.","en":"We're all equal before the law.","audio":"https://tatoeba.org/en/audio/download/1153010","words":[{"g":"all","l":"todo"},{"g":"to be","l":"ser"},{"g":"in the same way","l":"igual"},null,{"g":"the / her"},{"g":"law"}]},{"text":"Está justo ante tus ojos.","en":"It's right in front of your eyes.","audio":"https://tatoeba.org/en/audio/download/554631","words":[{"g":"to be","l":"estar"},{"g":"right, just"},null,{"g":"your"},{"g":"eye","l":"ojo"}]},{"text":"Ante el peligro me pongo en guardia.","en":"I put myself on guard against the danger.","words":[null,{"g":"the"},{"g":"danger, peril"},{"g":"me"},{"g":"orangutan"},null,null],"phrases":[[5,7,"en garde"]]},{"text":"No tengo que demostrar mi valía ante nadie.","en":"I don't have to prove myself to anybody.","audio":"https://tatoeba.org/en/audio/download/871951","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to show"},{"g":"my"},{"g":"worth"},null,{"g":"no one"}]}]}