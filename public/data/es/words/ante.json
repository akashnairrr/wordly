{"id":"ante","lemma":"ante","pos":"noun","rank":680,"glosses":["elk","suede","tapir (large odd-toed ungulate with a long prehensile upper lip)"],"ipa":"/ˈante/","gender":"m","forms":{"plural":"antes","feminine":"anta","femininePlural":"antas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Precision27-ante.wav","formAudio":{"antes":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Precision27-antes.wav"},"examples":[{"text":"Todos somos iguales ante la ley.","en":"We're all equal before the law.","audio":"https://tatoeba.org/en/audio/download/1153010","words":[{"g":"all","l":"todo"},{"g":"to be","l":"ser"},{"g":"in the same way","l":"igual"},null,{"g":"the / her"},{"g":"law"}]},{"text":"Una chica apareció ante mí.","en":"A girl appeared before me.","audio":"https://tatoeba.org/en/audio/download/639633","words":[{"g":"a"},{"g":"gal, chick"},{"g":"to appear","l":"aparecer"},null,{"g":"me"}]},{"text":"Está justo ante tus ojos.","en":"It's right in front of your eyes.","audio":"https://tatoeba.org/en/audio/download/554631","words":[{"g":"to be","l":"estar"},{"g":"right, just"},null,{"g":"your"},{"g":"eye","l":"ojo"}]},{"text":"Él estaba calmado ante el peligro.","en":"He was calm in the presence of danger.","audio":"https://tatoeba.org/en/audio/download/733502","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"calm"},null,{"g":"the"},{"g":"danger, peril"}]},{"text":"Deberías disculparte ante mí.","en":"You must excuse me.","audio":"https://tatoeba.org/en/audio/download/184583","words":[{"g":"to owe","l":"deber"},{"g":"to excuse","l":"disculpar"},null,{"g":"me"}]}]}