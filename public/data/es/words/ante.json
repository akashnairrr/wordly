{"id":"ante","lemma":"ante","pos":"noun","rank":234,"glosses":["elk","suede","tapir (large odd-toed ungulate with a long prehensile upper lip)"],"ipa":"/ˈante/","gender":"m","forms":{"plural":"antes","feminine":"anta","femininePlural":"antas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Precision27-ante.wav","formAudio":{"antes":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Precision27-antes.wav"},"examples":[{"text":"Deberías disculparte ante mí.","en":"You must excuse me.","audio":"https://tatoeba.org/en/audio/download/184583"},{"text":"Yo estaba aquí antes.","en":"I was here first.","audio":"https://tatoeba.org/en/audio/download/95842"},{"text":"Una chica apareció ante mí.","en":"A girl appeared before me.","audio":"https://tatoeba.org/en/audio/download/639633"},{"text":"La he visto antes.","en":"I saw her earlier.","audio":"https://tatoeba.org/en/audio/download/100974"},{"text":"Está justo ante tus ojos.","en":"It's right in front of your eyes.","audio":"https://tatoeba.org/en/audio/download/554631"}]}