{"id":"gripe","lemma":"gripe","pos":"noun","rank":3301,"glosses":["flu, influenza"],"ipa":"/ˈɡɾipe/","gender":"f","forms":{"plural":"gripes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q1321_%28spa%29-Marreromarco-gripe.wav","examples":[{"text":"Tengo gripe y estoy cansado.","en":"I have the flu and I'm tired.","words":[{"g":"to have","l":"tener"},null,{"g":"and"},{"g":"to be","l":"estar"},{"g":"tired, weary, wearied"}]},{"text":"Tengo un poco de gripe.","en":"I've got a touch of the flu.","words":[{"g":"to have","l":"tener"},null,null,{"g":"of / from"},null],"phrases":[[1,3,"a bit"]]},{"text":"Yo estaba en cama con gripe.","en":"I was in bed with the flu.","words":[{"g":"I"},{"g":"to be","l":"estar"},null,null,{"g":"with"},null],"phrases":[[2,4,"abed, in bed"]]},{"text":"He estado con gripe desde el lunes.","en":"I've had the flu since Monday.","audio":"https://tatoeba.org/en/audio/download/302982","words":[{"g":"to have","l":"haber"},{"g":"country, land"},{"g":"with"},null,{"g":"since"},{"g":"the"},{"g":"Monday"}]},{"text":"Tienes catarro, no gripe.","en":"What you have is a common cold, not the flu.","words":[{"g":"to have","l":"tener"},{"g":"cold"},{"g":"no / not"},null]}]}