{"id":"entrada","lemma":"entrada","pos":"noun","rank":867,"glosses":["entrance","entry, entering, admission, entryway","entry"],"ipa":"/enˈtɾada/","gender":"f","forms":{"plural":"entradas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-AdrianAbdulBaha-entrada.wav","examples":[{"text":"La entrada es libre.","en":"Admission is free.","audio":"https://tatoeba.org/en/audio/download/799037"},{"text":"Aquí están las entradas.","en":"Here are the tickets.","audio":"https://tatoeba.org/en/audio/download/455300"},{"text":"¿Dónde queda la entrada?","en":"Where's the entrance?","audio":"https://tatoeba.org/en/audio/download/454576"},{"text":"Yo pagué las entradas.","en":"I paid for the tickets.","audio":"https://tatoeba.org/en/audio/download/353693"},{"text":"¿Cuánto cuesta la entrada?","en":"How much does it cost to get in?","audio":"https://tatoeba.org/en/audio/download/607974"}]}