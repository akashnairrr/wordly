{"id":"totalmente","lemma":"totalmente","pos":"adv","rank":573,"glosses":["totally"],"ipa":"/toˌtalˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q1321_%28spa%29-Marreromarco-totalmente.wav","examples":[{"text":"Estoy totalmente de acuerdo.","en":"I totally agree.","audio":"https://tatoeba.org/en/audio/download/441668"},{"text":"Eso es totalmente mentira.","en":"That's a total lie.","audio":"https://tatoeba.org/en/audio/download/929674"},{"text":"Él estaba totalmente borracho.","en":"He was good and drunk.","audio":"https://tatoeba.org/en/audio/download/706861"},{"text":"Es totalmente mi culpa.","en":"It's totally my fault.","audio":"https://tatoeba.org/en/audio/download/461647"},{"text":"Eso es totalmente correcto.","en":"That's absolutely right.","audio":"https://tatoeba.org/en/audio/download/1187411"}]}