{"id":"honrado","lemma":"honrado","pos":"adj","rank":3469,"glosses":["honored","honorable","honest, truthful"],"ipa":"/onˈrado/","forms":{"feminine":"honrada","masculinePlural":"honrados","femininePlural":"honradas"},"examples":[{"text":"Tienes que ser honrado.","en":"You have to be honest.","audio":"https://tatoeba.org/en/audio/download/459113","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to be"},null]},{"text":"Me siento honrado de estar aquí.","en":"I'm honored to be here.","audio":"https://tatoeba.org/en/audio/download/460600","words":[{"g":"me"},{"g":"to seat","l":"sentar"},null,{"g":"of / from"},{"g":"to be"},{"g":"here"}]},{"text":"No puede ser un hombre honrado.","en":"He can't be an honest man.","audio":"https://tatoeba.org/en/audio/download/1197685","words":[null,null,null,{"g":"a"},{"g":"man"},null],"phrases":[[0,3,"it is impossible"]]},{"text":"Me siento honrado.","en":"I feel honored.","audio":"https://tatoeba.org/en/audio/download/415849","words":[{"g":"me"},{"g":"to seat","l":"sentar"},null]},{"text":"Debe ser un hombre honrado.","en":"He must be an honest man.","words":[{"g":"to owe","l":"deber"},{"g":"to be"},{"g":"a"},{"g":"man"},null]}]}