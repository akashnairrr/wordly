{"id":"rango","lemma":"rango","pos":"noun","rank":2466,"glosses":["rank","status, prestige","range (difference between largest and smallest observation)"],"ipa":"/ˈranɡo/","gender":"m","forms":{"plural":"rangos"},"order":2478,"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q1321_%28spa%29-Emanuelps27-rango.wav","examples":[{"text":"Sé cuál es el rango del soldado.","en":"I know what the soldier's rank is.","words":[{"g":"to know, to understand","l":"saber"},{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of the"},{"g":"soldier"}]},{"text":"Yo te supero en rango.","en":"I outrank you.","audio":"https://tatoeba.org/en/audio/download/440361","words":[{"g":"I"},{"g":"you"},{"g":"to surpass, exceed","l":"superar"},{"g":"in / on"},null]},{"text":"Tom tiene el rango de capitán.","en":"Tom holds the rank of captain.","words":[null,{"g":"to have","l":"tener"},{"g":"the"},null,{"g":"of / from"},{"g":"captain"}]}]}