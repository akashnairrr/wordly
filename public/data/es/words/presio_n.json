{"id":"presio_n","lemma":"presión","pos":"noun","rank":928,"glosses":["pressure"],"ipa":"/pɾeˈsjon/","gender":"f","forms":{"plural":"presiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q1321_%28spa%29-Marreromarco-presi%C3%B3n.wav","examples":[{"text":"Tengo la presión baja.","en":"I have low blood pressure.","audio":"https://tatoeba.org/en/audio/download/524397"},{"text":"Nunca presiones este botón.","en":"Never press this button."},{"text":"Déjame tomarte la presión.","en":"Let me take your blood pressure.","audio":"https://tatoeba.org/en/audio/download/538248"},{"text":"Creo que entiendo las presiones a las que estás sometido.","en":"I think I understand the pressures you are under."},{"text":"Permítame tomarle la presión.","en":"Let me take your blood pressure.","audio":"https://tatoeba.org/en/audio/download/538249"}]}