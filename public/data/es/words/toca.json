{"id":"toca","lemma":"toca","pos":"noun","rank":918,"glosses":["kerchief, turban cloth (so to say)"],"ipa":"/ˈtoka/","gender":"f","forms":{"plural":"tocas"},"examples":[{"text":"Me toca a mí.","en":"I'm next.","audio":"https://tatoeba.org/en/audio/download/302807"},{"text":"¿Tocas en una banda?","en":"Are you in a band?","audio":"https://tatoeba.org/en/audio/download/444379"},{"text":"¿A quién le toca?","en":"Who's first?","audio":"https://tatoeba.org/en/audio/download/438364"},{"text":"¿Aún tocas la flauta?","en":"Do you still play the flute?","audio":"https://tatoeba.org/en/audio/download/730613"},{"text":"Te toca a ti.","en":"It's your move.","audio":"https://tatoeba.org/en/audio/download/221791"}]}