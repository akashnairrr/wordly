{"id":"toca","lemma":"toca","pos":"noun","rank":915,"glosses":["kerchief, turban cloth (so to say)"],"ipa":"/ˈtoka/","gender":"f","forms":{"plural":"tocas"},"examples":[{"text":"Me toca a mí.","en":"I'm next.","audio":"https://tatoeba.org/en/audio/download/302807","words":[{"g":"me"},null,{"g":"to"},{"g":"me"}]},{"text":"¿A quién le toca?","en":"Who's first?","audio":"https://tatoeba.org/en/audio/download/438364","words":[{"g":"to"},{"g":"who"},{"g":"him / her"},null]},{"text":"Ahora te toca a ti.","en":"Now, you try.","audio":"https://tatoeba.org/en/audio/download/221792","words":[{"g":"now"},{"g":"you"},null,{"g":"to"},{"g":"you","l":"tú"}]},{"text":"Os toca a vosotros.","en":"Now, it's your turn.","audio":"https://tatoeba.org/en/audio/download/221793","words":[{"g":"you all","l":"vosotros"},null,{"g":"to"},{"g":"you all"}]},{"text":"Todavía no le toca a usted.","en":"It isn't your turn yet.","audio":"https://tatoeba.org/en/audio/download/301079","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"him / her"},null,{"g":"to"},{"g":"you (formal)"}]}]}