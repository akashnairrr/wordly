{"id":"inconveniente","lemma":"inconveniente","pos":"noun","rank":4420,"glosses":["problem, trouble, inconvenient","drawback (disadvantage)"],"ipa":"/inkombeˈnjente/","gender":"m","forms":{"plural":"inconvenientes"},"examples":[{"text":"Ese plan tiene algunos inconvenientes.","en":"That plan has certain disadvantages.","words":[{"g":"that"},{"g":"plan"},{"g":"to have","l":"tener"},{"g":"someone","l":"alguno"},null]},{"text":"No tiene inconveniente en que salgamos.","en":"He has no objection to our leaving.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"that"},{"g":"to go out","l":"salir"}]},{"text":"Lamentamos el inconveniente.","en":"We are sorry for the inconvenience.","words":[{"g":"to lament, to regret","l":"lamentar"},{"g":"the"},null]},{"text":"Deberás superar algunos inconvenientes.","en":"You'll have to overcome a few difficulties.","words":[{"g":"to owe","l":"deber"},{"g":"to surpass, exceed"},{"g":"someone","l":"alguno"},null]},{"text":"Es difícil superar este inconveniente sin cambiar drásticamente todo el sistema.","en":"It is difficult to overcome this shortcoming without drastically changing the whole system.","words":[{"g":"to be","l":"ser"},{"g":"difficult"},{"g":"to surpass, exceed"},{"g":"this"},null,{"g":"without"},{"g":"to change"},{"g":"drastically"},{"g":"all"},{"g":"the"},{"g":"system"}]}]}