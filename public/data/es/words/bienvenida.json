{"id":"bienvenida","lemma":"bienvenida","pos":"noun","rank":970,"glosses":["welcome","greeting"],"ipa":"/bjembeˈnida/","gender":"f","forms":{"plural":"bienvenidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-Marreromarco-bienvenida.wav","examples":[{"text":"Fue una sorpresa de bienvenida.","en":"It was a welcome surprise.","audio":"https://tatoeba.org/en/audio/download/299996"},{"text":"Las niñas no son bienvenidas.","en":"Girls aren't welcome."},{"text":"Nos dieron una cálida bienvenida.","en":"They gave us a warm greeting.","audio":"https://tatoeba.org/en/audio/download/514766"},{"text":"Bienvenidas.","en":"Welcome.","audio":"https://tatoeba.org/en/audio/download/503233"},{"text":"El capitán nos dio la bienvenida.","en":"The captain welcomed us.","audio":"https://tatoeba.org/en/audio/download/639510"}]}