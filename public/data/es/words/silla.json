{"id":"silla","lemma":"silla","pos":"noun","rank":1023,"glosses":["chair","saddle"],"ipa":"/ˈsiʝa/","gender":"f","forms":{"plural":"sillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-Eavqwiki-silla.wav","formAudio":{"sillas":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Eavqwiki-sillas.wav"},"examples":[{"text":"Yo hice esta silla.","en":"I made this chair.","audio":"https://tatoeba.org/en/audio/download/96619"},{"text":"Necesitamos tres sillas más.","en":"We need three more chairs.","audio":"https://tatoeba.org/en/audio/download/164875"},{"text":"Estás en mi silla.","en":"You're in my seat.","audio":"https://tatoeba.org/en/audio/download/449601"},{"text":"Ésas no son tus sillas.","en":"Those aren't your chairs.","audio":"https://tatoeba.org/en/audio/download/639196"},{"text":"Esta silla está ocupada.","en":"This seat is taken.","audio":"https://tatoeba.org/en/audio/download/501455"}]}