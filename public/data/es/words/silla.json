{"id":"silla","lemma":"silla","pos":"noun","rank":1020,"glosses":["chair","saddle"],"ipa":"/ˈsiʝa/","gender":"f","forms":{"plural":"sillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-Eavqwiki-silla.wav","formAudio":{"sillas":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Eavqwiki-sillas.wav"},"examples":[{"text":"Necesitamos tres sillas más.","en":"We need three more chairs.","audio":"https://tatoeba.org/en/audio/download/164875","words":[{"g":"to need","l":"necesitar"},{"g":"three"},null,{"g":"more"}]},{"text":"No pongas la silla allí.","en":"Don't put the chair there.","audio":"https://tatoeba.org/en/audio/download/451138","words":[{"g":"no / not"},{"g":"to put, to place","l":"poner"},{"g":"the / her"},null,{"g":"there"}]},{"text":"Las sillas estarán aquí mañana.","en":"The chairs will be here tomorrow.","audio":"https://tatoeba.org/en/audio/download/684480","words":[{"g":"the / them"},null,{"g":"to be","l":"estar"},{"g":"here"},{"g":"tomorrow"}]},{"text":"¿Podrías mover un poco la silla?","en":"Could you move the chair a bit?","audio":"https://tatoeba.org/en/audio/download/645510","words":[{"g":"to be able to, can","l":"poder"},{"g":"to move"},null,null,{"g":"the / her"},null],"phrases":[[2,4,"a bit"]]},{"text":"Es mi silla favorita.","en":"That's my favorite chair.","audio":"https://tatoeba.org/en/audio/download/57527","words":[{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"favorite/favourite","l":"favorito"}]}]}