{"id":"partido","lemma":"partido","pos":"noun","rank":740,"glosses":["party","game, match (chiefly for soccer)","hair parting or part"],"ipa":"/paɾˈtido/","gender":"m","forms":{"plural":"partidos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-AdrianAbdulBaha-partido.wav","formAudio":{"partidos":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-GlyphEnjoyer-partidos.wav"},"examples":[{"text":"Tengo partido el brazo.","en":"My arm is broken.","audio":"https://tatoeba.org/en/audio/download/419025"},{"text":"Tengo los labios partidos.","en":"I have chapped lips.","audio":"https://tatoeba.org/en/audio/download/449610"},{"text":"Se terminó el partido.","en":"The match is over.","audio":"https://tatoeba.org/en/audio/download/798007"},{"text":"Me gusta ir a ver partidos de béisbol.","en":"I like to go and watch baseball games.","audio":"https://tatoeba.org/en/audio/download/598972"},{"text":"Que comience el partido.","en":"Let the game begin.","audio":"https://tatoeba.org/en/audio/download/44113"}]}