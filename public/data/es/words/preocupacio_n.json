{"id":"preocupacio_n","lemma":"preocupación","pos":"noun","rank":2138,"glosses":["preoccupation","anxiety, worry"],"ipa":"/pɾeokupaˈθjon/","gender":"f","forms":{"plural":"preocupaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-Marreromarco-preocupaci%C3%B3n.wav","examples":[{"text":"Cuanto más dinero, más preocupaciones.","en":"More money means more problems.","audio":"https://tatoeba.org/en/audio/download/735177","words":[{"g":"as much [of]"},{"g":"more"},{"g":"money"},{"g":"more"},null]},{"text":"Gracias por su preocupación.","en":"Thank you for your concern.","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"his / her / your"},null]},{"text":"¿Cuáles son tus preocupaciones?","en":"What are your worries?","audio":"https://tatoeba.org/en/audio/download/461980","words":[{"g":"which one, what, which","l":"cuál"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Es mi única preocupación.","en":"That's my sole concern.","audio":"https://tatoeba.org/en/audio/download/639960","words":[{"g":"to be","l":"ser"},{"g":"my"},{"g":"only","l":"único"},null]},{"text":"No tengo preocupaciones.","en":"I've got no worries.","audio":"https://tatoeba.org/en/audio/download/450519","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]}]}