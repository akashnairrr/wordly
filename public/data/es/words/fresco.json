{"id":"fresco","lemma":"fresco","pos":"adj","rank":1681,"glosses":["fresh","cool (temperature)","cheeky"],"ipa":"/ˈfɾesko/","forms":{"feminine":"fresca","masculinePlural":"frescos","femininePlural":"frescas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-AdrianAbdulBaha-fresco.wav","examples":[{"text":"El pan está fresco.","en":"The bread is fresh.","audio":"https://tatoeba.org/en/audio/download/501318"},{"text":"La noche estaba fresca.","en":"The night was cool.","audio":"https://tatoeba.org/en/audio/download/501300"},{"text":"Quiero algunos huevos frescos.","en":"I want some fresh eggs.","audio":"https://tatoeba.org/en/audio/download/70211"},{"text":"Come más verduras frescas.","en":"Eat more fresh vegetables.","audio":"https://tatoeba.org/en/audio/download/517971"},{"text":"Empieza a hacer fresco.","en":"It's getting chilly.","audio":"https://tatoeba.org/en/audio/download/728646"}]}