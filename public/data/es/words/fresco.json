{"id":"fresco","lemma":"fresco","pos":"adj","rank":1678,"glosses":["fresh","cool (temperature)","cheeky"],"ipa":"/ˈfɾesko/","forms":{"feminine":"fresca","masculinePlural":"frescos","femininePlural":"frescas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-AdrianAbdulBaha-fresco.wav","examples":[{"text":"Necesitamos aire fresco.","en":"We need fresh air.","audio":"https://tatoeba.org/en/audio/download/68684","words":[{"g":"to need","l":"necesitar"},{"g":"air"},null]},{"text":"La noche estaba fresca.","en":"The night was cool.","audio":"https://tatoeba.org/en/audio/download/501300","words":[{"g":"the / her"},{"g":"night"},{"g":"to be","l":"estar"},null]},{"text":"Me gusta el aire fresco.","en":"I like fresh air.","audio":"https://tatoeba.org/en/audio/download/68537","words":[null,null,{"g":"the"},{"g":"air"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Quiero algunos huevos frescos.","en":"I want some fresh eggs.","audio":"https://tatoeba.org/en/audio/download/70211","words":[{"g":"to desire","l":"querer"},{"g":"someone","l":"alguno"},{"g":"guts, balls"},null]},{"text":"El agua del lago está fresca.","en":"The water in the lake is cool.","audio":"https://tatoeba.org/en/audio/download/703521","words":[{"g":"the"},{"g":"water"},{"g":"of the"},{"g":"lake"},{"g":"to be","l":"estar"},null]}]}