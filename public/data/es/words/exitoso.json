{"id":"exitoso","lemma":"exitoso","pos":"adj","rank":4104,"glosses":["successful (achieving or having achieved success)","prosperous, thriving (marked by success or prosperity)"],"ipa":"/eɡsiˈtoso/","forms":{"feminine":"exitosa","masculinePlural":"exitosos","femininePlural":"exitosas"},"examples":[{"text":"El concierto fue exitoso.","en":"The concert was successful.","audio":"https://tatoeba.org/en/audio/download/599085","words":[{"g":"the"},{"g":"concert"},{"g":"to be","l":"ser"},null]},{"text":"Quiero ser exitoso.","en":"I want to be successful.","words":[{"g":"to desire","l":"querer"},{"g":"to be"},null]},{"text":"Ella es una exitosa mujer de negocios.","en":"She's a successful businesswoman.","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"woman"},{"g":"of / from"},{"g":"business, enterprise","l":"negocio"}]},{"text":"Él es exitoso en todo.","en":"He is successful in everything.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"all"}]},{"text":"Esa compañía ha sido muy exitosa hasta ahora.","en":"That company has been very successful up to now.","words":[{"g":"that","l":"ese"},{"g":"company"},{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},null,null,null,null],"phrases":[[6,8,"up to now"]]}]}