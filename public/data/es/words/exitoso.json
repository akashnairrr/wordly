{"id":"exitoso","lemma":"exitoso","pos":"adj","rank":4106,"glosses":["successful (achieving or having achieved success)","prosperous, thriving (marked by success or prosperity)"],"ipa":"/eɡsiˈtoso/","forms":{"feminine":"exitosa","masculinePlural":"exitosos","femininePlural":"exitosas"},"order":4107,"examples":[{"text":"El concierto fue exitoso.","en":"The concert was successful.","audio":"https://tatoeba.org/en/audio/download/599085","words":[{"g":"the"},{"g":"concert"},{"g":"to be","l":"ser"},null]},{"text":"Quiero ser exitoso.","en":"I want to be successful.","words":[{"g":"to desire","l":"querer"},{"g":"to be"},null]},{"text":"Ella es una exitosa mujer de negocios.","en":"She's a successful businesswoman.","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"woman"},{"g":"of / from"},{"g":"business, enterprise","l":"negocio"}]}]}