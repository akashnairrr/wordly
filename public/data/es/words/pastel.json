{"id":"pastel","lemma":"pastel","pos":"noun","rank":1203,"glosses":["pastry","cake; pie","pastel"],"ipa":"/pasˈtel/","gender":"m","forms":{"plural":"pasteles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-AdrianAbdulBaha-pastel.wav","examples":[{"text":"Te hicimos un pastel.","en":"We made you a cake.","audio":"https://tatoeba.org/en/audio/download/548168"},{"text":"A mi también me gustan los pasteles.","en":"I also like cake.","audio":"https://tatoeba.org/en/audio/download/442375"},{"text":"¿Puedo comerme ese pastel?","en":"May I eat that cake?","audio":"https://tatoeba.org/en/audio/download/44353"},{"text":"Hay más de 15 tipos diferentes de pasteles.","en":"There are over 15 different kinds of pies.","audio":"https://tatoeba.org/en/audio/download/553766"},{"text":"Nadie comió el pastel.","en":"No one ate the cake.","audio":"https://tatoeba.org/en/audio/download/448523"}]}