{"id":"club","lemma":"club","pos":"noun","rank":615,"glosses":["club (an association of members joining together for some common purpose, especially sports or recreation)"],"ipa":"/ˈklub/","gender":"m","forms":{"plural":"clubs"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-AdrianAbdulBaha-club.wav","examples":[{"text":"Me encuentro con él en el club.","en":"I meet him at the club.","audio":"https://tatoeba.org/en/audio/download/460632","words":[{"g":"me"},{"g":"encounter, meeting"},{"g":"with"},{"g":"he"},{"g":"in / on"},{"g":"the"},null]},{"text":"¿A qué hora abre el club?","en":"What time does the club open?","audio":"https://tatoeba.org/en/audio/download/606441","words":[{"g":"to"},{"g":"what"},{"g":"hour"},{"g":"to open, open up","l":"abrir"},{"g":"the"},null]},{"text":"A veces le veo en el club.","en":"Sometimes I see him at the club.","audio":"https://tatoeba.org/en/audio/download/929644","words":[null,null,{"g":"him / her"},{"g":"to see, to spot","l":"ver"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"sometimes"]]},{"text":"Quien quiera entrar en nuestro club será bienvenido.","en":"Whoever wants to join our club will be welcome.","audio":"https://tatoeba.org/en/audio/download/610900","words":[{"g":"who"},{"g":"to desire","l":"querer"},{"g":"to enter"},{"g":"in / on"},{"g":"our, ours, to us"},null,{"g":"to be","l":"ser"},{"g":"welcome"}]},{"text":"¿Te unirás a nuestro club?","en":"Will you join our club?","audio":"https://tatoeba.org/en/audio/download/459015","words":[{"g":"you"},{"g":"to unite, join","l":"unir"},{"g":"to"},{"g":"our, ours, to us"},null]}]}