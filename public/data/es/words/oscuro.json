{"id":"oscuro","lemma":"oscuro","pos":"adj","rank":1126,"glosses":["dark (lacking light)","dark (deep in hue)","obscure, unclear"],"ipa":"/osˈkuɾo/","forms":{"feminine":"oscura","masculinePlural":"oscuros","femininePlural":"oscuras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-AdrianAbdulBaha-oscuro.wav","examples":[{"text":"Prefiero el rojo oscuro.","en":"I like dark red better.","audio":"https://tatoeba.org/en/audio/download/459914"},{"text":"La habitación es oscura.","en":"The room is dark.","audio":"https://tatoeba.org/en/audio/download/443785"},{"text":"Los gatos pueden ver incluso en lugares oscuros.","en":"Cats can see even in dark places.","audio":"https://tatoeba.org/en/audio/download/514980"},{"text":"Siempre lleva gafas oscuras.","en":"He always wears dark glasses.","audio":"https://tatoeba.org/en/audio/download/933476"},{"text":"Tenía el pelo castaño oscuro.","en":"He had dark brown hair.","audio":"https://tatoeba.org/en/audio/download/50996"}]}