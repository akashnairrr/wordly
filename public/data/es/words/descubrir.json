{"id":"descubrir","lemma":"descubrir","pos":"verb","rank":1286,"glosses":["to discover","to reveal","to invent"],"ipa":"/deskuˈbɾiɾ/","conjugation":{"indicative":{"present":{"1s":"descubro","2s":"descubres","3s":"descubre","1p":"descubrimos","2p":"descubrís","3p":"descubren"},"imperfect":{"1s":"descubría","2s":"descubrías","3s":"descubría","1p":"descubríamos","2p":"descubríais","3p":"descubrían"},"preterite":{"1s":"descubrí","2s":"descubriste","3s":"descubrió","1p":"descubrimos","2p":"descubristeis","3p":"descubrieron"},"future":{"1s":"descubriré","2s":"descubrirás","3s":"descubrirá","1p":"descubriremos","2p":"descubriréis","3p":"descubrirán"},"conditional":{"1s":"descubriría","2s":"descubrirías","3s":"descubriría","1p":"descubriríamos","2p":"descubriríais","3p":"descubrirían"}},"subjunctive":{"present":{"1s":"descubra","2s":"descubras","3s":"descubra","1p":"descubramos","2p":"descubráis","3p":"descubran"},"imperfect":{"1s":"descubriera","2s":"descubrieras","3s":"descubriera","1p":"descubriéramos","2p":"descubrierais","3p":"descubrieran"}},"imperative":{"affirmative":{"2s":"descubre","3s":"descubra","1p":"descubramos","2p":"descubrid","3p":"descubran"},"negative":{"2s":"descubras","3s":"descubra","1p":"descubramos","2p":"descubráis","3p":"descubran"}}},"nonFinite":{"gerund":"descubriendo","participle":"descubierto"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-AdrianAbdulBaha-descubrir.wav","examples":[{"text":"Nadie puede descubrir la solución.","en":"No one can figure it out.","audio":"https://tatoeba.org/en/audio/download/804035"},{"text":"Los científicos siguen descubriendo nuevas medicinas, por lo tanto, siempre hay esperanza para las personas que están en coma.","en":"Scientists continue to discover new medicines, so there is always hope for people who are in comas.","audio":"https://tatoeba.org/en/audio/download/692483"},{"text":"Hemos descubierto dónde vive.","en":"We found out where he lives.","audio":"https://tatoeba.org/en/audio/download/333043"},{"text":"Cada vez que leo este libro descubro algo nuevo.","en":"Every time I read this book, I find something new.","audio":"https://tatoeba.org/en/audio/download/581590"},{"text":"Cuanto más estudias, más descubres tu ignorancia.","en":"The more you study, the more you discover your ignorance."}]}