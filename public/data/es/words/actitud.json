{"id":"actitud","lemma":"actitud","pos":"noun","rank":1671,"glosses":["posture, pose, stance","attitude, disposition, policy"],"ipa":"/aɡtiˈtud/","gender":"f","forms":{"plural":"actitudes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-AdrianAbdulBaha-actitud.wav","examples":[{"text":"Esa es la actitud.","en":"That's the attitude.","audio":"https://tatoeba.org/en/audio/download/799963"},{"text":"Me agrada tu actitud.","en":"I like your attitude.","audio":"https://tatoeba.org/en/audio/download/454224"},{"text":"Me preocupa tu actitud.","en":"I'm worried about your attitude.","audio":"https://tatoeba.org/en/audio/download/765588"},{"text":"No me gusta tu actitud.","en":"I don't like your attitude.","audio":"https://tatoeba.org/en/audio/download/506650"},{"text":"Mi actitud hacia él cambió.","en":"My attitude towards him changed.","audio":"https://tatoeba.org/en/audio/download/582381"}]}