{"id":"actitud","lemma":"actitud","pos":"noun","rank":1668,"glosses":["posture, pose, stance","attitude, disposition, policy"],"ipa":"/aɡtiˈtud/","gender":"f","forms":{"plural":"actitudes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-AdrianAbdulBaha-actitud.wav","examples":[{"text":"No me gusta tu actitud.","en":"I don't like your attitude.","audio":"https://tatoeba.org/en/audio/download/506650","words":[{"g":"no / not"},null,null,{"g":"your"},null],"phrases":[[1,3,"like, thumbs up"]]},{"text":"Mi actitud hacia él cambió.","en":"My attitude towards him changed.","audio":"https://tatoeba.org/en/audio/download/582381","words":[{"g":"my"},null,{"g":"toward, towards"},{"g":"he"},{"g":"to change","l":"cambiar"}]},{"text":"¿Qué piensas de su actitud?","en":"What do you think of her attitude?","audio":"https://tatoeba.org/en/audio/download/1196841","words":[{"g":"what"},{"g":"to think, ponder","l":"pensar"},{"g":"of / from"},{"g":"his / her / your"},null]},{"text":"Esa es la actitud.","en":"That's the attitude.","audio":"https://tatoeba.org/en/audio/download/799963","words":[{"g":"that","l":"ese"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"Él tiene un problema de actitud.","en":"He has an attitude problem.","audio":"https://tatoeba.org/en/audio/download/639795","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"problem"},{"g":"of / from"},null]}]}