{"id":"victoria","lemma":"victoria","pos":"noun","rank":976,"glosses":["victory","triumph"],"ipa":"/biɡˈtoɾja/","gender":"f","forms":{"plural":"victorias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q1321_%28spa%29-AdrianAbdulBaha-victoria.wav","examples":[{"text":"La victoria es nuestra.","en":"The victory is ours.","audio":"https://tatoeba.org/en/audio/download/42242","words":[{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"our, ours, to us","l":"nuestro"}]},{"text":"Es una victoria fácil.","en":"It's an easy victory.","audio":"https://tatoeba.org/en/audio/download/454778","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"easy, facile, simple"}]},{"text":"Su victoria lo hizo un héroe.","en":"His victory made him a hero.","words":[{"g":"his / her / your"},null,{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"a"},{"g":"hero"}]},{"text":"Sin honor, la victoria pierde sentido.","en":"Without honor, victory is hollow.","words":[{"g":"without"},{"g":"honor"},{"g":"the / her"},null,{"g":"to lose","l":"perder"},{"g":"sense"}]},{"text":"No hay expectativas de victoria.","en":"We have no expectations of victory.","audio":"https://tatoeba.org/en/audio/download/527471","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"expectation","l":"expectativa"},{"g":"of / from"},null]}]}