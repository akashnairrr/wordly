{"id":"suceder","lemma":"suceder","pos":"verb","rank":481,"glosses":["to happen, to befall, to occur","to succeed to, to follow","to succeed, to triumph"],"ipa":"/suθeˈdeɾ/","conjugation":{"indicative":{"present":{"1s":"sucedo","2s":"sucedes","3s":"sucede","1p":"sucedemos","2p":"sucedéis","3p":"suceden"},"imperfect":{"1s":"sucedía","2s":"sucedías","3s":"sucedía","1p":"sucedíamos","2p":"sucedíais","3p":"sucedían"},"preterite":{"1s":"sucedí","2s":"sucediste","3s":"sucedió","1p":"sucedimos","2p":"sucedisteis","3p":"sucedieron"},"future":{"1s":"sucederé","2s":"sucederás","3s":"sucederá","1p":"sucederemos","2p":"sucederéis","3p":"sucederán"},"conditional":{"1s":"sucedería","2s":"sucederías","3s":"sucedería","1p":"sucederíamos","2p":"sucederíais","3p":"sucederían"}},"subjunctive":{"present":{"1s":"suceda","2s":"sucedas","3s":"suceda","1p":"sucedamos","2p":"sucedáis","3p":"sucedan"},"imperfect":{"1s":"sucediera","2s":"sucedieras","3s":"sucediera","1p":"sucediéramos","2p":"sucedierais","3p":"sucedieran"}},"imperative":{"affirmative":{"2s":"sucede","3s":"suceda","1p":"sucedamos","2p":"suceded","3p":"sucedan"},"negative":{"2s":"sucedas","3s":"suceda","1p":"sucedamos","2p":"sucedáis","3p":"sucedan"}}},"nonFinite":{"gerund":"sucediendo","participle":"sucedido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q1321_%28spa%29-Marreromarco-suceder.wav","examples":[{"text":"Cualquier cosa podría suceder.","en":"Anything could happen.","audio":"https://tatoeba.org/en/audio/download/453598"},{"text":"Lleva sucediendo demasiado tiempo.","en":"It's gone on too long.","audio":"https://tatoeba.org/en/audio/download/302011"},{"text":"Dime qué ha sucedido.","en":"Tell me what happened.","audio":"https://tatoeba.org/en/audio/download/516449"},{"text":"También me sucede a mí.","en":"It's happening to me, too.","audio":"https://tatoeba.org/en/audio/download/611325"},{"text":"En este libro suceden muchas coincidencias.","en":"In this book, lots of coincidences happen."}]}