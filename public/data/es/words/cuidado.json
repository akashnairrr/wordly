{"id":"cuidado","lemma":"cuidado","pos":"noun","rank":273,"glosses":["care (close attention; concern)","care (maintenance, upkeep)","care (the treatment of those in need)"],"ipa":"/kwiˈdado/","gender":"m","forms":{"plural":"cuidados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q1321_%28spa%29-Marreromarco-cuidado.wav","examples":[{"text":"¡Tom, ten cuidado!","en":"Tom, be careful!","audio":"https://tatoeba.org/en/audio/download/138097","words":[null,{"g":"to have","l":"tener"},null]},{"text":"Los niños estaban bien cuidados.","en":"The children were well looked after.","audio":"https://tatoeba.org/en/audio/download/932189","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"estar"},{"g":"well"},null]},{"text":"¡Cuidado con el perro!","en":"Beware of the dog!","audio":"https://tatoeba.org/en/audio/download/39677","words":[null,{"g":"with"},{"g":"the"},{"g":"dog"}]},{"text":"¡Ten cuidado con los dedos!","en":"Watch your fingers!","audio":"https://tatoeba.org/en/audio/download/501532","words":[{"g":"to have","l":"tener"},null,{"g":"with"},{"g":"the / them"},{"g":"digit: finger or toe","l":"dedo"}]},{"text":"Yo que tú tendría cuidado.","en":"I'd be careful if I were you.","audio":"https://tatoeba.org/en/audio/download/735084","words":[null,null,null,{"g":"to have","l":"tener"},null],"phrases":[[0,3,"if I were you"]]}]}