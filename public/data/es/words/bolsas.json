{"id":"bolsas","lemma":"bolsas","pos":"noun","rank":2304,"glosses":["dickweed; shithead; dickhead"],"ipa":"/ˈbolsas/","gender":"m","forms":{"plural":"bolsas"},"examples":[{"text":"Sube las bolsas arriba.","en":"Take the bags upstairs.","audio":"https://tatoeba.org/en/audio/download/514957","words":[{"g":"to go up or come up","l":"subir"},{"g":"the / them"},null,{"g":"come on!"}]},{"text":"Compré dos bolsas de palomitas.","en":"I bought two bags of popcorn.","audio":"https://tatoeba.org/en/audio/download/606487","words":[{"g":"to buy","l":"comprar"},{"g":"dung, excrement"},null,{"g":"of / from"},{"g":"popcorn","l":"palomita"}]},{"text":"La anciana cansada tenía bolsas bajo los ojos.","en":"The tired old lady had bags under her eyes.","audio":"https://tatoeba.org/en/audio/download/691659","words":[{"g":"the / her"},{"g":"elderly","l":"anciano"},{"g":"tired, weary, wearied","l":"cansado"},{"g":"to have","l":"tener"},null,{"g":"short"},{"g":"the / them"},{"g":"eye","l":"ojo"}]},{"text":"Estate pendiente de las bolsas.","en":"Keep an eye on the bags.","audio":"https://tatoeba.org/en/audio/download/514877","words":[{"g":"to be","l":"estar"},{"g":"pending"},{"g":"of / from"},{"g":"the / them"},null]},{"text":"Vigila las bolsas.","en":"Keep an eye on the bags.","audio":"https://tatoeba.org/en/audio/download/511998","words":[{"g":"to watch over","l":"vigilar"},{"g":"the / them"},null]}]}