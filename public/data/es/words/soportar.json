{"id":"soportar","lemma":"soportar","pos":"verb","rank":1524,"glosses":["to bear, to endure, to withstand, put up with, tolerate, to stomach, to weather, to handle","to support a weight or load"],"ipa":"/sopoɾˈtaɾ/","conjugation":{"indicative":{"present":{"1s":"soporto","2s":"soportas","3s":"soporta","1p":"soportamos","2p":"soportáis","3p":"soportan"},"imperfect":{"1s":"soportaba","2s":"soportabas","3s":"soportaba","1p":"soportábamos","2p":"soportabais","3p":"soportaban"},"preterite":{"1s":"soporté","2s":"soportaste","3s":"soportó","1p":"soportamos","2p":"soportasteis","3p":"soportaron"},"future":{"1s":"soportaré","2s":"soportarás","3s":"soportará","1p":"soportaremos","2p":"soportaréis","3p":"soportarán"},"conditional":{"1s":"soportaría","2s":"soportarías","3s":"soportaría","1p":"soportaríamos","2p":"soportaríais","3p":"soportarían"}},"subjunctive":{"present":{"1s":"soporte","2s":"soportes","3s":"soporte","1p":"soportemos","2p":"soportéis","3p":"soporten"},"imperfect":{"1s":"soportara","2s":"soportaras","3s":"soportara","1p":"soportáramos","2p":"soportarais","3p":"soportaran"}},"imperative":{"affirmative":{"2s":"soporta","3s":"soporte","1p":"soportemos","2p":"soportad","3p":"soporten"},"negative":{"2s":"soportes","3s":"soporte","1p":"soportemos","2p":"soportéis","3p":"soporten"}}},"nonFinite":{"gerund":"soportando","participle":"soportado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dd/LL-Q1321_%28spa%29-Marreromarco-soportar.wav","examples":[{"text":"No puedo soportar verlo.","en":"I can't bear the sight of him.","audio":"https://tatoeba.org/en/audio/download/506214"},{"text":"Ellos han soportado muchas dificultades.","en":"They endured many difficulties.","audio":"https://tatoeba.org/en/audio/download/770080"},{"text":"No soporto el golf.","en":"I can't stand golf.","audio":"https://tatoeba.org/en/audio/download/449672"},{"text":"Soy un hombre que no soporta estar solo.","en":"I'm a man who can't stand being alone.","audio":"https://tatoeba.org/en/audio/download/689086"},{"text":"Algunos hombres no soportan que su mujer gane más dinero.","en":"Some men can't stand their wives earning more than them.","audio":"https://tatoeba.org/en/audio/download/720895"}]}