{"id":"ansioso","lemma":"ansioso","pos":"adj","rank":3152,"glosses":["anxious","eager, agog"],"ipa":"/anˈsjoso/","forms":{"feminine":"ansiosa","masculinePlural":"ansiosos","femininePlural":"ansiosas"},"examples":[{"text":"¿No estás ansioso?","en":"Aren't you anxious?","audio":"https://tatoeba.org/en/audio/download/448979","words":[{"g":"no / not"},{"g":"to be","l":"estar"},null]},{"text":"Estoy ansioso de verte.","en":"I'm anxious to see you.","audio":"https://tatoeba.org/en/audio/download/461069","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to see, to spot","l":"ver"}]},{"text":"Estamos ansiosos por que vuelvas.","en":"We were all anxious for your return.","words":[{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"that"},{"g":"to return","l":"volver"}]},{"text":"Estoy ansioso por comenzar.","en":"I'm anxious to get started.","audio":"https://tatoeba.org/en/audio/download/552065","words":[{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"to begin, to commence"}]},{"text":"Todos están ansiosos por ver el partido.","en":"Everyone is looking forward to watching the game.","audio":"https://tatoeba.org/en/audio/download/608512","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"to see, to spot"},{"g":"the"},{"g":"party"}]}]}