{"id":"valiente","lemma":"valiente","pos":"adj","rank":1243,"glosses":["brave, courageous, fearless","valiant, gallant, doughty","gritty, plucky, gutsy, spunky"],"ipa":"/baˈljente/","forms":{"femininePlural":"valientes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-AdrianAbdulBaha-valiente.wav","examples":[{"text":"Él es muy valiente.","en":"He is very brave.","audio":"https://tatoeba.org/en/audio/download/442453"},{"text":"No eran para nada valientes.","en":"They were not brave at all."},{"text":"Usted es muy valiente.","en":"You're very brave.","audio":"https://tatoeba.org/en/audio/download/449904"},{"text":"La fortuna sonríe a los valientes.","en":"Luck comes to those who look for it."},{"text":"Es usted muy valiente.","en":"You're very brave.","audio":"https://tatoeba.org/en/audio/download/449014"}]}