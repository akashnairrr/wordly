{"id":"valiente","lemma":"valiente","pos":"adj","rank":1240,"glosses":["brave, courageous, fearless","valiant, gallant, doughty","gritty, plucky, gutsy, spunky"],"ipa":"/baˈljente/","forms":{"femininePlural":"valientes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-AdrianAbdulBaha-valiente.wav","examples":[{"text":"¡Usted es muy valiente!","en":"You're really brave.","audio":"https://tatoeba.org/en/audio/download/721594","words":[{"g":"you (formal)"},{"g":"to be","l":"ser"},null,null]},{"text":"Sois muy valientes.","en":"You're very brave.","audio":"https://tatoeba.org/en/audio/download/449905","words":[{"g":"to be","l":"ser"},null,null]},{"text":"Eres muy valiente, ¿verdad?","en":"You're very brave, aren't you?","audio":"https://tatoeba.org/en/audio/download/645551","words":[{"g":"to be","l":"ser"},null,null,{"g":"truth"}]},{"text":"No es usted tan valiente como parece.","en":"You're not as brave as you look.","audio":"https://tatoeba.org/en/audio/download/706070","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"you (formal)"},{"g":"so, as"},null,{"g":"as"},{"g":"to seem, to see fit","l":"parecer"}]},{"text":"Seamos valientes.","en":"Let's be brave.","audio":"https://tatoeba.org/en/audio/download/441076","words":[{"g":"to be","l":"ser"},null]}]}