{"id":"libertad","lemma":"libertad","pos":"noun","rank":660,"glosses":["liberty, freedom","latitude, leeway"],"ipa":"/libeɾˈta/","gender":"f","forms":{"plural":"libertades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-GlyphEnjoyer-libertad.wav","examples":[{"text":"Quiero mi libertad.","en":"I want my freedom.","audio":"https://tatoeba.org/en/audio/download/443842","words":[{"g":"to desire","l":"querer"},{"g":"my"},null]},{"text":"Dame la libertad o dame la muerte.","en":"Give me liberty or give me death.","audio":"https://tatoeba.org/en/audio/download/684343","words":[{"g":"to give, to give out","l":"dar"},{"g":"the / her"},null,{"g":"or"},{"g":"to give, to give out","l":"dar"},{"g":"the / her"},{"g":"death"}]},{"text":"Vive en libertad o muere.","en":"Live free or die.","audio":"https://tatoeba.org/en/audio/download/637048","words":[{"g":"to applaud","l":"vivar"},{"g":"in / on"},null,{"g":"or"},{"g":"to die","l":"morir"}]},{"text":"La libertad no es gratis.","en":"Freedom is not free.","audio":"https://tatoeba.org/en/audio/download/733115","words":[{"g":"the / her"},null,{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"free, without charge"}]},{"text":"Me gustaría verte cuando estés en libertad.","en":"I'd like to see you when you're free.","audio":"https://tatoeba.org/en/audio/download/805863","words":[{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"to see, to spot","l":"ver"},{"g":"when"},{"g":"to be","l":"estar"},{"g":"in / on"},null]}]}