{"id":"libertad","lemma":"libertad","pos":"noun","rank":663,"glosses":["liberty, freedom","latitude, leeway"],"ipa":"/libeɾˈta/","gender":"f","forms":{"plural":"libertades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-GlyphEnjoyer-libertad.wav","examples":[{"text":"Lucharon por la libertad.","en":"They fought for freedom.","audio":"https://tatoeba.org/en/audio/download/506410"},{"text":"Debemos respetar las libertades individuales.","en":"We must respect individual liberty."},{"text":"Lucharon por su libertad.","en":"They fought for their liberty.","audio":"https://tatoeba.org/en/audio/download/1187352"},{"text":"Vive en libertad o muere.","en":"Live free or die.","audio":"https://tatoeba.org/en/audio/download/637048"},{"text":"La libertad no es gratis.","en":"Freedom is not free.","audio":"https://tatoeba.org/en/audio/download/733115"}]}