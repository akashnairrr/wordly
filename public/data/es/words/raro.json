{"id":"raro","lemma":"raro","pos":"adj","rank":451,"glosses":["rare","strange, odd"],"ipa":"/ˈraɾo/","forms":{"feminine":"rara","masculinePlural":"raros","femininePlural":"raras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-raro.wav","examples":[{"text":"Tom no es raro.","en":"Tom isn't weird.","audio":"https://tatoeba.org/en/audio/download/800437"},{"text":"Esta leche huele rara.","en":"This milk smells funny.","audio":"https://tatoeba.org/en/audio/download/505975"},{"text":"¿De dónde has sacado esos zapatos tan raros?","en":"Where did you get those strange-looking shoes?","audio":"https://tatoeba.org/en/audio/download/692753"},{"text":"Él tiene ideas raras.","en":"He has strange ideas.","audio":"https://tatoeba.org/en/audio/download/453563"},{"text":"¿No es eso raro?","en":"Isn't that weird?","audio":"https://tatoeba.org/en/audio/download/442799"}]}