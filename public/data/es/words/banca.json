{"id":"banca","lemma":"banca","pos":"noun","rank":4912,"glosses":["small bench","seat (in an elective body)","financial system"],"ipa":"/ˈbanka/","gender":"f","forms":{"plural":"bancas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q1321_%28spa%29-Akhram-banca.wav","examples":[{"text":"Siéntate en la banca.","en":"Sit down on the bench.","audio":"https://tatoeba.org/en/audio/download/77883","words":[{"g":"to seat","l":"sentar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Él estaba sentado en una banca.","en":"He was sitting on a bench.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"seated"},{"g":"in / on"},{"g":"a"},null]},{"text":"Hay una banca debajo del árbol.","en":"There is a bench under the tree.","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"underneath"},{"g":"of the"},{"g":"tree"}]},{"text":"Nosotros estamos casi en banca rota.","en":"We're almost broke.","audio":"https://tatoeba.org/en/audio/download/800201","words":[{"g":"we"},{"g":"to be","l":"estar"},{"g":"almost"},{"g":"in / on"},null,{"g":"broken","l":"roto"}]},{"text":"Sentémonos en la banca.","en":"Let's sit down on the bench.","audio":"https://tatoeba.org/en/audio/download/735764","words":[{"g":"to seat","l":"sentar"},{"g":"in / on"},{"g":"the / her"},null]}]}