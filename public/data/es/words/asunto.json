{"id":"asunto","lemma":"asunto","pos":"noun","rank":472,"glosses":["matter; issue; business","affair (romantic relationship)"],"ipa":"/aˈsunto/","gender":"m","forms":{"plural":"asuntos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q1321_%28spa%29-AdrianAbdulBaha-asunto.wav","examples":[{"text":"Eso es asunto mío.","en":"That's my affair.","audio":"https://tatoeba.org/en/audio/download/444359"},{"text":"¡Métete en tus asuntos!","en":"Mind your own business!","audio":"https://tatoeba.org/en/audio/download/460411"},{"text":"Es un asunto complicado.","en":"It's a complex issue.","audio":"https://tatoeba.org/en/audio/download/454747"},{"text":"¡Meteos en vuestros asuntos!","en":"Mind your own business!","audio":"https://tatoeba.org/en/audio/download/460414"},{"text":"No es asunto tuyo.","en":"None of your business.","audio":"https://tatoeba.org/en/audio/download/35227"}]}