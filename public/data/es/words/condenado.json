{"id":"condenado","lemma":"condenado","pos":"adj","rank":2213,"glosses":["convicted","doomed","tired, fed up"],"ipa":"/kondeˈnado/","forms":{"feminine":"condenada","masculinePlural":"condenados","femininePlural":"condenadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-Marreromarco-condenado.wav","examples":[{"text":"Él fue condenado a muerte.","en":"He was condemned to death.","audio":"https://tatoeba.org/en/audio/download/585694","words":[{"g":"he"},{"g":"to be","l":"ser"},null,null,null],"phrases":[[3,5,"to death"]]},{"text":"Ese hombre debería ser condenado a muerte.","en":"That man should be sentenced to death.","audio":"https://tatoeba.org/en/audio/download/688883","words":[{"g":"that"},{"g":"man"},{"g":"to owe","l":"deber"},{"g":"to be"},null,null,null],"phrases":[[5,7,"to death"]]},{"text":"Estamos condenados.","en":"We are doomed.","audio":"https://tatoeba.org/en/audio/download/443041","words":[{"g":"to be","l":"estar"},null]},{"text":"Él fue condenado a tres años en prisión.","en":"He was sentenced to three years in jail.","audio":"https://tatoeba.org/en/audio/download/767705","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"to"},{"g":"three"},{"g":"year","l":"año"},{"g":"in / on"},{"g":"prison"}]},{"text":"Estás condenado al fracaso.","en":"You're bound to fail.","audio":"https://tatoeba.org/en/audio/download/551400","words":[{"g":"to be","l":"estar"},null,{"g":"to the"},{"g":"downfall"}]}]}