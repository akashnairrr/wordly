{"id":"resto","lemma":"resto","pos":"noun","rank":444,"glosses":["rest, remainder","remainder"],"ipa":"/ˈresto/","gender":"m","forms":{"plural":"restos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Marreromarco-resto.wav","examples":[{"text":"¿Dónde está el resto?","en":"Where's the rest?","audio":"https://tatoeba.org/en/audio/download/443769"},{"text":"Tom se comió los restos.","en":"Tom ate the leftovers.","audio":"https://tatoeba.org/en/audio/download/804374"},{"text":"Puedes quedarte con el resto.","en":"You can have the rest.","audio":"https://tatoeba.org/en/audio/download/459765"},{"text":"Comí los restos en el almuerzo.","en":"I ate leftovers for lunch.","audio":"https://tatoeba.org/en/audio/download/804378"},{"text":"Quédate el resto para ti.","en":"Keep the rest for yourself.","audio":"https://tatoeba.org/en/audio/download/635362"}]}