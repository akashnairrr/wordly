{"id":"hora","lemma":"hora","pos":"noun","rank":181,"glosses":["hour (a time period of sixty minutes)","time (the moment, as indicated by a clock or similar device)","high time (usually with \"ya\")"],"ipa":"/ˈoɾa/","gender":"f","forms":{"plural":"horas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-AdrianAbdulBaha-hora.wav","formAudio":{"horas":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-Precision27-horas.wav"},"examples":[{"text":"Estará aquí en media hora.","en":"He will be here in half an hour.","audio":"https://tatoeba.org/en/audio/download/354570","words":[{"g":"to be","l":"estar"},{"g":"here"},{"g":"in / on"},{"g":"half"},null]},{"text":"¿Cuántas horas de sueño necesitas?","en":"How many hours of sleep do you need?","audio":"https://tatoeba.org/en/audio/download/1577","words":[{"g":"how many"},null,{"g":"of / from"},{"g":"sleep, slumber"},{"g":"to need","l":"necesitar"}]},{"text":"¿Podría dormir un par de horas?","en":"Could I get a few hours of sleep?","audio":"https://tatoeba.org/en/audio/download/578251","words":[{"g":"to be able to, can","l":"poder"},{"g":"to sleep"},{"g":"a"},{"g":"pair"},{"g":"of / from"},null]},{"text":"Dame una hora.","en":"Give me an hour.","audio":"https://tatoeba.org/en/audio/download/441576","words":[{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"¿Qué hora es allí?","en":"What time is it there?","audio":"https://tatoeba.org/en/audio/download/459445","words":[{"g":"what"},null,{"g":"to be","l":"ser"},{"g":"there"}]}]}