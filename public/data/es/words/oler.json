{"id":"oler","lemma":"oler","pos":"verb","rank":1197,"glosses":["to smell (perceive by scent)","to pry into, investigate (make inquiries where one is not welcome)","to smell out, uncover (find out by prying)"],"ipa":"/oˈleɾ/","conjugation":{"indicative":{"present":{"1s":"huelo","2s":"hueles","3s":"huele","1p":"olemos","2p":"oléis","3p":"huelen"},"imperfect":{"1s":"olía","2s":"olías","3s":"olía","1p":"olíamos","2p":"olíais","3p":"olían"},"preterite":{"1s":"olí","2s":"oliste","3s":"olió","1p":"olimos","2p":"olisteis","3p":"olieron"},"future":{"1s":"oleré","2s":"olerás","3s":"olerá","1p":"oleremos","2p":"oleréis","3p":"olerán"},"conditional":{"1s":"olería","2s":"olerías","3s":"olería","1p":"oleríamos","2p":"oleríais","3p":"olerían"}},"subjunctive":{"present":{"1s":"huela","2s":"huelas","3s":"huela","1p":"olamos","2p":"oláis","3p":"huelan"},"imperfect":{"1s":"oliera","2s":"olieras","3s":"oliera","1p":"oliéramos","2p":"olierais","3p":"olieran"}},"imperative":{"affirmative":{"2s":"huele","3s":"huela","1p":"olamos","2p":"oled","3p":"huelan"},"negative":{"2s":"huelas","3s":"huela","1p":"olamos","2p":"oláis","3p":"huelan"}}},"nonFinite":{"gerund":"oliendo","participle":"olido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Rodelar-oler.wav","examples":[{"text":"Puedo oler el océano.","en":"I can smell the ocean.","audio":"https://tatoeba.org/en/audio/download/453968"},{"text":"La niña está oliendo las flores.","en":"The girl is smelling the flowers."},{"text":"Huelo algo que apesta.","en":"I smell something awful.","audio":"https://tatoeba.org/en/audio/download/606693"},{"text":"Hueles mal.","en":"You smell bad.","audio":"https://tatoeba.org/en/audio/download/276209"},{"text":"Una rosa huele bien.","en":"A rose smells sweet.","audio":"https://tatoeba.org/en/audio/download/1187344"}]}