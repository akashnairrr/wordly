{"id":"li_o","lemma":"lío","pos":"noun","rank":1553,"glosses":["bundle","trouble, hassle, problem, mess, pickle","lover, bit on the side"],"ipa":"/ˈlio/","gender":"m","forms":{"plural":"líos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-Emanuelps27-l%C3%ADo.wav","examples":[{"text":"Estoy atrapado en un lío.","en":"I'm stuck in a rut.","audio":"https://tatoeba.org/en/audio/download/800067"},{"text":"No quiero meterme en líos.","en":"I don't want to get in trouble.","audio":"https://tatoeba.org/en/audio/download/585810"},{"text":"Él está ahora metido en un lío.","en":"He is in trouble now.","audio":"https://tatoeba.org/en/audio/download/453883"},{"text":"Siempre arma líos.","en":"He's always making a mess of things."},{"text":"Él está metido en un gran lío.","en":"He is in great trouble.","audio":"https://tatoeba.org/en/audio/download/461518"}]}