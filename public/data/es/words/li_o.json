{"id":"li_o","lemma":"lío","pos":"noun","rank":1550,"glosses":["bundle","trouble, hassle, problem, mess, pickle","lover, bit on the side"],"ipa":"/ˈlio/","gender":"m","forms":{"plural":"líos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-Emanuelps27-l%C3%ADo.wav","examples":[{"text":"Estoy atrapado en un lío.","en":"I'm stuck in a rut.","audio":"https://tatoeba.org/en/audio/download/800067","words":[{"g":"to be","l":"estar"},{"g":"caught"},{"g":"in / on"},{"g":"a"},null]},{"text":"Siempre arma líos.","en":"He's always making a mess of things.","words":[{"g":"always"},{"g":"weapon, arm"},null]},{"text":"Llevaba un lío de ropa.","en":"He carried a bundle of clothes.","words":[{"g":"to take somewhere","l":"llevar"},{"g":"a"},null,{"g":"of / from"},{"g":"garment"}]},{"text":"Mira qué lío.","en":"Look at this mess.","audio":"https://tatoeba.org/en/audio/download/501663","words":[{"g":"target"},{"g":"what"},null]},{"text":"No quiero meterme en líos.","en":"I don't want to get in trouble.","audio":"https://tatoeba.org/en/audio/download/585810","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to put in, insert","l":"meter"},{"g":"in / on"},null]}]}