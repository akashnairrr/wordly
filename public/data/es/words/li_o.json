{"id":"li_o","lemma":"lío","pos":"noun","rank":1550,"glosses":["bundle","trouble, hassle, problem, mess, pickle","lover, bit on the side"],"ipa":"/ˈlio/","gender":"m","forms":{"plural":"líos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-Emanuelps27-l%C3%ADo.wav","examples":[{"text":"Te has metido en un gran lío.","en":"You've got a big problem.","audio":"https://tatoeba.org/en/audio/download/587440","words":[{"g":"you"},{"g":"to have","l":"haber"},{"g":"nosy"},{"g":"in / on"},{"g":"a"},null,null]},{"text":"Mira qué lío.","en":"Look at this mess.","audio":"https://tatoeba.org/en/audio/download/501663","words":[{"g":"target"},{"g":"what"},null]},{"text":"Siempre arma líos.","en":"He's always making a mess of things.","words":[{"g":"always"},{"g":"weapon, arm"},null]},{"text":"Él está ahora metido en un lío.","en":"He is in trouble now.","audio":"https://tatoeba.org/en/audio/download/453883","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"now"},{"g":"nosy"},{"g":"in / on"},{"g":"a"},null]},{"text":"No quiero meterme en líos.","en":"I don't want to get in trouble.","audio":"https://tatoeba.org/en/audio/download/585810","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to put in, insert","l":"meter"},{"g":"in / on"},null]}]}