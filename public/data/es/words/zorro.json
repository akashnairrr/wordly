{"id":"zorro","lemma":"zorro","pos":"noun","rank":3354,"glosses":["fox (carnivore)","opossum","skunk"],"ipa":"/ˈθoro/","gender":"m","forms":{"plural":"zorros","feminine":"zorra","femininePlural":"zorras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-Millars-zorro.wav","formAudio":{"zorros":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-Millars-zorros.wav","zorra":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q1321_%28spa%29-Millars-zorra.wav","zorras":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Millars-zorras.wav"},"examples":[{"text":"Llegó un zorro.","en":"A fox came along.","audio":"https://tatoeba.org/en/audio/download/636700","words":[{"g":"to arrive, get","l":"llegar"},{"g":"a"},null]},{"text":"El zorro es un animal salvaje.","en":"A fox is a wild animal.","audio":"https://tatoeba.org/en/audio/download/461385","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"a"},null,null],"phrases":[[4,6,"wild animal"]]},{"text":"No hay zorros aquí.","en":"There are no foxes here.","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"here"}]},{"text":"Un zorro cayó en la trampa.","en":"A fox was caught in the snare.","words":[{"g":"a"},null,{"g":"to fall","l":"caer"},{"g":"in / on"},{"g":"the / her"},{"g":"trap, snare"}]},{"text":"Ellos cazaban zorros.","en":"They hunted foxes.","audio":"https://tatoeba.org/en/audio/download/65902","words":[{"g":"they","l":"él"},{"g":"to hunt","l":"cazar"},null]}]}