{"id":"quemado","lemma":"quemado","pos":"adj","rank":2686,"glosses":["burnt","burned out","annoyed"],"ipa":"/keˈmado/","forms":{"feminine":"quemada","masculinePlural":"quemados","femininePlural":"quemadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2a/LL-Q1321_%28spa%29-Millars-Quemado.wav","examples":[{"text":"Todavía no se ha quemado nada.","en":"Nothing has been burned yet.","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"oneself"},{"g":"to have","l":"haber"},null,{"g":"nothing"}]},{"text":"He quemado la tostada.","en":"I've burnt the toast.","audio":"https://tatoeba.org/en/audio/download/44092","words":[{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"toast"}]},{"text":"Niños quemados temen al fuego.","en":"A burnt child fears the fire.","words":[{"g":"child, boy","l":"niño"},null,{"g":"to have an obsession","l":"temar"},{"g":"to the"},{"g":"fire"}]},{"text":"Una anciana murió quemada.","en":"An old woman was burnt to death.","words":[{"g":"a"},{"g":"elderly","l":"anciano"},{"g":"to die","l":"morir"},null]},{"text":"Estoy quemado de trabajar durante todo el día.","en":"I am worn out from working all day.","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to work"},{"g":"during, in, over"},null,null,null],"phrases":[[5,8,"all the time"]]}]}