{"id":"tomado","lemma":"tomado","pos":"adj","rank":916,"glosses":["drunk"],"ipa":"/toˈmado/","forms":{"feminine":"tomada","masculinePlural":"tomados","femininePlural":"tomadas"},"examples":[{"text":"He tomado mi decisión.","en":"I've made my decision.","audio":"https://tatoeba.org/en/audio/download/850116"},{"text":"Esta foto fue tomada en Boston hace tres años.","en":"This photo was taken in Boston three years ago.","audio":"https://tatoeba.org/en/audio/download/609945"},{"text":"Ellos fueron tomados prisioneros.","en":"They were taken prisoner."},{"text":"Ya había tomado café.","en":"I've already had a coffee.","audio":"https://tatoeba.org/en/audio/download/524986"},{"text":"Troya fue tomada por los griegos.","en":"Troy was captured by the Greeks."}]}