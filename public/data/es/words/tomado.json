{"id":"tomado","lemma":"tomado","pos":"adj","rank":913,"glosses":["drunk"],"ipa":"/toˈmado/","forms":{"feminine":"tomada","masculinePlural":"tomados","femininePlural":"tomadas"},"examples":[{"text":"¿Ya te has tomado la medicina?","en":"Have you taken your medicine yet?","audio":"https://tatoeba.org/en/audio/download/354093","words":[{"g":"now"},{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"medicine"}]},{"text":"He tomado mi decisión.","en":"I've made my decision.","audio":"https://tatoeba.org/en/audio/download/850116","words":[{"g":"to have","l":"haber"},null,{"g":"my"},{"g":"decision"}]},{"text":"Ya me había tomado un café.","en":"I've had coffee already.","audio":"https://tatoeba.org/en/audio/download/611135","words":[{"g":"now"},{"g":"me"},{"g":"makes pluperfect to…"},null,{"g":"a"},{"g":"coffee"}]},{"text":"Ellos iban tomados de la mano.","en":"They went hand in hand.","words":[{"g":"they","l":"él"},{"g":"to go","l":"ir"},null,null,null,null],"phrases":[[3,6,"hand in hand"]]},{"text":"Estoy tomada.","en":"I'm drunk.","words":[{"g":"to be","l":"estar"},null]}]}