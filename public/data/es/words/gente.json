{"id":"gente","lemma":"gente","pos":"noun","rank":114,"glosses":["people","guys, lads (used to address a group of people)"],"ipa":"/ˈxente/","gender":"f","forms":{"plural":"gentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-AdrianAbdulBaha-gente.wav","examples":[{"text":"¡Nos vemos, gente!","en":"See you guys later.","audio":"https://tatoeba.org/en/audio/download/448712","words":[null,null,null],"phrases":[[0,2,"cheers, goodbye"]]},{"text":"Yo conozco gente.","en":"I know people.","audio":"https://tatoeba.org/en/audio/download/440312","words":[{"g":"I"},{"g":"to know","l":"conocer"},null]},{"text":"Tú conoces a la gente.","en":"You know people.","audio":"https://tatoeba.org/en/audio/download/425148","words":[{"g":"you"},{"g":"to know","l":"conocer"},{"g":"to"},{"g":"the / her"},null]},{"text":"¿Puede la gente cambiar?","en":"Can people change?","audio":"https://tatoeba.org/en/audio/download/443801","words":[{"g":"to be able to, can","l":"poder"},{"g":"the / her"},null,{"g":"to change"}]},{"text":"Murieron las gentes a centenares.","en":"People died by the hundreds.","words":[{"g":"to die","l":"morir"},{"g":"the / them"},null,{"g":"to"},{"g":"a unit of one hundred…","l":"centenar"}]}]}