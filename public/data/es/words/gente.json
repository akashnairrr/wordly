{"id":"gente","lemma":"gente","pos":"noun","rank":115,"glosses":["people","guys, lads (used to address a group of people)"],"ipa":"/ˈxente/","gender":"f","forms":{"plural":"gentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-AdrianAbdulBaha-gente.wav","examples":[{"text":"Gusto a la gente.","en":"People like me.","audio":"https://tatoeba.org/en/audio/download/425215"},{"text":"Murieron las gentes a centenares.","en":"People died by the hundreds."},{"text":"La gente me adora.","en":"People like me.","audio":"https://tatoeba.org/en/audio/download/425216"},{"text":"La gente es ridícula.","en":"People are funny.","audio":"https://tatoeba.org/en/audio/download/799250"},{"text":"¿Puede la gente cambiar?","en":"Can people change?","audio":"https://tatoeba.org/en/audio/download/443801"}]}