{"id":"tema","lemma":"tema","pos":"noun","rank":735,"glosses":["theme; plot (of a book, film or other media)","topic; matter; subject","unit"],"ipa":"/ˈtema/","gender":"m","forms":{"plural":"temas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q1321_%28spa%29-Marreromarco-tema.wav","formAudio":{"temas":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q1321_%28spa%29-GlyphEnjoyer-temas.wav"},"examples":[{"text":"Ella cambió de tema.","en":"She changed the subject.","audio":"https://tatoeba.org/en/audio/download/41441"},{"text":"Algunos temas son eternos.","en":"Some topics are timeless.","audio":"https://tatoeba.org/en/audio/download/582448"},{"text":"No cambies de tema.","en":"Don't change the subject.","audio":"https://tatoeba.org/en/audio/download/527396"},{"text":"Hemos hablado de muchos temas","en":"We discussed many topics.","audio":"https://tatoeba.org/en/audio/download/586542"},{"text":"Sigamos con otro tema.","en":"Let's move on to another topic.","audio":"https://tatoeba.org/en/audio/download/296323"}]}