{"id":"bonito","lemma":"bonito","pos":"adj","rank":549,"glosses":["pretty, cute","nice, lovely, sweet, fine, charming, great"],"ipa":"/boˈnito/","forms":{"feminine":"bonita","masculinePlural":"bonitos","femininePlural":"bonitas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-bonito.wav","examples":[{"text":"Tu pelo es bonito.","en":"Your hair is pretty.","audio":"https://tatoeba.org/en/audio/download/453390","words":[{"g":"your"},{"g":"hair"},{"g":"to be","l":"ser"},null]},{"text":"Ella tiene una cara bonita.","en":"She has a pretty face.","audio":"https://tatoeba.org/en/audio/download/514707","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"face"},null]},{"text":"Es una bonita casa.","en":"It's a pretty house.","audio":"https://tatoeba.org/en/audio/download/519227","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"house"}]},{"text":"Tienes unas manos muy bonitas.","en":"You have beautiful hands.","audio":"https://tatoeba.org/en/audio/download/1152627","words":[{"g":"to have","l":"tener"},{"g":"an","l":"un"},{"g":"hand","l":"mano"},null,null]},{"text":"Le dio un bonito regalo.","en":"She gave him a nice present.","audio":"https://tatoeba.org/en/audio/download/586809","words":[{"g":"him / her"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null,{"g":"present, gift"}]}]}