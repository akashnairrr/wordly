{"id":"bonito","lemma":"bonito","pos":"adj","rank":552,"glosses":["pretty, cute","nice, lovely, sweet, fine, charming, great"],"ipa":"/boˈnito/","forms":{"feminine":"bonita","masculinePlural":"bonitos","femininePlural":"bonitas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-bonito.wav","examples":[{"text":"Tu pelo es bonito.","en":"Your hair is pretty.","audio":"https://tatoeba.org/en/audio/download/453390"},{"text":"Es una bonita casa.","en":"It's a pretty house.","audio":"https://tatoeba.org/en/audio/download/519227"},{"text":"Estos cuadros son bonitos.","en":"These pictures are beautiful.","audio":"https://tatoeba.org/en/audio/download/534719"},{"text":"¡Qué flores tan bonitas!","en":"What pretty flowers!","audio":"https://tatoeba.org/en/audio/download/44706"},{"text":"El perro es bonito.","en":"The dog is beautiful.","audio":"https://tatoeba.org/en/audio/download/637068"}]}