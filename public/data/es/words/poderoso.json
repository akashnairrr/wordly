{"id":"poderoso","lemma":"poderoso","pos":"adj","rank":1680,"glosses":["powerful"],"ipa":"/podeˈɾoso/","forms":{"feminine":"poderosa","masculinePlural":"poderosos","femininePlural":"poderosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q1321_%28spa%29-Marreromarco-poderoso.wav","examples":[{"text":"Es rico y poderoso.","en":"He's rich and powerful.","audio":"https://tatoeba.org/en/audio/download/730595"},{"text":"El silencio es un arma muy poderosa.","en":"Silence is a very powerful weapon.","audio":"https://tatoeba.org/en/audio/download/721986"},{"text":"Él tiene poderosos brazos.","en":"He has powerful arms.","audio":"https://tatoeba.org/en/audio/download/453702"},{"text":"Los soldados tenían armas más poderosas.","en":"The soldiers had more powerful weapons."},{"text":"Poderoso caballero es Don Dinero.","en":"Money talks.","audio":"https://tatoeba.org/en/audio/download/438313"}]}