{"id":"responsable","lemma":"responsable","pos":"adj","rank":983,"glosses":["responsible, answerable"],"ipa":"/responˈsable/","forms":{"femininePlural":"responsables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-AdrianAbdulBaha-responsable.wav","examples":[{"text":"¿Eres el responsable aquí?","en":"Are you in command here?","audio":"https://tatoeba.org/en/audio/download/1152085"},{"text":"Tom nos hizo responsables.","en":"Tom held us accountable."},{"text":"Tú eres el responsable.","en":"You're the one responsible.","audio":"https://tatoeba.org/en/audio/download/845541"},{"text":"No hubo responsables del hecho.","en":"There was no accountability."},{"text":"El responsable eres tú.","en":"You're the one responsible.","audio":"https://tatoeba.org/en/audio/download/845542"}]}