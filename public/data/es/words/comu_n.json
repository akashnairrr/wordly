{"id":"comu_n","lemma":"común","pos":"adj","rank":857,"glosses":["common, ordinary","common, joint, shared","usual"],"ipa":"/koˈmun/","forms":{"femininePlural":"comunes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/11/LL-Q1321_%28spa%29-Marreromarco-com%C3%BAn.wav","examples":[{"text":"Es un nombre común.","en":"It's a common name.","audio":"https://tatoeba.org/en/audio/download/448121"},{"text":"Tales accidentes son comunes.","en":"Such accidents are common.","audio":"https://tatoeba.org/en/audio/download/1152073"},{"text":"Eso es sentido común.","en":"That's common sense.","audio":"https://tatoeba.org/en/audio/download/450209"},{"text":"Las peleas limítrofes eran comunes.","en":"Border fights were common."},{"text":"Es un error común.","en":"It's a common mistake.","audio":"https://tatoeba.org/en/audio/download/461113"}]}