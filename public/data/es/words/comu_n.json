{"id":"comu_n","lemma":"común","pos":"adj","rank":854,"glosses":["common, ordinary","common, joint, shared","usual"],"ipa":"/koˈmun/","forms":{"femininePlural":"comunes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/11/LL-Q1321_%28spa%29-Marreromarco-com%C3%BAn.wav","examples":[{"text":"Yo no tengo nada en común con ella.","en":"She and I have nothing in common.","audio":"https://tatoeba.org/en/audio/download/687650","words":[{"g":"I"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"nothing"},{"g":"in / on"},null,{"g":"with"},{"g":"she"}]},{"text":"Pero nosotros no tenemos nada en común.","en":"But we don't have anything in common at all.","audio":"https://tatoeba.org/en/audio/download/706013","words":[{"g":"but"},{"g":"we"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"nothing"},{"g":"in / on"},null]},{"text":"Es un nombre común.","en":"It's a common name.","audio":"https://tatoeba.org/en/audio/download/448121","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"name"},null]},{"text":"Los accidentes han sido poco comunes.","en":"Accidents have been rare.","words":[{"g":"the / them"},{"g":"accident","l":"accidente"},{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},{"g":"little, not much"},null]},{"text":"Eso es sentido común.","en":"That's common sense.","audio":"https://tatoeba.org/en/audio/download/450209","words":[null,null,{"g":"sense"},null],"phrases":[[0,2,"that's it"]]}]}