{"id":"minuto","lemma":"minuto","pos":"noun","rank":250,"glosses":["minute (a unit of time equal to 60 seconds or ¹⁄₆₀ hour)","minute (a unit of angle measure equal to 60 seconds or ¹⁄₆₀ degree)"],"ipa":"/miˈnuto/","gender":"m","forms":{"plural":"minutos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q1321_%28spa%29-AdrianAbdulBaha-minuto.wav","formAudio":{"minutos":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-GlyphEnjoyer-minutos.wav"},"examples":[{"text":"¿Podría tener un minuto?","en":"Can I have a minute?","audio":"https://tatoeba.org/en/audio/download/449774","words":[{"g":"to be able to, can","l":"poder"},{"g":"to have"},{"g":"a"},null]},{"text":"Estaré contigo en diez minutos.","en":"I'll be with you in ten minutes.","audio":"https://tatoeba.org/en/audio/download/645501","words":[{"g":"to be","l":"estar"},{"g":"with you"},{"g":"in / on"},{"g":"A"},null]},{"text":"Dame un minuto, ¿vale?","en":"Give me a minute, OK?","audio":"https://tatoeba.org/en/audio/download/455063","words":[{"g":"to give, to give out","l":"dar"},{"g":"a"},null,{"g":"a voucher"}]},{"text":"Él llegó aquí diez minutos antes.","en":"He arrived here ten minutes early.","audio":"https://tatoeba.org/en/audio/download/684525","words":[{"g":"he"},{"g":"to arrive, get","l":"llegar"},{"g":"here"},{"g":"A"},null,{"g":"earlier"}]},{"text":"Estaré allí en un minuto.","en":"I'll be in there in a minute.","audio":"https://tatoeba.org/en/audio/download/615885","words":[{"g":"to be","l":"estar"},{"g":"there"},{"g":"in / on"},{"g":"a"},null]}]}