{"id":"negocio","lemma":"negocio","pos":"noun","rank":519,"glosses":["business, enterprise (commercial enterprise or establishment)","deal (a particular instance of buying or selling, a transaction)","deal (agreement between parties)"],"ipa":"/neˈɡoθjo/","gender":"m","forms":{"plural":"negocios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-Marreromarco-negocio.wav","examples":[{"text":"Yo hice un negocio.","en":"I made a deal.","audio":"https://tatoeba.org/en/audio/download/440331"},{"text":"Los negocios son lentos.","en":"Business is slow.","audio":"https://tatoeba.org/en/audio/download/442997"},{"text":"¿Cómo va el negocio?","en":"How's business?","audio":"https://tatoeba.org/en/audio/download/440600"},{"text":"Nos referimos a negocios.","en":"We mean business.","audio":"https://tatoeba.org/en/audio/download/800186"},{"text":"Me encanta este negocio.","en":"I love this store.","audio":"https://tatoeba.org/en/audio/download/443557"}]}