{"id":"preparado","lemma":"preparado","pos":"adj","rank":881,"glosses":["prepared","qualified, well-qualified"],"ipa":"/pɾepaˈɾado/","forms":{"feminine":"preparada","masculinePlural":"preparados","femininePlural":"preparadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-Marreromarco-preparado.wav","examples":[{"text":"El almuerzo está preparado.","en":"Lunch is ready.","audio":"https://tatoeba.org/en/audio/download/440914"},{"text":"La cena está preparada.","en":"Dinner's ready!","audio":"https://tatoeba.org/en/audio/download/440575"},{"text":"No estábamos preparados para ello.","en":"We weren't ready for it.","audio":"https://tatoeba.org/en/audio/download/540778"},{"text":"Voy a decirles que estamos preparadas.","en":"I'll go tell them that we're ready."},{"text":"Estoy preparado para votar.","en":"I'm ready to vote.","audio":"https://tatoeba.org/en/audio/download/634258"}]}