{"id":"hablado","lemma":"hablado","pos":"adj","rank":729,"glosses":["spoken; oral"],"ipa":"/aˈblado/","forms":{"feminine":"hablada","masculinePlural":"hablados","femininePlural":"habladas"},"examples":[{"text":"¿Has hablado con tu marido?","en":"Did you talk with your husband?","audio":"https://tatoeba.org/en/audio/download/645207","words":[{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"your"},{"g":"husband"}]},{"text":"La palabra hablada importa.","en":"The spoken word matters.","words":[{"g":"the / her"},{"g":"word"},null,{"g":"to matter","l":"importar"}]},{"text":"Nadie me ha hablado nunca así.","en":"I've never been spoken to like that.","audio":"https://tatoeba.org/en/audio/download/568488","words":[{"g":"no one"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"never"},{"g":"like this"}]},{"text":"Todavía no hemos hablado de eso.","en":"We haven't talked about that yet.","audio":"https://tatoeba.org/en/audio/download/451604","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"heme","l":"hemo"},null,{"g":"of / from"},{"g":"that","l":"ése"}]},{"text":"Hoy no he hablado con nadie.","en":"I haven't spoken with anyone today.","words":[{"g":"today, tonight"},{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"no one"}]}]}