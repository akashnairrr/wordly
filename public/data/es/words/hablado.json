{"id":"hablado","lemma":"hablado","pos":"adj","rank":729,"glosses":["spoken; oral"],"ipa":"/aˈblado/","forms":{"feminine":"hablada","masculinePlural":"hablados","femininePlural":"habladas"},"examples":[{"text":"¿Has hablado con tu marido?","en":"Did you talk with your husband?","audio":"https://tatoeba.org/en/audio/download/645207","words":[{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"your"},{"g":"husband"}]},{"text":"¿Has hablado alguna vez con él?","en":"Did you ever talk to him?","audio":"https://tatoeba.org/en/audio/download/1187616","words":[{"g":"to have","l":"haber"},null,null,null,{"g":"with"},{"g":"he"}],"phrases":[[2,4,"ever"]]},{"text":"La palabra hablada importa.","en":"The spoken word matters.","words":[{"g":"the / her"},{"g":"word"},null,{"g":"to matter","l":"importar"}]},{"text":"Me han hablado mucho de vosotros.","en":"I've heard a lot about you.","audio":"https://tatoeba.org/en/audio/download/1153084","words":[{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"much"},{"g":"of / from"},{"g":"you all"}]},{"text":"El inglés es una lengua hablada en todo el mundo.","en":"English is a language spoken all over the world.","audio":"https://tatoeba.org/en/audio/download/691964","words":[{"g":"the"},{"g":"English"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"tongue"},null,{"g":"in / on"},null,null,null],"phrases":[[7,10,"everyone, everybody"]]}]}