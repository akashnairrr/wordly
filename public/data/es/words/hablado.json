{"id":"hablado","lemma":"hablado","pos":"adj","rank":732,"glosses":["spoken; oral"],"ipa":"/aˈblado/","forms":{"feminine":"hablada","masculinePlural":"hablados","femininePlural":"habladas"},"examples":[{"text":"¿Has hablado con Tom?","en":"Have you spoken to Tom?","audio":"https://tatoeba.org/en/audio/download/101860"},{"text":"El inglés es una lengua hablada en todo el mundo.","en":"English is a language spoken all over the world.","audio":"https://tatoeba.org/en/audio/download/691964"},{"text":"¿Ha hablado Tom con Mary?","en":"Did Tom talk to Mary?","audio":"https://tatoeba.org/en/audio/download/269162"},{"text":"La palabra hablada importa.","en":"The spoken word matters."},{"text":"¿No has hablado con Tom?","en":"Didn't you talk to Tom?","audio":"https://tatoeba.org/en/audio/download/140108"}]}