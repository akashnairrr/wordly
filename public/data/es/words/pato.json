{"id":"pato","lemma":"pato","pos":"noun","rank":2706,"glosses":["duck, drake","homosexual, faggot","sockpuppet"],"ipa":"/ˈpato/","gender":"m","forms":{"plural":"patos","feminine":"pata","femininePlural":"patas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1321_%28spa%29-Millars-pato.wav","formAudio":{"pata":"https://upload.wikimedia.org/wikipedia/commons/0/06/LL-Q1321_%28spa%29-AdrianAbdulBaha-pata.wav"},"examples":[{"text":"Una vez maté un pato.","en":"I killed a duck once.","audio":"https://tatoeba.org/en/audio/download/454911","words":[null,null,{"g":"to kill, slay","l":"matar"},{"g":"a"},null],"phrases":[[0,2,"once"]]},{"text":"Se parece a un pato.","en":"It looks like a duck.","audio":"https://tatoeba.org/en/audio/download/453448","words":[{"g":"oneself"},{"g":"to seem, to see fit","l":"parecer"},{"g":"to"},{"g":"a"},null]},{"text":"Hay muchos patos en el parque.","en":"There are a lot of ducks in the park.","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"in / on"},{"g":"the"},{"g":"park"}]},{"text":"¿Dónde está el pato de goma?","en":"Where is the rubber duck?","words":[null,null,{"g":"the"},null,{"g":"of / from"},{"g":"hair tie"}],"phrases":[[0,2,"where are you?"]]},{"text":"Los patos aletearon al sol para secarse.","en":"The ducks flapped their wings in the sun to dry off.","audio":"https://tatoeba.org/en/audio/download/354296","words":[{"g":"the / them"},null,null,{"g":"to the"},{"g":"sun"},{"g":"for"},{"g":"to dry","l":"secar"}]}]}