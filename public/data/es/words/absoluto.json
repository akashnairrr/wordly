{"id":"absoluto","lemma":"absoluto","pos":"adj","rank":911,"glosses":["absolute"],"ipa":"/absoˈluto/","forms":{"feminine":"absoluta","masculinePlural":"absolutos","femininePlural":"absolutas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-AdrianAbdulBaha-absoluto.wav","formAudio":{"absoluta":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-AdrianAbdulBaha-absoluta.wav"},"examples":[{"text":"Tengo absoluta confianza en él.","en":"I have absolute trust in him.","audio":"https://tatoeba.org/en/audio/download/616238","words":[{"g":"to have","l":"tener"},null,{"g":"confidence, trust"},{"g":"in / on"},{"g":"he"}]},{"text":"No es difícil en absoluto hacerlo.","en":"It's not at all difficult to do that.","audio":"https://tatoeba.org/en/audio/download/410432","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"difficult"},{"g":"in / on"},null,{"g":"to do","l":"hacer"}]},{"text":"Esa es la verdad absoluta.","en":"That's the absolute truth.","words":[{"g":"that","l":"ese"},{"g":"to be","l":"ser"},null,null,null],"phrases":[[2,4,"honestly, to be honest"]]},{"text":"Había silencio absoluto.","en":"There was absolute silence.","words":[{"g":"makes pluperfect to…"},{"g":"silence"},null]},{"text":"Eso no me preocupa en absoluto.","en":"That doesn't worry me at all.","audio":"https://tatoeba.org/en/audio/download/599312","words":[{"g":"that","l":"ése"},{"g":"no / not"},{"g":"me"},{"g":"to worry","l":"preocupar"},{"g":"in / on"},null]}]}