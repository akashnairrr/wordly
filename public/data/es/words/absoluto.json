{"id":"absoluto","lemma":"absoluto","pos":"adj","rank":914,"glosses":["absolute"],"ipa":"/absoˈluto/","forms":{"feminine":"absoluta","masculinePlural":"absolutos","femininePlural":"absolutas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-AdrianAbdulBaha-absoluto.wav","formAudio":{"absoluta":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-AdrianAbdulBaha-absoluta.wav"},"examples":[{"text":"No recuerdo en absoluto.","en":"I don't remember it at all.","audio":"https://tatoeba.org/en/audio/download/512928"},{"text":"Tengo absoluta confianza en él.","en":"I have absolute trust in him.","audio":"https://tatoeba.org/en/audio/download/616238"},{"text":"No estoy cansado en absoluto.","en":"I'm not a bit tired.","audio":"https://tatoeba.org/en/audio/download/449927"},{"text":"Esperar más es una absoluta pérdida de tiempo.","en":"It's an absolute waste of time to wait any longer.","audio":"https://tatoeba.org/en/audio/download/705716"},{"text":"No me importa en absoluto.","en":"I don't mind it at all.","audio":"https://tatoeba.org/en/audio/download/460124"}]}