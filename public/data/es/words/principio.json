{"id":"principio","lemma":"principio","pos":"noun","rank":638,"glosses":["principle","cause, origin","beginning, start, outset, get-go"],"ipa":"/pɾinˈθipjo/","gender":"m","forms":{"plural":"principios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-AdrianAbdulBaha-principio.wav","examples":[{"text":"¿No podemos empezar desde el principio?","en":"Can't we start over?","audio":"https://tatoeba.org/en/audio/download/449766","words":[{"g":"no / not"},{"g":"to prune","l":"podar"},{"g":"to start"},{"g":"since"},{"g":"the"},null]},{"text":"Va contra mis principios.","en":"It's against my principles.","audio":"https://tatoeba.org/en/audio/download/540729","words":[{"g":"okay"},{"g":"antidote"},{"g":"my"},null]},{"text":"Al principio no me gustaba.","en":"At first I didn't like it.","audio":"https://tatoeba.org/en/audio/download/451073","words":[{"g":"to the"},null,{"g":"no / not"},{"g":"me"},{"g":"to like in a general…","l":"gustar"}]},{"text":"Nos hicimos amigos desde el principio.","en":"We were friends right from the start.","audio":"https://tatoeba.org/en/audio/download/299097","words":[{"g":"us"},{"g":"to do","l":"hacer"},{"g":"friend","l":"amigo"},{"g":"since"},{"g":"the"},null]},{"text":"Eso va en contra de mis principios.","en":"That runs against my principles.","words":[{"g":"that","l":"ése"},{"g":"okay"},null,null,null,{"g":"my"},null],"phrases":[[2,5,"against"]]}]}