{"id":"comprensio_n","lemma":"comprensión","pos":"noun","rank":4089,"glosses":["comprehension","understanding"],"ipa":"/kompɾenˈsjon/","gender":"f","forms":{"plural":"comprensiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-AdrianAbdulBaha-comprensi%C3%B3n.wav","examples":[{"text":"Gracias por vuestra comprensión.","en":"Thanks for your understanding.","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"yours","l":"vuestro"},null]},{"text":"¡Gracias a todos por la comprensión!","en":"Thank you all so much for understanding.","words":[null,null,{"g":"all","l":"todo"},{"g":"for / by"},{"g":"the / her"},null],"phrases":[[0,2,"thanks to, due to"]]},{"text":"Esto va más allá de mi comprensión.","en":"This is above me.","words":[{"g":"this"},{"g":"okay"},null,null,{"g":"of / from"},{"g":"my"},null],"phrases":[[2,4,"farther"]]},{"text":"Su explicación iba más allá de mi comprensión.","en":"His explanation was quite above me.","audio":"https://tatoeba.org/en/audio/download/831309","words":[{"g":"his / her / your"},{"g":"explanation"},{"g":"to go","l":"ir"},null,null,{"g":"of / from"},{"g":"my"},null],"phrases":[[3,5,"farther"]]},{"text":"El problema está más allá de mi comprensión.","en":"The problem is beyond my grasp.","words":[{"g":"the"},{"g":"problem"},{"g":"to be","l":"estar"},null,null,{"g":"of / from"},{"g":"my"},null],"phrases":[[3,5,"farther"]]}]}