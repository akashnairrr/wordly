{"id":"completamente","lemma":"completamente","pos":"adv","rank":568,"glosses":["completely"],"ipa":"/komˌpletaˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/4f/LL-Q1321_%28spa%29-Marreromarco-completamente.wav","examples":[{"text":"Me olvidé completamente.","en":"I completely forgot.","audio":"https://tatoeba.org/en/audio/download/449591","words":[{"g":"me"},{"g":"to forget","l":"olvidar"},null]},{"text":"Me sentía completamente feliz.","en":"I felt completely happy.","audio":"https://tatoeba.org/en/audio/download/191394","words":[{"g":"me"},{"g":"to feel","l":"sentir"},null,{"g":"happy, merry"}]},{"text":"Estoy completamente de acuerdo con usted.","en":"I agree with you absolutely.","audio":"https://tatoeba.org/en/audio/download/765448","words":[{"g":"to be","l":"estar"},null,null,null,null,{"g":"you (formal)"}],"phrases":[[2,5,"according to"]]},{"text":"Él estaba completamente despierto.","en":"He was wide awake.","audio":"https://tatoeba.org/en/audio/download/702951","words":[{"g":"he"},{"g":"to be","l":"estar"},null,{"g":"awake"}]},{"text":"Ahora estoy completamente solo.","en":"I'm all alone now.","audio":"https://tatoeba.org/en/audio/download/550152","words":[{"g":"now"},{"g":"to be","l":"estar"},null,{"g":"sole"}]}]}