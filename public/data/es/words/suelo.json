{"id":"suelo","lemma":"suelo","pos":"noun","rank":608,"glosses":["dirt, earth, ground, soil","floor, ground"],"ipa":"/ˈswelo/","gender":"m","forms":{"plural":"suelos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Eavqwiki-suelo.wav","formAudio":{"suelos":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1321_%28spa%29-Eavqwiki-suelos.wav"},"examples":[{"text":"No te sientes en el suelo.","en":"Don't sit on the floor.","audio":"https://tatoeba.org/en/audio/download/73244","words":[{"g":"no / not"},{"g":"you"},{"g":"to seat","l":"sentar"},{"g":"in / on"},{"g":"the"},null]},{"text":"No me importa dormir en el suelo.","en":"I don't mind sleeping on the floor.","audio":"https://tatoeba.org/en/audio/download/519086","words":[null,null,null,{"g":"to sleep"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,3,"I don't care!"]]},{"text":"Todos los suelos de su casa están hechos de madera.","en":"All the floors in her house are made of wood.","audio":"https://tatoeba.org/en/audio/download/692307","words":[{"g":"all","l":"todo"},{"g":"the / them"},null,{"g":"of / from"},{"g":"his / her / your"},{"g":"house"},{"g":"to be","l":"estar"},{"g":"done, completed","l":"hecho"},{"g":"of / from"},{"g":"wood"}]},{"text":"Suelo comer en casa con mi familia.","en":"I usually eat at home with my family.","audio":"https://tatoeba.org/en/audio/download/609240","words":[null,{"g":"to eat"},null,null,{"g":"with"},{"g":"my"},{"g":"family"}],"phrases":[[2,4,"home"]]},{"text":"Suelo pensar en el lugar donde te conocí.","en":"I often think about the place where I met you.","audio":"https://tatoeba.org/en/audio/download/599060","words":[null,{"g":"to think, ponder"},{"g":"in / on"},{"g":"the"},{"g":"place"},{"g":"by, near to"},{"g":"you"},{"g":"to know","l":"conocer"}]}]}