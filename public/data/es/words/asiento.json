{"id":"asiento","lemma":"asiento","pos":"noun","rank":1015,"glosses":["seat","sediment, deposit","treaty, pact"],"ipa":"/aˈsjento/","gender":"m","forms":{"plural":"asientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-asiento.wav","examples":[{"text":"Tome asiento, por favor.","en":"Please sit down.","audio":"https://tatoeba.org/en/audio/download/442004"},{"text":"¿Nos intercambiamos los asientos?","en":"Can we switch seats?","audio":"https://tatoeba.org/en/audio/download/451616"},{"text":"Este es mi asiento.","en":"This is my seat.","audio":"https://tatoeba.org/en/audio/download/799443"},{"text":"¿Podemos intercambiarnos los asientos?","en":"Can we switch seats?","audio":"https://tatoeba.org/en/audio/download/451617"},{"text":"Por favor tome asiento.","en":"Sit down, please.","audio":"https://tatoeba.org/en/audio/download/524898"}]}