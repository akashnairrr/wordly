{"id":"ganas","lemma":"ganas","pos":"noun","rank":823,"glosses":["desire, wish, want","enthusiasm","lust (chiefly when preceded by compound verb traerle o tener)"],"ipa":"/ˈɡanas/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-Precision27-ganas.wav","examples":[{"text":"Tengo ganas de llorar.","en":"I want to cry.","audio":"https://tatoeba.org/en/audio/download/440390"},{"text":"Tenía ganas de llorar.","en":"I felt like crying.","audio":"https://tatoeba.org/en/audio/download/450586"},{"text":"Tengo ganas de sonreír.","en":"I feel like smiling.","audio":"https://tatoeba.org/en/audio/download/534848"},{"text":"Sentí ganas de bailar.","en":"I felt like dancing.","audio":"https://tatoeba.org/en/audio/download/333264"},{"text":"Seguramente estudias con ganas.","en":"You must study hard.","audio":"https://tatoeba.org/en/audio/download/454735"}]}