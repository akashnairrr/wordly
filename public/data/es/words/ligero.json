{"id":"ligero","lemma":"ligero","pos":"adj","rank":3137,"glosses":["light, not heavy"],"ipa":"/liˈxeɾo/","forms":{"feminine":"ligera","masculinePlural":"ligeros","femininePlural":"ligeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Marreromarco-ligero.wav","examples":[{"text":"Me gustaría comer algo ligero.","en":"I'd like to eat something light.","audio":"https://tatoeba.org/en/audio/download/354666","words":[{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"to eat"},{"g":"something, anything"},null]},{"text":"Tengo una ligera idea de dónde está.","en":"I have a rough idea where it is.","audio":"https://tatoeba.org/en/audio/download/354736","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"idea"},{"g":"of / from"},null,null],"phrases":[[5,7,"where are you?"]]},{"text":"Tengo un ligero dolor de cabeza.","en":"I have a slight headache.","audio":"https://tatoeba.org/en/audio/download/44326","words":[{"g":"to have","l":"tener"},{"g":"a"},null,null,null,null],"phrases":[[3,6,"headache"]]},{"text":"Hubo una ligera lluvia ayer.","en":"There was a light rain yesterday.","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"rain"},{"g":"yesterday"}]},{"text":"Era lo suficientemente ligero.","en":"It was light enough.","audio":"https://tatoeba.org/en/audio/download/448415","words":[{"g":"to be","l":"ser"},{"g":"it / him"},{"g":"sufficiently"},null]}]}