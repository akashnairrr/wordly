{"id":"posible","lemma":"posible","pos":"adj","rank":324,"glosses":["possible"],"ipa":"/poˈsible/","forms":{"femininePlural":"posibles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q1321_%28spa%29-AdrianAbdulBaha-posible.wav","examples":[{"text":"Es posible que nieve.","en":"It may snow.","audio":"https://tatoeba.org/en/audio/download/424577"},{"text":"Debemos evitar la guerra por todos los medios posibles.","en":"We must avoid war by all possible means.","audio":"https://tatoeba.org/en/audio/download/37359"},{"text":"Hazlo lo mejor posible.","en":"Try your best.","audio":"https://tatoeba.org/en/audio/download/850170"},{"text":"Tratamos por todos los medios posibles.","en":"We tried all means possible."},{"text":"Es posible que venga.","en":"She might come.","audio":"https://tatoeba.org/en/audio/download/519306"}]}