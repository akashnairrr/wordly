{"id":"seguido","lemma":"seguido","pos":"adv","rank":1615,"glosses":["often"],"ipa":"/seˈɡido/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q1321_%28spa%29-AdrianAbdulBaha-seguido.wav","examples":[{"text":"¿Qué tan seguido comes pescado?","en":"How often do you eat fish?","audio":"https://tatoeba.org/en/audio/download/557793"},{"text":"He seguido una dieta estricta.","en":"I've been on a strict diet.","audio":"https://tatoeba.org/en/audio/download/605010"},{"text":"No me enfermo muy seguido.","en":"I don't get sick very often.","audio":"https://tatoeba.org/en/audio/download/518868"},{"text":"¡Ojalá hubiese seguido tu consejo!","en":"If I'd only taken your advice!","audio":"https://tatoeba.org/en/audio/download/703014"},{"text":"Ojalá hubiera seguido tu consejo.","en":"If only I had taken your advice.","audio":"https://tatoeba.org/en/audio/download/932191"}]}