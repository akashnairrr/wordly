{"id":"seguido","lemma":"seguido","pos":"adv","rank":1612,"glosses":["often"],"ipa":"/seˈɡido/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q1321_%28spa%29-AdrianAbdulBaha-seguido.wav","examples":[{"text":"¡Ojalá hubiese seguido tu consejo!","en":"If I'd only taken your advice!","audio":"https://tatoeba.org/en/audio/download/703014","words":[{"g":"I wish"},{"g":"to have","l":"haber"},null,{"g":"your"},{"g":"advice"}]},{"text":"No me enfermo muy seguido.","en":"I don't get sick very often.","audio":"https://tatoeba.org/en/audio/download/518868","words":[{"g":"no / not"},{"g":"me"},{"g":"sick, ill"},null,null]},{"text":"Vengo aquí seguido.","en":"I come here often.","audio":"https://tatoeba.org/en/audio/download/799346","words":[{"g":"to avenge","l":"vengar"},{"g":"here"},null]},{"text":"¿Vas seguido allí?","en":"Do you go there often?","words":[{"g":"to go","l":"ir"},null,{"g":"there"}]},{"text":"Él seguido cambia de opinión.","en":"He often changes his mind.","words":[{"g":"he"},null,{"g":"to change","l":"cambiar"},{"g":"of / from"},{"g":"opinion"}]}]}