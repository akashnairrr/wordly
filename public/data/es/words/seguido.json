{"id":"seguido","lemma":"seguido","pos":"adv","rank":1612,"glosses":["often"],"ipa":"/seˈɡido/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q1321_%28spa%29-AdrianAbdulBaha-seguido.wav","examples":[{"text":"¿Vas seguido allí?","en":"Do you go there often?","words":[{"g":"to go","l":"ir"},null,{"g":"there"}]},{"text":"Vengo aquí seguido.","en":"I come here often.","audio":"https://tatoeba.org/en/audio/download/799346","words":[{"g":"to avenge","l":"vengar"},{"g":"here"},null]},{"text":"Ojalá hubiera seguido tu consejo.","en":"If only I had taken your advice.","audio":"https://tatoeba.org/en/audio/download/932191","words":[{"g":"I wish"},{"g":"to have","l":"haber"},null,{"g":"your"},{"g":"advice"}]},{"text":"No me enfermo muy seguido.","en":"I don't get sick very often.","audio":"https://tatoeba.org/en/audio/download/518868","words":[{"g":"no / not"},{"g":"me"},{"g":"sick, ill"},null,null]},{"text":"Él seguido decía algo así.","en":"He would often say such a thing.","words":[{"g":"he"},null,{"g":"to say","l":"decir"},null,null],"phrases":[[3,5,"kind of"]]}]}