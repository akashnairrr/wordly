{"id":"vaci_o","lemma":"vacío","pos":"noun","rank":1395,"glosses":["vacuum, void","empty space; gap"],"ipa":"/baˈθio/","gender":"m","forms":{"plural":"vacíos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-AdrianAbdulBaha-vac%C3%ADo.wav","examples":[{"text":"Este asiento está vacío.","en":"This seat's free.","audio":"https://tatoeba.org/en/audio/download/730764"},{"text":"¿Hay todavía asientos vacíos?","en":"Are there still some empty seats?","audio":"https://tatoeba.org/en/audio/download/704035"},{"text":"Mi vaso está vacío.","en":"My glass is empty.","audio":"https://tatoeba.org/en/audio/download/443580"},{"text":"Todos los cajones del escritorio estaban vacíos.","en":"All the desk drawers were empty.","audio":"https://tatoeba.org/en/audio/download/645538"},{"text":"El tanque está vacío.","en":"The tank is empty.","audio":"https://tatoeba.org/en/audio/download/450106"}]}