{"id":"temer","lemma":"temer","pos":"verb","rank":2823,"glosses":["to fear","to dread","to be afraid, sorry; to suspect"],"ipa":"/teˈmeɾ/","conjugation":{"indicative":{"present":{"1s":"temo","2s":"temes","3s":"teme","1p":"tememos","2p":"teméis","3p":"temen"},"imperfect":{"1s":"temía","2s":"temías","3s":"temía","1p":"temíamos","2p":"temíais","3p":"temían"},"preterite":{"1s":"temí","2s":"temiste","3s":"temió","1p":"temimos","2p":"temisteis","3p":"temieron"},"future":{"1s":"temeré","2s":"temerás","3s":"temerá","1p":"temeremos","2p":"temeréis","3p":"temerán"},"conditional":{"1s":"temería","2s":"temerías","3s":"temería","1p":"temeríamos","2p":"temeríais","3p":"temerían"}},"subjunctive":{"present":{"1s":"tema","2s":"temas","3s":"tema","1p":"temamos","2p":"temáis","3p":"teman"},"imperfect":{"1s":"temiera","2s":"temieras","3s":"temiera","1p":"temiéramos","2p":"temierais","3p":"temieran"}},"imperative":{"affirmative":{"2s":"teme","3s":"tema","1p":"temamos","2p":"temed","3p":"teman"},"negative":{"2s":"temas","3s":"tema","1p":"temamos","2p":"temáis","3p":"teman"}}},"nonFinite":{"gerund":"temiendo","participle":"temido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Rodelar-temer.wav","formAudio":{"tema":"https://upload.wikimedia.org/wikipedia/commons/6/62/LL-Q1321_%28spa%29-Marreromarco-tema.wav","temas":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q1321_%28spa%29-GlyphEnjoyer-temas.wav"},"examples":[{"text":"Él no temía la muerte.","en":"He didn't fear death.","audio":"https://tatoeba.org/en/audio/download/453218","words":[{"g":"he"},{"g":"no / not"},null,{"g":"the / her"},{"g":"death"}]},{"text":"No tienes absolutamente nada que temer.","en":"You have absolutely nothing to fear.","audio":"https://tatoeba.org/en/audio/download/803917","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"absolutely"},{"g":"nothing"},{"g":"that"},null]},{"text":"Temía llegar tarde.","en":"I was afraid I'd be late.","audio":"https://tatoeba.org