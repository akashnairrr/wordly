{"id":"intento","lemma":"intento","pos":"noun","rank":685,"glosses":["attempt"],"ipa":"/inˈtento/","gender":"m","forms":{"plural":"intentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/42/LL-Q1321_%28spa%29-Marreromarco-intento.wav","examples":[{"text":"Vale, otro intento más.","en":"OK, try again.","audio":"https://tatoeba.org/en/audio/download/850174"},{"text":"Todos nuestros intentos fallaron.","en":"All of our attempts failed.","audio":"https://tatoeba.org/en/audio/download/803794"},{"text":"Haré mi mejor intento.","en":"I'll try my best.","audio":"https://tatoeba.org/en/audio/download/611637"},{"text":"Tenéis tres intentos para adivinarlo.","en":"You can have three guesses."},{"text":"Hice un segundo intento.","en":"I made a second attempt.","audio":"https://tatoeba.org/en/audio/download/820028"}]}