{"id":"elegir","lemma":"elegir","pos":"verb","rank":1193,"glosses":["to choose","to elect"],"ipa":"/eleˈxiɾ/","conjugation":{"indicative":{"present":{"1s":"elijo","2s":"eliges","3s":"elige","1p":"elegimos","2p":"elegís","3p":"eligen"},"imperfect":{"1s":"elegía","2s":"elegías","3s":"elegía","1p":"elegíamos","2p":"elegíais","3p":"elegían"},"preterite":{"1s":"elegí","2s":"elegiste","3s":"eligió","1p":"elegimos","2p":"elegisteis","3p":"eligieron"},"future":{"1s":"elegiré","2s":"elegirás","3s":"elegirá","1p":"elegiremos","2p":"elegiréis","3p":"elegirán"},"conditional":{"1s":"elegiría","2s":"elegirías","3s":"elegiría","1p":"elegiríamos","2p":"elegiríais","3p":"elegirían"}},"subjunctive":{"present":{"1s":"elija","2s":"elijas","3s":"elija","1p":"elijamos","2p":"elijáis","3p":"elijan"},"imperfect":{"1s":"eligiera","2s":"eligieras","3s":"eligiera","1p":"eligiéramos","2p":"eligierais","3p":"eligieran"}},"imperative":{"affirmative":{"2s":"elige","3s":"elija","1p":"elijamos","2p":"elegid","3p":"elijan"},"negative":{"2s":"elijas","3s":"elija","1p":"elijamos","2p":"elijáis","3p":"elijan"}}},"nonFinite":{"gerund":"eligiendo","participle":"elegido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-AdrianAbdulBaha-elegir.wav","formAudio":{"elegía":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q1321_%28spa%29-Emanuelps27-eleg%C3%ADa.wav"},"examples":[{"text":"Tú puedes elegir la que quieras.","en":"You may choose whichever you want.","audio":"https://tatoeba.org/en/audio/download/599039","words":[{"g":"you"},{"g":"to be able to, can","l":"poder"},null,{"g":"the / her"},{"g":"that"},{"g":"to desire","l":"querer"}]},{"text":"Elige el que te guste.","en":"Choose the one you like.","audio":"https://tatoeba.org/en/audio/download/461482","words":[null,null,null,{"g":"you"},{"g":"to like in a general…","l":"gustar"}],"phrases":[[1,3,"that"]]},{"text":"Tú fuiste quien eligió hacer eso.","en":"You were the one who chose to do that.","audio":"https://tatoeba.org/en/audio/download/586023","words":[{"g":"you"},{"g":"to go","l":"ir"},{"g":"who"},null,{"g":"to do"},{"g":"that","l":"ése"}]},{"text":"¿Por qué no me elegiste a mí?","en":"Why didn't you pick me?","audio":"https://tatoeba.org/en/audio/download/163007","words":[null,null,{"g":"no / not"},{"g":"me"},null,{"g":"to"},{"g":"me"}],"phrases":[[0,2,"why, for what reason"]]},{"text":"Tienes que elegir tu propio destino.","en":"You have to choose your own destiny.","audio":"https://tatoeba.org/en/audio/download/609864","words":[{"g":"to have","l":"tener"},{"g":"that"},null,{"g":"your"},{"g":"own"},{"g":"destiny, fate"}]}]}