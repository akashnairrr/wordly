{"id":"razo_n","lemma":"razón","pos":"noun","rank":173,"glosses":["reason","reasoning","correctness, rectitude, a point"],"ipa":"/raˈθon/","gender":"f","forms":{"plural":"razones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-Rodrigo5260-raz%C3%B3n.wav","examples":[{"text":"¿No tengo la razón?","en":"Am I not right?","audio":"https://tatoeba.org/en/audio/download/440564"},{"text":"Tengo mis propias razones.","en":"I have my own reasons.","audio":"https://tatoeba.org/en/audio/download/453712"},{"text":"En eso tiene razón.","en":"He has a point.","audio":"https://tatoeba.org/en/audio/download/636899"},{"text":"No hay razones para creerlo.","en":"There's no reason to believe it.","audio":"https://tatoeba.org/en/audio/download/505325"},{"text":"No conozco la razón.","en":"I don't know why.","audio":"https://tatoeba.org/en/audio/download/722065"}]}