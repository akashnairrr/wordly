{"id":"famoso","lemma":"famoso","pos":"adj","rank":1404,"glosses":["well-known, famous"],"ipa":"/faˈmoso/","forms":{"feminine":"famosa","masculinePlural":"famosos","femininePlural":"famosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q1321_%28spa%29-AdrianAbdulBaha-famoso.wav","examples":[{"text":"Él se hizo famoso.","en":"He became famous.","audio":"https://tatoeba.org/en/audio/download/67907"},{"text":"Mi hermana es famosa.","en":"My sister is famous.","audio":"https://tatoeba.org/en/audio/download/41886"},{"text":"Tom hace imitaciones de famosos.","en":"Tom does impersonations of famous people.","audio":"https://tatoeba.org/en/audio/download/801668"},{"text":"Ésas son personas muy famosas.","en":"Those are very famous people.","audio":"https://tatoeba.org/en/audio/download/306330"},{"text":"Es un famoso médico.","en":"He is famous as a doctor.","audio":"https://tatoeba.org/en/audio/download/639442"}]}