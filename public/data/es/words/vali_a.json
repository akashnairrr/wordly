{"id":"vali_a","lemma":"valía","pos":"noun","rank":3951,"glosses":["worth","faction"],"ipa":"/baˈlia/","gender":"f","forms":{"plural":"valías"},"examples":[{"text":"Valía la pena intentarlo.","en":"It was worth a try.","audio":"https://tatoeba.org/en/audio/download/87464","words":[null,{"g":"the / her"},{"g":"punishment, sentence"},{"g":"to try, to attempt","l":"intentar"}]},{"text":"No tengo que demostrar mi valía ante nadie.","en":"I don't have to prove myself to anybody.","audio":"https://tatoeba.org/en/audio/download/871951","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to show"},{"g":"my"},null,{"g":"elk"},{"g":"no one"}]},{"text":"Valía la pena probar.","en":"It was worth trying.","audio":"https://tatoeba.org/en/audio/download/448430","words":[null,{"g":"the / her"},{"g":"punishment, sentence"},{"g":"to prove"}]},{"text":"Pensé que valía la pena intentarlo.","en":"I thought it was worth a try.","words":[{"g":"to think, ponder","l":"pensar"},{"g":"that"},null,{"g":"the / her"},{"g":"punishment, sentence"},{"g":"to try, to attempt","l":"intentar"}]},{"text":"El plan de Tom no valía para nada.","en":"Tom's plan wasn't any good.","audio":"https://tatoeba.org/en/audio/download/306552","words":[{"g":"the"},{"g":"plan"},{"g":"of / from"},null,{"g":"no / not"},null,null,null],"phrases":[[6,8,"not at all"]]}]}