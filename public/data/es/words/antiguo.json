{"id":"antiguo","lemma":"antiguo","pos":"adj","rank":1267,"glosses":["old, former, erstwhile, quondam, one-time, onetime","old, ancient, age-old","vintage, antique"],"ipa":"/anˈtiɡwo/","forms":{"feminine":"antigua","masculinePlural":"antiguos","femininePlural":"antiguas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-AdrianAbdulBaha-antiguo.wav","examples":[{"text":"Este es un libro antiguo.","en":"This book is old.","audio":"https://tatoeba.org/en/audio/download/799944"},{"text":"Estoy viendo una película antigua.","en":"I am watching an old film.","audio":"https://tatoeba.org/en/audio/download/639975"},{"text":"Poseo algunos sellos muy antiguos.","en":"I own some very old stamps.","audio":"https://tatoeba.org/en/audio/download/514743"},{"text":"Tom coleccionaba monedas antiguas.","en":"Tom collected old coins.","audio":"https://tatoeba.org/en/audio/download/68687"},{"text":"Tengo un sello muy antiguo.","en":"I have a very old stamp.","audio":"https://tatoeba.org/en/audio/download/70225"}]}