{"id":"cerdo","lemma":"cerdo","pos":"noun","rank":1128,"glosses":["pig, hog","pork","slob, pig, hog"],"ipa":"/ˈθeɾdo/","gender":"m","forms":{"plural":"cerdos","feminine":"cerda","femininePlural":"cerdas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-Millars-cerdo.wav","formAudio":{"cerda":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-Marreromarco-cerda.wav"},"examples":[{"text":"No sea un cerdo.","en":"Don't be a pig.","audio":"https://tatoeba.org/en/audio/download/440680"},{"text":"Los hombres son cerdos.","en":"Men are pigs."},{"text":"La cerda gruñía mientras hozaba la tierra en busca de trufas.","en":"The pig snorted while rooting around in search of truffles.","audio":"https://tatoeba.org/en/audio/download/930606"},{"text":"No como carne de cerdo.","en":"I don't eat pork.","audio":"https://tatoeba.org/en/audio/download/553988"},{"text":"Los cerdos son animales inteligentes.","en":"Pigs are intelligent animals."}]}