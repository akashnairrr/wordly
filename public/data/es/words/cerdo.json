{"id":"cerdo","lemma":"cerdo","pos":"noun","rank":1125,"glosses":["pig, hog","pork","slob, pig, hog"],"ipa":"/ˈθeɾdo/","gender":"m","forms":{"plural":"cerdos","feminine":"cerda","femininePlural":"cerdas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-Millars-cerdo.wav","formAudio":{"cerda":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-Marreromarco-cerda.wav"},"examples":[{"text":"No sea un cerdo.","en":"Don't be a pig.","audio":"https://tatoeba.org/en/audio/download/440680","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Solía comer como un cerdo.","en":"I used to eat like a pig.","words":[{"g":"to be accustomed to…","l":"soler"},{"g":"to eat"},{"g":"as"},{"g":"a"},null]},{"text":"Los hombres son cerdos.","en":"Men are pigs.","words":[{"g":"the / them"},{"g":"man","l":"hombre"},{"g":"to be","l":"ser"},null]},{"text":"No seas un cerdo en la carretera.","en":"Don't hog the road.","audio":"https://tatoeba.org/en/audio/download/799871","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"in / on"},{"g":"the / her"},{"g":"road, highway"}]},{"text":"Tomás siempre fue un cerdo.","en":"Tom has always been a pig.","audio":"https://tatoeba.org/en/audio/download/518831","words":[{"g":"to take","l":"tomar"},{"g":"always"},{"g":"to be","l":"ser"},{"g":"a"},null]}]}