{"id":"simplemente","lemma":"simplemente","pos":"adv","rank":354,"glosses":["simply"],"ipa":"/ˌsimpleˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Marreromarco-simplemente.wav","examples":[{"text":"Estoy simplemente haciendo mi trabajo.","en":"I'm simply doing my job.","audio":"https://tatoeba.org/en/audio/download/594825","words":[{"g":"to be","l":"estar"},null,{"g":"to do","l":"hacer"},{"g":"my"},{"g":"work, job"}]},{"text":"Simplemente no sé qué decir...","en":"I just don't know what to say.","audio":"https://tatoeba.org/en/audio/download/1307","words":[null,null,null,null,{"g":"to say"}],"phrases":[[1,4,"je ne sais quoi"]]},{"text":"Simplemente no es justo.","en":"It's just not fair.","audio":"https://tatoeba.org/en/audio/download/74792","words":[null,{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"right, just"}]},{"text":"Eso fue simplemente estúpido.","en":"That was just plain stupid.","audio":"https://tatoeba.org/en/audio/download/77051","words":[{"g":"that","l":"ése"},{"g":"to be","l":"ser"},null,{"g":"stupid"}]},{"text":"Simplemente odio cuando eso ocurre.","en":"I just hate when that happens.","words":[null,{"g":"hate"},{"g":"when"},{"g":"that","l":"ése"},{"g":"to happen, to occur","l":"ocurrir"}]}]}