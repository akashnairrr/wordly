{"id":"silencio","lemma":"silencio","pos":"noun","rank":613,"glosses":["silence","rest"],"ipa":"/siˈlenθjo/","gender":"m","forms":{"plural":"silencios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-AdrianAbdulBaha-silencio.wav","examples":[{"text":"Hubo silencio por un momento.","en":"There was silence for a moment.","audio":"https://tatoeba.org/en/audio/download/522413","words":[{"g":"to have","l":"haber"},null,{"g":"for / by"},null,null],"phrases":[[3,5,"one second"]]},{"text":"El silencio es oro.","en":"Silence is golden.","audio":"https://tatoeba.org/en/audio/download/444348","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"gold."}]},{"text":"Todos estábamos en silencio.","en":"All of us were silent.","audio":"https://tatoeba.org/en/audio/download/71017","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},{"g":"in / on"},null]},{"text":"Me gusta comer en silencio.","en":"I like to eat in silence.","words":[null,null,{"g":"to eat"},{"g":"in / on"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Deberías estar en silencio en una biblioteca.","en":"You ought to be quiet in a library.","audio":"https://tatoeba.org/en/audio/download/609234","words":[{"g":"to owe","l":"deber"},{"g":"to be"},{"g":"in / on"},null,{"g":"in / on"},{"g":"a"},{"g":"library"}]}]}