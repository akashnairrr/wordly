{"id":"silencio","lemma":"silencio","pos":"noun","rank":616,"glosses":["silence","rest"],"ipa":"/siˈlenθjo/","gender":"m","forms":{"plural":"silencios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-AdrianAbdulBaha-silencio.wav","examples":[{"text":"Todo está en silencio.","en":"All is quiet.","audio":"https://tatoeba.org/en/audio/download/50931"},{"text":"Nos quedamos en silencio.","en":"We kept quiet.","audio":"https://tatoeba.org/en/audio/download/442949"},{"text":"El silencio es oro.","en":"Silence is golden.","audio":"https://tatoeba.org/en/audio/download/444348"},{"text":"El silencio vale oro.","en":"Silence is golden.","audio":"https://tatoeba.org/en/audio/download/444460"},{"text":"Todos estábamos en silencio.","en":"All of us were silent.","audio":"https://tatoeba.org/en/audio/download/71017"}]}