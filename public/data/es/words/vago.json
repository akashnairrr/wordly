{"id":"vago","lemma":"vago","pos":"noun","rank":3415,"glosses":["wanderer","vagabond, bum","slacker"],"ipa":"/ˈbaɡo/","gender":"m","forms":{"plural":"vagos","feminine":"vaga","femininePlural":"vagas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-vago.wav","examples":[{"text":"Tengo un vago recuerdo de mi abuela.","en":"I have a dim memory of my grandmother.","audio":"https://tatoeba.org/en/audio/download/589722","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"memory"},{"g":"of / from"},{"g":"my"},{"g":"grandmother"}]},{"text":"Es un chico muy vago.","en":"He is a very lazy boy.","audio":"https://tatoeba.org/en/audio/download/706087","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"boy"},null,null]},{"text":"Le dio una respuesta vaga.","en":"He gave a vague answer.","audio":"https://tatoeba.org/en/audio/download/929062","words":[{"g":"him / her"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"reply"},null]},{"text":"Él es vago por naturaleza.","en":"He is lazy by nature.","audio":"https://tatoeba.org/en/audio/download/636445","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"for / by"},{"g":"nature"}]},{"text":"Eres muy vaga.","en":"You're very lazy.","audio":"https://tatoeba.org/en/audio/download/858050","words":[{"g":"to be","l":"ser"},null,null]}]}