{"id":"estacio_n","lemma":"estación","pos":"noun","rank":794,"glosses":["station","season (of the year)"],"ipa":"/estaˈθjon/","gender":"f","forms":{"plural":"estaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q1321_%28spa%29-AdrianAbdulBaha-estaci%C3%B3n.wav","formAudio":{"estaciones":"https://upload.wikimedia.org/wikipedia/commons/9/9c/LL-Q1321_%28spa%29-Marreromarco-estaciones.wav"},"examples":[{"text":"¿Dónde está la estación?","en":"Where is the station?","audio":"https://tatoeba.org/en/audio/download/453185"},{"text":"¿Hay cuatro estaciones en Australia?","en":"Does Australia have four seasons?","audio":"https://tatoeba.org/en/audio/download/302424"},{"text":"Fui a la estación.","en":"I went to the station.","audio":"https://tatoeba.org/en/audio/download/68876"},{"text":"Hay cuatro estaciones al año.","en":"There are four seasons in a year.","audio":"https://tatoeba.org/en/audio/download/554055"},{"text":"Llegué a la estación.","en":"I arrived at the station.","audio":"https://tatoeba.org/en/audio/download/79128"}]}