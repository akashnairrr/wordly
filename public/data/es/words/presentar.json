{"id":"presentar","lemma":"presentar","pos":"verb","rank":1631,"glosses":["to present, to submit","to introduce (someone), to acquaint","to show; to show signs of"],"ipa":"/pɾesenˈtaɾ/","conjugation":{"indicative":{"present":{"1s":"presento","2s":"presentas","3s":"presenta","1p":"presentamos","2p":"presentáis","3p":"presentan"},"imperfect":{"1s":"presentaba","2s":"presentabas","3s":"presentaba","1p":"presentábamos","2p":"presentabais","3p":"presentaban"},"preterite":{"1s":"presenté","2s":"presentaste","3s":"presentó","1p":"presentamos","2p":"presentasteis","3p":"presentaron"},"future":{"1s":"presentaré","2s":"presentarás","3s":"presentará","1p":"presentaremos","2p":"presentaréis","3p":"presentarán"},"conditional":{"1s":"presentaría","2s":"presentarías","3s":"presentaría","1p":"presentaríamos","2p":"presentaríais","3p":"presentarían"}},"subjunctive":{"present":{"1s":"presente","2s":"presentes","3s":"presente","1p":"presentemos","2p":"presentéis","3p":"presenten"},"imperfect":{"1s":"presentara","2s":"presentaras","3s":"presentara","1p":"presentáramos","2p":"presentarais","3p":"presentaran"}},"imperative":{"affirmative":{"2s":"presenta","3s":"presente","1p":"presentemos","2p":"presentad","3p":"presenten"},"negative":{"2s":"presentes","3s":"presente","1p":"presentemos","2p":"presentéis","3p":"presenten"}}},"nonFinite":{"gerund":"presentando","participle":"presentado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-AdrianAbdulBaha-presentar.wav","formAudio":{"presente":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1321_%28spa%29-AdrianAbdulBaha-presente.wav"},"examples":[{"text":"No caeré sin presentar batalla.","en":"I won't go down without a fight.","audio":"https://tatoeba.org/en/audio/download/300124"},{"text":"Me ha presentado a su hermana.","en":"He introduced his sister to me.","audio":"https://tatoeba.org/en/audio/download/598050"},{"text":"Cuando se presenta una oportunidad favorable, no la dejo pasar.","en":"When a good opportunity presents itself, I don't let it pass.","audio":"https://tatoeba.org/en/audio/download/77268"},{"text":"Nos presentamos voluntarios.","en":"We volunteered.","audio":"https://tatoeba.org/en/audio/download/422588"},{"text":"Es muy ceremonioso cuando le presentan una persona desconocida.","en":"He's quite formal when he meets a stranger."}]}