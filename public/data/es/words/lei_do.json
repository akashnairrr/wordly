{"id":"lei_do","lemma":"leído","pos":"adj","rank":1363,"glosses":["well-read"],"ipa":"/leˈido/","forms":{"feminine":"leída","masculinePlural":"leídos","femininePlural":"leídas"},"examples":[{"text":"He leído una carta.","en":"I read a letter.","audio":"https://tatoeba.org/en/audio/download/636980"},{"text":"Dale una leída al artículo.","en":"Read through the article."},{"text":"No todos los libros son dignos de ser leídos.","en":"Not all books are worth reading."},{"text":"He leído tu informe.","en":"I read your report.","audio":"https://tatoeba.org/en/audio/download/821179"},{"text":"Esa novela fue muy leída.","en":"That novel was widely read."}]}