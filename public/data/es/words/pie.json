{"id":"pie","lemma":"pie","pos":"noun","rank":503,"glosses":["foot (a part of the body)","English or American foot (a unit of length equal to 30.48 cm)","pie, a Spanish foot (a former unit of length equivalent to about 27.9 cm)"],"ipa":"/ˈpje/","gender":"m","forms":{"plural":"pies"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-Rodelar-pie.wav","formAudio":{"pies":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q1321_%28spa%29-Marreromarco-pies.wav"},"examples":[{"text":"Iré a pie.","en":"I will go on foot.","audio":"https://tatoeba.org/en/audio/download/540910","words":[{"g":"to go","l":"ir"},{"g":"to"},null]},{"text":"¿Qué le pasó a tu pie?","en":"What happened to your foot?","audio":"https://tatoeba.org/en/audio/download/606562","words":[{"g":"what"},{"g":"him / her"},{"g":"to pass","l":"pasar"},{"g":"to"},{"g":"your"},null]},{"text":"Yo tengo los pies grandes.","en":"I have big feet.","audio":"https://tatoeba.org/en/audio/download/456613","words":[{"g":"I"},{"g":"to have","l":"tener"},{"g":"the / them"},null,{"g":"big, large","l":"grande"}]},{"text":"¿Irás a pie o en autobús?","en":"Will you go on foot or by bus?","audio":"https://tatoeba.org/en/audio/download/645324","words":[{"g":"to go","l":"ir"},{"g":"to"},null,{"g":"or"},{"g":"in / on"},{"g":"bus, coach"}]},{"text":"Ella tiene los pies pequeños.","en":"She has small feet.","audio":"https://tatoeba.org/en/audio/download/551868","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"the / them"},null,{"g":"small","l":"pequeño"}]}]}