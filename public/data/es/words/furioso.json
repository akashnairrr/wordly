{"id":"furioso","lemma":"furioso","pos":"adj","rank":2794,"glosses":["furious, raging","relentless"],"ipa":"/fuˈɾjoso/","forms":{"feminine":"furiosa","masculinePlural":"furiosos","femininePlural":"furiosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Marreromarco-furioso.wav","examples":[{"text":"Mi madre estaba furiosa.","en":"My mother was furious.","audio":"https://tatoeba.org/en/audio/download/460548","words":[{"g":"my"},{"g":"mother"},{"g":"to be","l":"estar"},null]},{"text":"¿Qué te puso tan furioso?","en":"What made you so angry?","audio":"https://tatoeba.org/en/audio/download/459449","words":[{"g":"what"},{"g":"you"},{"g":"to put, to place","l":"poner"},{"g":"so, as"},null]},{"text":"El gobernador estaba furioso.","en":"The governor was furious.","audio":"https://tatoeba.org/en/audio/download/639596","words":[{"g":"the"},{"g":"governing"},{"g":"to be","l":"estar"},null]},{"text":"Mis padres estaban furiosos.","en":"My parents were furious.","words":[{"g":"my"},{"g":"father, parent","l":"padre"},{"g":"to be","l":"estar"},null]},{"text":"Su esposa estaba furiosa.","en":"His wife was mad.","audio":"https://tatoeba.org/en/audio/download/637011","words":[{"g":"his / her / your"},{"g":"wife"},{"g":"to be","l":"estar"},null]}]}