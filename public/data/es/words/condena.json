{"id":"condena","lemma":"condena","pos":"noun","rank":2508,"glosses":["sentence, punishment"],"ipa":"/konˈdena/","gender":"f","forms":{"plural":"condenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q1321_%28spa%29-Emanuelps27-condena.wav","examples":[{"text":"Su hijo está cumpliendo su condena.","en":"His son is serving his sentence.","audio":"https://tatoeba.org/en/audio/download/733657","words":[{"g":"his / her / your"},{"g":"son"},{"g":"to be","l":"estar"},{"g":"to fulfil","l":"cumplir"},{"g":"his / her / your"},null]},{"text":"El acusado no tiene condenas anteriores.","en":"The defendant has no prior convictions.","audio":"https://tatoeba.org/en/audio/download/804288","words":[{"g":"the"},{"g":"accused"},{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"anterior","l":"anterior"}]},{"text":"Tom cumplió condena por robo.","en":"Tom did time for burglary.","audio":"https://tatoeba.org/en/audio/download/803621","words":[null,{"g":"to fulfil","l":"cumplir"},null,{"g":"for / by"},{"g":"robbery, theft"}]},{"text":"La condena de Tom fue de 25 horas de servicio comunitario.","en":"Tom's sentence was 25 hours of community service.","words":[{"g":"the / her"},null,{"g":"of / from"},null,{"g":"to be","l":"ser"},{"g":"of / from"},{"g":"hour","l":"hora"},null,null,{"g":"community"}],"phrases":[[7,9,"on duty"]]},{"text":"Tom tiene al menos una condena por conducir en estado de ebriedad.","en":"Tom has at least one conviction for drunken driving.","words":[null,{"g":"to have","l":"tener"},null,null,{"g":"a"},null,{"g":"for / by"},{"g":"to drive"},null,null,{"g":"of / from"},{"g":"drunkenness"}],"phrases":[[2,4,"at least, at minimum"],[8,10,"expecting, with child"]]}]}