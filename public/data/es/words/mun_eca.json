{"id":"mun_eca","lemma":"muñeca","pos":"noun","rank":1660,"glosses":["wrist"],"ipa":"/muˈɲeka/","gender":"f","forms":{"plural":"muñecas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-AdrianAbdulBaha-mu%C3%B1eca.wav","examples":[{"text":"¿Quién hizo la muñeca?","en":"Who made the doll?","audio":"https://tatoeba.org/en/audio/download/101967","words":[{"g":"who"},{"g":"to do","l":"hacer"},{"g":"the / her"},null]},{"text":"Mi hermana juega con muñecas.","en":"My sister plays with dolls.","audio":"https://tatoeba.org/en/audio/download/551705","words":[{"g":"my"},{"g":"sister"},{"g":"to play","l":"jugar"},{"g":"with"},null]},{"text":"Ella me dio una muñeca.","en":"She gave me a doll.","audio":"https://tatoeba.org/en/audio/download/551606","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"A mi hija le gusta jugar con muñecas.","en":"My daughter likes to play with dolls.","audio":"https://tatoeba.org/en/audio/download/607959","words":[{"g":"to"},{"g":"my"},{"g":"daughter"},{"g":"him / her"},{"g":"to like in a general…","l":"gustar"},{"g":"to play"},{"g":"with"},null]},{"text":"¿Dónde encontraste esa muñeca?","en":"Where did you find that doll?","audio":"https://tatoeba.org/en/audio/download/333740","words":[{"g":"where"},{"g":"to meet","l":"encontrar"},{"g":"that","l":"ese"},null]}]}