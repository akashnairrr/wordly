{"id":"un_a","lemma":"uña","pos":"noun","rank":2271,"glosses":["fingernail, toenail, nail","claw, hoof, stinger"],"ipa":"/ˈuɲa/","gender":"f","forms":{"plural":"uñas"},"order":2291,"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d8/LL-Q1321_%28spa%29-Rodelar-u%C3%B1a.wav","examples":[{"text":"Tengo las uñas demasiado cortas.","en":"My nails are too short.","audio":"https://tatoeba.org/en/audio/download/637227","words":[{"g":"to have","l":"tener"},{"g":"the / them"},null,{"g":"too much"},{"g":"short","l":"corto"}]},{"text":"Nunca me corto las uñas por la noche.","en":"I never cut my nails at night.","audio":"https://tatoeba.org/en/audio/download/641922","words":[{"g":"never"},{"g":"me"},{"g":"short"},{"g":"the / them"},null,null,null,null],"phrases":[[5,8,"at night"]]},{"text":"Me rompí una uña.","en":"I broke a nail.","words":[{"g":"me"},{"g":"to break","l":"romper"},{"g":"a"},null]}]}