{"id":"qui_mico","lemma":"químico","pos":"adj","rank":3740,"glosses":["chemical (of or relating to chemistry)"],"ipa":"/ˈkimiko/","forms":{"feminine":"química","masculinePlural":"químicos","femininePlural":"químicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-AdrianAbdulBaha-qu%C3%ADmico.wav","formAudio":{"química":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-AdrianAbdulBaha-qu%C3%ADmica.wav"},"examples":[{"text":"El magnesio es un elemento químico.","en":"Magnesium is a chemical element.","words":[{"g":"the"},{"g":"magnesium"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"element"},null]},{"text":"El tratado prohíbe el uso de armas químicas.","en":"The treaty bans the use of chemical weapons.","words":[{"g":"the"},{"g":"treaty"},{"g":"to forbid","l":"prohibir"},{"g":"the"},{"g":"use"},{"g":"of / from"},{"g":"weapon, arm","l":"arma"},null]},{"text":"Es más económico que los fertilizantes químicos.","en":"It is cheaper than chemical fertilizers.","audio":"https://tatoeba.org/en/audio/download/733937","words":[null,null,{"g":"economic"},{"g":"that"},{"g":"the / them"},{"g":"fertilizer","l":"fertilizante"},null],"phrases":[[0,2,"furthermore"]]},{"text":"Tenían buena química.","en":"They had good chemistry.","audio":"https://tatoeba.org/en/audio/download/612401","words":[{"g":"to have","l":"tener"},{"g":"good","l":"bueno"},null]},{"text":"¿Estudias química?","en":"Do you study chemistry?","audio":"https://tatoeba.org/en/audio/download/460757","words":[{"g":"to study","l":"estudiar"},null]}]}