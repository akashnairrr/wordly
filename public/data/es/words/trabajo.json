{"id":"trabajo","lemma":"trabajo","pos":"noun","rank":111,"glosses":["work, job","work","school assignment, often a presentation"],"ipa":"/tɾaˈbaxo/","gender":"m","forms":{"plural":"trabajos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1321_%28spa%29-AdrianAbdulBaha-trabajo.wav","examples":[{"text":"¿Hiciste tu trabajo?","en":"Did you do your work?","audio":"https://tatoeba.org/en/audio/download/455458","words":[{"g":"to do","l":"hacer"},{"g":"your"},null]},{"text":"¿Te gusta tu nuevo trabajo?","en":"Do you like your new job?","audio":"https://tatoeba.org/en/audio/download/39346","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"your"},{"g":"new"},null]},{"text":"Tenemos que continuar haciendo nuestros trabajos.","en":"We have to continue to do our jobs.","audio":"https://tatoeba.org/en/audio/download/845548","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to continue"},{"g":"to do","l":"hacer"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"Dame un trabajo.","en":"Give me a job.","audio":"https://tatoeba.org/en/audio/download/440141","words":[{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"Odio mi trabajo.","en":"I hate my job.","audio":"https://tatoeba.org/en/audio/download/440219","words":[{"g":"hate"},{"g":"my"},null]}]}