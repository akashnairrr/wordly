{"id":"trabajo","lemma":"trabajo","pos":"noun","rank":112,"glosses":["work, job","work","school assignment, often a presentation"],"ipa":"/tɾaˈbaxo/","gender":"m","forms":{"plural":"trabajos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1321_%28spa%29-AdrianAbdulBaha-trabajo.wav","examples":[{"text":"¿Qué tal el trabajo?","en":"How's work?","audio":"https://tatoeba.org/en/audio/download/50816"},{"text":"Tom tiene dos trabajos.","en":"Tom has two jobs.","audio":"https://tatoeba.org/en/audio/download/798909"},{"text":"Yo conozco mi trabajo.","en":"I know my job.","audio":"https://tatoeba.org/en/audio/download/440311"},{"text":"Tenemos que continuar haciendo nuestros trabajos.","en":"We have to continue to do our jobs.","audio":"https://tatoeba.org/en/audio/download/845548"},{"text":"Me gusta mi trabajo.","en":"I like my job.","audio":"https://tatoeba.org/en/audio/download/440320"}]}