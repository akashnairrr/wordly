{"id":"aceite","lemma":"aceite","pos":"noun","rank":1977,"glosses":["oil","olive oil"],"ipa":"/aˈθeite/","gender":"m","forms":{"plural":"aceites"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q1321_%28spa%29-Millars-aceite.wav","formAudio":{"aceites":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q1321_%28spa%29-AdrianAbdulBaha-aceites.wav"},"examples":[{"text":"Eso fue cocinado en aceite.","en":"That was cooked in oil.","audio":"https://tatoeba.org/en/audio/download/78219"},{"text":"Él compró mucha harina y aceite.","en":"He bought a lot of flour and oil.","audio":"https://tatoeba.org/en/audio/download/353958"},{"text":"¿Has comprobado el nivel de aceite últimamente?","en":"Have you checked the oil level recently?","audio":"https://tatoeba.org/en/audio/download/831459"},{"text":"El aceite no se mezcla con el agua.","en":"Oil and water don't mix.","audio":"https://tatoeba.org/en/audio/download/534372"},{"text":"Los niños odian el aceite de hígado de bacalao.","en":"Children hate cod liver oil.","audio":"https://tatoeba.org/en/audio/download/804176"}]}