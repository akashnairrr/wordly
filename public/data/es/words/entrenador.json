{"id":"entrenador","lemma":"entrenador","pos":"noun","rank":1277,"glosses":["trainer","manager (UK), coach (US)"],"ipa":"/entɾenaˈdoɾ/","gender":"m","forms":{"plural":"entrenadores","feminine":"entrenadora","femininePlural":"entrenadoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Marreromarco-entrenador.wav","examples":[{"text":"Éste es mi entrenador.","en":"This is my coach.","audio":"https://tatoeba.org/en/audio/download/443396"},{"text":"Ésta es mi entrenadora.","en":"This is my coach.","audio":"https://tatoeba.org/en/audio/download/443397"},{"text":"Eres un buen entrenador.","en":"You're a good coach.","audio":"https://tatoeba.org/en/audio/download/730552"},{"text":"No necesito un entrenador.","en":"I don't need a coach.","audio":"https://tatoeba.org/en/audio/download/630000"},{"text":"Era entrenador de baloncesto.","en":"I used to be a basketball coach.","audio":"https://tatoeba.org/en/audio/download/450807"}]}