{"id":"ropa","lemma":"ropa","pos":"noun","rank":447,"glosses":["garment, clothing, clothes, robes"],"ipa":"/ˈropa/","gender":"f","forms":{"plural":"ropas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q1321_%28spa%29-AdrianAbdulBaha-ropa.wav","examples":[{"text":"¡Pónganse algo de ropa!","en":"Put some clothes on.","audio":"https://tatoeba.org/en/audio/download/448631"},{"text":"Cuelgue usted aquí sus ropas.","en":"Hang your clothes here.","audio":"https://tatoeba.org/en/audio/download/515936"},{"text":"Mi ropa esta ahí.","en":"My clothes are there.","audio":"https://tatoeba.org/en/audio/download/101148"},{"text":"El rey se quitó sus ropas.","en":"The king got undressed.","audio":"https://tatoeba.org/en/audio/download/706125"},{"text":"Mi ropa está allí.","en":"My clothes are there.","audio":"https://tatoeba.org/en/audio/download/455331"}]}