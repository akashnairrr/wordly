{"id":"frontera","lemma":"frontera","pos":"noun","rank":1602,"glosses":["border, frontier","demarcation"],"ipa":"/fɾonˈteɾa/","gender":"f","forms":{"plural":"fronteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-Marreromarco-frontera.wav","formAudio":{"fronteras":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-Sinaloa-Fronteras.wav"},"examples":[{"text":"La frontera está cerrada.","en":"The border is closed.","audio":"https://tatoeba.org/en/audio/download/453932"},{"text":"El deporte no conoce fronteras.","en":"Sport knows no borders."},{"text":"Vivimos cerca de la frontera.","en":"We live near the border.","audio":"https://tatoeba.org/en/audio/download/69226"},{"text":"Francia hace frontera con Italia.","en":"France borders Italy."},{"text":"Tom cruzó la frontera con Francia.","en":"Tom crossed the border into France."}]}