{"id":"frontera","lemma":"frontera","pos":"noun","rank":1599,"glosses":["border, frontier","demarcation"],"ipa":"/fɾonˈteɾa/","gender":"f","forms":{"plural":"fronteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-Marreromarco-frontera.wav","formAudio":{"fronteras":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-Sinaloa-Fronteras.wav"},"examples":[{"text":"La frontera está cerrada.","en":"The border is closed.","audio":"https://tatoeba.org/en/audio/download/453932","words":[{"g":"the / her"},null,{"g":"to be","l":"estar"},{"g":"shut, closed","l":"cerrado"}]},{"text":"Vivimos cerca de la frontera.","en":"We live near the border.","audio":"https://tatoeba.org/en/audio/download/69226","words":[{"g":"to live","l":"vivir"},null,null,{"g":"the / her"},null],"phrases":[[1,3,"close to"]]},{"text":"El deporte no conoce fronteras.","en":"Sport knows no borders.","words":[{"g":"the"},{"g":"sport"},{"g":"no / not"},{"g":"to know","l":"conocer"},null]},{"text":"No estamos ni cerca de la frontera.","en":"We're nowhere near the border.","words":[{"g":"no / not"},{"g":"to be","l":"estar"},{"g":"Forms an emphatic…"},null,null,{"g":"the / her"},null],"phrases":[[3,5,"close to"]]},{"text":"Cruzaron la frontera.","en":"They crossed the border.","audio":"https://tatoeba.org/en/audio/download/821230","words":[{"g":"to cross","l":"cruzar"},{"g":"the / her"},null]}]}