{"id":"pecho","lemma":"pecho","pos":"noun","rank":1242,"glosses":["thorax","chest; the front of the thorax","breast (of a woman)"],"ipa":"/ˈpet͡ʃo/","gender":"m","forms":{"plural":"pechos"},"order":1329,"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-Rodelar-pecho.wav","examples":[{"text":"No te lo tomes a pecho.","en":"Don't take it to heart.","audio":"https://tatoeba.org/en/audio/download/460065","words":[{"g":"no / not"},{"g":"you"},{"g":"it / him"},{"g":"to take","l":"tomar"},{"g":"to"},null]},{"text":"Tengo un dolor agudo en mi pecho.","en":"I have a sharp pain in my chest.","audio":"https://tatoeba.org/en/audio/download/587508","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"pain"},{"g":"sharp, pointed, acute"},{"g":"in / on"},{"g":"my"},null]},{"text":"Tenía tres balazos en el pecho.","en":"He had three bullet wounds in his chest.","words":[{"g":"to have","l":"tener"},{"g":"three"},{"g":"gunshot, shot","l":"balazo"},{"g":"in / on"},{"g":"the"},null]}]}