{"id":"cable","lemma":"cable","pos":"noun","rank":1873,"glosses":["cable, cord","wire","hand, help"],"ipa":"/ˈkable/","gender":"m","forms":{"plural":"cables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-cable.wav","examples":[{"text":"No te comas un cable.","en":"Don't have a cow.","audio":"https://tatoeba.org/en/audio/download/443166"},{"text":"He cambiado algunos cables.","en":"I have changed a few cables.","audio":"https://tatoeba.org/en/audio/download/541052"},{"text":"Necesito un cable USB nuevo.","en":"I need a new USB cable.","audio":"https://tatoeba.org/en/audio/download/460465"},{"text":"Los cables transmiten electricidad.","en":"Wires carry electricity."},{"text":"Corta el cable rojo.","en":"Cut the red wire."}]}