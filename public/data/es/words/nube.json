{"id":"nube","lemma":"nube","pos":"noun","rank":2267,"glosses":["cloud","multitude, or crowd (of people)","baby's breath"],"ipa":"/ˈnube/","gender":"f","forms":{"plural":"nubes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-Rodelar-nube.wav","formAudio":{"nubes":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q1321_%28spa%29-Marreromarco-nubes.wav"},"examples":[{"text":"Mire esas nubes.","en":"Look at those clouds.","audio":"https://tatoeba.org/en/audio/download/517169","words":[{"g":"to look at","l":"mirar"},{"g":"that","l":"ese"},null]},{"text":"No había una nube en el cielo.","en":"There wasn't a cloud in the sky.","audio":"https://tatoeba.org/en/audio/download/514740","words":[{"g":"no / not"},{"g":"makes pluperfect to…"},{"g":"a"},null,{"g":"in / on"},{"g":"the"},{"g":"sky"}]},{"text":"Hoy hay más nubes que ayer.","en":"There are more clouds today than yesterday.","audio":"https://tatoeba.org/en/audio/download/691487","words":[{"g":"today, tonight"},{"g":"to have","l":"haber"},{"g":"more"},null,{"g":"that"},{"g":"yesterday"}]},{"text":"Mira la nube por allá.","en":"Look at the cloud over there.","words":[{"g":"target"},{"g":"the / her"},null,{"g":"for / by"},{"g":"there"}]},{"text":"Las nubes cubrieron el sol.","en":"The clouds hid the sun.","audio":"https://tatoeba.org/en/audio/download/538162","words":[{"g":"the / them"},null,{"g":"to cover","l":"cubrir"},{"g":"the"},{"g":"sun"}]}]}