{"id":"sabido","lemma":"sabido","pos":"adj","rank":1240,"glosses":["well-known"],"ipa":"/saˈbido/","forms":{"feminine":"sabida","masculinePlural":"sabidos","femininePlural":"sabidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-AdrianAbdulBaha-sabido.wav","examples":[{"text":"Tom debería haberlo sabido.","en":"Tom should've known.","audio":"https://tatoeba.org/en/audio/download/107031"},{"text":"¿Has sabido algo de él?","en":"Have you heard from him?","audio":"https://tatoeba.org/en/audio/download/70192"},{"text":"Ojalá hubiera sabido la verdad.","en":"I wish I had known the truth.","audio":"https://tatoeba.org/en/audio/download/333143"},{"text":"Ojalá hubiera sabido hablar francés.","en":"I wish I could've spoken French.","audio":"https://tatoeba.org/en/audio/download/352742"},{"text":"¿Has sabido algo de él últimamente?","en":"Have you heard from him recently?","audio":"https://tatoeba.org/en/audio/download/599187"}]}