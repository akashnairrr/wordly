{"id":"milagro","lemma":"milagro","pos":"noun","rank":1523,"glosses":["miracle","wonder, very unusual event"],"ipa":"/miˈlaɡɾo/","gender":"m","forms":{"plural":"milagros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q1321_%28spa%29-Marreromarco-milagro.wav","examples":[{"text":"Fue un verdadero milagro.","en":"It was truly a miracle.","audio":"https://tatoeba.org/en/audio/download/460764"},{"text":"¿Crees en los milagros?","en":"Do you believe in miracles?","audio":"https://tatoeba.org/en/audio/download/734831"},{"text":"Nos hemos salvado de milagro.","en":"We dodged a bullet on that one.","audio":"https://tatoeba.org/en/audio/download/722540"},{"text":"Yo creo en los milagros.","en":"I believe in miracles.","audio":"https://tatoeba.org/en/audio/download/454269"},{"text":"Es un milagro que Tom siga vivo.","en":"It's a miracle that Tom is still alive.","audio":"https://tatoeba.org/en/audio/download/802741"}]}