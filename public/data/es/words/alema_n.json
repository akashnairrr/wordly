{"id":"alema_n","lemma":"alemán","pos":"adj","rank":1522,"glosses":["German (of, from or relating to Germany)","German (relating to the German language)"],"ipa":"/aleˈman/","forms":{"feminine":"alemana","masculinePlural":"alemanes","femininePlural":"alemanas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q1321_%28spa%29-AdrianAbdulBaha-alem%C3%A1n.wav","formAudio":{"alemana":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-alemana.wav","alemanes":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Precision27-alemanes.wav"},"examples":[{"text":"No entiendo el alemán.","en":"I don't understand German.","audio":"https://tatoeba.org/en/audio/download/12598"},{"text":"La dominación alemana no duró mucho tiempo.","en":"The German domination didn't last very long.","audio":"https://tatoeba.org/en/audio/download/929752"},{"text":"Los coches alemanes son muy populares.","en":"German cars are very popular.","audio":"https://tatoeba.org/en/audio/download/642051"},{"text":"Los hombres alemanes van a la peluquería más a menudo que las mujeres alemanas.","en":"German men go to the hairdresser more often than German women."},{"text":"Él es alemán de nacimiento.","en":"He is German by birth.","audio":"https://tatoeba.org/en/audio/download/706867"}]}