{"id":"modo","lemma":"modo","pos":"noun","rank":456,"glosses":["way, manner","mood"],"ipa":"/ˈmodo/","gender":"m","forms":{"plural":"modos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-modo.wav","examples":[{"text":"No tengo modo de saberlo.","en":"I have no way of knowing.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to know, to understand","l":"saber"}]},{"text":"¿Qué importa de todos modos?","en":"What does it matter anyhow?","words":[{"g":"what"},{"g":"to matter","l":"importar"},{"g":"of / from"},{"g":"all","l":"todo"},null]},{"text":"Me sentía del mismo modo.","en":"I felt the same way.","audio":"https://tatoeba.org/en/audio/download/578470","words":[{"g":"me"},{"g":"to feel","l":"sentir"},null,null,null],"phrases":[[2,4,"thereof"]]},{"text":"Hay un modo mejor.","en":"There is a better way.","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"better"}]},{"text":"Tiene que haber un modo.","en":"There's got to be a way.","audio":"https://tatoeba.org/en/audio/download/78295","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to have"},{"g":"a"},null]}]}