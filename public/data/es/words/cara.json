{"id":"cara","lemma":"cara","pos":"noun","rank":275,"glosses":["face (the front part of the head)","face (one's facial expression)","face (the frontal aspect of something)"],"ipa":"/ˈkaɾa/","gender":"f","forms":{"plural":"caras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Eavqwiki-cara.wav","formAudio":{"caras":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-Eavqwiki-caras.wav"},"examples":[{"text":"Tienes muy mala cara.","en":"You look awful.","audio":"https://tatoeba.org/en/audio/download/541044"},{"text":"Las bodas son caras.","en":"Weddings are expensive.","audio":"https://tatoeba.org/en/audio/download/460908"},{"text":"Tienes cara de sueño.","en":"You look tired.","audio":"https://tatoeba.org/en/audio/download/441451"},{"text":"No vi sus caras.","en":"I didn't see their faces.","audio":"https://tatoeba.org/en/audio/download/594848"},{"text":"Me sequé la cara.","en":"I dried my face.","audio":"https://tatoeba.org/en/audio/download/552241"}]}