{"id":"oeste","lemma":"oeste","pos":"noun","rank":1117,"glosses":["west"],"ipa":"/oˈeste/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-oeste.wav","examples":[{"text":"Soy de la costa oeste.","en":"I'm from the West Coast.","audio":"https://tatoeba.org/en/audio/download/582544","words":[{"g":"to be","l":"ser"},null,null,{"g":"coast, coastline"},null],"phrases":[[1,3,"of the"]]},{"text":"La estación está al oeste del hotel.","en":"The station is to the west of the hotel.","audio":"https://tatoeba.org/en/audio/download/37874","words":[{"g":"the / her"},{"g":"station"},{"g":"to be","l":"estar"},{"g":"to the"},null,{"g":"of the"},{"g":"hotel"}]},{"text":"Tom se fue al oeste.","en":"Tom went west.","words":[null,{"g":"oneself"},{"g":"to be","l":"ser"},{"g":"to the"},null]},{"text":"Te recomiendo que vayas al oeste.","en":"I suggest you go west.","audio":"https://tatoeba.org/en/audio/download/455024","words":[{"g":"you"},{"g":"to recommend","l":"recomendar"},{"g":"that"},{"g":"what a ...","l":"vaya"},{"g":"to the"},null]},{"text":"El sol se pone en el oeste.","en":"The sun sets in the west.","words":[{"g":"the"},{"g":"sun"},{"g":"oneself"},{"g":"to put, to place","l":"poner"},{"g":"in / on"},{"g":"the"},null]}]}