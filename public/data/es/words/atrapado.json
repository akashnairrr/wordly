{"id":"atrapado","lemma":"atrapado","pos":"adj","rank":1500,"glosses":["caught, captured, trapped, stuck","caught up in"],"ipa":"/atɾaˈpado/","forms":{"feminine":"atrapada","masculinePlural":"atrapados","femininePlural":"atrapadas"},"examples":[{"text":"Tom se sintió atrapado.","en":"Tom felt trapped.","audio":"https://tatoeba.org/en/audio/download/799236"},{"text":"Ella ha estado atrapada desde hace una hora.","en":"She has been trapped an hour already."},{"text":"Parece que estamos atrapados.","en":"We seem to be trapped.","audio":"https://tatoeba.org/en/audio/download/459963"},{"text":"Algunas personas se sintieron atrapadas.","en":"Some people felt trapped.","audio":"https://tatoeba.org/en/audio/download/803611"},{"text":"Tom se sentía atrapado.","en":"Tom felt trapped.","audio":"https://tatoeba.org/en/audio/download/799237"}]}