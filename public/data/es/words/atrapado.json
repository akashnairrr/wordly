{"id":"atrapado","lemma":"atrapado","pos":"adj","rank":1497,"glosses":["caught, captured, trapped, stuck","caught up in"],"ipa":"/atɾaˈpado/","forms":{"feminine":"atrapada","masculinePlural":"atrapados","femininePlural":"atrapadas"},"examples":[{"text":"Hay alguien atrapado en el coche.","en":"There's someone trapped in the car.","audio":"https://tatoeba.org/en/audio/download/531744","words":[{"g":"to have","l":"haber"},{"g":"someone, somebody"},null,{"g":"in / on"},{"g":"the"},{"g":"car, automobile"}]},{"text":"Parece que estamos atrapados.","en":"We seem to be trapped.","audio":"https://tatoeba.org/en/audio/download/459963","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to be","l":"estar"},null]},{"text":"¿Has atrapado un pez alguna vez?","en":"Have you ever caught a fish?","words":[{"g":"to have","l":"haber"},null,{"g":"a"},{"g":"fish"},null,null],"phrases":[[4,6,"ever"]]},{"text":"Ellos están atrapados.","en":"They're trapped.","audio":"https://tatoeba.org/en/audio/download/442186","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},null]},{"text":"Estoy atrapado en un lío.","en":"I'm stuck in a rut.","audio":"https://tatoeba.org/en/audio/download/800067","words":[{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"a"},{"g":"bundle"}]}]}