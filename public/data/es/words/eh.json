{"id":"eh","lemma":"eh","pos":"intj","rank":178,"glosses":["hey! (used to call, draw attention, warn or reprehend)","uh, um (space filler in a conversation, expression of hesitation or pause in speech)","huh? (expresses confusion)"],"ipa":"/ˈe/","examples":[{"text":"¡Eh, yo te conozco!","en":"Hey. I know you.","audio":"https://tatoeba.org/en/audio/download/128120","words":[null,null,null,null],"phrases":[[1,4,"I know what you're like"]]},{"text":"Tú no estás para nada de acuerdo, ¿eh?","en":"You don't agree, do you?","audio":"https://tatoeba.org/en/audio/download/704342","words":[{"g":"you"},{"g":"no / not"},{"g":"to be","l":"estar"},null,null,null,null,null],"phrases":[[3,5,"not at all"],[5,7,"agreed"]]},{"text":"¡Eh, tú! ¿Qué haces?","en":"Hey, you! What are you doing?","audio":"https://tatoeba.org/en/audio/download/642067","words":[null,{"g":"you"},{"g":"what"},{"g":"to do","l":"hacer"}]},{"text":"¡Eh! ¿Qué ha pasado?","en":"Hey, what happened?","audio":"https://tatoeba.org/en/audio/download/79815","words":[null,{"g":"what"},{"g":"to have","l":"haber"},{"g":"past"}]},{"text":"¡Eh! ¿Adónde vas?","en":"Hey, where're you going?","audio":"https://tatoeba.org/en/audio/download/517302","words":[null,{"g":"to where"},{"g":"to go","l":"ir"}]}]}