{"id":"pero","lemma":"pero","pos":"conj","rank":23,"glosses":["but","well well; so; well (used for emphasis)","expresses surprise"],"ipa":"/ˈpeɾo/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-AdrianAbdulBaha-pero.wav","examples":[{"text":"Gracias, pero no.","en":"Thanks but no thanks.","audio":"https://tatoeba.org/en/audio/download/509828","words":[{"g":"thank you, thanks"},null,{"g":"no / not"}]},{"text":"Pero, ¿te gusta?","en":"But do you like it?","words":[null,{"g":"you"},{"g":"to like in a general…","l":"gustar"}]},{"text":"Él es bajo, pero fuerte.","en":"He is short, but strong.","audio":"https://tatoeba.org/en/audio/download/639260","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"short"},null,{"g":"strong"}]},{"text":"¿Pero en qué demonios estabas pensando?","en":"What on earth were you thinking?","audio":"https://tatoeba.org/en/audio/download/430168","words":[null,{"g":"in / on"},null,null,{"g":"to be","l":"estar"},{"g":"to think, ponder","l":"pensar"}],"phrases":[[2,4,"what the devil"]]},{"text":"¿Pero qué harás si no viene?","en":"But what will you do if he doesn't come?","audio":"https://tatoeba.org/en/audio/download/689292","words":[null,{"g":"what"},{"g":"to do","l":"hacer"},null,null,{"g":"to come","l":"venir"}],"phrases":[[3,5,"if not"]]}]}