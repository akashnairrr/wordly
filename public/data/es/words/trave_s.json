{"id":"trave_s","lemma":"través","pos":"noun","rank":545,"glosses":["bend, turn"],"ipa":"/tɾaˈbes/","gender":"m","forms":{"plural":"traveses"},"order":745,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q1321_%28spa%29-Precision27-trav%C3%A9s.wav","examples":[{"text":"Él nadó a través del río.","en":"He swam across the river.","words":[{"g":"he"},{"g":"to swim","l":"nadar"},{"g":"to"},null,{"g":"of the"},{"g":"river"}]},{"text":"Condujimos a través de la ciudad.","en":"We drove across the city.","words":[{"g":"to drive","l":"conducir"},{"g":"to"},null,null,null,{"g":"city"}],"phrases":[[3,5,"of the"]]},{"text":"El tren fue a través del túnel.","en":"The train went through a tunnel.","words":[{"g":"the"},{"g":"train"},{"g":"to be","l":"ser"},{"g":"to"},null,{"g":"of the"},{"g":"tunnel"}]}]}