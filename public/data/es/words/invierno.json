{"id":"invierno","lemma":"invierno","pos":"noun","rank":1577,"glosses":["winter"],"ipa":"/imˈbjeɾno/","gender":"m","forms":{"plural":"inviernos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q1321_%28spa%29-AdrianAbdulBaha-invierno.wav","examples":[{"text":"Me gusta el invierno.","en":"I like winter.","audio":"https://tatoeba.org/en/audio/download/38593"},{"text":"Hemos pasado unos inviernos muy fríos.","en":"We've had some very cold winters.","audio":"https://tatoeba.org/en/audio/download/581991"},{"text":"El invierno se acerca.","en":"Winter is coming.","audio":"https://tatoeba.org/en/audio/download/461515"},{"text":"Hemos tenido unos inviernos muy fríos.","en":"We've had some very cold winters.","audio":"https://tatoeba.org/en/audio/download/581992"},{"text":"Está llegando el invierno.","en":"Winter is coming.","audio":"https://tatoeba.org/en/audio/download/799064"}]}