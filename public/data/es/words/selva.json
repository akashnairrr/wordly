{"id":"selva","lemma":"selva","pos":"noun","rank":2725,"glosses":["jungle","forest"],"ipa":"/ˈselba/","gender":"f","forms":{"plural":"selvas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-AdrianAbdulBaha-selva.wav","examples":[{"text":"El león es el rey de la selva.","en":"The lion is the king of the jungle.","audio":"https://tatoeba.org/en/audio/download/34529","words":[{"g":"the"},{"g":"lion"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"king"},null,null,null],"phrases":[[5,7,"of the"]]},{"text":"En esa selva hay mucha caza mayor.","en":"There's a lot of big game in that forest.","words":[{"g":"in / on"},{"g":"that","l":"ese"},null,{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,null],"phrases":[[5,7,"big game hunting"]]},{"text":"Debemos proteger la selva tropical.","en":"We must protect the rainforest.","audio":"https://tatoeba.org/en/audio/download/611714","words":[{"g":"to owe","l":"deber"},{"g":"to protect, to defend"},{"g":"the / her"},null,{"g":"tropical"}]},{"text":"Él exploró la selva amazónica.","en":"He explored the Amazon jungle.","words":[{"g":"he"},null,{"g":"the / her"},null,null]},{"text":"Tenés que tener cuidado cuando estás en la selva.","en":"You have to be careful when you're in the jungle.","words":[{"g":"to have","l":"tener"},{"g":"that"},null,null,{"g":"when"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the / her"},null],"phrases":[[2,4,"to take care"]]}]}