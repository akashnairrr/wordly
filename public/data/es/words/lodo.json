{"id":"lodo","lemma":"lodo","pos":"noun","rank":4384,"glosses":["mud; muck; mire"],"ipa":"/ˈlodo/","gender":"m","forms":{"plural":"lodos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Marreromarco-lodo.wav","examples":[{"text":"Ella lo sacó del lodo.","en":"She pulled him out of the mud.","audio":"https://tatoeba.org/en/audio/download/522198","words":[{"g":"she"},{"g":"it / him"},{"g":"to put out, to get out","l":"sacar"},{"g":"of the"},null]},{"text":"Nos dimos un baño de lodo.","en":"We took a mud bath.","audio":"https://tatoeba.org/en/audio/download/75810","words":[{"g":"us"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"bath"},{"g":"of / from"},null]},{"text":"Sus manos estaban cubiertas con lodo.","en":"His hands were covered with mud.","words":[{"g":"his, her, its, their"},{"g":"hand","l":"mano"},{"g":"to be","l":"estar"},{"g":"covered","l":"cubierto"},{"g":"with"},null]}]}