{"id":"veces","lemma":"veces","pos":"prep","rank":176,"glosses":["by, times (multiplication)"],"ipa":"/ˈbeθes/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-Eavqwiki-veces.wav","examples":[{"text":"Lo comprobé dos veces.","en":"I checked it twice.","audio":"https://tatoeba.org/en/audio/download/821254"},{"text":"Él vino varias veces.","en":"He came several times.","audio":"https://tatoeba.org/en/audio/download/34689"},{"text":"A veces me asustas.","en":"Sometimes you scare me.","audio":"https://tatoeba.org/en/audio/download/458661"},{"text":"Fallaron las dos veces.","en":"They failed both times.","audio":"https://tatoeba.org/en/audio/download/639418"},{"text":"A veces robo cosas.","en":"I sometimes steal stuff.","audio":"https://tatoeba.org/en/audio/download/518641"}]}