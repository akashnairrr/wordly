{"id":"constante","lemma":"constante","pos":"adj","rank":2725,"glosses":["constant"],"ipa":"/konsˈtante/","forms":{"femininePlural":"constantes"},"order":2731,"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Marreromarco-constante.wav","examples":[{"text":"Viven en constante miedo.","en":"They live in constant fear.","words":[{"g":"to applaud","l":"vivar"},{"g":"in / on"},null,{"g":"fear"}]},{"text":"Estoy harto de tus constantes quejas.","en":"I'm fed up with your constant complaining.","audio":"https://tatoeba.org/en/audio/download/594282","words":[{"g":"to be","l":"estar"},{"g":"tired, fed up"},{"g":"of / from"},{"g":"your"},null,{"g":"complaint","l":"queja"}]},{"text":"Sus insultos constantes encendieron su ira.","en":"His constant insults aroused her anger.","words":[{"g":"his, her, its, their"},{"g":"insult","l":"insulto"},null,{"g":"to light, ignite","l":"encender"},{"g":"his / her / your"},{"g":"anger, ire"}]}]}