{"id":"verdaderamente","lemma":"verdaderamente","pos":"adv","rank":2148,"glosses":["truthfully"],"ipa":"/beɾdaˌdeɾaˈmente/","examples":[{"text":"Nada verdaderamente importa.","en":"Nothing really matters.","audio":"https://tatoeba.org/en/audio/download/460518","words":[{"g":"nothing"},null,{"g":"to matter","l":"importar"}]},{"text":"Verdaderamente no entiendo esta parte.","en":"I don't really understand this part.","audio":"https://tatoeba.org/en/audio/download/451526","words":[null,null,null,{"g":"this","l":"este"},{"g":"part"}],"phrases":[[1,3,"I don't understand"]]},{"text":"Verdaderamente parece el fin del mundo.","en":"It really looks like the end of the world.","audio":"https://tatoeba.org/en/audio/download/728634","words":[null,{"g":"to seem, to see fit","l":"parecer"},{"g":"the"},null,null,null],"phrases":[[3,6,"end of the world"]]},{"text":"Ha hecho una cosa verdaderamente estúpida.","en":"I've done a truly stupid thing.","audio":"https://tatoeba.org/en/audio/download/707719","words":[{"g":"to have","l":"haber"},{"g":"done, completed"},{"g":"a"},{"g":"thing"},null,{"g":"stupid","l":"estúpido"}]},{"text":"Es verdaderamente importante.","en":"It's really important.","audio":"https://tatoeba.org/en/audio/download/559454","words":[{"g":"to be","l":"ser"},null,{"g":"important"}]}]}