{"id":"viejo","lemma":"viejo","pos":"noun","rank":279,"glosses":["old person","old man (one's father)","guy or man, especially an adult or a male close to adulthood"],"ipa":"/ˈbjexo/","gender":"m","forms":{"plural":"viejos","feminine":"vieja","femininePlural":"viejas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-Rodelar-viejo.wav","formAudio":{"vieja":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1321_%28spa%29-Marreromarco-vieja.wav"},"examples":[{"text":"Soy un hombre viejo.","en":"I'm an old man.","audio":"https://tatoeba.org/en/audio/download/851491"},{"text":"Él usaba zapatos viejos.","en":"He wore old shoes.","audio":"https://tatoeba.org/en/audio/download/443888"},{"text":"Es una vieja costumbre.","en":"It's an old custom.","audio":"https://tatoeba.org/en/audio/download/448940"},{"text":"Cantó algunas viejas canciones.","en":"He sang some old songs.","audio":"https://tatoeba.org/en/audio/download/637165"},{"text":"Soy el más viejo.","en":"I'm the oldest.","audio":"https://tatoeba.org/en/audio/download/163211"}]}