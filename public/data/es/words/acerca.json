{"id":"acerca","lemma":"acerca","pos":"adv","rank":374,"glosses":["only used in acerca de (“about; concerning”)"],"ipa":"/aˈθeɾka/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-Marreromarco-acerca.wav","examples":[{"text":"¿Sabes algo acerca de esto?","en":"Do you know anything about this?","audio":"https://tatoeba.org/en/audio/download/522162","words":[{"g":"to know, to understand","l":"saber"},{"g":"something, anything"},null,{"g":"of / from"},{"g":"this"}]},{"text":"¿Quién más sabe acerca de esto?","en":"Who else knows about this?","audio":"https://tatoeba.org/en/audio/download/587536","words":[{"g":"who"},{"g":"more"},{"g":"to know, to understand","l":"saber"},null,{"g":"of / from"},{"g":"this"}]},{"text":"He oído acerca de ti.","en":"I've heard of you.","audio":"https://tatoeba.org/en/audio/download/444026","words":[{"g":"to have","l":"haber"},{"g":"hearing"},null,{"g":"of / from"},{"g":"you","l":"tú"}]},{"text":"Hablemos acerca del problema.","en":"Let's talk about the problem.","audio":"https://tatoeba.org/en/audio/download/600212","words":[{"g":"to talk","l":"hablar"},null,{"g":"of the"},{"g":"problem"}]},{"text":"Se acerca el fin del mundo.","en":"The end of the world is nearing.","audio":"https://tatoeba.org/en/audio/download/765635","words":[{"g":"oneself"},null,{"g":"the"},null,null,null],"phrases":[[3,6,"end of the world"]]}]}