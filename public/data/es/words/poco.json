{"id":"poco","lemma":"poco","pos":"det","rank":104,"glosses":["little, not much","few, not many","un-, not"],"ipa":"/ˈpoko/","forms":{"plural":"pocos","feminine":"poca","femininePlural":"pocas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q1321_%28spa%29-Precision27-poco.wav","formAudio":{"pocos":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q1321_%28spa%29-Rodelar-pocos.wav"},"examples":[{"text":"Quiero un poco más.","en":"I need more.","audio":"https://tatoeba.org/en/audio/download/442666"},{"text":"Ella tiene pocos amigos.","en":"She has few friends.","audio":"https://tatoeba.org/en/audio/download/34947"},{"text":"Ellos son de poca confianza.","en":"They're unreliable.","audio":"https://tatoeba.org/en/audio/download/501683"},{"text":"Pocas personas piensan así.","en":"Few people think so.","audio":"https://tatoeba.org/en/audio/download/44705"},{"text":"Venga, canta un poco.","en":"Try and sing.","audio":"https://tatoeba.org/en/audio/download/850213"}]}