{"id":"partida","lemma":"partida","pos":"noun","rank":1996,"glosses":["departure","match, lot, game (of cards, video games etc.)","passing (death)"],"ipa":"/paɾˈtida/","gender":"f","forms":{"plural":"partidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q1321_%28spa%29-Marreromarco-partida.wav","examples":[{"text":"¡Se acabó la partida!","en":"The game is over.","audio":"https://tatoeba.org/en/audio/download/444410"},{"text":"He ganado la partida.","en":"I have won the game.","audio":"https://tatoeba.org/en/audio/download/514946"},{"text":"Tom ganará esta partida.","en":"Tom will win this game.","audio":"https://tatoeba.org/en/audio/download/806090"},{"text":"Él ganará probablemente la partida.","en":"He is likely to win the game.","audio":"https://tatoeba.org/en/audio/download/598066"},{"text":"Si llueve pospondré mi partida.","en":"I will put off my departure if it rains.","audio":"https://tatoeba.org/en/audio/download/689402"}]}