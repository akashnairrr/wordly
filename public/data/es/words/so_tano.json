{"id":"so_tano","lemma":"sótano","pos":"noun","rank":1587,"glosses":["cellar","basement","pit"],"ipa":"/ˈsotano/","gender":"m","forms":{"plural":"sótanos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Marreromarco-s%C3%B3tano.wav","examples":[{"text":"El sótano quedó anegado.","en":"The basement was flooded.","audio":"https://tatoeba.org/en/audio/download/532431"},{"text":"Los sótanos están anegados.","en":"The basements are flooded.","audio":"https://tatoeba.org/en/audio/download/532430"},{"text":"Tenemos inquilinos en el sótano.","en":"We have tenants in the basement.","audio":"https://tatoeba.org/en/audio/download/871443"},{"text":"Está en el sótano.","en":"It's in the basement."},{"text":"Mi sótano está inundado.","en":"My basement is flooded."}]}