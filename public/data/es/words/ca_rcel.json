{"id":"ca_rcel","lemma":"cárcel","pos":"noun","rank":612,"glosses":["prison"],"ipa":"/ˈkaɾθel/","gender":"f","forms":{"plural":"cárceles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-Marreromarco-c%C3%A1rcel.wav","examples":[{"text":"Estoy en la cárcel.","en":"I'm in jail.","audio":"https://tatoeba.org/en/audio/download/439089"},{"text":"Las cárceles están superpobladas.","en":"Prisons are overcrowded."},{"text":"Él está en la cárcel.","en":"He's in prison.","audio":"https://tatoeba.org/en/audio/download/823676"},{"text":"Podría ir a la cárcel.","en":"I could go to jail.","audio":"https://tatoeba.org/en/audio/download/448618"},{"text":"Él acabará en la cárcel.","en":"He will end up in jail.","audio":"https://tatoeba.org/en/audio/download/636871"}]}