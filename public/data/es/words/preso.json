{"id":"preso","lemma":"preso","pos":"adj","rank":2943,"glosses":["imprisoned"],"ipa":"/ˈpɾeso/","forms":{"feminine":"presa","masculinePlural":"presos","femininePlural":"presas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q1321_%28spa%29-Emanuelps27-preso.wav","formAudio":{"presa":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-presa.wav"},"examples":[{"text":"Está preso, pero es inocente.","en":"He is prisoner, but he is innocent.","words":[{"g":"to be","l":"estar"},null,{"g":"but"},{"g":"to be","l":"ser"},{"g":"innocent"}]},{"text":"El preso se ha fugado.","en":"The prisoner has escaped.","audio":"https://tatoeba.org/en/audio/download/439838","words":[{"g":"the"},null,{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to escape","l":"fugar"}]},{"text":"El fugitivo ya está preso.","en":"The fugitive has been caught.","audio":"https://tatoeba.org/en/audio/download/456446","words":[{"g":"the"},{"g":"fugitive"},null,null,null],"phrases":[[2,4,"that's it"]]},{"text":"Se han escapado unos presos de la cárcel.","en":"Some prisoners have escaped from the jail.","words":[{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to escape, get out","l":"escapar"},{"g":"about, approximately"},null,null,null,{"g":"prison"}],"phrases":[[5,7,"of the"]]},{"text":"Lo metieron preso.","en":"He was put in prison.","audio":"https://tatoeba.org/en/audio/download/454039","words":[{"g":"it / him"},{"g":"to put in, insert","l":"meter"},null]}]}