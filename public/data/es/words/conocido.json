{"id":"conocido","lemma":"conocido","pos":"adj","rank":681,"glosses":["known","well-known, famous, renowned","familiar"],"ipa":"/konoˈθido/","forms":{"feminine":"conocida","masculinePlural":"conocidos","femininePlural":"conocidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/97/LL-Q1321_%28spa%29-Marreromarco-conocido.wav","examples":[{"text":"Ojalá la hubiera conocido.","en":"I wish I'd met her.","audio":"https://tatoeba.org/en/audio/download/69825"},{"text":"Esa canción me resulta conocida.","en":"That song sounds familiar to me.","audio":"https://tatoeba.org/en/audio/download/589756"},{"text":"Él tiene muchos conocidos pero pocos amigos.","en":"He has many acquaintances but few friends."},{"text":"Ya la había conocido.","en":"I have seen her before.","audio":"https://tatoeba.org/en/audio/download/458567"},{"text":"Esa canción me suena conocida.","en":"That song sounds familiar to me."}]}