{"id":"haya","lemma":"haya","pos":"noun","rank":288,"glosses":["beech, beech tree"],"ipa":"/ˈaʝa/","gender":"f","forms":{"plural":"hayas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/47/LL-Q1321_%28spa%29-AdrianAbdulBaha-haya.wav","examples":[{"text":"Espero que haya suerte.","en":"I hope it goes well.","audio":"https://tatoeba.org/en/audio/download/298922"},{"text":"Puede que no me hayas oído.","en":"Maybe you didn't hear me.","audio":"https://tatoeba.org/en/audio/download/126677"},{"text":"Puede que haya otros.","en":"There may be others.","audio":"https://tatoeba.org/en/audio/download/449008"},{"text":"Me ha conmovido que hayas recordado.","en":"I'm touched you remembered.","audio":"https://tatoeba.org/en/audio/download/803818"},{"text":"Puede que haya mentido.","en":"He may have told a lie.","audio":"https://tatoeba.org/en/audio/download/636739"}]}