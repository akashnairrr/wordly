{"id":"haya","lemma":"haya","pos":"noun","rank":285,"glosses":["beech, beech tree"],"ipa":"/ˈaʝa/","gender":"f","forms":{"plural":"hayas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/47/LL-Q1321_%28spa%29-AdrianAbdulBaha-haya.wav","examples":[{"text":"No parece que haya prisa.","en":"There seems to be no need to hurry.","audio":"https://tatoeba.org/en/audio/download/353391","words":[{"g":"no / not"},{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},null,{"g":"hurry, rush, urgency"}]},{"text":"Puede que él lo haya visto.","en":"He may have seen it.","audio":"https://tatoeba.org/en/audio/download/568417","words":[null,null,{"g":"he"},{"g":"it / him"},null,{"g":"seen"}],"phrases":[[0,2,"it may be that"]]},{"text":"Puede que haya algo de verdad.","en":"There may be some truth to this.","audio":"https://tatoeba.org/en/audio/download/568561","words":[null,null,null,{"g":"something, anything"},null,null],"phrases":[[0,2,"it may be that"],[4,6,"really"]]},{"text":"Me gusta que no haya nadie alrededor.","en":"I like that there's no one around.","audio":"https://tatoeba.org/en/audio/download/422552","words":[null,null,{"g":"that"},{"g":"no / not"},null,{"g":"no one"},{"g":"around"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Puede que haya perdido el tren.","en":"Perhaps he missed the train.","audio":"https://tatoeba.org/en/audio/download/642059","words":[null,null,null,{"g":"lost"},{"g":"the"},{"g":"train"}],"phrases":[[0,2,"it may be that"]]}]}