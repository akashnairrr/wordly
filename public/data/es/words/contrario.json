{"id":"contrario","lemma":"contrario","pos":"adj","rank":963,"glosses":["contrary, opposite","opposed, against"],"ipa":"/konˈtɾaɾjo/","forms":{"feminine":"contraria","masculinePlural":"contrarios","femininePlural":"contrarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-contrario.wav","examples":[{"text":"No finjamos lo contrario.","en":"Let's not pretend otherwise.","audio":"https://tatoeba.org/en/audio/download/803940"},{"text":"Yo voy en dirección contraria.","en":"I'm headed the other way.","audio":"https://tatoeba.org/en/audio/download/541285"},{"text":"No creamos lo contrario.","en":"Let's not pretend otherwise.","audio":"https://tatoeba.org/en/audio/download/611807"},{"text":"No pretendamos lo contrario.","en":"Let's not pretend otherwise.","audio":"https://tatoeba.org/en/audio/download/803942"},{"text":"Lo contrario es cierto también.","en":"The converse is also true.","audio":"https://tatoeba.org/en/audio/download/703940"}]}