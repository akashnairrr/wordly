{"id":"contrario","lemma":"contrario","pos":"adj","rank":960,"glosses":["contrary, opposite","opposed, against"],"ipa":"/konˈtɾaɾjo/","forms":{"feminine":"contraria","masculinePlural":"contrarios","femininePlural":"contrarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-contrario.wav","examples":[{"text":"Hizo lo contrario.","en":"He did the opposite.","audio":"https://tatoeba.org/en/audio/download/450537","words":[{"g":"to do","l":"hacer"},{"g":"it / him"},null]},{"text":"No tengo ninguna prueba de lo contrario.","en":"I have no proof to the contrary.","audio":"https://tatoeba.org/en/audio/download/645397","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"nobody","l":"ninguno"},{"g":"proof"},{"g":"of / from"},{"g":"it / him"},null]},{"text":"Yo voy en dirección contraria.","en":"I'm headed the other way.","audio":"https://tatoeba.org/en/audio/download/541285","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"in / on"},{"g":"direction"},null]},{"text":"De hecho, es todo lo contrario.","en":"Actually, it's exactly the opposite.","audio":"https://tatoeba.org/en/audio/download/519093","words":[null,null,{"g":"to be","l":"ser"},{"g":"all"},{"g":"it / him"},null],"phrases":[[0,2,"in fact"]]},{"text":"¡Él me dijo justo lo contrario!","en":"He told me just the opposite!","words":[{"g":"he"},{"g":"me"},{"g":"to say","l":"decir"},{"g":"right, just"},{"g":"it / him"},null]}]}