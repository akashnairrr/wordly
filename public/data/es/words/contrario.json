{"id":"contrario","lemma":"contrario","pos":"adj","rank":960,"glosses":["contrary, opposite","opposed, against"],"ipa":"/konˈtɾaɾjo/","forms":{"feminine":"contraria","masculinePlural":"contrarios","femininePlural":"contrarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-contrario.wav","examples":[{"text":"Yo voy en dirección contraria.","en":"I'm headed the other way.","audio":"https://tatoeba.org/en/audio/download/541285","words":[{"g":"I"},{"g":"to go","l":"ir"},{"g":"in / on"},{"g":"direction"},null]},{"text":"Hizo lo contrario.","en":"He did the opposite.","audio":"https://tatoeba.org/en/audio/download/450537","words":[{"g":"to do","l":"hacer"},{"g":"it / him"},null]},{"text":"Lo contrario es cierto también.","en":"The converse is also true.","audio":"https://tatoeba.org/en/audio/download/703940","words":[{"g":"it / him"},null,{"g":"to be","l":"ser"},{"g":"a certain, a specific"},{"g":"also, too, as well"}]},{"text":"¡Me dijo justo lo contrario!","en":"He told me just the opposite!","words":[{"g":"me"},{"g":"to say","l":"decir"},{"g":"right, just"},{"g":"it / him"},null]},{"text":"No tengo ninguna prueba de lo contrario.","en":"I have no proof to the contrary.","audio":"https://tatoeba.org/en/audio/download/645397","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"nobody","l":"ninguno"},{"g":"proof"},{"g":"of / from"},{"g":"it / him"},null]}]}