{"id":"receta","lemma":"receta","pos":"noun","rank":2515,"glosses":["prescription (a doctor's written order authorizing medicine or a treatment)","recipe (instructions for cooking food)"],"ipa":"/reˈθeta/","gender":"f","forms":{"plural":"recetas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-receta.wav","examples":[{"text":"¿Me puedes dar la receta?","en":"Can you give me the recipe?","audio":"https://tatoeba.org/en/audio/download/616296","words":[{"g":"me"},{"g":"to be able to, can","l":"poder"},{"g":"to give, to give out"},{"g":"the / her"},null]},{"text":"El médico me dio una receta.","en":"The doctor gave me a prescription.","audio":"https://tatoeba.org/en/audio/download/416178","words":[{"g":"the"},{"g":"doctor"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"¿Viste mi libro de recetas?","en":"Have you seen my recipe book?","words":[{"g":"you know"},{"g":"my"},{"g":"book"},{"g":"of / from"},null]},{"text":"Déjame ver tu receta médica.","en":"Let me see your prescription.","audio":"https://tatoeba.org/en/audio/download/599192","words":[{"g":"to leave","l":"dejar"},{"g":"to see, to spot"},{"g":"your"},null,{"g":"doctor","l":"médico"}]},{"text":"Deberías pedirle la receta a mi mamá.","en":"You should ask my mom for the recipe.","words":[{"g":"to owe","l":"deber"},{"g":"to ask for something","l":"pedir"},{"g":"the / her"},null,{"g":"to"},{"g":"my"},{"g":"mum, mom"}]}]}