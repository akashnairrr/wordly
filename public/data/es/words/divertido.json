{"id":"divertido","lemma":"divertido","pos":"adj","rank":469,"glosses":["entertaining, amusing, funny"],"ipa":"/dibeɾˈtido/","forms":{"feminine":"divertida","masculinePlural":"divertidos","femininePlural":"divertidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q1321_%28spa%29-Marreromarco-divertido.wav","examples":[{"text":"Eso no es divertido.","en":"That's not funny.","audio":"https://tatoeba.org/en/audio/download/444314"},{"text":"La vida es divertida.","en":"Life is fun.","audio":"https://tatoeba.org/en/audio/download/438387"},{"text":"Los perros son divertidos.","en":"Dogs are fun."},{"text":"Las fiestas son divertidas.","en":"Parties are fun.","audio":"https://tatoeba.org/en/audio/download/442180"},{"text":"No fue muy divertido.","en":"It wasn't very fun.","audio":"https://tatoeba.org/en/audio/download/525465"}]}