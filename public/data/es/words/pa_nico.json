{"id":"pa_nico","lemma":"pánico","pos":"adj","rank":1749,"glosses":["pertaining to the god Pan","panic (of fear, fright etc.)"],"ipa":"/ˈpaniko/","forms":{"feminine":"pánica","masculinePlural":"pánicos","femininePlural":"pánicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-Marreromarco-p%C3%A1nico.wav","examples":[{"text":"Tom entró en pánico.","en":"Tom panicked.","audio":"https://tatoeba.org/en/audio/download/799754"},{"text":"¿Quién entró en pánico?","en":"Who panicked?","audio":"https://tatoeba.org/en/audio/download/437997"},{"text":"Todos entraron en pánico.","en":"Everybody panicked.","audio":"https://tatoeba.org/en/audio/download/448497"},{"text":"Tom ha entrado en pánico.","en":"Tom is in shock.","audio":"https://tatoeba.org/en/audio/download/800110"},{"text":"Que no cunda el pánico.","en":"Try not to panic.","audio":"https://tatoeba.org/en/audio/download/850237"}]}