{"id":"pintura","lemma":"pintura","pos":"noun","rank":1374,"glosses":["painting","paint (colorant substance)","paintwork"],"ipa":"/pinˈtuɾa/","gender":"f","forms":{"plural":"pinturas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q1321_%28spa%29-AdrianAbdulBaha-pintura.wav","examples":[{"text":"Necesito pintura.","en":"I need paint.","audio":"https://tatoeba.org/en/audio/download/438157","words":[{"g":"to need","l":"necesitar"},null]},{"text":"Hay muchas pinturas en la pared.","en":"There are many paintings on the wall.","audio":"https://tatoeba.org/en/audio/download/599052","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"in / on"},{"g":"the / her"},{"g":"wall"}]},{"text":"También me gusta la pintura.","en":"I also like painting.","audio":"https://tatoeba.org/en/audio/download/455394","words":[{"g":"also, too, as well"},null,null,{"g":"the / her"},null],"phrases":[[1,3,"like, thumbs up"]]},{"text":"Ninguna de esas pinturas me gusta.","en":"I like neither of the pictures.","audio":"https://tatoeba.org/en/audio/download/527012","words":[{"g":"nobody","l":"ninguno"},{"g":"of / from"},{"g":"that","l":"ese"},null,null,null],"phrases":[[4,6,"like, thumbs up"]]},{"text":"Esta es mi pintura.","en":"This is my painting.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"my"},null]}]}