{"id":"imagen","lemma":"imagen","pos":"noun","rank":1003,"glosses":["image"],"ipa":"/iˈmaxen/","gender":"f","forms":{"plural":"imágenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-AdrianAbdulBaha-imagen.wav","examples":[{"text":"¿Puedes ver la imagen?","en":"Can you see the picture?","audio":"https://tatoeba.org/en/audio/download/104535"},{"text":"Por favor, muéstranos tus imágenes.","en":"Please show us your pictures.","audio":"https://tatoeba.org/en/audio/download/456817"},{"text":"¿Podemos aumentar la imagen?","en":"Can we enhance the image?","audio":"https://tatoeba.org/en/audio/download/639688"},{"text":"Este libro tiene muchas imágenes bellas.","en":"This book has many beautiful pictures.","audio":"https://tatoeba.org/en/audio/download/586500"},{"text":"¿Qué ves en la imagen?","en":"What do you see in the picture?","audio":"https://tatoeba.org/en/audio/download/551648"}]}