{"id":"idiota","lemma":"idiota","pos":"noun","rank":385,"glosses":["idiot, moron, fool, dork, eejit","dick, jerk, schmuck, douchebag, asshole, ass, jackass, prick (i.e., a cocky or self-important individual without any foundation for it)"],"ipa":"/iˈdjota/","gender":"mf","forms":{"plural":"idiotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Marreromarco-idiota.wav","examples":[{"text":"Mi hermano es idiota.","en":"My brother is an idiot.","audio":"https://tatoeba.org/en/audio/download/460421","words":[{"g":"my"},{"g":"brother"},{"g":"to be","l":"ser"},null]},{"text":"El mundo está lleno de idiotas.","en":"The world is full of fools.","audio":"https://tatoeba.org/en/audio/download/38255","words":[{"g":"the"},{"g":"world, earth"},{"g":"to be","l":"estar"},{"g":"full"},{"g":"of / from"},null]},{"text":"Nuestro profesor es un verdadero idiota.","en":"Our teacher is a real idiot.","audio":"https://tatoeba.org/en/audio/download/522452","words":[{"g":"our, ours, to us"},{"g":"professor"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"true, real"},null]},{"text":"¿Eres idiota o qué?","en":"Are you an idiot or what?","words":[{"g":"to be","l":"ser"},null,{"g":"or"},{"g":"what"}]},{"text":"Ustedes son idiotas.","en":"You're idiots.","audio":"https://tatoeba.org/en/audio/download/455188","words":[{"g":"you all"},{"g":"to be","l":"ser"},null]}]}