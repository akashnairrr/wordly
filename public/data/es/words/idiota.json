{"id":"idiota","lemma":"idiota","pos":"noun","rank":385,"glosses":["idiot, moron, fool, dork, eejit","dick, jerk, schmuck, douchebag, asshole, ass, jackass, prick (i.e., a cocky or self-important individual without any foundation for it)"],"ipa":"/iˈdjota/","gender":"mf","forms":{"plural":"idiotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Marreromarco-idiota.wav","examples":[{"text":"¡Eres un idiota!","en":"You're an idiot.","audio":"https://tatoeba.org/en/audio/download/68269","words":[{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Ustedes son idiotas.","en":"You're idiots.","audio":"https://tatoeba.org/en/audio/download/455188","words":[{"g":"you all"},{"g":"to be","l":"ser"},null]},{"text":"¡Qué idiota que soy!","en":"What an idiot I am!","audio":"https://tatoeba.org/en/audio/download/734264","words":[{"g":"what"},null,{"g":"that"},{"g":"to be","l":"ser"}]},{"text":"Somos dos idiotas.","en":"We're both idiots.","audio":"https://tatoeba.org/en/audio/download/449451","words":[{"g":"to be","l":"ser"},{"g":"dung, excrement"},null]},{"text":"Me sentí como un idiota.","en":"I felt like an idiot.","audio":"https://tatoeba.org/en/audio/download/103671","words":[{"g":"me"},{"g":"to feel","l":"sentir"},{"g":"as"},{"g":"a"},null]}]}