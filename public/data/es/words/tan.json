{"id":"tan","lemma":"tan","pos":"adv","rank":72,"glosses":["so, as","very"],"ipa":"/tan/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q1321_%28spa%29-Marreromarco-tan.wav","examples":[{"text":"¿Qué tan malo es?","en":"How bad is it?","audio":"https://tatoeba.org/en/audio/download/440095"},{"text":"¿Qué tan retrasado estoy?","en":"How late am I?","audio":"https://tatoeba.org/en/audio/download/440145"},{"text":"¡Eso es tan cierto!","en":"It's all true.","audio":"https://tatoeba.org/en/audio/download/549970"},{"text":"¡Qué tipo tan extraño!","en":"What a weirdo!","audio":"https://tatoeba.org/en/audio/download/845493"},{"text":"No soy tan mayor.","en":"I'm not so old.","audio":"https://tatoeba.org/en/audio/download/441059"}]}