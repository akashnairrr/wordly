{"id":"piel","lemma":"piel","pos":"noun","rank":887,"glosses":["skin","pelt"],"ipa":"/ˈpjel/","gender":"f","forms":{"plural":"pieles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Rodelar-piel.wav","examples":[{"text":"Tengo la piel seca.","en":"I have dry skin.","audio":"https://tatoeba.org/en/audio/download/821264"},{"text":"Su piel es lisa.","en":"Her skin is smooth.","audio":"https://tatoeba.org/en/audio/download/735644"},{"text":"Tengo piel de gallina.","en":"I've got goose bumps.","audio":"https://tatoeba.org/en/audio/download/455374"},{"text":"Un bebé tiene la piel sensible.","en":"A baby has delicate skin.","audio":"https://tatoeba.org/en/audio/download/705325"},{"text":"Se me ha puesto piel de gallina.","en":"I've got goose bumps.","audio":"https://tatoeba.org/en/audio/download/455376"}]}