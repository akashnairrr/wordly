{"id":"verdadero","lemma":"verdadero","pos":"adj","rank":652,"glosses":["true, real","honest"],"ipa":"/beɾdaˈdeɾo/","forms":{"feminine":"verdadera","masculinePlural":"verdaderos","femininePlural":"verdaderas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-AdrianAbdulBaha-verdadero.wav","examples":[{"text":"No era amor verdadero.","en":"It wasn't real love.","audio":"https://tatoeba.org/en/audio/download/34931"},{"text":"Eres una verdadera amiga.","en":"You're a real friend.","audio":"https://tatoeba.org/en/audio/download/454346"},{"text":"No usemos nuestros verdaderos nombres.","en":"Let's not use our real names.","audio":"https://tatoeba.org/en/audio/download/594450"},{"text":"No tengo joyas verdaderas.","en":"I don't own any real jewels."},{"text":"Eres un verdadero amigo.","en":"You're a real friend.","audio":"https://tatoeba.org/en/audio/download/454345"}]}