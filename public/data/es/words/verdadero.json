{"id":"verdadero","lemma":"verdadero","pos":"adj","rank":649,"glosses":["true, real","honest"],"ipa":"/beɾdaˈdeɾo/","forms":{"feminine":"verdadera","masculinePlural":"verdaderos","femininePlural":"verdaderas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-AdrianAbdulBaha-verdadero.wav","examples":[{"text":"Ese es mi verdadero nombre.","en":"That's my real name.","audio":"https://tatoeba.org/en/audio/download/262487","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"name"}]},{"text":"Ella es su verdadera madre.","en":"She is his real mother.","audio":"https://tatoeba.org/en/audio/download/461497","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"his / her / your"},null,{"g":"mother"}]},{"text":"Ellos no son mis verdaderos padres.","en":"They aren't my real parents.","audio":"https://tatoeba.org/en/audio/download/610734","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"father, parent","l":"padre"}]},{"text":"Eres un verdadero amigo.","en":"You're a real friend.","audio":"https://tatoeba.org/en/audio/download/454345","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"friend"}]},{"text":"¿Es ésa la verdadera razón?","en":"Is that the real reason?","audio":"https://tatoeba.org/en/audio/download/451087","words":[{"g":"to be","l":"ser"},{"g":"that one","l":"ése"},{"g":"the / her"},null,{"g":"reason"}]}]}