{"id":"verdadero","lemma":"verdadero","pos":"adj","rank":649,"glosses":["true, real","honest"],"ipa":"/beɾdaˈdeɾo/","forms":{"feminine":"verdadera","masculinePlural":"verdaderos","femininePlural":"verdaderas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-AdrianAbdulBaha-verdadero.wav","examples":[{"text":"¿Cuál es tu verdadera intención?","en":"What's your real purpose?","audio":"https://tatoeba.org/en/audio/download/64722","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"intention"}]},{"text":"Ese es mi verdadero nombre.","en":"That's my real name.","audio":"https://tatoeba.org/en/audio/download/262487","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"name"}]},{"text":"Yo no sé su verdadero nombre.","en":"I don't know her real name.","audio":"https://tatoeba.org/en/audio/download/590004","words":[{"g":"I"},null,null,{"g":"his / her / your"},null,{"g":"name"}],"phrases":[[1,3,"I don't know"]]},{"text":"Ellos no son mis verdaderos padres.","en":"They aren't my real parents.","audio":"https://tatoeba.org/en/audio/download/610734","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"father, parent","l":"padre"}]},{"text":"¿Es ésa la verdadera razón?","en":"Is that the real reason?","audio":"https://tatoeba.org/en/audio/download/451087","words":[{"g":"to be","l":"ser"},{"g":"that one","l":"ése"},{"g":"the / her"},null,{"g":"reason"}]}]}