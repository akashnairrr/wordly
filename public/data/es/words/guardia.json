{"id":"guardia","lemma":"guardia","pos":"noun","rank":852,"glosses":["watch, guard, guarding, guard duty, sentry duty","guard (unit or squad)","custody"],"ipa":"/ˈɡwaɾdja/","gender":"f","forms":{"plural":"guardias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Marreromarco-guardia.wav","examples":[{"text":"¿Quién está de guardia?","en":"Who is on duty?","audio":"https://tatoeba.org/en/audio/download/441331"},{"text":"¿Dónde están los guardias?","en":"Where are the guards?","audio":"https://tatoeba.org/en/audio/download/454474"},{"text":"Estoy de guardia ahora.","en":"I am on duty now.","audio":"https://tatoeba.org/en/audio/download/442446"},{"text":"¿Cómo mataste a los guardias?","en":"How did you kill the guards?"},{"text":"Hay un guardia afuera.","en":"A guard is outside.","audio":"https://tatoeba.org/en/audio/download/449372"}]}