{"id":"medianoche","lemma":"medianoche","pos":"noun","rank":1693,"glosses":["midnight","a small meat pie","a type of sandwich with spherical shaped roles and meats ranging from Sobrasada sausage, York ham or chorizo, containing cheese and even sometimes pieces of a Spanish omelette"],"ipa":"/medjaˈnot͡ʃe/","gender":"f","forms":{"plural":"medianoches"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-Millars-medianoche.wav","examples":[{"text":"Él me llamó a medianoche.","en":"He rang me up at midnight.","audio":"https://tatoeba.org/en/audio/download/639294","words":[{"g":"he"},{"g":"me"},{"g":"to summon, to call","l":"llamar"},{"g":"to"},null]},{"text":"Es pasada medianoche.","en":"It's past midnight.","audio":"https://tatoeba.org/en/audio/download/501401","words":[{"g":"to be","l":"ser"},{"g":"transit, crossing"},null]},{"text":"Aún no es medianoche.","en":"It's not midnight yet.","audio":"https://tatoeba.org/en/audio/download/788596","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Tienes hasta medianoche.","en":"You have until midnight.","audio":"https://tatoeba.org/en/audio/download/513291","words":[{"g":"to have","l":"tener"},{"g":"until"},null]},{"text":"Tiene hasta la medianoche.","en":"You have until midnight.","audio":"https://tatoeba.org/en/audio/download/523294","words":[{"g":"to have","l":"tener"},{"g":"until"},{"g":"the / her"},null]}]}