{"id":"ochenta","lemma":"ochenta","pos":"num","rank":4459,"glosses":["eighty"],"ipa":"/oˈt͡ʃenta/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-AdrianAbdulBaha-ochenta.wav","examples":[{"text":"Ahora tiene ochenta y un años.","en":"She is now eighty-one years old.","audio":"https://tatoeba.org/en/audio/download/353985","words":[{"g":"now"},{"g":"to have","l":"tener"},null,{"g":"and"},{"g":"a"},{"g":"year","l":"año"}]},{"text":"Él vivió hasta los ochenta.","en":"He lived to be eighty years old.","audio":"https://tatoeba.org/en/audio/download/354740","words":[{"g":"he"},{"g":"to live","l":"vivir"},{"g":"until"},{"g":"the / them"},null]},{"text":"Cumplió ochenta y uno.","en":"She turned eighty-one.","audio":"https://tatoeba.org/en/audio/download/821280","words":[{"g":"to fulfil","l":"cumplir"},null,{"g":"and"},{"g":"one"}]},{"text":"La mujer tiene más de ochenta años.","en":"The lady is over eighty.","words":[{"g":"the / her"},{"g":"woman"},{"g":"to have","l":"tener"},{"g":"more"},{"g":"of / from"},null,{"g":"year","l":"año"}]},{"text":"Ayer leí el libro hasta la página ochenta.","en":"I read the book up to page 80 yesterday.","words":[{"g":"yesterday"},{"g":"to read","l":"leer"},{"g":"the"},{"g":"book"},{"g":"until"},{"g":"the / her"},{"g":"page"},null]}]}