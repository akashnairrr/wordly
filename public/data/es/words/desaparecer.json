{"id":"desaparecer","lemma":"desaparecer","pos":"verb","rank":1233,"glosses":["to disappear, to go missing, to vanish, to be gone","to drop off (e.g. the map, the face of the earth)","to go away, to fade, to wear off, to subside"],"ipa":"/desapaɾeˈθeɾ/","conjugation":{"indicative":{"present":{"1s":"desaparezco","2s":"desapareces","3s":"desaparece","1p":"desaparecemos","2p":"desaparecéis","3p":"desaparecen"},"imperfect":{"1s":"desaparecía","2s":"desaparecías","3s":"desaparecía","1p":"desaparecíamos","2p":"desaparecíais","3p":"desaparecían"},"preterite":{"1s":"desaparecí","2s":"desapareciste","3s":"desapareció","1p":"desaparecimos","2p":"desaparecisteis","3p":"desaparecieron"},"future":{"1s":"desapareceré","2s":"desaparecerás","3s":"desaparecerá","1p":"desapareceremos","2p":"desapareceréis","3p":"desaparecerán"},"conditional":{"1s":"desaparecería","2s":"desaparecerías","3s":"desaparecería","1p":"desapareceríamos","2p":"desapareceríais","3p":"desaparecerían"}},"subjunctive":{"present":{"1s":"desaparezca","2s":"desaparezcas","3s":"desaparezca","1p":"desaparezcamos","2p":"desaparezcáis","3p":"desaparezcan"},"imperfect":{"1s":"desapareciera","2s":"desaparecieras","3s":"desapareciera","1p":"desapareciéramos","2p":"desaparecierais","3p":"desaparecieran"}},"imperative":{"affirmative":{"2s":"desaparece","3s":"desaparezca","1p":"desaparezcamos","2p":"desapareced","3p":"desaparezcan"},"negative":{"2s":"desaparezcas","3s":"desaparezca","1p":"desaparezcamos","2p":"desaparezcáis","3p":"desaparezcan"}}},"nonFinite":{"gerund":"desapareciendo","participle":"desaparecido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-AdrianAbdulBaha-desaparecer.wav","examples":[{"text":"El dinero desapareció.","en":"The money disappeared.","audio":"https://tatoeba.org/en/audio/download/78350","words":[{"g":"the"},{"g":"money"},null]},{"text":"Su hijo desapareció hace siete años.","en":"His son disappeared seven years ago.","audio":"https://tatoeba.org/en/audio/download/687622","words":[{"g":"his / her / your"},{"g":"son"},null,{"g":"to do","l":"hacer"},{"g":"seven"},{"g":"year","l":"año"}]},{"text":"Eso nunca desaparecerá.","en":"That will never disappear.","audio":"https://tatoeba.org/en/audio/download/78232","words":[{"g":"that","l":"ése"},{"g":"never"},null]},{"text":"¡Desaparece de mi vida!","en":"Get out of my life!","audio":"https://tatoeba.org/en/audio/download/519201","words":[null,null,null,null],"phrases":[[1,4,"my dear"]]},{"text":"Desaparecieron.","en":"They disappeared.","audio":"https://tatoeba.org/en/audio/download/443824","words":[null]}]}