{"id":"experiencia","lemma":"experiencia","pos":"noun","rank":803,"glosses":["experience","expertise"],"ipa":"/eɡspeˈɾjenθja/","gender":"f","forms":{"plural":"experiencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q1321_%28spa%29-AdrianAbdulBaha-experiencia.wav","examples":[{"text":"Él tiene mucha experiencia.","en":"He's very experienced.","audio":"https://tatoeba.org/en/audio/download/735874"},{"text":"Tom tuvo algunas experiencias muy inusuales.","en":"Tom had some very unusual experiences.","audio":"https://tatoeba.org/en/audio/download/805916"},{"text":"No tengo ninguna experiencia.","en":"I don't have any experience.","audio":"https://tatoeba.org/en/audio/download/532197"},{"text":"Fue una de las experiencias más increíbles de mi vida.","en":"It was one of the most incredible experiences of my life.","audio":"https://tatoeba.org/en/audio/download/609822"},{"text":"Tuve una experiencia terrible.","en":"I had a terrible experience.","audio":"https://tatoeba.org/en/audio/download/704373"}]}