{"id":"pelo","lemma":"pelo","pos":"noun","rank":538,"glosses":["hair (a single hair)","hair (all hair on the head)","fur"],"ipa":"/ˈpelo/","gender":"m","forms":{"plural":"pelos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q1321_%28spa%29-Millars-pelo.wav","examples":[{"text":"Me tiño el pelo.","en":"I dye my hair.","audio":"https://tatoeba.org/en/audio/download/1152136"},{"text":"Me puso los pelos de punta.","en":"It gave me goosebumps.","audio":"https://tatoeba.org/en/audio/download/302018"},{"text":"Mi pelo es gris.","en":"My hair is gray.","audio":"https://tatoeba.org/en/audio/download/798014"},{"text":"Aprobé el examen por los pelos.","en":"I barely passed the exam.","audio":"https://tatoeba.org/en/audio/download/581610"},{"text":"Mi pelo es largo.","en":"My hair is long.","audio":"https://tatoeba.org/en/audio/download/456404"}]}