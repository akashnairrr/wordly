{"id":"adio_s","lemma":"adiós","pos":"noun","rank":219,"glosses":["farewell; goodbye"],"ipa":"/aˈdjos/","gender":"m","forms":{"plural":"adioses"},"examples":[{"text":"Sonrió y dijo adiós.","en":"He smiled and said goodbye.","audio":"https://tatoeba.org/en/audio/download/735551"},{"text":"He venido a decir adiós.","en":"I've come to say goodbye.","audio":"https://tatoeba.org/en/audio/download/733577"},{"text":"Tom sonrió y dijo adiós.","en":"Tom smiled and said goodbye.","audio":"https://tatoeba.org/en/audio/download/330865"},{"text":"Se fue sin decirme adiós.","en":"He left without saying goodbye.","audio":"https://tatoeba.org/en/audio/download/1152208"},{"text":"Se fue sin decir adiós.","en":"He went off without saying good-bye.","audio":"https://tatoeba.org/en/audio/download/554801"}]}