{"id":"adio_s","lemma":"adiós","pos":"noun","rank":216,"glosses":["farewell; goodbye"],"ipa":"/aˈdjos/","gender":"m","forms":{"plural":"adioses"},"examples":[{"text":"Necesito decir adiós.","en":"I need to say goodbye.","audio":"https://tatoeba.org/en/audio/download/454442","words":[{"g":"to need","l":"necesitar"},{"g":"to say"},null]},{"text":"He venido a decir adiós.","en":"I've come to say goodbye.","audio":"https://tatoeba.org/en/audio/download/733577","words":[{"g":"to have","l":"haber"},{"g":"to come","l":"venir"},{"g":"to"},{"g":"to say"},null]},{"text":"Ella dijo adiós.","en":"She said goodbye.","audio":"https://tatoeba.org/en/audio/download/442966","words":[{"g":"she"},{"g":"to say","l":"decir"},null]},{"text":"Supongo que esto es un adiós.","en":"I guess this is goodbye.","audio":"https://tatoeba.org/en/audio/download/459300","words":[{"g":"to suppose","l":"suponer"},{"g":"that"},{"g":"this"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Le dijo adiós con la mano.","en":"She waved goodbye to him.","audio":"https://tatoeba.org/en/audio/download/639801","words":[{"g":"him / her"},{"g":"to say","l":"decir"},null,{"g":"with"},{"g":"the / her"},{"g":"hand"}]}]}