{"id":"incendio","lemma":"incendio","pos":"noun","rank":1646,"glosses":["fire (especially burning buildings or forests)","blaze","outburst"],"ipa":"/inˈθendjo/","gender":"m","forms":{"plural":"incendios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-AdrianAbdulBaha-incendio.wav","examples":[{"text":"Hay un incendio en mi cocina.","en":"There's a fire in my kitchen.","audio":"https://tatoeba.org/en/audio/download/333629","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"in / on"},{"g":"my"},{"g":"kitchen"}]},{"text":"¿Tiene usted seguro contra incendios?","en":"Do you have fire insurance?","words":[{"g":"to have","l":"tener"},{"g":"you (formal)"},{"g":"secure"},{"g":"antidote"},null]},{"text":"¿Alguien sabe cómo empezó el incendio?","en":"Does anybody know how the fire started?","audio":"https://tatoeba.org/en/audio/download/616158","words":[{"g":"someone, somebody"},{"g":"to know, to understand","l":"saber"},{"g":"how"},{"g":"to start","l":"empezar"},{"g":"the"},null]},{"text":"El edificio no tiene salida de incendios.","en":"The building has no fire exit.","audio":"https://tatoeba.org/en/audio/download/704389","words":[{"g":"the"},{"g":"building"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"exit, way out"},{"g":"of / from"},null]},{"text":"Hubo un incendio cerca.","en":"A fire broke out nearby.","audio":"https://tatoeba.org/en/audio/download/460831","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"close"}]}]}