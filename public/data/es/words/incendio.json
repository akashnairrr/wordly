{"id":"incendio","lemma":"incendio","pos":"noun","rank":1646,"glosses":["fire (especially burning buildings or forests)","blaze","outburst"],"ipa":"/inˈθendjo/","gender":"m","forms":{"plural":"incendios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-AdrianAbdulBaha-incendio.wav","examples":[{"text":"¿Alguien sabe cómo empezó el incendio?","en":"Does anybody know how the fire started?","audio":"https://tatoeba.org/en/audio/download/616158","words":[{"g":"someone, somebody"},{"g":"to know, to understand","l":"saber"},{"g":"how"},{"g":"to start","l":"empezar"},{"g":"the"},null]},{"text":"Hubo cinco incendios anoche.","en":"There were five fires last night.","audio":"https://tatoeba.org/en/audio/download/77822","words":[{"g":"to have","l":"haber"},{"g":"a five"},null,{"g":"last night"}]},{"text":"Hubo un gran incendio anoche.","en":"There was a big fire last night.","audio":"https://tatoeba.org/en/audio/download/514744","words":[{"g":"to have","l":"haber"},{"g":"a"},null,null,{"g":"last night"}]},{"text":"Hay un incendio en mi cocina.","en":"There's a fire in my kitchen.","audio":"https://tatoeba.org/en/audio/download/333629","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"in / on"},{"g":"my"},{"g":"kitchen"}]},{"text":"¿Tienes seguro contra incendios?","en":"Do you have fire insurance?","words":[{"g":"to have","l":"tener"},{"g":"secure"},{"g":"antidote"},null]}]}