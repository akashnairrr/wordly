{"id":"incendio","lemma":"incendio","pos":"noun","rank":1649,"glosses":["fire (especially burning buildings or forests)","blaze","outburst"],"ipa":"/inˈθendjo/","gender":"m","forms":{"plural":"incendios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-AdrianAbdulBaha-incendio.wav","examples":[{"text":"Hubo un incendio cerca.","en":"A fire broke out nearby.","audio":"https://tatoeba.org/en/audio/download/460831"},{"text":"Hubo cinco incendios anoche.","en":"There were five fires last night.","audio":"https://tatoeba.org/en/audio/download/77822"},{"text":"Tomás murió en el incendio.","en":"Tom died in the fire.","audio":"https://tatoeba.org/en/audio/download/455228"},{"text":"El edificio no tiene salida de incendios.","en":"The building has no fire exit.","audio":"https://tatoeba.org/en/audio/download/704389"},{"text":"En caso de incendio, marque 119.","en":"In case of fire, dial 119.","audio":"https://tatoeba.org/en/audio/download/514753"}]}