{"id":"embarazado","lemma":"embarazado","pos":"adj","rank":923,"glosses":["pregnant","uncomfortable"],"ipa":"/embaɾaˈθado/","forms":{"feminine":"embarazada","masculinePlural":"embarazados","femininePlural":"embarazadas"},"formAudio":{"embarazada":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-Marreromarco-embarazada.wav"},"examples":[{"text":"Tom está bastante seguro de no poder quedarse embarazado.","en":"Tom is pretty sure that he can't become pregnant."},{"text":"Mi esposa está embarazada.","en":"My wife's pregnant.","audio":"https://tatoeba.org/en/audio/download/448803"},{"text":"Las mujeres embarazadas a menudo sufren náuseas matutinas.","en":"Pregnant women often experience morning sickness.","audio":"https://tatoeba.org/en/audio/download/693762"},{"text":"Estoy embarazado.","en":"I'm pregnant.","audio":"https://tatoeba.org/en/audio/download/531556"},{"text":"Mi mujer está embarazada.","en":"My wife's pregnant.","audio":"https://tatoeba.org/en/audio/download/448804"}]}