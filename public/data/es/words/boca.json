{"id":"boca","lemma":"boca","pos":"noun","rank":486,"glosses":["mouth, oral cavity","entrance, opening","estuary"],"ipa":"/ˈboka/","gender":"f","forms":{"plural":"bocas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Rodelar-boca.wav","examples":[{"text":"Tengo la boca seca.","en":"My mouth is dry.","audio":"https://tatoeba.org/en/audio/download/524950"},{"text":"Si tuviéramos que hablar más que escuchar tendríamos dos bocas y una oreja.","en":"If we were supposed to talk more than listen, we would have been given two mouths and one ear.","audio":"https://tatoeba.org/en/audio/download/691908"},{"text":"Mi boca estaba seca.","en":"My mouth was dry.","audio":"https://tatoeba.org/en/audio/download/442934"},{"text":"Tenía la boca seca.","en":"My mouth was dry.","audio":"https://tatoeba.org/en/audio/download/443104"},{"text":"Tom cerró la boca.","en":"Tom shut his mouth.","audio":"https://tatoeba.org/en/audio/download/799144"}]}