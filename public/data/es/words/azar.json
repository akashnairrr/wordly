{"id":"azar","lemma":"azar","pos":"noun","rank":2696,"glosses":["luck, chance","misfortune, accident","obstacle, hazard"],"ipa":"/aˈθaɾ/","gender":"m","forms":{"plural":"azares"},"order":2703,"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-AdrianAbdulBaha-azar.wav","examples":[{"text":"No se lo dejes al azar.","en":"Don't leave it up to chance.","audio":"https://tatoeba.org/en/audio/download/587500","words":[{"g":"no / not"},{"g":"oneself"},{"g":"it / him"},{"g":"to leave","l":"dejar"},{"g":"to the"},null]},{"text":"Le gustan los juegos de azar.","en":"He likes games of chance.","words":[{"g":"him / her"},{"g":"to like in a general…","l":"gustar"},{"g":"the / them"},{"g":"play","l":"juego"},{"g":"of / from"},null]},{"text":"Corramos ese azar.","en":"Let's take that chance.","words":[{"g":"to run, to jog","l":"correr"},{"g":"that"},null]}]}