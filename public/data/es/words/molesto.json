{"id":"molesto","lemma":"molesto","pos":"adj","rank":833,"glosses":["annoyed, vexed","annoying, obtrusive","uncomfortable"],"ipa":"/moˈlesto/","forms":{"feminine":"molesta","masculinePlural":"molestos","femininePlural":"molestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Marreromarco-molesto.wav","examples":[{"text":"¿Le molesto a usted?","en":"Am I disturbing you?","audio":"https://tatoeba.org/en/audio/download/449661"},{"text":"Tom molesta a todos.","en":"Tom bugs everyone.","audio":"https://tatoeba.org/en/audio/download/799968"},{"text":"Todos estaban molestos.","en":"Everyone was upset."},{"text":"Todas estaban molestas.","en":"Everyone was upset."},{"text":"¿Acaso no es molesto?","en":"Isn't that annoying?","audio":"https://tatoeba.org/en/audio/download/450272"}]}