{"id":"molesto","lemma":"molesto","pos":"adj","rank":830,"glosses":["annoyed, vexed","annoying, obtrusive","uncomfortable"],"ipa":"/moˈlesto/","forms":{"feminine":"molesta","masculinePlural":"molestos","femininePlural":"molestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Marreromarco-molesto.wav","examples":[{"text":"¿No te molesta?","en":"Doesn't that bother you?","audio":"https://tatoeba.org/en/audio/download/802842","words":[{"g":"no / not"},{"g":"you"},null]},{"text":"¿Está usted molesto?","en":"Are you upset?","audio":"https://tatoeba.org/en/audio/download/437936","words":[{"g":"to be","l":"estar"},{"g":"you (formal)"},null]},{"text":"¿Te molesta si hago esto?","en":"Does it bother you if I do this?","audio":"https://tatoeba.org/en/audio/download/581688","words":[{"g":"you"},null,{"g":"if, whether"},{"g":"to do","l":"hacer"},{"g":"this"}]},{"text":"No sé para qué me molesto.","en":"I don't know why I bother.","audio":"https://tatoeba.org/en/audio/download/630624","words":[null,null,null,null,{"g":"me"},null],"phrases":[[0,2,"I don't know"],[2,4,"what for?"]]},{"text":"Mi esposa está muy molesta.","en":"My wife is very upset.","audio":"https://tatoeba.org/en/audio/download/460507","words":[{"g":"my"},{"g":"wife"},{"g":"to be","l":"estar"},null,null]}]}