{"id":"vario","lemma":"vario","pos":"adj","rank":1214,"glosses":["various","varied"],"ipa":"/ˈbaɾjo/","forms":{"feminine":"varia","masculinePlural":"varios","femininePlural":"varias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Marreromarco-vario.wav","formAudio":{"varios":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Precision27-varios.wav"},"examples":[{"text":"Ella me dio varios libros.","en":"She gave me several books.","audio":"https://tatoeba.org/en/audio/download/639110","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"book","l":"libro"}]},{"text":"Él vino varias veces.","en":"He came several times.","audio":"https://tatoeba.org/en/audio/download/34689","words":[{"g":"he"},{"g":"to come","l":"venir"},null,{"g":"by, times"}]},{"text":"Me quedaré aquí por varios días.","en":"I'm going to stay here for several days.","audio":"https://tatoeba.org/en/audio/download/78338","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"here"},{"g":"for / by"},null,{"g":"day","l":"día"}]},{"text":"Hice varias preguntas.","en":"I made some inquiries.","audio":"https://tatoeba.org/en/audio/download/455360","words":[{"g":"to do","l":"hacer"},null,{"g":"question","l":"pregunta"}]},{"text":"No he comido en varios días.","en":"I haven't eaten for days.","audio":"https://tatoeba.org/en/audio/download/581554","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"having had lunch"},{"g":"in / on"},null,{"g":"day","l":"día"}]}]}