{"id":"diez","lemma":"diez","pos":"noun","rank":406,"glosses":["A (highest grade in testing)"],"ipa":"/ˈdjeθ/","gender":"m","forms":{"plural":"dieces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q1321_%28spa%29-Rodrigo5260-diez.wav","examples":[{"text":"Estaré contigo en diez minutos.","en":"I'll be with you in ten minutes.","audio":"https://tatoeba.org/en/audio/download/645501","words":[{"g":"to be","l":"estar"},{"g":"with you"},{"g":"in / on"},null,{"g":"minute","l":"minuto"}]},{"text":"Él llegó aquí diez minutos antes.","en":"He arrived here ten minutes early.","audio":"https://tatoeba.org/en/audio/download/684525","words":[{"g":"he"},{"g":"to arrive, get","l":"llegar"},{"g":"here"},null,{"g":"minute","l":"minuto"},{"g":"earlier"}]},{"text":"Te debo diez dólares.","en":"I owe you ten dollars.","audio":"https://tatoeba.org/en/audio/download/453445","words":[{"g":"you"},{"g":"to owe","l":"deber"},null,{"g":"dollar","l":"dólar"}]},{"text":"Tengo un hijo de diez años.","en":"I have a ten-year-old boy.","audio":"https://tatoeba.org/en/audio/download/582024","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"son"},{"g":"of / from"},null,{"g":"year","l":"año"}]},{"text":"El tren parte en diez minutos.","en":"The train leaves in ten minutes.","audio":"https://tatoeba.org/en/audio/download/1191508","words":[{"g":"the"},{"g":"train"},{"g":"part"},{"g":"in / on"},null,{"g":"minute","l":"minuto"}]}]}