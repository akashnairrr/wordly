{"id":"rostro","lemma":"rostro","pos":"noun","rank":1329,"glosses":["face (the front part of the head)"],"ipa":"/ˈrostɾo/","gender":"m","forms":{"plural":"rostros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6a/LL-Q1321_%28spa%29-Millars-rostro.wav","examples":[{"text":"Su rostro se iluminó.","en":"Her face lit up.","audio":"https://tatoeba.org/en/audio/download/734374"},{"text":"Tu rostro me resulta familiar.","en":"Your face is familiar to me.","audio":"https://tatoeba.org/en/audio/download/519002"},{"text":"Tu rostro me parece familiar.","en":"Your face is familiar to me.","audio":"https://tatoeba.org/en/audio/download/519003"},{"text":"El rostro de Tom se siente áspero porque debe afeitarse.","en":"Tom's face feels rough because he needs to shave.","audio":"https://tatoeba.org/en/audio/download/65036"},{"text":"Su rostro se puso rojo.","en":"Her face turned red."}]}