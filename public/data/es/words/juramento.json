{"id":"juramento","lemma":"juramento","pos":"noun","rank":2735,"glosses":["an oath","a sworn statement"],"ipa":"/xuɾaˈmento/","gender":"m","forms":{"plural":"juramentos"},"order":2741,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a6/LL-Q1321_%28spa%29-Marreromarco-juramento.wav","examples":[{"text":"Recuerda que estás bajo juramento.","en":"Remember you are under oath.","audio":"https://tatoeba.org/en/audio/download/803737","words":[{"g":"to remember","l":"recordar"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"short"},null]},{"text":"Te recuerdo que todavía estás bajo juramento.","en":"I remind you that you are still under oath.","words":[{"g":"you"},{"g":"memory"},{"g":"that"},{"g":"still, yet"},{"g":"to be","l":"estar"},{"g":"short"},null]},{"text":"Quisiera recordarle que está bajo juramento.","en":"I'd like to remind you that you're under oath.","audio":"https://tatoeba.org/en/audio/download/693860","words":[{"g":"to desire","l":"querer"},{"g":"to remember","l":"recordar"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"short"},null]}]}