{"id":"durante","lemma":"durante","pos":"prep","rank":226,"glosses":["during, in, over","for (as a duration)"],"ipa":"/duˈɾante/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Marreromarco-durante.wav","examples":[{"text":"Llovió durante una semana.","en":"It rained for a week.","audio":"https://tatoeba.org/en/audio/download/453903"},{"text":"Estudié durante una hora.","en":"I studied for one hour.","audio":"https://tatoeba.org/en/audio/download/45804"},{"text":"Andamos durante dos horas.","en":"We walked for two hours.","audio":"https://tatoeba.org/en/audio/download/65242"},{"text":"Llovió durante tres días.","en":"It rained for three days.","audio":"https://tatoeba.org/en/audio/download/552147"},{"text":"Ayunamos durante tres días.","en":"We fasted for three days.","audio":"https://tatoeba.org/en/audio/download/798013"}]}