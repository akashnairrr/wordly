{"id":"durante","lemma":"durante","pos":"prep","rank":223,"glosses":["during, in, over","for (as a duration)"],"ipa":"/duˈɾante/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Marreromarco-durante.wav","examples":[{"text":"Mi padre estuvo durmiendo durante la película.","en":"My father slept through the movie.","audio":"https://tatoeba.org/en/audio/download/926244","words":[{"g":"my"},{"g":"father, parent"},{"g":"to be","l":"estar"},{"g":"to sleep","l":"dormir"},null,{"g":"the / her"},{"g":"film"}]},{"text":"¿Durante cuánto tiempo lo habéis estado buscando?","en":"How long have you been looking for it?","audio":"https://tatoeba.org/en/audio/download/611138","words":[null,null,null,{"g":"it / him"},{"g":"to have","l":"haber"},{"g":"country, land"},{"g":"to seek","l":"buscar"}],"phrases":[[1,3,"how long"]]},{"text":"Puedo hacer esto durante todo el día.","en":"I can do this all day.","audio":"https://tatoeba.org/en/audio/download/454265","words":[{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"this"},null,null,null,null],"phrases":[[4,7,"all the time"]]},{"text":"Lo hice durante toda la mañana.","en":"I did that all morning.","audio":"https://tatoeba.org/en/audio/download/430420","words":[{"g":"it / him"},{"g":"to do","l":"hacer"},null,{"g":"all","l":"todo"},{"g":"the / her"},{"g":"tomorrow"}]},{"text":"Puedo hacer esto durante toda la noche.","en":"I can do this all night.","audio":"https://tatoeba.org/en/audio/download/459851","words":[{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"this"},null,{"g":"all","l":"todo"},{"g":"the / her"},{"g":"night"}]}]}