{"id":"sufrir","lemma":"sufrir","pos":"verb","rank":1865,"glosses":["to suffer (be confronted with something undesired)","to withstand, endure, resist or undergo a physical or moral damage"],"ipa":"/suˈfɾiɾ/","conjugation":{"indicative":{"present":{"1s":"sufro","2s":"sufres","3s":"sufre","1p":"sufrimos","2p":"sufrís","3p":"sufren"},"imperfect":{"1s":"sufría","2s":"sufrías","3s":"sufría","1p":"sufríamos","2p":"sufríais","3p":"sufrían"},"preterite":{"1s":"sufrí","2s":"sufriste","3s":"sufrió","1p":"sufrimos","2p":"sufristeis","3p":"sufrieron"},"future":{"1s":"sufriré","2s":"sufrirás","3s":"sufrirá","1p":"sufriremos","2p":"sufriréis","3p":"sufrirán"},"conditional":{"1s":"sufriría","2s":"sufrirías","3s":"sufriría","1p":"sufriríamos","2p":"sufriríais","3p":"sufrirían"}},"subjunctive":{"present":{"1s":"sufra","2s":"sufras","3s":"sufra","1p":"suframos","2p":"sufráis","3p":"sufran"},"imperfect":{"1s":"sufriera","2s":"sufrieras","3s":"sufriera","1p":"sufriéramos","2p":"sufrierais","3p":"sufrieran"}},"imperative":{"affirmative":{"2s":"sufre","3s":"sufra","1p":"suframos","2p":"sufrid","3p":"sufran"},"negative":{"2s":"sufras","3s":"sufra","1p":"suframos","2p":"sufráis","3p":"sufran"}}},"nonFinite":{"gerund":"sufriendo","participle":"sufrido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-AdrianAbdulBaha-sufrir.wav","examples":[{"text":"¿Por qué debo sufrir?","en":"Why must I suffer?","audio":"https://tatoeba.org/en/audio/download/448321"},{"text":"Ella parecía estar sufriendo un infarto.","en":"She seemed to be suffering a heart attack.","audio":"https://tatoeba.org/en/audio/download/692638"},{"text":"He sufrido un accidente.","en":"I've had an accident.","audio":"https://tatoeba.org/en/audio/download/417879"},{"text":"Sufro depresión durante el invierno.","en":"I suffer from depression during the wintertime.","audio":"https://tatoeba.org/en/audio/download/705912"},{"text":"Sufres, ¿no?","en":"You're in pain, aren't you?"}]}