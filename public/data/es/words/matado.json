{"id":"matado","lemma":"matado","pos":"adj","rank":822,"glosses":["loser, idler, poor thing","fugly, hideous (person)","bookish (lover of reading and or study)"],"ipa":"/maˈtado/","forms":{"feminine":"matada","masculinePlural":"matados","femininePlural":"matadas"},"formAudio":{"matada":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q1321_%28spa%29-Rub%C3%BD%C3%B1-matada.wav"},"examples":[{"text":"Nadie me ha matado aún.","en":"Nobody's killed me yet.","audio":"https://tatoeba.org/en/audio/download/460541","words":[{"g":"no one"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"still, yet"}]},{"text":"¿Alguna vez has matado a alguien?","en":"Have you ever killed a man?","audio":"https://tatoeba.org/en/audio/download/333242","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"someone, somebody"}],"phrases":[[0,2,"ever"]]},{"text":"Tienes suerte de que no te hayan matado.","en":"You're lucky you weren't killed.","audio":"https://tatoeba.org/en/audio/download/915853","words":[{"g":"to have","l":"tener"},{"g":"luck, fortune"},null,null,{"g":"no / not"},{"g":"you"},{"g":"to have","l":"haber"},null],"phrases":[[2,4,"that"]]},{"text":"Tom no ha matado nunca a nadie.","en":"Tom has never killed anybody.","audio":"https://tatoeba.org/en/audio/download/333635","words":[null,{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"never"},{"g":"to"},{"g":"no one"}]},{"text":"Los animales debían ser matados.","en":"The animals had to be killed.","words":[{"g":"the / them"},{"g":"animal","l":"animal"},{"g":"to owe","l":"deber"},{"g":"to be"},null]}]}