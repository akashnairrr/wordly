{"id":"siete","lemma":"siete","pos":"noun","rank":579,"glosses":["seven","butthole","tear, snag"],"ipa":"/ˈsjete/","gender":"m","forms":{"plural":"sietes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q1321_%28spa%29-AdrianAbdulBaha-siete.wav","examples":[{"text":"Ella tiene siete hijos.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/449805"},{"text":"Tiene siete hijos varones.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/448771"},{"text":"Desayunamos a las siete.","en":"We have breakfast at seven.","audio":"https://tatoeba.org/en/audio/download/553947"},{"text":"Volveré a las siete.","en":"I'll be back at seven o'clock.","audio":"https://tatoeba.org/en/audio/download/355347"},{"text":"Siete dólares, por favor.","en":"That'll be seven dollars, please.","audio":"https://tatoeba.org/en/audio/download/37721"}]}