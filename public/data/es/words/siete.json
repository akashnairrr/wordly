{"id":"siete","lemma":"siete","pos":"noun","rank":577,"glosses":["seven","butthole","tear, snag"],"ipa":"/ˈsjete/","gender":"m","forms":{"plural":"sietes"},"order":77,"unit":5,"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q1321_%28spa%29-AdrianAbdulBaha-siete.wav","examples":[{"text":"Ella tiene siete hijos.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/449805","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"son","l":"hijo"}]},{"text":"Cinco y dos son siete.","en":"Five plus two equals seven.","audio":"https://tatoeba.org/en/audio/download/933863","words":[{"g":"a five"},{"g":"and"},{"g":"dung, excrement"},{"g":"to be","l":"ser"},null]},{"text":"Una semana tiene siete días.","en":"A week has seven days.","audio":"https://tatoeba.org/en/audio/download/42175","words":[{"g":"a"},{"g":"week"},{"g":"to have","l":"tener"},null,{"g":"day","l":"día"}]}]}