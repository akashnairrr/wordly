{"id":"siete","lemma":"siete","pos":"noun","rank":576,"glosses":["seven","butthole","tear, snag"],"ipa":"/ˈsjete/","gender":"m","forms":{"plural":"sietes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q1321_%28spa%29-AdrianAbdulBaha-siete.wav","examples":[{"text":"Su hijo desapareció hace siete años.","en":"His son disappeared seven years ago.","audio":"https://tatoeba.org/en/audio/download/687622","words":[{"g":"his / her / your"},{"g":"son"},{"g":"to disappear","l":"desaparecer"},{"g":"to do","l":"hacer"},null,{"g":"year","l":"año"}]},{"text":"Una semana tiene siete días.","en":"A week has seven days.","audio":"https://tatoeba.org/en/audio/download/42175","words":[{"g":"a"},{"g":"week"},{"g":"to have","l":"tener"},null,{"g":"day","l":"día"}]},{"text":"Ella tiene siete hijos.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/449805","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"son","l":"hijo"}]},{"text":"La tienda cierra a las siete.","en":"The shop closes at seven.","audio":"https://tatoeba.org/en/audio/download/764991","words":[{"g":"the / her"},{"g":"tent"},{"g":"to close, to shut","l":"cerrar"},{"g":"to"},{"g":"the / them"},null]},{"text":"Siete dólares, por favor.","en":"That'll be seven dollars, please.","audio":"https://tatoeba.org/en/audio/download/37721","words":[null,{"g":"dollar","l":"dólar"},null,null],"phrases":[[2,4,"please"]]}]}