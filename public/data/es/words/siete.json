{"id":"siete","lemma":"siete","pos":"noun","rank":576,"glosses":["seven","butthole","tear, snag"],"ipa":"/ˈsjete/","gender":"m","forms":{"plural":"sietes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q1321_%28spa%29-AdrianAbdulBaha-siete.wav","examples":[{"text":"Te llamaré a las siete.","en":"I'll call you at seven.","audio":"https://tatoeba.org/en/audio/download/39787","words":[{"g":"you"},{"g":"to summon, to call","l":"llamar"},{"g":"to"},{"g":"the / them"},null]},{"text":"Me dijo que estaría aquí sobre las siete.","en":"He told me he would be here about seven.","audio":"https://tatoeba.org/en/audio/download/635509","words":[{"g":"me"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"here"},{"g":"envelope"},{"g":"the / them"},null]},{"text":"Ella tiene siete hijos.","en":"She has seven sons.","audio":"https://tatoeba.org/en/audio/download/449805","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"son","l":"hijo"}]},{"text":"Eran las siete y media.","en":"It was seven thirty.","audio":"https://tatoeba.org/en/audio/download/449299","words":[{"g":"to be","l":"ser"},{"g":"the / them"},null,{"g":"and"},{"g":"half"}]},{"text":"Salí de casa a las siete.","en":"I left home at seven.","audio":"https://tatoeba.org/en/audio/download/453189","words":[{"g":"to go out","l":"salir"},{"g":"of / from"},{"g":"house"},{"g":"to"},{"g":"the / them"},null]}]}