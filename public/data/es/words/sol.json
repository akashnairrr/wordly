{"id":"sol","lemma":"sol","pos":"noun","rank":566,"glosses":["sun","sunlight","sunny side (of a place)"],"ipa":"/ˈsol/","gender":"m","forms":{"plural":"soles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dd/LL-Q1321_%28spa%29-Rodelar-sol.wav","examples":[{"text":"Me gusta el sol.","en":"I love the sun.","audio":"https://tatoeba.org/en/audio/download/519186"},{"text":"El sol está saliendo.","en":"The sun is rising.","audio":"https://tatoeba.org/en/audio/download/449012"},{"text":"El sol está brillando.","en":"The sun is shining.","audio":"https://tatoeba.org/en/audio/download/501182"},{"text":"Me gusta mucho el sol.","en":"I love the sun.","audio":"https://tatoeba.org/en/audio/download/636630"},{"text":"Me quemé con el sol.","en":"I got sunburned.","audio":"https://tatoeba.org/en/audio/download/415804"}]}