{"id":"tienda","lemma":"tienda","pos":"noun","rank":558,"glosses":["tent","shop, store"],"ipa":"/ˈtjenda/","gender":"f","forms":{"plural":"tiendas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-AdrianAbdulBaha-tienda.wav","examples":[{"text":"¿Hay una tienda ahí?","en":"Is there a shop there?","audio":"https://tatoeba.org/en/audio/download/454394","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"there"}]},{"text":"¿Tienes sitio para una tienda?","en":"Do you have room for a tent?","words":[{"g":"to have","l":"tener"},{"g":"site, place"},{"g":"for"},{"g":"a"},null]},{"text":"¿Qué compró ella en la tienda?","en":"What did she buy at the shop?","audio":"https://tatoeba.org/en/audio/download/37301","words":[{"g":"what"},{"g":"to buy","l":"comprar"},{"g":"she"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Fui a muchas tiendas buscando el libro.","en":"I went to many shops to look for the book.","audio":"https://tatoeba.org/en/audio/download/693426","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"much","l":"mucho"},null,{"g":"to seek","l":"buscar"},{"g":"the"},{"g":"book"}]},{"text":"Esta tienda me pertenece.","en":"This shop belongs to me.","audio":"https://tatoeba.org/en/audio/download/519676","words":[{"g":"this","l":"este"},null,{"g":"me"},{"g":"to belong","l":"pertenecer"}]}]}