{"id":"impresionante","lemma":"impresionante","pos":"adj","rank":1229,"glosses":["impressive","awesome, amazing","stunning, breathtaking, striking (physical appearance, scenery)"],"ipa":"/impɾesjoˈnante/","forms":{"femininePlural":"impresionantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q1321_%28spa%29-Marreromarco-impresionante.wav","examples":[{"text":"Eso es bastante impresionante.","en":"That's pretty impressive.","audio":"https://tatoeba.org/en/audio/download/519524"},{"text":"Es impresionante cómo funciona.","en":"It's amazing how it works.","audio":"https://tatoeba.org/en/audio/download/611335"},{"text":"Realmente te ves impresionante.","en":"You really do look stunning.","audio":"https://tatoeba.org/en/audio/download/803921"},{"text":"Tu técnica es impresionante.","en":"Your technique is impressive.","audio":"https://tatoeba.org/en/audio/download/722099"},{"text":"Tom hizo una captura impresionante.","en":"Tom made a great catch.","audio":"https://tatoeba.org/en/audio/download/302023"}]}