{"id":"impresionante","lemma":"impresionante","pos":"adj","rank":1226,"glosses":["impressive","awesome, amazing","stunning, breathtaking, striking (physical appearance, scenery)"],"ipa":"/impɾesjoˈnante/","forms":{"femininePlural":"impresionantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q1321_%28spa%29-Marreromarco-impresionante.wav","examples":[{"text":"Es realmente impresionante.","en":"That's really impressive.","audio":"https://tatoeba.org/en/audio/download/519563","words":[{"g":"to be","l":"ser"},{"g":"really"},null]},{"text":"Eso es bastante impresionante.","en":"That's pretty impressive.","audio":"https://tatoeba.org/en/audio/download/519524","words":[null,null,{"g":"quite"},null],"phrases":[[0,2,"that's it"]]},{"text":"Es impresionante cómo funciona.","en":"It's amazing how it works.","audio":"https://tatoeba.org/en/audio/download/611335","words":[{"g":"to be","l":"ser"},null,{"g":"how"},{"g":"to work, to function","l":"funcionar"}]},{"text":"Realmente te ves impresionante.","en":"You really do look stunning.","audio":"https://tatoeba.org/en/audio/download/803921","words":[{"g":"really"},{"g":"you"},{"g":"to see, to spot","l":"ver"},null]},{"text":"La vista era impresionante.","en":"The view was impressive.","words":[{"g":"the / her"},{"g":"sight"},{"g":"to be","l":"ser"},null]}]}