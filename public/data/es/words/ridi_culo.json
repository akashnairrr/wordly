{"id":"ridi_culo","lemma":"ridículo","pos":"adj","rank":944,"glosses":["ridiculous"],"ipa":"/riˈdikulo/","forms":{"feminine":"ridícula","masculinePlural":"ridículos","femininePlural":"ridículas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Marreromarco-rid%C3%ADculo.wav","examples":[{"text":"No seas tan ridículo.","en":"Don't be so ridiculous.","audio":"https://tatoeba.org/en/audio/download/460296"},{"text":"La gente es ridícula.","en":"People are funny.","audio":"https://tatoeba.org/en/audio/download/799250"},{"text":"Ustedes dos son ridículos.","en":"You two are ridiculous.","audio":"https://tatoeba.org/en/audio/download/458814"},{"text":"Ese sombrero me parece ridículo.","en":"That hat looks kind of stupid.","audio":"https://tatoeba.org/en/audio/download/803927"},{"text":"Es una idea ridícula.","en":"It's a stupid idea.","audio":"https://tatoeba.org/en/audio/download/63628"}]}