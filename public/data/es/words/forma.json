{"id":"forma","lemma":"forma","pos":"noun","rank":207,"glosses":["shape; form; figure","way; manner","basis; method"],"ipa":"/ˈfoɾma/","gender":"f","forms":{"plural":"formas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Precision27-forma.wav","formAudio":{"formas":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q1321_%28spa%29-Eavqwiki-formas.wav"},"examples":[{"text":"No tengo forma de saberlo.","en":"I have no way of knowing.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to know, to understand","l":"saber"}]},{"text":"¿Cuántas formas hay de hacer eso?","en":"How many ways are there to do that?","audio":"https://tatoeba.org/en/audio/download/567850","words":[{"g":"how many"},null,{"g":"to have","l":"haber"},{"g":"of / from"},{"g":"to do"},{"g":"that","l":"ése"}]},{"text":"De esta forma es mucho mejor.","en":"It's much better this way.","audio":"https://tatoeba.org/en/audio/download/611319","words":[null,null,null,{"g":"to be","l":"ser"},{"g":"much"},{"g":"better"}],"phrases":[[0,2,"definitely this time"]]},{"text":"Lo puedes hacer de ambas formas.","en":"You can do it either way.","audio":"https://tatoeba.org/en/audio/download/765608","words":[{"g":"it / him"},{"g":"to be able to, can","l":"poder"},null,null,{"g":"both","l":"ambos"},null],"phrases":[[2,4,"to make as if"]]},{"text":"Respira de forma normal.","en":"Breathe normally.","audio":"https://tatoeba.org/en/audio/download/443198","words":[{"g":"to breathe","l":"respirar"},{"g":"of / from"},null,{"g":"normal"}]}]}