{"id":"forma","lemma":"forma","pos":"noun","rank":207,"glosses":["shape; form; figure","way; manner","basis; method"],"ipa":"/ˈfoɾma/","gender":"f","forms":{"plural":"formas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Precision27-forma.wav","formAudio":{"formas":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q1321_%28spa%29-Eavqwiki-formas.wav"},"examples":[{"text":"No tengo forma de saberlo.","en":"I have no way of knowing.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to know, to understand","l":"saber"}]},{"text":"De esta forma es mucho mejor.","en":"It's much better this way.","audio":"https://tatoeba.org/en/audio/download/611319","words":[null,null,null,{"g":"to be","l":"ser"},{"g":"much"},{"g":"better"}],"phrases":[[0,2,"definitely this time"]]},{"text":"Respira de forma normal.","en":"Breathe normally.","audio":"https://tatoeba.org/en/audio/download/443198","words":[{"g":"to breathe","l":"respirar"},{"g":"of / from"},null,{"g":"normal"}]},{"text":"Me voy a poner en forma.","en":"I'm going to get in shape.","audio":"https://tatoeba.org/en/audio/download/510114","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to put, to place"},{"g":"in / on"},null]},{"text":"No deseo hacerlo de esa forma.","en":"I don't want to do it like that.","audio":"https://tatoeba.org/en/audio/download/298666","words":[{"g":"no / not"},{"g":"desire, wish"},{"g":"to do","l":"hacer"},{"g":"of / from"},{"g":"that","l":"ese"},null]}]}