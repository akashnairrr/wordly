{"id":"forma","lemma":"forma","pos":"noun","rank":210,"glosses":["shape; form; figure","way; manner","basis; method"],"ipa":"/ˈfoɾma/","gender":"f","forms":{"plural":"formas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Precision27-forma.wav","formAudio":{"formas":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q1321_%28spa%29-Eavqwiki-formas.wav"},"examples":[{"text":"Respira de forma normal.","en":"Breathe normally.","audio":"https://tatoeba.org/en/audio/download/443198"},{"text":"Gracias de todas formas.","en":"Thanks anyway.","audio":"https://tatoeba.org/en/audio/download/501206"},{"text":"No estoy en forma.","en":"I'm out of shape.","audio":"https://tatoeba.org/en/audio/download/550011"},{"text":"Hay tres formas de ganar.","en":"There are three ways to win.","audio":"https://tatoeba.org/en/audio/download/1152635"},{"text":"Ocurrió de forma natural.","en":"It happened naturally.","audio":"https://tatoeba.org/en/audio/download/459930"}]}