{"id":"cuerpo","lemma":"cuerpo","pos":"noun","rank":314,"glosses":["body (the physical structure of a human or animal)","body, torso","body, corpse"],"ipa":"/ˈkweɾpo/","gender":"m","forms":{"plural":"cuerpos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-AdrianAbdulBaha-cuerpo.wav","examples":[{"text":"Tiene un cuerpo perfecto.","en":"He has a perfect body.","audio":"https://tatoeba.org/en/audio/download/702912"},{"text":"Su caballo ganó por tres cuerpos.","en":"His horse won by three lengths.","audio":"https://tatoeba.org/en/audio/download/1061758"},{"text":"Me duele todo el cuerpo.","en":"I ache all over.","audio":"https://tatoeba.org/en/audio/download/538006"},{"text":"Varios cuerpos fueron encontrados.","en":"Several bodies were discovered."},{"text":"Me dolía todo el cuerpo.","en":"My whole body ached.","audio":"https://tatoeba.org/en/audio/download/1253515"}]}