{"id":"amistad","lemma":"amistad","pos":"noun","rank":1451,"glosses":["friendship"],"ipa":"/amisˈtad/","gender":"f","forms":{"plural":"amistades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q1321_%28spa%29-AdrianAbdulBaha-amistad.wav","examples":[{"text":"¿Qué es mejor que la amistad?","en":"What is better than friendship?","audio":"https://tatoeba.org/en/audio/download/645555","words":[{"g":"what"},{"g":"to be","l":"ser"},{"g":"better"},{"g":"that"},{"g":"the / her"},null]},{"text":"Tu amistad significa mucho para mí.","en":"Your friendship has great value to me.","audio":"https://tatoeba.org/en/audio/download/688961","words":[{"g":"your"},null,{"g":"to signify","l":"significar"},{"g":"much"},null,null],"phrases":[[4,6,"in my opinion"]]},{"text":"Una fiesta es un buen lugar para hacer amistades.","en":"A party is a good place to make friends with other people.","words":[{"g":"a"},{"g":"party"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"place"},{"g":"for"},{"g":"to do"},null]},{"text":"Creo en la amistad.","en":"I believe in friendship.","audio":"https://tatoeba.org/en/audio/download/639162","words":[{"g":"to believe","l":"creer"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Pronto hicieron amistad.","en":"They soon became friends.","audio":"https://tatoeba.org/en/audio/download/512867","words":[{"g":"prompt, on time"},{"g":"to do","l":"hacer"},null]}]}