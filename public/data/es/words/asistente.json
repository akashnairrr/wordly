{"id":"asistente","lemma":"asistente","pos":"noun","rank":1472,"glosses":["attendee","assistant"],"ipa":"/asisˈtente/","gender":"m","forms":{"plural":"asistentes","feminine":"asistente","femininePlural":"asistentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q1321_%28spa%29-AdrianAbdulBaha-asistente.wav","examples":[{"text":"Soy su nueva asistente.","en":"I'm your new assistant.","audio":"https://tatoeba.org/en/audio/download/270292"},{"text":"Él tuvo dos o tres asistentes bastante competentes.","en":"He had two or three rather competent assistants."},{"text":"Tengo mi propio asistente.","en":"I have my own assistant.","audio":"https://tatoeba.org/en/audio/download/459098"},{"text":"No eres mi asistente.","en":"You're not my assistant.","audio":"https://tatoeba.org/en/audio/download/797976"},{"text":"Soy el asistente de Tom.","en":"I'm Tom's assistant.","audio":"https://tatoeba.org/en/audio/download/152857"}]}