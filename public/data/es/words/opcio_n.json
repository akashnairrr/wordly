{"id":"opcio_n","lemma":"opción","pos":"noun","rank":884,"glosses":["option"],"ipa":"/obˈθjon/","gender":"f","forms":{"plural":"opciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-Marreromarco-opci%C3%B3n.wav","examples":[{"text":"No tuve otra opción.","en":"I had no other choice.","audio":"https://tatoeba.org/en/audio/download/454186"},{"text":"Tom tiene dos opciones.","en":"Tom has two choices.","audio":"https://tatoeba.org/en/audio/download/798912"},{"text":"Quiero una tercera opción.","en":"I want a third choice.","audio":"https://tatoeba.org/en/audio/download/454130"},{"text":"¿Cuáles son mis opciones?","en":"What are my choices?","audio":"https://tatoeba.org/en/audio/download/454742"},{"text":"No teníamos otra opción.","en":"We had no other option.","audio":"https://tatoeba.org/en/audio/download/415978"}]}