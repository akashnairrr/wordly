{"id":"difi_cil","lemma":"difícil","pos":"adj","rank":291,"glosses":["difficult, hard, tough, challenging, rough, tricky, trying, arduous, testing","unlikely (i.e. improbable)","awkward (e.g. situation or position)"],"ipa":"/diˈfiθil/","forms":{"femininePlural":"difíciles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-AdrianAbdulBaha-dif%C3%ADcil.wav","examples":[{"text":"Eso sería difícil.","en":"That would be difficult.","audio":"https://tatoeba.org/en/audio/download/599163","words":[{"g":"that","l":"ése"},{"g":"to be","l":"ser"},null]},{"text":"¿Será un examen difícil?","en":"Will it be a difficult exam?","audio":"https://tatoeba.org/en/audio/download/642211","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"exam"},null]},{"text":"Este problema parece difícil.","en":"This problem seems difficult.","audio":"https://tatoeba.org/en/audio/download/582321","words":[{"g":"this"},{"g":"problem"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"No hagas preguntas tan difíciles.","en":"Don't ask such hard questions.","audio":"https://tatoeba.org/en/audio/download/38411","words":[{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"question","l":"pregunta"},{"g":"so, as"},null]},{"text":"Será un día difícil para mí.","en":"It'll be a difficult day for me.","audio":"https://tatoeba.org/en/audio/download/798363","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"day"},null,null,null],"phrases":[[4,6,"in my opinion"]]}]}