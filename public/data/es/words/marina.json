{"id":"marina","lemma":"marina","pos":"noun","rank":1580,"glosses":["navy"],"ipa":"/maˈɾina/","gender":"f","forms":{"plural":"marinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Marreromarco-marina.wav","examples":[{"text":"Me fui a la marina.","en":"I went into the navy.","audio":"https://tatoeba.org/en/audio/download/455345","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},null]},{"text":"La Marina defiende nuestras costas.","en":"The navy defends our seacoast.","words":[{"g":"the / her"},null,{"g":"to defend","l":"defender"},{"g":"our, ours, to us","l":"nuestro"},{"g":"coast, coastline","l":"costa"}]},{"text":"Tom y Mary se apuntaron a la marina.","en":"Tom and Mary joined the navy.","words":[null,{"g":"and"},null,{"g":"oneself"},{"g":"to point","l":"apuntar"},{"g":"to"},{"g":"the / her"},null]},{"text":"Las tortugas marinas son longevas.","en":"Sea turtles have a long lifespan.","words":[{"g":"the / them"},{"g":"turtle","l":"tortuga"},null,{"g":"to be","l":"ser"},null]},{"text":"Ellos hicieron que el piloto volara el helicóptero de la Marina.","en":"They made the pilot fly the Navy helicopter.","words":[{"g":"they","l":"él"},{"g":"to do","l":"hacer"},{"g":"that"},{"g":"the"},{"g":"pilot"},{"g":"to fly, to fly away","l":"volar"},{"g":"the"},{"g":"helicopter"},null,null,null],"phrases":[[8,10,"of the"]]}]}