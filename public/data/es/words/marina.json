{"id":"marina","lemma":"marina","pos":"noun","rank":1580,"glosses":["navy"],"ipa":"/maˈɾina/","gender":"f","forms":{"plural":"marinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Marreromarco-marina.wav","examples":[{"text":"Me fui a la marina.","en":"I went into the navy.","audio":"https://tatoeba.org/en/audio/download/455345","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},null]},{"text":"Las tortugas marinas son longevas.","en":"Sea turtles have a long lifespan.","words":[{"g":"the / them"},{"g":"turtle","l":"tortuga"},null,{"g":"to be","l":"ser"},null]},{"text":"La Marina defiende nuestras costas.","en":"The navy defends our seacoast.","words":[{"g":"the / her"},null,{"g":"to defend","l":"defender"},{"g":"our, ours, to us","l":"nuestro"},{"g":"coast, coastline","l":"costa"}]},{"text":"A las nutrias marinas les encanta comer almejas mientras nadan boca arriba.","en":"Sea otters love to eat clams while swimming on their backs.","audio":"https://tatoeba.org/en/audio/download/930664","words":[{"g":"to"},{"g":"the / them"},{"g":"otter","l":"nutria"},null,{"g":"them"},{"g":"to charm, to enchant","l":"encantar"},{"g":"to eat"},{"g":"clam, cockle","l":"almeja"},{"g":"while, whilst, as"},{"g":"to swim","l":"nadar"},null,null],"phrases":[[10,12,"face-up"]]},{"text":"Tom y Mary se apuntaron a la marina.","en":"Tom and Mary joined the navy.","words":[null,{"g":"and"},null,{"g":"oneself"},{"g":"to point","l":"apuntar"},{"g":"to"},{"g":"the / her"},null]}]}