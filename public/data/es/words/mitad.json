{"id":"mitad","lemma":"mitad","pos":"noun","rank":534,"glosses":["half"],"ipa":"/miˈtad/","gender":"f","forms":{"plural":"mitades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1321_%28spa%29-AdrianAbdulBaha-mitad.wav","examples":[{"text":"Dame la mitad.","en":"Give me half.","audio":"https://tatoeba.org/en/audio/download/438288","words":[{"g":"to give, to give out","l":"dar"},{"g":"the / her"},null]},{"text":"Necesito sólo la mitad.","en":"I only need half.","audio":"https://tatoeba.org/en/audio/download/442785","words":[{"g":"to need","l":"necesitar"},null,{"g":"the / her"},null]},{"text":"Puedo hacerlo en la mitad de tiempo.","en":"I can do it in half the time.","audio":"https://tatoeba.org/en/audio/download/333129","words":[{"g":"to be able to, can","l":"poder"},{"g":"to do","l":"hacer"},{"g":"in / on"},{"g":"the / her"},null,{"g":"of / from"},{"g":"time"}]},{"text":"Doblar el papel por la mitad.","en":"Fold the paper in half.","audio":"https://tatoeba.org/en/audio/download/351960","words":[{"g":"to fold"},{"g":"the"},{"g":"paper"},{"g":"for / by"},{"g":"the / her"},null]},{"text":"¿Quieres la mitad de esta torta?","en":"Do you want half of this cake?","audio":"https://tatoeba.org/en/audio/download/582405","words":[{"g":"to desire","l":"querer"},{"g":"the / her"},null,null,null,{"g":"cake"}],"phrases":[[3,5,"definitely this time"]]}]}