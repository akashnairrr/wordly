{"id":"mitad","lemma":"mitad","pos":"noun","rank":537,"glosses":["half"],"ipa":"/miˈtad/","gender":"f","forms":{"plural":"mitades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1321_%28spa%29-AdrianAbdulBaha-mitad.wav","examples":[{"text":"Pártelo a la mitad.","en":"Cut it in half.","audio":"https://tatoeba.org/en/audio/download/40253"},{"text":"Necesito sólo la mitad.","en":"I only need half.","audio":"https://tatoeba.org/en/audio/download/442785"},{"text":"Doblar el papel por la mitad.","en":"Fold the paper in half.","audio":"https://tatoeba.org/en/audio/download/351960"},{"text":"La mitad de ésos son míos.","en":"Half of these are mine.","audio":"https://tatoeba.org/en/audio/download/461010"},{"text":"La mitad de éstas son mías.","en":"Half of these are mine.","audio":"https://tatoeba.org/en/audio/download/461011"}]}