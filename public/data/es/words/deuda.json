{"id":"deuda","lemma":"deuda","pos":"noun","rank":1828,"glosses":["debt (an obligation to perform for another)","debt (the state of owing something to another)","debt (money that someone owes to another)"],"ipa":"/ˈdeuda/","gender":"f","forms":{"plural":"deudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-AdrianAbdulBaha-deuda.wav","examples":[{"text":"Tengo una deuda con él.","en":"I owe him a debt.","audio":"https://tatoeba.org/en/audio/download/703018"},{"text":"Estoy libre de deudas.","en":"I am free of debt.","audio":"https://tatoeba.org/en/audio/download/734430"},{"text":"Estoy en deuda con usted.","en":"I'm indebted to you.","audio":"https://tatoeba.org/en/audio/download/449352"},{"text":"Debo pagar mis deudas.","en":"I must repay my debts.","audio":"https://tatoeba.org/en/audio/download/453642"},{"text":"Su deuda alcanzó los 100 dólares.","en":"His debt came to 100 dollars.","audio":"https://tatoeba.org/en/audio/download/706763"}]}