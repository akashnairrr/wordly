{"id":"deuda","lemma":"deuda","pos":"noun","rank":1824,"glosses":["debt (an obligation to perform for another)","debt (the state of owing something to another)","debt (money that someone owes to another)"],"ipa":"/ˈdeuda/","gender":"f","forms":{"plural":"deudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-AdrianAbdulBaha-deuda.wav","examples":[{"text":"Estoy libre de deudas.","en":"I am free of debt.","audio":"https://tatoeba.org/en/audio/download/734430","words":[{"g":"to be","l":"estar"},{"g":"free"},{"g":"of / from"},null]},{"text":"Tengo una deuda con él.","en":"I owe him a debt.","audio":"https://tatoeba.org/en/audio/download/703018","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"with"},{"g":"he"}]},{"text":"Debo pagar mis deudas.","en":"I must repay my debts.","audio":"https://tatoeba.org/en/audio/download/453642","words":[{"g":"to owe","l":"deber"},{"g":"to pay"},{"g":"my"},null]},{"text":"Estoy en deuda contigo.","en":"I'm in your debt.","words":[{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"with you"}]},{"text":"¿Cómo pagaré mis deudas?","en":"How will I pay my debts?","audio":"https://tatoeba.org/en/audio/download/833115","words":[{"g":"how"},{"g":"to pay","l":"pagar"},{"g":"my"},null]}]}