{"id":"deuda","lemma":"deuda","pos":"noun","rank":1825,"glosses":["debt (an obligation to perform for another)","debt (the state of owing something to another)","debt (money that someone owes to another)"],"ipa":"/ˈdeuda/","gender":"f","forms":{"plural":"deudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-AdrianAbdulBaha-deuda.wav","examples":[{"text":"Estoy en deuda con usted.","en":"I'm indebted to you.","audio":"https://tatoeba.org/en/audio/download/449352","words":[{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"with"},{"g":"you (formal)"}]},{"text":"Estoy libre de deudas.","en":"I am free of debt.","audio":"https://tatoeba.org/en/audio/download/734430","words":[{"g":"to be","l":"estar"},{"g":"free"},{"g":"of / from"},null]},{"text":"Tengo una deuda con él.","en":"I owe him a debt.","audio":"https://tatoeba.org/en/audio/download/703018","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"with"},{"g":"he"}]},{"text":"Debo pagar mis deudas.","en":"I must repay my debts.","audio":"https://tatoeba.org/en/audio/download/453642","words":[{"g":"to owe","l":"deber"},{"g":"to pay"},{"g":"my"},null]},{"text":"Nuestra deuda es mayor de lo que podemos pagar.","en":"Our debt is more than we can pay.","audio":"https://tatoeba.org/en/audio/download/514761","words":[{"g":"our, ours, to us","l":"nuestro"},null,{"g":"to be","l":"ser"},{"g":"of age"},{"g":"of / from"},null,null,{"g":"to prune","l":"podar"},{"g":"to pay"}],"phrases":[[5,7,"what, that which"]]}]}