{"id":"pa_gina","lemma":"página","pos":"noun","rank":1463,"glosses":["page"],"ipa":"/ˈpaxina/","gender":"f","forms":{"plural":"páginas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-AdrianAbdulBaha-p%C3%A1gina.wav","examples":[{"text":"¿En qué página estás?","en":"What page are you on?","audio":"https://tatoeba.org/en/audio/download/550388"},{"text":"Tengo que imprimir 100 páginas.","en":"I have to print 100 pages.","audio":"https://tatoeba.org/en/audio/download/531717"},{"text":"Empecemos en la página 30.","en":"Let's begin on page 30.","audio":"https://tatoeba.org/en/audio/download/72271"},{"text":"Han arrancado tres páginas.","en":"Three pages have been torn out.","audio":"https://tatoeba.org/en/audio/download/512869"},{"text":"¿En qué página está Tom?","en":"What page is Tom on?","audio":"https://tatoeba.org/en/audio/download/800845"}]}