{"id":"aguja","lemma":"aguja","pos":"noun","rank":2807,"glosses":["needle","hand (of a clock)","firing pin"],"ipa":"/aˈɡuxa/","gender":"f","forms":{"plural":"agujas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q1321_%28spa%29-AdrianAbdulBaha-aguja.wav","examples":[{"text":"Un reloj tiene dos agujas.","en":"A clock has two hands.","audio":"https://tatoeba.org/en/audio/download/823735","words":[{"g":"a"},{"g":"clock"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null]},{"text":"Deja que te enhebre la aguja.","en":"Let me thread the needle for you.","audio":"https://tatoeba.org/en/audio/download/462102","words":[{"g":"rest"},{"g":"that"},{"g":"you"},null,{"g":"the / her"},null]},{"text":"¿Quieres que enhebre la aguja por ti?","en":"Would you like me to thread the needle for you?","audio":"https://tatoeba.org/en/audio/download/459682","words":[{"g":"to desire","l":"querer"},{"g":"that"},null,{"g":"the / her"},null,{"g":"for / by"},{"g":"you","l":"tú"}]},{"text":"¿No tendrás una aguja y algo de hilo?","en":"Don't you have a needle and some thread?","audio":"https://tatoeba.org/en/audio/download/688852","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"and"},{"g":"something, anything"},null,null],"phrases":[[6,8,"straight"]]},{"text":"Permítame enhebrar la aguja por usted.","en":"Let me thread the needle for you.","audio":"https://tatoeba.org/en/audio/download/460050","words":[{"g":"to allow, permit","l":"permitir"},null,{"g":"the / her"},null,{"g":"for / by"},{"g":"you (formal)"}]}]}