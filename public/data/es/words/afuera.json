{"id":"afuera","lemma":"afuera","pos":"adv","rank":424,"glosses":["out, outside","peripheral"],"ipa":"/aˈfweɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-Marreromarco-afuera.wav","examples":[{"text":"¿Puedo ir afuera?","en":"Can I go outside?","audio":"https://tatoeba.org/en/audio/download/443140","words":[{"g":"to be able to, can","l":"poder"},{"g":"to go"},null]},{"text":"Ven conmigo afuera.","en":"Come outside with me.","audio":"https://tatoeba.org/en/audio/download/513380","words":[{"g":"to come","l":"venir"},{"g":"with me"},null]},{"text":"¿Puedes esperar afuera?","en":"Can you wait outside?","audio":"https://tatoeba.org/en/audio/download/454804","words":[{"g":"to be able to, can","l":"poder"},{"g":"to hope"},null]},{"text":"Ella está afuera ahora.","en":"She is out now.","audio":"https://tatoeba.org/en/audio/download/441120","words":[{"g":"she"},{"g":"to be","l":"estar"},null,{"g":"now"}]},{"text":"Lleva afuera la basura.","en":"Take the garbage out.","audio":"https://tatoeba.org/en/audio/download/454795","words":[{"g":"to take somewhere","l":"llevar"},null,{"g":"the / her"},{"g":"trash"}]}]}