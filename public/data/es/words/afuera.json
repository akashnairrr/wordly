{"id":"afuera","lemma":"afuera","pos":"adv","rank":427,"glosses":["out, outside","peripheral"],"ipa":"/aˈfweɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-Marreromarco-afuera.wav","examples":[{"text":"Ella está afuera ahora.","en":"She is out now.","audio":"https://tatoeba.org/en/audio/download/441120"},{"text":"Ve a esperar afuera.","en":"Go wait outside.","audio":"https://tatoeba.org/en/audio/download/441596"},{"text":"Hay un guardia afuera.","en":"A guard is outside.","audio":"https://tatoeba.org/en/audio/download/449372"},{"text":"Hace frío allí afuera.","en":"It's cold out there.","audio":"https://tatoeba.org/en/audio/download/449003"},{"text":"¿Comes afuera a menudo?","en":"Do you eat out often?","audio":"https://tatoeba.org/en/audio/download/453143"}]}