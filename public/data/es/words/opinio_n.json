{"id":"opinio_n","lemma":"opinión","pos":"noun","rank":727,"glosses":["opinion"],"ipa":"/opiˈnjon/","gender":"f","forms":{"plural":"opiniones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-AdrianAbdulBaha-opini%C3%B3n.wav","examples":[{"text":"Soy de su opinión.","en":"We think alike.","audio":"https://tatoeba.org/en/audio/download/706482"},{"text":"Planeamos obtener las opiniones del público.","en":"We plan to elicit opinions from the public.","audio":"https://tatoeba.org/en/audio/download/705486"},{"text":"Tengo una opinión diferente.","en":"I think otherwise.","audio":"https://tatoeba.org/en/audio/download/443728"},{"text":"A partir de aquí nuestras opiniones difieren.","en":"It's on this point that our opinions differ.","audio":"https://tatoeba.org/en/audio/download/806363"},{"text":"¿Esta es tu opinión?","en":"Is this your opinion?","audio":"https://tatoeba.org/en/audio/download/800927"}]}