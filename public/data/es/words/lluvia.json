{"id":"lluvia","lemma":"lluvia","pos":"noun","rank":1351,"glosses":["rain","shower (precipitation)"],"ipa":"/ˈʝubja/","gender":"f","forms":{"plural":"lluvias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Rodelar-lluvia.wav","examples":[{"text":"Cae una lluvia fina.","en":"It's drizzling.","audio":"https://tatoeba.org/en/audio/download/523640"},{"text":"La estación de lluvias empieza en junio.","en":"The rainy season begins in June.","audio":"https://tatoeba.org/en/audio/download/599036"},{"text":"¿Te gusta la lluvia?","en":"Do you like rain?","audio":"https://tatoeba.org/en/audio/download/39781"},{"text":"La época de lluvias comienza en junio.","en":"The rainy season begins in June.","audio":"https://tatoeba.org/en/audio/download/587547"},{"text":"Los cultivos necesitan lluvia.","en":"The crops need rain.","audio":"https://tatoeba.org/en/audio/download/448394"}]}