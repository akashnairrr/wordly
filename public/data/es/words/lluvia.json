{"id":"lluvia","lemma":"lluvia","pos":"noun","rank":1348,"glosses":["rain","shower (precipitation)"],"ipa":"/ˈʝubja/","gender":"f","forms":{"plural":"lluvias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Rodelar-lluvia.wav","examples":[{"text":"¿Te gusta la lluvia?","en":"Do you like rain?","audio":"https://tatoeba.org/en/audio/download/39781","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},null]},{"text":"Esperamos lluvia hoy.","en":"We expect rain today.","audio":"https://tatoeba.org/en/audio/download/454889","words":[{"g":"to hope","l":"esperar"},null,{"g":"today, tonight"}]},{"text":"Hemos tenido mucha lluvia este mes.","en":"We've had a lot of rain this month.","audio":"https://tatoeba.org/en/audio/download/537846","words":[{"g":"heme","l":"hemo"},{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},null,{"g":"this"},{"g":"month"}]},{"text":"La época de lluvias comienza en junio.","en":"The rainy season begins in June.","audio":"https://tatoeba.org/en/audio/download/587547","words":[{"g":"the / her"},{"g":"epoch"},{"g":"of / from"},null,{"g":"to begin, to commence","l":"comenzar"},{"g":"in / on"},{"g":"June"}]},{"text":"La lluvia se convirtió en nieve.","en":"The rain changed into snow.","audio":"https://tatoeba.org/en/audio/download/594325","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to turn into","l":"convertir"},{"g":"in / on"},{"g":"snow"}]}]}