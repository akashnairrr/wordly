{"id":"lluvia","lemma":"lluvia","pos":"noun","rank":1348,"glosses":["rain","shower (precipitation)"],"ipa":"/ˈʝubja/","gender":"f","forms":{"plural":"lluvias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Rodelar-lluvia.wav","examples":[{"text":"¿Te gusta la lluvia?","en":"Do you like rain?","audio":"https://tatoeba.org/en/audio/download/39781","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},null]},{"text":"No me molesta caminar bajo la lluvia.","en":"It doesn't bother me to walk in the rain.","audio":"https://tatoeba.org/en/audio/download/609013","words":[{"g":"no / not"},{"g":"me"},{"g":"annoyed, vexed","l":"molesto"},{"g":"to walk"},{"g":"short"},{"g":"the / her"},null]},{"text":"La estación de lluvias empieza en junio.","en":"The rainy season begins in June.","audio":"https://tatoeba.org/en/audio/download/599036","words":[{"g":"the / her"},{"g":"station"},{"g":"of / from"},null,{"g":"to start","l":"empezar"},{"g":"in / on"},{"g":"June"}]},{"text":"Esperamos lluvia hoy.","en":"We expect rain today.","audio":"https://tatoeba.org/en/audio/download/454889","words":[{"g":"to hope","l":"esperar"},null,{"g":"today, tonight"}]},{"text":"La lluvia se convirtió en nieve.","en":"The rain changed into snow.","audio":"https://tatoeba.org/en/audio/download/594325","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to turn into","l":"convertir"},{"g":"in / on"},{"g":"snow"}]}]}