{"id":"uniforme","lemma":"uniforme","pos":"adj","rank":1574,"glosses":["uniform, even"],"ipa":"/uniˈfoɾme/","forms":{"femininePlural":"uniformes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q1321_%28spa%29-AdrianAbdulBaha-uniforme.wav","examples":[{"text":"¿Dónde está tu uniforme?","en":"Where's your uniform?","audio":"https://tatoeba.org/en/audio/download/454054"},{"text":"Los soldados marchan con uniformes de camuflaje.","en":"The soldiers march in camouflaged uniforms.","audio":"https://tatoeba.org/en/audio/download/693520"},{"text":"Los dos llevan uniforme.","en":"They're both wearing uniforms.","audio":"https://tatoeba.org/en/audio/download/355381"},{"text":"Nuestro colegio abandonó los uniformes el año pasado.","en":"Our school did away with uniforms last year."},{"text":"En nuestra escuela llevamos uniforme.","en":"We wear uniforms at our school.","audio":"https://tatoeba.org/en/audio/download/733703"}]}