{"id":"pase","lemma":"pase","pos":"noun","rank":543,"glosses":["pass, permit","pass (the act of moving the ball or puck from one player to another)"],"ipa":"/ˈpase/","gender":"m","forms":{"plural":"pases"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-AdrianAbdulBaha-pase.wav","examples":[{"text":"Pase adentro, por favor.","en":"Please come in.","audio":"https://tatoeba.org/en/audio/download/441084"},{"text":"No te pases de listo.","en":"Don't get any ideas.","audio":"https://tatoeba.org/en/audio/download/586913"},{"text":"No quiero que eso pase.","en":"I don't want that to happen.","audio":"https://tatoeba.org/en/audio/download/582034"},{"text":"No te pases de vueltas, Tom.","en":"Dial it back, Tom.","audio":"https://tatoeba.org/en/audio/download/800092"},{"text":"Nadie quiere que eso pase.","en":"No one wants that to happen.","audio":"https://tatoeba.org/en/audio/download/823757"}]}