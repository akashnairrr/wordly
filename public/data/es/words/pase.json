{"id":"pase","lemma":"pase","pos":"noun","rank":540,"glosses":["pass, permit","pass (the act of moving the ball or puck from one player to another)"],"ipa":"/ˈpase/","gender":"m","forms":{"plural":"pases"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-AdrianAbdulBaha-pase.wav","examples":[{"text":"¿Cómo puedo evitar que pase esto?","en":"How can I prevent this from happening?","audio":"https://tatoeba.org/en/audio/download/689358","words":[{"g":"how"},{"g":"to be able to, can","l":"poder"},{"g":"to avoid"},{"g":"that"},null,{"g":"this"}]},{"text":"No quiero que nada te pase.","en":"I don't want anything to happen to you.","audio":"https://tatoeba.org/en/audio/download/594793","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"that"},{"g":"nothing"},{"g":"you"},null]},{"text":"¿A qué hora quieres que pase por ti?","en":"What time do you want me to pick you up?","audio":"https://tatoeba.org/en/audio/download/616117","words":[{"g":"to"},{"g":"what"},{"g":"hour"},{"g":"to desire","l":"querer"},{"g":"that"},null,{"g":"for / by"},{"g":"you","l":"tú"}]},{"text":"Pase adentro, por favor.","en":"Please come in.","audio":"https://tatoeba.org/en/audio/download/441084","words":[null,{"g":"inside"},null,null],"phrases":[[2,4,"please"]]},{"text":"No puedes permitir que eso pase.","en":"You can't let that happen.","audio":"https://tatoeba.org/en/audio/download/606548","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to allow, permit"},{"g":"that"},{"g":"that","l":"ése"},null]}]}