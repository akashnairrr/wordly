{"id":"pase","lemma":"pase","pos":"noun","rank":541,"glosses":["pass, permit","pass (the act of moving the ball or puck from one player to another)"],"ipa":"/ˈpase/","gender":"m","forms":{"plural":"pases"},"order":743,"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-AdrianAbdulBaha-pase.wav","examples":[{"text":"Nadie quiere que eso pase.","en":"No one wants that to happen.","audio":"https://tatoeba.org/en/audio/download/823757","words":[{"g":"no one"},{"g":"to desire","l":"querer"},{"g":"that"},{"g":"that","l":"ése"},null]},{"text":"Él espera que pase algo interesante.","en":"He hopes that something interesting happens.","audio":"https://tatoeba.org/en/audio/download/692755","words":[{"g":"he"},{"g":"wait"},{"g":"that"},null,{"g":"something, anything"},{"g":"interesting"}]},{"text":"Lo haré pase lo que pase.","en":"I'll do that, no matter what.","audio":"https://tatoeba.org/en/audio/download/929761","words":[{"g":"it / him"},{"g":"to do","l":"hacer"},null,null,null,null],"phrases":[[3,5,"what, that which"]]}]}