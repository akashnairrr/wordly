{"id":"jama_s","lemma":"jamás","pos":"adv","rank":488,"glosses":["never","ever"],"ipa":"/xaˈmas/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q1321_%28spa%29-Marreromarco-jam%C3%A1s.wav","examples":[{"text":"Jamás dudé de ti.","en":"I never doubted you.","audio":"https://tatoeba.org/en/audio/download/448244"},{"text":"Yo jamás te traicionaría.","en":"I'd never betray you.","audio":"https://tatoeba.org/en/audio/download/454509"},{"text":"Yo jamás le traicionaría.","en":"I'd never betray you.","audio":"https://tatoeba.org/en/audio/download/454510"},{"text":"Jamás estuve enojado contigo.","en":"I was never mad at you.","audio":"https://tatoeba.org/en/audio/download/460905"},{"text":"Esto no terminará jamás.","en":"This is never going to end.","audio":"https://tatoeba.org/en/audio/download/516450"}]}