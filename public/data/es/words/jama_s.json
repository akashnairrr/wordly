{"id":"jama_s","lemma":"jamás","pos":"adv","rank":485,"glosses":["never","ever"],"ipa":"/xaˈmas/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q1321_%28spa%29-Marreromarco-jam%C3%A1s.wav","examples":[{"text":"Jamás me haría hacerlo, ¿a que no?","en":"You'd never make me do that, would you?","audio":"https://tatoeba.org/en/audio/download/506576","words":[null,{"g":"me"},{"g":"to do","l":"hacer"},{"g":"to do","l":"hacer"},null,null,null],"phrases":[[4,7,"I bet"]]},{"text":"Jamás te voy a ayudar.","en":"I'll never help you.","audio":"https://tatoeba.org/en/audio/download/448789","words":[null,{"g":"you"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to help"}]},{"text":"¡Nunca jamás haré eso de nuevo!","en":"I'll never ever do that again!","audio":"https://tatoeba.org/en/audio/download/515020","words":[{"g":"never"},null,{"g":"to do","l":"hacer"},{"g":"that","l":"ése"},null,null],"phrases":[[4,6,"again"]]},{"text":"Yo jamás diría una cosa así.","en":"I would never say such a thing.","audio":"https://tatoeba.org/en/audio/download/600084","words":[{"g":"I"},null,{"g":"to say","l":"decir"},{"g":"a"},{"g":"thing"},{"g":"like this"}]},{"text":"Jamás lo olvides.","en":"Don't ever forget it.","audio":"https://tatoeba.org/en/audio/download/453462","words":[null,{"g":"it / him"},{"g":"to forget","l":"olvidar"}]}]}