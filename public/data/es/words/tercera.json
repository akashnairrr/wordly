{"id":"tercera","lemma":"tercera","pos":"noun","rank":1266,"glosses":["a third (interval)"],"ipa":"/teɾˈθeɾa/","gender":"f","forms":{"plural":"terceras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4b/LL-Q1321_%28spa%29-AdrianAbdulBaha-tercera.wav","examples":[{"text":"Quiero una tercera opción.","en":"I want a third choice.","audio":"https://tatoeba.org/en/audio/download/454130"},{"text":"Estamos en la tercera planta.","en":"We're on the third floor.","audio":"https://tatoeba.org/en/audio/download/567285"},{"text":"Ella lo intentó una tercera vez.","en":"She tried a third time.","audio":"https://tatoeba.org/en/audio/download/68576"},{"text":"Ella lo intentó por tercera vez.","en":"She tried a third time.","audio":"https://tatoeba.org/en/audio/download/68577"},{"text":"Me gustó la tercera canción que cantaste anoche.","en":"I liked the third song you sang last night.","audio":"https://tatoeba.org/en/audio/download/451382"}]}