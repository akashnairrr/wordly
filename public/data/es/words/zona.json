{"id":"zona","lemma":"zona","pos":"noun","rank":749,"glosses":["zone, district, area"],"ipa":"/ˈθona/","gender":"f","forms":{"plural":"zonas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q1321_%28spa%29-AdrianAbdulBaha-zona.wav","examples":[{"text":"Nos encanta esta zona.","en":"We love it here.","audio":"https://tatoeba.org/en/audio/download/442332"},{"text":"Rusia tiene once zonas horarias.","en":"Russia has eleven time zones."},{"text":"Él me mostró la zona.","en":"He showed me around.","audio":"https://tatoeba.org/en/audio/download/637020"},{"text":"Vivo en una zona rural.","en":"I live in a rural area.","audio":"https://tatoeba.org/en/audio/download/553048"},{"text":"En esta zona está prohibido fumar.","en":"Smoking is forbidden in this area.","audio":"https://tatoeba.org/en/audio/download/687304"}]}