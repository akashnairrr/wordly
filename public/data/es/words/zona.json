{"id":"zona","lemma":"zona","pos":"noun","rank":746,"glosses":["zone, district, area"],"ipa":"/ˈθona/","gender":"f","forms":{"plural":"zonas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q1321_%28spa%29-AdrianAbdulBaha-zona.wav","examples":[{"text":"¿Cómo de bien conoces esta zona?","en":"How well do you know this area?","words":[{"g":"how"},{"g":"of / from"},{"g":"well"},{"g":"to know","l":"conocer"},{"g":"this","l":"este"},null]},{"text":"Vivo en una zona rural.","en":"I live in a rural area.","audio":"https://tatoeba.org/en/audio/download/553048","words":[{"g":"alive, living"},{"g":"in / on"},{"g":"a"},null,{"g":"rural"}]},{"text":"Nos encanta esta zona.","en":"We love it here.","audio":"https://tatoeba.org/en/audio/download/442332","words":[{"g":"us"},{"g":"to charm, to enchant","l":"encantar"},{"g":"this","l":"este"},null]},{"text":"En esta zona está prohibido fumar.","en":"Smoking is forbidden in this area.","audio":"https://tatoeba.org/en/audio/download/687304","words":[{"g":"in / on"},{"g":"this","l":"este"},null,{"g":"to be","l":"estar"},null,null],"phrases":[[4,6,"no smoking"]]},{"text":"Él me mostró la zona.","en":"He showed me around.","audio":"https://tatoeba.org/en/audio/download/637020","words":[{"g":"he"},{"g":"me"},{"g":"to show","l":"mostrar"},{"g":"the / her"},null]}]}