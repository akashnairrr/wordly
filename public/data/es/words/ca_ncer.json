{"id":"ca_ncer","lemma":"cáncer","pos":"noun","rank":1371,"glosses":["cancer"],"ipa":"/ˈkanθeɾ/","gender":"m","forms":{"plural":"cánceres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q1321_%28spa%29-AdrianAbdulBaha-c%C3%A1ncer.wav","examples":[{"text":"Tomás murió de cáncer.","en":"Tom died of cancer.","audio":"https://tatoeba.org/en/audio/download/501554"},{"text":"Tiene cáncer de pulmón.","en":"He's got lung cancer.","audio":"https://tatoeba.org/en/audio/download/39293"},{"text":"Soy un paciente con cáncer.","en":"I'm a cancer patient.","audio":"https://tatoeba.org/en/audio/download/455266"},{"text":"Mi esposa murió de cáncer.","en":"My wife died of cancer.","audio":"https://tatoeba.org/en/audio/download/39208"},{"text":"Ese anciano murió de cáncer.","en":"The old man died of cancer.","audio":"https://tatoeba.org/en/audio/download/706984"}]}