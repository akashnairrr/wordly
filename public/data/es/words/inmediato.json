{"id":"inmediato","lemma":"inmediato","pos":"adj","rank":1124,"glosses":["immediate"],"ipa":"/immeˈdjato/","forms":{"feminine":"inmediata","masculinePlural":"inmediatos","femininePlural":"inmediatas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-AdrianAbdulBaha-inmediato.wav","examples":[{"text":"Puedes irte de inmediato.","en":"You may go at once.","audio":"https://tatoeba.org/en/audio/download/734519"},{"text":"Él dio una respuesta inmediata.","en":"He made a quick response."},{"text":"Se requieren medidas inmediatas.","en":"Prompt action is necessary.","audio":"https://tatoeba.org/en/audio/download/735624"},{"text":"Debemos actuar de inmediato.","en":"We must act at once.","audio":"https://tatoeba.org/en/audio/download/453543"},{"text":"La respuesta de Tom fue inmediata.","en":"Tom's response was immediate."}]}