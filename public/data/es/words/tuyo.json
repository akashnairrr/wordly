{"id":"tuyo","lemma":"tuyo","pos":"pron","rank":521,"glosses":["yours"],"ipa":"/ˈtuʝo/","forms":{"plural":"tuyos","feminine":"tuya","femininePlural":"tuyas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Marreromarco-tuyo.wav","formAudio":{"tuya":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Marreromarco-tuya.wav"},"examples":[{"text":"El tuyo es peor.","en":"Yours is worse.","audio":"https://tatoeba.org/en/audio/download/441397"},{"text":"¿Son tuyos todos esos libros?","en":"Are all these books yours?","audio":"https://tatoeba.org/en/audio/download/607943"},{"text":"Esto es culpa tuya.","en":"This is on you.","audio":"https://tatoeba.org/en/audio/download/441100"},{"text":"Estoy deseando tener noticias tuyas.","en":"I am looking forward to hearing from you soon.","audio":"https://tatoeba.org/en/audio/download/552868"},{"text":"El trabajo es tuyo.","en":"You got the job.","audio":"https://tatoeba.org/en/audio/download/442304"}]}