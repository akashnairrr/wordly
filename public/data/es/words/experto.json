{"id":"experto","lemma":"experto","pos":"adj","rank":1814,"glosses":["expert"],"ipa":"/eɡsˈpeɾto/","forms":{"feminine":"experta","masculinePlural":"expertos","femininePlural":"expertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-AdrianAbdulBaha-experto.wav","formAudio":{"expertos":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Precision27-expertos.wav"},"examples":[{"text":"Pregunta a un experto.","en":"Ask an expert.","audio":"https://tatoeba.org/en/audio/download/438036"},{"text":"Ella es experta en matemáticas.","en":"She is an expert in mathematics.","audio":"https://tatoeba.org/en/audio/download/35751"},{"text":"Los expertos dicen que es improbable.","en":"Experts say that's unlikely.","audio":"https://tatoeba.org/en/audio/download/804102"},{"text":"Tú eres el experto.","en":"You're the expert.","audio":"https://tatoeba.org/en/audio/download/103981"},{"text":"Eres la experta.","en":"You're the expert.","audio":"https://tatoeba.org/en/audio/download/448751"}]}