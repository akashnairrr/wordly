{"id":"bienvenido","lemma":"bienvenido","pos":"adj","rank":836,"glosses":["welcome"],"ipa":"/bjembeˈnido/","forms":{"feminine":"bienvenida","masculinePlural":"bienvenidos","femininePlural":"bienvenidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-AdrianAbdulBaha-bienvenido.wav","formAudio":{"bienvenida":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-Marreromarco-bienvenida.wav"},"examples":[{"text":"Bienvenido de vuelta, Tom.","en":"Welcome back, Tom.","audio":"https://tatoeba.org/en/audio/download/799685"},{"text":"Fue una sorpresa de bienvenida.","en":"It was a welcome surprise.","audio":"https://tatoeba.org/en/audio/download/299996"},{"text":"Los visitantes son bienvenidos.","en":"Visitors are welcome.","audio":"https://tatoeba.org/en/audio/download/453035"},{"text":"Las niñas no son bienvenidas.","en":"Girls aren't welcome."},{"text":"Bienvenido de nuevo, Tom.","en":"Welcome back, Tom.","audio":"https://tatoeba.org/en/audio/download/799686"}]}