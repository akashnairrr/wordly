{"id":"encuentro","lemma":"encuentro","pos":"noun","rank":752,"glosses":["encounter, meeting","dispute, row","match, game"],"ipa":"/enˈkwentɾo/","gender":"m","forms":{"plural":"encuentros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-AdrianAbdulBaha-encuentro.wav","examples":[{"text":"Me encuentro mejor.","en":"I am better.","audio":"https://tatoeba.org/en/audio/download/425008","words":[{"g":"me"},null,{"g":"better"}]},{"text":"Al fin te encuentro.","en":"Here you are.","audio":"https://tatoeba.org/en/audio/download/425171","words":[null,null,{"g":"you"},null],"phrases":[[0,2,"at last"]]},{"text":"Él sabe que no me gustan los encuentros cara a cara.","en":"He knows I don't like face to face meetings.","audio":"https://tatoeba.org/en/audio/download/77680","words":[{"g":"he"},{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"no / not"},{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"the / them"},null,null,null,null],"phrases":[[8,11,"vis-à-vis"]]},{"text":"Me encuentro con él en el club.","en":"I meet him at the club.","audio":"https://tatoeba.org/en/audio/download/460632","words":[{"g":"me"},null,{"g":"with"},{"g":"he"},{"g":"in / on"},{"g":"the"},{"g":"club"}]},{"text":"No encuentro las llaves de mi casa.","en":"I can't find the keys to my house.","audio":"https://tatoeba.org/en/audio/download/519607","words":[{"g":"no / not"},null,{"g":"the / them"},{"g":"key","l":"llave"},{"g":"of / from"},{"g":"my"},{"g":"house"}]}]}