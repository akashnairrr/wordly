{"id":"encuentro","lemma":"encuentro","pos":"noun","rank":752,"glosses":["encounter, meeting","dispute, row","match, game"],"ipa":"/enˈkwentɾo/","gender":"m","forms":{"plural":"encuentros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-AdrianAbdulBaha-encuentro.wav","examples":[{"text":"El encuentro es mañana.","en":"The meeting is tomorrow.","audio":"https://tatoeba.org/en/audio/download/556983","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"tomorrow"}]},{"text":"Me encuentro mucho mejor.","en":"I feel much better.","audio":"https://tatoeba.org/en/audio/download/799523","words":[{"g":"me"},null,{"g":"much"},{"g":"better"}]},{"text":"¿Dónde lo encuentro?","en":"Where can I find him?","words":[{"g":"where"},{"g":"it / him"},null]},{"text":"Ese fue nuestro primer encuentro.","en":"That was our first encounter.","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"our, ours, to us"},null,null]},{"text":"Él sabe que no me gustan los encuentros cara a cara.","en":"He knows I don't like face to face meetings.","audio":"https://tatoeba.org/en/audio/download/77680","words":[{"g":"he"},{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"no / not"},{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"the / them"},null,null,null,null],"phrases":[[8,11,"vis-à-vis"]]}]}