{"id":"venganza","lemma":"venganza","pos":"noun","rank":1313,"glosses":["vengeance"],"ipa":"/benˈɡanθa/","gender":"f","forms":{"plural":"venganzas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Marreromarco-venganza.wav","examples":[{"text":"Tendré mi venganza.","en":"I'll have my revenge.","audio":"https://tatoeba.org/en/audio/download/800818","words":[{"g":"to have","l":"tener"},{"g":"my"},null]},{"text":"Voy a tener mi venganza.","en":"I'll have my revenge.","audio":"https://tatoeba.org/en/audio/download/800819","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to have"},{"g":"my"},null]},{"text":"Todos queríamos venganza.","en":"We all wanted revenge.","audio":"https://tatoeba.org/en/audio/download/458892","words":[{"g":"all","l":"todo"},{"g":"to desire","l":"querer"},null]},{"text":"La venganza es dulce.","en":"Revenge is sweet.","words":[{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"sweet"}]},{"text":"Te otorgaremos tu venganza.","en":"We'll give you your revenge.","words":[{"g":"you"},null,{"g":"your"},null]}]}