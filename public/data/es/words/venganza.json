{"id":"venganza","lemma":"venganza","pos":"noun","rank":1316,"glosses":["vengeance"],"ipa":"/benˈɡanθa/","gender":"f","forms":{"plural":"venganzas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Marreromarco-venganza.wav","examples":[{"text":"Voy a tener mi venganza.","en":"I'll have my revenge.","audio":"https://tatoeba.org/en/audio/download/800819"},{"text":"La venganza es un plato que se sirve frío.","en":"Revenge is a dish best served cold.","audio":"https://tatoeba.org/en/audio/download/687829"},{"text":"La venganza es dulce.","en":"Revenge is sweet."},{"text":"Tom quería la venganza.","en":"Tom wanted revenge."},{"text":"Te otorgaremos tu venganza.","en":"We'll give you your revenge."}]}