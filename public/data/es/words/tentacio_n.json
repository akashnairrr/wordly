{"id":"tentacio_n","lemma":"tentación","pos":"noun","rank":4279,"glosses":["temptation"],"ipa":"/tentaˈθjon/","gender":"f","forms":{"plural":"tentaciones"},"order":4280,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q1321_%28spa%29-Marreromarco-tentaci%C3%B3n.wav","examples":[{"text":"Él cayó en la tentación.","en":"He gave in to the temptation.","audio":"https://tatoeba.org/en/audio/download/819948","words":[{"g":"he"},{"g":"to fall","l":"caer"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Él no pudo resistir la tentación.","en":"He could not resist the temptation.","audio":"https://tatoeba.org/en/audio/download/687756","words":[{"g":"he"},{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to tolerate"},{"g":"the / her"},null]},{"text":"No debes caer en la tentación.","en":"You must not yield to temptation.","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to fall"},{"g":"in / on"},{"g":"the / her"},null]}]}