{"id":"universidad","lemma":"universidad","pos":"noun","rank":595,"glosses":["university, (US) college"],"ipa":"/unibeɾsiˈdad/","gender":"f","forms":{"plural":"universidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-universidad.wav","formAudio":{"universidades":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Emanuelps27-universidades.wav"},"examples":[{"text":"Está en la universidad.","en":"He is in college.","audio":"https://tatoeba.org/en/audio/download/733928"},{"text":"El número de universidades privadas ha crecido.","en":"The number of private colleges has increased."},{"text":"¿Vas a la universidad?","en":"Do you go to college?","audio":"https://tatoeba.org/en/audio/download/103638"},{"text":"Muchos estudiantes compiten por ingresar a las mejores universidades.","en":"Many students compete to get into the best universities."},{"text":"Soy catedrático de universidad.","en":"I'm a university professor.","audio":"https://tatoeba.org/en/audio/download/422317"}]}