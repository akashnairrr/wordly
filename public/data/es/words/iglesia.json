{"id":"iglesia","lemma":"iglesia","pos":"noun","rank":681,"glosses":["church"],"ipa":"/iˈɡlesja/","gender":"f","forms":{"plural":"iglesias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q1321_%28spa%29-AdrianAbdulBaha-iglesia.wav","examples":[{"text":"¿Cuántos años tiene esa iglesia?","en":"How old is that church?","audio":"https://tatoeba.org/en/audio/download/461821","words":[{"g":"how much","l":"cuánto"},{"g":"year","l":"año"},{"g":"to have","l":"tener"},{"g":"that","l":"ese"},null]},{"text":"Mi casa está cerca de la iglesia.","en":"My house is near the church.","audio":"https://tatoeba.org/en/audio/download/582329","words":[{"g":"my"},{"g":"house"},{"g":"to be","l":"estar"},null,null,{"g":"the / her"},null],"phrases":[[3,5,"close to"]]},{"text":"Esa es una iglesia.","en":"That's a church.","audio":"https://tatoeba.org/en/audio/download/78094","words":[{"g":"that","l":"ese"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Se erigieron iglesias por toda la isla.","en":"Churches were erected all over the island.","words":[{"g":"oneself"},null,null,{"g":"for / by"},{"g":"all","l":"todo"},{"g":"the / her"},{"g":"island"}]},{"text":"Voy a la iglesia.","en":"I'm going to church.","audio":"https://tatoeba.org/en/audio/download/163191","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},null]}]}