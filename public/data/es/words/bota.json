{"id":"bota","lemma":"bota","pos":"noun","rank":1934,"glosses":["boot"],"ipa":"/ˈbota/","gender":"f","forms":{"plural":"botas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-Marreromarco-bota.wav","examples":[{"text":"Mire cuánto bota esta pelota.","en":"Look how this ball bounces.","audio":"https://tatoeba.org/en/audio/download/1103194"},{"text":"Mis botas tienen polvo.","en":"My boots are dusty.","audio":"https://tatoeba.org/en/audio/download/722256"},{"text":"Mire cuánto bota esa pelota.","en":"Look how that ball bounces."},{"text":"Nos pusimos las botas.","en":"We put on our boots.","audio":"https://tatoeba.org/en/audio/download/850401"},{"text":"¿Qué número de bota calzas?","en":"What size boots do you wear?"}]}