{"id":"corredor","lemma":"corredor","pos":"adj","rank":2525,"glosses":["running","ratite"],"ipa":"/koreˈdoɾ/","forms":{"feminine":"corredora","masculinePlural":"corredores","femininePlural":"corredoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-corredor.wav","formAudio":{"corredores":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Rub%C3%BD%C3%B1-Corredores.wav"},"examples":[{"text":"Soy el corredor más rápido.","en":"I am the fastest runner.","audio":"https://tatoeba.org/en/audio/download/1187412","words":[{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"more"},{"g":"rapid"}]},{"text":"Ella es una corredora lenta.","en":"She is a slow runner.","audio":"https://tatoeba.org/en/audio/download/453439","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"slow","l":"lento"}]},{"text":"Ella está en el corredor de la muerte.","en":"She is on death row.","audio":"https://tatoeba.org/en/audio/download/707818","words":[{"g":"she"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},null,null,null,{"g":"death"}],"phrases":[[5,7,"of the"]]},{"text":"Algunos corredores beben agua mientras corren.","en":"Some runners drink water as they are running.","audio":"https://tatoeba.org/en/audio/download/694174","words":[{"g":"someone","l":"alguno"},null,{"g":"to drink","l":"beber"},{"g":"water"},{"g":"while, whilst, as"},{"g":"to run, to jog","l":"correr"}]},{"text":"El corredor apretó en la última vuelta.","en":"The runner sprinted on the last lap.","words":[{"g":"the"},null,{"g":"to squeeze","l":"apretar"},{"g":"in / on"},{"g":"the / her"},{"g":"final","l":"último"},{"g":"turn"}]}]}