{"id":"tanto","lemma":"tanto","pos":"noun","rank":175,"glosses":["copy","poker chip; counter","point; goal (in a game)"],"ipa":"/ˈtanto/","gender":"m","forms":{"plural":"tantos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-Precision27-tanto.wav","formAudio":{"tantos":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Eavqwiki-tantos.wav"},"examples":[{"text":"No hace tanto frío.","en":"It's not that cold.","audio":"https://tatoeba.org/en/audio/download/103820"},{"text":"Han pasado tantos años.","en":"It's been so many years.","audio":"https://tatoeba.org/en/audio/download/639657"},{"text":"No te preocupes tanto.","en":"Don't worry so much.","audio":"https://tatoeba.org/en/audio/download/72107"},{"text":"¡No des tantos rodeos!","en":"Let's not beat around the bush.","audio":"https://tatoeba.org/en/audio/download/296186"},{"text":"Estaba un tanto alterado.","en":"I was kind of upset.","audio":"https://tatoeba.org/en/audio/download/630670"}]}