{"id":"esposas","lemma":"esposas","pos":"noun","rank":1809,"glosses":["handcuffs"],"ipa":"/esˈposas/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Emanuelps27-esposas.wav","examples":[{"text":"¿Cuántas esposas has tenido?","en":"How many wives have you had?","audio":"https://tatoeba.org/en/audio/download/582495"},{"text":"Tom tiene tres ex esposas.","en":"Tom has three ex-wives."},{"text":"Los sacerdotes no tienen esposas.","en":"Priests don't have wives."},{"text":"Los curas no tienen esposas.","en":"Priests don't have wives."},{"text":"Echamos realmente de menos a nuestras esposas.","en":"We really miss our wives."}]}