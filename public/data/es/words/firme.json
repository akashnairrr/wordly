{"id":"firme","lemma":"firme","pos":"adj","rank":1517,"glosses":["firm, steady, secure","steadfast, unwavering, unswerving, firm","adamant"],"ipa":"/ˈfiɾme/","forms":{"femininePlural":"firmes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Marreromarco-firme.wav","examples":[{"text":"Es mi firme intención hacer esto.","en":"It is my firm intention to do this.","audio":"https://tatoeba.org/en/audio/download/1061654","words":[{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"intention"},{"g":"to do"},{"g":"this"}]},{"text":"Firme aquí, por favor.","en":"Sign here, please.","audio":"https://tatoeba.org/en/audio/download/524832","words":[null,{"g":"here"},null,null],"phrases":[[2,4,"please"]]},{"text":"Esta mesa no está firme.","en":"This table isn't steady.","words":[{"g":"this","l":"este"},{"g":"table"},{"g":"no / not"},{"g":"to be","l":"estar"},null]},{"text":"Solo necesito que firme aquí.","en":"I just need you to sign here.","words":[{"g":"sole"},{"g":"to need","l":"necesitar"},{"g":"that"},null,{"g":"here"}]},{"text":"Creo que estoy en lo firme.","en":"I believe I'm in the right.","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"it / him"},null]}]}