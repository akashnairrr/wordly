{"id":"humo","lemma":"humo","pos":"noun","rank":1718,"glosses":["smoke","steam","fume, fumes"],"ipa":"/ˈumo/","gender":"m","forms":{"plural":"humos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1321_%28spa%29-Rodelar-humo.wav","examples":[{"text":"La habitación estaba llena de humo.","en":"The room was full of smoke.","audio":"https://tatoeba.org/en/audio/download/590179","words":[{"g":"the / her"},{"g":"room"},{"g":"to be","l":"estar"},{"g":"full","l":"lleno"},{"g":"of / from"},null]},{"text":"No hay humo sin fuego.","en":"There is no smoke without fire.","audio":"https://tatoeba.org/en/audio/download/600118","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"without"},{"g":"fire"}]},{"text":"¿De dónde viene el humo?","en":"Where's that smoke coming from?","words":[{"g":"of / from"},{"g":"where"},{"g":"to come","l":"venir"},{"g":"the"},null]},{"text":"Hice humo mi plata en muy poco tiempo.","en":"I went through my money in a very short time.","words":[{"g":"to do","l":"hacer"},null,{"g":"my"},{"g":"silver"},{"g":"in / on"},null,{"g":"little, not much"},{"g":"time"}]},{"text":"Yo huelo humo.","en":"I smell smoke.","audio":"https://tatoeba.org/en/audio/download/440518","words":[{"g":"I"},{"g":"to smell","l":"oler"},null]}]}