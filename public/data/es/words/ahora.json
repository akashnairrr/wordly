{"id":"ahora","lemma":"ahora","pos":"adv","rank":41,"glosses":["now (at the present time)","just now, just a moment ago (in the past)","very soon, in a moment (in the future)"],"ipa":"/aˈoɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-AdrianAbdulBaha-ahora.wav","examples":[{"text":"¿Ahora me crees?","en":"Do you believe me now?","audio":"https://tatoeba.org/en/audio/download/104601","words":[null,{"g":"me"},{"g":"to believe","l":"creer"}]},{"text":"¿Necesito hacerlo ahora?","en":"Do I need to do that now?","audio":"https://tatoeba.org/en/audio/download/451081","words":[{"g":"to need","l":"necesitar"},{"g":"to do","l":"hacer"},null]},{"text":"¿Tienes que hacer eso ahora?","en":"Do you have to do that now?","audio":"https://tatoeba.org/en/audio/download/506268","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to do"},{"g":"that","l":"ése"},null]},{"text":"Lo puedo hacer ahora","en":"I can do it now.","audio":"https://tatoeba.org/en/audio/download/441607","words":[{"g":"it / him"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},null]},{"text":"Ahora trabajo aquí.","en":"I work here now.","audio":"https://tatoeba.org/en/audio/download/1252865","words":[null,{"g":"work, job"},{"g":"here"}]}]}