{"id":"aprobacio_n","lemma":"aprobación","pos":"noun","rank":3290,"glosses":["approval","validation"],"ipa":"/apɾobaˈθjon/","gender":"f","forms":{"plural":"aprobaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-aprobaci%C3%B3n.wav","examples":[{"text":"Tu aprobación es importante para mí.","en":"Your approval is important to me.","audio":"https://tatoeba.org/en/audio/download/300660","words":[{"g":"your"},null,{"g":"to be","l":"ser"},{"g":"important"},null,null],"phrases":[[4,6,"in my opinion"]]},{"text":"Esto tiene mi aprobación.","en":"This has my approval.","words":[{"g":"this"},{"g":"to have","l":"tener"},{"g":"my"},null]},{"text":"No puedo dar mi aprobación a tu plan.","en":"I cannot approve your plan.","audio":"https://tatoeba.org/en/audio/download/693675","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to give, to give out"},{"g":"my"},null,{"g":"to"},{"g":"your"},{"g":"plan"}]},{"text":"¿El alojamiento contó con tu aprobación?","en":"Did the accommodations meet with your approval?","words":[{"g":"the"},{"g":"accommodation"},{"g":"to count","l":"contar"},{"g":"with"},{"g":"your"},null]},{"text":"Él me dio su sello de aprobación.","en":"He gave me his stamp of approval.","words":[{"g":"he"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"his / her / your"},{"g":"seal, sigil"},{"g":"of / from"},null]}]}