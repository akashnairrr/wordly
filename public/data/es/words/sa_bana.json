{"id":"sa_bana","lemma":"sábana","pos":"noun","rank":3251,"glosses":["sheet; bedsheet"],"ipa":"/ˈsabana/","gender":"f","forms":{"plural":"sábanas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q1321_%28spa%29-AdrianAbdulBaha-s%C3%A1bana.wav","examples":[{"text":"Ella puso sábanas en su cama.","en":"She put sheets on her bed.","words":[{"g":"she"},{"g":"to put, to place","l":"poner"},null,{"g":"in / on"},{"g":"his / her / your"},{"g":"bed"}]},{"text":"Quiero la sábana.","en":"I want the blanket.","audio":"https://tatoeba.org/en/audio/download/800405","words":[{"g":"to desire","l":"querer"},{"g":"the / her"},null]},{"text":"Lavé las sábanas.","en":"I washed the sheets.","audio":"https://tatoeba.org/en/audio/download/449587","words":[{"g":"to wash","l":"lavar"},{"g":"the / them"},null]},{"text":"Había dos sábanas sobre la cama.","en":"Two sheets were on the bed.","words":[{"g":"makes pluperfect to…"},{"g":"dung, excrement"},null,{"g":"envelope"},{"g":"the / her"},{"g":"bed"}]},{"text":"Al menos las sábanas están limpias.","en":"At least the sheets are clean.","audio":"https://tatoeba.org/en/audio/download/510164","words":[null,null,{"g":"the / them"},null,{"g":"to be","l":"estar"},{"g":"clean","l":"limpio"}],"phrases":[[0,2,"at least, at minimum"]]}]}