{"id":"necesidad","lemma":"necesidad","pos":"noun","rank":1166,"glosses":["need","necessity","neediness, state of being in need"],"ipa":"/neθesiˈdad/","gender":"f","forms":{"plural":"necesidades"},"order":1259,"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q1321_%28spa%29-Marreromarco-necesidad.wav","examples":[{"text":"No hay necesidad de preocuparse.","en":"There's no need to worry.","audio":"https://tatoeba.org/en/audio/download/522402","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"to worry","l":"preocupar"}]},{"text":"Todavía no tengo necesidad de ti.","en":"I don't need you yet.","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"you","l":"tú"}]},{"text":"No hay necesidad de llamar un taxi.","en":"There's no need to hail a taxi.","audio":"https://tatoeba.org/en/audio/download/804553","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"to summon, to call"},{"g":"a"},{"g":"taxi"}]}]}