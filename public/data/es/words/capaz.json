{"id":"capaz","lemma":"capaz","pos":"adv","rank":617,"glosses":["maybe, perhaps"],"ipa":"/kaˈpaθ/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q1321_%28spa%29-AdrianAbdulBaha-capaz.wav","examples":[{"text":"¿Eres capaz de resolverlo?","en":"Can you solve it?","audio":"https://tatoeba.org/en/audio/download/721589"},{"text":"No soy capaz de hacerlo.","en":"I can't do it.","audio":"https://tatoeba.org/en/audio/download/611363"},{"text":"Ojalá fuera capaz de nadar.","en":"I wish I could swim.","audio":"https://tatoeba.org/en/audio/download/50257"},{"text":"Pienso que él es capaz.","en":"I think he's competent.","audio":"https://tatoeba.org/en/audio/download/459826"},{"text":"Yo era capaz de ayudarla.","en":"I was able to help her.","audio":"https://tatoeba.org/en/audio/download/458643"}]}