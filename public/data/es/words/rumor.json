{"id":"rumor","lemma":"rumor","pos":"noun","rank":1895,"glosses":["rumor","murmur"],"ipa":"/ruˈmoɾ/","gender":"m","forms":{"plural":"rumores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d7/LL-Q1321_%28spa%29-Marreromarco-rumor.wav","examples":[{"text":"Era sólo un rumor.","en":"It was only a rumor.","audio":"https://tatoeba.org/en/audio/download/630101"},{"text":"Los rumores eran falsos.","en":"The rumors were false.","audio":"https://tatoeba.org/en/audio/download/460583"},{"text":"Oí un rumor interesante.","en":"I heard an interesting rumor.","audio":"https://tatoeba.org/en/audio/download/735799"},{"text":"Los rumores se extendieron rápidamente.","en":"The rumors spread quickly.","audio":"https://tatoeba.org/en/audio/download/587225"},{"text":"El rumor no es cierto.","en":"The rumor isn't true.","audio":"https://tatoeba.org/en/audio/download/38896"}]}