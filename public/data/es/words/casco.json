{"id":"casco","lemma":"casco","pos":"noun","rank":2404,"glosses":["helmet","crown (top part of a hat)","hulk (unused ship)"],"ipa":"/ˈkasko/","gender":"m","forms":{"plural":"cascos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-casco.wav","examples":[{"text":"Tienes mi casco.","en":"You've got my helmet.","audio":"https://tatoeba.org/en/audio/download/454628","words":[{"g":"to have","l":"tener"},{"g":"my"},null]},{"text":"Ponte los cascos y escucha esto.","en":"Put on your headphones and listen to this.","words":[{"g":"to put, to place","l":"poner"},{"g":"the / them"},null,{"g":"and"},{"g":"listening"},{"g":"this"}]},{"text":"¿Ambos llevaban casco?","en":"Were both of them wearing helmets?","words":[{"g":"both"},{"g":"to take somewhere","l":"llevar"},null]},{"text":"Una bala perforó el casco.","en":"A bullet pierced the helmet.","words":[{"g":"a"},{"g":"bullet"},{"g":"to puncture","l":"perforar"},{"g":"the"},null]},{"text":"Los soldados llevaban cascos de acero.","en":"The soldiers were wearing steel helmets.","words":[{"g":"the / them"},{"g":"soldier","l":"soldado"},{"g":"to take somewhere","l":"llevar"},null,null,null],"phrases":[[4,6,"steely"]]}]}