{"id":"grado","lemma":"grado","pos":"noun","rank":1541,"glosses":["degree","grade","level"],"ipa":"/ˈɡɾado/","gender":"m","forms":{"plural":"grados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/08/LL-Q1321_%28spa%29-Marreromarco-grado.wav","examples":[{"text":"¿En qué grado estás?","en":"What grade are you in?","audio":"https://tatoeba.org/en/audio/download/461621"},{"text":"Hace treinta grados bajo cero.","en":"It's thirty degrees below zero.","audio":"https://tatoeba.org/en/audio/download/599210"},{"text":"Tom tiene un grado en biología.","en":"Tom has a degree in biology.","audio":"https://tatoeba.org/en/audio/download/296583"},{"text":"Un ángulo recto tiene 90 grados.","en":"A right angle has ninety degrees.","audio":"https://tatoeba.org/en/audio/download/34702"},{"text":"Existe un grado de estrés en todos los trabajos.","en":"There's a degree of stress in every job.","audio":"https://tatoeba.org/en/audio/download/688991"}]}