{"id":"semana","lemma":"semana","pos":"noun","rank":241,"glosses":["week (7 days)"],"ipa":"/seˈmana/","gender":"f","forms":{"plural":"semanas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-Precision27-semana.wav","formAudio":{"semanas":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q1321_%28spa%29-GlyphEnjoyer-semanas.wav"},"examples":[{"text":"La semana se acabó.","en":"The week is over.","audio":"https://tatoeba.org/en/audio/download/444344"},{"text":"Lo hacen todas las semanas.","en":"They do it each week.","audio":"https://tatoeba.org/en/audio/download/637066"},{"text":"¡Qué semana más larga!","en":"What a long week!","audio":"https://tatoeba.org/en/audio/download/636991"},{"text":"Los veré en tres semanas.","en":"See you in three weeks.","audio":"https://tatoeba.org/en/audio/download/460685"},{"text":"¿Cómo estuvo tu semana?","en":"How was your week?","audio":"https://tatoeba.org/en/audio/download/443681"}]}