{"id":"misio_n","lemma":"misión","pos":"noun","rank":718,"glosses":["mission, quest","mission, task, assignment","mission"],"ipa":"/miˈsjon/","gender":"f","forms":{"plural":"misiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-Marreromarco-misi%C3%B3n.wav","examples":[{"text":"Esta es mi misión.","en":"This is my mission.","audio":"https://tatoeba.org/en/audio/download/799441"},{"text":"La misión era simple.","en":"The mission was simple.","audio":"https://tatoeba.org/en/audio/download/523272"},{"text":"Tom completó la misión.","en":"Tom completed the mission.","audio":"https://tatoeba.org/en/audio/download/65240"},{"text":"Tom está en una misión.","en":"Tom is on a mission.","audio":"https://tatoeba.org/en/audio/download/799123"},{"text":"La misión fue un fracaso.","en":"The mission was unsuccessful.","audio":"https://tatoeba.org/en/audio/download/804410"}]}