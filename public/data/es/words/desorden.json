{"id":"desorden","lemma":"desorden","pos":"noun","rank":2873,"glosses":["disorder","untidiness"],"ipa":"/desˈoɾden/","gender":"m","forms":{"plural":"desórdenes"},"order":2878,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-Marreromarco-desorden.wav","examples":[{"text":"Lamento el desorden.","en":"I'm sorry for the mess.","audio":"https://tatoeba.org/en/audio/download/80172","words":[{"g":"lament"},{"g":"the"},null]},{"text":"Limpia el desorden que hiciste.","en":"Clean up the mess you've made.","words":[{"g":"cleansing, cleaning"},{"g":"the"},null,{"g":"that"},{"g":"to do","l":"hacer"}]},{"text":"Él me ayudó a limpiar el desorden.","en":"He helped me clean up the mess.","words":[{"g":"he"},{"g":"me"},{"g":"to help","l":"ayudar"},{"g":"to"},{"g":"to clean"},{"g":"the"},null]}]}