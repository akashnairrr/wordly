{"id":"acabado","lemma":"acabado","pos":"adj","rank":844,"glosses":["worn-out","finished","moneyless; out of money; having no (or very little) money; poor"],"ipa":"/akaˈbado/","forms":{"feminine":"acabada","masculinePlural":"acabados","femininePlural":"acabadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q1321_%28spa%29-Marreromarco-acabado.wav","examples":[{"text":"¿Te has acabado este libro?","en":"Are you through with this book?","audio":"https://tatoeba.org/en/audio/download/645646","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"this"},{"g":"book"}]},{"text":"Mi vida está casi acabada.","en":"My life is almost over.","audio":"https://tatoeba.org/en/audio/download/845607","words":[null,null,{"g":"to be","l":"estar"},{"g":"almost"},null],"phrases":[[0,2,"my honey, my love"]]},{"text":"Se nos ha acabado el dinero.","en":"We're out of money.","audio":"https://tatoeba.org/en/audio/download/107701","words":[{"g":"oneself"},{"g":"us"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"money"}]},{"text":"Se me ha acabado la paciencia.","en":"I have no more patience.","audio":"https://tatoeba.org/en/audio/download/459346","words":[{"g":"oneself"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"patience, forbearance"}]},{"text":"Me he acabado el libro.","en":"I've finished reading the book.","audio":"https://tatoeba.org/en/audio/download/551747","words":[{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"book"}]}]}