{"id":"callejo_n","lemma":"callejón","pos":"noun","rank":2288,"glosses":["alley, side street","blind alley"],"ipa":"/kaʝeˈxon/","gender":"m","forms":{"plural":"callejones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-Marreromarco-callej%C3%B3n.wav","examples":[{"text":"Está derecho por este callejón.","en":"It is right up his alley.","words":[{"g":"to be","l":"estar"},{"g":"right"},{"g":"for / by"},{"g":"this"},null]},{"text":"Es un callejón sin salida.","en":"It's a dead end.","audio":"https://tatoeba.org/en/audio/download/441840","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"without"},{"g":"exit, way out"}]},{"text":"El ladrón la atacó en un callejón.","en":"The robber attacked her on a back street.","words":[{"g":"the"},{"g":"thief"},{"g":"the / her"},{"g":"to attack, to come at","l":"atacar"},{"g":"in / on"},{"g":"a"},null]},{"text":"Estamos en un callejón sin salida.","en":"We're in a blind alley.","words":[{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"a"},null,{"g":"without"},{"g":"exit, way out"}]},{"text":"Este es un callejón sin salida.","en":"This is a dead-end alley.","words":[{"g":"this"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"without"},{"g":"exit, way out"}]}]}