{"id":"toque","lemma":"toque","pos":"noun","rank":1289,"glosses":["a touch","a strum","a toll (musical sound used to announce something)"],"ipa":"/ˈtoke/","gender":"m","forms":{"plural":"toques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-AdrianAbdulBaha-toque.wav","examples":[{"text":"¿Hay toque de queda?","en":"Is there a curfew?","audio":"https://tatoeba.org/en/audio/download/444433"},{"text":"No toques mi auto.","en":"Don't touch my car.","audio":"https://tatoeba.org/en/audio/download/450617"},{"text":"No toque las flores.","en":"Don't touch the flowers.","audio":"https://tatoeba.org/en/audio/download/459742"},{"text":"No toques mi bicicleta.","en":"Don't touch my bike.","audio":"https://tatoeba.org/en/audio/download/449834"},{"text":"No toque la pintura fresca.","en":"Don't touch the wet paint.","audio":"https://tatoeba.org/en/audio/download/594267"}]}