{"id":"centro","lemma":"centro","pos":"noun","rank":564,"glosses":["center","center, moderate tendencies or ideas","middle"],"ipa":"/ˈθentɾo/","gender":"m","forms":{"plural":"centros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-centro.wav","examples":[{"text":"Quiero ir al centro.","en":"I want to go to town.","audio":"https://tatoeba.org/en/audio/download/454809"},{"text":"Yo no me como los centros de las manzanas.","en":"I don't eat apple cores.","audio":"https://tatoeba.org/en/audio/download/458602"},{"text":"El centro comercial está desierto.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/453931"},{"text":"Se construyeron nuevas fábricas y centros industiales.","en":"New factories and industrial centers were built."},{"text":"Tengo que ir al centro.","en":"I need to go into town.","audio":"https://tatoeba.org/en/audio/download/459101"}]}