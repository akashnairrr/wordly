{"id":"centro","lemma":"centro","pos":"noun","rank":561,"glosses":["center","center, moderate tendencies or ideas","middle"],"ipa":"/ˈθentɾo/","gender":"m","forms":{"plural":"centros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-centro.wav","examples":[{"text":"Vivimos en el centro de la ciudad.","en":"We live in the center of the city.","audio":"https://tatoeba.org/en/audio/download/594617","words":[{"g":"to live","l":"vivir"},{"g":"in / on"},{"g":"the"},null,null,null,{"g":"city"}],"phrases":[[4,6,"of the"]]},{"text":"Su oficina queda en el centro.","en":"His office is located in the center of the town.","words":[{"g":"his / her / your"},{"g":"office"},{"g":"curfew"},{"g":"in / on"},{"g":"the"},null]},{"text":"Él necesita ser el centro de atención.","en":"He needs to be the center of attention.","words":[{"g":"he"},{"g":"to need","l":"necesitar"},{"g":"to be"},{"g":"the"},null,{"g":"of / from"},{"g":"attention"}]},{"text":"Vamos al centro.","en":"Let's go downtown.","audio":"https://tatoeba.org/en/audio/download/443866","words":[{"g":"to go","l":"ir"},{"g":"to the"},null]},{"text":"Quiero ir al centro.","en":"I want to go to town.","audio":"https://tatoeba.org/en/audio/download/454809","words":[{"g":"to desire","l":"querer"},{"g":"to go"},{"g":"to the"},null]}]}