{"id":"corazo_n","lemma":"corazón","pos":"noun","rank":262,"glosses":["heart (organ of the body)","heart, emotions, kindness, spirit","core (of a fruit)"],"ipa":"/koɾaˈθon/","gender":"m","forms":{"plural":"corazones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1321_%28spa%29-Rodelar-coraz%C3%B3n.wav","formAudio":{"corazones":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Eavqwiki-corazones.wav"},"examples":[{"text":"Me duele el corazón.","en":"My heart aches.","audio":"https://tatoeba.org/en/audio/download/501199"},{"text":"Tengo el as de corazones.","en":"I have the ace of hearts.","audio":"https://tatoeba.org/en/audio/download/515939"},{"text":"Haz de tripas corazón.","en":"Bite the bullet.","audio":"https://tatoeba.org/en/audio/download/301179"},{"text":"Siempre estará en nuestros corazones.","en":"He will forever be in our hearts.","audio":"https://tatoeba.org/en/audio/download/684478"},{"text":"Me arde el corazón.","en":"My heart's aching.","audio":"https://tatoeba.org/en/audio/download/800313"}]}