{"id":"corazo_n","lemma":"corazón","pos":"noun","rank":259,"glosses":["heart (organ of the body)","heart, emotions, kindness, spirit","core (of a fruit)"],"ipa":"/koɾaˈθon/","gender":"m","forms":{"plural":"corazones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1321_%28spa%29-Rodelar-coraz%C3%B3n.wav","formAudio":{"corazones":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Eavqwiki-corazones.wav"},"examples":[{"text":"No tienes corazón.","en":"You have no heart.","audio":"https://tatoeba.org/en/audio/download/636598","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Lo sé con mi corazón.","en":"I know it in my heart.","audio":"https://tatoeba.org/en/audio/download/454482","words":[{"g":"it / him"},{"g":"to know, to understand","l":"saber"},{"g":"with"},{"g":"my"},null]},{"text":"Es malo para el corazón.","en":"It's bad for the heart.","audio":"https://tatoeba.org/en/audio/download/554632","words":[{"g":"to be","l":"ser"},{"g":"bad"},{"g":"for"},{"g":"the"},null]},{"text":"Escucha a tu corazón.","en":"Listen to your heart.","audio":"https://tatoeba.org/en/audio/download/454562","words":[{"g":"listening"},{"g":"to"},{"g":"your"},null]},{"text":"Ella tiene un buen corazón.","en":"She has a good heart.","audio":"https://tatoeba.org/en/audio/download/522203","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"a"},null,null]}]}