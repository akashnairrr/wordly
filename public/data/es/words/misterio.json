{"id":"misterio","lemma":"misterio","pos":"noun","rank":1731,"glosses":["mystery, mysteriousness","crib, nativity scene","mystery, event in Jesus' life"],"ipa":"/misˈteɾjo/","gender":"m","forms":{"plural":"misterios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Marreromarco-misterio.wav","examples":[{"text":"He resuelto el misterio.","en":"I solved the mystery.","audio":"https://tatoeba.org/en/audio/download/454845"},{"text":"Nos encantan los misterios.","en":"We love mysteries.","audio":"https://tatoeba.org/en/audio/download/135894"},{"text":"¿Puedes resolver el misterio?","en":"Can you solve the puzzle?","audio":"https://tatoeba.org/en/audio/download/804238"},{"text":"La vida está llena de misterios.","en":"Life is full of mysteries."},{"text":"Eso sigue siendo un misterio.","en":"That remains a mystery.","audio":"https://tatoeba.org/en/audio/download/461267"}]}