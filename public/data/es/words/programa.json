{"id":"programa","lemma":"programa","pos":"noun","rank":589,"glosses":["programme, program","show, programme","program"],"ipa":"/pɾoˈɡɾama/","gender":"m","forms":{"plural":"programas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dd/LL-Q1321_%28spa%29-AdrianAbdulBaha-programa.wav","examples":[{"text":"Éste es nuestro programa.","en":"This is our agenda.","audio":"https://tatoeba.org/en/audio/download/765609"},{"text":"Solía escuchar programas en inglés.","en":"I used to listen to English programs."},{"text":"No veo ese programa.","en":"I don't watch that show.","audio":"https://tatoeba.org/en/audio/download/459910"},{"text":"¿Qué programas ves en la tele?","en":"What programs do you watch on TV?"},{"text":"¿Quieres ver este programa?","en":"Do you want to watch this program?","audio":"https://tatoeba.org/en/audio/download/735652"}]}