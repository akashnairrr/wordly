{"id":"dolor","lemma":"dolor","pos":"noun","rank":503,"glosses":["pain, ache, aching soreness, tenderness (physical)","grief","sorrow, hurt, pain, suffering (emotional, mental)"],"ipa":"/doˈloɾ/","gender":"m","forms":{"plural":"dolores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-AdrianAbdulBaha-dolor.wav","formAudio":{"dolores":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Emanuelps27-dolores.wav"},"examples":[{"text":"Tengo dolor de espalda.","en":"I have a backache.","audio":"https://tatoeba.org/en/audio/download/444082"},{"text":"Tengo unos dolores terribles.","en":"I have a terrible pain.","audio":"https://tatoeba.org/en/audio/download/458975"},{"text":"El dolor ha desaparecido.","en":"The pain has gone.","audio":"https://tatoeba.org/en/audio/download/525599"},{"text":"Mi madre sufre dolores de cabeza a menudo.","en":"My mother often suffers from headaches.","audio":"https://tatoeba.org/en/audio/download/635204"},{"text":"Tengo dolor de garganta.","en":"I have a sore throat.","audio":"https://tatoeba.org/en/audio/download/519640"}]}