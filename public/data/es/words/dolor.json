{"id":"dolor","lemma":"dolor","pos":"noun","rank":500,"glosses":["pain, ache, aching soreness, tenderness (physical)","grief","sorrow, hurt, pain, suffering (emotional, mental)"],"ipa":"/doˈloɾ/","gender":"m","forms":{"plural":"dolores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-AdrianAbdulBaha-dolor.wav","formAudio":{"dolores":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Emanuelps27-dolores.wav"},"examples":[{"text":"Tengo un fuerte dolor aquí.","en":"I have a bad pain here.","audio":"https://tatoeba.org/en/audio/download/458991","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"strong"},null,{"g":"here"}]},{"text":"Tengo un dolor en mi cuello.","en":"I have a pain in my neck.","audio":"https://tatoeba.org/en/audio/download/599172","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"in / on"},{"g":"my"},{"g":"neck"}]},{"text":"¿Sientes algún dolor en tu estómago?","en":"Do you feel any pain in your stomach?","audio":"https://tatoeba.org/en/audio/download/506264","words":[{"g":"to seat","l":"sentar"},null,null,{"g":"in / on"},{"g":"your"},{"g":"stomach"}]},{"text":"Tengo unos dolores terribles.","en":"I have a terrible pain.","audio":"https://tatoeba.org/en/audio/download/458975","words":[{"g":"to have","l":"tener"},{"g":"about, approximately"},null,{"g":"terrible","l":"terrible"}]},{"text":"El dolor era terrible.","en":"The pain was terrible.","audio":"https://tatoeba.org/en/audio/download/461345","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"terrible"}]}]}