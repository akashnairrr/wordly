{"id":"dolor","lemma":"dolor","pos":"noun","rank":500,"glosses":["pain, ache, aching soreness, tenderness (physical)","grief","sorrow, hurt, pain, suffering (emotional, mental)"],"ipa":"/doˈloɾ/","gender":"m","forms":{"plural":"dolores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-AdrianAbdulBaha-dolor.wav","formAudio":{"dolores":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Emanuelps27-dolores.wav"},"examples":[{"text":"¿El dolor te despierta por las noches?","en":"Does the pain wake you up at night?","audio":"https://tatoeba.org/en/audio/download/1155858","words":[{"g":"the"},null,{"g":"you"},{"g":"awake","l":"despierto"},{"g":"for / by"},{"g":"the / them"},{"g":"night","l":"noche"}]},{"text":"¿Sientes algún dolor en tu estómago?","en":"Do you feel any pain in your stomach?","audio":"https://tatoeba.org/en/audio/download/506264","words":[{"g":"to seat","l":"sentar"},null,null,{"g":"in / on"},{"g":"your"},{"g":"stomach"}]},{"text":"Tom a menudo tiene dolores de cabeza.","en":"Tom often has headaches.","words":[null,null,null,{"g":"to have","l":"tener"},null,null,null],"phrases":[[1,3,"often, oftentimes"],[5,7,"upside down"]]},{"text":"Mi dolor de cabeza se ha ido.","en":"My headache is gone.","audio":"https://tatoeba.org/en/audio/download/450189","words":[{"g":"my"},null,null,null,{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"away with the fairies"}],"phrases":[[2,4,"upside down"]]},{"text":"Tengo dolores en el pecho.","en":"I have a pain in my chest.","words":[{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"the"},{"g":"thorax"}]}]}