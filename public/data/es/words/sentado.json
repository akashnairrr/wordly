{"id":"sentado","lemma":"sentado","pos":"adj","rank":1022,"glosses":["seated","settled, established","sensible, solid"],"ipa":"/senˈtado/","forms":{"feminine":"sentada","masculinePlural":"sentados","femininePlural":"sentadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-Emanuelps27-sentado.wav","examples":[{"text":"No hay nadie sentado aquí.","en":"There's no one sitting here.","audio":"https://tatoeba.org/en/audio/download/615934","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"no one"},null,{"g":"here"}]},{"text":"Alguien está sentado allí.","en":"Someone is sitting there.","audio":"https://tatoeba.org/en/audio/download/559299","words":[{"g":"someone, somebody"},{"g":"to be","l":"estar"},null,{"g":"there"}]},{"text":"¿Por qué estamos aquí sentados?","en":"Why are we sitting here?","audio":"https://tatoeba.org/en/audio/download/199518","words":[null,null,{"g":"to be","l":"estar"},{"g":"here"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Él estaba sentado en el suelo.","en":"He was sitting on the floor.","audio":"https://tatoeba.org/en/audio/download/330627","words":[{"g":"he"},{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"the"},{"g":"dirt"}]},{"text":"Estaban sentados alrededor de la mesa.","en":"They were sitting around the table.","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"the / her"},{"g":"table"}],"phrases":[[2,4,"around, approximately"]]}]}