{"id":"sentado","lemma":"sentado","pos":"adj","rank":1025,"glosses":["seated","settled, established","sensible, solid"],"ipa":"/senˈtado/","forms":{"feminine":"sentada","masculinePlural":"sentados","femininePlural":"sentadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-Emanuelps27-sentado.wav","examples":[{"text":"Tom estaba sentado leyendo.","en":"Tom sat reading.","audio":"https://tatoeba.org/en/audio/download/799599"},{"text":"Quédate sentada, por favor.","en":"Remain seated, please.","audio":"https://tatoeba.org/en/audio/download/75831"},{"text":"Quédense sentados, por favor.","en":"Please remain seated.","audio":"https://tatoeba.org/en/audio/download/459475"},{"text":"Quedaos sentadas, por favor.","en":"Remain seated, please.","audio":"https://tatoeba.org/en/audio/download/75830"},{"text":"Tom todavía está sentado.","en":"Tom is still sitting.","audio":"https://tatoeba.org/en/audio/download/140142"}]}