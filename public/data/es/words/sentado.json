{"id":"sentado","lemma":"sentado","pos":"adj","rank":1022,"glosses":["seated","settled, established","sensible, solid"],"ipa":"/senˈtado/","forms":{"feminine":"sentada","masculinePlural":"sentados","femininePlural":"sentadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-Emanuelps27-sentado.wav","examples":[{"text":"Estoy sentado solo en mi casa.","en":"I'm sitting alone in my house.","audio":"https://tatoeba.org/en/audio/download/518865","words":[{"g":"to be","l":"estar"},null,{"g":"sole"},{"g":"in / on"},{"g":"my"},{"g":"house"}]},{"text":"¿Por qué estamos aquí sentados?","en":"Why are we sitting here?","audio":"https://tatoeba.org/en/audio/download/199518","words":[null,null,{"g":"to be","l":"estar"},{"g":"here"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"¿Cuánto tiempo llevas ahí sentado?","en":"How long have you been sitting there?","audio":"https://tatoeba.org/en/audio/download/559977","words":[null,null,{"g":"to take somewhere","l":"llevar"},{"g":"there"},null],"phrases":[[0,2,"how long"]]},{"text":"¿Quién estaba sentado delante de usted en el cine?","en":"Who was that sitting in front of you at the movies?","audio":"https://tatoeba.org/en/audio/download/693982","words":[{"g":"who"},{"g":"to be","l":"estar"},null,null,null,{"g":"you (formal)"},{"g":"in / on"},{"g":"the"},{"g":"cinema, moviehouse"}],"phrases":[[3,5,"in front of"]]},{"text":"Dos niños están sentados sobre la cerca.","en":"Two children are sitting on the fence.","audio":"https://tatoeba.org/en/audio/download/598498","words":[{"g":"dung, excrement"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"estar"},null,{"g":"envelope"},{"g":"the / her"},{"g":"close"}]}]}