{"id":"obra","lemma":"obra","pos":"noun","rank":830,"glosses":["work (usually literary or artistic)","construction"],"ipa":"/ˈobɾa/","gender":"f","forms":{"plural":"obras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-Marreromarco-obra.wav","examples":[{"text":"Esta obra ha concluido.","en":"This play has ended.","audio":"https://tatoeba.org/en/audio/download/734382"},{"text":"¿Sueles ir a ver obras de teatro?","en":"Do you often go to see plays?","audio":"https://tatoeba.org/en/audio/download/553876"},{"text":"Es una obra maestra.","en":"This is a masterpiece.","audio":"https://tatoeba.org/en/audio/download/735924"},{"text":"¿Soléis ir a ver obras de teatro?","en":"Do you often go to see plays?","audio":"https://tatoeba.org/en/audio/download/553878"},{"text":"Dimos fin a la obra.","en":"We finished the work.","audio":"https://tatoeba.org/en/audio/download/501302"}]}