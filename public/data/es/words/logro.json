{"id":"logro","lemma":"logro","pos":"noun","rank":2614,"glosses":["attainment, achievement, accomplishment, success","achievement"],"ipa":"/ˈloɡɾo/","gender":"m","forms":{"plural":"logros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-Haylli-logro.wav","examples":[{"text":"No logro dormir bien.","en":"I can't sleep well.","audio":"https://tatoeba.org/en/audio/download/70016","words":[{"g":"no / not"},null,{"g":"to sleep"},{"g":"well"}]},{"text":"No logro pensar en otra cosa.","en":"I can't think about anything else.","audio":"https://tatoeba.org/en/audio/download/352750","words":[{"g":"no / not"},null,{"g":"to think, ponder"},{"g":"in / on"},{"g":"someone else","l":"otro"},{"g":"thing"}]},{"text":"No logro abrir la puerta.","en":"I can't open the door.","audio":"https://tatoeba.org/en/audio/download/454842","words":[{"g":"no / not"},null,null,null,null],"phrases":[[2,5,"to open the door"]]},{"text":"Sus logros hablan por sí solos.","en":"His accomplishments speak for themselves.","words":[{"g":"his, her, its, their"},null,{"g":"to talk","l":"hablar"},{"g":"for / by"},{"g":"yes"},{"g":"sole","l":"solo"}]},{"text":"No logro ver el motivo.","en":"I fail to see the reason.","audio":"https://tatoeba.org/en/audio/download/515231","words":[{"g":"no / not"},null,{"g":"to see, to spot"},{"g":"the"},{"g":"reason, ground, motive"}]}]}