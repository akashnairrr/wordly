{"id":"billete","lemma":"billete","pos":"noun","rank":2240,"glosses":["banknote, bill (paper currency)","ticket","billet"],"ipa":"/biˈʝete/","gender":"m","forms":{"plural":"billetes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-AdrianAbdulBaha-billete.wav","examples":[{"text":"No sé cómo comprar un billete.","en":"I don't know how to buy a ticket.","audio":"https://tatoeba.org/en/audio/download/353477","words":[null,null,{"g":"how"},{"g":"to buy"},{"g":"a"},null],"phrases":[[0,2,"I don't know"]]},{"text":"¿Quiere usted billetes pequeños o grandes?","en":"Would you like big bills or small bills?","audio":"https://tatoeba.org/en/audio/download/599986","words":[{"g":"to desire","l":"querer"},{"g":"you (formal)"},null,{"g":"small","l":"pequeño"},{"g":"or"},{"g":"big, large","l":"grande"}]},{"text":"Sé que es mi billete.","en":"I know that's my ticket.","audio":"https://tatoeba.org/en/audio/download/540715","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Solo tengo dos billetes de avión.","en":"I only have two plane tickets.","audio":"https://tatoeba.org/en/audio/download/806472","words":[{"g":"sole"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null,{"g":"of / from"},{"g":"aeroplane"}]},{"text":"He perdido mi billete.","en":"I've lost my ticket.","audio":"https://tatoeba.org/en/audio/download/81978","words":[{"g":"to have","l":"haber"},{"g":"lost"},{"g":"my"},null]}]}