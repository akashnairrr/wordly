{"id":"impuesto","lemma":"impuesto","pos":"noun","rank":1759,"glosses":["impost","tax, levy (money paid to the government)"],"ipa":"/imˈpwesto/","gender":"m","forms":{"plural":"impuestos"},"order":1802,"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Marreromarco-impuesto.wav","examples":[{"text":"Tienes que pagar impuestos.","en":"You have to pay taxes.","audio":"https://tatoeba.org/en/audio/download/458987","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to pay"},null]},{"text":"Yo pago mis impuestos.","en":"I pay my taxes.","audio":"https://tatoeba.org/en/audio/download/800213","words":[{"g":"I"},{"g":"pay, payment"},{"g":"my"},null]},{"text":"Lamento haberte impuesto tanto.","en":"I am sorry I have imposed so much on you.","words":[{"g":"lament"},{"g":"to have","l":"haber"},null,{"g":"copy"}]}]}