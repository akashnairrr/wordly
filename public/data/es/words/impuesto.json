{"id":"impuesto","lemma":"impuesto","pos":"noun","rank":1761,"glosses":["impost","tax, levy (money paid to the government)"],"ipa":"/imˈpwesto/","gender":"m","forms":{"plural":"impuestos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Marreromarco-impuesto.wav","examples":[{"text":"Se impuso un impuesto especial a los coches importados.","en":"A special tax was imposed on imported cars.","audio":"https://tatoeba.org/en/audio/download/693144"},{"text":"Yo pago mis impuestos.","en":"I pay my taxes.","audio":"https://tatoeba.org/en/audio/download/800213"},{"text":"Lamento haberte impuesto tanto.","en":"I am sorry I have imposed so much on you."},{"text":"Tenemos que pagar impuestos.","en":"We must pay taxes.","audio":"https://tatoeba.org/en/audio/download/104060"},{"text":"¿Hay algún impuesto sobre esto?","en":"Is there any tax on this?"}]}