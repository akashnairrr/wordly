{"id":"emocio_n","lemma":"emoción","pos":"noun","rank":1991,"glosses":["emotion (person's internal state of being)","excitement"],"ipa":"/emoˈθjon/","gender":"f","forms":{"plural":"emociones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-Marreromarco-emoci%C3%B3n.wav","examples":[{"text":"Con toda la emoción, olvidé comer.","en":"In all the excitement, I forgot to eat.","audio":"https://tatoeba.org/en/audio/download/585928"},{"text":"¡No te emociones tanto!","en":"Don't get so excited!","audio":"https://tatoeba.org/en/audio/download/455447"},{"text":"De toda la emoción, olvidé comer.","en":"In all the excitement, I forgot to eat.","audio":"https://tatoeba.org/en/audio/download/585929"},{"text":"No muestre sus emociones.","en":"Don't let your feelings show.","audio":"https://tatoeba.org/en/audio/download/524379"},{"text":"Al juego le faltó emoción.","en":"The game lacked excitement."}]}