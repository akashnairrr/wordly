{"id":"bastante","lemma":"bastante","pos":"adv","rank":277,"glosses":["quite, rather, pretty, fairly","enough; sufficiently","quite a bit; to a considerable degree"],"ipa":"/basˈtante/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q1321_%28spa%29-Marreromarco-bastante.wav","examples":[{"text":"Es un número bastante grande.","en":"It is quite a big number.","audio":"https://tatoeba.org/en/audio/download/1190517","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"number"},null,{"g":"big, large"}]},{"text":"Esta casa es bastante pequeña.","en":"This house is quite small.","audio":"https://tatoeba.org/en/audio/download/68460","words":[{"g":"this","l":"este"},{"g":"house"},{"g":"to be","l":"ser"},null,{"g":"small","l":"pequeño"}]},{"text":"Esto es bastante bueno.","en":"This is quite good.","audio":"https://tatoeba.org/en/audio/download/501432","words":[{"g":"this"},{"g":"to be","l":"ser"},null,{"g":"good"}]},{"text":"Eso suena bastante tonto.","en":"That just sounds stupid.","audio":"https://tatoeba.org/en/audio/download/611785","words":[{"g":"that","l":"ése"},{"g":"to sound, to ring","l":"sonar"},null,{"g":"stupid"}]},{"text":"Eres bastante listo.","en":"You're quite smart.","audio":"https://tatoeba.org/en/audio/download/448724","words":[{"g":"to be","l":"ser"},null,{"g":"clever, smart"}]}]}