{"id":"fuerza","lemma":"fuerza","pos":"noun","rank":496,"glosses":["force","strength"],"ipa":"/ˈfweɾθa/","gender":"f","forms":{"plural":"fuerzas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-AdrianAbdulBaha-fuerza.wav","formAudio":{"fuerzas":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Precision27-fuerzas.wav"},"examples":[{"text":"Perdí mi fuerza.","en":"I've lost my strength.","audio":"https://tatoeba.org/en/audio/download/453730","words":[{"g":"to lose","l":"perder"},{"g":"my"},null]},{"text":"No me quedan fuerzas.","en":"I don't have any energy left.","audio":"https://tatoeba.org/en/audio/download/567479","words":[{"g":"no / not"},{"g":"me"},{"g":"to be , to end up","l":"quedar"},null]},{"text":"Yo no tengo tu fuerza.","en":"I don't have your strength.","audio":"https://tatoeba.org/en/audio/download/552058","words":[{"g":"I"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"your"},null]},{"text":"Esto me da fuerzas para continuar.","en":"This gives me the strength to go on.","audio":"https://tatoeba.org/en/audio/download/788422","words":[{"g":"this"},{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"for"},{"g":"to continue"}]},{"text":"Fuerza la puerta.","en":"Kick the door in.","audio":"https://tatoeba.org/en/audio/download/442811","words":[null,{"g":"the / her"},{"g":"door"}]}]}