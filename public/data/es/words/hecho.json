{"id":"hecho","lemma":"hecho","pos":"adj","rank":108,"glosses":["done, completed","made"],"ipa":"/ˈet͡ʃo/","forms":{"feminine":"hecha","masculinePlural":"hechos","femininePlural":"hechas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-AdrianAbdulBaha-hecho.wav","examples":[{"text":"Tom está hecho polvo.","en":"Tom's flaky.","audio":"https://tatoeba.org/en/audio/download/302208"},{"text":"Toda mi tarea está hecha.","en":"All my homework is done.","audio":"https://tatoeba.org/en/audio/download/459053"},{"text":"Quiero conocer los hechos.","en":"I want to know the facts.","audio":"https://tatoeba.org/en/audio/download/531904"},{"text":"¿De qué están hechas?","en":"What are they made of?","audio":"https://tatoeba.org/en/audio/download/78213"},{"text":"¿Quién ha hecho esto?","en":"Who did this?","audio":"https://tatoeba.org/en/audio/download/534685"}]}