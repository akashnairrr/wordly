{"id":"granjero","lemma":"granjero","pos":"noun","rank":3515,"glosses":["farmer"],"ipa":"/ɡɾanˈxeɾo/","gender":"m","forms":{"plural":"granjeros","feminine":"granjera","femininePlural":"granjeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/92/LL-Q1321_%28spa%29-Marreromarco-granjero.wav","examples":[{"text":"Soy un granjero.","en":"I'm a farmer.","audio":"https://tatoeba.org/en/audio/download/438122","words":[{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Sus padres eran granjeros.","en":"His parents were farmers.","audio":"https://tatoeba.org/en/audio/download/35043","words":[{"g":"his, her, its, their"},{"g":"father, parent","l":"padre"},{"g":"to be","l":"ser"},null]},{"text":"Mi abuela era granjera.","en":"My grandmother was a farmer.","audio":"https://tatoeba.org/en/audio/download/330757","words":[{"g":"my"},{"g":"grandmother"},{"g":"to be","l":"ser"},null]},{"text":"Él quería ser un granjero.","en":"He wanted to be a farmer.","words":[{"g":"he"},{"g":"to desire","l":"querer"},{"g":"to be"},{"g":"a"},null]},{"text":"Algunos granjeros están trabajando en la granja.","en":"Some farmers are working on the farm.","audio":"https://tatoeba.org/en/audio/download/689267","words":[{"g":"someone","l":"alguno"},null,{"g":"to be","l":"estar"},{"g":"to work","l":"trabajar"},{"g":"in / on"},{"g":"the / her"},{"g":"farm, grange"}]}]}