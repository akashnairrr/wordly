{"id":"huevo","lemma":"huevo","pos":"noun","rank":1863,"glosses":["egg","spawn","testicle"],"ipa":"/ˈw̝ebo/","gender":"m","forms":{"plural":"huevos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Rodrigo5260-huevo.wav","formAudio":{"huevos":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-Marreromarco-huevos.wav"},"examples":[{"text":"Él sacó un huevo.","en":"He took out one egg.","audio":"https://tatoeba.org/en/audio/download/449480"},{"text":"Las aves ponen huevos.","en":"Birds lay eggs.","audio":"https://tatoeba.org/en/audio/download/440559"},{"text":"Me encantan las yemas de huevo.","en":"I love egg yolks.","audio":"https://tatoeba.org/en/audio/download/703366"},{"text":"¿Dónde están los huevos?","en":"Where are the eggs?","audio":"https://tatoeba.org/en/audio/download/604807"},{"text":"La gallina ha puesto un huevo esta mañana.","en":"The chicken laid an egg this morning.","audio":"https://tatoeba.org/en/audio/download/531893"}]}