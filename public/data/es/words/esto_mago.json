{"id":"esto_mago","lemma":"estómago","pos":"noun","rank":1432,"glosses":["stomach (an organ in animals that stores food in the process of digestion)"],"ipa":"/esˈtomaɡo/","gender":"m","forms":{"plural":"estómagos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q1321_%28spa%29-AdrianAbdulBaha-est%C3%B3mago.wav","examples":[{"text":"Me duele mi estómago.","en":"My tummy hurts.","audio":"https://tatoeba.org/en/audio/download/460721"},{"text":"Tengo ardor de estómago.","en":"I have heartburn.","audio":"https://tatoeba.org/en/audio/download/442677"},{"text":"Me duele el estómago.","en":"My stomach hurts.","audio":"https://tatoeba.org/en/audio/download/442878"},{"text":"Tengo el estómago lleno.","en":"My stomach's full.","audio":"https://tatoeba.org/en/audio/download/443732"},{"text":"Tengo dolor de estómago.","en":"I have a stomachache.","audio":"https://tatoeba.org/en/audio/download/453722"}]}