{"id":"haz","lemma":"haz","pos":"noun","rank":197,"glosses":["bundle","beam"],"ipa":"/ˈaθ/","gender":"m","forms":{"plural":"haces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Marreromarco-haz.wav","examples":[{"text":"Haz que se detenga.","en":"Make it stop.","audio":"https://tatoeba.org/en/audio/download/438818"},{"text":"¿Por qué lo haces?","en":"Why do you do it?","audio":"https://tatoeba.org/en/audio/download/443392"},{"text":"Haz lo que quieras.","en":"Suit yourself.","audio":"https://tatoeba.org/en/audio/download/440558"},{"text":"¿Me haces un favor?","en":"Can I ask a favor?","audio":"https://tatoeba.org/en/audio/download/444232"},{"text":"Haz eso por mí.","en":"Do that for me.","audio":"https://tatoeba.org/en/audio/download/440734"}]}