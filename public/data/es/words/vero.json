{"id":"vero","lemma":"vero","pos":"noun","rank":4297,"glosses":["vair"],"ipa":"/ˈbeɾo/","gender":"m","forms":{"plural":"veros"},"examples":[{"text":"¿Cuándo puedo veros?","en":"When can I see you?","audio":"https://tatoeba.org/en/audio/download/44090","words":[{"g":"when"},{"g":"to be able to, can","l":"poder"},null]},{"text":"Espero veros.","en":"I hope to see you.","audio":"https://tatoeba.org/en/audio/download/437356","words":[{"g":"to hope","l":"esperar"},null]},{"text":"Me alegro mucho de veros.","en":"I'm very glad to see you.","audio":"https://tatoeba.org/en/audio/download/45316","words":[{"g":"me"},{"g":"to make happy","l":"alegrar"},{"g":"much"},{"g":"of / from"},null]},{"text":"No quiero volver a veros.","en":"I don't want to see you again.","audio":"https://tatoeba.org/en/audio/download/355186","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to return"},{"g":"to"},null]},{"text":"Me alegro de veros por aquí, chicos.","en":"I'm happy to see you guys here.","audio":"https://tatoeba.org/en/audio/download/765616","words":[{"g":"me"},{"g":"to make happy","l":"alegrar"},{"g":"of / from"},null,{"g":"for / by"},{"g":"here"},{"g":"boy","l":"chico"}]}]}