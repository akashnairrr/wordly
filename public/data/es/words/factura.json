{"id":"factura","lemma":"factura","pos":"noun","rank":3168,"glosses":["bill, invoice","quality, caliber","Danish pastry"],"ipa":"/faɡˈtuɾa/","gender":"f","forms":{"plural":"facturas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-Marreromarco-factura.wav","examples":[{"text":"Puedo pagar esta factura mañana.","en":"I can pay this bill tomorrow.","audio":"https://tatoeba.org/en/audio/download/604798","words":[{"g":"to be able to, can","l":"poder"},{"g":"to pay"},{"g":"this","l":"este"},null,{"g":"tomorrow"}]},{"text":"Tengo facturas que pagar.","en":"I have bills to pay.","audio":"https://tatoeba.org/en/audio/download/604716","words":[{"g":"to have","l":"tener"},null,{"g":"that"},{"g":"to pay"}]},{"text":"Alguien tiene que pagar la factura.","en":"Someone has to pay the bill.","audio":"https://tatoeba.org/en/audio/download/609148","words":[{"g":"someone, somebody"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to pay"},{"g":"the / her"},null]},{"text":"Tengo que pagar un montón de facturas.","en":"I have a lot of bills I have to pay.","audio":"https://tatoeba.org/en/audio/download/605017","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to pay"},null,null,{"g":"of / from"},null],"phrases":[[3,5,"synonym of mucho"]]},{"text":"No deberías haber pagado la factura.","en":"You shouldn't have paid the bill.","audio":"https://tatoeba.org/en/audio/download/353761","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to have"},{"g":"paid"},{"g":"the / her"},null]}]}