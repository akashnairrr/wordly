{"id":"equipo","lemma":"equipo","pos":"noun","rank":289,"glosses":["team","equipment, kit, hardware","device"],"ipa":"/eˈkipo/","gender":"m","forms":{"plural":"equipos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-equipo.wav","examples":[{"text":"Nuestro equipo puede ganar.","en":"Our team can win.","audio":"https://tatoeba.org/en/audio/download/449918"},{"text":"Los equipos salen al campo.","en":"The teams are coming onto the field.","audio":"https://tatoeba.org/en/audio/download/687920"},{"text":"El equipo local ganó.","en":"The home team won.","audio":"https://tatoeba.org/en/audio/download/449665"},{"text":"Diez equipos compitieron por el premio.","en":"Ten teams competed for the prize.","audio":"https://tatoeba.org/en/audio/download/557489"},{"text":"Somos un buen equipo.","en":"We're a good team.","audio":"https://tatoeba.org/en/audio/download/733242"}]}