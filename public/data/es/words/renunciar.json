{"id":"renunciar","lemma":"renunciar","pos":"verb","rank":1885,"glosses":["to renounce, to abandon, to give up, to relinquish, to do without","to renounce, to reject","to quit, to resign"],"ipa":"/renunˈθjaɾ/","conjugation":{"indicative":{"present":{"1s":"renuncio","2s":"renuncias","3s":"renuncia","1p":"renunciamos","2p":"renunciáis","3p":"renuncian"},"imperfect":{"1s":"renunciaba","2s":"renunciabas","3s":"renunciaba","1p":"renunciábamos","2p":"renunciabais","3p":"renunciaban"},"preterite":{"1s":"renuncié","2s":"renunciaste","3s":"renunció","1p":"renunciamos","2p":"renunciasteis","3p":"renunciaron"},"future":{"1s":"renunciaré","2s":"renunciarás","3s":"renunciará","1p":"renunciaremos","2p":"renunciaréis","3p":"renunciarán"},"conditional":{"1s":"renunciaría","2s":"renunciarías","3s":"renunciaría","1p":"renunciaríamos","2p":"renunciaríais","3p":"renunciarían"}},"subjunctive":{"present":{"1s":"renuncie","2s":"renuncies","3s":"renuncie","1p":"renunciemos","2p":"renunciéis","3p":"renuncien"},"imperfect":{"1s":"renunciara","2s":"renunciaras","3s":"renunciara","1p":"renunciáramos","2p":"renunciarais","3p":"renunciaran"}},"imperative":{"affirmative":{"2s":"renuncia","3s":"renuncie","1p":"renunciemos","2p":"renunciad","3p":"renuncien"},"negative":{"2s":"renuncies","3s":"renuncie","1p":"renunciemos","2p":"renunciéis","3p":"renuncien"}}},"nonFinite":{"gerund":"renunciando","participle":"renunciado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Marreromarco-renunciar.wav","examples":[{"text":"Tom tuvo que renunciar.","en":"Tom had to resign.","audio":"https://tatoeba.org/en/audio/download/799542"},{"text":"Yo no renuncio así nada más.","en":"I'm no quitter."},{"text":"Él entregó su renuncia.","en":"He handed in his resignation."},{"text":"Renuncié a mi trabajo.","en":"I gave up my job.","audio":"https://tatoeba.org/en/audio/download/442621"},{"text":"¿Por qué renunciaste?","en":"Why did you quit?","audio":"https://tatoeba.org/en/audio/download/444406"}]}