{"id":"problema","lemma":"problema","pos":"noun","rank":180,"glosses":["problem, issue, challenge (a difficulty or obstacle that has to be dealt with)","trouble (in the singular or in the plural)","question, dilemma, conundrum"],"ipa":"/pɾoˈblema/","gender":"m","forms":{"plural":"problemas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-AdrianAbdulBaha-problema.wav","formAudio":{"problemas":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-Precision27-problemas.wav"},"examples":[{"text":"¿Tenemos un problema?","en":"Do we have a problem?","audio":"https://tatoeba.org/en/audio/download/454169","words":[{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"Todos tenemos problemas.","en":"We all have problems.","audio":"https://tatoeba.org/en/audio/download/454958","words":[{"g":"all","l":"todo"},{"g":"to have","l":"tener"},null]},{"text":"¿Tienes algún problema conmigo?","en":"Do you have a problem with me?","audio":"https://tatoeba.org/en/audio/download/333779","words":[{"g":"to have","l":"tener"},null,null,{"g":"with me"}]},{"text":"¿Entiendes el problema?","en":"Do you understand what the problem is?","audio":"https://tatoeba.org/en/audio/download/517396","words":[{"g":"to understand","l":"entender"},{"g":"the"},null]},{"text":"No tengo problemas para dormir.","en":"I have no problem sleeping.","audio":"https://tatoeba.org/en/audio/download/415937","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"for"},{"g":"to sleep"}]}]}