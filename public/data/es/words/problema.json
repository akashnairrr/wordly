{"id":"problema","lemma":"problema","pos":"noun","rank":182,"glosses":["problem, issue, challenge (a difficulty or obstacle that has to be dealt with)","trouble (in the singular or in the plural)","question, dilemma, conundrum"],"ipa":"/pɾoˈblema/","gender":"m","forms":{"plural":"problemas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-AdrianAbdulBaha-problema.wav","formAudio":{"problemas":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-Precision27-problemas.wav"},"examples":[{"text":"Eso es un problema.","en":"That's a problem.","audio":"https://tatoeba.org/en/audio/download/443798"},{"text":"Él está en problemas.","en":"He is in trouble.","audio":"https://tatoeba.org/en/audio/download/442468"},{"text":"Ya veo el problema.","en":"I see the problem.","audio":"https://tatoeba.org/en/audio/download/444032"},{"text":"Me metí en problemas.","en":"I got into trouble.","audio":"https://tatoeba.org/en/audio/download/449496"},{"text":"No había ningún problema.","en":"It was no trouble.","audio":"https://tatoeba.org/en/audio/download/443440"}]}