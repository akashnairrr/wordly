{"id":"limpio","lemma":"limpio","pos":"adj","rank":1185,"glosses":["clean","broke, out of pocket"],"ipa":"/ˈlimpjo/","forms":{"feminine":"limpia","masculinePlural":"limpios","femininePlural":"limpias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q1321_%28spa%29-AdrianAbdulBaha-limpio.wav","formAudio":{"limpias":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Vanbasten_23-Limpias.wav"},"examples":[{"text":"¿Está limpio el lugar?","en":"Is the place clean?","audio":"https://tatoeba.org/en/audio/download/448358"},{"text":"El agua está limpia.","en":"The water's clean.","audio":"https://tatoeba.org/en/audio/download/501360"},{"text":"No hay platos limpios.","en":"There are no clean plates.","audio":"https://tatoeba.org/en/audio/download/35282"},{"text":"Mis manos están limpias.","en":"My hands are clean.","audio":"https://tatoeba.org/en/audio/download/851401"},{"text":"Quiero este traje limpio.","en":"I want this suit cleaned.","audio":"https://tatoeba.org/en/audio/download/611917"}]}