{"id":"cincuenta","lemma":"cincuenta","pos":"num","rank":2246,"glosses":["fifty"],"ipa":"/θinˈkwenta/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/bd/LL-Q1321_%28spa%29-AdrianAbdulBaha-cincuenta.wav","examples":[{"text":"Mi padre tiene cincuenta años.","en":"My father is fifty years old.","audio":"https://tatoeba.org/en/audio/download/333565","words":[{"g":"my"},{"g":"father, parent"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"En este pueblo hay cincuenta familias.","en":"There are fifty families in this village.","audio":"https://tatoeba.org/en/audio/download/693602","words":[{"g":"in / on"},{"g":"this"},{"g":"town, village"},{"g":"to have","l":"haber"},null,{"g":"family","l":"familia"}]},{"text":"Solo vinieron cincuenta personas.","en":"Only fifty people came.","audio":"https://tatoeba.org/en/audio/download/194861","words":[{"g":"sole"},{"g":"to come","l":"venir"},null,{"g":"person (an individual","l":"persona"}]},{"text":"Nuestra escuela tiene cincuenta años.","en":"Our school is fifty years old.","audio":"https://tatoeba.org/en/audio/download/355415","words":[{"g":"our, ours, to us","l":"nuestro"},{"g":"school"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Hay cincuenta miembros en el club.","en":"There are 50 members in the club.","words":[{"g":"to have","l":"haber"},null,{"g":"limb","l":"miembro"},{"g":"in / on"},{"g":"the"},{"g":"club"}]}]}