{"id":"agua","lemma":"agua","pos":"noun","rank":265,"glosses":["water","body of water","rain (condensed water falling from a cloud)"],"ipa":"/ˈaɡwa/","gender":"f","forms":{"plural":"aguas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Precision27-agua.wav","formAudio":{"aguas":"https://upload.wikimedia.org/wikipedia/commons/3/32/LL-Q1321_%28spa%29-Eavqwiki-aguas.wav"},"examples":[{"text":"¿Cómo está el agua?","en":"How's the water?","audio":"https://tatoeba.org/en/audio/download/821193"},{"text":"Te estás metiendo en aguas profundas.","en":"You're getting into deep water.","audio":"https://tatoeba.org/en/audio/download/703820"},{"text":"El agua está fría.","en":"The water's cold.","audio":"https://tatoeba.org/en/audio/download/91258"},{"text":"Las aguas residuales contaminan el mar a menudo.","en":"Sewage often pollutes the ocean."},{"text":"El agua está buena.","en":"The water is good.","audio":"https://tatoeba.org/en/audio/download/450025"}]}