{"id":"tal","lemma":"tal","pos":"pron","rank":121,"glosses":["such"],"ipa":"/ˈtal/","forms":{"femininePlural":"tales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-Marreromarco-tal.wav","examples":[{"text":"¿Qué tal os va?","en":"Hi, guys.","audio":"https://tatoeba.org/en/audio/download/437822"},{"text":"Tales accidentes son comunes.","en":"Such accidents are common.","audio":"https://tatoeba.org/en/audio/download/1152073"},{"text":"¿Qué tal el trabajo?","en":"How's work?","audio":"https://tatoeba.org/en/audio/download/50816"},{"text":"No creo que tales cosas existan.","en":"I don't believe such things exist.","audio":"https://tatoeba.org/en/audio/download/538027"},{"text":"¿Qué tal la escuela?","en":"How's school?","audio":"https://tatoeba.org/en/audio/download/438198"}]}