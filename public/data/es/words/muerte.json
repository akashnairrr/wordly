{"id":"muerte","lemma":"muerte","pos":"noun","rank":253,"glosses":["death (the cessation of life)","death (the personification of death as a hooded figure)","death, demise (the collapse or end of something)"],"ipa":"/ˈmweɾte/","gender":"f","forms":{"plural":"muertes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dd/LL-Q1321_%28spa%29-Precision27-muerte.wav","formAudio":{"muertes":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Eavqwiki-muertes.wav"},"examples":[{"text":"¿Tiene ella miedo de la muerte?","en":"Is she afraid of death?","audio":"https://tatoeba.org/en/audio/download/705369","words":[{"g":"to have","l":"tener"},{"g":"she"},{"g":"fear"},null,null,null],"phrases":[[3,5,"of the"]]},{"text":"Su muerte es una gran pérdida.","en":"His death is a great loss.","audio":"https://tatoeba.org/en/audio/download/639530","words":[{"g":"his / her / your"},null,{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"loss"}]},{"text":"Piensa en la muerte.","en":"Think about death.","audio":"https://tatoeba.org/en/audio/download/799854","words":[{"g":"to think, ponder","l":"pensar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Dame la libertad o dame la muerte.","en":"Give me liberty or give me death.","audio":"https://tatoeba.org/en/audio/download/684343","words":[{"g":"to give, to give out","l":"dar"},null,null,{"g":"or"},{"g":"to give, to give out","l":"dar"},{"g":"the / her"},null],"phrases":[[1,3,"a region of Peru"]]},{"text":"No le temo a la muerte.","en":"I don't fear death.","audio":"https://tatoeba.org/en/audio/download/450475","words":[{"g":"no / not"},{"g":"him / her"},{"g":"to have an obsession","l":"temar"},{"g":"to"},{"g":"the / her"},null]}]}