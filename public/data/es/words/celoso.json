{"id":"celoso","lemma":"celoso","pos":"adj","rank":1896,"glosses":["jealous","zealous"],"ipa":"/θeˈloso/","forms":{"feminine":"celosa","masculinePlural":"celosos","femininePlural":"celosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Marreromarco-celoso.wav","examples":[{"text":"Yo me puse celoso.","en":"I got jealous.","audio":"https://tatoeba.org/en/audio/download/440291"},{"text":"Es una mujer celosa.","en":"She's a jealous woman.","audio":"https://tatoeba.org/en/audio/download/637204"},{"text":"No están celosos, ¿o sí?","en":"You're not jealous, are you?","audio":"https://tatoeba.org/en/audio/download/598576"},{"text":"Odio a las mujeres celosas.","en":"I hate jealous women.","audio":"https://tatoeba.org/en/audio/download/453555"},{"text":"Es un poco celoso.","en":"He's a bit jealous.","audio":"https://tatoeba.org/en/audio/download/702954"}]}