{"id":"fila","lemma":"fila","pos":"noun","rank":1730,"glosses":["line, row, rank, file","queue (British), line (US)","rank"],"ipa":"/ˈfila/","gender":"f","forms":{"plural":"filas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-AdrianAbdulBaha-fila.wav","examples":[{"text":"Estoy esperando en la fila.","en":"I'm waiting in line.","audio":"https://tatoeba.org/en/audio/download/800387"},{"text":"Había dos filas de soldados.","en":"There were two lines of soldiers.","audio":"https://tatoeba.org/en/audio/download/684585"},{"text":"Por favor, poneos en fila.","en":"Please line up in a row.","audio":"https://tatoeba.org/en/audio/download/75272"},{"text":"Tom se sentó dos filas por delante de mí.","en":"Tom sat two rows ahead of me.","audio":"https://tatoeba.org/en/audio/download/333606"},{"text":"¿Dónde está el final de esta fila?","en":"Where is the end of this line?","audio":"https://tatoeba.org/en/audio/download/514875"}]}