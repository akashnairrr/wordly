{"id":"fila","lemma":"fila","pos":"noun","rank":1727,"glosses":["line, row, rank, file","queue (British), line (US)","rank"],"ipa":"/ˈfila/","gender":"f","forms":{"plural":"filas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-AdrianAbdulBaha-fila.wav","examples":[{"text":"¿Dónde está el final de esta fila?","en":"Where is the end of this line?","audio":"https://tatoeba.org/en/audio/download/514875","words":[null,null,{"g":"the"},{"g":"final"},null,null,null],"phrases":[[0,2,"where are you?"],[4,6,"definitely this time"]]},{"text":"Había dos filas de soldados.","en":"There were two lines of soldiers.","audio":"https://tatoeba.org/en/audio/download/684585","words":[{"g":"makes pluperfect to…"},{"g":"dung, excrement"},null,{"g":"of / from"},{"g":"soldier","l":"soldado"}]},{"text":"Los niños estaban en fila.","en":"The children were standing in line.","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"estar"},{"g":"in / on"},null]},{"text":"Estoy esperando en la fila.","en":"I'm waiting in line.","audio":"https://tatoeba.org/en/audio/download/800387","words":[{"g":"to be","l":"estar"},{"g":"to hope","l":"esperar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Los soldados regresaron a sus filas.","en":"The soldiers returned to their lines.","words":[{"g":"the / them"},{"g":"soldier","l":"soldado"},{"g":"to return","l":"regresar"},{"g":"to"},{"g":"his, her, its, their"},null]}]}