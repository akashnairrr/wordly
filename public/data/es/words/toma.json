{"id":"toma","lemma":"toma","pos":"noun","rank":302,"glosses":["conquest, capture, taking, takeover","dose, serving","intake"],"ipa":"/ˈtoma/","gender":"f","forms":{"plural":"tomas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q1321_%28spa%29-AdrianAbdulBaha-toma.wav","examples":[{"text":"Esto toma su tiempo.","en":"It takes time.","audio":"https://tatoeba.org/en/audio/download/440540"},{"text":"¿Me tomas el pelo?","en":"Isn't that terrific?","audio":"https://tatoeba.org/en/audio/download/450758"},{"text":"Toma, usa mi llave.","en":"Here, use my key.","audio":"https://tatoeba.org/en/audio/download/263805"},{"text":"¿Qué tomas para desayunar?","en":"What do you usually have for breakfast?","audio":"https://tatoeba.org/en/audio/download/526939"},{"text":"Toma lo que quieras.","en":"Take what you want.","audio":"https://tatoeba.org/en/audio/download/450375"}]}