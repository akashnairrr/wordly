{"id":"computadora","lemma":"computadora","pos":"noun","rank":1397,"glosses":["computer"],"ipa":"/komputaˈdoɾa/","gender":"f","forms":{"plural":"computadoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-AdrianAbdulBaha-computadora.wav","examples":[{"text":"Odio a mi computadora.","en":"I hate my computer.","audio":"https://tatoeba.org/en/audio/download/799350"},{"text":"No sé mucho de computadoras.","en":"I don't know much about computers.","audio":"https://tatoeba.org/en/audio/download/590291"},{"text":"Esta es mi computadora.","en":"This is my computer.","audio":"https://tatoeba.org/en/audio/download/799218"},{"text":"Las computadoras son máquinas.","en":"Computers are machines."},{"text":"Necesito una computadora nueva.","en":"I need a new computer.","audio":"https://tatoeba.org/en/audio/download/453992"}]}