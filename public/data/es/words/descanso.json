{"id":"descanso","lemma":"descanso","pos":"noun","rank":1080,"glosses":["rest, break","relief","half-time"],"ipa":"/desˈkanso/","gender":"m","forms":{"plural":"descansos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-descanso.wav","examples":[{"text":"¿Puedo tomar un descanso?","en":"May I take a rest?","audio":"https://tatoeba.org/en/audio/download/444234"},{"text":"Tomémonos un pequeño descanso.","en":"Let's have a little rest.","audio":"https://tatoeba.org/en/audio/download/39830"},{"text":"Deberías darte un descanso.","en":"You should get some rest.","audio":"https://tatoeba.org/en/audio/download/735595"},{"text":"¿Podemos hacer un descanso?","en":"May we have a short recess?","audio":"https://tatoeba.org/en/audio/download/633218"},{"text":"Tengo que tomar un descanso.","en":"I need to take a break.","audio":"https://tatoeba.org/en/audio/download/459104"}]}