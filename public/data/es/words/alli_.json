{"id":"alli_","lemma":"allí","pos":"adv","rank":144,"glosses":["there (away from the speaker and the listener)"],"ipa":"/aˈʝi/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Sinaloa-all%C3%AD.wav","examples":[{"text":"Voy a estar allí.","en":"I'll attend.","audio":"https://tatoeba.org/en/audio/download/455431"},{"text":"Yo no estaba allí.","en":"I wasn't there.","audio":"https://tatoeba.org/en/audio/download/440908"},{"text":"Allí no había nadie.","en":"No one was there.","audio":"https://tatoeba.org/en/audio/download/47611"},{"text":"Mi mujer estaba allí.","en":"My wife was there.","audio":"https://tatoeba.org/en/audio/download/164704"},{"text":"Ella debe ir allí.","en":"She must go there.","audio":"https://tatoeba.org/en/audio/download/524923"}]}