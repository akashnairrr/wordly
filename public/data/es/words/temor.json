{"id":"temor","lemma":"temor","pos":"noun","rank":2802,"glosses":["fear; dread","awe","apprehension"],"ipa":"/teˈmoɾ/","gender":"m","forms":{"plural":"temores"},"order":2808,"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-AdrianAbdulBaha-temor.wav","examples":[{"text":"Ese muchacho no mostró ningún temor.","en":"That boy showed no fear.","words":[{"g":"that"},{"g":"boy or young adult"},{"g":"no / not"},{"g":"to show","l":"mostrar"},null,null]},{"text":"Mi mayor temor es ahogarme.","en":"My greatest fear is drowning.","audio":"https://tatoeba.org/en/audio/download/582083","words":[{"g":"my"},{"g":"of age"},null,{"g":"to be","l":"ser"},{"g":"to drown","l":"ahogar"}]},{"text":"El temor a la muerte es peor que la muerte misma.","en":"Fear of death is worse than death itself.","audio":"https://tatoeba.org/en/audio/download/594912","words":[{"g":"the"},null,{"g":"to"},{"g":"the / her"},{"g":"death"},{"g":"to be","l":"ser"},{"g":"bad","l":"malo"},{"g":"that"},{"g":"the / her"},{"g":"death"},{"g":"same","l":"mismo"}]}]}