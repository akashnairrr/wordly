{"id":"caballero","lemma":"caballero","pos":"noun","rank":558,"glosses":["horseman","knight; cavalier","gentleman"],"ipa":"/kabaˈʝeɾo/","gender":"m","forms":{"plural":"caballeros","feminine":"caballera","femininePlural":"caballeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav","examples":[{"text":"Él es un caballero.","en":"He is a gentleman.","audio":"https://tatoeba.org/en/audio/download/444104"},{"text":"Con su permiso, caballeros.","en":"Excuse me, gentlemen.","audio":"https://tatoeba.org/en/audio/download/845732"},{"text":"Poderoso caballero es Don Dinero.","en":"Money talks.","audio":"https://tatoeba.org/en/audio/download/438313"},{"text":"Es un caballero entre caballeros.","en":"He is a gentleman among gentlemen.","audio":"https://tatoeba.org/en/audio/download/687658"},{"text":"Yo conozco a este caballero.","en":"I know the gentleman.","audio":"https://tatoeba.org/en/audio/download/636586"}]}