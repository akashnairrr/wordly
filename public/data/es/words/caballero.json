{"id":"caballero","lemma":"caballero","pos":"noun","rank":555,"glosses":["horseman","knight; cavalier","gentleman"],"ipa":"/kabaˈʝeɾo/","gender":"m","forms":{"plural":"caballeros","feminine":"caballera","femininePlural":"caballeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav","examples":[{"text":"Él solía ser un caballero.","en":"He used to be a gentleman.","audio":"https://tatoeba.org/en/audio/download/35076","words":[{"g":"he"},{"g":"to be accustomed to…","l":"soler"},{"g":"to be"},{"g":"a"},null]},{"text":"Él es un caballero de verdad.","en":"He is a true gentleman.","audio":"https://tatoeba.org/en/audio/download/703748","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[4,6,"really"]]},{"text":"Ese caballero debe de ser un médico.","en":"That gentleman must be a doctor.","audio":"https://tatoeba.org/en/audio/download/687547","words":[{"g":"that"},null,{"g":"to owe","l":"deber"},{"g":"of / from"},{"g":"to be"},{"g":"a"},{"g":"doctor"}]},{"text":"Un caballero no haría algo así.","en":"A gentleman wouldn't do such a thing.","audio":"https://tatoeba.org/en/audio/download/568255","words":[{"g":"a"},null,{"g":"no / not"},{"g":"to do","l":"hacer"},null,null],"phrases":[[4,6,"kind of"]]},{"text":"Aquí hay un caballero que quiere verte.","en":"There's a man here that wants to see you.","audio":"https://tatoeba.org/en/audio/download/77925","words":[{"g":"here"},{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"that"},{"g":"to desire","l":"querer"},{"g":"to see, to spot","l":"ver"}]}]}