{"id":"caballero","lemma":"caballero","pos":"noun","rank":555,"glosses":["horseman","knight; cavalier","gentleman"],"ipa":"/kabaˈʝeɾo/","gender":"m","forms":{"plural":"caballeros","feminine":"caballera","femininePlural":"caballeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav","examples":[{"text":"Yo conozco a este caballero.","en":"I know the gentleman.","audio":"https://tatoeba.org/en/audio/download/636586","words":[{"g":"I"},{"g":"to know","l":"conocer"},{"g":"to"},{"g":"this"},null]},{"text":"Es un caballero entre caballeros.","en":"He is a gentleman among gentlemen.","audio":"https://tatoeba.org/en/audio/download/687658","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"between"},null]},{"text":"Él es un caballero de verdad.","en":"He is a true gentleman.","audio":"https://tatoeba.org/en/audio/download/703748","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[4,6,"really"]]},{"text":"Ese caballero debe de ser un médico.","en":"That gentleman must be a doctor.","audio":"https://tatoeba.org/en/audio/download/687547","words":[{"g":"that"},null,{"g":"to owe","l":"deber"},{"g":"of / from"},{"g":"to be"},{"g":"a"},{"g":"doctor"}]},{"text":"Un caballero no haría algo así.","en":"A gentleman wouldn't do such a thing.","audio":"https://tatoeba.org/en/audio/download/568255","words":[{"g":"a"},null,{"g":"no / not"},{"g":"to do","l":"hacer"},null,null],"phrases":[[4,6,"kind of"]]}]}