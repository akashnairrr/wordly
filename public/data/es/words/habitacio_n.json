{"id":"habitacio_n","lemma":"habitación","pos":"noun","rank":350,"glosses":["room (separate part of a building)","bedroom (room with a bed for sleeping)","habitation (the act of inhabiting)"],"ipa":"/abitaˈθjon/","gender":"f","forms":{"plural":"habitaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e4/LL-Q1321_%28spa%29-Marreromarco-habitaci%C3%B3n.wav","examples":[{"text":"Yo necesito una habitación.","en":"I need a room.","audio":"https://tatoeba.org/en/audio/download/440350"},{"text":"Tenemos cuatro habitaciones arriba.","en":"We have four bedrooms upstairs.","audio":"https://tatoeba.org/en/audio/download/734492"},{"text":"Sal de la habitación.","en":"Leave the room.","audio":"https://tatoeba.org/en/audio/download/440936"},{"text":"Esta casa tiene seis habitaciones.","en":"This house has six rooms.","audio":"https://tatoeba.org/en/audio/download/553739"},{"text":"Salí de la habitación.","en":"Leave the room.","audio":"https://tatoeba.org/en/audio/download/440961"}]}