{"id":"entrado","lemma":"entrado","pos":"adj","rank":1889,"glosses":["after the start of; into; (late) into; (well) into;"],"ipa":"/enˈtɾado/","forms":{"feminine":"entrada","masculinePlural":"entrados","femininePlural":"entradas"},"formAudio":{"entrada":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-AdrianAbdulBaha-entrada.wav"},"examples":[{"text":"¿Te ha entrado sueño?","en":"Are you sleepy?","audio":"https://tatoeba.org/en/audio/download/633976","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"sleep, slumber"}]},{"text":"¿Cómo has entrado?","en":"How did you get in?","audio":"https://tatoeba.org/en/audio/download/77063","words":[{"g":"how"},{"g":"to have","l":"haber"},null]},{"text":"Tom ha entrado en pánico.","en":"Tom is in shock.","audio":"https://tatoeba.org/en/audio/download/800110","words":[null,{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"pertaining to the god…"}]},{"text":"Él debe haber entrado a esta habitación.","en":"He must have entered this room.","words":[{"g":"he"},{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"to"},{"g":"this","l":"este"},{"g":"room"}]},{"text":"Tom dijo que habían entrado a robar en su casa.","en":"Tom said his house had been broken into.","audio":"https://tatoeba.org/en/audio/download/801168","words":[null,{"g":"to say","l":"decir"},{"g":"that"},{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"to rob"},{"g":"in / on"},{"g":"his / her / your"},{"g":"house"}]}]}