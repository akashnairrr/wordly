{"id":"navidad","lemma":"navidad","pos":"noun","rank":631,"glosses":["Christmas present"],"gender":"f","forms":{"plural":"navidades"},"examples":[{"text":"Estamos ya en Navidad.","en":"Christmas is here.","audio":"https://tatoeba.org/en/audio/download/548321"},{"text":"Dime lo que quieres por Navidades.","en":"Tell me what you want for Christmas.","audio":"https://tatoeba.org/en/audio/download/581988"},{"text":"La Navidad vendrá pronto.","en":"Christmas is coming soon.","audio":"https://tatoeba.org/en/audio/download/531579"},{"text":"Ella se marchó en navidades.","en":"She left on Christmas Day."},{"text":"Ya se acerca la Navidad.","en":"It's almost Christmas.","audio":"https://tatoeba.org/en/audio/download/548320"}]}