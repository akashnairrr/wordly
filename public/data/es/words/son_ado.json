{"id":"son_ado","lemma":"soñado","pos":"adj","rank":3272,"glosses":["dream-"],"ipa":"/soˈɲado/","forms":{"feminine":"soñada","masculinePlural":"soñados","femininePlural":"soñadas"},"examples":[{"text":"He soñado contigo.","en":"I dreamt about you.","audio":"https://tatoeba.org/en/audio/download/1561","words":[{"g":"to have","l":"haber"},null,{"g":"with you"}]},{"text":"He soñado con este día.","en":"I've dreamed of this day.","audio":"https://tatoeba.org/en/audio/download/516134","words":[{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"this"},{"g":"day"}]},{"text":"Siempre he soñado con abrir un restaurante.","en":"I've always dreamed of opening a restaurant.","audio":"https://tatoeba.org/en/audio/download/858007","words":[{"g":"always"},{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"to open, open up"},{"g":"a"},{"g":"restaurant"}]},{"text":"¿Alguna vez has soñado con ser otra persona?","en":"Have you ever dreamt about being someone else?","audio":"https://tatoeba.org/en/audio/download/728399","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"with"},{"g":"to be"},{"g":"someone else","l":"otro"},{"g":"person (an individual"}],"phrases":[[0,2,"ever"]]},{"text":"Yo debo haberlo soñado.","en":"I must have dreamt it.","words":[{"g":"I"},{"g":"to owe","l":"deber"},{"g":"to have","l":"haber"},null]}]}