{"id":"ofendido","lemma":"ofendido","pos":"adj","rank":4312,"glosses":["offended","aggrieved, injured"],"ipa":"/ofenˈdido/","forms":{"feminine":"ofendida","masculinePlural":"ofendidos","femininePlural":"ofendidas"},"examples":[{"text":"Parece que te he ofendido.","en":"It seems I've offended you.","audio":"https://tatoeba.org/en/audio/download/582491","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"you"},{"g":"to have","l":"haber"},null]},{"text":"Espero no haberte ofendido.","en":"I hope I haven't offended you.","words":[{"g":"to hope","l":"esperar"},{"g":"no / not"},{"g":"to have","l":"haber"},null]},{"text":"Estoy profundamente ofendido por esto.","en":"I'm deeply offended by this.","audio":"https://tatoeba.org/en/audio/download/586596","words":[{"g":"to be","l":"estar"},{"g":"profoundly, deeply"},null,{"g":"for / by"},{"g":"this"}]},{"text":"Fui ofendido.","en":"I was insulted.","audio":"https://tatoeba.org/en/audio/download/440850","words":[{"g":"to go","l":"ir"},null]},{"text":"Ella se disculpó por haberle ofendido.","en":"She apologized for having offended him.","audio":"https://tatoeba.org/en/audio/download/608812","words":[{"g":"she"},{"g":"oneself"},{"g":"to excuse","l":"disculpar"},{"g":"for / by"},{"g":"to have","l":"haber"},null]}]}