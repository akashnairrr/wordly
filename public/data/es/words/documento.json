{"id":"documento","lemma":"documento","pos":"noun","rank":1629,"glosses":["document, paper","record"],"ipa":"/dokuˈmento/","gender":"m","forms":{"plural":"documentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-AdrianAbdulBaha-documento.wav","examples":[{"text":"Hice trizas el documento.","en":"I shredded the document.","audio":"https://tatoeba.org/en/audio/download/804383"},{"text":"Puedo mostrarte los documentos.","en":"I can show the documents to you.","audio":"https://tatoeba.org/en/audio/download/354742"},{"text":"No puedo abrir el documento.","en":"I can't open the document.","audio":"https://tatoeba.org/en/audio/download/556757"},{"text":"El espía quemó los documentos.","en":"The spy burned the papers.","audio":"https://tatoeba.org/en/audio/download/537861"},{"text":"Tienes que leer este documento.","en":"You have to read this document.","audio":"https://tatoeba.org/en/audio/download/439731"}]}