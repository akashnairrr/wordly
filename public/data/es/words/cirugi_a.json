{"id":"cirugi_a","lemma":"cirugía","pos":"noun","rank":1440,"glosses":["surgery"],"ipa":"/θiɾuˈxia/","gender":"f","forms":{"plural":"cirugías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-Marreromarco-cirug%C3%ADa.wav","examples":[{"text":"Necesito cirugía.","en":"I need surgery.","audio":"https://tatoeba.org/en/audio/download/440830","words":[{"g":"to need","l":"necesitar"},null]},{"text":"¿Ayudará la cirugía?","en":"Will surgery help it?","audio":"https://tatoeba.org/en/audio/download/453475","words":[{"g":"to help","l":"ayudar"},{"g":"the / her"},null]},{"text":"La cirugía es la mejor solución.","en":"Surgery is the best solution.","audio":"https://tatoeba.org/en/audio/download/730245","words":[{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"better"},{"g":"solution"}]},{"text":"La cirugía duró tres horas.","en":"The surgery lasted three hours.","audio":"https://tatoeba.org/en/audio/download/1086629","words":[{"g":"the / her"},null,{"g":"to last","l":"durar"},{"g":"three"},{"g":"hour","l":"hora"}]},{"text":"Recientemente tuve cirugía.","en":"I recently had surgery.","words":[{"g":"recently"},{"g":"to have","l":"tener"},null]}]}