{"id":"duro","lemma":"duro","pos":"adj","rank":422,"glosses":["hard (not soft)","firm, solid","hard, difficult"],"ipa":"/ˈduɾo/","forms":{"feminine":"dura","masculinePlural":"duros","femininePlural":"duras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-duro.wav","examples":[{"text":"Prometo trabajar duro.","en":"I promise to work hard.","audio":"https://tatoeba.org/en/audio/download/459923","words":[{"g":"to promise","l":"prometer"},{"g":"to work"},null]},{"text":"Gracias por tu trabajo duro.","en":"Thank you for your hard work.","audio":"https://tatoeba.org/en/audio/download/523222","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"your"},{"g":"work, job"},null]},{"text":"¿El trabajo es duro?","en":"Is the work hard?","audio":"https://tatoeba.org/en/audio/download/442819","words":[{"g":"the"},{"g":"work, job"},{"g":"to be","l":"ser"},null]},{"text":"Los tiempos eran duros.","en":"Times were hard.","audio":"https://tatoeba.org/en/audio/download/442152","words":[{"g":"the / them"},{"g":"time","l":"tiempo"},{"g":"to be","l":"ser"},null]},{"text":"Ella trabaja duro.","en":"She works hard.","audio":"https://tatoeba.org/en/audio/download/441133","words":[{"g":"she"},{"g":"to work","l":"trabajar"},null]}]}