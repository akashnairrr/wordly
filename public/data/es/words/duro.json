{"id":"duro","lemma":"duro","pos":"adj","rank":425,"glosses":["hard (not soft)","firm, solid","hard, difficult"],"ipa":"/ˈduɾo/","forms":{"feminine":"dura","masculinePlural":"duros","femininePlural":"duras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5d/LL-Q1321_%28spa%29-AdrianAbdulBaha-duro.wav","examples":[{"text":"Estamos sin un duro.","en":"We're broke.","audio":"https://tatoeba.org/en/audio/download/424607"},{"text":"La vida es dura.","en":"Life is hard.","audio":"https://tatoeba.org/en/audio/download/438259"},{"text":"Los tiempos eran duros.","en":"Times were hard.","audio":"https://tatoeba.org/en/audio/download/442152"},{"text":"No coma cosas duras, por favor.","en":"Don't eat hard foods.","audio":"https://tatoeba.org/en/audio/download/800775"},{"text":"El hierro es duro.","en":"Iron is hard.","audio":"https://tatoeba.org/en/audio/download/519343"}]}