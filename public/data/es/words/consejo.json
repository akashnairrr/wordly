{"id":"consejo","lemma":"consejo","pos":"noun","rank":682,"glosses":["advice, counsel, piece of advice","council, board"],"ipa":"/konˈsexo/","gender":"m","forms":{"plural":"consejos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0c/LL-Q1321_%28spa%29-AdrianAbdulBaha-consejo.wav","examples":[{"text":"Pide consejo a Tom.","en":"Get Tom's advice.","audio":"https://tatoeba.org/en/audio/download/800235"},{"text":"Nunca escuchas nuestros consejos.","en":"You never listen to our advice.","audio":"https://tatoeba.org/en/audio/download/706303"},{"text":"Es un buen consejo.","en":"That's good advice.","audio":"https://tatoeba.org/en/audio/download/448654"},{"text":"Yo no necesito tus consejos.","en":"I don't need your advice.","audio":"https://tatoeba.org/en/audio/download/590021"},{"text":"¿Cuál es vuestro consejo?","en":"What's your advice?","audio":"https://tatoeba.org/en/audio/download/128105"}]}