{"id":"viento","lemma":"viento","pos":"noun","rank":1063,"glosses":["wind (movement of air)","woodwind section","guy rope"],"ipa":"/ˈbjento/","gender":"m","forms":{"plural":"vientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Rodelar-viento.wav","examples":[{"text":"Me gusta escuchar el viento.","en":"I like listening to the wind.","audio":"https://tatoeba.org/en/audio/download/1152626","words":[null,null,{"g":"to listen to"},{"g":"the"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Hoy no hace viento.","en":"There's no wind today.","audio":"https://tatoeba.org/en/audio/download/67417","words":[{"g":"today, tonight"},{"g":"no / not"},{"g":"to do","l":"hacer"},null]},{"text":"Hace más viento hoy que ayer.","en":"There's more wind today than yesterday.","audio":"https://tatoeba.org/en/audio/download/733710","words":[{"g":"to do","l":"hacer"},{"g":"more"},null,{"g":"today, tonight"},{"g":"that"},{"g":"yesterday"}]},{"text":"Los fuertes vientos acompañaban la lluvia.","en":"Strong winds accompanied the rain.","audio":"https://tatoeba.org/en/audio/download/1152103","words":[{"g":"the / them"},{"g":"strong","l":"fuerte"},null,null,{"g":"the / her"},{"g":"rain"}]},{"text":"Hay un poco de viento.","en":"There's a little wind.","audio":"https://tatoeba.org/en/audio/download/460978","words":[{"g":"to have","l":"haber"},null,null,{"g":"of / from"},null],"phrases":[[1,3,"a bit"]]}]}