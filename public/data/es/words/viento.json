{"id":"viento","lemma":"viento","pos":"noun","rank":1066,"glosses":["wind (movement of air)","woodwind section","guy rope"],"ipa":"/ˈbjento/","gender":"m","forms":{"plural":"vientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Rodelar-viento.wav","examples":[{"text":"El viento soplaba violentamente.","en":"The wind blew hard.","audio":"https://tatoeba.org/en/audio/download/706734"},{"text":"Quien siembra vientos, recoge tempestades.","en":"You reap what you sow.","audio":"https://tatoeba.org/en/audio/download/531543"},{"text":"Hay algo de viento.","en":"There is some wind.","audio":"https://tatoeba.org/en/audio/download/501696"},{"text":"Los fuertes vientos acompañaban la lluvia.","en":"Strong winds accompanied the rain.","audio":"https://tatoeba.org/en/audio/download/1152103"},{"text":"El viento se calmó.","en":"The wind calmed down.","audio":"https://tatoeba.org/en/audio/download/68573"}]}