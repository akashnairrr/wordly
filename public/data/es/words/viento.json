{"id":"viento","lemma":"viento","pos":"noun","rank":1063,"glosses":["wind (movement of air)","woodwind section","guy rope"],"ipa":"/ˈbjento/","gender":"m","forms":{"plural":"vientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Rodelar-viento.wav","examples":[{"text":"Hace viento, ¿verdad?","en":"It's windy, isn't it?","audio":"https://tatoeba.org/en/audio/download/741219","words":[{"g":"to do","l":"hacer"},null,{"g":"truth"}]},{"text":"¿A que hoy hace viento?","en":"It's windy today, isn't it?","audio":"https://tatoeba.org/en/audio/download/164453","words":[{"g":"to"},{"g":"that"},{"g":"today, tonight"},{"g":"to do","l":"hacer"},null]},{"text":"Me gusta escuchar el viento.","en":"I like listening to the wind.","audio":"https://tatoeba.org/en/audio/download/1152626","words":[null,null,{"g":"to listen to"},{"g":"the"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Los fuertes vientos acompañaban la lluvia.","en":"Strong winds accompanied the rain.","audio":"https://tatoeba.org/en/audio/download/1152103","words":[{"g":"the / them"},{"g":"strong","l":"fuerte"},null,null,{"g":"the / her"},{"g":"rain"}]},{"text":"Esta mañana hace mucho viento, ¿no?","en":"There's a lot of wind this morning, isn't there?","audio":"https://tatoeba.org/en/audio/download/553848","words":[{"g":"this","l":"este"},{"g":"tomorrow"},{"g":"to do","l":"hacer"},{"g":"much"},null,{"g":"no / not"}]}]}