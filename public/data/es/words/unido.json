{"id":"unido","lemma":"unido","pos":"adj","rank":783,"glosses":["united","joined, linked"],"ipa":"/uˈnido/","forms":{"feminine":"unida","masculinePlural":"unidos","femininePlural":"unidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-AdrianAbdulBaha-unido.wav","formAudio":{"unidos":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Precision27-Unidos.wav","unidas":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-GlyphEnjoyer-Unidas.wav"},"examples":[{"text":"La capital de Reino Unido es Londres.","en":"The capital of the United Kingdom is London.","audio":"https://tatoeba.org/en/audio/download/692925"},{"text":"Soy de los Estados Unidos.","en":"I'm from America.","audio":"https://tatoeba.org/en/audio/download/46352"},{"text":"El edificio de las Naciones Unidas fue construido en 1952.","en":"The United Nations Building was built in 1952.","audio":"https://tatoeba.org/en/audio/download/600105"},{"text":"¿Cuál es mayor, Japón o el Reino Unido?","en":"Which is larger, Japan or Britain?","audio":"https://tatoeba.org/en/audio/download/806818"},{"text":"Quiero ir a Estados Unidos.","en":"I want to go to America.","audio":"https://tatoeba.org/en/audio/download/586825"}]}