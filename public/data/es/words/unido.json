{"id":"unido","lemma":"unido","pos":"adj","rank":780,"glosses":["united","joined, linked"],"ipa":"/uˈnido/","forms":{"feminine":"unida","masculinePlural":"unidos","femininePlural":"unidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-AdrianAbdulBaha-unido.wav","formAudio":{"unidos":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Precision27-Unidos.wav","unidas":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-GlyphEnjoyer-Unidas.wav"},"examples":[{"text":"Mis padres y yo no estamos unidos.","en":"My parents and I aren't close.","audio":"https://tatoeba.org/en/audio/download/586943","words":[{"g":"my"},{"g":"father, parent","l":"padre"},{"g":"and"},{"g":"I"},{"g":"no / not"},{"g":"to be","l":"estar"},null]},{"text":"Estábamos muy unidos.","en":"We were really tight.","audio":"https://tatoeba.org/en/audio/download/850163","words":[{"g":"to be","l":"estar"},null,null]},{"text":"La guerra había unido a los americanos.","en":"The war had united the American people.","words":[{"g":"the / her"},{"g":"war, warfare"},{"g":"makes pluperfect to…"},null,{"g":"to"},{"g":"the / them"},{"g":"American","l":"americano"}]},{"text":"Estamos todos unidos en la amistad.","en":"We're all united in friendship.","audio":"https://tatoeba.org/en/audio/download/578328","words":[{"g":"to be","l":"estar"},{"g":"all","l":"todo"},null,{"g":"in / on"},{"g":"the / her"},{"g":"friendship"}]},{"text":"El pueblo está unido con nuestra ciudad a través de un puente.","en":"The village is connected with our town by a bridge.","audio":"https://tatoeba.org/en/audio/download/692249","words":[{"g":"the"},{"g":"town, village"},{"g":"to be","l":"estar"},null,{"g":"with"},{"g":"our, ours, to us","l":"nuestro"},{"g":"city"},null,null,null,{"g":"a"},{"g":"bridge"}],"phrases":[[7,10,"across"]]}]}