{"id":"pregunta","lemma":"pregunta","pos":"noun","rank":336,"glosses":["question (sentence that asks for information)"],"ipa":"/pɾeˈɡunta/","gender":"f","forms":{"plural":"preguntas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-AdrianAbdulBaha-pregunta.wav","examples":[{"text":"Pregunta en los alrededores.","en":"Ask around.","audio":"https://tatoeba.org/en/audio/download/439017"},{"text":"¿Por qué lo preguntas?","en":"Why do you ask?","audio":"https://tatoeba.org/en/audio/download/1358"},{"text":"Pregunta a un experto.","en":"Ask an expert.","audio":"https://tatoeba.org/en/audio/download/438036"},{"text":"¿Por qué me preguntas?","en":"Why are you asking me?","audio":"https://tatoeba.org/en/audio/download/459787"},{"text":"Contesta a mi pregunta.","en":"Answer my question.","audio":"https://tatoeba.org/en/audio/download/449110"}]}