{"id":"pregunta","lemma":"pregunta","pos":"noun","rank":333,"glosses":["question (sentence that asks for information)"],"ipa":"/pɾeˈɡunta/","gender":"f","forms":{"plural":"preguntas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-AdrianAbdulBaha-pregunta.wav","examples":[{"text":"Te tengo una pregunta.","en":"I have a question for you.","audio":"https://tatoeba.org/en/audio/download/598540","words":[{"g":"you"},{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"¿Puedo hacer una pregunta?","en":"Can I ask a question?","audio":"https://tatoeba.org/en/audio/download/453025","words":[{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"a"},null]},{"text":"Responde la pregunta.","en":"Answer the question.","audio":"https://tatoeba.org/en/audio/download/39416","words":[{"g":"to answer, to reply","l":"responder"},{"g":"the / her"},null]},{"text":"¿Tienes alguna pregunta?","en":"Do you have a question?","audio":"https://tatoeba.org/en/audio/download/459001","words":[{"g":"to have","l":"tener"},{"g":"someone","l":"alguno"},null]},{"text":"Ella me hizo una pregunta.","en":"She asked me a question.","audio":"https://tatoeba.org/en/audio/download/39315","words":[{"g":"she"},{"g":"me"},{"g":"to do","l":"hacer"},{"g":"a"},null]}]}