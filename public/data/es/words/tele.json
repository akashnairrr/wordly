{"id":"tele","lemma":"tele","pos":"noun","rank":1816,"glosses":["television"],"ipa":"/ˈtele/","gender":"f","forms":{"plural":"teles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Marreromarco-tele.wav","examples":[{"text":"¿Puedo apagar la tele?","en":"Can I turn off the TV?","audio":"https://tatoeba.org/en/audio/download/39713"},{"text":"Te vi en la tele.","en":"I saw you on TV.","audio":"https://tatoeba.org/en/audio/download/441751"},{"text":"Estoy cansado de la tele.","en":"I'm tired of TV.","audio":"https://tatoeba.org/en/audio/download/441865"},{"text":"Él está viendo la tele.","en":"He is watching TV.","audio":"https://tatoeba.org/en/audio/download/444086"},{"text":"Me gusta ver la tele.","en":"I like to watch TV.","audio":"https://tatoeba.org/en/audio/download/449889"}]}