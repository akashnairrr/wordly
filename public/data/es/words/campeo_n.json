{"id":"campeo_n","lemma":"campeón","pos":"noun","rank":1682,"glosses":["champion, champ (informal address)"],"ipa":"/kampeˈon/","gender":"m","forms":{"plural":"campeones","feminine":"campeona","femininePlural":"campeonas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q1321_%28spa%29-AdrianAbdulBaha-campe%C3%B3n.wav","examples":[{"text":"Soy campeón de la nación.","en":"I'm the national champion.","audio":"https://tatoeba.org/en/audio/download/427826","words":[{"g":"to be","l":"ser"},null,null,null,{"g":"nation"}],"phrases":[[2,4,"of the"]]},{"text":"No somos los campeones.","en":"We're not the champions.","audio":"https://tatoeba.org/en/audio/download/611791","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"the / them"},null]},{"text":"El campeón fue recibido por una enorme multitud.","en":"The champion was welcomed by large crowds.","audio":"https://tatoeba.org/en/audio/download/635479","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"to receive, get","l":"recibir"},{"g":"for / by"},{"g":"a"},{"g":"enormous, huge"},{"g":"multitude"}]},{"text":"Ellos son campeones académicos.","en":"They're academic champions.","words":[{"g":"they","l":"él"},{"g":"to be","l":"ser"},null,{"g":"academic","l":"académico"}]},{"text":"Sos el campeón, ¿no?","en":"You're the champion, aren't you?","words":[{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"no / not"}]}]}