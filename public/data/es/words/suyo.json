{"id":"suyo","lemma":"suyo","pos":"pron","rank":862,"glosses":["his, hers, its","theirs","yours"],"ipa":"/ˈsuʝo/","forms":{"plural":"suyos","feminine":"suya","femininePlural":"suyas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q1321_%28spa%29-Marreromarco-suyo.wav","examples":[{"text":"Ese coche es suyo.","en":"That car is hers.","audio":"https://tatoeba.org/en/audio/download/442881"},{"text":"Estos bolígrafos son suyos.","en":"These pens are his.","audio":"https://tatoeba.org/en/audio/download/636465"},{"text":"¿Esta radio es suya?","en":"Is this radio yours?","audio":"https://tatoeba.org/en/audio/download/449218"},{"text":"Esas fotos son suyas.","en":"Those photos are hers.","audio":"https://tatoeba.org/en/audio/download/461096"},{"text":"El perro es suyo.","en":"The dog is theirs.","audio":"https://tatoeba.org/en/audio/download/637000"}]}