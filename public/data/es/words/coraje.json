{"id":"coraje","lemma":"coraje","pos":"noun","rank":2192,"glosses":["anger, rage, resentment","courage, bravery, spunk"],"ipa":"/koˈɾaxe/","gender":"m","forms":{"plural":"corajes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Marreromarco-coraje.wav","examples":[{"text":"No deberíamos perder el coraje.","en":"We shouldn't lose courage.","audio":"https://tatoeba.org/en/audio/download/514854","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to lose"},{"g":"the"},null]},{"text":"Te admiro por tu coraje.","en":"I admire you for your courage.","audio":"https://tatoeba.org/en/audio/download/553757","words":[{"g":"you"},{"g":"to admire","l":"admirar"},{"g":"for / by"},{"g":"your"},null]},{"text":"Él tuvo el coraje de decirlo.","en":"He had the courage to say it.","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"the"},null,{"g":"of / from"},{"g":"to say","l":"decir"}]},{"text":"Tengo coraje y fuerza de voluntad.","en":"I have courage and a strong will.","words":[{"g":"to have","l":"tener"},null,{"g":"and"},null,null,null],"phrases":[[3,6,"willpower"]]},{"text":"Su coraje la respaldaba.","en":"Her courage supported her.","words":[{"g":"his / her / your"},null,{"g":"the / her"},null]}]}