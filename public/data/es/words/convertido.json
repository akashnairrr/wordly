{"id":"convertido","lemma":"convertido","pos":"adj","rank":1427,"glosses":["converted"],"ipa":"/kombeɾˈtido/","forms":{"feminine":"convertida","masculinePlural":"convertidos","femininePlural":"convertidas"},"examples":[{"text":"Me he convertido en mujer.","en":"I became a woman.","audio":"https://tatoeba.org/en/audio/download/734755","words":[{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"woman"}]},{"text":"Se ha convertido en una hermosa joven.","en":"She has grown into a beautiful young lady.","audio":"https://tatoeba.org/en/audio/download/693848","words":[{"g":"oneself"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"a"},{"g":"gorgeous","l":"hermoso"},{"g":"young, youthful"}]},{"text":"Me he convertido en un hombre nuevo.","en":"I've become a new man.","words":[{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"a"},{"g":"man"},{"g":"new"}]},{"text":"El príncipe fue convertido en rana.","en":"The prince was changed into a frog.","audio":"https://tatoeba.org/en/audio/download/608525","words":[{"g":"the"},{"g":"prince"},{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"frog"}]},{"text":"Siento mucho en lo que me he convertido.","en":"I hate what I've become.","audio":"https://tatoeba.org/en/audio/download/459302","words":[{"g":"to seat","l":"sentar"},{"g":"much"},{"g":"in / on"},null,null,{"g":"me"},{"g":"to have","l":"haber"},null],"phrases":[[3,5,"what, that which"]]}]}