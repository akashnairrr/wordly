{"id":"calle","lemma":"calle","pos":"noun","rank":412,"glosses":["street","lane (in a pool or racetrack, but not a highway)"],"ipa":"/ˈkaʝe/","gender":"f","forms":{"plural":"calles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-AdrianAbdulBaha-calle.wav","formAudio":{"calles":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-Marreromarco-calles.wav"},"examples":[{"text":"¿En qué calle vive usted?","en":"What street do you live on?","audio":"https://tatoeba.org/en/audio/download/594618","words":[{"g":"in / on"},{"g":"what"},null,{"g":"to applaud","l":"vivar"},{"g":"you (formal)"}]},{"text":"¿Tú también vives en esta calle?","en":"Do you live on this street, too?","audio":"https://tatoeba.org/en/audio/download/921366","words":[{"g":"you"},{"g":"also, too, as well"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"this","l":"este"},null]},{"text":"¿Sabes qué calle lleva a mi casa?","en":"Do you know which road leads to my house?","audio":"https://tatoeba.org/en/audio/download/689020","words":[{"g":"to know, to understand","l":"saber"},{"g":"what"},null,{"g":"to take somewhere","l":"llevar"},{"g":"to"},{"g":"my"},{"g":"house"}]},{"text":"Me encontré con ella en la calle.","en":"I met her on the street.","audio":"https://tatoeba.org/en/audio/download/39727","words":[{"g":"me"},{"g":"to meet","l":"encontrar"},{"g":"with"},{"g":"she"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Una mujer me preguntó por una calle.","en":"A woman asked me for directions.","audio":"https://tatoeba.org/en/audio/download/706545","words":[{"g":"a"},{"g":"woman"},{"g":"me"},{"g":"to ask","l":"preguntar"},{"g":"for / by"},{"g":"a"},null]}]}