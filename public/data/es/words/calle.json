{"id":"calle","lemma":"calle","pos":"noun","rank":415,"glosses":["street","lane (in a pool or racetrack, but not a highway)"],"ipa":"/ˈkaʝe/","gender":"f","forms":{"plural":"calles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-AdrianAbdulBaha-calle.wav","formAudio":{"calles":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-Marreromarco-calles.wav"},"examples":[{"text":"Yo crucé la calle.","en":"I crossed the street.","audio":"https://tatoeba.org/en/audio/download/453643"},{"text":"Las calles están limpias.","en":"The streets are clean.","audio":"https://tatoeba.org/en/audio/download/75819"},{"text":"Vivo en la calle.","en":"I live on the street.","audio":"https://tatoeba.org/en/audio/download/694260"},{"text":"Las calles estaban vacías.","en":"The streets were empty.","audio":"https://tatoeba.org/en/audio/download/74789"},{"text":"La calle está inundada.","en":"The street is packed.","audio":"https://tatoeba.org/en/audio/download/437119"}]}