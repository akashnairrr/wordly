{"id":"resistencia","lemma":"resistencia","pos":"noun","rank":2018,"glosses":["resistance","resistor (component that implements electrical resistance)","endurance, stamina"],"ipa":"/resisˈtenθja/","gender":"f","forms":{"plural":"resistencias"},"order":2048,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Marreromarco-resistencia.wav","examples":[{"text":"Aplastaron toda resistencia.","en":"They crushed all resistance.","words":[{"g":"to crush","l":"aplastar"},{"g":"all","l":"todo"},null]},{"text":"Se admiraron de su resistencia.","en":"They were amazed at his courage.","words":[{"g":"oneself"},{"g":"to admire","l":"admirar"},{"g":"of / from"},{"g":"his / her / your"},null]},{"text":"El enemigo se rindió sin dar más resistencia.","en":"The enemy gave in without further resistance.","words":[{"g":"the"},{"g":"adverse"},{"g":"oneself"},{"g":"to conquer","l":"rendir"},{"g":"without"},{"g":"to give, to give out"},{"g":"more"},null]}]}