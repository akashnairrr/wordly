{"id":"lejos","lemma":"lejos","pos":"adv","rank":361,"glosses":["far, far away"],"ipa":"/ˈlexos/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Rodelar-lejos.wav","examples":[{"text":"Manda lejos a Tom.","en":"Send Tom away.","audio":"https://tatoeba.org/en/audio/download/152878"},{"text":"No está tan lejos.","en":"It's not so far.","audio":"https://tatoeba.org/en/audio/download/38066"},{"text":"Estate lejos de mí.","en":"Keep away from me.","audio":"https://tatoeba.org/en/audio/download/444148"},{"text":"Ella no fue lejos.","en":"She didn't go far.","audio":"https://tatoeba.org/en/audio/download/444320"},{"text":"Tom no llegará lejos.","en":"Tom won't get far.","audio":"https://tatoeba.org/en/audio/download/799217"}]}