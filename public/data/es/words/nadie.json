{"id":"nadie","lemma":"nadie","pos":"pron","rank":118,"glosses":["no one; nobody (anyone or anybody)"],"ipa":"/ˈnadje/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q1321_%28spa%29-AdrianAbdulBaha-nadie.wav","examples":[{"text":"Nadie sabe todavía.","en":"No one knows yet.","audio":"https://tatoeba.org/en/audio/download/443169","words":[null,{"g":"to know, to understand","l":"saber"},{"g":"still, yet"}]},{"text":"Nadie te puede ayudar.","en":"No one can help you.","audio":"https://tatoeba.org/en/audio/download/448642","words":[null,{"g":"you"},{"g":"to be able to, can","l":"poder"},{"g":"to help"}]},{"text":"Nadie sabe la razón.","en":"No one knows the reason.","audio":"https://tatoeba.org/en/audio/download/69239","words":[null,{"g":"to know, to understand","l":"saber"},{"g":"the / her"},{"g":"reason"}]},{"text":"Casi nadie la cree.","en":"Almost no one believes her.","audio":"https://tatoeba.org/en/audio/download/639501","words":[{"g":"almost"},null,{"g":"the / her"},{"g":"to believe","l":"creer"}]},{"text":"Parece que nadie sabe la verdad.","en":"It seems that no one knows the truth.","audio":"https://tatoeba.org/en/audio/download/609705","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},null,{"g":"to know, to understand","l":"saber"},null,null],"phrases":[[4,6,"honestly, to be honest"]]}]}