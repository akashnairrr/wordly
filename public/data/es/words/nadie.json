{"id":"nadie","lemma":"nadie","pos":"pron","rank":119,"glosses":["no one; nobody (anyone or anybody)"],"ipa":"/ˈnadje/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2e/LL-Q1321_%28spa%29-AdrianAbdulBaha-nadie.wav","examples":[{"text":"No ha venido nadie.","en":"Nobody came.","audio":"https://tatoeba.org/en/audio/download/39870"},{"text":"No lo sabía nadie.","en":"Nobody knew.","audio":"https://tatoeba.org/en/audio/download/857913"},{"text":"No se movió nadie.","en":"No one moved.","audio":"https://tatoeba.org/en/audio/download/221656"},{"text":"Nadie me lo dijo.","en":"No one told me.","audio":"https://tatoeba.org/en/audio/download/77048"},{"text":"Nadie me prestó ayuda.","en":"No one helped me.","audio":"https://tatoeba.org/en/audio/download/442875"}]}