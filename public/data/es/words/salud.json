{"id":"salud","lemma":"salud","pos":"intj","rank":672,"glosses":["bless you (said to somebody who has sneezed)","cheers (the usual toast when drinking alcohol)"],"ipa":"/saˈlud/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-AdrianAbdulBaha-salud.wav","examples":[{"text":"La salud es riqueza.","en":"Health is wealth.","audio":"https://tatoeba.org/en/audio/download/800044"},{"text":"Gozo de buena salud.","en":"I'm in good health.","audio":"https://tatoeba.org/en/audio/download/448322"},{"text":"Tom tiene mala salud.","en":"Tom is in poor health.","audio":"https://tatoeba.org/en/audio/download/803743"},{"text":"Estoy preocupado por su salud.","en":"I am anxious about your health.","audio":"https://tatoeba.org/en/audio/download/552782"},{"text":"Me preocupo por tu salud.","en":"I am concerned for your health.","audio":"https://tatoeba.org/en/audio/download/551695"}]}