{"id":"cien","lemma":"cien","pos":"num","rank":1199,"glosses":["one hundred (100)"],"ipa":"/ˈθjen/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-AdrianAbdulBaha-cien.wav","examples":[{"text":"Le debo cien dólares.","en":"I owe him $100.","audio":"https://tatoeba.org/en/audio/download/39592"},{"text":"Hoy gasté cien dólares.","en":"I spent 100 dollars today.","audio":"https://tatoeba.org/en/audio/download/77782"},{"text":"Él ahorró cien dólares.","en":"He saved a hundred dollars.","audio":"https://tatoeba.org/en/audio/download/43255"},{"text":"Planeo vivir cien años.","en":"I plan to live to be a hundred.","audio":"https://tatoeba.org/en/audio/download/298460"},{"text":"Caminamos otras cien yardas.","en":"We walked another hundred yards.","audio":"https://tatoeba.org/en/audio/download/514863"}]}