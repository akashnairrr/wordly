{"id":"anillo","lemma":"anillo","pos":"noun","rank":978,"glosses":["ring","annulus","annulet"],"ipa":"/aˈniʝo/","gender":"m","forms":{"plural":"anillos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1321_%28spa%29-AdrianAbdulBaha-anillo.wav","examples":[{"text":"Yo tengo un anillo.","en":"I have a ring.","audio":"https://tatoeba.org/en/audio/download/440300"},{"text":"¿Es eso un anillo?","en":"Is that a ring?","audio":"https://tatoeba.org/en/audio/download/541269"},{"text":"No quiero el anillo.","en":"I don't want the ring.","audio":"https://tatoeba.org/en/audio/download/454564"},{"text":"¿Cuánto vale este anillo?","en":"How much is this ring worth?","audio":"https://tatoeba.org/en/audio/download/600022"},{"text":"El anillo es de oro puro.","en":"The ring is made of pure gold.","audio":"https://tatoeba.org/en/audio/download/684661"}]}