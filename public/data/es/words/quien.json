{"id":"quien","lemma":"quien","pos":"pron","rank":184,"glosses":["who","whom","whoever; whomever; anyone who"],"ipa":"/ˈkjen/","forms":{"plural":"quienes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-Precision27-quien.wav","examples":[{"text":"Necesito alguien con quien hablar.","en":"I need someone to talk with.","audio":"https://tatoeba.org/en/audio/download/77491","words":[{"g":"to need","l":"necesitar"},{"g":"someone, somebody"},{"g":"with"},null,{"g":"to talk"}]},{"text":"¿Sabes quienes son ellos?","en":"Do you know who they are?","audio":"https://tatoeba.org/en/audio/download/553887","words":[{"g":"to know, to understand","l":"saber"},null,{"g":"to be","l":"ser"},{"g":"they","l":"él"}]},{"text":"No tengo ningún amigo con quien hablar.","en":"I have no friend to talk with.","audio":"https://tatoeba.org/en/audio/download/642247","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"friend"},{"g":"with"},null,{"g":"to talk"}]},{"text":"¿Quienes son esos hombres?","en":"Who are these men?","audio":"https://tatoeba.org/en/audio/download/800264","words":[null,{"g":"to be","l":"ser"},{"g":"that","l":"ese"},{"g":"man","l":"hombre"}]},{"text":"Ella necesita a alguien con quien hablar.","en":"She needs someone to talk to.","audio":"https://tatoeba.org/en/audio/download/34648","words":[{"g":"she"},{"g":"to need","l":"necesitar"},{"g":"to"},{"g":"someone, somebody"},{"g":"with"},null,{"g":"to talk"}]}]}