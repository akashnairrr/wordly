{"id":"juro","lemma":"juro","pos":"noun","rank":635,"glosses":["ownership"],"ipa":"/ˈxuɾo/","gender":"m","forms":{"plural":"juros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-Rodrigo5260-juro.wav","examples":[{"text":"Te juro que no estoy drogado.","en":"I swear I'm not high.","audio":"https://tatoeba.org/en/audio/download/823853"},{"text":"Te juro que no estoy borracho.","en":"I swear I'm not drunk.","audio":"https://tatoeba.org/en/audio/download/820387"},{"text":"Te juro que te lo contaré todo algún día.","en":"I swear I'll tell you everything someday.","audio":"https://tatoeba.org/en/audio/download/506015"},{"text":"Juro que no hice trampa.","en":"I swear that I didn't cheat."},{"text":"Juro que no vi nada.","en":"I swear I didn't see anything."}]}