{"id":"oreja","lemma":"oreja","pos":"noun","rank":2399,"glosses":["outer ear; auricle; ear (used for references to the external or tangible aspects of the ear)"],"ipa":"/oˈɾexa/","gender":"f","forms":{"plural":"orejas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-Rodelar-oreja.wav","examples":[{"text":"Tenemos dos orejas.","en":"We have two ears.","audio":"https://tatoeba.org/en/audio/download/636431","words":[{"g":"to have","l":"tener"},{"g":"dung, excrement"},null]},{"text":"No tengo oreja para la música.","en":"I don't have an ear for music.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"for"},{"g":"the / her"},{"g":"music"}]},{"text":"¿Te gustaría mostrar tus orejas?","en":"Do you want your ears to show?","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"to show"},{"g":"your"},null]},{"text":"Oímos con nuestras orejas.","en":"We hear with our ears.","audio":"https://tatoeba.org/en/audio/download/43262","words":[{"g":"to hear","l":"oír"},{"g":"with"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"Un gato tiene dos orejas.","en":"A cat has two ears.","words":[{"g":"a"},{"g":"cat"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null]}]}