{"id":"recientemente","lemma":"recientemente","pos":"adv","rank":1858,"glosses":["recently"],"ipa":"/reˌθjenteˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-AdrianAbdulBaha-recientemente.wav","examples":[{"text":"Él murió recientemente.","en":"He died recently.","audio":"https://tatoeba.org/en/audio/download/442407","words":[{"g":"he"},{"g":"to die","l":"morir"},null]},{"text":"¿Has oído de ella recientemente?","en":"Have you heard from her recently?","words":[{"g":"to have","l":"haber"},{"g":"hearing"},{"g":"of / from"},{"g":"she"},null]},{"text":"¿A quién has ayudado recientemente?","en":"Who have you helped recently?","audio":"https://tatoeba.org/en/audio/download/551309","words":[{"g":"to"},{"g":"who"},{"g":"to have","l":"haber"},{"g":"to help","l":"ayudar"},null]},{"text":"Recientemente tuve cirugía.","en":"I recently had surgery.","words":[null,{"g":"to have","l":"tener"},{"g":"surgery"}]},{"text":"He estado muy ocupado recientemente.","en":"I've been so busy recently.","audio":"https://tatoeba.org/en/audio/download/582630","words":[{"g":"to have","l":"haber"},{"g":"country, land"},null,{"g":"occupied"},null]}]}