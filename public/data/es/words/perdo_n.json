{"id":"perdo_n","lemma":"perdón","pos":"noun","rank":399,"glosses":["pardon","mercy"],"ipa":"/peɾˈdon/","gender":"m","forms":{"plural":"perdones"},"examples":[{"text":"Él me pidió perdón.","en":"He asked for my pardon.","audio":"https://tatoeba.org/en/audio/download/636425","words":[{"g":"he"},{"g":"me"},{"g":"to ask for something","l":"pedir"},null]},{"text":"Pido tu perdón.","en":"I ask your forgiveness.","audio":"https://tatoeba.org/en/audio/download/459998","words":[{"g":"to ask for something","l":"pedir"},{"g":"your"},null]},{"text":"Perdón, ¿dijiste algo?","en":"I'm sorry, did you say something?","audio":"https://tatoeba.org/en/audio/download/850338","words":[null,{"g":"to say","l":"decir"},{"g":"something, anything"}]},{"text":"Te quiero pedir perdón.","en":"I want to ask you for forgiveness.","audio":"https://tatoeba.org/en/audio/download/506673","words":[null,null,{"g":"to ask for something"},null],"phrases":[[0,2,"I love you"]]},{"text":"Perdón, me debo haber equivocado de número.","en":"Sorry, I must've dialed the wrong number.","audio":"https://tatoeba.org/en/audio/download/422663","words":[null,{"g":"me"},{"g":"to owe","l":"deber"},{"g":"to have"},{"g":"mistaken, wrong"},{"g":"of / from"},{"g":"number"}]}]}