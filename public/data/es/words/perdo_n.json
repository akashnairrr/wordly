{"id":"perdo_n","lemma":"perdón","pos":"noun","rank":402,"glosses":["pardon","mercy"],"ipa":"/peɾˈdon/","gender":"m","forms":{"plural":"perdones"},"examples":[{"text":"Perdón, se me olvidó.","en":"Sorry, I forgot.","audio":"https://tatoeba.org/en/audio/download/442065"},{"text":"Te ruego que me perdones.","en":"I beg you to forgive me.","audio":"https://tatoeba.org/en/audio/download/459030"},{"text":"Perdón por la tardanza.","en":"Sorry for the delay.","audio":"https://tatoeba.org/en/audio/download/450388"},{"text":"Te pido que me perdones.","en":"I ask that you forgive me.","audio":"https://tatoeba.org/en/audio/download/639224"},{"text":"Vinimos a pedir perdón.","en":"We came to apologize.","audio":"https://tatoeba.org/en/audio/download/454726"}]}