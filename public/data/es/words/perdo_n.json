{"id":"perdo_n","lemma":"perdón","pos":"noun","rank":399,"glosses":["pardon","mercy"],"ipa":"/peɾˈdon/","gender":"m","forms":{"plural":"perdones"},"examples":[{"text":"Perdón, ¿dijiste algo?","en":"I'm sorry, did you say something?","audio":"https://tatoeba.org/en/audio/download/850338","words":[null,{"g":"to say","l":"decir"},{"g":"something, anything"}]},{"text":"Él me pidió perdón.","en":"He asked for my pardon.","audio":"https://tatoeba.org/en/audio/download/636425","words":[{"g":"he"},{"g":"me"},{"g":"to ask for something","l":"pedir"},null]},{"text":"Pido tu perdón.","en":"I ask your forgiveness.","audio":"https://tatoeba.org/en/audio/download/459998","words":[{"g":"to ask for something","l":"pedir"},{"g":"your"},null]},{"text":"Perdón por llegar tarde.","en":"Excuse me for being late.","audio":"https://tatoeba.org/en/audio/download/537892","words":[null,{"g":"for / by"},null,null],"phrases":[[2,4,"to be late"]]},{"text":"Te quiero pedir perdón.","en":"I want to ask you for forgiveness.","audio":"https://tatoeba.org/en/audio/download/506673","words":[null,null,{"g":"to ask for something"},null],"phrases":[[0,2,"I love you"]]}]}