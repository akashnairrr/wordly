{"id":"alta","lemma":"alta","pos":"noun","rank":795,"glosses":["certificate of discharge (from a hospital)","entry into a profession or organization","tax declaration, tax return"],"ipa":"/ˈalta/","gender":"f","forms":{"plural":"altas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/28/LL-Q1321_%28spa%29-AdrianAbdulBaha-alta.wav","examples":[{"text":"Ella no es alta.","en":"She is not tall.","audio":"https://tatoeba.org/en/audio/download/442007"},{"text":"Las olas están altas.","en":"The waves are high.","audio":"https://tatoeba.org/en/audio/download/501212"},{"text":"¿Tu esposa es alta?","en":"Is your wife tall?","audio":"https://tatoeba.org/en/audio/download/443870"},{"text":"Sois más altas que yo.","en":"You're taller than me.","audio":"https://tatoeba.org/en/audio/download/587216"},{"text":"Ojalá fuera más alta.","en":"I wish I were taller.","audio":"https://tatoeba.org/en/audio/download/39120"}]}