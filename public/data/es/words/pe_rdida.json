{"id":"pe_rdida","lemma":"pérdida","pos":"noun","rank":1293,"glosses":["loss","leak"],"ipa":"/ˈpeɾdida/","gender":"f","forms":{"plural":"pérdidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Rodrigo5260-p%C3%A9rdida.wav","examples":[{"text":"Su muerte es una gran pérdida.","en":"His death is a great loss.","audio":"https://tatoeba.org/en/audio/download/639530","words":[{"g":"his / her / your"},{"g":"death"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"¡Qué pérdida!","en":"What a loss!","audio":"https://tatoeba.org/en/audio/download/438812","words":[{"g":"what"},null]},{"text":"La compañía sufrió grandes pérdidas.","en":"The company suffered big losses.","words":[{"g":"the / her"},{"g":"company"},{"g":"to suffer","l":"sufrir"},{"g":"big, large","l":"grande"},null]},{"text":"Siento vuestra pérdida.","en":"I feel your loss.","audio":"https://tatoeba.org/en/audio/download/604928","words":[{"g":"to seat","l":"sentar"},{"g":"yours","l":"vuestro"},null]},{"text":"Siento mucho su pérdida.","en":"Sorry for your loss.","audio":"https://tatoeba.org/en/audio/download/448596","words":[{"g":"to seat","l":"sentar"},{"g":"much"},{"g":"his / her / your"},null]}]}