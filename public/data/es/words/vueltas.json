{"id":"vueltas","lemma":"vueltas","pos":"noun","rank":1505,"glosses":["go-back"],"ipa":"/ˈbweltas/","gender":"f","examples":[{"text":"Mi cabeza está dando vueltas.","en":"My head is spinning.","audio":"https://tatoeba.org/en/audio/download/450214"},{"text":"No te pases de vueltas, Tom.","en":"Dial it back, Tom.","audio":"https://tatoeba.org/en/audio/download/800092"},{"text":"Tom les ha dado tres vueltas.","en":"Tom was absolutely terrific.","audio":"https://tatoeba.org/en/audio/download/801483"},{"text":"Un helicóptero dio vueltas sobre nosotros.","en":"A helicopter circled over us.","audio":"https://tatoeba.org/en/audio/download/514905"},{"text":"No hay que darle más vueltas.","en":"There's no reason to think about it anymore.","audio":"https://tatoeba.org/en/audio/download/419284"}]}