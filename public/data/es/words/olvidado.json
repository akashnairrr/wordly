{"id":"olvidado","lemma":"olvidado","pos":"adj","rank":931,"glosses":["forgotten"],"ipa":"/olbiˈdado/","forms":{"feminine":"olvidada","masculinePlural":"olvidados","femininePlural":"olvidadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-Marreromarco-olvidado.wav","examples":[{"text":"He olvidado su nombre.","en":"I forget his name.","audio":"https://tatoeba.org/en/audio/download/444163"},{"text":"La tragedia de la guerra no debe ser olvidada.","en":"The tragedy of war must not be forgotten."},{"text":"Las revoluciones que fracasan son rápidamente olvidadas.","en":"Revolutions that don't succeed are soon forgotten."},{"text":"No me he olvidado.","en":"I haven't forgotten.","audio":"https://tatoeba.org/en/audio/download/450024"},{"text":"No lo he olvidado.","en":"I haven't forgotten.","audio":"https://tatoeba.org/en/audio/download/47758"}]}