{"id":"muera","lemma":"muera","pos":"noun","rank":1696,"glosses":["cooking salt"],"ipa":"/ˈmweɾa/","gender":"f","forms":{"plural":"mueras"},"examples":[{"text":"¡Muera el rey!","en":"Down with the king!","words":[null,{"g":"the"},{"g":"king"}]},{"text":"Te amaré hasta que me muera.","en":"I'll love you until I die.","audio":"https://tatoeba.org/en/audio/download/522037","words":[{"g":"you"},{"g":"to love","l":"amar"},null,null,{"g":"me"},null],"phrases":[[2,4,"until, till"]]},{"text":"Cuando muera, quiero ser cremado.","en":"When I die, I want to be cremated.","words":[{"g":"when"},null,{"g":"to desire","l":"querer"},{"g":"to be"},{"g":"to cremate","l":"cremar"}]},{"text":"Espero que no muera Tom.","en":"I hope Tom doesn't die.","audio":"https://tatoeba.org/en/audio/download/802839","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"no / not"},null,null]},{"text":"Espero que te mueras.","en":"I hope you die.","audio":"https://tatoeba.org/en/audio/download/800001","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"you"},null]}]}