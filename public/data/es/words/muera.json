{"id":"muera","lemma":"muera","pos":"noun","rank":1699,"glosses":["cooking salt"],"ipa":"/ˈmweɾa/","gender":"f","forms":{"plural":"mueras"},"examples":[{"text":"Espero que no muera Tom.","en":"I hope Tom doesn't die.","audio":"https://tatoeba.org/en/audio/download/802839"},{"text":"Espero que te mueras.","en":"I hope you die.","audio":"https://tatoeba.org/en/audio/download/800001"},{"text":"Te amaré hasta que me muera.","en":"I'll love you until I die.","audio":"https://tatoeba.org/en/audio/download/522037"},{"text":"No te mueras, Tom.","en":"Tom, don't die.","audio":"https://tatoeba.org/en/audio/download/40099"},{"text":"Espero que Tom no muera.","en":"I hope Tom doesn't die."}]}