{"id":"mala","lemma":"mala","pos":"noun","rank":446,"glosses":["suitcase","mailbag","mail, post"],"ipa":"/ˈmala/","gender":"f","forms":{"plural":"malas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-Marreromarco-mala.wav","examples":[{"text":"Tienes muy mala cara.","en":"You look awful.","audio":"https://tatoeba.org/en/audio/download/541044"},{"text":"Tengo malas noticias para ti.","en":"I have bad news for you.","audio":"https://tatoeba.org/en/audio/download/459006"},{"text":"¿Soy una mala persona?","en":"Am I a bad person?","audio":"https://tatoeba.org/en/audio/download/637152"},{"text":"Tengo malas noticias para vosotros.","en":"I have bad news for you.","audio":"https://tatoeba.org/en/audio/download/77061"},{"text":"Era una mala idea.","en":"It was a bad idea.","audio":"https://tatoeba.org/en/audio/download/103619"}]}