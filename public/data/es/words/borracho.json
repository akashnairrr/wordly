{"id":"borracho","lemma":"borracho","pos":"adj","rank":1101,"glosses":["drunk, inebriated","boozy (containing alcohol)"],"ipa":"/boˈrat͡ʃo/","forms":{"feminine":"borracha","masculinePlural":"borrachos","femininePlural":"borrachas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-borracho.wav","examples":[{"text":"Él estaba más o menos borracho.","en":"He was more or less drunk.","audio":"https://tatoeba.org/en/audio/download/764779","words":[{"g":"he"},{"g":"to be","l":"estar"},null,null,null,null],"phrases":[[2,5,"give or take"]]},{"text":"Ellos están borrachos.","en":"They're drunk.","audio":"https://tatoeba.org/en/audio/download/501471","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},null]},{"text":"Era un verdadero borracho.","en":"He was a real drunkard.","audio":"https://tatoeba.org/en/audio/download/636797","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"true, real"},null]},{"text":"Estamos demasiado borrachos.","en":"We're too drunk.","audio":"https://tatoeba.org/en/audio/download/461328","words":[{"g":"to be","l":"estar"},{"g":"too much"},null]},{"text":"Estás borracha.","en":"You're drunk.","audio":"https://tatoeba.org/en/audio/download/263687","words":[{"g":"to be","l":"estar"},null]}]}