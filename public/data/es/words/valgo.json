{"id":"valgo","lemma":"valgo","pos":"adj","rank":3708,"glosses":["valgus (abnormally turned outward, especially of the foot)"],"ipa":"/ˈbalɡo/","forms":{"feminine":"valga","masculinePlural":"valgos","femininePlural":"valgas"},"examples":[{"text":"Yo valgo más que esto.","en":"I'm worth more than this.","words":[{"g":"I"},null,null,null,{"g":"this"}],"phrases":[[2,4,"apart from"]]},{"text":"Espero que esto lo valga.","en":"I hope this is worth it.","audio":"https://tatoeba.org/en/audio/download/461196","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"this"},{"g":"it / him"},null]},{"text":"Al fin y al cabo, nada que valga la pena se consigue sin luchar.","en":"All in all, nothing worthwhile comes without a fight.","words":[null,null,{"g":"and"},null,null,{"g":"nothing"},{"g":"that"},null,{"g":"the / her"},{"g":"punishment, sentence"},{"g":"oneself"},{"g":"to achieve","l":"conseguir"},{"g":"without"},{"g":"to fight"}],"phrases":[[0,2,"at last"],[3,5,"in the end"]]}]}