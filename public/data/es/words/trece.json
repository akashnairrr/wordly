{"id":"trece","lemma":"trece","pos":"noun","rank":3894,"glosses":["thirteen"],"ipa":"/ˈtɾeθe/","gender":"m","forms":{"plural":"treces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-AdrianAbdulBaha-trece.wav","examples":[{"text":"Trece personas han muerto.","en":"Thirteen people have died.","audio":"https://tatoeba.org/en/audio/download/523264","words":[null,{"g":"person (an individual","l":"persona"},{"g":"to have","l":"haber"},{"g":"dead"}]},{"text":"Tengo trece años.","en":"I'm thirteen.","audio":"https://tatoeba.org/en/audio/download/305367","words":[{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Tengo una hija de trece años.","en":"I have a daughter who's 13 years old.","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"daughter"},{"g":"of / from"},null,{"g":"year","l":"año"}]},{"text":"Mi papá murió cuando yo tenía trece años.","en":"My dad died when I was thirteen.","audio":"https://tatoeba.org/en/audio/download/823795","words":[{"g":"my"},{"g":"dad"},{"g":"to die","l":"morir"},{"g":"when"},{"g":"I"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Mi hermana hará trece años el próximo verano.","en":"My sister will be thirteen years old next summer.","audio":"https://tatoeba.org/en/audio/download/599285","words":[{"g":"my"},{"g":"sister"},{"g":"to do","l":"hacer"},null,{"g":"year","l":"año"},{"g":"the"},{"g":"near"},{"g":"summer"}]}]}