{"id":"agenda","lemma":"agenda","pos":"noun","rank":2406,"glosses":["agenda, planner (notebook)","agenda (list of matters to be taken up)"],"ipa":"/aˈxenda/","gender":"f","forms":{"plural":"agendas"},"order":2419,"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q1321_%28spa%29-Marreromarco-agenda.wav","examples":[{"text":"Tengo la agenda muy llena.","en":"I've got a very full schedule.","audio":"https://tatoeba.org/en/audio/download/541254","words":[{"g":"to have","l":"tener"},{"g":"the / her"},null,{"g":"very"},{"g":"full","l":"lleno"}]},{"text":"Mi agenda es de locos.","en":"My schedule is insane.","audio":"https://tatoeba.org/en/audio/download/302001","words":[{"g":"my"},null,{"g":"to be","l":"ser"},null,null],"phrases":[[3,5,"crazy"]]},{"text":"Él cambia su agenda de día a día.","en":"He changes his schedule from day to day.","words":[{"g":"he"},{"g":"to change","l":"cambiar"},{"g":"his / her / your"},null,null,null,{"g":"to"},{"g":"day"}],"phrases":[[4,6,"in the daytime"]]}]}