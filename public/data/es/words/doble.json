{"id":"doble","lemma":"doble","pos":"adj","rank":865,"glosses":["double","twofold"],"ipa":"/ˈdoble/","forms":{"femininePlural":"dobles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Marreromarco-doble.wav","examples":[{"text":"Yo tengo el doble de tu edad.","en":"I'm twice your age.","audio":"https://tatoeba.org/en/audio/download/450403","words":[{"g":"I"},{"g":"to have","l":"tener"},{"g":"the"},null,{"g":"of / from"},{"g":"your"},{"g":"age"}]},{"text":"Él es el doble de viejo que yo.","en":"He is twice as old as I am.","audio":"https://tatoeba.org/en/audio/download/25354","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"the"},null,null,null,{"g":"that"},{"g":"I"}],"phrases":[[4,6,"second-hand"]]},{"text":"Nos gustaría una habitación doble con baño.","en":"We'd like a double room with bath.","audio":"https://tatoeba.org/en/audio/download/705505","words":[{"g":"us"},{"g":"to like in a general…","l":"gustar"},{"g":"a"},{"g":"room"},null,{"g":"with"},{"g":"bath"}]},{"text":"Estoy viendo doble.","en":"I'm seeing double.","audio":"https://tatoeba.org/en/audio/download/443905","words":[{"g":"to be","l":"estar"},{"g":"to see, to spot","l":"ver"},null]},{"text":"Sólo hay una cama doble.","en":"There's only a double bed.","audio":"https://tatoeba.org/en/audio/download/604900","words":[null,{"g":"to have","l":"haber"},{"g":"a"},{"g":"bed"},null]}]}