{"id":"debajo","lemma":"debajo","pos":"adv","rank":792,"glosses":["underneath","below"],"ipa":"/deˈbaxo/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Marreromarco-debajo.wav","examples":[{"text":"Salió de debajo del coche.","en":"He got out from under the car.","audio":"https://tatoeba.org/en/audio/download/641914"},{"text":"No miré debajo del sofá.","en":"I didn't look under the couch.","audio":"https://tatoeba.org/en/audio/download/451396"},{"text":"Lo escondí debajo de mi cama.","en":"I hid it under my bed.","audio":"https://tatoeba.org/en/audio/download/83171"},{"text":"Me escondí debajo de la mesa.","en":"I hid under the table.","audio":"https://tatoeba.org/en/audio/download/39937"},{"text":"¿Puedes nadar por debajo del agua?","en":"Can you swim underwater?","audio":"https://tatoeba.org/en/audio/download/40240"}]}