{"id":"asco","lemma":"asco","pos":"noun","rank":1773,"glosses":["disgust","quality of being disgusting","nausea"],"ipa":"/ˈasko/","gender":"m","forms":{"plural":"ascos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-Marreromarco-asco.wav","examples":[{"text":"Tom me da asco.","en":"Tom disgusts me.","audio":"https://tatoeba.org/en/audio/download/799916"},{"text":"No le hago ascos a nada.","en":"I'm not afraid of anything.","audio":"https://tatoeba.org/en/audio/download/931484"},{"text":"Tom estará muerto de asco.","en":"Tom will be bored stiff.","audio":"https://tatoeba.org/en/audio/download/803586"},{"text":"A mí también me da asco.","en":"It disgusts me, too.","audio":"https://tatoeba.org/en/audio/download/449168"},{"text":"La verdad es que me da asco.","en":"The truth is that it disgusts me.","audio":"https://tatoeba.org/en/audio/download/296208"}]}