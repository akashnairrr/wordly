{"id":"asco","lemma":"asco","pos":"noun","rank":1770,"glosses":["disgust","quality of being disgusting","nausea"],"ipa":"/ˈasko/","gender":"m","forms":{"plural":"ascos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-Marreromarco-asco.wav","examples":[{"text":"Me das asco.","en":"You disgust me.","audio":"https://tatoeba.org/en/audio/download/441444","words":[{"g":"me"},{"g":"to give, to give out","l":"dar"},null]},{"text":"A mí también me da asco.","en":"It disgusts me, too.","audio":"https://tatoeba.org/en/audio/download/449168","words":[{"g":"to"},{"g":"me"},{"g":"also, too, as well"},{"g":"me"},{"g":"to give, to give out","l":"dar"},null]},{"text":"No le hago ascos a nada.","en":"I'm not afraid of anything.","audio":"https://tatoeba.org/en/audio/download/931484","words":[{"g":"no / not"},{"g":"him / her"},{"g":"to do","l":"hacer"},null,{"g":"to"},{"g":"nothing"}]},{"text":"La verdad es que me da asco.","en":"The truth is that it disgusts me.","audio":"https://tatoeba.org/en/audio/download/296208","words":[null,null,null,null,{"g":"me"},{"g":"to give, to give out","l":"dar"},null],"phrases":[[0,2,"honestly, to be honest"],[2,4,"implies"]]},{"text":"Esas cosas me dan asco.","en":"Those things disgust me.","words":[{"g":"that","l":"ese"},{"g":"thing","l":"cosa"},{"g":"me"},{"g":"dan"},null]}]}