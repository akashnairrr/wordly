{"id":"abajo","lemma":"abajo","pos":"adv","rank":330,"glosses":["down, downwards","downstairs","below"],"ipa":"/aˈbaxo/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-AdrianAbdulBaha-abajo.wav","examples":[{"text":"Yo miré hacia abajo.","en":"I looked down.","audio":"https://tatoeba.org/en/audio/download/440323"},{"text":"Hace calor aquí abajo.","en":"It's hot down here.","audio":"https://tatoeba.org/en/audio/download/450621"},{"text":"Me deslicé barra abajo.","en":"I slid down the pole.","audio":"https://tatoeba.org/en/audio/download/512078"},{"text":"¿Hay alguien ahí abajo?","en":"Is somebody down there?","audio":"https://tatoeba.org/en/audio/download/460979"},{"text":"Por favor, vayan abajo.","en":"Please come downstairs.","audio":"https://tatoeba.org/en/audio/download/587232"}]}