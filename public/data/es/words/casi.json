{"id":"casi","lemma":"casi","pos":"adv","rank":237,"glosses":["almost"],"ipa":"/ˈkasi/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-AdrianAbdulBaha-casi.wav","examples":[{"text":"Ya casi es hora.","en":"It's about time.","audio":"https://tatoeba.org/en/audio/download/441861"},{"text":"Son casi las seis.","en":"It's almost six.","audio":"https://tatoeba.org/en/audio/download/441843"},{"text":"Casi tengo treinta años.","en":"I'm almost thirty.","audio":"https://tatoeba.org/en/audio/download/443475"},{"text":"Casi nunca se rinde.","en":"He rarely gives up.","audio":"https://tatoeba.org/en/audio/download/636524"},{"text":"Casi se me olvida.","en":"I almost forgot it.","audio":"https://tatoeba.org/en/audio/download/450467"}]}