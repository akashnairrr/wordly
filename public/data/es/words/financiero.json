{"id":"financiero","lemma":"financiero","pos":"adj","rank":3974,"glosses":["financial"],"ipa":"/finanˈθjeɾo/","forms":{"feminine":"financiera","masculinePlural":"financieros","femininePlural":"financieras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Marreromarco-financiero.wav","examples":[{"text":"El nuevo gobierno tiene problemas financieros.","en":"The new government has financial troubles.","audio":"https://tatoeba.org/en/audio/download/926273","words":[{"g":"the"},{"g":"new"},{"g":"government"},{"g":"to have","l":"tener"},{"g":"problem","l":"problema"},null]},{"text":"Nuestros problemas financieros son serios.","en":"Our financial problems are serious.","words":[{"g":"our, ours, to us","l":"nuestro"},{"g":"problem","l":"problema"},null,{"g":"to be","l":"ser"},{"g":"serious","l":"serio"}]},{"text":"Ellos están enfrentando problemas financieros.","en":"They are facing financial problems.","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},{"g":"to confront, to face","l":"enfrentar"},{"g":"problem","l":"problema"},null]},{"text":"La compañía se encuentra en apuros financieros.","en":"The company is in financial difficulties.","words":[{"g":"the / her"},{"g":"company"},{"g":"oneself"},{"g":"to meet","l":"encontrar"},{"g":"in / on"},{"g":"difficulty","l":"apuro"},null]},{"text":"Tom está pasando por problemas financieros.","en":"Tom is facing financial problems.","words":[null,{"g":"to be","l":"estar"},{"g":"to pass","l":"pasar"},{"g":"for / by"},{"g":"problem","l":"problema"},null]}]}