{"id":"alquiler","lemma":"alquiler","pos":"noun","rank":1878,"glosses":["rent (a payment made in exchange for something borrowed, and its amount)"],"ipa":"/alkiˈleɾ/","gender":"m","forms":{"plural":"alquileres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q1321_%28spa%29-Marreromarco-alquiler.wav","examples":[{"text":"El alquiler es barato.","en":"The rent is cheap.","audio":"https://tatoeba.org/en/audio/download/449187"},{"text":"Están pagando el alquiler.","en":"They're paying rent.","audio":"https://tatoeba.org/en/audio/download/450736"},{"text":"¿Has pagado el alquiler?","en":"Have you paid the rent?","audio":"https://tatoeba.org/en/audio/download/139505"},{"text":"¿Quién va a pagar el alquiler?","en":"Who'll pay the rent?","audio":"https://tatoeba.org/en/audio/download/455186"},{"text":"¿Cuándo hay que pagar el alquiler?","en":"When is the rent due?","audio":"https://tatoeba.org/en/audio/download/611262"}]}