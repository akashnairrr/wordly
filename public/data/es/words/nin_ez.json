{"id":"nin_ez","lemma":"niñez","pos":"noun","rank":4663,"glosses":["childhood"],"ipa":"/niˈɲeθ/","gender":"f","forms":{"plural":"niñeces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-AdrianAbdulBaha-ni%C3%B1ez.wav","examples":[{"text":"Tuve una niñez bastante feliz.","en":"I had a pretty happy childhood.","audio":"https://tatoeba.org/en/audio/download/297474","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"quite"},{"g":"happy, merry"}]},{"text":"Hablemos de tu niñez.","en":"Let's talk about your childhood.","audio":"https://tatoeba.org/en/audio/download/594456","words":[{"g":"to talk","l":"hablar"},{"g":"of / from"},{"g":"your"},null]},{"text":"Me recuerda a mi niñez.","en":"It reminds me of my childhood.","words":[{"g":"me"},{"g":"to remember","l":"recordar"},{"g":"to"},{"g":"my"},null]},{"text":"¿Cuál es tu primer recuerdo de la niñez?","en":"What is your earliest memory from childhood?","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"memory"},null,null,null],"phrases":[[5,7,"of the"]]},{"text":"Su niñez fue dura.","en":"His childhood was harsh.","words":[{"g":"his / her / your"},null,{"g":"to be","l":"ser"},{"g":"hard","l":"duro"}]}]}