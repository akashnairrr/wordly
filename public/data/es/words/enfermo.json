{"id":"enfermo","lemma":"enfermo","pos":"adj","rank":798,"glosses":["sick, ill","degenerate"],"ipa":"/enˈfeɾmo/","forms":{"feminine":"enferma","masculinePlural":"enfermos","femininePlural":"enfermas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/de/LL-Q1321_%28spa%29-AdrianAbdulBaha-enfermo.wav","formAudio":{"enferma":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-Wikipedian-walker-enferma.wav"},"examples":[{"text":"Él se ve enfermo.","en":"He seems ill.","audio":"https://tatoeba.org/en/audio/download/438555"},{"text":"¿De verdad estoy enferma?","en":"Am I really sick?","audio":"https://tatoeba.org/en/audio/download/800078"},{"text":"Muchos de los hombres se pusieron enfermos.","en":"Many of the men became sick.","audio":"https://tatoeba.org/en/audio/download/642225"},{"text":"Al comienzo, pensé que estaban enfermas.","en":"At first, I thought they were sick."},{"text":"Su hijo está enfermo.","en":"His son is ill.","audio":"https://tatoeba.org/en/audio/download/637160"}]}