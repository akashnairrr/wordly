{"id":"piso","lemma":"piso","pos":"noun","rank":688,"glosses":["floor, ground (surface of the earth)","floor, story, storey (level of a building)","flat, apartment"],"ipa":"/ˈpiso/","gender":"m","forms":{"plural":"pisos"},"examples":[{"text":"¿En qué piso vivís?","en":"What floor do you live on?","audio":"https://tatoeba.org/en/audio/download/524434"},{"text":"El edificio tiene veinte pisos.","en":"The building has twenty floors.","audio":"https://tatoeba.org/en/audio/download/733508"},{"text":"Estoy ocupado buscando piso.","en":"I'm busy looking for an apartment.","audio":"https://tatoeba.org/en/audio/download/526954"},{"text":"Este edificio tiene 5 pisos y 20 apartamentos.","en":"This building has 5 floors and 20 apartments.","audio":"https://tatoeba.org/en/audio/download/531693"},{"text":"El piso estaba muy frío.","en":"The floor was very cold.","audio":"https://tatoeba.org/en/audio/download/587399"}]}