{"id":"honor","lemma":"honor","pos":"noun","rank":687,"glosses":["honor"],"ipa":"/oˈnoɾ/","gender":"m","forms":{"plural":"honores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-honor.wav","examples":[{"text":"¿Me harás el honor de cenar conmigo?","en":"Will you do me the honor of dining with me?","audio":"https://tatoeba.org/en/audio/download/694005","words":[{"g":"me"},{"g":"to do","l":"hacer"},{"g":"the"},null,{"g":"of / from"},{"g":"to dine"},{"g":"with me"}]},{"text":"Sería un honor para mí.","en":"I'd be honored.","audio":"https://tatoeba.org/en/audio/download/440859","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[3,5,"in my opinion"]]},{"text":"Tom se graduó con honores.","en":"Tom graduated with honors.","audio":"https://tatoeba.org/en/audio/download/806380","words":[null,{"g":"oneself"},{"g":"to graduate","l":"graduar"},{"g":"with"},null]},{"text":"Ella fue dama de honor en la boda.","en":"She was a bridesmaid at the wedding.","audio":"https://tatoeba.org/en/audio/download/687415","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"lady, dame"},{"g":"of / from"},null,{"g":"in / on"},{"g":"the / her"},{"g":"wedding"}]},{"text":"Sin honor, la victoria pierde sentido.","en":"Without honor, victory is hollow.","words":[{"g":"without"},null,null,null,{"g":"to lose","l":"perder"},{"g":"sense"}],"phrases":[[2,4,"a department of Chile"]]}]}