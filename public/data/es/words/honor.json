{"id":"honor","lemma":"honor","pos":"noun","rank":687,"glosses":["honor"],"ipa":"/oˈnoɾ/","gender":"m","forms":{"plural":"honores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-honor.wav","examples":[{"text":"Sería un honor para mí.","en":"I'd be honored.","audio":"https://tatoeba.org/en/audio/download/440859","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[3,5,"in my opinion"]]},{"text":"¿Me harás el honor de cenar conmigo?","en":"Will you do me the honor of dining with me?","audio":"https://tatoeba.org/en/audio/download/694005","words":[{"g":"me"},{"g":"to do","l":"hacer"},{"g":"the"},null,{"g":"of / from"},{"g":"to dine"},{"g":"with me"}]},{"text":"Ella se graduó con honores.","en":"She graduated with honors.","words":[{"g":"she"},{"g":"oneself"},{"g":"to graduate","l":"graduar"},{"g":"with"},null]},{"text":"Pensé que eras un hombre de honor.","en":"I thought you were a man of honor.","words":[{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"era, age","l":"era"},{"g":"a"},{"g":"man"},{"g":"of / from"},null]},{"text":"No hay honor entre ladrones.","en":"There is no honor among thieves.","audio":"https://tatoeba.org/en/audio/download/1191496","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"between"},{"g":"thief","l":"ladrón"}]}]}