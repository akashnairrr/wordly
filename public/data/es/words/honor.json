{"id":"honor","lemma":"honor","pos":"noun","rank":690,"glosses":["honor"],"ipa":"/oˈnoɾ/","gender":"m","forms":{"plural":"honores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-honor.wav","examples":[{"text":"Sería un honor para mí.","en":"I'd be honored.","audio":"https://tatoeba.org/en/audio/download/440859"},{"text":"Tom se graduó con honores.","en":"Tom graduated with honors.","audio":"https://tatoeba.org/en/audio/download/806380"},{"text":"No hay honor entre ladrones.","en":"There is no honor among thieves.","audio":"https://tatoeba.org/en/audio/download/1191496"},{"text":"Ella se graduó con honores.","en":"She graduated with honors."},{"text":"¿Me harás el honor de cenar conmigo?","en":"Will you do me the honor of dining with me?","audio":"https://tatoeba.org/en/audio/download/694005"}]}