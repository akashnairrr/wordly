{"id":"plan","lemma":"plan","pos":"noun","rank":389,"glosses":["plan","scheme (systematic plan of future action)","intention"],"ipa":"/ˈplan/","gender":"m","forms":{"plural":"planes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Marreromarco-plan.wav","examples":[{"text":"Yo tengo un plan.","en":"I have a plan.","audio":"https://tatoeba.org/en/audio/download/440298"},{"text":"He hecho otros planes.","en":"I made other plans.","audio":"https://tatoeba.org/en/audio/download/448616"},{"text":"Este es mi plan.","en":"That's my plan.","audio":"https://tatoeba.org/en/audio/download/799439"},{"text":"¿Cuáles son tus planes?","en":"What're your plans?","audio":"https://tatoeba.org/en/audio/download/501553"},{"text":"¿Cuál es el plan?","en":"What's the plan?","audio":"https://tatoeba.org/en/audio/download/442224"}]}