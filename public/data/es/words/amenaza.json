{"id":"amenaza","lemma":"amenaza","pos":"noun","rank":1159,"glosses":["threat, menace, an indication of danger","threat, menace, an expression of intent"],"ipa":"/ameˈnaθa/","gender":"f","forms":{"plural":"amenazas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-AdrianAbdulBaha-amenaza.wav","examples":[{"text":"Ellos no son una amenaza.","en":"They're not a threat.","audio":"https://tatoeba.org/en/audio/download/454008","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Eso suena como una amenaza.","en":"That sounds like a threat.","audio":"https://tatoeba.org/en/audio/download/518266","words":[{"g":"that","l":"ése"},{"g":"to sound, to ring","l":"sonar"},{"g":"as"},{"g":"a"},null]},{"text":"La amenaza es real.","en":"The threat is real.","words":[{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"real"}]},{"text":"Eso casi parece amenaza.","en":"That almost sounds like a threat.","words":[{"g":"that","l":"ése"},{"g":"almost"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"Tú eres una amenaza.","en":"You're a menace.","audio":"https://tatoeba.org/en/audio/download/831423","words":[{"g":"you"},{"g":"to be","l":"ser"},{"g":"a"},null]}]}