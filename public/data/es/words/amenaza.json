{"id":"amenaza","lemma":"amenaza","pos":"noun","rank":1159,"glosses":["threat, menace, an indication of danger","threat, menace, an expression of intent"],"ipa":"/ameˈnaθa/","gender":"f","forms":{"plural":"amenazas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/13/LL-Q1321_%28spa%29-AdrianAbdulBaha-amenaza.wav","examples":[{"text":"Tú eres una amenaza.","en":"You're a menace.","audio":"https://tatoeba.org/en/audio/download/831423","words":[{"g":"you"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Es usted una amenaza.","en":"You're a menace.","audio":"https://tatoeba.org/en/audio/download/831424","words":[{"g":"to be","l":"ser"},{"g":"you (formal)"},{"g":"a"},null]},{"text":"No me asustan tus amenazas.","en":"Your threats don't frighten me.","audio":"https://tatoeba.org/en/audio/download/590019","words":[{"g":"no / not"},{"g":"me"},{"g":"to scare","l":"asustar"},{"g":"your"},null]},{"text":"Ellos no son una amenaza.","en":"They're not a threat.","audio":"https://tatoeba.org/en/audio/download/454008","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Eso suena como una amenaza.","en":"That sounds like a threat.","audio":"https://tatoeba.org/en/audio/download/518266","words":[{"g":"that","l":"ése"},{"g":"to sound, to ring","l":"sonar"},{"g":"as"},{"g":"a"},null]}]}