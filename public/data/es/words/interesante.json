{"id":"interesante","lemma":"interesante","pos":"adj","rank":606,"glosses":["interesting"],"ipa":"/inteɾeˈsante/","forms":{"femininePlural":"interesantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-Marreromarco-interesante.wav","examples":[{"text":"Eso no es interesante.","en":"That's not interesting.","audio":"https://tatoeba.org/en/audio/download/461061"},{"text":"Encuentro las lenguas extranjeras muy interesantes.","en":"I find foreign languages very interesting.","audio":"https://tatoeba.org/en/audio/download/587254"},{"text":"¿Ese libro es interesante?","en":"Is that book interesting?","audio":"https://tatoeba.org/en/audio/download/519242"},{"text":"Hay muchos animales interesantes en Australia.","en":"There are many interesting animals in Australia.","audio":"https://tatoeba.org/en/audio/download/586967"},{"text":"El espectáculo fue interesante.","en":"The show was interesting.","audio":"https://tatoeba.org/en/audio/download/516357"}]}