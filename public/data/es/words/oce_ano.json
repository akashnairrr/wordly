{"id":"oce_ano","lemma":"océano","pos":"noun","rank":1775,"glosses":["ocean"],"ipa":"/oˈθeano/","gender":"m","forms":{"plural":"océanos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q1321_%28spa%29-AdrianAbdulBaha-oc%C3%A9ano.wav","examples":[{"text":"Puedo oler el océano.","en":"I can smell the ocean.","audio":"https://tatoeba.org/en/audio/download/453968"},{"text":"El océano Pacífico es uno de los cinco océanos.","en":"The Pacific Ocean is one of the five oceans.","audio":"https://tatoeba.org/en/audio/download/590363"},{"text":"Volamos sobre el océano Pacífico.","en":"We're flying over the Pacific.","audio":"https://tatoeba.org/en/audio/download/798386"},{"text":"La Tierra tiene cinco océanos.","en":"The world has five oceans."},{"text":"Este río desemboca en el Océano Pacífico.","en":"This river flows into the Pacific Ocean.","audio":"https://tatoeba.org/en/audio/download/599114"}]}