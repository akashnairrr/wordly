{"id":"copia","lemma":"copia","pos":"noun","rank":1531,"glosses":["copy (a duplicate of an original)","abundance"],"ipa":"/ˈkopja/","gender":"f","forms":{"plural":"copias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-AdrianAbdulBaha-copia.wav","examples":[{"text":"Por favor, copia esto.","en":"Please copy this.","audio":"https://tatoeba.org/en/audio/download/443183"},{"text":"Tengo cinco copias, pero necesito el doble.","en":"I have five copies, but I need twice as many.","audio":"https://tatoeba.org/en/audio/download/691956"},{"text":"Copia esto, por favor.","en":"Copy this, please.","audio":"https://tatoeba.org/en/audio/download/443775"},{"text":"Hágame tres copias de cada página, por favor.","en":"Please make three copies of each page.","audio":"https://tatoeba.org/en/audio/download/534293"},{"text":"Dale esta copia a Tom.","en":"Give this copy to Tom.","audio":"https://tatoeba.org/en/audio/download/194641"}]}