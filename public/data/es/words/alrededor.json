{"id":"alrededor","lemma":"alrededor","pos":"adv","rank":531,"glosses":["around (from place to place)"],"ipa":"/alredeˈdoɾ/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q1321_%28spa%29-Marreromarco-alrededor.wav","examples":[{"text":"Revisa a nuestro alrededor.","en":"Check around.","audio":"https://tatoeba.org/en/audio/download/439006"},{"text":"Miré a mi alrededor.","en":"I looked around.","audio":"https://tatoeba.org/en/audio/download/441747"},{"text":"Corrí alrededor del campo.","en":"I ran around the field.","audio":"https://tatoeba.org/en/audio/download/461973"},{"text":"No había nadie alrededor.","en":"There was no one about.","audio":"https://tatoeba.org/en/audio/download/707002"},{"text":"Corrimos alrededor del parque.","en":"We ran around the park.","audio":"https://tatoeba.org/en/audio/download/461753"}]}