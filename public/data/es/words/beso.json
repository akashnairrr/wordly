{"id":"beso","lemma":"beso","pos":"noun","rank":948,"glosses":["kiss"],"ipa":"/ˈbeso/","gender":"m","forms":{"plural":"besos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q1321_%28spa%29-Rodrigo5260-beso.wav","formAudio":{"besos":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-Marreromarco-besos.wav"},"examples":[{"text":"Dame un beso.","en":"Give me a kiss.","audio":"https://tatoeba.org/en/audio/download/128163","words":[{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"Él le dio su primer beso.","en":"He gave her her first kiss.","audio":"https://tatoeba.org/en/audio/download/639225","words":[{"g":"he"},{"g":"him / her"},{"g":"to give, to give out","l":"dar"},{"g":"his / her / your"},null,null]},{"text":"Eres la primera chica que beso.","en":"You're the first girl I've ever kissed.","audio":"https://tatoeba.org/en/audio/download/728365","words":[{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"first gear"},{"g":"gal, chick"},{"g":"that"},null]},{"text":"Tus besos saben a canela.","en":"Your kisses taste like cinnamon.","audio":"https://tatoeba.org/en/audio/download/731601","words":[{"g":"your"},null,{"g":"to know, to understand","l":"saber"},{"g":"to"},{"g":"cinnamon"}]},{"text":"Creo que me debes un beso.","en":"I think you owe me a kiss.","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"me"},{"g":"to owe","l":"deber"},{"g":"a"},null]}]}