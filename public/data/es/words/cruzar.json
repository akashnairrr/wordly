load/730223","words":[{"g":"tour"},{"g":"to"},{"g":"the / her"},{"g":"right"},{"g":"in / on"},{"g":"the"},null]},{"text":"Estoy cruzando mis dedos.","en":"I'm crossing my fingers.","audio":"https://tatoeba.org/en/audio/download/608006","words":[{"g":"to be","l":"estar"},null,{"g":"my"},{"g":"digit: finger or toe","l":"dedo"}]},{"text":"No se me cruzó por la cabeza.","en":"It hadn't crossed my mind.","audio":"https://tatoeba.org/en/audio/download/594234","words":[{"g":"no / not"},{"g":"oneself"},{"g":"me"},null,{"g":"for / by"},{"g":"the / her"},{"g":"head"}]},{"text":"Hay un hotel al cruzar la calle.","en":"There's a hotel across the street.","audio":"https://tatoeba.org/en/audio/download/608607","words":[{"g":"to have","l":"haber"},{"g":"a"},{"g":"hotel"},{"g":"to the"},null,{"g":"the / her"},{"g":"street"}]}]}