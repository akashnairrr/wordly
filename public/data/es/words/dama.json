{"id":"dama","lemma":"dama","pos":"noun","rank":1006,"glosses":["lady, dame","a female member of the court of honor at a quinceañera","queen"],"ipa":"/ˈdama/","gender":"f","forms":{"plural":"damas","masculine":"caballero","masculinePlural":"caballeros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-AdrianAbdulBaha-dama.wav","formAudio":{"damas":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q1321_%28spa%29-Emanuelps27-damas.wav","caballero":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav"},"examples":[{"text":"La dama se quedó callada.","en":"The lady remained silent.","audio":"https://tatoeba.org/en/audio/download/639744"},{"text":"No quiero jugar a las damas.","en":"I don't want to play checkers.","audio":"https://tatoeba.org/en/audio/download/585822"},{"text":"Él es un caballero.","en":"He is a gentleman.","audio":"https://tatoeba.org/en/audio/download/444104"},{"text":"Con su permiso, caballeros.","en":"Excuse me, gentlemen.","audio":"https://tatoeba.org/en/audio/download/845732"},{"text":"Su abuela es una dama encantadora.","en":"Your grandmother is a charming lady.","audio":"https://tatoeba.org/en/audio/download/915742"}]}