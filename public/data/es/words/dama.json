{"id":"dama","lemma":"dama","pos":"noun","rank":1003,"glosses":["lady, dame","a female member of the court of honor at a quinceañera","queen"],"ipa":"/ˈdama/","gender":"f","forms":{"plural":"damas","masculine":"caballero","masculinePlural":"caballeros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-AdrianAbdulBaha-dama.wav","formAudio":{"damas":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q1321_%28spa%29-Emanuelps27-damas.wav","caballero":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav"},"examples":[{"text":"Su abuela es una dama encantadora.","en":"Your grandmother is a charming lady.","audio":"https://tatoeba.org/en/audio/download/915742","words":[{"g":"his / her / your"},{"g":"grandmother"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"charming","l":"encantador"}]},{"text":"¿Conoces a esta dama?","en":"Do you know this lady?","words":[{"g":"to know","l":"conocer"},{"g":"to"},{"g":"this","l":"este"},null]},{"text":"Veo un señor y una dama.","en":"I see a gentleman and a lady.","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"mister, sir, lord"},{"g":"and"},{"g":"a"},null]},{"text":"Él saludó a la dama.","en":"He greeted the lady.","words":[{"g":"he"},{"g":"to greet","l":"saludar"},{"g":"to"},{"g":"the / her"},null]},{"text":"La dama se quedó callada.","en":"The lady remained silent.","audio":"https://tatoeba.org/en/audio/download/639744","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to be , to end up","l":"quedar"},{"g":"quiet, silent","l":"callado"}]}]}