{"id":"dama","lemma":"dama","pos":"noun","rank":1003,"glosses":["lady, dame","a female member of the court of honor at a quinceañera","queen"],"ipa":"/ˈdama/","gender":"f","forms":{"plural":"damas","masculine":"caballero","masculinePlural":"caballeros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-AdrianAbdulBaha-dama.wav","formAudio":{"damas":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q1321_%28spa%29-Emanuelps27-damas.wav","caballero":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-caballero.wav"},"examples":[{"text":"Ella fue dama de honor en la boda.","en":"She was a bridesmaid at the wedding.","audio":"https://tatoeba.org/en/audio/download/687415","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"honor"},{"g":"in / on"},{"g":"the / her"},{"g":"wedding"}]},{"text":"Su abuela es una dama encantadora.","en":"Your grandmother is a charming lady.","audio":"https://tatoeba.org/en/audio/download/915742","words":[{"g":"his / her / your"},{"g":"grandmother"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"charming","l":"encantador"}]},{"text":"¿Conoces a esta dama?","en":"Do you know this lady?","words":[{"g":"to know","l":"conocer"},{"g":"to"},{"g":"this","l":"este"},null]},{"text":"Le di mi asiento a la dama mayor.","en":"I gave my seat to the old lady.","words":[{"g":"him / her"},{"g":"Used as a friendly…"},{"g":"my"},{"g":"seat"},{"g":"to"},{"g":"the / her"},null,{"g":"of age"}]},{"text":"Veo un señor y una dama.","en":"I see a gentleman and a lady.","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"mister, sir, lord"},{"g":"and"},{"g":"a"},null]}]}