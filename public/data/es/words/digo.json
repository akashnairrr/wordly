{"id":"digo","lemma":"digo","pos":"intj","rank":204,"glosses":["I mean; used to explain or correct a previous utterance"],"ipa":"/ˈdiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Marreromarco-digo.wav","examples":[{"text":"¿Entiendes lo que te digo?","en":"Do you understand what I'm saying?","audio":"https://tatoeba.org/en/audio/download/553891","words":[{"g":"to understand","l":"entender"},null,null,{"g":"you"},null],"phrases":[[1,3,"what, that which"]]},{"text":"Hazlo como te digo.","en":"Do as I tell you.","audio":"https://tatoeba.org/en/audio/download/65895","words":[{"g":"to do","l":"hacer"},{"g":"as"},{"g":"you"},null]},{"text":"¿Qué pasa si digo que no?","en":"What happens if I say no?","audio":"https://tatoeba.org/en/audio/download/606528","words":[null,null,{"g":"if, whether"},null,{"g":"that"},{"g":"no / not"}],"phrases":[[0,2,"what's up?"]]},{"text":"Por favor, recuerda lo que te digo.","en":"Please remember what I tell you.","audio":"https://tatoeba.org/en/audio/download/803841","words":[null,null,{"g":"to remember","l":"recordar"},null,null,{"g":"you"},null],"phrases":[[0,2,"please"],[3,5,"what, that which"]]},{"text":"Hablo en serio cuando digo que te quiero.","en":"I mean it when I say that I love you.","audio":"https://tatoeba.org/en/audio/download/687718","words":[{"g":"to talk","l":"hablar"},null,null,{"g":"when"},null,{"g":"that"},null,null],"phrases":[[1,3,"seriously"],[6,8,"I love you"]]}]}