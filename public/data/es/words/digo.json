{"id":"digo","lemma":"digo","pos":"intj","rank":204,"glosses":["I mean; used to explain or correct a previous utterance"],"ipa":"/ˈdiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Marreromarco-digo.wav","examples":[{"text":"Hazlo como te digo.","en":"Do as I tell you.","audio":"https://tatoeba.org/en/audio/download/65895","words":[{"g":"to do","l":"hacer"},{"g":"as"},{"g":"you"},null]},{"text":"Lo digo todo el tiempo.","en":"I say it all the time.","audio":"https://tatoeba.org/en/audio/download/453866","words":[{"g":"it / him"},null,null,null,null],"phrases":[[2,5,"all the time, always"]]},{"text":"Tienes que hacer como digo.","en":"You have to do as I say.","audio":"https://tatoeba.org/en/audio/download/515013","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to do"},{"g":"as"},null]},{"text":"¿Qué pasa si digo que no?","en":"What happens if I say no?","audio":"https://tatoeba.org/en/audio/download/606528","words":[null,null,{"g":"if, whether"},null,{"g":"that"},{"g":"no / not"}],"phrases":[[0,2,"what's up?"]]},{"text":"¿Entiendes lo que te digo?","en":"Do you understand what I'm saying?","audio":"https://tatoeba.org/en/audio/download/553891","words":[{"g":"to understand","l":"entender"},null,null,{"g":"you"},null],"phrases":[[1,3,"what, that which"]]}]}