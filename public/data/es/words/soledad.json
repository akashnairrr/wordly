{"id":"soledad","lemma":"soledad","pos":"noun","rank":2696,"glosses":["solitude"],"ipa":"/soleˈdad/","gender":"f","forms":{"plural":"soledades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f8/LL-Q1321_%28spa%29-AdrianAbdulBaha-soledad.wav","examples":[{"text":"Disfruto la soledad.","en":"I enjoy solitude.","audio":"https://tatoeba.org/en/audio/download/422564","words":[{"g":"to enjoy","l":"disfrutar"},{"g":"the / her"},null]},{"text":"No hay nada peor que la soledad.","en":"There's nothing worse than loneliness.","audio":"https://tatoeba.org/en/audio/download/586512","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"nothing"},{"g":"bad","l":"malo"},{"g":"that"},{"g":"the / her"},null]},{"text":"Hay quienes disfrutan la soledad.","en":"Some people enjoy solitude.","audio":"https://tatoeba.org/en/audio/download/806852","words":[{"g":"to have","l":"haber"},{"g":"who","l":"quien"},{"g":"to enjoy","l":"disfrutar"},{"g":"the / her"},null]},{"text":"La peor soledad es no sentirte a gusto contigo mismo.","en":"The worst loneliness is to not be comfortable with yourself.","audio":"https://tatoeba.org/en/audio/download/692386","words":[{"g":"the / her"},{"g":"bad","l":"malo"},null,{"g":"to be","l":"ser"},{"g":"no / not"},{"g":"to feel","l":"sentir"},null,null,{"g":"with you"},{"g":"same"}],"phrases":[[6,8,"at ease, comfortable"]]},{"text":"Disfruto de la soledad.","en":"I like being alone.","audio":"https://tatoeba.org/en/audio/download/422563","words":[{"g":"to enjoy","l":"disfrutar"},null,null,null],"phrases":[[1,3,"of the"]]}]}