{"id":"mejilla","lemma":"mejilla","pos":"noun","rank":4250,"glosses":["cheek"],"ipa":"/meˈxiʝa/","gender":"f","forms":{"plural":"mejillas"},"order":4251,"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q1321_%28spa%29-AdrianAbdulBaha-mejilla.wav","examples":[{"text":"Te besé en la mejilla.","en":"I kissed you on the cheek.","audio":"https://tatoeba.org/en/audio/download/1152476","words":[{"g":"you"},{"g":"to kiss","l":"besar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Sus mejillas estaban rojas.","en":"Her cheeks were red.","audio":"https://tatoeba.org/en/audio/download/735672","words":[{"g":"his, her, its, their"},null,{"g":"to be","l":"estar"},{"g":"red","l":"rojo"}]},{"text":"Ella me dio un beso en la mejilla.","en":"She gave me a peck on the cheek.","audio":"https://tatoeba.org/en/audio/download/921299","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"kiss"},{"g":"in / on"},{"g":"the / her"},null]}]}