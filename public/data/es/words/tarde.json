{"id":"tarde","lemma":"tarde","pos":"adv","rank":181,"glosses":["late (after a specified deadline)","late in the day"],"ipa":"/ˈtaɾde/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-AdrianAbdulBaha-tarde.wav","examples":[{"text":"Puedo pagar más tarde?","en":"Can I pay later?","audio":"https://tatoeba.org/en/audio/download/441467"},{"text":"¿Ya es tan tarde?","en":"Is it that late?","audio":"https://tatoeba.org/en/audio/download/441916"},{"text":"Ella se levantó tarde.","en":"She got up late.","audio":"https://tatoeba.org/en/audio/download/49732"},{"text":"Nunca me levanto tarde.","en":"I never sleep in.","audio":"https://tatoeba.org/en/audio/download/800378"},{"text":"Se me hizo tarde.","en":"I'm running late.","audio":"https://tatoeba.org/en/audio/download/442790"}]}