{"id":"he_roe","lemma":"héroe","pos":"noun","rank":981,"glosses":["hero"],"ipa":"/ˈeɾoe/","gender":"m","forms":{"plural":"héroes","feminine":"heroína","femininePlural":"heroínas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q1321_%28spa%29-Marreromarco-h%C3%A9roe.wav","formAudio":{"heroína":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Marreromarco-hero%C3%ADna.wav"},"examples":[{"text":"No soy un héroe.","en":"I'm not a hero.","audio":"https://tatoeba.org/en/audio/download/128149"},{"text":"No me gustan las novelas sin héroes.","en":"I don't like novels without heroes.","audio":"https://tatoeba.org/en/audio/download/568150"},{"text":"Ella quiere ser una heroína.","en":"She wants to be a heroine.","audio":"https://tatoeba.org/en/audio/download/639232"},{"text":"Tom es nuestro héroe.","en":"Tom is our hero.","audio":"https://tatoeba.org/en/audio/download/262824"},{"text":"Los verdaderos héroes somos nosotros.","en":"The real heroes are us."}]}