{"id":"asustado","lemma":"asustado","pos":"adj","rank":1268,"glosses":["scared"],"ipa":"/asusˈtado/","forms":{"feminine":"asustada","masculinePlural":"asustados","femininePlural":"asustadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q1321_%28spa%29-Wikipedian-walker-asustado.wav","examples":[{"text":"Yo me sentí asustado.","en":"I felt scared.","audio":"https://tatoeba.org/en/audio/download/440285"},{"text":"Mi esposa parecía asustada.","en":"My wife looked surprised.","audio":"https://tatoeba.org/en/audio/download/527308"},{"text":"Todos excepto Tom parecen asustados.","en":"Everyone looks scared but Tom.","audio":"https://tatoeba.org/en/audio/download/333775"},{"text":"Estamos todas muy asustadas.","en":"We're all very scared."},{"text":"Tom se veía asustado.","en":"Tom looked scared.","audio":"https://tatoeba.org/en/audio/download/799896"}]}