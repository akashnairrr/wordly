{"id":"autobu_s","lemma":"autobús","pos":"noun","rank":1093,"glosses":["bus, coach"],"ipa":"/autoˈbus/","gender":"m","forms":{"plural":"autobuses"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-Eavqwiki-autob%C3%BAs.wav","formAudio":{"autobuses":"https://upload.wikimedia.org/wikipedia/commons/4/48/LL-Q1321_%28spa%29-Eavqwiki-autobuses.wav"},"examples":[{"text":"Yo vine en autobús.","en":"I came by bus.","audio":"https://tatoeba.org/en/audio/download/440154"},{"text":"Todos los autobuses están llenos.","en":"All of the buses are full.","audio":"https://tatoeba.org/en/audio/download/598039"},{"text":"Ha venido en autobús.","en":"He came by bus.","audio":"https://tatoeba.org/en/audio/download/86734"},{"text":"Durante la Nochebuena los autobuses no circularán.","en":"The buses won't run on Christmas Eve.","audio":"https://tatoeba.org/en/audio/download/300719"},{"text":"El autobús es lento.","en":"The bus is slow.","audio":"https://tatoeba.org/en/audio/download/442079"}]}