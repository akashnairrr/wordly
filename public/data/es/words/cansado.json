{"id":"cansado","lemma":"cansado","pos":"adj","rank":955,"glosses":["tired, weary, wearied","tiring","sleepy"],"ipa":"/kanˈsado/","forms":{"feminine":"cansada","masculinePlural":"cansados","femininePlural":"cansadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-cansado.wav","formAudio":{"cansada":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Marreromarco-cansada.wav"},"examples":[{"text":"Usted se ve cansado.","en":"You look tired.","audio":"https://tatoeba.org/en/audio/download/441416"},{"text":"No estoy nada cansada.","en":"I'm not a bit tired.","audio":"https://tatoeba.org/en/audio/download/1190541"},{"text":"Tengo los brazos cansados.","en":"My arms are tired.","audio":"https://tatoeba.org/en/audio/download/273199"},{"text":"¿Por qué están hoy tan cansadas?","en":"Why are you so tired today?","audio":"https://tatoeba.org/en/audio/download/66782"},{"text":"Debe de estar cansado.","en":"He must be tired.","audio":"https://tatoeba.org/en/audio/download/46392"}]}