{"id":"celular","lemma":"celular","pos":"adj","rank":1515,"glosses":["cellular"],"ipa":"/θeluˈlaɾ/","forms":{"femininePlural":"celulares"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Marreromarco-celular.wav","examples":[{"text":"Necesito cargar mi celular.","en":"I need to charge my cellphone.","audio":"https://tatoeba.org/en/audio/download/519503"},{"text":"Él tiene cuatro celulares.","en":"He has four mobile phones."},{"text":"Mi celular estaba apagado.","en":"My cell phone was off."},{"text":"La mayoría de los jóvenes tienen celulares.","en":"Most young people have mobile phones."},{"text":"Mi celular está sonando.","en":"My cellphone is ringing."}]}