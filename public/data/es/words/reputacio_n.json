{"id":"reputacio_n","lemma":"reputación","pos":"noun","rank":1712,"glosses":["reputation"],"ipa":"/reputaˈθjon/","gender":"f","forms":{"plural":"reputaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-reputaci%C3%B3n.wav","examples":[{"text":"Él ha perdido su reputación.","en":"He lost his honor.","audio":"https://tatoeba.org/en/audio/download/526936"},{"text":"Él tiene una buena reputación.","en":"He has a good reputation.","audio":"https://tatoeba.org/en/audio/download/554101"},{"text":"Mi reputación está en juego.","en":"My reputation is at stake.","audio":"https://tatoeba.org/en/audio/download/804225"},{"text":"Mi reputación estará en juego.","en":"I'll stake my reputation on it.","audio":"https://tatoeba.org/en/audio/download/804232"},{"text":"Me jugaré mi reputación en eso.","en":"I'll stake my reputation on that.","audio":"https://tatoeba.org/en/audio/download/804229"}]}