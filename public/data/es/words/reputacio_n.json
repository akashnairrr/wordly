{"id":"reputacio_n","lemma":"reputación","pos":"noun","rank":1710,"glosses":["reputation"],"ipa":"/reputaˈθjon/","gender":"f","forms":{"plural":"reputaciones"},"order":1755,"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-reputaci%C3%B3n.wav","examples":[{"text":"Él tiene una buena reputación.","en":"He has a good reputation.","audio":"https://tatoeba.org/en/audio/download/554101","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"good","l":"bueno"},null]},{"text":"Él ha perdido su reputación.","en":"He lost his honor.","audio":"https://tatoeba.org/en/audio/download/526936","words":[{"g":"he"},{"g":"to have","l":"haber"},{"g":"lost"},{"g":"his / her / your"},null]},{"text":"Mi reputación estará en juego.","en":"I'll stake my reputation on it.","audio":"https://tatoeba.org/en/audio/download/804232","words":[{"g":"my"},null,{"g":"to be","l":"estar"},null,null],"phrases":[[3,5,"at stake"]]}]}