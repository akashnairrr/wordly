{"id":"baja","lemma":"baja","pos":"noun","rank":665,"glosses":["casualty, loss","drop, fall, reduction","sick leave (absence for illness)"],"ipa":"/ˈbaxa/","gender":"f","forms":{"plural":"bajas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dd/LL-Q1321_%28spa%29-AdrianAbdulBaha-baja.wav","formAudio":{"bajas":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1321_%28spa%29-AdrianAbdulBaha-bajas.wav"},"examples":[{"text":"Habla en voz baja.","en":"Speak softly.","audio":"https://tatoeba.org/en/audio/download/438906"},{"text":"Hemos tenido unas cuantas bajas.","en":"We've had a few casualties."},{"text":"Baja por las escaleras.","en":"Go down the stairs.","audio":"https://tatoeba.org/en/audio/download/523566"},{"text":"Acepto las condiciones si tú bajas el precio.","en":"I'll agree to the terms if you lower the price."},{"text":"Quiero una mesa baja.","en":"I want a low table.","audio":"https://tatoeba.org/en/audio/download/799035"}]}