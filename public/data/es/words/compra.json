{"id":"compra","lemma":"compra","pos":"noun","rank":1484,"glosses":["purchase, buying","acquisition"],"ipa":"/ˈkompɾa/","gender":"f","forms":{"plural":"compras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q1321_%28spa%29-Marreromarco-compra.wav","examples":[{"text":"Hicimos una buena compra.","en":"We made a good buy.","audio":"https://tatoeba.org/en/audio/download/637154"},{"text":"Ella salió de compras.","en":"She went shopping.","audio":"https://tatoeba.org/en/audio/download/444110"},{"text":"Compra la versión completa.","en":"Buy the full version.","audio":"https://tatoeba.org/en/audio/download/767997"},{"text":"Me voy de compras.","en":"I'm going shopping.","audio":"https://tatoeba.org/en/audio/download/448568"},{"text":"Mucha gente compra aquí.","en":"Many people shop here.","audio":"https://tatoeba.org/en/audio/download/460694"}]}