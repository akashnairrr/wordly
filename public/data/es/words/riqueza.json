{"id":"riqueza","lemma":"riqueza","pos":"noun","rank":3130,"glosses":["wealth, affluence, richness","riches","richness (i.e. quality of being extremely abundant or having high intrinsic value)"],"ipa":"/riˈkeθa/","gender":"f","forms":{"plural":"riquezas"},"order":3135,"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Rodrigo5260-riqueza.wav","examples":[{"text":"La salud es riqueza.","en":"Health is wealth.","audio":"https://tatoeba.org/en/audio/download/800044","words":[{"g":"the / her"},{"g":"bless you"},{"g":"to be","l":"ser"},null]},{"text":"La salud está por encima de la riqueza.","en":"Health is above wealth.","audio":"https://tatoeba.org/en/audio/download/803853","words":[{"g":"the / her"},{"g":"bless you"},{"g":"to be","l":"estar"},null,null,null,null,null],"phrases":[[3,5,"over, above"],[5,7,"of the"]]},{"text":"Él ha acumulado riqueza.","en":"He has accumulated wealth.","words":[{"g":"he"},{"g":"to have","l":"haber"},{"g":"to accumulate","l":"acumular"},null]}]}