{"id":"cai_do","lemma":"caído","pos":"adj","rank":1457,"glosses":["fallen","collapsed","down, not online"],"ipa":"/kaˈido/","forms":{"feminine":"caída","masculinePlural":"caídos","femininePlural":"caídas"},"formAudio":{"caída":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-ca%C3%ADda.wav"},"examples":[{"text":"Seguro que se te han caído.","en":"You must've dropped them.","audio":"https://tatoeba.org/en/audio/download/422580","words":[{"g":"secure"},{"g":"that"},{"g":"oneself"},{"g":"you"},{"g":"to have","l":"haber"},null]},{"text":"He caído en una trampa.","en":"I fell into a trap.","audio":"https://tatoeba.org/en/audio/download/929124","words":[{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"a"},{"g":"trap, snare"}]},{"text":"La página web está caída.","en":"The website is down.","words":[{"g":"the / her"},null,null,{"g":"to be","l":"estar"},null],"phrases":[[1,3,"web page"]]},{"text":"Se te ha caído el lápiz.","en":"You dropped your pencil.","audio":"https://tatoeba.org/en/audio/download/599979","words":[{"g":"oneself"},{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"pencil"}]},{"text":"El jardín estaba cubierto de hojas caídas.","en":"The garden was covered with fallen leaves.","audio":"https://tatoeba.org/en/audio/download/692026","words":[{"g":"the"},{"g":"garden"},{"g":"to be","l":"estar"},{"g":"covered"},{"g":"of / from"},{"g":"leaf","l":"hoja"},null]}]}