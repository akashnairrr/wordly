{"id":"cai_do","lemma":"caído","pos":"adj","rank":1460,"glosses":["fallen","collapsed","down, not online"],"ipa":"/kaˈido/","forms":{"feminine":"caída","masculinePlural":"caídos","femininePlural":"caídas"},"formAudio":{"caída":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-ca%C3%ADda.wav"},"examples":[{"text":"El régimen ha caído.","en":"The regime has fallen.","audio":"https://tatoeba.org/en/audio/download/301854"},{"text":"La página web está caída.","en":"The website is down."},{"text":"Él se arrodilló y rogó por las almas de los caídos.","en":"He got down on his knees and prayed for the souls of the deceased."},{"text":"El jardín estaba cubierto de hojas caídas.","en":"The garden was covered with fallen leaves.","audio":"https://tatoeba.org/en/audio/download/692026"},{"text":"Tienen que habérsete caído.","en":"You must've dropped them.","audio":"https://tatoeba.org/en/audio/download/422579"}]}