{"id":"aproximadamente","lemma":"aproximadamente","pos":"adv","rank":2473,"glosses":["approximately"],"ipa":"/apɾoɡsiˌmadaˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Marreromarco-aproximadamente.wav","examples":[{"text":"Tienen aproximadamente la misma edad.","en":"They are about the same age.","audio":"https://tatoeba.org/en/audio/download/537894","words":[{"g":"to have","l":"tener"},null,{"g":"the / her"},{"g":"same","l":"mismo"},{"g":"age"}]},{"text":"Tenemos aproximadamente tu edad.","en":"We're about your age.","audio":"https://tatoeba.org/en/audio/download/459158","words":[{"g":"to have","l":"tener"},null,{"g":"your"},{"g":"age"}]},{"text":"Había mil personas aproximadamente.","en":"There were about a thousand people.","audio":"https://tatoeba.org/en/audio/download/930699","words":[{"g":"makes pluperfect to…"},{"g":"thousand"},{"g":"person (an individual","l":"persona"},null]},{"text":"Tiene aproximadamente la misma edad que yo.","en":"She's about the same age as I am.","audio":"https://tatoeba.org/en/audio/download/353401","words":[{"g":"to have","l":"tener"},null,{"g":"the / her"},{"g":"same","l":"mismo"},{"g":"age"},{"g":"that"},{"g":"I"}]},{"text":"En total son aproximadamente diez mil dólares.","en":"The total is approximately ten thousand dollars.","words":[null,null,{"g":"to be","l":"ser"},null,null,null,{"g":"dollar","l":"dólar"}],"phrases":[[0,2,"in total"],[4,6,"ten thousand"]]}]}