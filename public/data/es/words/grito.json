{"id":"grito","lemma":"grito","pos":"noun","rank":2037,"glosses":["a cry, a yell, a scream, a growl"],"ipa":"/ˈɡɾito/","gender":"m","forms":{"plural":"gritos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-AdrianAbdulBaha-grito.wav","examples":[{"text":"Oí un grito.","en":"I heard a scream.","audio":"https://tatoeba.org/en/audio/download/442768","words":[{"g":"to hear","l":"oír"},{"g":"a"},null]},{"text":"Él oyó un grito.","en":"He heard a shout.","audio":"https://tatoeba.org/en/audio/download/442424","words":[{"g":"he"},{"g":"to hear","l":"oír"},{"g":"a"},null]},{"text":"Oímos su grito.","en":"We heard her cry.","audio":"https://tatoeba.org/en/audio/download/44591","words":[{"g":"to hear","l":"oír"},{"g":"his / her / your"},null]},{"text":"Me asustaron tus gritos.","en":"Your screams frightened me.","words":[{"g":"me"},{"g":"to scare","l":"asustar"},{"g":"your"},null]},{"text":"Un grito rompió el silencio.","en":"A scream broke the silence.","words":[{"g":"a"},null,{"g":"to break","l":"romper"},{"g":"the"},{"g":"silence"}]}]}