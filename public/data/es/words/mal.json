{"id":"mal","lemma":"mal","pos":"adv","rank":161,"glosses":["badly, poorly, ill","awry, amiss, wrong, wrongly","hard (functions as an adverb in Spanish but translates as an adjective in English)"],"ipa":"/ˈmal/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-mal.wav","examples":[{"text":"¿Qué puede salir mal?","en":"What can go wrong?","audio":"https://tatoeba.org/en/audio/download/448259","words":[{"g":"what"},{"g":"to be able to, can","l":"poder"},{"g":"to go out"},null]},{"text":"Lo pasó mal.","en":"It went badly.","audio":"https://tatoeba.org/en/audio/download/684753","words":[{"g":"it / him"},{"g":"to pass","l":"pasar"},null]},{"text":"¿Hemos hecho algo mal?","en":"Have we done something wrong?","audio":"https://tatoeba.org/en/audio/download/333216","words":[{"g":"heme","l":"hemo"},{"g":"done, completed"},{"g":"something, anything"},null]},{"text":"¿Te he llamado en mal momento?","en":"Have I called you at a bad time?","audio":"https://tatoeba.org/en/audio/download/581689","words":[{"g":"you"},{"g":"to have","l":"haber"},{"g":"called"},{"g":"in / on"},null,{"g":"moment, instant"}]},{"text":"Él tuvo un mal día.","en":"He had a bad day.","audio":"https://tatoeba.org/en/audio/download/79830","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"day"}]}]}