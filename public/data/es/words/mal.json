{"id":"mal","lemma":"mal","pos":"adv","rank":163,"glosses":["badly, poorly, ill","awry, amiss, wrong, wrongly","hard (functions as an adverb in Spanish but translates as an adjective in English)"],"ipa":"/ˈmal/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-mal.wav","examples":[{"text":"Ahora me siento mal.","en":"Now I feel bad.","audio":"https://tatoeba.org/en/audio/download/441151"},{"text":"Esto no está mal.","en":"This isn't bad.","audio":"https://tatoeba.org/en/audio/download/534822"},{"text":"Es un mal momento.","en":"It's a bad time.","audio":"https://tatoeba.org/en/audio/download/77881"},{"text":"Él se portó mal.","en":"He behaved badly.","audio":"https://tatoeba.org/en/audio/download/442418"},{"text":"Hoy me siento mal.","en":"I feel bad today.","audio":"https://tatoeba.org/en/audio/download/78792"}]}