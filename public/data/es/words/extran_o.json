{"id":"extran_o","lemma":"extraño","pos":"adj","rank":442,"glosses":["strange, unusual, odd, weird, bizarre, uncanny, rare, peculiar, freaky, freakish, freak, curious","foreign, alien, extraneous","funny, suspicious"],"ipa":"/e(ɡ)sˈtɾaɲo/","forms":{"feminine":"extraña","masculinePlural":"extraños","femininePlural":"extrañas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-Marreromarco-extra%C3%B1o.wav","examples":[{"text":"Yo extraño a mi gato.","en":"I miss my cat.","audio":"https://tatoeba.org/en/audio/download/440334","words":[{"g":"I"},null,{"g":"to"},{"g":"my"},{"g":"cat"}]},{"text":"¡Qué tipo tan extraño!","en":"What a weirdo!","audio":"https://tatoeba.org/en/audio/download/845493","words":[{"g":"what"},{"g":"kind"},{"g":"so, as"},null]},{"text":"No hables con extraños.","en":"Don't talk to strangers.","audio":"https://tatoeba.org/en/audio/download/460188","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},{"g":"with"},null]},{"text":"Yo era un extraño.","en":"I was an outsider.","audio":"https://tatoeba.org/en/audio/download/1252576","words":[{"g":"I"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Fue mi primera noche entre extraños.","en":"It was my first night among strangers.","words":[{"g":"to be","l":"ser"},{"g":"my"},{"g":"first gear"},{"g":"night"},{"g":"between"},null]}]}