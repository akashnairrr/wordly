{"id":"extran_o","lemma":"extraño","pos":"adj","rank":445,"glosses":["strange, unusual, odd, weird, bizarre, uncanny, rare, peculiar, freaky, freakish, freak, curious","foreign, alien, extraneous","funny, suspicious"],"ipa":"/e(ɡ)sˈtɾaɲo/","forms":{"feminine":"extraña","masculinePlural":"extraños","femininePlural":"extrañas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-Marreromarco-extra%C3%B1o.wav","examples":[{"text":"¡Qué tipo tan extraño!","en":"What a weirdo!","audio":"https://tatoeba.org/en/audio/download/845493"},{"text":"Fue una extraña noche.","en":"It was a strange night.","audio":"https://tatoeba.org/en/audio/download/721829"},{"text":"Los gatos son extraños.","en":"Cats are weird.","audio":"https://tatoeba.org/en/audio/download/851360"},{"text":"Las pinturas de Picasso me parecen extrañas.","en":"Picasso's paintings seem strange to me.","audio":"https://tatoeba.org/en/audio/download/1189070"},{"text":"Esto puede parecer extraño.","en":"It may seem odd.","audio":"https://tatoeba.org/en/audio/download/1086442"}]}