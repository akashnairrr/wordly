{"id":"extran_o","lemma":"extraño","pos":"adj","rank":442,"glosses":["strange, unusual, odd, weird, bizarre, uncanny, rare, peculiar, freaky, freakish, freak, curious","foreign, alien, extraneous","funny, suspicious"],"ipa":"/e(ɡ)sˈtɾaɲo/","forms":{"feminine":"extraña","masculinePlural":"extraños","femininePlural":"extrañas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-Marreromarco-extra%C3%B1o.wav","examples":[{"text":"A mí me parece extraño.","en":"It seems strange to me.","audio":"https://tatoeba.org/en/audio/download/1152330","words":[{"g":"to"},{"g":"me"},{"g":"me"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"Vi algo extraño en el cielo.","en":"I saw something strange in the sky.","audio":"https://tatoeba.org/en/audio/download/608502","words":[{"g":"to see, to spot","l":"ver"},{"g":"something, anything"},null,{"g":"in / on"},{"g":"the"},{"g":"sky"}]},{"text":"No hables con extraños.","en":"Don't talk to strangers.","audio":"https://tatoeba.org/en/audio/download/460188","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},{"g":"with"},null]},{"text":"Extraño ese lugar.","en":"I miss that place.","audio":"https://tatoeba.org/en/audio/download/443935","words":[null,{"g":"that"},{"g":"place"}]},{"text":"Fue mi primera noche entre extraños.","en":"It was my first night among strangers.","words":[{"g":"to be","l":"ser"},{"g":"my"},{"g":"first gear"},{"g":"night"},{"g":"between"},null]}]}