{"id":"cero","lemma":"cero","pos":"noun","rank":1428,"glosses":["zero"],"ipa":"/ˈθeɾo/","gender":"m","forms":{"plural":"ceros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/47/LL-Q1321_%28spa%29-AdrianAbdulBaha-cero.wav","examples":[{"text":"Lo hice desde cero.","en":"I made it from scratch.","audio":"https://tatoeba.org/en/audio/download/460630"},{"text":"El número 2010 tiene dos ceros.","en":"There are two zeros in the number \"2010.\""},{"text":"El valor predeterminado es cero.","en":"The default value is zero.","audio":"https://tatoeba.org/en/audio/download/77000"},{"text":"Hace treinta grados bajo cero.","en":"It's thirty degrees below zero.","audio":"https://tatoeba.org/en/audio/download/599210"},{"text":"Son un cero a la izquierda.","en":"You're useless.","audio":"https://tatoeba.org/en/audio/download/501620"}]}