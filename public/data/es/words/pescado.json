{"id":"pescado","lemma":"pescado","pos":"noun","rank":1504,"glosses":["dead fish intended for consumption; food fish","fish"],"ipa":"/pesˈkado/","gender":"m","forms":{"plural":"pescados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-Sinaloa-pescado.wav","examples":[{"text":"Me encanta el pescado.","en":"I love fish.","audio":"https://tatoeba.org/en/audio/download/439068"},{"text":"¿Te gusta el pescado?","en":"Do you like fish?","audio":"https://tatoeba.org/en/audio/download/442904"},{"text":"¿Os gusta el pescado?","en":"Do you like fish?","audio":"https://tatoeba.org/en/audio/download/873706"},{"text":"No he pedido pescado.","en":"I didn't order fish.","audio":"https://tatoeba.org/en/audio/download/449195"},{"text":"Como pescado a diario.","en":"I eat fish every day.","audio":"https://tatoeba.org/en/audio/download/510143"}]}