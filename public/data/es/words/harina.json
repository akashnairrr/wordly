{"id":"harina","lemma":"harina","pos":"noun","rank":4363,"glosses":["flour","cocaine"],"ipa":"/aˈɾina/","gender":"f","forms":{"plural":"harinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-Millars-harina.wav","examples":[{"text":"¿Tenemos suficiente harina?","en":"Do we have enough flour?","audio":"https://tatoeba.org/en/audio/download/459143","words":[{"g":"to have","l":"tener"},{"g":"sufficient, enough"},null]},{"text":"Me hace falta harina.","en":"I need flour.","words":[{"g":"me"},{"g":"to do","l":"hacer"},{"g":"lack, shortage"},null]},{"text":"Él compró mucha harina y aceite.","en":"He bought a lot of flour and oil.","audio":"https://tatoeba.org/en/audio/download/353958","words":[{"g":"he"},{"g":"to buy","l":"comprar"},{"g":"much","l":"mucho"},null,{"g":"and"},{"g":"oil"}]},{"text":"La harina se hace con trigo.","en":"Flour is made from wheat.","audio":"https://tatoeba.org/en/audio/download/639500","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to do","l":"hacer"},{"g":"with"},{"g":"wheat"}]},{"text":"Ellos hacen harina moliendo el trigo.","en":"They grind wheat into flour.","audio":"https://tatoeba.org/en/audio/download/706845","words":[{"g":"they","l":"él"},{"g":"to do","l":"hacer"},null,null,{"g":"the"},{"g":"wheat"}]}]}