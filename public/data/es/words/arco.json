{"id":"arco","lemma":"arco","pos":"noun","rank":2563,"glosses":["bow (weapon)","bow (rod for an instrument)","arc"],"ipa":"/ˈaɾko/","gender":"m","forms":{"plural":"arcos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-AdrianAbdulBaha-arco.wav","examples":[{"text":"Un arco sin flechas no vale para nada.","en":"A bow is no use without arrows.","audio":"https://tatoeba.org/en/audio/download/581684","words":[{"g":"a"},null,{"g":"without"},{"g":"arrow","l":"flecha"},{"g":"no / not"},{"g":"a voucher"},null,null],"phrases":[[6,8,"not at all"]]},{"text":"Nunca he visto un arco iris.","en":"I've never seen a rainbow.","words":[{"g":"never"},{"g":"to have","l":"haber"},{"g":"seen"},{"g":"a"},null,{"g":"iris"}]},{"text":"Un arco es inútil sin las flechas.","en":"A bow is no use without arrows.","audio":"https://tatoeba.org/en/audio/download/589948","words":[{"g":"a"},null,{"g":"to be","l":"ser"},{"g":"useless, pointless"},{"g":"without"},{"g":"the / them"},{"g":"arrow","l":"flecha"}]},{"text":"Los indios lucharon con arcos y flechas.","en":"The Indians fought with bows and arrows.","words":[{"g":"the / them"},{"g":"Indian","l":"indio"},{"g":"to fight","l":"luchar"},{"g":"with"},null,{"g":"and"},{"g":"arrow","l":"flecha"}]},{"text":"La temporada de caza con arco se abre hoy.","en":"Bow hunting season opens today.","words":[{"g":"the / her"},{"g":"season"},{"g":"of / from"},{"g":"hunting"},{"g":"with"},null,{"g":"oneself"},{"g":"to open, open up","l":"abrir"},{"g":"today, tonight"}]}]}