{"id":"supuesto","lemma":"supuesto","pos":"adj","rank":217,"glosses":["supposed, self-styled, alleged"],"ipa":"/suˈpwesto/","forms":{"feminine":"supuesta","masculinePlural":"supuestos","femininePlural":"supuestas"},"examples":[{"text":"Por supuesto que esperaré.","en":"Of course I'll wait.","audio":"https://tatoeba.org/en/audio/download/450324"},{"text":"¡Por supuesto que estoy bromeando!","en":"Of course, I'm joking.","audio":"https://tatoeba.org/en/audio/download/730635"},{"text":"Por supuesto, él tiene razón.","en":"Of course, he is right.","audio":"https://tatoeba.org/en/audio/download/35342"},{"text":"Por supuesto que te recuerdo.","en":"Of course I remember you.","audio":"https://tatoeba.org/en/audio/download/523250"},{"text":"Por supuesto que es ilegal.","en":"Of course, this is illegal.","audio":"https://tatoeba.org/en/audio/download/519008"}]}