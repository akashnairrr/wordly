{"id":"orgulloso","lemma":"orgulloso","pos":"adj","rank":1082,"glosses":["proud","prideful, arrogant, haughty"],"ipa":"/oɾɡuˈʝoso/","forms":{"feminine":"orgullosa","masculinePlural":"orgullosos","femininePlural":"orgullosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c3/LL-Q1321_%28spa%29-AdrianAbdulBaha-orgulloso.wav","examples":[{"text":"Estoy orgulloso de ti.","en":"I'm proud of you.","audio":"https://tatoeba.org/en/audio/download/37989"},{"text":"Estoy orgullosa de ti.","en":"I'm proud of you.","audio":"https://tatoeba.org/en/audio/download/37990"},{"text":"Todos estamos orgullosos de ti.","en":"We're all proud of you.","audio":"https://tatoeba.org/en/audio/download/458842"},{"text":"¿Estáis orgullosas de vuestro padre?","en":"Are you proud of your father?","audio":"https://tatoeba.org/en/audio/download/333063"},{"text":"Estoy orgulloso de vosotros.","en":"I'm proud of you.","audio":"https://tatoeba.org/en/audio/download/47550"}]}