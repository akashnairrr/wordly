{"id":"marcado","lemma":"marcado","pos":"adj","rank":3491,"glosses":["marked, pronounced"],"ipa":"/maɾˈkado/","forms":{"feminine":"marcada","masculinePlural":"marcados","femininePlural":"marcadas"},"examples":[{"text":"Lo siento, debo haber marcado un número equivocado.","en":"Sorry, I must've dialed the wrong number.","audio":"https://tatoeba.org/en/audio/download/422661","words":[null,null,{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"a"},{"g":"number"},{"g":"mistaken, wrong"}],"phrases":[[0,2,"I'm sorry"]]},{"text":"El camino no está marcado con claridad.","en":"The path wasn't clearly marked.","words":[{"g":"the"},{"g":"way, route"},{"g":"no / not"},{"g":"to be","l":"estar"},null,{"g":"with"},{"g":"clarity, clearness"}]},{"text":"Las iglesias están marcadas en el mapa con una cruz.","en":"Churches are designated on the map with crosses.","audio":"https://tatoeba.org/en/audio/download/691637","words":[{"g":"the / them"},{"g":"church","l":"iglesia"},{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"the"},{"g":"map"},{"g":"with"},{"g":"a"},{"g":"cross"}]},{"text":"Tom tiene un marcado acento.","en":"Tom has a heavy accent.","words":[null,{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"accent"}]},{"text":"Tom tiene un acento muy marcado.","en":"Tom has a very thick accent.","words":[null,{"g":"to have","l":"tener"},{"g":"a"},{"g":"accent"},null,null]}]}