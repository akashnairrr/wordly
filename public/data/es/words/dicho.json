{"id":"dicho","lemma":"dicho","pos":"noun","rank":185,"glosses":["saying, expression","remark","proverb"],"ipa":"/ˈdit͡ʃo/","gender":"m","forms":{"plural":"dichos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-Marreromarco-dicho.wav","examples":[{"text":"¿Has dicho que sí?","en":"Did you say yes?","audio":"https://tatoeba.org/en/audio/download/78873"},{"text":"¡Siempre tiene dichos tan agudos!","en":"He's always making such witty remarks!"},{"text":"No lo he dicho.","en":"I didn't say it.","audio":"https://tatoeba.org/en/audio/download/441492"},{"text":"¿Qué ha dicho Tom?","en":"What has Tom said?","audio":"https://tatoeba.org/en/audio/download/101979"},{"text":"Nunca he dicho eso.","en":"I've never said that.","audio":"https://tatoeba.org/en/audio/download/454081"}]}