{"id":"costa","lemma":"costa","pos":"noun","rank":1203,"glosses":["coast, coastline","shore, shoreline"],"ipa":"/ˈkosta/","gender":"f","forms":{"plural":"costas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4f/LL-Q1321_%28spa%29-AdrianAbdulBaha-costa.wav","examples":[{"text":"Tom necesitaba dinero a toda costa.","en":"Tom badly needed money.","audio":"https://tatoeba.org/en/audio/download/353408","words":[null,{"g":"to need","l":"necesitar"},{"g":"money"},{"g":"to"},{"g":"all","l":"todo"},null]},{"text":"Soy de la costa oeste.","en":"I'm from the West Coast.","audio":"https://tatoeba.org/en/audio/download/582544","words":[{"g":"to be","l":"ser"},null,null,null,{"g":"west"}],"phrases":[[1,3,"of the"]]},{"text":"La guerra se debe evitar a toda costa.","en":"War must be avoided at all costs.","audio":"https://tatoeba.org/en/audio/download/590279","words":[{"g":"the / her"},{"g":"war, warfare"},{"g":"oneself"},{"g":"to owe","l":"deber"},{"g":"to avoid"},{"g":"to"},{"g":"all","l":"todo"},null]},{"text":"Pasamos el día libre en la costa.","en":"We spent our holiday at the seaside.","audio":"https://tatoeba.org/en/audio/download/706613","words":[{"g":"to pass","l":"pasar"},{"g":"the"},{"g":"day"},{"g":"free"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Él la salvó a costas de su vida propia.","en":"He saved her at the cost of his own life.","words":[{"g":"he"},{"g":"the / her"},{"g":"to save","l":"salvar"},{"g":"to"},null,{"g":"of / from"},{"g":"his / her / your"},{"g":"life"},{"g":"own","l":"propio"}]}]}