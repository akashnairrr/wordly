{"id":"interruptor","lemma":"interruptor","pos":"adj","rank":4073,"glosses":["interrupting"],"ipa":"/interubˈtoɾ/","forms":{"feminine":"interruptora","masculinePlural":"interruptores","femininePlural":"interruptoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Emanuelps27-interruptor.wav","examples":[{"text":"Busco el interruptor de la luz.","en":"I'm looking for the light switch.","audio":"https://tatoeba.org/en/audio/download/694279","words":[{"g":"to seek","l":"buscar"},{"g":"the"},null,null,null,{"g":"light"}],"phrases":[[3,5,"of the"]]},{"text":"Ella pulsó el interruptor.","en":"She pressed the switch.","words":[{"g":"she"},null,{"g":"the"},null]},{"text":"No puedo encenderlo porque el interruptor está roto.","en":"I can't turn it on, because the switch is broken.","audio":"https://tatoeba.org/en/audio/download/609131","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to light, ignite","l":"encender"},{"g":"because"},{"g":"the"},null,{"g":"to be","l":"estar"},{"g":"broken"}]},{"text":"Tom giró el interruptor.","en":"Tom flipped the switch.","audio":"https://tatoeba.org/en/audio/download/804612","words":[null,{"g":"to turn, pivot","l":"girar"},{"g":"the"},null]},{"text":"Si pulsas este interruptor, se abrirán las cortinas automáticamente.","en":"If you touch this switch, it will open the curtains automatically.","audio":"https://tatoeba.org/en/audio/download/692741","words":[{"g":"if, whether"},null,{"g":"this"},null,{"g":"oneself"},{"g":"to open, open up","l":"abrir"},{"g":"the / them"},{"g":"curtain","l":"cortina"},{"g":"automatically"}]}]}