{"id":"urgente","lemma":"urgente","pos":"adj","rank":1760,"glosses":["urgent"],"ipa":"/uɾˈxente/","forms":{"femininePlural":"urgentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-urgente.wav","examples":[{"text":"Dijiste que era urgente.","en":"You said it was urgent.","audio":"https://tatoeba.org/en/audio/download/269160"},{"text":"Tengo asuntos urgentes que atender.","en":"I have urgent matters to attend to.","audio":"https://tatoeba.org/en/audio/download/633849"},{"text":"Dijeron que era urgente.","en":"They said it was urgent.","audio":"https://tatoeba.org/en/audio/download/439765"},{"text":"Él tenía noticias urgentes que comunicarme.","en":"He had some urgent news to tell me.","audio":"https://tatoeba.org/en/audio/download/707182"},{"text":"Ven rápido. Es urgente.","en":"Come quickly. It's urgent.","audio":"https://tatoeba.org/en/audio/download/451062"}]}