{"id":"medalla","lemma":"medalla","pos":"noun","rank":2764,"glosses":["medal"],"ipa":"/meˈdaʝa/","gender":"f","forms":{"plural":"medallas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-medalla.wav","examples":[{"text":"Mereces una medalla.","en":"You deserve a medal.","audio":"https://tatoeba.org/en/audio/download/453850","words":[{"g":"to deserve","l":"merecer"},{"g":"a"},null]},{"text":"Os merecéis una medalla.","en":"You deserve a medal.","audio":"https://tatoeba.org/en/audio/download/75841","words":[{"g":"you all","l":"vosotros"},{"g":"to deserve","l":"merecer"},{"g":"a"},null]},{"text":"Él ganó una medalla de plata.","en":"He won a silver medal.","words":[{"g":"he"},{"g":"to gain","l":"ganar"},{"g":"a"},null,{"g":"of / from"},{"g":"silver"}]},{"text":"Yo gané la medalla de oro.","en":"I won the gold medal.","audio":"https://tatoeba.org/en/audio/download/453405","words":[{"g":"I"},{"g":"to gain","l":"ganar"},{"g":"the / her"},null,{"g":"of / from"},{"g":"gold."}]},{"text":"La medalla tenía una inscripción.","en":"The medal had an inscription.","words":[{"g":"the / her"},null,{"g":"to have","l":"tener"},{"g":"a"},{"g":"inscription"}]}]}