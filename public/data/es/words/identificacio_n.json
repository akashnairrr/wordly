{"id":"identificacio_n","lemma":"identificación","pos":"noun","rank":1701,"glosses":["identification"],"ipa":"/identifikaˈθjon/","gender":"f","forms":{"plural":"identificaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q1321_%28spa%29-AdrianAbdulBaha-identificaci%C3%B3n.wav","examples":[{"text":"Me pidieron mi identificación.","en":"I got carded.","audio":"https://tatoeba.org/en/audio/download/415850"},{"text":"Su identificación era falsa.","en":"His ID was fake.","audio":"https://tatoeba.org/en/audio/download/441533"},{"text":"¿Puedo ver alguna identificación?","en":"Can I see some ID?","audio":"https://tatoeba.org/en/audio/download/443306"},{"text":"Tom usó una identificación falsa.","en":"Tom used a fake ID.","audio":"https://tatoeba.org/en/audio/download/799390"},{"text":"Tom le mostró al cantinero una identificación falsa.","en":"Tom showed the bartender a fake ID card."}]}