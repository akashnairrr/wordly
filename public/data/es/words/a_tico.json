{"id":"a_tico","lemma":"ático","pos":"adj","rank":3839,"glosses":["Attic (of, from or relating to the region of Attica, Greece)"],"ipa":"/ˈatiko/","forms":{"feminine":"ática","masculinePlural":"áticos","femininePlural":"áticas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-Emanuelps27-%C3%A1tico.wav","examples":[{"text":"Lo encontré en el ático.","en":"I found it in the attic.","audio":"https://tatoeba.org/en/audio/download/460927","words":[{"g":"it / him"},{"g":"to meet","l":"encontrar"},{"g":"in / on"},{"g":"the"},null]},{"text":"¿Quién sabe qué encontraremos en el ático?","en":"Who knows what we'll find up in the attic?","audio":"https://tatoeba.org/en/audio/download/587425","words":[null,null,{"g":"what"},{"g":"to meet","l":"encontrar"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"who knows?"]]},{"text":"Hay suficiente espacio en el ático.","en":"There's ample room in the attic.","audio":"https://tatoeba.org/en/audio/download/937804","words":[{"g":"to have","l":"haber"},{"g":"sufficient, enough"},{"g":"space"},{"g":"in / on"},{"g":"the"},null]},{"text":"Subí al ático.","en":"I went up to the attic.","audio":"https://tatoeba.org/en/audio/download/741038","words":[{"g":"to go up or come up","l":"subir"},{"g":"to the"},null]},{"text":"Lo guardo en el ático.","en":"I keep it in the attic.","audio":"https://tatoeba.org/en/audio/download/460928","words":[{"g":"it / him"},{"g":"to save","l":"guardar"},{"g":"in / on"},{"g":"the"},null]}]}