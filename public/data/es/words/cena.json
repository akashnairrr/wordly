{"id":"cena","lemma":"cena","pos":"noun","rank":545,"glosses":["supper, dinner"],"ipa":"/ˈθena/","gender":"f","forms":{"plural":"cenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q1321_%28spa%29-AdrianAbdulBaha-cena.wav","examples":[{"text":"Yo pago la cena.","en":"Dinner's on me.","audio":"https://tatoeba.org/en/audio/download/440712"},{"text":"¿Cenas pescado con frecuencia?","en":"Do you often have fish for dinner?","audio":"https://tatoeba.org/en/audio/download/353479"},{"text":"La cena está preparada.","en":"Dinner's ready!","audio":"https://tatoeba.org/en/audio/download/440575"},{"text":"¿Cenas conmigo esta noche?","en":"Would you have dinner with me tonight?","audio":"https://tatoeba.org/en/audio/download/540703"},{"text":"¡La cena está lista!","en":"Dinner's ready!","audio":"https://tatoeba.org/en/audio/download/103415"}]}