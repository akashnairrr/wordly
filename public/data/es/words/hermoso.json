{"id":"hermoso","lemma":"hermoso","pos":"adj","rank":594,"glosses":["gorgeous, beautiful, handsome, lovely"],"ipa":"/eɾˈmoso/","forms":{"feminine":"hermosa","masculinePlural":"hermosos","femininePlural":"hermosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-AdrianAbdulBaha-hermoso.wav","examples":[{"text":"Tengo un hermoso perro.","en":"I have a pretty dog.","audio":"https://tatoeba.org/en/audio/download/636949"},{"text":"La vida es hermosa.","en":"Life is beautiful.","audio":"https://tatoeba.org/en/audio/download/443940"},{"text":"Ella tiene unos ojos hermosos.","en":"She has beautiful eyes.","audio":"https://tatoeba.org/en/audio/download/461453"},{"text":"Esas flores son hermosas.","en":"Those flowers are beautiful.","audio":"https://tatoeba.org/en/audio/download/594398"},{"text":"Es un día hermoso.","en":"It's a beautiful day.","audio":"https://tatoeba.org/en/audio/download/453618"}]}