{"id":"tantos","lemma":"tantos","pos":"noun","rank":1200,"glosses":["score"],"ipa":"/ˈtantos/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Eavqwiki-tantos.wav","examples":[{"text":"Han pasado tantos años.","en":"It's been so many years.","audio":"https://tatoeba.org/en/audio/download/639657"},{"text":"¡No des tantos rodeos!","en":"Let's not beat around the bush.","audio":"https://tatoeba.org/en/audio/download/296186"},{"text":"Tiene cincuenta y tantos años.","en":"He's in his fifties.","audio":"https://tatoeba.org/en/audio/download/637148"},{"text":"Treinta años no son tantos.","en":"Thirty isn't that old.","audio":"https://tatoeba.org/en/audio/download/79149"},{"text":"¿Por qué tienes tantos gatos?","en":"Why do you have so many cats?","audio":"https://tatoeba.org/en/audio/download/554707"}]}