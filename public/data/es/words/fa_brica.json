{"id":"fa_brica","lemma":"fábrica","pos":"noun","rank":1532,"glosses":["factory"],"ipa":"/ˈfabɾika/","gender":"f","forms":{"plural":"fábricas"},"order":1587,"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-Marreromarco-f%C3%A1brica.wav","examples":[{"text":"Él trabaja en una fábrica.","en":"He works in a factory.","audio":"https://tatoeba.org/en/audio/download/49708","words":[{"g":"he"},{"g":"to work","l":"trabajar"},{"g":"in / on"},{"g":"a"},null]},{"text":"Vayamos a la fábrica.","en":"Let's go to the factory.","audio":"https://tatoeba.org/en/audio/download/594478","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},null]},{"text":"Han decidido cerrar esta fábrica.","en":"They've decided to shut down this factory.","audio":"https://tatoeba.org/en/audio/download/704351","words":[{"g":"to have","l":"haber"},{"g":"decided"},{"g":"to close, to shut"},{"g":"this","l":"este"},null]}]}