{"id":"enojado","lemma":"enojado","pos":"adj","rank":1489,"glosses":["angry, mad","annoyed","enraged"],"ipa":"/enoˈxado/","forms":{"feminine":"enojada","masculinePlural":"enojados","femininePlural":"enojadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-Marreromarco-enojado.wav","examples":[{"text":"Él aún está enojado.","en":"He is still angry.","audio":"https://tatoeba.org/en/audio/download/443346"},{"text":"Ella debe estar enojada.","en":"She must be angry.","audio":"https://tatoeba.org/en/audio/download/444300"},{"text":"¿Por qué están tan enojados?","en":"Why are you guys so angry?","audio":"https://tatoeba.org/en/audio/download/587334"},{"text":"¿Aún siguen enojadas conmigo?","en":"Are you still mad at me?","audio":"https://tatoeba.org/en/audio/download/462164"},{"text":"Mi tío está enojado.","en":"My uncle is angry.","audio":"https://tatoeba.org/en/audio/download/48670"}]}