{"id":"vecindario","lemma":"vecindario","pos":"noun","rank":2111,"glosses":["neighbourhood"],"ipa":"/beθinˈdaɾjo/","gender":"m","forms":{"plural":"vecindarios"},"examples":[{"text":"¿Cómo es tu vecindario?","en":"What's your neighborhood like?","audio":"https://tatoeba.org/en/audio/download/425334","words":[{"g":"how"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Él no vive en mi vecindario.","en":"He doesn't live in my neighborhood.","audio":"https://tatoeba.org/en/audio/download/1187958","words":[{"g":"he"},{"g":"no / not"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"my"},null]},{"text":"Todos los vecindarios son diferentes.","en":"Every neighborhood is different.","audio":"https://tatoeba.org/en/audio/download/451420","words":[{"g":"all","l":"todo"},{"g":"the / them"},null,{"g":"to be","l":"ser"},{"g":"differently","l":"diferente"}]},{"text":"Cada vecindario es diferente.","en":"Every neighborhood is different.","audio":"https://tatoeba.org/en/audio/download/451410","words":[{"g":"each"},null,{"g":"to be","l":"ser"},{"g":"differently"}]},{"text":"Todos vivimos en el mismo vecindario.","en":"All of us live in the same neighborhood.","words":[{"g":"all","l":"todo"},{"g":"to live","l":"vivir"},{"g":"in / on"},{"g":"the"},{"g":"same"},null]}]}