{"id":"disculpa","lemma":"disculpa","pos":"noun","rank":655,"glosses":["excuse","apology"],"ipa":"/disˈkulpa/","gender":"f","forms":{"plural":"disculpas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q1321_%28spa%29-Marreromarco-disculpa.wav","examples":[{"text":"Te debo una disculpa.","en":"I owe you an apology.","audio":"https://tatoeba.org/en/audio/download/454361"},{"text":"Tengo que pedir disculpas.","en":"I must apologize.","audio":"https://tatoeba.org/en/audio/download/442662"},{"text":"Disculpa, ¿qué hora es?","en":"Excuse me, what time is it?","audio":"https://tatoeba.org/en/audio/download/519370"},{"text":"Pido disculpas por eso.","en":"I apologize for that.","audio":"https://tatoeba.org/en/audio/download/454233"},{"text":"Te debo una gran disculpa.","en":"I owe you a big apology.","audio":"https://tatoeba.org/en/audio/download/501325"}]}