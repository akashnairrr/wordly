{"id":"fracasado","lemma":"fracasado","pos":"adj","rank":3482,"glosses":["failed, unsuccessful"],"ipa":"/fɾakaˈsado/","forms":{"feminine":"fracasada","masculinePlural":"fracasados","femininePlural":"fracasadas"},"examples":[{"text":"Sin su consejo, él hubiera fracasado.","en":"Without her advice, he would have failed.","words":[{"g":"without"},{"g":"his / her / your"},{"g":"advice"},{"g":"he"},{"g":"to have","l":"haber"},null]},{"text":"Nadie me dijo que había fracasado.","en":"No one told me that he had failed.","words":[{"g":"no one"},{"g":"me"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"makes pluperfect to…"},null]},{"text":"Tienen que haber fracasado.","en":"They must've failed.","audio":"https://tatoeba.org/en/audio/download/422643","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to have"},null]},{"text":"Hemos fracasado.","en":"We have failed.","words":[{"g":"heme","l":"hemo"},null]},{"text":"Si no hubiese sido por tu ayuda, habría fracasado.","en":"If it hadn't been for your help, I would've failed.","audio":"https://tatoeba.org/en/audio/download/741068","words":[null,null,{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},{"g":"for / by"},{"g":"your"},{"g":"help, aid"},{"g":"to have","l":"haber"},null],"phrases":[[0,2,"if not"]]}]}