{"id":"hoy","lemma":"hoy","pos":"adv","rank":153,"glosses":["today, tonight (on the current day)"],"ipa":"/ˈoi/","audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q1321_%28spa%29-AdrianAbdulBaha-hoy.wav","examples":[{"text":"¿Quién ha ganado hoy?","en":"Who won today?","audio":"https://tatoeba.org/en/audio/download/410437"},{"text":"Está haciendo calor hoy.","en":"It's hot today.","audio":"https://tatoeba.org/en/audio/download/440922"},{"text":"¿Qué día es hoy?","en":"What day is it?","audio":"https://tatoeba.org/en/audio/download/453286"},{"text":"Lo necesito para hoy.","en":"I need it today.","audio":"https://tatoeba.org/en/audio/download/821205"},{"text":"Hoy es mi día.","en":"I'm lucky today.","audio":"https://tatoeba.org/en/audio/download/441657"}]}