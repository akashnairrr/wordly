{"id":"fracaso","lemma":"fracaso","pos":"noun","rank":2358,"glosses":["downfall, ruin, calamity, disaster","failure, flop"],"ipa":"/fɾaˈkaso/","gender":"m","forms":{"plural":"fracasos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-Marreromarco-fracaso.wav","examples":[{"text":"Él tiene la culpa del fracaso.","en":"He is to blame for the failure.","audio":"https://tatoeba.org/en/audio/download/1061942","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"the / her"},{"g":"fault"},{"g":"of the"},null]},{"text":"Fue un completo fracaso.","en":"It was a complete failure.","audio":"https://tatoeba.org/en/audio/download/600035","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"full, complete"},null]},{"text":"Siempre fracaso.","en":"I always fail.","audio":"https://tatoeba.org/en/audio/download/611220","words":[{"g":"always"},null]},{"text":"Soy responsable por este fracaso.","en":"I am responsible for this failure.","words":[{"g":"to be","l":"ser"},{"g":"responsible"},{"g":"for / by"},{"g":"this"},null]},{"text":"¿De quién es la culpa del fracaso?","en":"Who's to blame for the failure?","words":[{"g":"of / from"},{"g":"who"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"fault"},{"g":"of the"},null]}]}