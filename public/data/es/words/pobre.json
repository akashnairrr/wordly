{"id":"pobre","lemma":"pobre","pos":"adj","rank":518,"glosses":["poor (lacking money, resources, etc.)","poor (pitiable, pitiful)"],"ipa":"/ˈpobɾe/","forms":{"femininePlural":"pobres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-AdrianAbdulBaha-pobre.wav","examples":[{"text":"Ella no es pobre.","en":"She isn't poor.","audio":"https://tatoeba.org/en/audio/download/441121"},{"text":"Ellos son muy pobres.","en":"They're very poor.","audio":"https://tatoeba.org/en/audio/download/449422"},{"text":"Él era muy pobre.","en":"He was very poor.","audio":"https://tatoeba.org/en/audio/download/45365"},{"text":"Éramos pobres, pero felices.","en":"We were poor, but we were happy.","audio":"https://tatoeba.org/en/audio/download/606496"},{"text":"¿Y si soy pobre?","en":"What if I am poor?","audio":"https://tatoeba.org/en/audio/download/637073"}]}