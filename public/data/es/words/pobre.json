{"id":"pobre","lemma":"pobre","pos":"adj","rank":515,"glosses":["poor (lacking money, resources, etc.)","poor (pitiable, pitiful)"],"ipa":"/ˈpobɾe/","forms":{"femininePlural":"pobres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-AdrianAbdulBaha-pobre.wav","examples":[{"text":"Su pobre perro está todavía vivo.","en":"His poor dog is still alive.","audio":"https://tatoeba.org/en/audio/download/705436","words":[{"g":"his / her / your"},null,{"g":"dog"},{"g":"to be","l":"estar"},{"g":"still, yet"},{"g":"alive, living"}]},{"text":"Él es pobre entre pobres.","en":"He's as poor as can be.","audio":"https://tatoeba.org/en/audio/download/704326","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"between"},null]},{"text":"Es pobre, pero feliz.","en":"He is poor, but happy.","audio":"https://tatoeba.org/en/audio/download/637008","words":[{"g":"to be","l":"ser"},null,{"g":"but"},{"g":"happy, merry"}]},{"text":"No somos pobres.","en":"We're not poor.","audio":"https://tatoeba.org/en/audio/download/441268","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"No soy pobre.","en":"I'm not poor.","audio":"https://tatoeba.org/en/audio/download/438143","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]}]}