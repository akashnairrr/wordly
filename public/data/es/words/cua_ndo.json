{"id":"cua_ndo","lemma":"cuándo","pos":"adv","rank":283,"glosses":["when"],"ipa":"/ˈkwando/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Rodelar-cu%C3%A1ndo.wav","examples":[{"text":"¿Cuándo vino él aquí?","en":"When did he come here?","audio":"https://tatoeba.org/en/audio/download/735821","words":[null,{"g":"to come","l":"venir"},{"g":"he"},{"g":"here"}]},{"text":"¿Conoces cómo y cuándo?","en":"Do you know how and when?","audio":"https://tatoeba.org/en/audio/download/518609","words":[{"g":"to know","l":"conocer"},{"g":"how"},{"g":"and"},null]},{"text":"¿Sabes cuándo hacerlo?","en":"Do you know when to do it?","audio":"https://tatoeba.org/en/audio/download/512153","words":[{"g":"to know, to understand","l":"saber"},null,{"g":"to do","l":"hacer"}]},{"text":"No sé cuándo necesito hacerlo.","en":"I don't know when I need to do that.","audio":"https://tatoeba.org/en/audio/download/435743","words":[null,null,null,{"g":"to need","l":"necesitar"},{"g":"to do","l":"hacer"}],"phrases":[[0,2,"I don't know"]]},{"text":"Él me dijo cuándo decir sí.","en":"He told me when to say yes.","words":[{"g":"he"},{"g":"me"},{"g":"to say","l":"decir"},null,{"g":"to say"},{"g":"yes"}]}]}