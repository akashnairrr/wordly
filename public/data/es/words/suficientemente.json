{"id":"suficientemente","lemma":"suficientemente","pos":"adv","rank":1047,"glosses":["sufficiently"],"ipa":"/sufiˌθjenteˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q1321_%28spa%29-Emanuelps27-suficientemente.wav","examples":[{"text":"¿Es suficientemente grande?","en":"Is it large enough?","audio":"https://tatoeba.org/en/audio/download/450094","words":[{"g":"to be","l":"ser"},null,{"g":"big, large"}]},{"text":"¿Está lo suficientemente cerca para ir andando?","en":"Is it close enough to walk there?","audio":"https://tatoeba.org/en/audio/download/687562","words":[{"g":"to be","l":"estar"},{"g":"it / him"},null,{"g":"close"},{"g":"for"},{"g":"to go"},{"g":"to walk, to go","l":"andar"}]},{"text":"Soy suficientemente mayor.","en":"I'm old enough.","audio":"https://tatoeba.org/en/audio/download/441031","words":[{"g":"to be","l":"ser"},null,{"g":"of age"}]},{"text":"No soy lo suficientemente bueno.","en":"I'm not good enough.","audio":"https://tatoeba.org/en/audio/download/637211","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"it / him"},null,{"g":"good"}]},{"text":"Lo sé lo suficientemente bien.","en":"I know it well enough.","audio":"https://tatoeba.org/en/audio/download/453221","words":[{"g":"it / him"},{"g":"to know, to understand","l":"saber"},{"g":"it / him"},null,{"g":"well"}]}]}