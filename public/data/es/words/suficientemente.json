{"id":"suficientemente","lemma":"suficientemente","pos":"adv","rank":1050,"glosses":["sufficiently"],"ipa":"/sufiˌθjenteˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q1321_%28spa%29-Emanuelps27-suficientemente.wav","examples":[{"text":"No soy suficientemente rico.","en":"I'm not rich enough.","audio":"https://tatoeba.org/en/audio/download/448999"},{"text":"Era lo suficientemente ligero.","en":"It was light enough.","audio":"https://tatoeba.org/en/audio/download/448415"},{"text":"No sois suficientemente veloces.","en":"You're not fast enough.","audio":"https://tatoeba.org/en/audio/download/460226"},{"text":"No fuimos suficientemente listos.","en":"We weren't smart enough.","audio":"https://tatoeba.org/en/audio/download/410580"},{"text":"No soy lo suficientemente bueno.","en":"I'm not good enough.","audio":"https://tatoeba.org/en/audio/download/637211"}]}