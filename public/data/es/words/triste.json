{"id":"triste","lemma":"triste","pos":"adj","rank":671,"glosses":["As a temporary state.","As a trait.","dismal, dreary, glum, miserable, melancholic"],"ipa":"/ˈtɾiste/","forms":{"femininePlural":"tristes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f6/LL-Q1321_%28spa%29-AdrianAbdulBaha-triste.wav","examples":[{"text":"Esta canción suena triste.","en":"This song sounds sad.","audio":"https://tatoeba.org/en/audio/download/706341","words":[{"g":"this","l":"este"},{"g":"song"},{"g":"to sound, to ring","l":"sonar"},null]},{"text":"Eso sería muy triste.","en":"That would be very sad.","audio":"https://tatoeba.org/en/audio/download/461102","words":[{"g":"that","l":"ése"},{"g":"to be","l":"ser"},null,null]},{"text":"¿Por qué están tan tristes?","en":"Why are you so sad?","audio":"https://tatoeba.org/en/audio/download/44347","words":[null,null,{"g":"to be","l":"estar"},{"g":"so, as"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Me puso un poco triste.","en":"It made me a little sad.","audio":"https://tatoeba.org/en/audio/download/557715","words":[{"g":"me"},{"g":"to put, to place","l":"poner"},null,null,null],"phrases":[[2,4,"a bit"]]},{"text":"Él nos trajo noticias tristes.","en":"He brought us sad news.","audio":"https://tatoeba.org/en/audio/download/553842","words":[{"g":"he"},{"g":"us"},{"g":"to bring","l":"traer"},{"g":"notice","l":"noticia"},null]}]}