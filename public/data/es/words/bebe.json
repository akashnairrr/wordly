{"id":"bebe","lemma":"bebe","pos":"noun","rank":1030,"glosses":["baby"],"ipa":"/ˈbebe/","gender":"m","forms":{"plural":"bebes","feminine":"beba","femininePlural":"bebas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Marreromarco-bebe.wav","examples":[{"text":"Bebe algo de té.","en":"Drink some tea.","audio":"https://tatoeba.org/en/audio/download/440631"},{"text":"¿Con qué frecuencia bebes?","en":"How often do you drink?","audio":"https://tatoeba.org/en/audio/download/548323"},{"text":"No puedes dejar que Tom beba por sí mismo.","en":"You can't let Tom drink by himself."},{"text":"No bebas el agua.","en":"Don't drink the water.","audio":"https://tatoeba.org/en/audio/download/454557"},{"text":"El gato bebe leche.","en":"The cat drinks milk.","audio":"https://tatoeba.org/en/audio/download/734270"}]}