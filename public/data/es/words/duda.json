{"id":"duda","lemma":"duda","pos":"noun","rank":710,"glosses":["doubt","question","second thought"],"ipa":"/ˈduda/","gender":"f","forms":{"plural":"dudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-AdrianAbdulBaha-duda.wav","examples":[{"text":"No tengo ninguna duda.","en":"I have no doubts.","audio":"https://tatoeba.org/en/audio/download/41287"},{"text":"Tomás nunca tuvo dudas.","en":"Tom never had doubts.","audio":"https://tatoeba.org/en/audio/download/455282"},{"text":"Duda de todo y de todos.","en":"Doubt everything and everyone.","audio":"https://tatoeba.org/en/audio/download/1153221"},{"text":"Todavía tengo mis dudas.","en":"I still have my doubts.","audio":"https://tatoeba.org/en/audio/download/459126"},{"text":"Parece no haber duda sobre eso.","en":"There seems no doubt about it.","audio":"https://tatoeba.org/en/audio/download/585898"}]}