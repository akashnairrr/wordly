{"id":"cualquiera","lemma":"cualquiera","pos":"pron","rank":597,"glosses":["anyone, whoever, whomever"],"ipa":"/kwalˈkjeɾa/","forms":{"plural":"cualesquiera"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-Eavqwiki-cualquiera.wav","examples":[{"text":"Cualquiera logra hacer eso.","en":"Anyone can do that.","audio":"https://tatoeba.org/en/audio/download/449983"},{"text":"Cualquiera puede hacer esto.","en":"Anyone can do this.","audio":"https://tatoeba.org/en/audio/download/449235"},{"text":"Cualquiera pudo hacer esto.","en":"Anybody could do this.","audio":"https://tatoeba.org/en/audio/download/454023"},{"text":"Esto avergonzaría a cualquiera.","en":"This would embarrass anyone.","audio":"https://tatoeba.org/en/audio/download/594615"},{"text":"Eso lo puede hacer cualquiera.","en":"Anyone can do that.","audio":"https://tatoeba.org/en/audio/download/449900"}]}