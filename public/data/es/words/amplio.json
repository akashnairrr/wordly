{"id":"amplio","lemma":"amplio","pos":"adj","rank":4991,"glosses":["broad, large, spacious, wide, expansive","broad, wide, comprehensive, extensive, large, wide-ranging, ample"],"ipa":"/ˈampljo/","forms":{"feminine":"amplia","masculinePlural":"amplios","femininePlural":"amplias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Marreromarco-amplio.wav","examples":[{"text":"La oficina nueva es más amplia.","en":"The new office is more spacious.","audio":"https://tatoeba.org/en/audio/download/301913","words":[{"g":"the / her"},{"g":"office"},{"g":"news, novelty"},null,null,null],"phrases":[[3,5,"furthermore"]]},{"text":"El río es amplio.","en":"The river is wide.","audio":"https://tatoeba.org/en/audio/download/519454","words":[{"g":"the"},{"g":"river"},{"g":"to be","l":"ser"},null]},{"text":"Ella tiene una manera amplia de ver las cosas.","en":"She has a broad view of things.","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"way"},null,{"g":"of / from"},{"g":"to see, to spot"},{"g":"the / them"},{"g":"thing","l":"cosa"}]},{"text":"El mercado es amplio.","en":"The market is big.","words":[{"g":"the"},{"g":"market"},{"g":"to be","l":"ser"},null]},{"text":"Tom tiene un amplio círculo de amigos.","en":"Tom has a wide circle of friends.","words":[null,{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"circle"},{"g":"of / from"},{"g":"friend","l":"amigo"}]}]}