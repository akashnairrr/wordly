{"id":"arriba","lemma":"arriba","pos":"intj","rank":305,"glosses":["come on!","hurray for (someone)!","up with"],"ipa":"/aˈriba/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-AdrianAbdulBaha-arriba.wav","examples":[{"text":"No mires hacia arriba.","en":"Don't look up.","audio":"https://tatoeba.org/en/audio/download/440121"},{"text":"Sube las bolsas arriba.","en":"Take the bags upstairs.","audio":"https://tatoeba.org/en/audio/download/514957"},{"text":"Tenemos cuatro habitaciones arriba.","en":"We have four bedrooms upstairs.","audio":"https://tatoeba.org/en/audio/download/734492"},{"text":"Abrí el cajón de arriba.","en":"I opened the top drawer.","audio":"https://tatoeba.org/en/audio/download/456719"},{"text":"¿Qué está pasando allá arriba?","en":"What's happening up there?","audio":"https://tatoeba.org/en/audio/download/606546"}]}