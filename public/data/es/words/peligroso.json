{"id":"peligroso","lemma":"peligroso","pos":"adj","rank":761,"glosses":["perilous, dangerous"],"ipa":"/peliˈɡɾoso/","forms":{"feminine":"peligrosa","masculinePlural":"peligrosos","femininePlural":"peligrosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a7/LL-Q1321_%28spa%29-AdrianAbdulBaha-peligroso.wav","examples":[{"text":"Su plan es peligroso.","en":"His plan is dangerous!","audio":"https://tatoeba.org/en/audio/download/734274"},{"text":"Es una calle peligrosa.","en":"This is a dangerous road.","audio":"https://tatoeba.org/en/audio/download/518987"},{"text":"Ellos son muy peligrosos.","en":"They're very dangerous.","audio":"https://tatoeba.org/en/audio/download/461590"},{"text":"Algunas serpientes son peligrosas.","en":"Some snakes are dangerous.","audio":"https://tatoeba.org/en/audio/download/639784"},{"text":"Eso puede ser peligroso.","en":"That can be dangerous.","audio":"https://tatoeba.org/en/audio/download/461160"}]}