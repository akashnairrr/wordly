{"id":"valor","lemma":"valor","pos":"noun","rank":859,"glosses":["value (all senses)","security","worth"],"ipa":"/baˈloɾ/","gender":"m","forms":{"plural":"valores"},"order":993,"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q1321_%28spa%29-AdrianAbdulBaha-valor.wav","examples":[{"text":"Es de poco valor.","en":"It is of little value.","audio":"https://tatoeba.org/en/audio/download/78227","words":[{"g":"to be","l":"ser"},{"g":"of / from"},{"g":"little, not much"},null]},{"text":"Tuvo el valor de decirlo.","en":"She had the courage to say it.","audio":"https://tatoeba.org/en/audio/download/642178","words":[{"g":"to have","l":"tener"},{"g":"the"},null,{"g":"of / from"},{"g":"to say","l":"decir"}]},{"text":"Eso no tiene valor para nosotros.","en":"That's of no value to us.","audio":"https://tatoeba.org/en/audio/download/706051","words":[{"g":"that","l":"ése"},{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"for"},{"g":"we"}]}]}