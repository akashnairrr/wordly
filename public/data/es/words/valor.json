{"id":"valor","lemma":"valor","pos":"noun","rank":861,"glosses":["value (all senses)","security","worth"],"ipa":"/baˈloɾ/","gender":"m","forms":{"plural":"valores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q1321_%28spa%29-AdrianAbdulBaha-valor.wav","examples":[{"text":"Es de gran valor.","en":"It is of great value.","audio":"https://tatoeba.org/en/audio/download/454445"},{"text":"No compartimos los mismos valores.","en":"We don't share the same values."},{"text":"Es de poco valor.","en":"It is of little value.","audio":"https://tatoeba.org/en/audio/download/78227"},{"text":"Los valores de la bolsa cayeron.","en":"Stock prices dropped."},{"text":"Parece no tener ningún valor.","en":"It seems worthless.","audio":"https://tatoeba.org/en/audio/download/119083"}]}