{"id":"orden","lemma":"orden","pos":"noun","rank":421,"glosses":["order (command)","order (request for some product or service or that which is requested)","order (law)"],"ipa":"/ˈoɾden/","gender":"f","forms":{"plural":"órdenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Marreromarco-orden.wav","examples":[{"text":"Esto es una orden.","en":"This is an order.","audio":"https://tatoeba.org/en/audio/download/444127"},{"text":"Esas son nuestras órdenes.","en":"Those are our orders.","audio":"https://tatoeba.org/en/audio/download/800867"},{"text":"Todo está en orden.","en":"Everything's fine.","audio":"https://tatoeba.org/en/audio/download/444292"},{"text":"Mis órdenes son incondicionales.","en":"My orders are absolute.","audio":"https://tatoeba.org/en/audio/download/734456"},{"text":"Fuego a mi orden.","en":"Fire on my command.","audio":"https://tatoeba.org/en/audio/download/799969"}]}