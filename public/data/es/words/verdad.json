{"id":"verdad","lemma":"verdad","pos":"noun","rank":70,"glosses":["truth","fact"],"ipa":"/beɾˈda/","gender":"f","forms":{"plural":"verdades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-verdad.wav","examples":[{"text":"¿Qué es la verdad?","en":"What is truth?","audio":"https://tatoeba.org/en/audio/download/721607"},{"text":"De verdad lo siento.","en":"I'm truly sorry.","audio":"https://tatoeba.org/en/audio/download/441968"},{"text":"¿Eso no es verdad?","en":"Isn't that true?","audio":"https://tatoeba.org/en/audio/download/75812"},{"text":"Debe de ser verdad.","en":"It must be true.","audio":"https://tatoeba.org/en/audio/download/444294"},{"text":"Eso no es verdad.","en":"That isn't true.","audio":"https://tatoeba.org/en/audio/download/442067"}]}