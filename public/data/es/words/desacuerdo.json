{"id":"desacuerdo","lemma":"desacuerdo","pos":"noun","rank":4677,"glosses":["disagreement"],"ipa":"/desaˈkweɾdo/","gender":"m","forms":{"plural":"desacuerdos"},"examples":[{"text":"Estoy totalmente en desacuerdo contigo.","en":"I completely disagree with you.","audio":"https://tatoeba.org/en/audio/download/586916","words":[{"g":"to be","l":"estar"},{"g":"totally"},{"g":"in / on"},null,{"g":"with you"}]},{"text":"El jurado está en desacuerdo.","en":"The jury is hung.","audio":"https://tatoeba.org/en/audio/download/443424","words":[{"g":"the"},{"g":"juror"},{"g":"to be","l":"estar"},{"g":"in / on"},null]},{"text":"Me duele estar en desacuerdo con tu opinión.","en":"It pains me to disagree with your opinion.","words":[{"g":"me"},{"g":"to hurt","l":"doler"},{"g":"to be"},{"g":"in / on"},null,{"g":"with"},{"g":"your"},{"g":"opinion"}]},{"text":"Esta es la razón por la que estoy en desacuerdo contigo.","en":"This is the reason I disagree with you.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"reason"},{"g":"for / by"},{"g":"the / her"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"with you"}]},{"text":"Tom está en desacuerdo con Mary en ese tema.","en":"Tom disagrees with Mary on that matter.","words":[null,{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"with"},null,{"g":"in / on"},{"g":"that"},{"g":"theme"}]}]}