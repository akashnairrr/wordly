{"id":"sencillo","lemma":"sencillo","pos":"adj","rank":1624,"glosses":["plain","simple, straightforward"],"ipa":"/senˈθiʝo/","forms":{"feminine":"sencilla","masculinePlural":"sencillos","femininePlural":"sencillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q1321_%28spa%29-Marreromarco-sencillo.wav","examples":[{"text":"Encontrar su oficina fue sencillo.","en":"Finding his office was easy.","audio":"https://tatoeba.org/en/audio/download/611592","words":[{"g":"to meet"},{"g":"his / her / your"},{"g":"office"},{"g":"to be","l":"ser"},null]},{"text":"Ella le hizo una cena sencilla.","en":"She made him a simple dinner.","words":[{"g":"she"},{"g":"him / her"},{"g":"to do","l":"hacer"},{"g":"a"},{"g":"supper, dinner"},null]},{"text":"Esto es sencillo.","en":"This is easy.","audio":"https://tatoeba.org/en/audio/download/438346","words":[{"g":"this"},{"g":"to be","l":"ser"},null]},{"text":"Yo llevo una vida sencilla.","en":"I live a simple life.","audio":"https://tatoeba.org/en/audio/download/454369","words":[{"g":"I"},{"g":"to take somewhere","l":"llevar"},{"g":"a"},{"g":"life"},null]},{"text":"Vamos a comenzar por las preguntas sencillas.","en":"Let's start with the easy questions.","audio":"https://tatoeba.org/en/audio/download/645694","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to begin, to commence"},{"g":"for / by"},{"g":"the / them"},{"g":"question","l":"pregunta"},null]}]}