{"id":"hasta","lemma":"hasta","pos":"prep","rank":98,"glosses":["until","up to, to the point of, as much as"],"ipa":"/ˈasta/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-AdrianAbdulBaha-hasta.wav","examples":[{"text":"Trabajo hasta muy tarde.","en":"I work until very late.","audio":"https://tatoeba.org/en/audio/download/458815","words":[{"g":"work, job"},null,null,{"g":"late"}]},{"text":"¿Puede esperar hasta mañana?","en":"Can you wait until tomorrow?","audio":"https://tatoeba.org/en/audio/download/513120","words":[{"g":"to be able to, can","l":"poder"},{"g":"to hope"},null,{"g":"tomorrow"}]},{"text":"¿Qué te trae hasta aquí?","en":"What brings you here?","audio":"https://tatoeba.org/en/audio/download/103641","words":[{"g":"what"},{"g":"you"},{"g":"to bring","l":"traer"},null,{"g":"here"}]},{"text":"Tienes hasta medianoche.","en":"You have until midnight.","audio":"https://tatoeba.org/en/audio/download/513291","words":[{"g":"to have","l":"tener"},null,{"g":"midnight"}]},{"text":"Hasta ayer no sabía la verdad.","en":"I didn't know the truth until yesterday.","audio":"https://tatoeba.org/en/audio/download/611646","words":[null,{"g":"yesterday"},{"g":"no / not"},{"g":"to know, to understand","l":"saber"},null,null],"phrases":[[4,6,"honestly, to be honest"]]}]}