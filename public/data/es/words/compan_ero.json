{"id":"compan_ero","lemma":"compañero","pos":"noun","rank":743,"glosses":["companion (someone with whom one spends time or keeps company)","mate, colleague; (with a qualifier) fellow X, classmate, coworker, etc. (someone with whom something is shared)","fellow member of a political group; comrade"],"ipa":"/kompaˈɲeɾo/","gender":"m","forms":{"plural":"compañeros","feminine":"compañera","femininePlural":"compañeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-AdrianAbdulBaha-compa%C3%B1ero.wav","examples":[{"text":"Odio a mi compañero de habitación.","en":"I hate my roommate.","audio":"https://tatoeba.org/en/audio/download/139841","words":[{"g":"hate"},{"g":"to"},{"g":"my"},null,{"g":"of / from"},{"g":"room"}]},{"text":"Mis compañeros me gustan mucho.","en":"I really like my teammates.","audio":"https://tatoeba.org/en/audio/download/611740","words":[{"g":"my"},null,{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"much"}]},{"text":"Conozco a tu compañera de habitación.","en":"I know your roommate.","audio":"https://tatoeba.org/en/audio/download/568021","words":[{"g":"to know","l":"conocer"},{"g":"to"},{"g":"your"},null,{"g":"of / from"},{"g":"room"}]},{"text":"No tengo un compañero.","en":"I don't have a partner.","audio":"https://tatoeba.org/en/audio/download/630052","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"No puedo hablar por todos mis compañeros.","en":"I can't speak for all of my colleagues.","audio":"https://tatoeba.org/en/audio/download/728625","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to talk"},{"g":"for / by"},{"g":"all","l":"todo"},{"g":"my"},null]}]}