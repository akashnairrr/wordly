{"id":"idea","lemma":"idea","pos":"noun","rank":179,"glosses":["idea"],"ipa":"/iˈdea/","gender":"f","forms":{"plural":"ideas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-AdrianAbdulBaha-idea.wav","examples":[{"text":"No tenía ni idea.","en":"I had no clue.","audio":"https://tatoeba.org/en/audio/download/534469"},{"text":"No tengo más ideas.","en":"I ran out of ideas.","audio":"https://tatoeba.org/en/audio/download/449029"},{"text":"Yo no tuve idea.","en":"I had no idea.","audio":"https://tatoeba.org/en/audio/download/440294"},{"text":"Tomás tiene otras ideas.","en":"Tom has other ideas.","audio":"https://tatoeba.org/en/audio/download/455122"},{"text":"Eso fue idea mía.","en":"It was my idea.","audio":"https://tatoeba.org/en/audio/download/139840"}]}