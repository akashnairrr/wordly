{"id":"orilla","lemma":"orilla","pos":"noun","rank":3238,"glosses":["shore, bank (of a watercourse)","edge, border"],"ipa":"/oˈɾiʝa/","gender":"f","forms":{"plural":"orillas"},"order":3242,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q1321_%28spa%29-Marreromarco-orilla.wav","examples":[{"text":"Paseamos por la orilla del lago.","en":"We walked along the shore of the lake.","audio":"https://tatoeba.org/en/audio/download/705662","words":[{"g":"to stroll","l":"pasear"},{"g":"for / by"},{"g":"the / her"},null,{"g":"of the"},{"g":"lake"}]},{"text":"Hay un montón de basura en la otra orilla del río.","en":"There's a lot of trash on the far bank of the river.","audio":"https://tatoeba.org/en/audio/download/589873","words":[{"g":"to have","l":"haber"},null,null,{"g":"of / from"},{"g":"trash"},{"g":"in / on"},{"g":"the / her"},{"g":"someone else","l":"otro"},null,{"g":"of the"},{"g":"river"}],"phrases":[[1,3,"synonym of mucho"]]},{"text":"La niña estaba lloriqueando en la orilla de la sala.","en":"The girl was sobbing in the corner of the schoolroom.","words":[{"g":"the / her"},{"g":"girl"},{"g":"to be","l":"estar"},{"g":"to cry a little","l":"lloriquear"},{"g":"in / on"},{"g":"the / her"},null,null,null,{"g":"room"}],"phrases":[[7,9,"of the"]]}]}