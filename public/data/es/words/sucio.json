{"id":"sucio","lemma":"sucio","pos":"adj","rank":1347,"glosses":["dirty, filthy","sinful, tainted","obscene, vulgar"],"ipa":"/ˈsuθjo/","forms":{"feminine":"sucia","masculinePlural":"sucios","femininePlural":"sucias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-Rodelar-sucio.wav","examples":[{"text":"El niño está sucio.","en":"The child is dirty.","audio":"https://tatoeba.org/en/audio/download/730230"},{"text":"El agua está sucia.","en":"The water is dirty.","audio":"https://tatoeba.org/en/audio/download/1253064"},{"text":"Tus pies están sucios.","en":"Your feet are dirty.","audio":"https://tatoeba.org/en/audio/download/50236"},{"text":"Tengo las manos sucias.","en":"My hands are dirty.","audio":"https://tatoeba.org/en/audio/download/820022"},{"text":"Este tenedor está sucio.","en":"This fork is dirty.","audio":"https://tatoeba.org/en/audio/download/501537"}]}