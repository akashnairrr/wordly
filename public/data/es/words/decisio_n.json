{"id":"decisio_n","lemma":"decisión","pos":"noun","rank":599,"glosses":["decision"],"ipa":"/deθiˈsjon/","gender":"f","forms":{"plural":"decisiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Marreromarco-decisi%C3%B3n.wav","examples":[{"text":"He tomado mi decisión.","en":"I've made my decision.","audio":"https://tatoeba.org/en/audio/download/850116"},{"text":"Tienes que tomar decisiones.","en":"You have to make choices.","audio":"https://tatoeba.org/en/audio/download/586686"},{"text":"La decisión era fácil.","en":"The decision was easy.","audio":"https://tatoeba.org/en/audio/download/262789"},{"text":"No me gusta tomar decisiones.","en":"I don't like making decisions.","audio":"https://tatoeba.org/en/audio/download/541172"},{"text":"Fue una sabia decisión.","en":"It was a wise decision.","audio":"https://tatoeba.org/en/audio/download/460840"}]}