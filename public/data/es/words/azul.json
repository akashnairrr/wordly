{"id":"azul","lemma":"azul","pos":"noun","rank":826,"glosses":["blue","a police officer","A grade of 4,0 or above in the Chilean academic grading."],"ipa":"/aˈθul/","gender":"m","forms":{"plural":"azules"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Rodrigo5260-azul.wav","formAudio":{"azules":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Rdrg109-azules.wav"},"examples":[{"text":"El coche es azul.","en":"The car is blue.","audio":"https://tatoeba.org/en/audio/download/703768"},{"text":"Mis ojos son azules.","en":"I have blue eyes.","audio":"https://tatoeba.org/en/audio/download/43617"},{"text":"El mar es azul.","en":"The sea is blue.","audio":"https://tatoeba.org/en/audio/download/221603"},{"text":"Sus ojos son azules.","en":"Her eyes are blue.","audio":"https://tatoeba.org/en/audio/download/444130"},{"text":"El cielo es azul.","en":"The sky is blue.","audio":"https://tatoeba.org/en/audio/download/39214"}]}