{"id":"pena","lemma":"pena","pos":"noun","rank":490,"glosses":["punishment, sentence","pity (sympathy)","used in dar pena"],"ipa":"/ˈpena/","gender":"f","forms":{"plural":"penas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-AdrianAbdulBaha-pena.wav","examples":[{"text":"Vale la pena intentarlo.","en":"It's worth a try.","audio":"https://tatoeba.org/en/audio/download/41025"},{"text":"Se entregó a las penas.","en":"She abandoned herself to grief."},{"text":"Merece la pena intentarlo.","en":"It's worth a try.","audio":"https://tatoeba.org/en/audio/download/41026"},{"text":"A duras penas se hacía entender.","en":"He could hardly make himself understood."},{"text":"Siento pena por Tom.","en":"I feel bad for Tom.","audio":"https://tatoeba.org/en/audio/download/78290"}]}