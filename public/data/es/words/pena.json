{"id":"pena","lemma":"pena","pos":"noun","rank":487,"glosses":["punishment, sentence","pity (sympathy)","used in dar pena"],"ipa":"/ˈpena/","gender":"f","forms":{"plural":"penas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-AdrianAbdulBaha-pena.wav","examples":[{"text":"Me das pena.","en":"I pity you.","audio":"https://tatoeba.org/en/audio/download/410068","words":[{"g":"me"},{"g":"to give, to give out","l":"dar"},null]},{"text":"¿Vale la pena?","en":"Is it worth it?","audio":"https://tatoeba.org/en/audio/download/454902","words":[{"g":"a voucher"},{"g":"the / her"},null]},{"text":"¡Qué pena que no sepas bailar!","en":"What a pity you can't dance!","audio":"https://tatoeba.org/en/audio/download/767954","words":[{"g":"what"},null,{"g":"that"},{"g":"no / not"},{"g":"to know, to understand","l":"saber"},{"g":"to dance"}]},{"text":"Se entregó a las penas.","en":"She abandoned herself to grief.","words":[{"g":"oneself"},{"g":"to deliver","l":"entregar"},{"g":"to"},{"g":"the / them"},null]},{"text":"Merece la pena intentarlo.","en":"It's worth a try.","audio":"https://tatoeba.org/en/audio/download/41026","words":[{"g":"to deserve","l":"merecer"},{"g":"the / her"},null,{"g":"to try, to attempt","l":"intentar"}]}]}