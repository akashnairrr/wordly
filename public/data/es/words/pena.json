{"id":"pena","lemma":"pena","pos":"noun","rank":487,"glosses":["punishment, sentence","pity (sympathy)","used in dar pena"],"ipa":"/ˈpena/","gender":"f","forms":{"plural":"penas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-AdrianAbdulBaha-pena.wav","examples":[{"text":"Vale la pena intentarlo.","en":"It's worth a try.","audio":"https://tatoeba.org/en/audio/download/41025","words":[{"g":"a voucher"},{"g":"the / her"},null,{"g":"to try, to attempt","l":"intentar"}]},{"text":"Vale la pena visitar el castillo.","en":"The castle is worth visiting.","audio":"https://tatoeba.org/en/audio/download/642329","words":[{"g":"a voucher"},{"g":"the / her"},null,{"g":"to visit"},{"g":"the"},{"g":"castle"}]},{"text":"No sé si vale la pena.","en":"I don't know if it's worth it.","audio":"https://tatoeba.org/en/audio/download/690851","words":[null,null,{"g":"if, whether"},{"g":"a voucher"},{"g":"the / her"},null],"phrases":[[0,2,"I don't know"]]},{"text":"Qué pena.","en":"What a pity!","audio":"https://tatoeba.org/en/audio/download/39181","words":[{"g":"what"},null]},{"text":"A duras penas se hacía entender.","en":"He could hardly make himself understood.","words":[{"g":"to"},{"g":"hard","l":"duro"},null,{"g":"oneself"},{"g":"to do","l":"hacer"},{"g":"to understand"}]}]}