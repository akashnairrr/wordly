{"id":"escena","lemma":"escena","pos":"noun","rank":684,"glosses":["scene","stage","cutscene"],"ipa":"/esˈθena/","gender":"f","forms":{"plural":"escenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6d/LL-Q1321_%28spa%29-Marreromarco-escena.wav","examples":[{"text":"Esta escena me encanta.","en":"This scene delights me.","audio":"https://tatoeba.org/en/audio/download/639917","words":[{"g":"this","l":"este"},null,{"g":"me"},{"g":"to charm, to enchant","l":"encantar"}]},{"text":"No hagas una escena.","en":"Don't make a scene.","audio":"https://tatoeba.org/en/audio/download/586011","words":[{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"a"},null]},{"text":"Fui a la escena del crimen.","en":"I went to the scene of the crime.","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},null,{"g":"of the"},{"g":"crime"}]},{"text":"Fue una escena horrorosa.","en":"It was a horrible scene.","audio":"https://tatoeba.org/en/audio/download/594636","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"horrible","l":"horroroso"}]},{"text":"La primera escena tiene mucho movimiento.","en":"The first scene has a lot of action.","words":[{"g":"the / her"},{"g":"first gear"},null,{"g":"to have","l":"tener"},{"g":"much"},{"g":"movement"}]}]}