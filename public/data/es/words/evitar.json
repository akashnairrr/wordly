{"id":"evitar","lemma":"evitar","pos":"verb","rank":866,"glosses":["to avoid, to bypass, to evade, to circumvent, to dodge, to shun, to eschew (to steer clear of)","to avoid, to prevent, to keep from, to stop from, to avert, to obviate, to deter","to help (abstain from doing) (always in the negative)"],"ipa":"/ebiˈtaɾ/","conjugation":{"indicative":{"present":{"1s":"evito","2s":"evitas","3s":"evita","1p":"evitamos","2p":"evitáis","3p":"evitan"},"imperfect":{"1s":"evitaba","2s":"evitabas","3s":"evitaba","1p":"evitábamos","2p":"evitabais","3p":"evitaban"},"preterite":{"1s":"evité","2s":"evitaste","3s":"evitó","1p":"evitamos","2p":"evitasteis","3p":"evitaron"},"future":{"1s":"evitaré","2s":"evitarás","3s":"evitará","1p":"evitaremos","2p":"evitaréis","3p":"evitarán"},"conditional":{"1s":"evitaría","2s":"evitarías","3s":"evitaría","1p":"evitaríamos","2p":"evitaríais","3p":"evitarían"}},"subjunctive":{"present":{"1s":"evite","2s":"evites","3s":"evite","1p":"evitemos","2p":"evitéis","3p":"eviten"},"imperfect":{"1s":"evitara","2s":"evitaras","3s":"evitara","1p":"evitáramos","2p":"evitarais","3p":"evitaran"}},"imperative":{"affirmative":{"2s":"evita","3s":"evite","1p":"evitemos","2p":"evitad","3p":"eviten"},"negative":{"2s":"evites","3s":"evite","1p":"evitemos","2p":"evitéis","3p":"eviten"}}},"nonFinite":{"gerund":"evitando","participle":"evitado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-AdrianAbdulBaha-evitar.wav","examples":[{"text":"Ella me evita.","en":"She avoids me.","audio":"https://tatoeba.org/en/audio/download/501148","words":[{"g":"she"},{"g":"me"},null]},{"text":"¿Cómo puedo evitar que pase esto?","en":"How can I prevent this from happening?","audio":"https://tatoeba.org/en/audio/download/689358","words":[{"g":"how"},{"g":"to be able to, can","l":"poder"},null,{"g":"that"},{"g":"pass, permit"},{"g":"this"}]},{"text":"Me estás evitando.","en":"You're avoiding me.","audio":"https://tatoeba.org/en/audio/download/449319","words":[{"g":"me"},{"g":"to be","l":"estar"},null]},{"text":"Evitó responder a mis preguntas.","en":"She avoided answering my questions.","audio":"https://tatoeba.org/en/audio/download/598993","words":[null,{"g":"to answer, to reply"},{"g":"to"},{"g":"my"},{"g":"question","l":"pregunta"}]},{"text":"No puedo evitar hacer eso.","en":"I can't help doing that.","audio":"https://tatoeba.org/en/audio/download/460140","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},null,{"g":"to do"},{"g":"that","l":"ése"}]}]}