{"id":"evitar","lemma":"evitar","pos":"verb","rank":869,"glosses":["to avoid, to bypass, to evade, to circumvent, to dodge, to shun, to eschew (to steer clear of)","to avoid, to prevent, to keep from, to stop from, to avert, to obviate, to deter","to help (abstain from doing) (always in the negative)"],"ipa":"/ebiˈtaɾ/","conjugation":{"indicative":{"present":{"1s":"evito","2s":"evitas","3s":"evita","1p":"evitamos","2p":"evitáis","3p":"evitan"},"imperfect":{"1s":"evitaba","2s":"evitabas","3s":"evitaba","1p":"evitábamos","2p":"evitabais","3p":"evitaban"},"preterite":{"1s":"evité","2s":"evitaste","3s":"evitó","1p":"evitamos","2p":"evitasteis","3p":"evitaron"},"future":{"1s":"evitaré","2s":"evitarás","3s":"evitará","1p":"evitaremos","2p":"evitaréis","3p":"evitarán"},"conditional":{"1s":"evitaría","2s":"evitarías","3s":"evitaría","1p":"evitaríamos","2p":"evitaríais","3p":"evitarían"}},"subjunctive":{"present":{"1s":"evite","2s":"evites","3s":"evite","1p":"evitemos","2p":"evitéis","3p":"eviten"},"imperfect":{"1s":"evitara","2s":"evitaras","3s":"evitara","1p":"evitáramos","2p":"evitarais","3p":"evitaran"}},"imperative":{"affirmative":{"2s":"evita","3s":"evite","1p":"evitemos","2p":"evitad","3p":"eviten"},"negative":{"2s":"evites","3s":"evite","1p":"evitemos","2p":"evitéis","3p":"eviten"}}},"nonFinite":{"gerund":"evitando","participle":"evitado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-AdrianAbdulBaha-evitar.wav","examples":[{"text":"No se puede evitar.","en":"It can't be helped.","audio":"https://tatoeba.org/en/audio/download/798856"},{"text":"Estamos evitando a Tom.","en":"We're avoiding Tom.","audio":"https://tatoeba.org/en/audio/download/799198"},{"text":"Creo que ese accidente podría haberse evitado.","en":"I think that accident could've been prevented.","audio":"https://tatoeba.org/en/audio/download/462052"},{"text":"Evito manejar de noche si puedo.","en":"I avoid driving at night if I can."},{"text":"¿Por qué me evitas?","en":"Why are you avoiding me?"}]}