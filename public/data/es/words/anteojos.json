{"id":"anteojos","lemma":"anteojos","pos":"noun","rank":4244,"glosses":["glasses"],"ipa":"/anteˈoxos/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-AdrianAbdulBaha-anteojos.wav","examples":[{"text":"¿Sabes dónde están mis anteojos?","en":"Do you know where my glasses are?","audio":"https://tatoeba.org/en/audio/download/586573","words":[{"g":"to know, to understand","l":"saber"},{"g":"where"},{"g":"to be","l":"estar"},{"g":"my"},null]},{"text":"Estoy buscando mis anteojos.","en":"I'm looking for my glasses.","audio":"https://tatoeba.org/en/audio/download/734325","words":[{"g":"to be","l":"estar"},{"g":"to seek","l":"buscar"},{"g":"my"},null]},{"text":"¿Alguien vio dónde dejé mis anteojos?","en":"Did anyone see where I left my glasses?","words":[{"g":"someone, somebody"},{"g":"to see, to spot","l":"ver"},{"g":"where"},{"g":"to leave","l":"dejar"},{"g":"my"},null]},{"text":"Él se sacó los anteojos.","en":"He took off his glasses.","audio":"https://tatoeba.org/en/audio/download/461410","words":[{"g":"he"},{"g":"oneself"},{"g":"to put out, to get out","l":"sacar"},{"g":"the / them"},null]},{"text":"El muchacho usa anteojos.","en":"The boy is wearing glasses.","words":[{"g":"the"},{"g":"boy or young adult"},{"g":"to use","l":"usar"},null]}]}