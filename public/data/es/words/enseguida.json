{"id":"enseguida","lemma":"enseguida","pos":"adv","rank":701,"glosses":["immediately","next"],"ipa":"/enseˈɡida/","examples":[{"text":"¿Lo puedo hacer enseguida?","en":"May I do it right now?","audio":"https://tatoeba.org/en/audio/download/460471","words":[{"g":"it / him"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},null]},{"text":"¿Tengo que ir enseguida?","en":"Do I have to go right now?","audio":"https://tatoeba.org/en/audio/download/735563","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to go"},null]},{"text":"Ella vino enseguida.","en":"She came at once.","audio":"https://tatoeba.org/en/audio/download/442876","words":[{"g":"she"},{"g":"to come","l":"venir"},null]},{"text":"No necesitaba hacerlo enseguida.","en":"I didn't need to do that right away.","audio":"https://tatoeba.org/en/audio/download/435752","words":[{"g":"no / not"},{"g":"to need","l":"necesitar"},{"g":"to do","l":"hacer"},null]},{"text":"Dice que viene enseguida.","en":"He says he will come at once.","audio":"https://tatoeba.org/en/audio/download/706870","words":[{"g":"to say","l":"decir"},{"g":"that"},{"g":"to come","l":"venir"},null]}]}