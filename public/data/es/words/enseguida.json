{"id":"enseguida","lemma":"enseguida","pos":"adv","rank":704,"glosses":["immediately","next"],"ipa":"/enseˈɡida/","examples":[{"text":"Tom se fue enseguida.","en":"Tom left right away.","audio":"https://tatoeba.org/en/audio/download/800120"},{"text":"¿Lo puedo hacer enseguida?","en":"May I do it right now?","audio":"https://tatoeba.org/en/audio/download/460471"},{"text":"Tuvimos que marcharnos enseguida.","en":"We had to leave quickly.","audio":"https://tatoeba.org/en/audio/download/556923"},{"text":"¿Tengo que ir enseguida?","en":"Do I have to go right now?","audio":"https://tatoeba.org/en/audio/download/735563"},{"text":"Dice que viene enseguida.","en":"He says he will come at once.","audio":"https://tatoeba.org/en/audio/download/706870"}]}