{"id":"enseguida","lemma":"enseguida","pos":"adv","rank":701,"glosses":["immediately","next"],"ipa":"/enseˈɡida/","examples":[{"text":"¿Lo puedo hacer enseguida?","en":"May I do it right now?","audio":"https://tatoeba.org/en/audio/download/460471","words":[{"g":"it / him"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},null]},{"text":"Me pondré con eso enseguida.","en":"I'll get right on that.","audio":"https://tatoeba.org/en/audio/download/532296","words":[{"g":"me"},{"g":"to put, to place","l":"poner"},{"g":"with"},{"g":"that","l":"ése"},null]},{"text":"¿Tengo que ir enseguida?","en":"Do I have to go right now?","audio":"https://tatoeba.org/en/audio/download/735563","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to go"},null]},{"text":"Ella vino enseguida.","en":"She came at once.","audio":"https://tatoeba.org/en/audio/download/442876","words":[{"g":"she"},{"g":"to come","l":"venir"},null]},{"text":"Él volvió enseguida.","en":"He came back soon.","audio":"https://tatoeba.org/en/audio/download/444087","words":[{"g":"he"},{"g":"to return","l":"volver"},null]}]}