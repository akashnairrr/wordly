{"id":"cienti_fico","lemma":"científico","pos":"adj","rank":2068,"glosses":["scientific"],"ipa":"/θjenˈtifiko/","forms":{"feminine":"científica","masculinePlural":"científicos","femininePlural":"científicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-AdrianAbdulBaha-cient%C3%ADfico.wav","formAudio":{"científica":"https://upload.wikimedia.org/wikipedia/commons/9/93/LL-Q1321_%28spa%29-Akhram-cient%C3%ADfica.wav","científicos":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-GlyphEnjoyer-cient%C3%ADficos.wav"},"examples":[{"text":"Él es un gran científico.","en":"He is a great scientist.","audio":"https://tatoeba.org/en/audio/download/461463","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Él dijo: \"Quiero ser científico\".","en":"He said, \"I want to be a scientist.\"","audio":"https://tatoeba.org/en/audio/download/687457","words":[{"g":"he"},{"g":"to say","l":"decir"},{"g":"to desire","l":"querer"},{"g":"to be"},null]},{"text":"Los científicos parecen estar en lo cierto.","en":"Scientists seem to have known the truth.","words":[{"g":"the / them"},null,{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},{"g":"in / on"},{"g":"it / him"},{"g":"a certain, a specific"}]},{"text":"Es científico y músico.","en":"He is a scientist and musician.","audio":"https://tatoeba.org/en/audio/download/733177","words":[{"g":"to be","l":"ser"},null,{"g":"and"},{"g":"musical"}]},{"text":"No hay base científica para estas afirmaciones.","en":"There is no scientific basis for these claims.","audio":"https://tatoeba.org/en/audio/download/615938","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"base"},null,{"g":"for"},{"g":"this","l":"este"},{"g":"claim or statement of…","l":"afirmación"}]}]}