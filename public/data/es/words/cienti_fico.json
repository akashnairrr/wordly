{"id":"cienti_fico","lemma":"científico","pos":"adj","rank":2069,"glosses":["scientific"],"ipa":"/θjenˈtifiko/","forms":{"feminine":"científica","masculinePlural":"científicos","femininePlural":"científicas"},"order":2096,"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-AdrianAbdulBaha-cient%C3%ADfico.wav","formAudio":{"científica":"https://upload.wikimedia.org/wikipedia/commons/9/93/LL-Q1321_%28spa%29-Akhram-cient%C3%ADfica.wav","científicos":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-GlyphEnjoyer-cient%C3%ADficos.wav"},"examples":[{"text":"Él es científico.","en":"He is a scientist.","audio":"https://tatoeba.org/en/audio/download/444085","words":[{"g":"he"},{"g":"to be","l":"ser"},null]},{"text":"Él dijo: \"Quiero ser científico\".","en":"He said, \"I want to be a scientist.\"","audio":"https://tatoeba.org/en/audio/download/687457","words":[{"g":"he"},{"g":"to say","l":"decir"},{"g":"to desire","l":"querer"},{"g":"to be"},null]},{"text":"Los científicos parecen estar en lo cierto.","en":"Scientists seem to have known the truth.","words":[{"g":"the / them"},null,{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},{"g":"in / on"},{"g":"it / him"},{"g":"a certain, a specific"}]}]}