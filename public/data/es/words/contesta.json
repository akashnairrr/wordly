{"id":"contesta","lemma":"contesta","pos":"noun","rank":1921,"glosses":["answer; reply","contest"],"ipa":"/konˈtesta/","gender":"f","forms":{"plural":"contestas"},"examples":[{"text":"Contesta a mi pregunta.","en":"Answer my question.","audio":"https://tatoeba.org/en/audio/download/449110","words":[null,{"g":"to"},{"g":"my"},{"g":"question"}]},{"text":"¿Por qué no contesta nadie?","en":"Why does nobody answer?","audio":"https://tatoeba.org/en/audio/download/821218","words":[null,null,{"g":"no / not"},null,{"g":"no one"}],"phrases":[[0,2,"why, for what reason"]]},{"text":"Cuando los llamo, no contesta nadie.","en":"When I phone them nobody answers.","words":[{"g":"when"},{"g":"the / them"},{"g":"to summon, to call","l":"llamar"},{"g":"no / not"},null,{"g":"no one"}]},{"text":"Contesta a mi pregunta con cuidado.","en":"Answer my question carefully.","audio":"https://tatoeba.org/en/audio/download/641758","words":[null,{"g":"to"},{"g":"my"},{"g":"question"},{"g":"with"},{"g":"care (close attention"}]},{"text":"Cuando suene el teléfono, contesta de inmediato.","en":"When the telephone rings, you must answer right away.","words":[{"g":"when"},{"g":"to sound, to ring","l":"sonar"},{"g":"the"},{"g":"telephone"},null,null,null],"phrases":[[5,7,"immediately"]]}]}