{"id":"pasajero","lemma":"pasajero","pos":"adj","rank":2426,"glosses":["transient, passing"],"ipa":"/pasaˈxeɾo/","forms":{"feminine":"pasajera","masculinePlural":"pasajeros","femininePlural":"pasajeras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-pasajero.wav","examples":[{"text":"¿Cuántos pasajeros hay?","en":"How many passengers are there?","words":[{"g":"how much","l":"cuánto"},null,{"g":"to have","l":"haber"}]},{"text":"El amor es pasajero.","en":"Love is transient.","words":[{"g":"the"},{"g":"love"},{"g":"to be","l":"ser"},null]},{"text":"El tren estaba repleto de pasajeros.","en":"The train was full of passengers.","audio":"https://tatoeba.org/en/audio/download/589802","words":[{"g":"the"},{"g":"train"},{"g":"to be","l":"estar"},{"g":"full, filled, replete"},{"g":"of / from"},null]},{"text":"Todos los pasajeros murieron en el accidente.","en":"All the passengers were killed in the crash.","words":[{"g":"all","l":"todo"},{"g":"the / them"},null,{"g":"to die","l":"morir"},{"g":"in / on"},{"g":"the"},{"g":"accident"}]},{"text":"Algunos pasajeros montaron en el avión.","en":"A few passengers went on board the plane.","audio":"https://tatoeba.org/en/audio/download/689506","words":[{"g":"someone","l":"alguno"},null,{"g":"to mount","l":"montar"},{"g":"in / on"},{"g":"the"},{"g":"aeroplane"}]}]}