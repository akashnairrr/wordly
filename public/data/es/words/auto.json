{"id":"auto","lemma":"auto","pos":"noun","rank":322,"glosses":["a public deed or ceremony","order, writ, resolution","short play from the Middle Ages or the Renaissance"],"ipa":"/ˈauto/","gender":"m","forms":{"plural":"autos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-AdrianAbdulBaha-auto.wav","examples":[{"text":"Nosotros queremos un auto.","en":"We want a car.","audio":"https://tatoeba.org/en/audio/download/442960"},{"text":"Estos autos están fabricados en Japón.","en":"These cars are made in Japan.","audio":"https://tatoeba.org/en/audio/download/586978"},{"text":"Éste es mi auto.","en":"This is my car.","audio":"https://tatoeba.org/en/audio/download/441086"},{"text":"\"¿Estos autos son tuyos?\" \"Sí, son míos.\"","en":"\"Are these cars yours?\" \"Yes they are.\"","audio":"https://tatoeba.org/en/audio/download/64832"},{"text":"No es mi auto.","en":"It's not my car.","audio":"https://tatoeba.org/en/audio/download/441919"}]}