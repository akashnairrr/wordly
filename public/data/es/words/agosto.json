{"id":"agosto","lemma":"agosto","pos":"noun","rank":2601,"glosses":["August"],"ipa":"/aˈɡosto/","gender":"m","forms":{"plural":"agostos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1321_%28spa%29-Eavqwiki-agosto.wav","examples":[{"text":"No hay clases en agosto.","en":"There's no school in August.","audio":"https://tatoeba.org/en/audio/download/551599","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"tuition"},{"g":"in / on"},null]},{"text":"Él volvió el agosto pasado.","en":"He came back last August.","audio":"https://tatoeba.org/en/audio/download/70184","words":[{"g":"he"},{"g":"to return","l":"volver"},{"g":"the"},null,{"g":"past"}]},{"text":"Agosto es el octavo mes del año.","en":"August is the eighth month of the year.","audio":"https://tatoeba.org/en/audio/download/858072","words":[null,{"g":"to be","l":"ser"},{"g":"the"},{"g":"eighth"},{"g":"month"},{"g":"of the"},{"g":"year"}]},{"text":"Él le habló a la nación el ocho de agosto.","en":"He spoke to the nation on August eighth.","words":[{"g":"he"},{"g":"him / her"},{"g":"to talk","l":"hablar"},{"g":"to"},{"g":"the / her"},{"g":"nation"},{"g":"the"},{"g":"eight"},{"g":"of / from"},null]},{"text":"Sin aire acondicionado, no se puede ir en coche en pleno agosto.","en":"Without air conditioning, it's impossible to travel by car in the middle of August.","audio":"https://tatoeba.org/en/audio/download/297420","words":[{"g":"without"},null,null,{"g":"no / not"},null,null,{"g":"to go"},{"g":"in / on"},{"g":"car, automobile"},{"g":"in / on"},{"g":"full"},null],"phrases":[[1,3,"air conditioning"],[4,6,"may I?"]]}]}