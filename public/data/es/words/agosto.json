{"id":"agosto","lemma":"agosto","pos":"noun","rank":2602,"glosses":["August"],"ipa":"/aˈɡosto/","gender":"m","forms":{"plural":"agostos"},"order":2610,"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bc/LL-Q1321_%28spa%29-Eavqwiki-agosto.wav","examples":[{"text":"No hay clases en agosto.","en":"There's no school in August.","audio":"https://tatoeba.org/en/audio/download/551599","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"tuition"},{"g":"in / on"},null]},{"text":"Él volvió el agosto pasado.","en":"He came back last August.","audio":"https://tatoeba.org/en/audio/download/70184","words":[{"g":"he"},{"g":"to return","l":"volver"},{"g":"the"},null,{"g":"past"}]},{"text":"Agosto es el octavo mes del año.","en":"August is the eighth month of the year.","audio":"https://tatoeba.org/en/audio/download/858072","words":[null,{"g":"to be","l":"ser"},{"g":"the"},{"g":"eighth"},{"g":"month"},{"g":"of the"},{"g":"year"}]}]}