{"id":"responsabilidad","lemma":"responsabilidad","pos":"noun","rank":1192,"glosses":["responsibility, responsibleness","accountability","legal liability"],"ipa":"/responsabiliˈdad/","gender":"f","forms":{"plural":"responsabilidades"},"order":1282,"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q1321_%28spa%29-AdrianAbdulBaha-responsabilidad.wav","examples":[{"text":"Haz eso bajo tu propia responsabilidad.","en":"Do that at your own risk.","audio":"https://tatoeba.org/en/audio/download/704125","words":[{"g":"to do","l":"hacer"},{"g":"that","l":"ése"},{"g":"short"},{"g":"your"},{"g":"own","l":"propio"},null]},{"text":"¿Cuáles son tus responsabilidades?","en":"What are your responsibilities?","audio":"https://tatoeba.org/en/audio/download/462115","words":[{"g":"which one, what, which","l":"cuál"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"No puedo aceptar responsabilidad por eso.","en":"I can't accept responsibility for that.","audio":"https://tatoeba.org/en/audio/download/587379","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to accept"},null,{"g":"for / by"},{"g":"that","l":"ése"}]}]}