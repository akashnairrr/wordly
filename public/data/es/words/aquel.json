{"id":"aquel","lemma":"aquel","pos":"det","rank":858,"glosses":["that (over there; implying some distance)"],"ipa":"/aˈkel/","forms":{"feminine":"aquella","masculinePlural":"aquellos","femininePlural":"aquellas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-Sinaloa-aquel.wav","formAudio":{"aquella":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Marreromarco-aquella.wav"},"examples":[{"text":"¿Quién es aquel hombre?","en":"Who's that man?","audio":"https://tatoeba.org/en/audio/download/441325"},{"text":"Me gusta aquella corbata.","en":"I like that tie.","audio":"https://tatoeba.org/en/audio/download/441741"},{"text":"Aquellos son de Tom.","en":"Those are Tom's.","audio":"https://tatoeba.org/en/audio/download/800279"},{"text":"Conozco a aquellas chicas.","en":"I know those girls.","audio":"https://tatoeba.org/en/audio/download/50323"},{"text":"Me gusta aquel perro.","en":"I like that dog.","audio":"https://tatoeba.org/en/audio/download/441784"}]}