{"id":"decepcionado","lemma":"decepcionado","pos":"adj","rank":2814,"glosses":["disappointed, gutted (UK), disillusioned"],"ipa":"/deθebθjoˈnado/","forms":{"feminine":"decepcionada","masculinePlural":"decepcionados","femininePlural":"decepcionadas"},"examples":[{"text":"Estaba un poco decepcionado.","en":"I was a little disappointed.","audio":"https://tatoeba.org/en/audio/download/514734","words":[{"g":"to be","l":"estar"},null,null,null],"phrases":[[1,3,"a bit"]]},{"text":"Estoy muy decepcionada contigo.","en":"I'm very disappointed in you.","audio":"https://tatoeba.org/en/audio/download/333714","words":[{"g":"to be","l":"estar"},null,null,{"g":"with you"}]},{"text":"Estamos decepcionados con los resultados.","en":"We're disappointed with the results.","audio":"https://tatoeba.org/en/audio/download/461341","words":[{"g":"to be","l":"estar"},null,{"g":"with"},{"g":"the / them"},{"g":"result","l":"resultado"}]},{"text":"Estoy decepcionado de ti.","en":"I'm disappointed with you.","audio":"https://tatoeba.org/en/audio/download/519555","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"you","l":"tú"}]},{"text":"Ella parecía decepcionada con el resultado.","en":"She seemed disappointed at the result.","audio":"https://tatoeba.org/en/audio/download/608944","words":[{"g":"she"},{"g":"to seem, to see fit","l":"parecer"},null,{"g":"with"},{"g":"the"},{"g":"result"}]}]}