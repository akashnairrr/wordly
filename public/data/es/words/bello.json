{"id":"bello","lemma":"bello","pos":"adj","rank":1214,"glosses":["beautiful, fair","lovely (wonderful)"],"ipa":"/ˈbeʝo/","forms":{"feminine":"bella","masculinePlural":"bellos","femininePlural":"bellas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q1321_%28spa%29-AdrianAbdulBaha-bello.wav","formAudio":{"bella":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Marreromarco-bella.wav","bellas":"https://upload.wikimedia.org/wikipedia/commons/0/06/LL-Q1321_%28spa%29-Wikipedian-walker-bellas.wav"},"examples":[{"text":"El escenario era indescriptiblemente bello.","en":"The scenery was beautiful beyond description.","audio":"https://tatoeba.org/en/audio/download/692665"},{"text":"La vida es bella.","en":"Life is beautiful.","audio":"https://tatoeba.org/en/audio/download/1552"},{"text":"Él compone poemas bellos.","en":"He composes beautiful poems.","audio":"https://tatoeba.org/en/audio/download/553620"},{"text":"Las mujeres australianas son muy bellas.","en":"Australian women are very beautiful.","audio":"https://tatoeba.org/en/audio/download/831168"},{"text":"La Tierra es un bello planeta.","en":"Earth is a beautiful planet.","audio":"https://tatoeba.org/en/audio/download/706973"}]}