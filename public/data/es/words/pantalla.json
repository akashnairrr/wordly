{"id":"pantalla","lemma":"pantalla","pos":"noun","rank":1839,"glosses":["screen","display screen","lampshade"],"ipa":"/panˈtaʝa/","gender":"f","forms":{"plural":"pantallas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-pantalla.wav","examples":[{"text":"Tom señaló a la pantalla.","en":"Tom pointed to the screen.","audio":"https://tatoeba.org/en/audio/download/804425","words":[null,{"g":"to signal","l":"señalar"},{"g":"to"},{"g":"the / her"},null]},{"text":"Tom está mirando a su pantalla del ordenador..","en":"Tom is looking at his computer screen.","audio":"https://tatoeba.org/en/audio/download/804431","words":[null,{"g":"to be","l":"estar"},{"g":"to look at","l":"mirar"},{"g":"to"},{"g":"his / her / your"},null,{"g":"of the"},{"g":"computer"}]},{"text":"No me gusta sentarme tan cerca de la pantalla.","en":"I don't like to sit too close to the screen.","words":[{"g":"no / not"},null,null,{"g":"to seat","l":"sentar"},{"g":"so, as"},null,null,{"g":"the / her"},null],"phrases":[[1,3,"like, thumbs up"],[5,7,"close to"]]},{"text":"Tom continuó mirando fijamente a la pantalla en blanco.","en":"Tom continued staring at the blank screen.","audio":"https://tatoeba.org/en/audio/download/804429","words":[null,{"g":"to continue","l":"continuar"},{"g":"to look at","l":"mirar"},{"g":"firmly"},{"g":"to"},{"g":"the / her"},null,null,null],"phrases":[[7,9,"blank"]]},{"text":"Los ojos de Tom estaban pegados a la pantalla.","en":"Tom's eyes were glued to the screen.","audio":"https://tatoeba.org/en/audio/download/804433","words":[{"g":"the / them"},{"g":"eye","l":"ojo"},{"g":"of / from"},null,{"g":"to be","l":"estar"},{"g":"cleaving","l":"pegado"},{"g":"to"},{"g":"the / her"},null]}]}