{"id":"genio","lemma":"genio","pos":"noun","rank":1266,"glosses":["genius","temper, mood (normally a bad temper)"],"ipa":"/ˈxenjo/","gender":"m","forms":{"plural":"genios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-genio.wav","examples":[{"text":"Su hijo es un genio.","en":"Her son is a genius.","audio":"https://tatoeba.org/en/audio/download/449886","words":[{"g":"his / her / your"},{"g":"son"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Se dice que es un genio.","en":"He is said to be a genius.","audio":"https://tatoeba.org/en/audio/download/639625","words":[{"g":"oneself"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Sois unos genios.","en":"You guys are geniuses.","audio":"https://tatoeba.org/en/audio/download/459367","words":[{"g":"to be","l":"ser"},{"g":"about, approximately"},null]},{"text":"Un genio salió de la botella.","en":"A genie came out of the bottle.","words":[{"g":"a"},null,{"g":"to go out","l":"salir"},null,null,{"g":"bottle"}],"phrases":[[3,5,"of the"]]},{"text":"Él pensaba que era un genio.","en":"He thought that he was a genius.","words":[{"g":"he"},{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]}]}