{"id":"genio","lemma":"genio","pos":"noun","rank":1269,"glosses":["genius","temper, mood (normally a bad temper)"],"ipa":"/ˈxenjo/","gender":"m","forms":{"plural":"genios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-genio.wav","examples":[{"text":"Él es un genio.","en":"He is a genius.","audio":"https://tatoeba.org/en/audio/download/440645"},{"text":"Todos los niños son genios en potencia.","en":"All children are potential geniuses.","audio":"https://tatoeba.org/en/audio/download/687828"},{"text":"¿Es Tom un genio?","en":"Is Tom a genius?","audio":"https://tatoeba.org/en/audio/download/799199"},{"text":"Tom y Mary son genios.","en":"Tom and Mary are geniuses."},{"text":"Su hijo es un genio.","en":"Her son is a genius.","audio":"https://tatoeba.org/en/audio/download/449886"}]}