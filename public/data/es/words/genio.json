{"id":"genio","lemma":"genio","pos":"noun","rank":1266,"glosses":["genius","temper, mood (normally a bad temper)"],"ipa":"/ˈxenjo/","gender":"m","forms":{"plural":"genios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-genio.wav","examples":[{"text":"Él es un genio.","en":"He is a genius.","audio":"https://tatoeba.org/en/audio/download/440645","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Sois unos genios.","en":"You guys are geniuses.","audio":"https://tatoeba.org/en/audio/download/459367","words":[{"g":"to be","l":"ser"},{"g":"about, approximately"},null]},{"text":"Se dice que es un genio.","en":"He is said to be a genius.","audio":"https://tatoeba.org/en/audio/download/639625","words":[{"g":"oneself"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"¡Pero qué genio es!","en":"What a genius he is!","words":[{"g":"but"},{"g":"what"},null,{"g":"to be","l":"ser"}]},{"text":"Todos los niños son genios en potencia.","en":"All children are potential geniuses.","audio":"https://tatoeba.org/en/audio/download/687828","words":[{"g":"all","l":"todo"},{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"ser"},null,null,null],"phrases":[[5,7,"potential"]]}]}