{"id":"ellas","lemma":"ellas","pos":"pron","rank":546,"glosses":["they, them (used subjectively and after prepositions; can refer to women and feminine nouns)"],"ipa":"/ˈeʝas/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-AdrianAbdulBaha-ellas.wav","examples":[{"text":"Ellas pueden ayudar.","en":"They can help.","audio":"https://tatoeba.org/en/audio/download/501499","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to help"}]},{"text":"Ellas han venido.","en":"They have come.","audio":"https://tatoeba.org/en/audio/download/424695","words":[null,{"g":"to have","l":"haber"},{"g":"to come","l":"venir"}]},{"text":"¿Están ellas aquí?","en":"Are they here?","audio":"https://tatoeba.org/en/audio/download/425232","words":[{"g":"to be","l":"estar"},null,{"g":"here"}]},{"text":"Ellas me siguen.","en":"They're following me.","audio":"https://tatoeba.org/en/audio/download/823865","words":[null,{"g":"me"},{"g":"to follow","l":"seguir"}]},{"text":"Ellas quieren más dinero.","en":"They want more money.","audio":"https://tatoeba.org/en/audio/download/454881","words":[null,{"g":"to desire","l":"querer"},{"g":"more"},{"g":"money"}]}]}