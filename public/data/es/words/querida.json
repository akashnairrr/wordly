{"id":"querida","lemma":"querida","pos":"noun","rank":434,"glosses":["dear, honey, darling","mistress"],"ipa":"/keˈɾida/","gender":"f","forms":{"plural":"queridas","masculine":"querido","masculinePlural":"queridos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Wikipedian-walker-querida.wav","formAudio":{"querido":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-Marreromarco-querido.wav"},"examples":[{"text":"Ella era querida por todos en la villa.","en":"She was loved by everybody in the village."},{"text":"Nunca te he querido.","en":"I've never loved you.","audio":"https://tatoeba.org/en/audio/download/550260"},{"text":"Tienes que cuidar de tus seres queridos.","en":"You need to look after your loved ones.","audio":"https://tatoeba.org/en/audio/download/688909"},{"text":"Siempre te he querido.","en":"I've always loved you.","audio":"https://tatoeba.org/en/audio/download/104790"},{"text":"Era querido por todos.","en":"He was loved by everybody.","audio":"https://tatoeba.org/en/audio/download/721722"}]}