{"id":"segunda","lemma":"segunda","pos":"noun","rank":667,"glosses":["second gear","double meaning"],"ipa":"/seˈɡunda/","gender":"f","forms":{"plural":"segundas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Precision27-segunda.wav","examples":[{"text":"Es de segunda mano.","en":"It's second-hand.","audio":"https://tatoeba.org/en/audio/download/442585"},{"text":"Tengo unas treinta primas segundas.","en":"I have about thirty second cousins.","audio":"https://tatoeba.org/en/audio/download/456776"},{"text":"Denme una segunda oportunidad.","en":"Give me a second chance.","audio":"https://tatoeba.org/en/audio/download/461876"},{"text":"No tendrás una segunda oportunidad.","en":"You won't get a second chance.","audio":"https://tatoeba.org/en/audio/download/516142"},{"text":"¿Cuándo se inició la Segunda Guerra Mundial?","en":"When did World War II break out?","audio":"https://tatoeba.org/en/audio/download/594271"}]}