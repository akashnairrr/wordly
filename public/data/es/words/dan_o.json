{"id":"dan_o","lemma":"daño","pos":"noun","rank":477,"glosses":["damage","hex, curse"],"ipa":"/ˈdaɲo/","gender":"m","forms":{"plural":"daños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-Marreromarco-da%C3%B1o.wav","examples":[{"text":"El daño está hecho.","en":"The damage is done.","audio":"https://tatoeba.org/en/audio/download/501185","words":[{"g":"the"},null,{"g":"to be","l":"estar"},{"g":"done, completed"}]},{"text":"¿Qué tan malo fue el daño?","en":"How bad was the damage?","audio":"https://tatoeba.org/en/audio/download/612020","words":[{"g":"what"},{"g":"so, as"},{"g":"bad"},{"g":"to be","l":"ser"},{"g":"the"},null]},{"text":"Tuvo que pagar los daños.","en":"He had to pay the damages.","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to pay"},{"g":"the / them"},null]},{"text":"¿Te hicieron daño?","en":"Did they hurt you?","audio":"https://tatoeba.org/en/audio/download/443506","words":[{"g":"you"},{"g":"to do","l":"hacer"},null]},{"text":"Estimamos los daños en mil dólares.","en":"We estimate the damage at one thousand dollars.","audio":"https://tatoeba.org/en/audio/download/64559","words":[{"g":"to esteem","l":"estimar"},{"g":"the / them"},null,{"g":"in / on"},{"g":"thousand"},{"g":"dollar","l":"dólar"}]}]}