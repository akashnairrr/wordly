{"id":"dan_o","lemma":"daño","pos":"noun","rank":480,"glosses":["damage","hex, curse"],"ipa":"/ˈdaɲo/","gender":"m","forms":{"plural":"daños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-Marreromarco-da%C3%B1o.wav","examples":[{"text":"¿Le he hecho daño?","en":"Did I hurt it?","audio":"https://tatoeba.org/en/audio/download/820223"},{"text":"La tormenta causó numerosos daños.","en":"The storm caused a lot of damage.","audio":"https://tatoeba.org/en/audio/download/526999"},{"text":"¡No me hagas daño!","en":"Don't hurt me!","audio":"https://tatoeba.org/en/audio/download/460125"},{"text":"Estimamos los daños en mil dólares.","en":"We estimate the damage at one thousand dollars.","audio":"https://tatoeba.org/en/audio/download/64559"},{"text":"¿Te he hecho daño?","en":"Did I hurt you?","audio":"https://tatoeba.org/en/audio/download/45071"}]}