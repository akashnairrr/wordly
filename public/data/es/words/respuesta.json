{"id":"respuesta","lemma":"respuesta","pos":"noun","rank":567,"glosses":["reply, response, answer"],"ipa":"/resˈpwesta/","gender":"f","forms":{"plural":"respuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-AdrianAbdulBaha-respuesta.wav","examples":[{"text":"Gracias por tu respuesta.","en":"Thanks for your reply.","audio":"https://tatoeba.org/en/audio/download/460799","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"your"},null]},{"text":"No tengo todas las respuestas.","en":"I don't have all the answers.","audio":"https://tatoeba.org/en/audio/download/599311","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"all","l":"todo"},{"g":"the / them"},null]},{"text":"Nadie sabe la respuesta.","en":"No one knows the answer.","audio":"https://tatoeba.org/en/audio/download/524375","words":[{"g":"no one"},{"g":"to know, to understand","l":"saber"},{"g":"the / her"},null]},{"text":"¿Puedes explicar tu respuesta?","en":"Can you explain your answer?","audio":"https://tatoeba.org/en/audio/download/83168","words":[{"g":"to be able to, can","l":"poder"},{"g":"to explain"},{"g":"your"},null]},{"text":"Necesito respuestas.","en":"I need answers.","audio":"https://tatoeba.org/en/audio/download/440804","words":[{"g":"to need","l":"necesitar"},null]}]}