{"id":"ambos","lemma":"ambos","pos":"pron","rank":500,"glosses":["both"],"ipa":"/ˈambos/","forms":{"femininePlural":"ambas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-Marreromarco-ambos.wav","examples":[{"text":"Yo puedo hacer ambos.","en":"I can do both.","audio":"https://tatoeba.org/en/audio/download/440157"},{"text":"Las quiero a ambas.","en":"I love you both.","audio":"https://tatoeba.org/en/audio/download/441808"},{"text":"Los quiero a ambos.","en":"I love you both.","audio":"https://tatoeba.org/en/audio/download/441807"},{"text":"Ambas afirmaciones son falsas.","en":"Both claims are false.","audio":"https://tatoeba.org/en/audio/download/453957"},{"text":"Los maté a ambos.","en":"I killed them both.","audio":"https://tatoeba.org/en/audio/download/448379"}]}