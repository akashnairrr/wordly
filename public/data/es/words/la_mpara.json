{"id":"la_mpara","lemma":"lámpara","pos":"noun","rank":3041,"glosses":["lamp","torch, flashlight","clothing stain"],"ipa":"/ˈlampaɾa/","gender":"f","forms":{"plural":"lámparas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-l%C3%A1mpara.wav","examples":[{"text":"Yo necesito una lámpara.","en":"I need a lamp.","audio":"https://tatoeba.org/en/audio/download/440347","words":[{"g":"I"},{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"¿Cuánto cuesta esa lámpara?","en":"How much does that lamp cost?","words":[null,null,{"g":"that","l":"ese"},null],"phrases":[[0,2,"how much does it cost?"]]},{"text":"Compré una lámpara vieja.","en":"I bought an old lamp.","audio":"https://tatoeba.org/en/audio/download/453256","words":[{"g":"to buy","l":"comprar"},{"g":"a"},null,{"g":"hag"}]},{"text":"Él colgó una lámpara del techo.","en":"He put a light on the roof.","audio":"https://tatoeba.org/en/audio/download/64573","words":[{"g":"he"},{"g":"to hang","l":"colgar"},{"g":"a"},null,{"g":"of the"},{"g":"ceiling"}]},{"text":"Ella encendió la lámpara porque estaba oscuro.","en":"She switched on the lamp because it was dark.","audio":"https://tatoeba.org/en/audio/download/705513","words":[{"g":"she"},{"g":"to light, ignite","l":"encender"},{"g":"the / her"},null,{"g":"because"},{"g":"to be","l":"estar"},{"g":"dark"}]}]}