{"id":"golpe","lemma":"golpe","pos":"noun","rank":843,"glosses":["hit, blow, strike","punch, jab","knock (door)"],"ipa":"/ˈɡolpe/","gender":"m","forms":{"plural":"golpes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/49/LL-Q1321_%28spa%29-AdrianAbdulBaha-golpe.wav","examples":[{"text":"Es un golpe bajo.","en":"That's a low blow.","audio":"https://tatoeba.org/en/audio/download/637074","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"short"}]},{"text":"Fue un golpe de suerte.","en":"It was a lucky guess.","audio":"https://tatoeba.org/en/audio/download/455131","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"of / from"},{"g":"luck, fortune"}]},{"text":"Abre la puerta de golpe.","en":"Kick the door in.","audio":"https://tatoeba.org/en/audio/download/442813","words":[{"g":"to open, open up","l":"abrir"},{"g":"the / her"},{"g":"door"},{"g":"of / from"},null]},{"text":"Intenté abrir la puerta a golpes, pero fue imposible.","en":"I tried to break the door open, which I found impossible.","audio":"https://tatoeba.org/en/audio/download/692378","words":[{"g":"to try, to attempt","l":"intentar"},null,null,null,{"g":"to"},null,{"g":"but"},{"g":"to be","l":"ser"},{"g":"impossible"}],"phrases":[[1,4,"to open the door"]]},{"text":"Él tuvo un golpe.","en":"He had a stroke.","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"a"},null]}]}