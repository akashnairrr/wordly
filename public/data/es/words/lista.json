{"id":"lista","lemma":"lista","pos":"noun","rank":348,"glosses":["list, roll","stripe","roster"],"ipa":"/ˈlista/","gender":"f","forms":{"plural":"listas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q1321_%28spa%29-AdrianAbdulBaha-lista.wav","examples":[{"text":"¡La cena está lista!","en":"Dinner's ready!","audio":"https://tatoeba.org/en/audio/download/103415"},{"text":"¿Están ya listas mis fotos?","en":"Are my pictures ready now?","audio":"https://tatoeba.org/en/audio/download/410536"},{"text":"La comida está lista.","en":"Lunch is ready.","audio":"https://tatoeba.org/en/audio/download/441383"},{"text":"Eres una de las personas más listas que conozco.","en":"You're one of the smartest people I know.","audio":"https://tatoeba.org/en/audio/download/605073"},{"text":"¿Está lista la torta?","en":"Is the cake ready?","audio":"https://tatoeba.org/en/audio/download/443874"}]}