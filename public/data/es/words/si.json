{"id":"si","lemma":"si","pos":"conj","rank":25,"glosses":["if, whether","points out something obvious, usually not translated"],"ipa":"/si/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Precision27-si.wav","examples":[{"text":"Ven si puedes.","en":"Come if you can.","audio":"https://tatoeba.org/en/audio/download/441359","words":[{"g":"to come","l":"venir"},null,{"g":"to be able to, can","l":"poder"}]},{"text":"Si no es ahora, ¿cuándo?","en":"If not now, when?","audio":"https://tatoeba.org/en/audio/download/442831","words":[null,{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"now"},{"g":"when"}]},{"text":"Si tengo tiempo lo haré.","en":"If I have time, I'll do it.","audio":"https://tatoeba.org/en/audio/download/39166","words":[null,{"g":"to have","l":"tener"},{"g":"time"},{"g":"it / him"},{"g":"to do","l":"hacer"}]},{"text":"No sé si iré, o no.","en":"I don't know if I'll go or not.","audio":"https://tatoeba.org/en/audio/download/557045","words":[null,null,null,{"g":"to go","l":"ir"},{"g":"or"},{"g":"no / not"}],"phrases":[[0,2,"I don't know"]]},{"text":"Si puedes venir mañana, hazlo.","en":"If you can come tomorrow, please do.","audio":"https://tatoeba.org/en/audio/download/611665","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to come"},{"g":"tomorrow"},{"g":"to do","l":"hacer"}]}]}