{"id":"constantemente","lemma":"constantemente","pos":"adv","rank":2624,"glosses":["constantly"],"ipa":"/konsˌtanteˈmente/","examples":[{"text":"El viento sopla constantemente.","en":"The wind blows constantly.","words":[{"g":"the"},{"g":"wind"},{"g":"to blow","l":"soplar"},null]},{"text":"Ella está constantemente escribiendo cartas.","en":"She is constantly writing letters.","words":[{"g":"she"},{"g":"to be","l":"estar"},null,{"g":"to write","l":"escribir"},{"g":"letter","l":"carta"}]},{"text":"Él constantemente me pedía dinero prestado.","en":"He was constantly borrowing money from me.","audio":"https://tatoeba.org/en/audio/download/538060","words":[{"g":"he"},null,{"g":"me"},{"g":"to ask for something","l":"pedir"},{"g":"money"},{"g":"lent, loaned"}]},{"text":"La colección se actualiza constantemente.","en":"The collection is constantly updated.","words":[{"g":"the / her"},{"g":"collection"},{"g":"oneself"},null,null]},{"text":"Él atribuye constantemente su éxito a su esposa.","en":"He often attributes his success to his wife.","words":[{"g":"he"},{"g":"to assign","l":"atribuir"},null,{"g":"his / her / your"},{"g":"success"},{"g":"to"},{"g":"his / her / your"},{"g":"wife"}]}]}