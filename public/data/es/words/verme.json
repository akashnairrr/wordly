{"id":"verme","lemma":"verme","pos":"noun","rank":785,"glosses":["worm"],"ipa":"/ˈbeɾme/","gender":"m","forms":{"plural":"vermes"},"examples":[{"text":"Ella vino a verme.","en":"She came to see me.","audio":"https://tatoeba.org/en/audio/download/450505"},{"text":"No pueden verme contigo.","en":"I can't be seen with you.","audio":"https://tatoeba.org/en/audio/download/611872"},{"text":"Él huyó al verme.","en":"He ran away when he saw me.","audio":"https://tatoeba.org/en/audio/download/2623"},{"text":"Pensé que querías verme.","en":"I thought that you wanted to see me.","audio":"https://tatoeba.org/en/audio/download/524426"},{"text":"¿No estás contento de verme?","en":"Aren't you glad to see me?","audio":"https://tatoeba.org/en/audio/download/611925"}]}