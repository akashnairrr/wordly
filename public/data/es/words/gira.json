{"id":"gira","lemma":"gira","pos":"noun","rank":1422,"glosses":["tour (a journey through a list of places)"],"ipa":"/ˈxiɾa/","gender":"f","forms":{"plural":"giras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-Emanuelps27-gira.wav","examples":[{"text":"El mundo no gira a tu alrededor.","en":"The world doesn't revolve around you.","audio":"https://tatoeba.org/en/audio/download/611065","words":[{"g":"the"},{"g":"world, earth"},{"g":"no / not"},null,{"g":"to"},{"g":"your"},{"g":"around"}]},{"text":"Gira a la derecha.","en":"Turn right.","audio":"https://tatoeba.org/en/audio/download/438265","words":[null,{"g":"to"},{"g":"the / her"},{"g":"right"}]},{"text":"Gira la llave hacia la izquierda.","en":"Turn the key to the left.","audio":"https://tatoeba.org/en/audio/download/523598","words":[null,{"g":"the / her"},{"g":"key"},{"g":"toward, towards"},{"g":"the / her"},{"g":"left"}]},{"text":"El camino gira a la izquierda allí.","en":"The road turns left there.","audio":"https://tatoeba.org/en/audio/download/929074","words":[{"g":"the"},{"g":"way, route"},null,{"g":"to"},{"g":"the / her"},{"g":"left"},{"g":"there"}]},{"text":"En la siguiente esquina, gira hacia la derecha.","en":"At the next corner, turn right.","words":[{"g":"in / on"},{"g":"the / her"},{"g":"following"},{"g":"corner"},null,{"g":"toward, towards"},{"g":"the / her"},{"g":"right"}]}]}