{"id":"gira","lemma":"gira","pos":"noun","rank":1422,"glosses":["tour (a journey through a list of places)"],"ipa":"/ˈxiɾa/","gender":"f","forms":{"plural":"giras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-Emanuelps27-gira.wav","examples":[{"text":"La tierra gira.","en":"The earth rotates.","audio":"https://tatoeba.org/en/audio/download/1195628","words":[{"g":"the / her"},{"g":"Earth"},null]},{"text":"Gira a la izquierda.","en":"Turn to the left.","audio":"https://tatoeba.org/en/audio/download/39915","words":[null,{"g":"to"},{"g":"the / her"},{"g":"left"}]},{"text":"El camino gira a la izquierda allí.","en":"The road turns left there.","audio":"https://tatoeba.org/en/audio/download/929074","words":[{"g":"the"},{"g":"way, route"},null,{"g":"to"},{"g":"the / her"},{"g":"left"},{"g":"there"}]},{"text":"El mundo no gira alrededor tuyo.","en":"The world doesn't revolve around you.","words":[{"g":"the"},{"g":"world, earth"},{"g":"no / not"},null,{"g":"around"},{"g":"yours"}]},{"text":"Gira el pomo y abre la puerta.","en":"Turn the knob and open the door.","audio":"https://tatoeba.org/en/audio/download/353944","words":[null,{"g":"the"},{"g":"knob, doorknob, pommel"},{"g":"and"},{"g":"to open, open up","l":"abrir"},{"g":"the / her"},{"g":"door"}]}]}