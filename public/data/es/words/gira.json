{"id":"gira","lemma":"gira","pos":"noun","rank":1425,"glosses":["tour (a journey through a list of places)"],"ipa":"/ˈxiɾa/","gender":"f","forms":{"plural":"giras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-Emanuelps27-gira.wav","examples":[{"text":"Gira a la derecha.","en":"Turn right.","audio":"https://tatoeba.org/en/audio/download/438265"},{"text":"Gira a la izquierda.","en":"Turn to the left.","audio":"https://tatoeba.org/en/audio/download/39915"},{"text":"Gira la llave hacia la izquierda.","en":"Turn the key to the left.","audio":"https://tatoeba.org/en/audio/download/523598"},{"text":"No todo gira en torno a ti.","en":"It's not always about you.","audio":"https://tatoeba.org/en/audio/download/611317"},{"text":"El camino gira a la izquierda allí.","en":"The road turns left there.","audio":"https://tatoeba.org/en/audio/download/929074"}]}