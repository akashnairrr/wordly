{"id":"van","lemma":"van","pos":"noun","rank":208,"glosses":["van (vehicle)"],"ipa":"/ˈban/","gender":"m","forms":{"plural":"vanes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q1321_%28spa%29-AdrianAbdulBaha-van.wav","examples":[{"text":"Ellos van a ir.","en":"They're going.","audio":"https://tatoeba.org/en/audio/download/412242"},{"text":"Ellas van a irse.","en":"They're going.","audio":"https://tatoeba.org/en/audio/download/412243"},{"text":"¿Cómo van las cosas?","en":"How are things?","audio":"https://tatoeba.org/en/audio/download/524841"},{"text":"Las cosas van bien.","en":"Things are fine.","audio":"https://tatoeba.org/en/audio/download/412323"},{"text":"¿Van a salir ustedes?","en":"Are you going out?","audio":"https://tatoeba.org/en/audio/download/412373"}]}