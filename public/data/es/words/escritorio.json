{"id":"escritorio","lemma":"escritorio","pos":"noun","rank":1659,"glosses":["writing desk","study (room where writing is done)","desktop, desktop computer (the main graphical user interface of an operating system)"],"ipa":"/eskɾiˈtoɾjo/","gender":"m","forms":{"plural":"escritorios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/45/LL-Q1321_%28spa%29-AdrianAbdulBaha-escritorio.wav","examples":[{"text":"Mi escritorio es viejo.","en":"My desk is old.","audio":"https://tatoeba.org/en/audio/download/440959","words":[{"g":"my"},null,{"g":"to be","l":"ser"},{"g":"old person"}]},{"text":"¿Qué hay sobre el escritorio?","en":"What is on the desk?","audio":"https://tatoeba.org/en/audio/download/453115","words":[null,null,{"g":"envelope"},{"g":"the"},null],"phrases":[[0,2,"what's up?"]]},{"text":"Estos son nuestros escritorios.","en":"These are our desks.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"No lo pongas encima de mi escritorio.","en":"Don't put it on my desk.","audio":"https://tatoeba.org/en/audio/download/460107","words":[{"g":"no / not"},{"g":"it / him"},{"g":"to put, to place","l":"poner"},null,null,{"g":"my"},null],"phrases":[[3,5,"on, on top of"]]},{"text":"Deja tu escritorio como está.","en":"Leave your desk as it is.","audio":"https://tatoeba.org/en/audio/download/514762","words":[{"g":"rest"},{"g":"your"},null,{"g":"as"},{"g":"to be","l":"estar"}]}]}