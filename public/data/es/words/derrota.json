{"id":"derrota","lemma":"derrota","pos":"noun","rank":3235,"glosses":["defeat"],"ipa":"/deˈrota/","gender":"f","forms":{"plural":"derrotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Marreromarco-derrota.wav","examples":[{"text":"Él reconoció su derrota.","en":"He admitted his defeat.","audio":"https://tatoeba.org/en/audio/download/461433","words":[{"g":"he"},{"g":"to recognize","l":"reconocer"},{"g":"his / her / your"},null]},{"text":"La derrota lo abatió completamente.","en":"The defeat completely crushed him.","words":[{"g":"the / her"},null,{"g":"it / him"},null,{"g":"completely"}]},{"text":"Él no admitió la derrota.","en":"He didn't acknowledge defeat.","audio":"https://tatoeba.org/en/audio/download/514826","words":[{"g":"he"},{"g":"no / not"},{"g":"to accept","l":"admitir"},{"g":"the / her"},null]},{"text":"La derrota hirió su orgullo.","en":"Losing injured their pride.","audio":"https://tatoeba.org/en/audio/download/639868","words":[{"g":"the / her"},null,{"g":"to wound, injure","l":"herir"},{"g":"his / her / your"},{"g":"pride"}]},{"text":"Deberías reconocer tu derrota.","en":"You should acknowledge your failure.","audio":"https://tatoeba.org/en/audio/download/687712","words":[{"g":"to owe","l":"deber"},{"g":"to recognize"},{"g":"your"},null]}]}