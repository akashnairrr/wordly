{"id":"derrota","lemma":"derrota","pos":"noun","rank":3237,"glosses":["defeat"],"ipa":"/deˈrota/","gender":"f","forms":{"plural":"derrotas"},"order":3241,"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Marreromarco-derrota.wav","examples":[{"text":"Él reconoció su derrota.","en":"He admitted his defeat.","audio":"https://tatoeba.org/en/audio/download/461433","words":[{"g":"he"},{"g":"to recognize","l":"reconocer"},{"g":"his / her / your"},null]},{"text":"Él no admitió la derrota.","en":"He didn't acknowledge defeat.","audio":"https://tatoeba.org/en/audio/download/514826","words":[{"g":"he"},{"g":"no / not"},{"g":"to accept","l":"admitir"},{"g":"the / her"},null]},{"text":"La derrota lo abatió completamente.","en":"The defeat completely crushed him.","words":[{"g":"the / her"},null,{"g":"it / him"},null,{"g":"completely"}]}]}