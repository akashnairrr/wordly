{"id":"solucio_n","lemma":"solución","pos":"noun","rank":1401,"glosses":["solution"],"ipa":"/soluˈθjon/","gender":"f","forms":{"plural":"soluciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-AdrianAbdulBaha-soluci%C3%B3n.wav","examples":[{"text":"Yo tengo la solución.","en":"I have the solution.","audio":"https://tatoeba.org/en/audio/download/448919"},{"text":"Los problemas difíciles requieren de soluciones imaginativas.","en":"Difficult problems require imaginative solutions."},{"text":"¿Cuál es la solución?","en":"What's the solution?","audio":"https://tatoeba.org/en/audio/download/455421"},{"text":"No hay ninguna solución.","en":"There is no solution.","audio":"https://tatoeba.org/en/audio/download/36219"},{"text":"Esta es la solución.","en":"This is the solution.","audio":"https://tatoeba.org/en/audio/download/800864"}]}