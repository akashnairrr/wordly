{"id":"abierta","lemma":"abierta","pos":"noun","rank":1155,"glosses":["the act of opening"],"ipa":"/aˈbjeɾta/","gender":"f","forms":{"plural":"abiertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q1321_%28spa%29-Ivanhercaz-abierta.wav","examples":[{"text":"Soy de mente abierta.","en":"I'm open-minded.","audio":"https://tatoeba.org/en/audio/download/441937"},{"text":"Tengo las puntas abiertas.","en":"I have split ends.","audio":"https://tatoeba.org/en/audio/download/518648"},{"text":"¿La puerta está abierta?","en":"Is the door open?","audio":"https://tatoeba.org/en/audio/download/1252867"},{"text":"Las ventanas están abiertas.","en":"The windows are open.","audio":"https://tatoeba.org/en/audio/download/63621"},{"text":"La jaula está abierta.","en":"The cage is open.","audio":"https://tatoeba.org/en/audio/download/443521"}]}