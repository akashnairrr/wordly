{"id":"prohibido","lemma":"prohibido","pos":"adj","rank":2177,"glosses":["forbidden; prohibited"],"ipa":"/pɾoiˈbido/","forms":{"feminine":"prohibida","masculinePlural":"prohibidos","femininePlural":"prohibidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-AdrianAbdulBaha-prohibido.wav","examples":[{"text":"En esta zona está prohibido fumar.","en":"Smoking is forbidden in this area.","audio":"https://tatoeba.org/en/audio/download/687304","words":[{"g":"in / on"},{"g":"this","l":"este"},{"g":"zone, district, area"},{"g":"to be","l":"estar"},null,{"g":"to smoke"}]},{"text":"Está prohibido hablar en la biblioteca.","en":"Talking in the library is not allowed.","audio":"https://tatoeba.org/en/audio/download/688846","words":[{"g":"to be","l":"estar"},null,{"g":"to talk"},{"g":"in / on"},{"g":"the / her"},{"g":"library"}]},{"text":"Ahora está prohibida la caza.","en":"Hunting is forbidden now.","words":[{"g":"now"},{"g":"to be","l":"estar"},null,{"g":"the / her"},{"g":"hunting"}]},{"text":"Tú tienes prohibido fumar aquí.","en":"You're prohibited from smoking here.","audio":"https://tatoeba.org/en/audio/download/803692","words":[{"g":"you"},{"g":"to have","l":"tener"},null,{"g":"to smoke"},{"g":"here"}]},{"text":"Los niños tienen prohibido fumar.","en":"Children are prohibited from smoking.","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to have","l":"tener"},null,{"g":"to smoke"}]}]}