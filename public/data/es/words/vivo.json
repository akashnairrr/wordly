{"id":"vivo","lemma":"vivo","pos":"adj","rank":390,"glosses":["alive, living (having life)","vivid, lively","intense, strong"],"ipa":"/ˈbibo/","forms":{"feminine":"viva","masculinePlural":"vivos","femininePlural":"vivas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-AdrianAbdulBaha-vivo.wav","formAudio":{"viva":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-Marreromarco-viva.wav"},"examples":[{"text":"Vivo con mi tío.","en":"I'm living with my uncle.","audio":"https://tatoeba.org/en/audio/download/519249","words":[null,{"g":"with"},{"g":"my"},{"g":"uncle"}]},{"text":"¿Su padre está vivo?","en":"Is her father alive?","audio":"https://tatoeba.org/en/audio/download/636684","words":[{"g":"his / her / your"},{"g":"father, parent"},{"g":"to be","l":"estar"},null]},{"text":"Ambos están vivos.","en":"Both are alive.","audio":"https://tatoeba.org/en/audio/download/440572","words":[{"g":"both"},{"g":"to be","l":"estar"},null]},{"text":"¿Sabes dónde vivo?","en":"Do you know where I live?","audio":"https://tatoeba.org/en/audio/download/70985","words":[{"g":"to know, to understand","l":"saber"},{"g":"where"},null]},{"text":"Todavía estamos vivos.","en":"We're still alive.","audio":"https://tatoeba.org/en/audio/download/449434","words":[{"g":"still, yet"},{"g":"to be","l":"estar"},null]}]}