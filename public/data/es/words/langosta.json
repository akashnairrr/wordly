{"id":"langosta","lemma":"langosta","pos":"noun","rank":4328,"glosses":["lobster","locust"],"ipa":"/lanˈɡosta/","gender":"f","forms":{"plural":"langostas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-AdrianAbdulBaha-langosta.wav","examples":[{"text":"No quiero comer una langosta viva.","en":"I don't want to eat a live lobster.","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to eat"},{"g":"a"},null,{"g":"alive, living","l":"vivo"}]},{"text":"Las langostas son crustáceos.","en":"Lobsters are crustaceans.","audio":"https://tatoeba.org/en/audio/download/722122","words":[{"g":"the / them"},null,{"g":"to be","l":"ser"},null]},{"text":"A Tom le gusta la langosta.","en":"Tom likes lobster.","audio":"https://tatoeba.org/en/audio/download/799554","words":[{"g":"to"},null,{"g":"him / her"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},null]},{"text":"Nosotros comemos langostas sólo en ocasiones especiales.","en":"We have lobsters only on special occasions.","audio":"https://tatoeba.org/en/audio/download/517987","words":[{"g":"we"},{"g":"to eat","l":"comer"},null,null,null,null,{"g":"special","l":"especial"}],"phrases":[[4,6,"on occasion"]]},{"text":"Me gusta mucho la langosta, pero son carísimas.","en":"I am very fond of lobsters, but they are very, very expensive.","words":[null,null,{"g":"much"},{"g":"the / her"},null,{"g":"but"},{"g":"to be","l":"ser"},null],"phrases":[[0,2,"like, thumbs up"]]}]}