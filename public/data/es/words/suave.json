{"id":"suave","lemma":"suave","pos":"adj","rank":1572,"glosses":["smooth, soft, fluffy","soft, gentle, light, mild (e.g. mild flavor, a mild winter)","suave (charming, confident and elegant)"],"ipa":"/ˈswabe/","forms":{"femininePlural":"suaves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q1321_%28spa%29-Rodelar-suave.wav","examples":[{"text":"Era demasiado suave.","en":"It was too soft.","audio":"https://tatoeba.org/en/audio/download/441947","words":[{"g":"to be","l":"ser"},{"g":"too much"},null]},{"text":"Por favor, sé suave.","en":"Please be gentle.","audio":"https://tatoeba.org/en/audio/download/443209","words":[null,null,{"g":"to know, to understand","l":"saber"},null],"phrases":[[0,2,"please"]]},{"text":"Tom tiene las manos suaves.","en":"Tom has soft hands.","words":[null,{"g":"to have","l":"tener"},{"g":"the / them"},{"g":"hand","l":"mano"},null]},{"text":"Estamos teniendo un invierno suave.","en":"We're having a mild winter.","audio":"https://tatoeba.org/en/audio/download/514846","words":[{"g":"to be","l":"estar"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"winter"},null]},{"text":"Su voz era suave y bonita.","en":"Her voice was soft and beautiful.","audio":"https://tatoeba.org/en/audio/download/684264","words":[{"g":"his / her / your"},{"g":"voice"},{"g":"to be","l":"ser"},null,{"g":"and"},{"g":"pretty, cute","l":"bonito"}]}]}