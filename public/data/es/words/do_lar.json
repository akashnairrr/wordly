{"id":"do_lar","lemma":"dólar","pos":"noun","rank":361,"glosses":["dollar (designation for specific currency)"],"ipa":"/ˈdolaɾ/","gender":"m","forms":{"plural":"dólares"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q1321_%28spa%29-Marreromarco-d%C3%B3lar.wav","formAudio":{"dólares":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-Precision27-d%C3%B3lares.wav"},"examples":[{"text":"Te debo diez dólares.","en":"I owe you ten dollars.","audio":"https://tatoeba.org/en/audio/download/453445","words":[{"g":"you"},{"g":"to owe","l":"deber"},{"g":"A"},null]},{"text":"Me encontré un dólar en la calle.","en":"I found a dollar in the street.","audio":"https://tatoeba.org/en/audio/download/354966","words":[{"g":"me"},{"g":"to meet","l":"encontrar"},{"g":"a"},null,{"g":"in / on"},{"g":"the / her"},{"g":"street"}]},{"text":"Solo me quedan tres dólares.","en":"I have just three dollars left.","audio":"https://tatoeba.org/en/audio/download/354865","words":[{"g":"sole"},{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"three"},null]},{"text":"Si te pago un dólar, estaremos en paz.","en":"If I pay you a dollar, we'll be even.","audio":"https://tatoeba.org/en/audio/download/689479","words":[{"g":"if, whether"},{"g":"you"},{"g":"pay, payment"},{"g":"a"},null,{"g":"to be","l":"estar"},null,null],"phrases":[[6,8,"in peace"]]},{"text":"Me apuesto cinco dólares a que no viene.","en":"I bet five dollars that he will not come.","audio":"https://tatoeba.org/en/audio/download/688866","words":[{"g":"me"},{"g":"handsome, good-looking"},{"g":"a five"},null,null,null,null,{"g":"to come","l":"venir"}],"phrases":[[4,7,"I bet"]]}]}