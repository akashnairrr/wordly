{"id":"contrato","lemma":"contrato","pos":"noun","rank":1102,"glosses":["contract, agreement"],"ipa":"/konˈtɾato/","gender":"m","forms":{"plural":"contratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Marreromarco-contrato.wav","examples":[{"text":"¿Cuáles son las condiciones del contrato?","en":"What are the terms of the contract?","audio":"https://tatoeba.org/en/audio/download/687933","words":[{"g":"which one, what, which","l":"cuál"},{"g":"to be","l":"ser"},{"g":"the / them"},{"g":"condition","l":"condición"},{"g":"of the"},null]},{"text":"Puede que no tengamos que firmar un contrato.","en":"We might not need to sign a contract.","audio":"https://tatoeba.org/en/audio/download/522399","words":[null,null,{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to sign"},{"g":"a"},null],"phrases":[[0,2,"it may be that"]]},{"text":"Quiero firmar los contratos.","en":"I want to sign the contracts.","words":[{"g":"to desire","l":"querer"},{"g":"to sign"},{"g":"the / them"},null]},{"text":"Por favor firma el contrato.","en":"Please sign your name on the contract.","audio":"https://tatoeba.org/en/audio/download/612353","words":[null,null,{"g":"signature"},{"g":"the"},null],"phrases":[[0,2,"please"]]},{"text":"¿Hizo usted un contrato en forma con él?","en":"Did you make a formal agreement with him?","words":[{"g":"to do","l":"hacer"},{"g":"you (formal)"},{"g":"a"},null,null,null,{"g":"with"},{"g":"he"}],"phrases":[[4,6,"fit, in shape"]]}]}