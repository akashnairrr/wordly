{"id":"contrato","lemma":"contrato","pos":"noun","rank":1105,"glosses":["contract, agreement"],"ipa":"/konˈtɾato/","gender":"m","forms":{"plural":"contratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Marreromarco-contrato.wav","examples":[{"text":"Se firmó el contrato.","en":"The contract was signed.","audio":"https://tatoeba.org/en/audio/download/99963"},{"text":"Quiero firmar los contratos.","en":"I want to sign the contracts."},{"text":"Firmaré el contrato más tarde.","en":"I'll sign the contract later.","audio":"https://tatoeba.org/en/audio/download/559235"},{"text":"El contrato venció el lunes.","en":"The contract expired on Monday.","audio":"https://tatoeba.org/en/audio/download/352003"},{"text":"Este contrato aún está vigente.","en":"This contract is still in effect.","audio":"https://tatoeba.org/en/audio/download/559204"}]}