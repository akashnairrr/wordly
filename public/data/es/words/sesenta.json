{"id":"sesenta","lemma":"sesenta","pos":"num","rank":3833,"glosses":["sixty (the cardinal number occurring after fifty-nine and before sixty-one, represented in Roman numerals as LX and in Arabic numerals as 60)"],"ipa":"/seˈsenta/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1321_%28spa%29-AdrianAbdulBaha-sesenta.wav","examples":[{"text":"Ella tiene casi sesenta años.","en":"She is almost sixty years old.","audio":"https://tatoeba.org/en/audio/download/642022","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"almost"},null,{"g":"year","l":"año"}]},{"text":"Él tiene cerca de sesenta años.","en":"He is close to sixty.","audio":"https://tatoeba.org/en/audio/download/78874","words":[{"g":"he"},{"g":"to have","l":"tener"},null,null,null,{"g":"year","l":"año"}],"phrases":[[2,4,"close to"]]},{"text":"Un minuto tiene sesenta segundos.","en":"One minute has sixty seconds.","audio":"https://tatoeba.org/en/audio/download/590191","words":[{"g":"a"},{"g":"minute"},{"g":"to have","l":"tener"},null,{"g":"second","l":"segundo"}]},{"text":"Parece tener al menos sesenta años.","en":"She looks at least sixty.","audio":"https://tatoeba.org/en/audio/download/639563","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"to have"},null,null,null,{"g":"year","l":"año"}],"phrases":[[2,4,"at least, at minimum"]]},{"text":"Se abrieron sesenta nuevos museos.","en":"Sixty new museums opened.","words":[{"g":"oneself"},{"g":"to open, open up","l":"abrir"},null,{"g":"new","l":"nuevo"},{"g":"museum","l":"museo"}]}]}