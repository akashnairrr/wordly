{"id":"despierto","lemma":"despierto","pos":"adj","rank":895,"glosses":["awake"],"ipa":"/desˈpjeɾto/","forms":{"feminine":"despierta","masculinePlural":"despiertos","femininePlural":"despiertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-Marreromarco-despierto.wav","examples":[{"text":"¿Está Tom despierto todavía?","en":"Is Tom awake yet?","audio":"https://tatoeba.org/en/audio/download/800181"},{"text":"Ve y despierta a Mary.","en":"Go and wake up Mary.","audio":"https://tatoeba.org/en/audio/download/798851"},{"text":"Todos los niños están despiertos.","en":"All the kids are awake.","audio":"https://tatoeba.org/en/audio/download/559341"},{"text":"¿A qué hora te despiertas?","en":"What time do you wake up?","audio":"https://tatoeba.org/en/audio/download/616119"},{"text":"Mira quién está despierto.","en":"Look who's awake.","audio":"https://tatoeba.org/en/audio/download/800180"}]}