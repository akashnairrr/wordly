{"id":"playa","lemma":"playa","pos":"noun","rank":1045,"glosses":["beach","car park"],"ipa":"/ˈplaʝa/","gender":"f","forms":{"plural":"playas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0d/LL-Q1321_%28spa%29-AdrianAbdulBaha-playa.wav","examples":[{"text":"Me gusta la playa.","en":"I like the beach.","audio":"https://tatoeba.org/en/audio/download/442741"},{"text":"Me encantan las playas en Australia.","en":"I love the beaches in Australia.","audio":"https://tatoeba.org/en/audio/download/302421"},{"text":"Estoy en la playa.","en":"I'm at the beach.","audio":"https://tatoeba.org/en/audio/download/442703"},{"text":"No recuerdo los nombres de las playas.","en":"I don't remember the names of the beaches."},{"text":"Fuimos a la playa.","en":"We went to the beach.","audio":"https://tatoeba.org/en/audio/download/454580"}]}