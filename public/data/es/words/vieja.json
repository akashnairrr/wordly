{"id":"vieja","lemma":"vieja","pos":"noun","rank":698,"glosses":["hag","wife, (spouse): little woman"],"ipa":"/ˈbjexa/","gender":"f","forms":{"plural":"viejas","masculine":"viejo","masculinePlural":"viejos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1321_%28spa%29-Marreromarco-vieja.wav","formAudio":{"viejo":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-Rodelar-viejo.wav"},"examples":[{"text":"Es una vieja costumbre.","en":"It's an old custom.","audio":"https://tatoeba.org/en/audio/download/448940"},{"text":"Cantó algunas viejas canciones.","en":"He sang some old songs.","audio":"https://tatoeba.org/en/audio/download/637165"},{"text":"Soy un hombre viejo.","en":"I'm an old man.","audio":"https://tatoeba.org/en/audio/download/851491"},{"text":"Él usaba zapatos viejos.","en":"He wore old shoes.","audio":"https://tatoeba.org/en/audio/download/443888"},{"text":"Compré una lámpara vieja.","en":"I bought an old lamp.","audio":"https://tatoeba.org/en/audio/download/453256"}]}