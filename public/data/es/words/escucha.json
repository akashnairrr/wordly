{"id":"escucha","lemma":"escucha","pos":"noun","rank":283,"glosses":["listening","monitoring","tapping"],"ipa":"/esˈkut͡ʃa/","gender":"f","forms":{"plural":"escuchas"},"examples":[{"text":"Permanezca a la escucha.","en":"Keep listening.","audio":"https://tatoeba.org/en/audio/download/440925"},{"text":"Tú no escuchas, ¿verdad?","en":"You don't listen, do you?","audio":"https://tatoeba.org/en/audio/download/162685"},{"text":"Tom escucha a Mary.","en":"Tom listens to Mary.","audio":"https://tatoeba.org/en/audio/download/303562"},{"text":"Nunca escuchas nuestros consejos.","en":"You never listen to our advice.","audio":"https://tatoeba.org/en/audio/download/706303"},{"text":"Escucha a tu corazón.","en":"Listen to your heart.","audio":"https://tatoeba.org/en/audio/download/454562"}]}