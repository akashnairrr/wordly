{"id":"a_frico","lemma":"áfrico","pos":"adj","rank":1948,"glosses":["African"],"ipa":"/ˈafɾiko/","forms":{"feminine":"áfrica","masculinePlural":"áfricos","femininePlural":"áfricas"},"formAudio":{"áfrica":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-Rub%C3%BD%C3%B1-%C3%81frica.wav"},"examples":[{"text":"África es un continente.","en":"Africa is a continent.","audio":"https://tatoeba.org/en/audio/download/506451"},{"text":"Él nació en África.","en":"He was born in Africa.","audio":"https://tatoeba.org/en/audio/download/38886"},{"text":"Él quiere ir a África.","en":"He wants to go to Africa.","audio":"https://tatoeba.org/en/audio/download/639750"},{"text":"¿Has estado alguna vez en África?","en":"Have you ever been to Africa?","audio":"https://tatoeba.org/en/audio/download/585757"},{"text":"Quiero ir a África algún día.","en":"I want to go to Africa someday.","audio":"https://tatoeba.org/en/audio/download/590204"}]}