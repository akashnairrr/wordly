{"id":"reunir","lemma":"reunir","pos":"verb","rank":2827,"glosses":["to gather, to collect, to bring together, to assemble, to get together, to round up, to marshal, to compile, to put together, to pull together, to draw together, to pool","to satisfy, to meet, to possess (e.g. conditions, requirements, criteria, qualifications, characteristics)","to join, unite"],"ipa":"/reuˈniɾ/","conjugation":{"indicative":{"present":{"1s":"reúno","2s":"reúnes","3s":"reúne","1p":"reunimos","2p":"reunís","3p":"reúnen"},"imperfect":{"1s":"reunía","2s":"reunías","3s":"reunía","1p":"reuníamos","2p":"reuníais","3p":"reunían"},"preterite":{"1s":"reuní","2s":"reuniste","3s":"reunió","1p":"reunimos","2p":"reunisteis","3p":"reunieron"},"future":{"1s":"reuniré","2s":"reunirás","3s":"reunirá","1p":"reuniremos","2p":"reuniréis","3p":"reunirán"},"conditional":{"1s":"reuniría","2s":"reunirías","3s":"reuniría","1p":"reuniríamos","2p":"reuniríais","3p":"reunirían"}},"subjunctive":{"present":{"1s":"reúna","2s":"reúnas","3s":"reúna","1p":"reunamos","2p":"reunáis","3p":"reúnan"},"imperfect":{"1s":"reuniera","2s":"reunieras","3s":"reuniera","1p":"reuniéramos","2p":"reunierais","3p":"reunieran"}},"imperative":{"affirmative":{"2s":"reúne","3s":"reúna","1p":"reunamos","2p":"reunid","3p":"reúnan"},"negative":{"2s":"reúnas","3s":"reúna","1p":"reunamos","2p":"reunáis","3p":"reúnan"}}},"nonFinite":{"gerund":"reuniendo","participle":"reunido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-AdrianAbdulBaha-reunir.wav","examples":[{"text":"Tenemos que reunir información.","en":"We have to gather information.","audio":"https://tatoeba.org/en/audio/download/734441","words":[{"g":"to have","l":"tener"},{"g":"that"},null,{"g":"information, data"}]},{"text":"Nos reunimos aquí una vez por semana.","en":"We meet here once a week.","audio":"https://tatoeba.org/en/audio/download/609585","words":[{"g":"us"},null,{"g":"here"},null,null,{"g":"for / by"},{"g":"week"}],"phrases":[[3,5,"once"]]},{"text":"Me reuniré contigo más tarde.","en":"I'll join you later.","audio":"https://tatoeba.org/en/audio/download/450418","words":[{"g":"me"},null,{"g":"with you"},null,null],"phrases":[[3,5,"later"]]},{"text":"Mañana nos vamos a reunir aquí.","en":"We're going to meet up here tomorrow.","words":[{"g":"tomorrow"},{"g":"us"},{"g":"to go","l":"ir"},{"g":"to"},null,{"g":"here"}]},{"text":"El comité se reúne dos veces al mes.","en":"The committee meets twice a month.","audio":"https://tatoeba.org/en/audio/download/687422","words":[{"g":"the"},{"g":"committee"},{"g":"oneself"},null,{"g":"dung, excrement"},{"g":"by, times"},{"g":"to the"},{"g":"month"}]}]}