{"id":"adelante","lemma":"adelante","pos":"adv","rank":271,"glosses":["forward (toward the front)","forward (into the future)"],"ipa":"/adeˈlante/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q1321_%28spa%29-Marreromarco-adelante.wav","examples":[{"text":"Le di para adelante.","en":"I didn't look back.","audio":"https://tatoeba.org/en/audio/download/800395"},{"text":"Tom deambulaba adelante y atrás.","en":"Tom paced back and forth.","audio":"https://tatoeba.org/en/audio/download/299988"},{"text":"Dejaré eso para más adelante.","en":"I'll take a rain check on that.","audio":"https://tatoeba.org/en/audio/download/704472"},{"text":"\"¿Puedo usar este teléfono?\" \"Adelante.\"","en":"\"May I use this telephone?\" \"Go ahead.\"","audio":"https://tatoeba.org/en/audio/download/705559"},{"text":"Yo estoy más adelante que tú.","en":"I outrank you.","audio":"https://tatoeba.org/en/audio/download/440362"}]}