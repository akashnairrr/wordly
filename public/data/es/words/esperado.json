{"id":"esperado","lemma":"esperado","pos":"adj","rank":1965,"glosses":["expected"],"ipa":"/espeˈɾado/","forms":{"feminine":"esperada","masculinePlural":"esperados","femininePlural":"esperadas"},"examples":[{"text":"He esperado diez minutos.","en":"I waited for ten minutes.","audio":"https://tatoeba.org/en/audio/download/73978"},{"text":"Te puedo ofrecer algunas predicciones estadísticas de los ingresos esperados.","en":"I can provide you with some statistical predictions of expected revenues."},{"text":"Ya hemos esperado suficiente.","en":"We've done enough waiting.","audio":"https://tatoeba.org/en/audio/download/611973"},{"text":"Tom debería habernos esperado.","en":"Tom should've waited for us to get there.","audio":"https://tatoeba.org/en/audio/download/1151868"},{"text":"He esperado demasiado para esto.","en":"I've waited too long for this.","audio":"https://tatoeba.org/en/audio/download/532156"}]}