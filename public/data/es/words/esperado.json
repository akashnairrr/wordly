{"id":"esperado","lemma":"esperado","pos":"adj","rank":1962,"glosses":["expected"],"ipa":"/espeˈɾado/","forms":{"feminine":"esperada","masculinePlural":"esperados","femininePlural":"esperadas"},"examples":[{"text":"Yo hubiera esperado.","en":"I would've waited.","audio":"https://tatoeba.org/en/audio/download/443399","words":[{"g":"I"},{"g":"to have","l":"haber"},null]},{"text":"Te he esperado.","en":"I've been waiting for you.","audio":"https://tatoeba.org/en/audio/download/516653","words":[{"g":"you"},{"g":"to have","l":"haber"},null]},{"text":"Yo debería haber esperado otros tres meses.","en":"I should've waited another three months.","audio":"https://tatoeba.org/en/audio/download/582016","words":[{"g":"I"},{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"someone else","l":"otro"},{"g":"three"},{"g":"month","l":"mes"}]},{"text":"He esperado diez minutos.","en":"I waited for ten minutes.","audio":"https://tatoeba.org/en/audio/download/73978","words":[{"g":"to have","l":"haber"},null,{"g":"A"},{"g":"minute","l":"minuto"}]},{"text":"Ya hemos esperado suficiente.","en":"We've done enough waiting.","audio":"https://tatoeba.org/en/audio/download/611973","words":[{"g":"now"},{"g":"heme","l":"hemo"},null,{"g":"sufficient, enough"}]}]}