{"id":"esperado","lemma":"esperado","pos":"adj","rank":1962,"glosses":["expected"],"ipa":"/espeˈɾado/","forms":{"feminine":"esperada","masculinePlural":"esperados","femininePlural":"esperadas"},"examples":[{"text":"He esperado demasiado para esto.","en":"I've waited too long for this.","audio":"https://tatoeba.org/en/audio/download/532156","words":[{"g":"to have","l":"haber"},null,{"g":"too much"},{"g":"for"},{"g":"this"}]},{"text":"He esperado más de una semana.","en":"I've waited for more than a week.","audio":"https://tatoeba.org/en/audio/download/568209","words":[{"g":"to have","l":"haber"},null,{"g":"more"},{"g":"of / from"},{"g":"a"},{"g":"week"}]},{"text":"He esperado diez minutos.","en":"I waited for ten minutes.","audio":"https://tatoeba.org/en/audio/download/73978","words":[{"g":"to have","l":"haber"},null,{"g":"A"},{"g":"minute","l":"minuto"}]},{"text":"Ya hemos esperado suficiente.","en":"We've done enough waiting.","audio":"https://tatoeba.org/en/audio/download/611973","words":[{"g":"now"},{"g":"heme","l":"hemo"},null,{"g":"sufficient, enough"}]},{"text":"Yo hubiera esperado.","en":"I would've waited.","audio":"https://tatoeba.org/en/audio/download/443399","words":[{"g":"I"},{"g":"to have","l":"haber"},null]}]}