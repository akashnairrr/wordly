{"id":"sonrisa","lemma":"sonrisa","pos":"noun","rank":1505,"glosses":["smile"],"ipa":"/sonˈrisa/","gender":"f","forms":{"plural":"sonrisas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q1321_%28spa%29-AdrianAbdulBaha-sonrisa.wav","examples":[{"text":"Él me recibió con una sonrisa.","en":"He greeted me with a smile.","audio":"https://tatoeba.org/en/audio/download/639622","words":[{"g":"he"},{"g":"me"},{"g":"to receive, get","l":"recibir"},{"g":"with"},{"g":"a"},null]},{"text":"No me gusta tu sonrisa.","en":"I don't like your smile.","audio":"https://tatoeba.org/en/audio/download/850061","words":[{"g":"no / not"},null,null,{"g":"your"},null],"phrases":[[1,3,"like, thumbs up"]]},{"text":"Tienes una linda sonrisa.","en":"You have a pretty smile.","words":[{"g":"to have","l":"tener"},{"g":"a"},null,null]},{"text":"Las sonrisas no siempre indican placer.","en":"Smiles do not always indicate pleasure.","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"always"},{"g":"to indicate","l":"indicar"},{"g":"to like"}]},{"text":"Ella le puso una gran sonrisa.","en":"She gave him a big smile.","words":[{"g":"she"},{"g":"him / her"},{"g":"to put, to place","l":"poner"},{"g":"a"},null,null]}]}