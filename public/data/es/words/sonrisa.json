{"id":"sonrisa","lemma":"sonrisa","pos":"noun","rank":1505,"glosses":["smile"],"ipa":"/sonˈrisa/","gender":"f","forms":{"plural":"sonrisas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ad/LL-Q1321_%28spa%29-AdrianAbdulBaha-sonrisa.wav","examples":[{"text":"¡A ver esa sonrisa!","en":"Try to look happy.","audio":"https://tatoeba.org/en/audio/download/850220","words":[null,null,{"g":"that","l":"ese"},null],"phrases":[[0,2,"show me!"]]},{"text":"No me gusta tu sonrisa.","en":"I don't like your smile.","audio":"https://tatoeba.org/en/audio/download/850061","words":[{"g":"no / not"},null,null,{"g":"your"},null],"phrases":[[1,3,"like, thumbs up"]]},{"text":"Él me recibió con una sonrisa.","en":"He greeted me with a smile.","audio":"https://tatoeba.org/en/audio/download/639622","words":[{"g":"he"},{"g":"me"},{"g":"to receive, get","l":"recibir"},{"g":"with"},{"g":"a"},null]},{"text":"Las sonrisas no siempre indican placer.","en":"Smiles do not always indicate pleasure.","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"always"},{"g":"to indicate","l":"indicar"},{"g":"to like"}]},{"text":"Hagas lo que hagas, hazlo con una sonrisa.","en":"Whatever you do, do it with a smile.","audio":"https://tatoeba.org/en/audio/download/802848","words":[{"g":"to do","l":"hacer"},null,null,{"g":"to do","l":"hacer"},{"g":"to do","l":"hacer"},{"g":"with"},{"g":"a"},null],"phrases":[[1,3,"what, that which"]]}]}