{"id":"notable","lemma":"notable","pos":"adj","rank":4329,"glosses":["remarkable, notable, noteworthy, noticeable, significant, marked, outstanding, striking, noted"],"ipa":"/noˈtable/","forms":{"femininePlural":"notables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-AdrianAbdulBaha-notable.wav","examples":[{"text":"Eso es notable.","en":"That's outstanding.","audio":"https://tatoeba.org/en/audio/download/448962","words":[null,null,null],"phrases":[[0,2,"that's it"]]},{"text":"Él tiene una memoria notable.","en":"He has a remarkable memory.","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"memory"},null]},{"text":"Tom hace un trabajo notable.","en":"Tom does outstanding work.","audio":"https://tatoeba.org/en/audio/download/804397","words":[null,{"g":"to do","l":"hacer"},{"g":"a"},{"g":"work, job"},null]},{"text":"Los recientes avances en medicina son notables.","en":"Recent advances in medicine are remarkable.","words":[{"g":"the / them"},{"g":"recent","l":"reciente"},{"g":"advance","l":"avance"},{"g":"in / on"},{"g":"medicine"},{"g":"to be","l":"ser"},null]},{"text":"Pese a ser joven, es un médico notable.","en":"Although he's young, he's an outstanding doctor.","audio":"https://tatoeba.org/en/audio/download/693473","words":[null,null,{"g":"to be"},{"g":"young, youthful"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"doctor"},null],"phrases":[[0,2,"in spite of"]]}]}