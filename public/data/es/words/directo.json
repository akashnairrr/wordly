{"id":"directo","lemma":"directo","pos":"adj","rank":1145,"glosses":["direct, straightforward","blunt, straight","live"],"ipa":"/diˈɾeɡto/","forms":{"feminine":"directa","masculinePlural":"directos","femininePlural":"directas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q1321_%28spa%29-Marreromarco-directo.wav","examples":[{"text":"Voy a ser directo.","en":"I'll be direct.","audio":"https://tatoeba.org/en/audio/download/440865"},{"text":"Las pinturas no deben exponerse a la luz solar directa.","en":"Paintings should not be exposed to direct sunlight."},{"text":"Id directos al grano.","en":"Don't beat around the bush."},{"text":"Tus preguntas fueron muy directas.","en":"Your questions were too direct.","audio":"https://tatoeba.org/en/audio/download/589677"},{"text":"Tom es muy directo.","en":"Tom is very blunt.","audio":"https://tatoeba.org/en/audio/download/799937"}]}