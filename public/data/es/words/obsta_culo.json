{"id":"obsta_culo","lemma":"obstáculo","pos":"noun","rank":4181,"glosses":["obstacle, hindrance, stumbling block, hurdle, barrier, impediment, obstruction, handicap, constraint, snag, bottleneck (something immaterial that hinders progress)","obstacle (something physically hindering progress)","hurdle"],"ipa":"/obsˈtakulo/","gender":"m","forms":{"plural":"obstáculos"},"order":4182,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-Marreromarco-obst%C3%A1culo.wav","examples":[{"text":"Hubo un obstáculo.","en":"There was a hitch.","audio":"https://tatoeba.org/en/audio/download/448928","words":[{"g":"to have","l":"haber"},{"g":"a"},null]},{"text":"Hay otro obstáculo.","en":"There's another hitch.","audio":"https://tatoeba.org/en/audio/download/460975","words":[{"g":"to have","l":"haber"},{"g":"someone else"},null]},{"text":"Seguimos adelante a pesar de los obstáculos.","en":"We pushed ahead despite the obstacles.","audio":"https://tatoeba.org/en/audio/download/693278","words":[{"g":"to follow","l":"seguir"},{"g":"forward"},null,null,null,{"g":"the / them"},null],"phrases":[[2,5,"in spite of, despite"]]}]}