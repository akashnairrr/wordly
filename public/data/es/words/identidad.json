{"id":"identidad","lemma":"identidad","pos":"noun","rank":1635,"glosses":["identity"],"ipa":"/identiˈdad/","gender":"f","forms":{"plural":"identidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q1321_%28spa%29-Marreromarco-identidad.wav","examples":[{"text":"¿Tiene usted documentos de identidad?","en":"Do you have any identification?","audio":"https://tatoeba.org/en/audio/download/515932"},{"text":"Éste es mi carnet de identidad.","en":"This is my I.D. card.","audio":"https://tatoeba.org/en/audio/download/38410"},{"text":"No reveló su identidad.","en":"He didn't reveal his identity."},{"text":"Él asumió una nueva identidad.","en":"He assumed a new identity."},{"text":"Él no reveló su identidad.","en":"He didn't reveal his identity."}]}