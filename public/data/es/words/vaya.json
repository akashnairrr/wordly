{"id":"vaya","lemma":"vaya","pos":"intj","rank":197,"glosses":["expresses surprise: wow!, why, oh!, whoa!, well!, man!, boy!","expresses dismay, worry, indignation or frustration: gee!, jeez!, gosh!, why, man!, oh dear!","what a ..."],"ipa":"/ˈbaʝa/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-vaya.wav","examples":[{"text":"Espero que te vaya bien.","en":"I hope you're doing well.","audio":"https://tatoeba.org/en/audio/download/505317","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"you"},null,{"g":"well"}]},{"text":"¿Quieres que vaya o no?","en":"Do you want me to go or not?","audio":"https://tatoeba.org/en/audio/download/523183","words":[{"g":"to desire","l":"querer"},{"g":"that"},null,{"g":"or"},{"g":"no / not"}]},{"text":"Vaya a dormir ahora.","en":"Go to sleep now.","audio":"https://tatoeba.org/en/audio/download/441628","words":[null,{"g":"to"},{"g":"to sleep"},{"g":"now"}]},{"text":"¿Dudas que él vaya a ganar?","en":"Do you doubt that he will win?","audio":"https://tatoeba.org/en/audio/download/641832","words":[{"g":"doubt","l":"duda"},{"g":"that"},{"g":"he"},null,{"g":"to"},{"g":"to gain"}]},{"text":"Quizá vaya contigo mañana.","en":"I might want to go with you tomorrow.","audio":"https://tatoeba.org/en/audio/download/300351","words":[{"g":"perhaps, maybe"},null,{"g":"with you"},{"g":"tomorrow"}]}]}