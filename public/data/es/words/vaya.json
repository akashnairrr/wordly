{"id":"vaya","lemma":"vaya","pos":"intj","rank":200,"glosses":["expresses surprise: wow!, why, oh!, whoa!, well!, man!, boy!","expresses dismay, worry, indignation or frustration: gee!, jeez!, gosh!, why, man!, oh dear!","what a ..."],"ipa":"/ˈbaʝa/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-vaya.wav","examples":[{"text":"Vaya a dormir ahora.","en":"Go to sleep now.","audio":"https://tatoeba.org/en/audio/download/441628"},{"text":"¡No vaya tan ligero!","en":"Don't go so fast!","audio":"https://tatoeba.org/en/audio/download/799039"},{"text":"Vaya con estos señores.","en":"Go with these men.","audio":"https://tatoeba.org/en/audio/download/443363"},{"text":"¡Vaya niño más tonto!","en":"What a stupid kid!","audio":"https://tatoeba.org/en/audio/download/512115"},{"text":"Ojalá te vaya bien.","en":"I hope you do fine.","audio":"https://tatoeba.org/en/audio/download/450194"}]}