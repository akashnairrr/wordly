{"id":"infarto","lemma":"infarto","pos":"noun","rank":3561,"glosses":["heart attack, myocardial infarction","infarct (in general)"],"ipa":"/inˈfaɾto/","gender":"m","forms":{"plural":"infartos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-AdrianAbdulBaha-infarto.wav","examples":[{"text":"Murió de un infarto.","en":"He died of a heart attack.","audio":"https://tatoeba.org/en/audio/download/630154","words":[{"g":"to die","l":"morir"},{"g":"of / from"},{"g":"a"},null]},{"text":"Tuve un infarto el año pasado.","en":"I had a stroke last year.","audio":"https://tatoeba.org/en/audio/download/788560","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"the"},{"g":"year"},{"g":"past"}]},{"text":"Casi me dio un infarto.","en":"I almost had a heart attack.","words":[{"g":"almost"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"Ella parecía estar sufriendo un infarto.","en":"She seemed to be suffering a heart attack.","audio":"https://tatoeba.org/en/audio/download/692638","words":[{"g":"she"},{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},{"g":"to suffer","l":"sufrir"},{"g":"a"},null]},{"text":"Vas a hacer que me dé un infarto.","en":"You'll give me a heart attack.","audio":"https://tatoeba.org/en/audio/download/645582","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to do"},{"g":"that"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]}]}