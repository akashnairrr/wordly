o/download/634340","words":[{"g":"me"},{"g":"to be able to, can","l":"poder"},null,null,null,{"g":"the / her"},{"g":"window"}],"phrases":[[3,5,"next to, alongside"]]},{"text":"¿Me puedo sentar a tu lado?","en":"May I sit next to you?","audio":"https://tatoeba.org/en/audio/download/460464","words":[{"g":"me"},{"g":"to be able to, can","l":"poder"},null,{"g":"to"},{"g":"your"},{"g":"side"}]},{"text":"Me siento un poco triste hoy.","en":"I'm feeling a little sad today.","audio":"https://tatoeba.org/en/audio/download/600064","words":[{"g":"me"},null,null,null,{"g":"As a temporary state."},{"g":"today, tonight"}],"phrases":[[2,4,"a bit"]]}]}