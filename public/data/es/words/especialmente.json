{"id":"especialmente","lemma":"especialmente","pos":"adv","rank":919,"glosses":["specially","especially"],"ipa":"/espeˌθjalˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Marreromarco-especialmente.wav","examples":[{"text":"Hoy no hace calor especialmente.","en":"It isn't especially hot today.","audio":"https://tatoeba.org/en/audio/download/706504","words":[{"g":"today, tonight"},{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"heat"},null]},{"text":"Me gusta caminar, especialmente a la mañana.","en":"I like walking, especially in the morning.","audio":"https://tatoeba.org/en/audio/download/600010","words":[null,null,{"g":"to walk"},null,{"g":"to"},{"g":"the / her"},{"g":"tomorrow"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Me gusta escuchar música, especialmente jazz.","en":"I like listening to music, especially jazz.","audio":"https://tatoeba.org/en/audio/download/694133","words":[null,null,{"g":"to listen to"},{"g":"music"},null,{"g":"jazz"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Me gusta la música, especialmente el rock.","en":"I love music, especially rock.","audio":"https://tatoeba.org/en/audio/download/937541","words":[null,null,{"g":"the / her"},{"g":"music"},null,{"g":"the"},{"g":"rock"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Ella es especialmente atractiva.","en":"She is remarkably attractive.","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"attractive, appealing","l":"atractivo"}]}]}