{"id":"especialmente","lemma":"especialmente","pos":"adv","rank":919,"glosses":["specially","especially"],"ipa":"/espeˌθjalˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Marreromarco-especialmente.wav","examples":[{"text":"Me gusta la música, especialmente el rock.","en":"I love music, especially rock.","audio":"https://tatoeba.org/en/audio/download/937541","words":[null,null,{"g":"the / her"},{"g":"music"},null,{"g":"the"},{"g":"rock"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Me gusta caminar, especialmente a la mañana.","en":"I like walking, especially in the morning.","audio":"https://tatoeba.org/en/audio/download/600010","words":[null,null,{"g":"to walk"},null,{"g":"to"},{"g":"the / her"},{"g":"tomorrow"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Hoy no hace calor especialmente.","en":"It isn't especially hot today.","audio":"https://tatoeba.org/en/audio/download/706504","words":[{"g":"today, tonight"},{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"heat"},null]},{"text":"Tom no pareció especialmente contento de verme.","en":"Tom didn't seem particularly happy to see me.","words":[null,{"g":"no / not"},{"g":"to seem, to see fit","l":"parecer"},null,{"g":"content"},{"g":"of / from"},{"g":"worm"}]},{"text":"Usted no parece especialmente complacido.","en":"You don't seem particularly pleased.","words":[{"g":"you (formal)"},{"g":"no / not"},{"g":"to seem, to see fit","l":"parecer"},null,{"g":"content"}]}]}