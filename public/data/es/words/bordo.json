{"id":"bordo","lemma":"bordo","pos":"noun","rank":1412,"glosses":["side, board","tack","ridge"],"ipa":"/ˈboɾdo/","gender":"m","forms":{"plural":"bordos"},"examples":[{"text":"Yo subí a bordo.","en":"I went aboard.","audio":"https://tatoeba.org/en/audio/download/440413"},{"text":"¿Puedo subir a bordo?","en":"May I come aboard?","audio":"https://tatoeba.org/en/audio/download/826094"},{"text":"Dormí a bordo del barco.","en":"I slept aboard the ship.","audio":"https://tatoeba.org/en/audio/download/586770"},{"text":"Te dejaré subir a bordo.","en":"I'll let you come aboard.","audio":"https://tatoeba.org/en/audio/download/831260"},{"text":"Pido permiso para subir a bordo.","en":"I request permission to come aboard.","audio":"https://tatoeba.org/en/audio/download/831259"}]}