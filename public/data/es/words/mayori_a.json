{"id":"mayori_a","lemma":"mayoría","pos":"noun","rank":686,"glosses":["majority"],"ipa":"/maʝoˈɾia/","gender":"f","forms":{"plural":"mayorías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f3/LL-Q1321_%28spa%29-AdrianAbdulBaha-mayor%C3%ADa.wav","examples":[{"text":"La mayoría nunca se equivoca.","en":"The majority is never wrong.","audio":"https://tatoeba.org/en/audio/download/694600"},{"text":"La mayoría de éstos son míos.","en":"Most of these are mine.","audio":"https://tatoeba.org/en/audio/download/461008"},{"text":"La mayoría de éstas son mías.","en":"Most of these are mine.","audio":"https://tatoeba.org/en/audio/download/461012"},{"text":"Tom no es como la mayoría.","en":"Tom isn't conventional.","audio":"https://tatoeba.org/en/audio/download/301987"},{"text":"La mayoría de ellos son canadienses.","en":"Most of them are Canadians.","audio":"https://tatoeba.org/en/audio/download/302333"}]}