{"id":"di_a","lemma":"día","pos":"noun","rank":105,"glosses":["day (any period of 24 hours)","day (a period from midnight to the following midnight)","day (rotational period of a planet)"],"ipa":"/ˈdia/","gender":"m","forms":{"plural":"días"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Precision27-d%C3%ADa.wav","formAudio":{"días":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q1321_%28spa%29-Precision27-d%C3%ADas.wav"},"examples":[{"text":"Es un nuevo día.","en":"It's a new day.","audio":"https://tatoeba.org/en/audio/download/440979"},{"text":"Lloro todos los días.","en":"I cry every day.","audio":"https://tatoeba.org/en/audio/download/819935"},{"text":"¡Qué día tan malo!","en":"What a bad day!","audio":"https://tatoeba.org/en/audio/download/523539"},{"text":"Corro todos los días.","en":"I run every day.","audio":"https://tatoeba.org/en/audio/download/38873"},{"text":"¡Qué día tan triste!","en":"What a sad day!","audio":"https://tatoeba.org/en/audio/download/523541"}]}