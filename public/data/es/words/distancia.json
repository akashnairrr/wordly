{"id":"distancia","lemma":"distancia","pos":"noun","rank":1075,"glosses":["distance"],"ipa":"/disˈtanθja/","gender":"f","forms":{"plural":"distancias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Rodrigo5260-distancia.wav","examples":[{"text":"Pásame el mando a distancia.","en":"Hand me the remote.","audio":"https://tatoeba.org/en/audio/download/637214"},{"text":"No estoy acostumbrado a caminar largas distancias.","en":"I am not accustomed to walking long distances.","audio":"https://tatoeba.org/en/audio/download/607945"},{"text":"¡Devuélveme el mando a distancia!","en":"Give me back the TV remote.","audio":"https://tatoeba.org/en/audio/download/639962"},{"text":"Los pájaros vuelan distancias largas.","en":"Birds fly long distances."},{"text":"¿A qué distancia está el pueblo?","en":"How far is it to town?","audio":"https://tatoeba.org/en/audio/download/611278"}]}