{"id":"distancia","lemma":"distancia","pos":"noun","rank":1072,"glosses":["distance"],"ipa":"/disˈtanθja/","gender":"f","forms":{"plural":"distancias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Rodrigo5260-distancia.wav","examples":[{"text":"Vimos un castillo en la distancia.","en":"We saw a castle in the distance.","audio":"https://tatoeba.org/en/audio/download/531844","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"castle"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"¿A qué distancia está el pueblo?","en":"How far is it to town?","audio":"https://tatoeba.org/en/audio/download/611278","words":[{"g":"to"},{"g":"what"},null,{"g":"to be","l":"estar"},{"g":"the"},{"g":"town, village"}]},{"text":"Puedo ver un barco a la distancia.","en":"I can see a ship in the distance.","words":[{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"a"},{"g":"boat"},{"g":"to"},{"g":"the / her"},null]},{"text":"Vimos una débil luz en la distancia.","en":"We saw a dim light in the distance.","audio":"https://tatoeba.org/en/audio/download/803798","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"weak"},{"g":"light"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"¿Qué distancia hay hasta tu casa?","en":"How far is it from here to your house?","words":[{"g":"what"},null,{"g":"to have","l":"haber"},{"g":"until"},{"g":"your"},{"g":"house"}]}]}