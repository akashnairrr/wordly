{"id":"avio_n","lemma":"avión","pos":"noun","rank":633,"glosses":["aeroplane, airplane, plane","hopscotch"],"ipa":"/aˈbjon/","gender":"m","forms":{"plural":"aviones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4f/LL-Q1321_%28spa%29-AdrianAbdulBaha-avi%C3%B3n.wav","examples":[{"text":"Odia viajar en avión.","en":"He hates air travel.","audio":"https://tatoeba.org/en/audio/download/933950"},{"text":"Los aviones despegaron uno tras otro.","en":"One plane after another took off.","audio":"https://tatoeba.org/en/audio/download/706581"},{"text":"Iré allí en avión.","en":"I'll go there by plane.","audio":"https://tatoeba.org/en/audio/download/460935"},{"text":"Mi pasatiempo es hacer maquetas de aviones.","en":"My hobby is making model planes.","audio":"https://tatoeba.org/en/audio/download/354041"},{"text":"Él abordó el avión.","en":"He went aboard the plane.","audio":"https://tatoeba.org/en/audio/download/826104"}]}