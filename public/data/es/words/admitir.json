{"id":"admitir","lemma":"admitir","pos":"verb","rank":1834,"glosses":["to accept, to admit, to agree to, to concede","to admit, to let in","to permit, to allow"],"ipa":"/admiˈtiɾ/","conjugation":{"indicative":{"present":{"1s":"admito","2s":"admites","3s":"admite","1p":"admitimos","2p":"admitís","3p":"admiten"},"imperfect":{"1s":"admitía","2s":"admitías","3s":"admitía","1p":"admitíamos","2p":"admitíais","3p":"admitían"},"preterite":{"1s":"admití","2s":"admitiste","3s":"admitió","1p":"admitimos","2p":"admitisteis","3p":"admitieron"},"future":{"1s":"admitiré","2s":"admitirás","3s":"admitirá","1p":"admitiremos","2p":"admitiréis","3p":"admitirán"},"conditional":{"1s":"admitiría","2s":"admitirías","3s":"admitiría","1p":"admitiríamos","2p":"admitiríais","3p":"admitirían"}},"subjunctive":{"present":{"1s":"admita","2s":"admitas","3s":"admita","1p":"admitamos","2p":"admitáis","3p":"admitan"},"imperfect":{"1s":"admitiera","2s":"admitieras","3s":"admitiera","1p":"admitiéramos","2p":"admitierais","3p":"admitieran"}},"imperative":{"affirmative":{"2s":"admite","3s":"admita","1p":"admitamos","2p":"admitid","3p":"admitan"},"negative":{"2s":"admitas","3s":"admita","1p":"admitamos","2p":"admitáis","3p":"admitan"}}},"nonFinite":{"gerund":"admitiendo","participle":"admitido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Marreromarco-admitir.wav","examples":[{"text":"Es difícil admitir que se es un perdedor.","en":"It's hard to admit you're a loser.","audio":"https://tatoeba.org/en/audio/download/741193"},{"text":"Ese chico fue admitido en la escuela.","en":"The boy was admitted to the school."},{"text":"Admito que estoy equivocado.","en":"I admit I'm wrong.","audio":"https://tatoeba.org/en/audio/download/444217"},{"text":"¿Por qué no admites tu error?","en":"Why don't you admit your mistake?"},{"text":"¿Admite el precio rebaja?","en":"Can the price be discounted?","audio":"https://tatoeba.org/en/audio/download/702914"}]}