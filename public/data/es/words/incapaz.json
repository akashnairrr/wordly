{"id":"incapaz","lemma":"incapaz","pos":"adj","rank":3034,"glosses":["incapable, unable"],"ipa":"/inkaˈpaθ/","forms":{"femininePlural":"incapaces"},"order":3039,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a9/LL-Q1321_%28spa%29-AdrianAbdulBaha-incapaz.wav","examples":[{"text":"Él es incapaz de hacerlo.","en":"He is unable to do it.","audio":"https://tatoeba.org/en/audio/download/68283","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"to do","l":"hacer"}]},{"text":"Él es incapaz de comprar un coche.","en":"He is unable to buy a car.","audio":"https://tatoeba.org/en/audio/download/553753","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"to buy"},{"g":"a"},{"g":"car, automobile"}]},{"text":"Fuimos incapaces de seguir su lógica.","en":"We were unable to follow his logic.","words":[{"g":"to go","l":"ir"},null,{"g":"of / from"},{"g":"to follow"},{"g":"his / her / your"},{"g":"logic"}]}]}