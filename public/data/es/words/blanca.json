{"id":"blanca","lemma":"blanca","pos":"noun","rank":910,"glosses":["minim, half note"],"ipa":"/ˈblanka/","gender":"f","forms":{"plural":"blancas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/16/LL-Q1321_%28spa%29-Marreromarco-blanca.wav","formAudio":{"blancas":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1321_%28spa%29-Marreromarco-blancas.wav"},"examples":[{"text":"Me puse una camisa blanca.","en":"I wore a white shirt.","audio":"https://tatoeba.org/en/audio/download/540711"},{"text":"¿Llevan aquéllas faldas blancas?","en":"Do those girls wear white skirts?","audio":"https://tatoeba.org/en/audio/download/684430"},{"text":"Su cara se puso blanca.","en":"Her face turned white.","audio":"https://tatoeba.org/en/audio/download/1061708"},{"text":"¿Por qué siempre llevas camisas blancas?","en":"Why do you always wear white shirts?","audio":"https://tatoeba.org/en/audio/download/823751"},{"text":"Esa vela no es blanca.","en":"That candle isn't white.","audio":"https://tatoeba.org/en/audio/download/515202"}]}