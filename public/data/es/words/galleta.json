{"id":"galleta","lemma":"galleta","pos":"noun","rank":1856,"glosses":["cookie / biscuit","slap"],"ipa":"/ɡaˈʝeta/","gender":"f","forms":{"plural":"galletas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-AdrianAbdulBaha-galleta.wav","examples":[{"text":"Yo saqué la última galleta.","en":"I took the last cookie.","audio":"https://tatoeba.org/en/audio/download/458683"},{"text":"Me gustan las galletas.","en":"I like cookies.","audio":"https://tatoeba.org/en/audio/download/440874"},{"text":"¿Quién se ha comido la última galleta?","en":"Who ate the last cookie?","audio":"https://tatoeba.org/en/audio/download/92613"},{"text":"Tom me hizo galletas.","en":"Tom made me cookies.","audio":"https://tatoeba.org/en/audio/download/800953"},{"text":"Hay una galleta debajo de la mesa.","en":"A cookie is under the table.","audio":"https://tatoeba.org/en/audio/download/71127"}]}