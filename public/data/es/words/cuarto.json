{"id":"cuarto","lemma":"cuarto","pos":"noun","rank":430,"glosses":["fourth (in a series)","quarter-hour (one of four equal divisions of an hour)","watch (one of the four approximately equal divisions of the night, especially for shifts of watchmen)"],"ipa":"/ˈkwaɾto/","gender":"m","forms":{"plural":"cuartos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-AdrianAbdulBaha-cuarto.wav","examples":[{"text":"¿Dónde está tu cuarto?","en":"Where is your room?","audio":"https://tatoeba.org/en/audio/download/448226","words":[null,null,{"g":"your"},null],"phrases":[[0,2,"where are you?"]]},{"text":"Tres medios son seis cuartos.","en":"Three halves is six quarters.","audio":"https://tatoeba.org/en/audio/download/819895","words":[{"g":"three"},{"g":"media"},{"g":"to be","l":"ser"},{"g":"six"},null]},{"text":"Yo necesito un cuarto.","en":"I need a room.","audio":"https://tatoeba.org/en/audio/download/440349","words":[{"g":"I"},{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"No vayas a mi cuarto.","en":"Don't go in my room.","audio":"https://tatoeba.org/en/audio/download/448223","words":[{"g":"no / not"},{"g":"what a ...","l":"vaya"},{"g":"to"},{"g":"my"},null]},{"text":"Esta casa tiene dos cuartos de baño.","en":"This house has two bathrooms.","words":[{"g":"this","l":"este"},{"g":"house"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null,{"g":"of / from"},{"g":"bath"}]}]}