{"id":"comienzo","lemma":"comienzo","pos":"noun","rank":1211,"glosses":["beginning"],"ipa":"/koˈmjenθo/","gender":"m","forms":{"plural":"comienzos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Marreromarco-comienzo.wav","examples":[{"text":"Es un buen comienzo.","en":"It's a good start.","audio":"https://tatoeba.org/en/audio/download/443726"},{"text":"Todos los comienzos son difíciles.","en":"All beginnings are difficult."},{"text":"Yo pensé eso al comienzo.","en":"I thought so at first.","audio":"https://tatoeba.org/en/audio/download/454479"},{"text":"Ellos llegaron a Osaka a comienzos de mayo.","en":"They arrived in Osaka at the beginning of May."},{"text":"Lo sabía desde el comienzo.","en":"I knew it from the start.","audio":"https://tatoeba.org/en/audio/download/77877"}]}