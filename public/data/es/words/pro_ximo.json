{"id":"pro_ximo","lemma":"próximo","pos":"adj","rank":529,"glosses":["near","next","approaching, forthcoming, upcoming"],"ipa":"/ˈpɾoɡsimo/","forms":{"feminine":"próxima","masculinePlural":"próximos","femininePlural":"próximas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Marreromarco-pr%C3%B3ximo.wav","examples":[{"text":"¿Qué te parece el próximo domingo?","en":"What about next Sunday?","audio":"https://tatoeba.org/en/audio/download/459472","words":[{"g":"what"},{"g":"you"},{"g":"to seem, to see fit","l":"parecer"},{"g":"the"},null,{"g":"Sunday"}]},{"text":"¡Hasta la próxima semana!","en":"See you next week!","audio":"https://tatoeba.org/en/audio/download/444416","words":[{"g":"until"},{"g":"the / her"},null,{"g":"week"}]},{"text":"¿Cuándo es tu próximo espectáculo?","en":"When is your next show?","audio":"https://tatoeba.org/en/audio/download/461768","words":[{"g":"when"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"show, performance"}]},{"text":"¿Cuál es la próxima parada?","en":"What is the next stop?","audio":"https://tatoeba.org/en/audio/download/80657","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the / her"},null,{"g":"stop"}]},{"text":"Los próximos lunes y martes son fiesta.","en":"Next Monday and Tuesday are holidays.","audio":"https://tatoeba.org/en/audio/download/298582","words":[{"g":"the / them"},null,{"g":"Monday"},{"g":"and"},{"g":"Tuesday (the third day…"},{"g":"to be","l":"ser"},{"g":"party"}]}]}