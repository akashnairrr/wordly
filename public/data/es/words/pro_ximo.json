{"id":"pro_ximo","lemma":"próximo","pos":"adj","rank":532,"glosses":["near","next","approaching, forthcoming, upcoming"],"ipa":"/ˈpɾoɡsimo/","forms":{"feminine":"próxima","masculinePlural":"próximos","femininePlural":"próximas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Marreromarco-pr%C3%B3ximo.wav","examples":[{"text":"Cogeré el próximo autobús.","en":"I'll take the next bus.","audio":"https://tatoeba.org/en/audio/download/125078"},{"text":"¡Hasta la próxima semana!","en":"See you next week!","audio":"https://tatoeba.org/en/audio/download/444416"},{"text":"Los próximos lunes y martes son fiesta.","en":"Next Monday and Tuesday are holidays.","audio":"https://tatoeba.org/en/audio/download/298582"},{"text":"El camino va derecho por las próximas 50 millas.","en":"The road stays straight for the next 50 miles."},{"text":"Cogeré el próximo bus.","en":"I'll catch the next bus.","audio":"https://tatoeba.org/en/audio/download/538242"}]}