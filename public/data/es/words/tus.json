{"id":"tus","lemma":"tus","pos":"det","rank":140,"glosses":["your (informal, plural)"],"ipa":"/tus/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-AdrianAbdulBaha-tus.wav","examples":[{"text":"Me gustan tus perros.","en":"I like your dogs.","audio":"https://tatoeba.org/en/audio/download/442687"},{"text":"Llama a tus hermanas.","en":"Call your sisters.","audio":"https://tatoeba.org/en/audio/download/636721"},{"text":"Obedece a tus padres.","en":"Obey your parents.","audio":"https://tatoeba.org/en/audio/download/513064"},{"text":"Aquí están tus llaves.","en":"Here are your keys.","audio":"https://tatoeba.org/en/audio/download/449925"},{"text":"He aquí tus llaves.","en":"Here are your keys.","audio":"https://tatoeba.org/en/audio/download/449926"}]}