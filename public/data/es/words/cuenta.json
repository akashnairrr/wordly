{"id":"cuenta","lemma":"cuenta","pos":"noun","rank":196,"glosses":["count, tally","operation","bill"],"ipa":"/ˈkwenta/","gender":"f","forms":{"plural":"cuentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/67/LL-Q1321_%28spa%29-Precision27-cuenta.wav","examples":[{"text":"La cuenta, por favor.","en":"Check, please.","audio":"https://tatoeba.org/en/audio/download/1522"},{"text":"¿Nos cuentas un cuento?","en":"Could you tell us a story?","audio":"https://tatoeba.org/en/audio/download/611963"},{"text":"¡La cuenta, por favor!","en":"Check, please.","audio":"https://tatoeba.org/en/audio/download/525333"},{"text":"Nunca me cuentas nada.","en":"You never tell me anything.","audio":"https://tatoeba.org/en/audio/download/639774"},{"text":"Estoy por mi cuenta.","en":"I'm on my own.","audio":"https://tatoeba.org/en/audio/download/440529"}]}