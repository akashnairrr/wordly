{"id":"ruego","lemma":"ruego","pos":"noun","rank":1465,"glosses":["plea, appeal"],"ipa":"/ˈrweɡo/","gender":"m","forms":{"plural":"ruegos"},"examples":[{"text":"Te ruego que nos ayudes.","en":"I beg you to help us.","audio":"https://tatoeba.org/en/audio/download/454181"},{"text":"Hizo oídos sordos a mis ruegos.","en":"He was deaf to my pleas.","audio":"https://tatoeba.org/en/audio/download/932210"},{"text":"Le ruego que me perdone.","en":"I beg you to forgive me.","audio":"https://tatoeba.org/en/audio/download/460739"},{"text":"Te ruego que me perdones.","en":"I beg you to forgive me.","audio":"https://tatoeba.org/en/audio/download/459030"},{"text":"Os ruego que me perdonéis.","en":"I beg you to forgive me.","audio":"https://tatoeba.org/en/audio/download/459853"}]}