{"id":"ruego","lemma":"ruego","pos":"noun","rank":1462,"glosses":["plea, appeal"],"ipa":"/ˈrweɡo/","gender":"m","forms":{"plural":"ruegos"},"examples":[{"text":"Te lo ruego.","en":"I beg you.","words":[{"g":"you"},{"g":"it / him"},null]},{"text":"Le ruego que me perdone.","en":"I beg you to forgive me.","audio":"https://tatoeba.org/en/audio/download/460739","words":[{"g":"him / her"},null,{"g":"that"},{"g":"me"},{"g":"to pardon","l":"perdonar"}]},{"text":"Te ruego que me dejes vivir.","en":"I beg you to let me live.","words":[{"g":"you"},null,{"g":"that"},{"g":"me"},{"g":"to leave","l":"dejar"},{"g":"to live"}]},{"text":"Hizo oídos sordos a mis ruegos.","en":"He was deaf to my pleas.","audio":"https://tatoeba.org/en/audio/download/932210","words":[{"g":"to do","l":"hacer"},{"g":"hearing","l":"oído"},{"g":"deaf","l":"sordo"},{"g":"to"},{"g":"my"},null]},{"text":"Te ruego que nos ayudes.","en":"I beg you to help us.","audio":"https://tatoeba.org/en/audio/download/454181","words":[{"g":"you"},null,{"g":"that"},{"g":"us"},{"g":"to help","l":"ayudar"}]}]}