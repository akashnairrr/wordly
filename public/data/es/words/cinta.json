{"id":"cinta","lemma":"cinta","pos":"noun","rank":1202,"glosses":["ribbon, worn by girls in the hair","tape"],"ipa":"/ˈθinta/","gender":"f","forms":{"plural":"cintas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Marreromarco-cinta.wav","examples":[{"text":"No hay cinta en esta cámara.","en":"There's no film in this camera.","audio":"https://tatoeba.org/en/audio/download/805838","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"room"}]},{"text":"Vamos a escuchar esta cinta.","en":"Let's listen to the tape.","audio":"https://tatoeba.org/en/audio/download/693395","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to listen to"},{"g":"this","l":"este"},null]},{"text":"Es la mejor cinta del año.","en":"It's the best film of the year.","words":[{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"better"},null,{"g":"of the"},{"g":"year"}]},{"text":"Había una grabadora de cintas en la mesa.","en":"There was a tape recorder on the table.","audio":"https://tatoeba.org/en/audio/download/806114","words":[{"g":"makes pluperfect to…"},{"g":"a"},{"g":"recorder"},{"g":"of / from"},null,{"g":"in / on"},{"g":"the / her"},{"g":"table"}]},{"text":"Él borró su discurso de la cinta.","en":"He erased his speech from the tape.","words":[{"g":"he"},{"g":"to erase, to delete","l":"borrar"},{"g":"his / her / your"},{"g":"discourse"},null,null,null],"phrases":[[4,6,"of the"]]}]}