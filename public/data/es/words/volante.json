{"id":"volante","lemma":"volante","pos":"noun","rank":3033,"glosses":["flyer, circular","steering wheel","shuttlecock"],"ipa":"/boˈlante/","gender":"m","forms":{"plural":"volantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-Marreromarco-volante.wav","examples":[{"text":"La velocidad al volante causa accidentes.","en":"Speeding causes accidents.","audio":"https://tatoeba.org/en/audio/download/611732","words":[{"g":"the / her"},{"g":"speed"},{"g":"to the"},null,{"g":"cause"},{"g":"accident","l":"accidente"}]},{"text":"¡Mira! ¡Un platillo volante!","en":"Look! A flying saucer!","words":[{"g":"target"},{"g":"a"},{"g":"saucer"},null]},{"text":"Giré el volante del coche hacia la derecha.","en":"I turned my steering wheel to the right.","words":[{"g":"to turn, pivot","l":"girar"},{"g":"the"},null,{"g":"of the"},{"g":"car, automobile"},{"g":"toward, towards"},{"g":"the / her"},{"g":"right"}]},{"text":"Tom se quedó dormido en el volante.","en":"Tom fell asleep at the wheel.","words":[null,{"g":"oneself"},{"g":"to be , to end up","l":"quedar"},{"g":"asleep, sleeping"},{"g":"in / on"},{"g":"the"},null]},{"text":"Él se durmió al volante y sufrió un accidente.","en":"He fell asleep behind the wheel and had an accident.","words":[{"g":"he"},{"g":"oneself"},{"g":"to sleep","l":"dormir"},{"g":"to the"},null,{"g":"and"},{"g":"to suffer","l":"sufrir"},{"g":"a"},{"g":"accident"}]}]}