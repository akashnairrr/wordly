{"id":"pasillo","lemma":"pasillo","pos":"noun","rank":1621,"glosses":["hallway, corridor","aisle","pasillo"],"ipa":"/paˈsiʝo/","gender":"m","forms":{"plural":"pasillos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q1321_%28spa%29-Marreromarco-pasillo.wav","examples":[{"text":"¿Podemos hablar en el pasillo?","en":"Can we speak in the hall?","audio":"https://tatoeba.org/en/audio/download/605072","words":[{"g":"to prune","l":"podar"},{"g":"to talk"},{"g":"in / on"},{"g":"the"},null]},{"text":"¿Puedo tener un asiento de pasillo?","en":"Can I have an aisle seat?","words":[{"g":"to be able to, can","l":"poder"},{"g":"to have"},{"g":"a"},{"g":"seat"},{"g":"of / from"},null]},{"text":"Cuelga tu abrigo en el pasillo.","en":"Hang your coat in the hallway.","audio":"https://tatoeba.org/en/audio/download/410491","words":[{"g":"to hang","l":"colgar"},{"g":"your"},{"g":"overcoat"},{"g":"in / on"},{"g":"the"},null]},{"text":"La sala de estar está al final del pasillo.","en":"The living room is at the end of the hall.","audio":"https://tatoeba.org/en/audio/download/508428","words":[{"g":"the / her"},null,null,null,{"g":"to be","l":"estar"},null,null,{"g":"of the"},null],"phrases":[[1,4,"living room"],[5,7,"in the end"]]},{"text":"El suelo del pasillo está embaldosado.","en":"The corridor floor is tiled.","words":[{"g":"the"},{"g":"dirt"},{"g":"of the"},null,{"g":"to be","l":"estar"},null]}]}