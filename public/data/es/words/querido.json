{"id":"querido","lemma":"querido","pos":"noun","rank":435,"glosses":["sweetheart","lover","the letter Q in the Spanish spelling alphabet"],"ipa":"/keˈɾido/","gender":"m","forms":{"plural":"queridos","feminine":"querida","femininePlural":"queridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-Marreromarco-querido.wav","formAudio":{"querida":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Wikipedian-walker-querida.wav"},"examples":[{"text":"Nunca te he querido.","en":"I've never loved you.","audio":"https://tatoeba.org/en/audio/download/550260"},{"text":"Tienes que cuidar de tus seres queridos.","en":"You need to look after your loved ones.","audio":"https://tatoeba.org/en/audio/download/688909"},{"text":"Ella era querida por todos en la villa.","en":"She was loved by everybody in the village."},{"text":"Siempre te he querido.","en":"I've always loved you.","audio":"https://tatoeba.org/en/audio/download/104790"},{"text":"Era querido por todos.","en":"He was loved by everybody.","audio":"https://tatoeba.org/en/audio/download/721722"}]}