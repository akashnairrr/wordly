{"id":"retirado","lemma":"retirado","pos":"adj","rank":3195,"glosses":["withdrawn, removed; retired"],"ipa":"/retiˈɾado/","forms":{"feminine":"retirada","masculinePlural":"retirados","femininePlural":"retiradas"},"formAudio":{"retirada":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-Emanuelps27-retirada.wav"},"examples":[{"text":"Ambos cargos fueron retirados.","en":"Both charges were withdrawn.","audio":"https://tatoeba.org/en/audio/download/804626","words":[{"g":"both"},{"g":"charge, burden","l":"cargo"},{"g":"to go","l":"ir"},null]},{"text":"Su nombre ha sido retirado de la lista.","en":"Your name has been dropped from the list.","audio":"https://tatoeba.org/en/audio/download/606608","words":[{"g":"his / her / your"},{"g":"name"},{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},null,null,null,{"g":"list, roll"}],"phrases":[[5,7,"of the"]]},{"text":"¿No te alegra haberte retirado?","en":"Aren't you glad you're retired?","audio":"https://tatoeba.org/en/audio/download/586921","words":[{"g":"no / not"},{"g":"you"},{"g":"to make happy","l":"alegrar"},{"g":"to have","l":"haber"},null]},{"text":"Tomás es un policía retirado.","en":"Tom is a retired policeman.","audio":"https://tatoeba.org/en/audio/download/519020","words":[{"g":"to take","l":"tomar"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"Civility"},null]},{"text":"Los posters fueron inmediatamente retirados de la pared.","en":"The posters were immediately removed from the wall.","words":[{"g":"the / them"},null,{"g":"to go","l":"ir"},{"g":"immediately"},null,null,null,{"g":"wall"}],"phrases":[[5,7,"of the"]]}]}