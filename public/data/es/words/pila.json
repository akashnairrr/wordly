{"id":"pila","lemma":"pila","pos":"noun","rank":3145,"glosses":["small battery","pile, stack, heap, mound","a lot"],"ipa":"/ˈpila/","gender":"f","forms":{"plural":"pilas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Marreromarco-pila.wav","formAudio":{"pilas":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q1321_%28spa%29-Rub%C3%BD%C3%B1-Pilas.wav"},"examples":[{"text":"Necesita pilas nuevas.","en":"It needs new batteries.","audio":"https://tatoeba.org/en/audio/download/460506","words":[{"g":"to need","l":"necesitar"},null,{"g":"new","l":"nuevo"}]},{"text":"Me he quedado sin pila.","en":"My battery ran out.","audio":"https://tatoeba.org/en/audio/download/930786","words":[{"g":"me"},{"g":"to have","l":"haber"},{"g":"to be , to end up","l":"quedar"},{"g":"without"},null]},{"text":"El mando no tiene pilas.","en":"The remote control doesn't have batteries.","audio":"https://tatoeba.org/en/audio/download/505234","words":[{"g":"the"},{"g":"command"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Nunca supe su nombre de pila.","en":"I never knew his first name.","words":[{"g":"never"},{"g":"to know, to understand","l":"saber"},{"g":"his / her / your"},{"g":"name"},{"g":"of / from"},null]},{"text":"¿Incluye pilas?","en":"Does it include batteries?","audio":"https://tatoeba.org/en/audio/download/921414","words":[{"g":"to include","l":"incluir"},null]}]}