{"id":"queda","lemma":"queda","pos":"noun","rank":370,"glosses":["curfew"],"ipa":"/ˈkeda/","gender":"f","forms":{"plural":"quedas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-Marreromarco-queda.wav","examples":[{"text":"El verde te queda.","en":"Green suits you.","audio":"https://tatoeba.org/en/audio/download/441525"},{"text":"Si te quedas, me quedo.","en":"If you stay, I'll stay.","audio":"https://tatoeba.org/en/audio/download/196014"},{"text":"¿Dónde queda el zoológico?","en":"Where's the zoo?","audio":"https://tatoeba.org/en/audio/download/442241"},{"text":"¿Te vas o te quedas?","en":"Are you going or staying?","audio":"https://tatoeba.org/en/audio/download/71104"},{"text":"Japón queda en Asia.","en":"Japan is in Asia.","audio":"https://tatoeba.org/en/audio/download/442665"}]}