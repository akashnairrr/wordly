{"id":"boto_n","lemma":"botón","pos":"noun","rank":1918,"glosses":["button (clothing, mechanical)","key (on a musical instrument)","bud (newly formed leaf or flower that has not yet unfolded)"],"ipa":"/boˈton/","gender":"m","forms":{"plural":"botones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Marreromarco-bot%C3%B3n.wav","formAudio":{"botones":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-AdrianAbdulBaha-botones.wav"},"examples":[{"text":"El botón se cayó.","en":"The button came off.","audio":"https://tatoeba.org/en/audio/download/449929"},{"text":"Por favor cose estos botones.","en":"Please sew these buttons on.","audio":"https://tatoeba.org/en/audio/download/804306"},{"text":"Este botón está suelto.","en":"This button is loose.","audio":"https://tatoeba.org/en/audio/download/453605"},{"text":"Esta chaqueta tiene botones.","en":"This jacket has buttons."},{"text":"No pulsar ese botón.","en":"Don't push that button.","audio":"https://tatoeba.org/en/audio/download/704778"}]}