{"id":"boto_n","lemma":"botón","pos":"noun","rank":1914,"glosses":["button (clothing, mechanical)","key (on a musical instrument)","bud (newly formed leaf or flower that has not yet unfolded)"],"ipa":"/boˈton/","gender":"m","forms":{"plural":"botones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Marreromarco-bot%C3%B3n.wav","formAudio":{"botones":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-AdrianAbdulBaha-botones.wav"},"examples":[{"text":"No toques el botón.","en":"Don't touch the button.","audio":"https://tatoeba.org/en/audio/download/527405","words":[{"g":"no / not"},{"g":"a touch","l":"toque"},{"g":"the"},null]},{"text":"Tu camisa ha perdido un botón.","en":"Your shirt is missing a button.","audio":"https://tatoeba.org/en/audio/download/506298","words":[{"g":"your"},{"g":"shirt"},{"g":"to have","l":"haber"},{"g":"lost"},{"g":"a"},null]},{"text":"El botón se cayó.","en":"The button came off.","audio":"https://tatoeba.org/en/audio/download/449929","words":[{"g":"the"},null,{"g":"oneself"},{"g":"to fall","l":"caer"}]},{"text":"Necesito pulsar el botón.","en":"I need to press the button.","audio":"https://tatoeba.org/en/audio/download/525443","words":[{"g":"to need","l":"necesitar"},{"g":"to press"},{"g":"the"},null]},{"text":"Este botón está suelto.","en":"This button is loose.","audio":"https://tatoeba.org/en/audio/download/453605","words":[{"g":"this"},null,{"g":"to be","l":"estar"},{"g":"free, loose, undone"}]}]}