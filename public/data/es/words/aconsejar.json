09","words":[{"g":"the"},{"g":"doctor"},{"g":"him / her"},null,null,null],"phrases":[[4,6,"no smoking"]]},{"text":"Él sabe aconsejar personas.","en":"He knows how to advise people.","words":[{"g":"he"},{"g":"to know, to understand","l":"saber"},null,{"g":"person (an individual","l":"persona"}]},{"text":"Te aconsejo enfáticamente no hacer eso.","en":"I strongly advise you not to do that.","words":[{"g":"you"},null,null,{"g":"no / not"},{"g":"to do"},{"g":"that","l":"ése"}]}]}