{"id":"corazones","lemma":"corazones","pos":"noun","rank":1894,"glosses":["hearts (a suit of cards, ♥)"],"ipa":"/koɾaˈθones/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Eavqwiki-corazones.wav","examples":[{"text":"Tengo el as de corazones.","en":"I have the ace of hearts.","audio":"https://tatoeba.org/en/audio/download/515939"},{"text":"Siempre estará en nuestros corazones.","en":"He will forever be in our hearts.","audio":"https://tatoeba.org/en/audio/download/684478"},{"text":"Siempre vivirá en nuestros corazones.","en":"He will live forever in our hearts.","audio":"https://tatoeba.org/en/audio/download/687757"}]}