{"id":"bolsa","lemma":"bolsa","pos":"noun","rank":812,"glosses":["bag","coin purse","purse, handbag"],"ipa":"/ˈbolsa/","gender":"f","forms":{"plural":"bolsas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-bolsa.wav","examples":[{"text":"Esta es mi bolsa.","en":"This is my bag.","audio":"https://tatoeba.org/en/audio/download/128134"},{"text":"Sube las bolsas arriba.","en":"Take the bags upstairs.","audio":"https://tatoeba.org/en/audio/download/514957"},{"text":"Aquí está tu bolsa.","en":"Here's your bag.","audio":"https://tatoeba.org/en/audio/download/441483"},{"text":"Estate pendiente de las bolsas.","en":"Keep an eye on the bags.","audio":"https://tatoeba.org/en/audio/download/514877"},{"text":"¿Dónde está la bolsa?","en":"Where's the bag?","audio":"https://tatoeba.org/en/audio/download/821249"}]}