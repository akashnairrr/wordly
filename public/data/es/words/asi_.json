{"id":"asi_","lemma":"así","pos":"adv","rank":44,"glosses":["like this; like that; as such; thus; so; thereby; this way, that way","used to express wishes of misfortune against someone, or to cast a spell"],"ipa":"/aˈsi/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-Precision27-as%C3%AD.wav","examples":[{"text":"¿Por qué me siento así?","en":"Why do I feel this way?","audio":"https://tatoeba.org/en/audio/download/459768","words":[null,null,{"g":"me"},{"g":"to seat","l":"sentar"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Me estás bromeando, ¿no es así?","en":"You're kidding me, right?","audio":"https://tatoeba.org/en/audio/download/522382","words":[{"g":"me"},{"g":"to be","l":"estar"},{"g":"to joke, to kid","l":"bromear"},{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"¿Por qué nos siguen pasando cosas así?","en":"Why do things like this keep happening to us?","audio":"https://tatoeba.org/en/audio/download/460010","words":[null,null,{"g":"us"},{"g":"to follow","l":"seguir"},{"g":"to pass","l":"pasar"},{"g":"thing","l":"cosa"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Yo también pienso así.","en":"We think alike.","audio":"https://tatoeba.org/en/audio/download/427982","words":[null,null,{"g":"animal feed"},null],"phrases":[[0,2,"me too"]]},{"text":"A mí me gusta así.","en":"I like it like that.","audio":"https://tatoeba.org/en/audio/download/939615","words":[{"g":"to"},{"g":"me"},null,null,null],"phrases":[[2,4,"like, thumbs up"]]}]}