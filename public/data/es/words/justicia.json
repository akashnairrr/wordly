{"id":"justicia","lemma":"justicia","pos":"noun","rank":890,"glosses":["justice","righteousness","the law"],"ipa":"/xusˈtiθja/","gender":"f","forms":{"plural":"justicias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Marreromarco-justicia.wav","examples":[{"text":"Quiero justicia.","en":"I want justice.","audio":"https://tatoeba.org/en/audio/download/821325","words":[{"g":"to desire","l":"querer"},null]},{"text":"Queremos justicia.","en":"We want justice.","audio":"https://tatoeba.org/en/audio/download/101906","words":[{"g":"to desire","l":"querer"},null]},{"text":"La justicia se encuentra en la corte.","en":"Justice is found in a courtroom.","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to meet","l":"encontrar"},{"g":"in / on"},{"g":"the / her"},{"g":"cut"}]},{"text":"Él reinó con justicia su reino.","en":"He ruled his kingdom fairly.","words":[{"g":"he"},null,{"g":"with"},null,{"g":"his / her / your"},{"g":"kingdom"}]},{"text":"La justicia prevalecerá al final.","en":"Justice will prevail in the end.","words":[{"g":"the / her"},null,null,null,null],"phrases":[[3,5,"in the end"]]}]}