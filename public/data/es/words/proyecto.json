{"id":"proyecto","lemma":"proyecto","pos":"noun","rank":1019,"glosses":["project, plan"],"ipa":"/pɾoˈʝeɡto/","gender":"m","forms":{"plural":"proyectos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q1321_%28spa%29-AdrianAbdulBaha-proyecto.wav","examples":[{"text":"Este es mi proyecto.","en":"That's my plan.","audio":"https://tatoeba.org/en/audio/download/799440"},{"text":"¿Le hablaste acerca de tus proyectos?","en":"Did you speak with him about your projects?"},{"text":"El proyecto fue suspendido.","en":"The project was aborted.","audio":"https://tatoeba.org/en/audio/download/831286"},{"text":"¿Hablaste con él acerca de tus proyectos?","en":"Did you speak with him about your projects?"},{"text":"Es un proyecto ambicioso.","en":"It's an ambitious project.","audio":"https://tatoeba.org/en/audio/download/519527"}]}