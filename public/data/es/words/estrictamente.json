{"id":"estrictamente","lemma":"estrictamente","pos":"adv","rank":4290,"glosses":["strictly"],"ipa":"/esˌtɾiɡtaˈmente/","order":4291,"examples":[{"text":"Esto es, estrictamente hablando, un error.","en":"This is, strictly speaking, a mistake.","audio":"https://tatoeba.org/en/audio/download/589706","words":[{"g":"this"},{"g":"to be","l":"ser"},null,{"g":"to talk","l":"hablar"},{"g":"a"},{"g":"error"}]},{"text":"Está estrictamente prohibido fumar aquí.","en":"Smoking is strictly forbidden here.","audio":"https://tatoeba.org/en/audio/download/687493","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"here"}],"phrases":[[2,4,"no smoking"]]},{"text":"Estrictamente hablando, hubo varios errores en su discurso.","en":"Strictly speaking, there were some mistakes in his speech.","words":[null,{"g":"to talk","l":"hablar"},{"g":"to have","l":"haber"},{"g":"various, several"},{"g":"error","l":"error"},{"g":"in / on"},{"g":"his / her / your"},{"g":"discourse"}]}]}