{"id":"e","lemma":"e","pos":"conj","rank":312,"glosses":["and"],"ipa":"/e/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-Precision27-e.wav","examples":[{"text":"Él era joven e inocente.","en":"He was young and innocent.","audio":"https://tatoeba.org/en/audio/download/639764","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"young, youthful"},null,{"g":"innocent"}]},{"text":"Tengo mujer e hijos.","en":"I have a wife and kids.","audio":"https://tatoeba.org/en/audio/download/550250","words":[{"g":"to have","l":"tener"},{"g":"woman"},null,{"g":"son","l":"hijo"}]},{"text":"Él puede hablar francés e inglés.","en":"He can speak French and English.","audio":"https://tatoeba.org/en/audio/download/515907","words":[{"g":"he"},{"g":"to be able to, can","l":"poder"},{"g":"to talk"},{"g":"French"},null,{"g":"English"}]},{"text":"Él es guapo e inteligente.","en":"He is handsome and clever.","audio":"https://tatoeba.org/en/audio/download/692093","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"good-looking"},null,{"g":"intelligent"}]},{"text":"Si quieres intentarlo, ve e intenta.","en":"If you want to try it, go ahead and try it.","words":[{"g":"if, whether"},{"g":"to desire","l":"querer"},{"g":"to try, to attempt","l":"intentar"},{"g":"to see, to spot","l":"ver"},null,{"g":"to try, to attempt","l":"intentar"}]}]}