{"id":"testamento","lemma":"testamento","pos":"noun","rank":2402,"glosses":["will, testament","testament","an exceedingly long text"],"ipa":"/testaˈmento/","gender":"m","forms":{"plural":"testamentos"},"order":2415,"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-Marreromarco-testamento.wav","examples":[{"text":"Él hizo un testamento el año pasado.","en":"He made a will last year.","words":[{"g":"he"},{"g":"to do","l":"hacer"},{"g":"a"},null,{"g":"the"},{"g":"year"},{"g":"past"}]},{"text":"Él murió sin haber hecho un testamento.","en":"He died without having made a will.","words":[{"g":"he"},{"g":"to die","l":"morir"},{"g":"without"},{"g":"to have"},{"g":"done, completed"},{"g":"a"},null]},{"text":"Él le dejó todo a ella en su testamento.","en":"He left everything to her in his will.","audio":"https://tatoeba.org/en/audio/download/693753","words":[{"g":"he"},{"g":"him / her"},{"g":"to leave","l":"dejar"},{"g":"all"},{"g":"to"},{"g":"she"},{"g":"in / on"},{"g":"his / her / your"},null]}]}