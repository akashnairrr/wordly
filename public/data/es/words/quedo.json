{"id":"quedo","lemma":"quedo","pos":"adv","rank":1215,"glosses":["quietly"],"ipa":"/ˈkedo/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-Emanuelps27-quedo.wav","examples":[{"text":"Me quedo con usted.","en":"I'll stay with you.","audio":"https://tatoeba.org/en/audio/download/731748"},{"text":"Me quedo con Tom.","en":"I'm staying with Tom.","audio":"https://tatoeba.org/en/audio/download/800948"},{"text":"Si te quedas, me quedo.","en":"If you stay, I'll stay.","audio":"https://tatoeba.org/en/audio/download/196014"},{"text":"Me quedo dormido en cualquier sitio.","en":"I can sleep anywhere.","audio":"https://tatoeba.org/en/audio/download/415940"},{"text":"Estoy muerto si me quedo aquí.","en":"I'm dead if I stay here.","audio":"https://tatoeba.org/en/audio/download/770177"}]}