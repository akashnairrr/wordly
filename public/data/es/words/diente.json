{"id":"diente","lemma":"diente","pos":"noun","rank":983,"glosses":["tooth","tooth, cog (sharp projection on the blade of a saw or similar implement)","clove (of garlic)"],"ipa":"/ˈdjente/","gender":"m","forms":{"plural":"dientes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q1321_%28spa%29-Rodelar-diente.wav","formAudio":{"dientes":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Marreromarco-dientes.wav"},"examples":[{"text":"Ojo por ojo, diente por diente.","en":"An eye for an eye, a tooth for a tooth.","audio":"https://tatoeba.org/en/audio/download/527456","words":[{"g":"eye"},{"g":"for / by"},{"g":"eye"},null,{"g":"for / by"},null]},{"text":"Estoy con dolor de dientes.","en":"I have a toothache.","audio":"https://tatoeba.org/en/audio/download/450062","words":[{"g":"to be","l":"estar"},{"g":"with"},{"g":"pain"},{"g":"of / from"},null]},{"text":"Mis dientes son de color blanco.","en":"My teeth are white.","audio":"https://tatoeba.org/en/audio/download/456647","words":[{"g":"my"},null,{"g":"to be","l":"ser"},null,null,{"g":"white"}],"phrases":[[3,5,"colored"]]},{"text":"Este diente está suelto.","en":"This tooth is loose.","audio":"https://tatoeba.org/en/audio/download/450343","words":[{"g":"this"},null,{"g":"to be","l":"estar"},{"g":"to release","l":"soltar"}]},{"text":"Sus dientes eran blancos.","en":"His teeth were white.","words":[{"g":"his, her, its, their"},null,{"g":"to be","l":"ser"},{"g":"white","l":"blanco"}]}]}