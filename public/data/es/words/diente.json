{"id":"diente","lemma":"diente","pos":"noun","rank":986,"glosses":["tooth","tooth, cog (sharp projection on the blade of a saw or similar implement)","clove (of garlic)"],"ipa":"/ˈdjente/","gender":"m","forms":{"plural":"dientes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/85/LL-Q1321_%28spa%29-Rodelar-diente.wav","formAudio":{"dientes":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Marreromarco-dientes.wav"},"examples":[{"text":"Me astillé el diente.","en":"I chipped my tooth.","audio":"https://tatoeba.org/en/audio/download/722123"},{"text":"Lávate bien los dientes.","en":"Brush your teeth well.","audio":"https://tatoeba.org/en/audio/download/39417"},{"text":"Me rompí el diente.","en":"I chipped my tooth.","audio":"https://tatoeba.org/en/audio/download/722124"},{"text":"Cepíllate los dientes bien.","en":"Brush your teeth well.","audio":"https://tatoeba.org/en/audio/download/39418"},{"text":"Este diente está suelto.","en":"This tooth is loose.","audio":"https://tatoeba.org/en/audio/download/450343"}]}