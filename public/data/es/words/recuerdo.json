{"id":"recuerdo","lemma":"recuerdo","pos":"noun","rank":373,"glosses":["memory (a specific thing that is remembered)","souvenir"],"ipa":"/reˈkweɾdo/","gender":"m","forms":{"plural":"recuerdos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-recuerdo.wav","examples":[{"text":"Sí, yo recuerdo.","en":"I do remember.","audio":"https://tatoeba.org/en/audio/download/440269","words":[{"g":"yes"},{"g":"I"},null]},{"text":"Esta canción me trae recuerdos de alguien.","en":"This song reminds me of someone.","audio":"https://tatoeba.org/en/audio/download/611678","words":[{"g":"this","l":"este"},{"g":"song"},{"g":"me"},{"g":"to bring","l":"traer"},null,{"g":"of / from"},{"g":"someone, somebody"}]},{"text":"No te recuerdo.","en":"I don't remember you.","audio":"https://tatoeba.org/en/audio/download/455313","words":[{"g":"no / not"},{"g":"you"},null]},{"text":"Esa foto me trajo muchos recuerdos.","en":"That picture brought back a lot of memories.","audio":"https://tatoeba.org/en/audio/download/568487","words":[{"g":"that","l":"ese"},{"g":"photo, photograph"},{"g":"me"},{"g":"to bring","l":"traer"},{"g":"much","l":"mucho"},null]},{"text":"Yo recuerdo esa noche.","en":"I remember that night.","audio":"https://tatoeba.org/en/audio/download/552260","words":[{"g":"I"},null,{"g":"that","l":"ese"},{"g":"night"}]}]}