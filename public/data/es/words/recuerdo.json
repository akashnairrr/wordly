{"id":"recuerdo","lemma":"recuerdo","pos":"noun","rank":376,"glosses":["memory (a specific thing that is remembered)","souvenir"],"ipa":"/reˈkweɾdo/","gender":"m","forms":{"plural":"recuerdos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-recuerdo.wav","examples":[{"text":"Claro que lo recuerdo.","en":"I do remember it.","audio":"https://tatoeba.org/en/audio/download/442533"},{"text":"El cuadro me trajo muchos recuerdos.","en":"The picture brought back a lot of memories.","audio":"https://tatoeba.org/en/audio/download/37294"},{"text":"Claro que recuerdo eso.","en":"I do remember that.","audio":"https://tatoeba.org/en/audio/download/448812"},{"text":"Esa foto me trajo muchos recuerdos.","en":"That picture brought back a lot of memories.","audio":"https://tatoeba.org/en/audio/download/568487"},{"text":"Yo recuerdo esa noche.","en":"I remember that night.","audio":"https://tatoeba.org/en/audio/download/552260"}]}