{"id":"recuerdo","lemma":"recuerdo","pos":"noun","rank":373,"glosses":["memory (a specific thing that is remembered)","souvenir"],"ipa":"/reˈkweɾdo/","gender":"m","forms":{"plural":"recuerdos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-recuerdo.wav","examples":[{"text":"Todavía recuerdo su nombre.","en":"I still remember his name.","audio":"https://tatoeba.org/en/audio/download/515011","words":[{"g":"still, yet"},null,{"g":"his / her / your"},{"g":"name"}]},{"text":"Recuerdo cómo era él.","en":"I remember how he used to be.","audio":"https://tatoeba.org/en/audio/download/524877","words":[null,{"g":"how"},{"g":"to be","l":"ser"},{"g":"he"}]},{"text":"Esta canción me trae recuerdos de alguien.","en":"This song reminds me of someone.","audio":"https://tatoeba.org/en/audio/download/611678","words":[{"g":"this","l":"este"},{"g":"song"},{"g":"me"},{"g":"to bring","l":"traer"},null,{"g":"of / from"},{"g":"someone, somebody"}]},{"text":"Lo recuerdo bien.","en":"I remember him well.","audio":"https://tatoeba.org/en/audio/download/449877","words":[{"g":"it / him"},null,{"g":"well"}]},{"text":"Esa foto me trajo muchos recuerdos.","en":"That picture brought back a lot of memories.","audio":"https://tatoeba.org/en/audio/download/568487","words":[{"g":"that","l":"ese"},{"g":"photo, photograph"},{"g":"me"},{"g":"to bring","l":"traer"},{"g":"much","l":"mucho"},null]}]}