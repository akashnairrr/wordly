{"id":"recuerdo","lemma":"recuerdo","pos":"noun","rank":374,"glosses":["memory (a specific thing that is remembered)","souvenir"],"ipa":"/reˈkweɾdo/","gender":"m","forms":{"plural":"recuerdos"},"order":621,"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-recuerdo.wav","examples":[{"text":"Todavía recuerdo su nombre.","en":"I still remember his name.","audio":"https://tatoeba.org/en/audio/download/515011","words":[{"g":"still, yet"},null,{"g":"his / her / your"},{"g":"name"}]},{"text":"Recuerdo cómo era él.","en":"I remember how he used to be.","audio":"https://tatoeba.org/en/audio/download/524877","words":[null,{"g":"how"},{"g":"to be","l":"ser"},{"g":"he"}]},{"text":"Lo recuerdo bien.","en":"I remember him well.","audio":"https://tatoeba.org/en/audio/download/449877","words":[{"g":"it / him"},null,{"g":"well"}]}]}