{"id":"salga","lemma":"salga","pos":"noun","rank":902,"glosses":["a kind of levy on salt in the Kingdom of Aragon"],"ipa":"/ˈsalɡa/","gender":"f","forms":{"plural":"salgas"},"examples":[{"text":"Salga de mi cama.","en":"Get out of my bed.","audio":"https://tatoeba.org/en/audio/download/221540"},{"text":"Te prohíbo que salgas.","en":"I forbid you to leave.","audio":"https://tatoeba.org/en/audio/download/453331"},{"text":"Deseo que salga bien.","en":"I hope it goes well.","audio":"https://tatoeba.org/en/audio/download/298921"},{"text":"No salgas después de que oscurezca.","en":"Don't go out after dark.","audio":"https://tatoeba.org/en/audio/download/460085"},{"text":"¡Salga de mi oficina!","en":"Get out of my office.","audio":"https://tatoeba.org/en/audio/download/454365"}]}