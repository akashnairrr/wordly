{"id":"momento","lemma":"momento","pos":"noun","rank":129,"glosses":["moment, instant","timing","momentum"],"ipa":"/moˈmento/","gender":"m","forms":{"plural":"momentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d0/LL-Q1321_%28spa%29-AdrianAbdulBaha-momento.wav","examples":[{"text":"Ha llegado el momento.","en":"It's time.","audio":"https://tatoeba.org/en/audio/download/438504"},{"text":"Siempre fastidias los buenos momentos.","en":"You always ruin a good moment.","audio":"https://tatoeba.org/en/audio/download/735096"},{"text":"Llámame en cualquier momento.","en":"Call me anytime.","audio":"https://tatoeba.org/en/audio/download/34508"},{"text":"Los precios permanecen estables en estos momentos.","en":"Prices are stable these days.","audio":"https://tatoeba.org/en/audio/download/306327"},{"text":"Es un mal momento.","en":"It's a bad time.","audio":"https://tatoeba.org/en/audio/download/77881"}]}