{"id":"oscuridad","lemma":"oscuridad","pos":"noun","rank":1148,"glosses":["darkness","obscurity"],"ipa":"/oskuɾiˈdad/","gender":"f","forms":{"plural":"oscuridades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q1321_%28spa%29-AdrianAbdulBaha-oscuridad.wav","examples":[{"text":"Brilla en la oscuridad.","en":"It glows in the dark.","audio":"https://tatoeba.org/en/audio/download/453808"},{"text":"Nos besamos en la oscuridad.","en":"We kissed in the dark.","audio":"https://tatoeba.org/en/audio/download/459980"},{"text":"Yo le temo a la oscuridad.","en":"I'm afraid of the dark.","audio":"https://tatoeba.org/en/audio/download/458593"},{"text":"Le tengo miedo a la oscuridad.","en":"I'm afraid of the dark.","audio":"https://tatoeba.org/en/audio/download/460850"},{"text":"Encendió una vela en la oscuridad.","en":"He lit a candle in the dark.","audio":"https://tatoeba.org/en/audio/download/639521"}]}