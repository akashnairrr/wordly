{"id":"oscuridad","lemma":"oscuridad","pos":"noun","rank":1145,"glosses":["darkness","obscurity"],"ipa":"/oskuɾiˈdad/","gender":"f","forms":{"plural":"oscuridades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q1321_%28spa%29-AdrianAbdulBaha-oscuridad.wav","examples":[{"text":"Ella desapareció en la oscuridad.","en":"She disappeared in the dark.","words":[{"g":"she"},{"g":"to disappear","l":"desaparecer"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"El niño tiene miedo de la oscuridad.","en":"The little boy is afraid of the dark.","audio":"https://tatoeba.org/en/audio/download/554010","words":[null,null,{"g":"to have","l":"tener"},{"g":"fear"},null,null,null],"phrases":[[0,2,"the Christ child"],[4,6,"of the"]]},{"text":"Los perros pueden ver en la oscuridad.","en":"Dogs can see in the dark.","audio":"https://tatoeba.org/en/audio/download/172493","words":[{"g":"the / them"},{"g":"dog","l":"perro"},{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Alguien llamó mi nombre en la oscuridad.","en":"Somebody called my name in the dark.","words":[{"g":"someone, somebody"},{"g":"to summon, to call","l":"llamar"},{"g":"my"},{"g":"name"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Le tengo miedo a la oscuridad.","en":"I'm afraid of the dark.","audio":"https://tatoeba.org/en/audio/download/460850","words":[{"g":"him / her"},{"g":"to have","l":"tener"},{"g":"fear"},{"g":"to"},{"g":"the / her"},null]}]}