{"id":"habi_a","lemma":"había","pos":"verb","rank":132,"glosses":["makes pluperfect to verbs as part of the auxiliary verb haber."],"ipa":"/aˈbia/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/bd/LL-Q1321_%28spa%29-Precision27-hab%C3%ADa.wav","examples":[{"text":"Te lo había avisado.","en":"I warned you.","audio":"https://tatoeba.org/en/audio/download/508844"},{"text":"Te lo había advertido.","en":"I warned you.","audio":"https://tatoeba.org/en/audio/download/508845"},{"text":"No te había visto.","en":"I didn't see you.","audio":"https://tatoeba.org/en/audio/download/442502"},{"text":"Allí no había nadie.","en":"No one was there.","audio":"https://tatoeba.org/en/audio/download/47611"},{"text":"Había un perro corriendo.","en":"A dog was running.","audio":"https://tatoeba.org/en/audio/download/735680"}]}