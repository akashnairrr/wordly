{"id":"habi_a","lemma":"había","pos":"verb","rank":131,"glosses":["makes pluperfect to verbs as part of the auxiliary verb haber."],"ipa":"/aˈbia/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/bd/LL-Q1321_%28spa%29-Precision27-hab%C3%ADa.wav","examples":[{"text":"¿Qué había ahí?","en":"What was there?","audio":"https://tatoeba.org/en/audio/download/441470","words":[{"g":"what"},null,{"g":"there"}]},{"text":"Había alguien en la casa.","en":"Somebody was in the house.","audio":"https://tatoeba.org/en/audio/download/102322","words":[null,{"g":"someone, somebody"},{"g":"in / on"},{"g":"the / her"},{"g":"house"}]},{"text":"¿Había estrellas en el cielo?","en":"Were there any stars in the sky?","audio":"https://tatoeba.org/en/audio/download/554850","words":[null,{"g":"star","l":"estrella"},{"g":"in / on"},{"g":"the"},{"g":"sky"}]},{"text":"Jamás había oído tal cosa.","en":"I've never heard of such a thing.","audio":"https://tatoeba.org/en/audio/download/527437","words":[{"g":"never"},null,{"g":"hearing"},{"g":"such"},{"g":"thing"}]},{"text":"Había un mensaje para mí, ¿verdad?","en":"There was a message for me, wasn't there?","audio":"https://tatoeba.org/en/audio/download/694094","words":[null,{"g":"a"},{"g":"message"},null,null,{"g":"truth"}],"phrases":[[3,5,"in my opinion"]]}]}