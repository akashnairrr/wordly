{"id":"atacar","lemma":"atacar","pos":"verb","rank":1858,"glosses":["to attack, to come at","to engage (enter into conflicted with)","to assail"],"ipa":"/ataˈkaɾ/","conjugation":{"indicative":{"present":{"1s":"ataco","2s":"atacas","3s":"ataca","1p":"atacamos","2p":"atacáis","3p":"atacan"},"imperfect":{"1s":"atacaba","2s":"atacabas","3s":"atacaba","1p":"atacábamos","2p":"atacabais","3p":"atacaban"},"preterite":{"1s":"ataqué","2s":"atacaste","3s":"atacó","1p":"atacamos","2p":"atacasteis","3p":"atacaron"},"future":{"1s":"atacaré","2s":"atacarás","3s":"atacará","1p":"atacaremos","2p":"atacaréis","3p":"atacarán"},"conditional":{"1s":"atacaría","2s":"atacarías","3s":"atacaría","1p":"atacaríamos","2p":"atacaríais","3p":"atacarían"}},"subjunctive":{"present":{"1s":"ataque","2s":"ataques","3s":"ataque","1p":"ataquemos","2p":"ataquéis","3p":"ataquen"},"imperfect":{"1s":"atacara","2s":"atacaras","3s":"atacara","1p":"atacáramos","2p":"atacarais","3p":"atacaran"}},"imperative":{"affirmative":{"2s":"ataca","3s":"ataque","1p":"ataquemos","2p":"atacad","3p":"ataquen"},"negative":{"2s":"ataques","3s":"ataque","1p":"ataquemos","2p":"ataquéis","3p":"ataquen"}}},"nonFinite":{"gerund":"atacando","participle":"atacado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q1321_%28spa%29-Marreromarco-atacar.wav","formAudio":{"ataque":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-AdrianAbdulBaha-ataque.wav"},"examples":[{"text":"Debemos atacar antes de que amanezca.","en":"We need to attack before sunrise.","audio":"https://tatoeba.org/en/audio/download/1253286"},{"text":"El enemigo siguió atacando la noche entera.","en":"The enemy kept up the attack all night."},{"text":"Él fue atacado por un tiburón.","en":"He was attacked by a shark.","audio":"https://tatoeba.org/en/audio/download/639503"},{"text":"¿Qué debería hacer si me ataca un oso grizzly?","en":"What should I do if I'm attacked by a grizzly bear?","audio":"https://tatoeba.org/en/audio/download