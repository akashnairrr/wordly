{"id":"herir","lemma":"herir","pos":"verb","rank":3449,"glosses":["to wound, injure (cause physical injury and pain)","to hurt, offend, wound (cause emotional pain)"],"ipa":"/eˈɾiɾ/","conjugation":{"indicative":{"present":{"1s":"hiero","2s":"hieres","3s":"hiere","1p":"herimos","2p":"herís","3p":"hieren"},"imperfect":{"1s":"hería","2s":"herías","3s":"hería","1p":"heríamos","2p":"heríais","3p":"herían"},"preterite":{"1s":"herí","2s":"heriste","3s":"hirió","1p":"herimos","2p":"heristeis","3p":"hirieron"},"future":{"1s":"heriré","2s":"herirás","3s":"herirá","1p":"heriremos","2p":"heriréis","3p":"herirán"},"conditional":{"1s":"heriría","2s":"herirías","3s":"heriría","1p":"heriríamos","2p":"heriríais","3p":"herirían"}},"subjunctive":{"present":{"1s":"hiera","2s":"hieras","3s":"hiera","1p":"hiramos","2p":"hiráis","3p":"hieran"},"imperfect":{"1s":"hiriera","2s":"hirieras","3s":"hiriera","1p":"hiriéramos","2p":"hirierais","3p":"hirieran"}},"imperative":{"affirmative":{"2s":"hiere","3s":"hiera","1p":"hiramos","2p":"herid","3p":"hieran"},"negative":{"2s":"hieras","3s":"hiera","1p":"hiramos","2p":"hiráis","3p":"hieran"}}},"nonFinite":{"gerund":"hiriendo","participle":"herido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-AdrianAbdulBaha-herir.wav","formAudio":{"herido":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Marreromarco-herido.wav"},"examples":[{"text":"Él no quería herir tus sentimientos.","en":"He did not intend to hurt your feelings.","audio":"https://tatoeba.org/en/audio/download/688867","words":[{"g":"he"},{"g":"no / not"},{"g":"to desire","l":"querer"},null,{"g":"your"},{"g":"feeling","l":"sentimiento"}]},{"text":"Le hirieron en la batalla.","en":"He was wounded in the battle.","audio":"https://tatoeba.org/en/audio/download/586741","words":[{"g":"him / her"},null,{"g":"in / on"},{"g":"the / her"},{"g":"battle"}]},{"text":"A él le hirió una bala.","en":"He was wounded by a bullet.","audio":"https://tatoeba.org/en/audio/download/606451","words":[{"g":"to"},{"g":"he"},{"g":"him / her"},null,{"g":"a"},{"g":"bullet"}]},{"text":"¿Herí sus sentimientos?","en":"Did I hurt his feelings?","audio":"https://tatoeba.org/en/audio/download/70226","words":[null,{"g":"his, her, its, their"},{"g":"feeling","l":"sentimiento"}]},{"text":"No quise herir a nadie.","en":"I meant no harm.","audio":"https://tatoeba.org/en/audio/download/441681","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},null,{"g":"to"},{"g":"no one"}]}]}