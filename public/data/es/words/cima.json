{"id":"cima","lemma":"cima","pos":"noun","rank":2261,"glosses":["top","peak, summit, mountaintop (top of a mountain or hill)","cyme"],"ipa":"/ˈθima/","gender":"f","forms":{"plural":"cimas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-AdrianAbdulBaha-cima.wav","examples":[{"text":"Estoy en la cima del mundo.","en":"I'm on top of the world.","words":[{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the / her"},null,{"g":"of the"},{"g":"world, earth"}]},{"text":"Puedo ver la cima de la montaña.","en":"I can see the top of the mountain.","words":[{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"the / her"},null,null,null,{"g":"mountain"}],"phrases":[[4,6,"of the"]]},{"text":"Subimos a la cima.","en":"We climbed to the top.","audio":"https://tatoeba.org/en/audio/download/459234","words":[{"g":"to go up or come up","l":"subir"},{"g":"to"},{"g":"the / her"},null]},{"text":"Él vive en la cima de la colina.","en":"He lives at the top of the hill.","audio":"https://tatoeba.org/en/audio/download/354637","words":[{"g":"he"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the / her"},null,null,null,{"g":"hill"}],"phrases":[[5,7,"of the"]]},{"text":"Nosotros escalamos hasta la cima.","en":"We climbed right up to the top.","words":[{"g":"we"},{"g":"to scale, to climb","l":"escalar"},{"g":"until"},{"g":"the / her"},null]}]}