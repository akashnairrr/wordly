{"id":"rabia","lemma":"rabia","pos":"noun","rank":2754,"glosses":["rage, anger","rabies"],"ipa":"/ˈrabja/","gender":"f","forms":{"plural":"rabias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-Marreromarco-rabia.wav","examples":[{"text":"Su rabia es comprensible.","en":"Her anger is understandable.","audio":"https://tatoeba.org/en/audio/download/767768","words":[{"g":"his / her / your"},null,{"g":"to be","l":"ser"},{"g":"comprehensible"}]},{"text":"No pude contener mi rabia.","en":"I couldn't control my anger.","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to contain"},{"g":"my"},null]},{"text":"Las noticias lo hicieron explotar de rabia.","en":"The news caused him to explode with anger.","words":[{"g":"the / them"},{"g":"notice","l":"noticia"},{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"to exploit"},{"g":"of / from"},null]},{"text":"Tom no podía contener su rabia.","en":"Tom couldn't contain his anger.","words":[null,{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to contain"},{"g":"his / her / your"},null]},{"text":"Ella rompió el plato a propósito solo para mostrar su rabia.","en":"She broke the dish on purpose just to show her anger.","words":[{"g":"she"},{"g":"to break","l":"romper"},{"g":"the"},{"g":"plate, dish"},null,null,{"g":"sole"},{"g":"for"},{"g":"to show"},{"g":"his / her / your"},null],"phrases":[[4,6,"by the way"]]}]}