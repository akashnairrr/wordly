{"id":"sobreviviente","lemma":"sobreviviente","pos":"adj","rank":4022,"glosses":["surviving"],"ipa":"/sobɾebiˈbjente/","forms":{"femininePlural":"sobrevivientes"},"examples":[{"text":"No hay sobrevivientes.","en":"There are no survivors.","audio":"https://tatoeba.org/en/audio/download/460264","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null]},{"text":"Hay tres sobrevivientes.","en":"There are three survivors.","audio":"https://tatoeba.org/en/audio/download/524619","words":[{"g":"to have","l":"haber"},{"g":"three"},null]},{"text":"Tom fue el único sobreviviente.","en":"Tom was the only survivor.","words":[null,{"g":"to be","l":"ser"},{"g":"the"},{"g":"only"},null]},{"text":"El único sobreviviente del choque fue una bebé.","en":"The sole survivor of the crash was a baby.","words":[{"g":"the"},{"g":"only"},null,{"g":"of the"},{"g":"collision"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"baby"}]},{"text":"Tom y yo somos los únicos sobrevivientes.","en":"Tom and I are the only survivors.","words":[null,{"g":"and"},{"g":"I"},{"g":"to be","l":"ser"},{"g":"the / them"},{"g":"only","l":"único"},null]}]}