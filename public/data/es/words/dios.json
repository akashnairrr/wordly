{"id":"dios","lemma":"dios","pos":"noun","rank":91,"glosses":["god"],"ipa":"/ˈdjos/","gender":"m","forms":{"plural":"dioses","feminine":"diosa","femininePlural":"diosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c6/LL-Q1321_%28spa%29-AdrianAbdulBaha-dios.wav","formAudio":{"diosa":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q1321_%28spa%29-Marreromarco-diosa.wav"},"examples":[{"text":"¡Que Dios te bendiga!","en":"God bless you!","audio":"https://tatoeba.org/en/audio/download/636720"},{"text":"Los dioses no existen.","en":"There are no gods."},{"text":"Que Dios me perdone.","en":"God forgive me.","audio":"https://tatoeba.org/en/audio/download/871858"},{"text":"Sacrificaron una cabra en honor a los dioses.","en":"They killed a goat as a sacrifice to the gods."},{"text":"Sólo Dios lo sabe.","en":"Only God knows.","audio":"https://tatoeba.org/en/audio/download/441083"}]}