{"id":"cheque","lemma":"cheque","pos":"noun","rank":1589,"glosses":["cheque, blank cheque","checkmark","check valve"],"ipa":"/ˈt͡ʃeke/","gender":"m","forms":{"plural":"cheques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/41/LL-Q1321_%28spa%29-Marreromarco-cheque.wav","examples":[{"text":"¿Puedo pagar con cheque?","en":"May I pay by check?","audio":"https://tatoeba.org/en/audio/download/450121"},{"text":"¿Aceptan cheques de viajero?","en":"Do you take travelers' checks?","audio":"https://tatoeba.org/en/audio/download/598541"},{"text":"Él firmó el cheque.","en":"He signed the check.","audio":"https://tatoeba.org/en/audio/download/449046"},{"text":"¿Tienes cheques de viaje?","en":"Do you have any travelers' checks?","audio":"https://tatoeba.org/en/audio/download/353476"},{"text":"Por favor cobra este cheque.","en":"Please cash this check.","audio":"https://tatoeba.org/en/audio/download/612348"}]}