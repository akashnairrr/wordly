{"id":"sen_or","lemma":"señor","pos":"noun","rank":85,"glosses":["mister, sir, lord (title conferred on a married or older male)","gentleman","master"],"ipa":"/seˈɲoɾ/","gender":"m","forms":{"plural":"señores","feminine":"señora","femininePlural":"señoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1or.wav","formAudio":{"señora":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1ora.wav"},"examples":[{"text":"Puede irse ahora, señor.","en":"You can go now, sir.","audio":"https://tatoeba.org/en/audio/download/453560"},{"text":"Ve con estos señores.","en":"Go with these men.","audio":"https://tatoeba.org/en/audio/download/443361"},{"text":"Detén a esa señora.","en":"Stop that woman.","audio":"https://tatoeba.org/en/audio/download/424959"},{"text":"\"¿Las bebidas son gratis?\" \"Solo para las señoras.\"","en":"\"Are the drinks free?\" \"Only for ladies.\""},{"text":"¿El señor es médico?","en":"Are you a doctor, sir?","audio":"https://tatoeba.org/en/audio/download/455317"}]}