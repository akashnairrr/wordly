{"id":"sen_or","lemma":"señor","pos":"noun","rank":85,"glosses":["mister, sir, lord (title conferred on a married or older male)","gentleman","master"],"ipa":"/seˈɲoɾ/","gender":"m","forms":{"plural":"señores","feminine":"señora","femininePlural":"señoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1or.wav","formAudio":{"señora":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1ora.wav"},"examples":[{"text":"¿El señor es médico?","en":"Are you a doctor, sir?","audio":"https://tatoeba.org/en/audio/download/455317","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"doctor"}]},{"text":"¿Cuál es su nombre, señor?","en":"What is your name, sir?","audio":"https://tatoeba.org/en/audio/download/78266","words":[null,null,null,null,null],"phrases":[[0,4,"what is your name?"]]},{"text":"Puede irse ahora, señor.","en":"You can go now, sir.","audio":"https://tatoeba.org/en/audio/download/453560","words":[{"g":"to be able to, can","l":"poder"},{"g":"to go","l":"ir"},{"g":"now"},null]},{"text":"No puedo hacer eso, señor.","en":"I can't do that, sir.","audio":"https://tatoeba.org/en/audio/download/455231","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"that","l":"ése"},null]},{"text":"Estoy buscando trabajo, señor.","en":"I am looking for a job, sir.","audio":"https://tatoeba.org/en/audio/download/35804","words":[{"g":"to be","l":"estar"},{"g":"to seek","l":"buscar"},{"g":"work, job"},null]}]}