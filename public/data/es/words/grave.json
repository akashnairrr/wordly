{"id":"grave","lemma":"grave","pos":"adj","rank":1130,"glosses":["serious, grave","bass (sound)","solemn"],"ipa":"/ˈɡɾabe/","forms":{"femininePlural":"graves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Marreromarco-grave.wav","examples":[{"text":"No es nada grave.","en":"It's nothing serious.","audio":"https://tatoeba.org/en/audio/download/453220"},{"text":"Tenemos problemas más graves que atender.","en":"We've got much bigger problems to deal with.","audio":"https://tatoeba.org/en/audio/download/769715"},{"text":"Esto es grave, Tom.","en":"This is serious, Tom.","audio":"https://tatoeba.org/en/audio/download/800863"},{"text":"Estás en graves apuros.","en":"You are in very serious trouble."},{"text":"Esto es muy grave.","en":"This is very serious.","audio":"https://tatoeba.org/en/audio/download/454807"}]}