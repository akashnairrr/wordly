{"id":"chaqueta","lemma":"chaqueta","pos":"noun","rank":1495,"glosses":["jacket, piece of clothing worn on the upper body outside a shirt or blouse, often waist length to thigh length"],"ipa":"/t͡ʃaˈketa/","gender":"f","forms":{"plural":"chaquetas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-AdrianAbdulBaha-chaqueta.wav","examples":[{"text":"La chaqueta me queda grande.","en":"The jacket's big on me.","audio":"https://tatoeba.org/en/audio/download/690976","words":[{"g":"the / her"},null,{"g":"me"},{"g":"curfew"},{"g":"big, large"}]},{"text":"Necesito una chaqueta nueva.","en":"I need a new jacket.","audio":"https://tatoeba.org/en/audio/download/1252992","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null,{"g":"news, novelty"}]},{"text":"Quiero comprar esta chaqueta.","en":"I want to buy this jacket.","audio":"https://tatoeba.org/en/audio/download/582430","words":[{"g":"to desire","l":"querer"},{"g":"to buy"},{"g":"this","l":"este"},null]},{"text":"No podemos encontrar nuestras chaquetas.","en":"We can't find our jackets.","words":[{"g":"no / not"},{"g":"to prune","l":"podar"},{"g":"to meet"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"Mi chaqueta está en el auto.","en":"My jacket's in the car.","audio":"https://tatoeba.org/en/audio/download/460576","words":[{"g":"my"},null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},{"g":"a public deed or…"}]}]}