{"id":"roto","lemma":"roto","pos":"adj","rank":1062,"glosses":["broken","corrupt, rotten","vulgar, low-class, classless"],"ipa":"/ˈroto/","forms":{"feminine":"rota","masculinePlural":"rotos","femininePlural":"rotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Marreromarco-roto.wav","formAudio":{"rota":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Marreromarco-rota.wav"},"examples":[{"text":"El bolígrafo está roto.","en":"The pen is broken.","audio":"https://tatoeba.org/en/audio/download/524809"},{"text":"La caja está rota.","en":"The box is broken.","audio":"https://tatoeba.org/en/audio/download/450107"},{"text":"¿Tienes los dedos rotos?","en":"Are your fingers broken?","audio":"https://tatoeba.org/en/audio/download/616283"},{"text":"Mis gafas de sol están rotas.","en":"My sunglasses are broken."},{"text":"Mi cuchillo está roto.","en":"My knife is broken.","audio":"https://tatoeba.org/en/audio/download/40513"}]}