{"id":"afortunado","lemma":"afortunado","pos":"adj","rank":1950,"glosses":["lucky, fortunate"],"ipa":"/afoɾtuˈnado/","forms":{"feminine":"afortunada","masculinePlural":"afortunados","femininePlural":"afortunadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b7/LL-Q1321_%28spa%29-Marreromarco-afortunado.wav","examples":[{"text":"Tom se sintió afortunado.","en":"Tom felt lucky.","audio":"https://tatoeba.org/en/audio/download/128130"},{"text":"Eres una chica afortunada.","en":"You're a lucky girl.","audio":"https://tatoeba.org/en/audio/download/455069"},{"text":"Somos muy afortunados de tenerlos.","en":"We're very lucky to have them.","audio":"https://tatoeba.org/en/audio/download/1086547"},{"text":"Estas personas fueron muy afortunadas.","en":"These people were very lucky."},{"text":"¿Quién es el afortunado?","en":"Who's the lucky one?","audio":"https://tatoeba.org/en/audio/download/453430"}]}