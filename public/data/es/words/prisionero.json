{"id":"prisionero","lemma":"prisionero","pos":"noun","rank":1926,"glosses":["prisoner"],"ipa":"/pɾisjoˈneɾo/","gender":"m","forms":{"plural":"prisioneros","feminine":"prisionera","femininePlural":"prisioneras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Marreromarco-prisionero.wav","examples":[{"text":"Tom es mi prisionero.","en":"Tom is my prisoner.","audio":"https://tatoeba.org/en/audio/download/799522"},{"text":"Los prisioneros fueron liberados.","en":"The prisoners were set free.","audio":"https://tatoeba.org/en/audio/download/330747"},{"text":"El prisionero fue liberado.","en":"The prisoner was released.","audio":"https://tatoeba.org/en/audio/download/639156"},{"text":"Los prisioneros intentaron escaparse.","en":"The prisoners tried to escape.","audio":"https://tatoeba.org/en/audio/download/355393"},{"text":"Ellos liberaron al prisionero.","en":"They released the prisoner.","audio":"https://tatoeba.org/en/audio/download/788396"}]}