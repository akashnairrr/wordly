{"id":"vergonzoso","lemma":"vergonzoso","pos":"adj","rank":3065,"glosses":["shameful","shy, bashful"],"ipa":"/beɾɡonˈθoso/","forms":{"feminine":"vergonzosa","masculinePlural":"vergonzosos","femininePlural":"vergonzosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Marreromarco-vergonzoso.wav","examples":[{"text":"Puede ser vergonzoso.","en":"It can be embarrassing.","audio":"https://tatoeba.org/en/audio/download/459940","words":[{"g":"to be able to, can","l":"poder"},{"g":"to be"},null]},{"text":"Tu comportamiento fue vergonzoso.","en":"Your behavior was shameful.","audio":"https://tatoeba.org/en/audio/download/516358","words":[{"g":"your"},{"g":"behavior"},{"g":"to be","l":"ser"},null]},{"text":"Tu conducta es absolutamente vergonzosa.","en":"Your conduct is absolutely shameful.","audio":"https://tatoeba.org/en/audio/download/734764","words":[{"g":"your"},{"g":"behaviour, conduct"},{"g":"to be","l":"ser"},{"g":"absolutely"},null]},{"text":"No digas nada vergonzoso, por favor.","en":"Please don't say anything embarrassing.","words":[{"g":"no / not"},{"g":"to say","l":"decir"},{"g":"nothing"},null,null,null],"phrases":[[4,6,"please"]]},{"text":"Qué vergonzoso para todos nosotros.","en":"How embarrassing for us all.","words":[{"g":"what"},null,{"g":"for"},{"g":"all","l":"todo"},{"g":"we"}]}]}