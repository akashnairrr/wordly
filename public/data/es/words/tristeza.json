{"id":"tristeza","lemma":"tristeza","pos":"noun","rank":2740,"glosses":["sadness, gloom, sorrow, gloominess, unhappiness, misery","tristeza (plant disease)"],"ipa":"/tɾisˈteθa/","gender":"f","forms":{"plural":"tristezas"},"order":2746,"audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Marreromarco-tristeza.wav","examples":[{"text":"Sus ojos estaban llenos de tristeza.","en":"Her eyes were full of sadness.","audio":"https://tatoeba.org/en/audio/download/641955","words":[{"g":"his, her, its, their"},{"g":"eye","l":"ojo"},{"g":"to be","l":"estar"},{"g":"full","l":"lleno"},{"g":"of / from"},null]},{"text":"Ella me miró con tristeza.","en":"She looked sadly at me.","audio":"https://tatoeba.org/en/audio/download/706645","words":[{"g":"she"},{"g":"me"},{"g":"to look at","l":"mirar"},{"g":"with"},null]},{"text":"Me da tristeza escucharlo.","en":"I am sad to hear it.","audio":"https://tatoeba.org/en/audio/download/449914","words":[{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"to listen to","l":"escuchar"}]}]}