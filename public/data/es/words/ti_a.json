{"id":"ti_a","lemma":"tía","pos":"noun","rank":676,"glosses":["girl, woman, chick"],"ipa":"/ˈtia/","gender":"f","forms":{"plural":"tías","masculine":"tío","masculinePlural":"tíos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADa.wav","formAudio":{"tío":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADo.wav"},"examples":[{"text":"¿Qué hace tu tía?","en":"What does your aunt do?","audio":"https://tatoeba.org/en/audio/download/459459","words":[{"g":"what"},{"g":"to do","l":"hacer"},{"g":"your"},null]},{"text":"Mi tía parece joven.","en":"My aunt looks young.","audio":"https://tatoeba.org/en/audio/download/449826","words":[{"g":"my"},null,{"g":"to seem, to see fit","l":"parecer"},{"g":"young, youthful"}]},{"text":"Mi tía tenía tres hijos.","en":"My aunt had three kids.","audio":"https://tatoeba.org/en/audio/download/460530","words":[{"g":"my"},null,{"g":"to have","l":"tener"},{"g":"three"},{"g":"son","l":"hijo"}]},{"text":"Mi tía me trajo flores.","en":"My aunt brought me flowers.","audio":"https://tatoeba.org/en/audio/download/526776","words":[{"g":"my"},null,{"g":"me"},{"g":"to bring","l":"traer"},{"g":"flower","l":"flor"}]},{"text":"Mi tía es mayor que mi madre.","en":"My aunt is older than my mother.","audio":"https://tatoeba.org/en/audio/download/537914","words":[{"g":"my"},null,{"g":"to be","l":"ser"},{"g":"of age"},{"g":"that"},{"g":"my"},{"g":"mother"}]}]}