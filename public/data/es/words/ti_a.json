{"id":"ti_a","lemma":"tía","pos":"noun","rank":679,"glosses":["girl, woman, chick"],"ipa":"/ˈtia/","gender":"f","forms":{"plural":"tías","masculine":"tío","masculinePlural":"tíos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADa.wav","formAudio":{"tío":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-t%C3%ADo.wav"},"examples":[{"text":"Mi tía parece joven.","en":"My aunt looks young.","audio":"https://tatoeba.org/en/audio/download/449826"},{"text":"Él tiene dos tías de parte materna.","en":"He has two aunts on his mother's side."},{"text":"Él es mi tío.","en":"He is my uncle.","audio":"https://tatoeba.org/en/audio/download/68265"},{"text":"Tom tiene tres tíos.","en":"Tom has three uncles."},{"text":"Su tía parece joven.","en":"His aunt looks young.","audio":"https://tatoeba.org/en/audio/download/636660"}]}