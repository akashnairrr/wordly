{"id":"zapato","lemma":"zapato","pos":"noun","rank":806,"glosses":["shoe"],"ipa":"/θaˈpato/","gender":"m","forms":{"plural":"zapatos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q1321_%28spa%29-Rodrigo5260-zapato.wav","formAudio":{"zapatos":"https://upload.wikimedia.org/wikipedia/commons/1/17/LL-Q1321_%28spa%29-Eavqwiki-zapatos.wav"},"examples":[{"text":"El perro se comió mi zapato.","en":"The dog ate my shoe.","audio":"https://tatoeba.org/en/audio/download/636490"},{"text":"Él usaba zapatos viejos.","en":"He wore old shoes.","audio":"https://tatoeba.org/en/audio/download/443888"},{"text":"Perdí mi zapato en el incendio.","en":"I lost my shoe in the fire.","audio":"https://tatoeba.org/en/audio/download/937774"},{"text":"Mis zapatos han desaparecido.","en":"My shoes are gone.","audio":"https://tatoeba.org/en/audio/download/73788"},{"text":"Se me ha metido una china en el zapato.","en":"I have a pebble in my shoe.","audio":"https://tatoeba.org/en/audio/download/522051"}]}