{"id":"adivino","lemma":"adivino","pos":"noun","rank":1748,"glosses":["fortune teller, seer","guesser (a person who guesses; especially someone who can make a reasonable prediction from little evidence)"],"ipa":"/adiˈbino/","gender":"m","forms":{"plural":"adivinos","feminine":"adivina","femininePlural":"adivinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q1321_%28spa%29-Marreromarco-adivino.wav","formAudio":{"adivina":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Emanuelps27-adivina.wav"},"examples":[{"text":"Adivina qué me pasó.","en":"Guess what happened to me.","audio":"https://tatoeba.org/en/audio/download/735546"},{"text":"¿No adivinas lo que estoy haciendo?","en":"Can't you guess what I'm doing?","audio":"https://tatoeba.org/en/audio/download/355102"},{"text":"Adivina lo que me dijo.","en":"Guess what he told me.","audio":"https://tatoeba.org/en/audio/download/70191"},{"text":"¿Adivinas de qué quiero hablarte?","en":"Can you guess what I want to talk to you about?"},{"text":"Adivina a quién vi hoy.","en":"Guess who I saw today.","audio":"https://tatoeba.org/en/audio/download/455414"}]}