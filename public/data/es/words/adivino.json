{"id":"adivino","lemma":"adivino","pos":"noun","rank":1746,"glosses":["fortune teller, seer","guesser (a person who guesses; especially someone who can make a reasonable prediction from little evidence)"],"ipa":"/adiˈbino/","gender":"m","forms":{"plural":"adivinos","feminine":"adivina","femininePlural":"adivinas"},"order":1790,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q1321_%28spa%29-Marreromarco-adivino.wav","formAudio":{"adivina":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Emanuelps27-adivina.wav"},"examples":[{"text":"Adivina qué me pasó.","en":"Guess what happened to me.","audio":"https://tatoeba.org/en/audio/download/735546","words":[null,{"g":"what"},{"g":"me"},{"g":"to pass","l":"pasar"}]},{"text":"Adivina qué tengo en la mano.","en":"Guess what I'm holding in my hand.","audio":"https://tatoeba.org/en/audio/download/352446","words":[null,{"g":"what"},{"g":"to have","l":"tener"},{"g":"in / on"},{"g":"the / her"},{"g":"hand"}]},{"text":"¿No adivinas lo que estoy haciendo?","en":"Can't you guess what I'm doing?","audio":"https://tatoeba.org/en/audio/download/355102","words":[{"g":"no / not"},null,null,null,{"g":"to be","l":"estar"},{"g":"to do","l":"hacer"}],"phrases":[[2,4,"what, that which"]]}]}