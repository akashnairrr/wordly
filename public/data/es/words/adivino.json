{"id":"adivino","lemma":"adivino","pos":"noun","rank":1745,"glosses":["fortune teller, seer","guesser (a person who guesses; especially someone who can make a reasonable prediction from little evidence)"],"ipa":"/adiˈbino/","gender":"m","forms":{"plural":"adivinos","feminine":"adivina","femininePlural":"adivinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q1321_%28spa%29-Marreromarco-adivino.wav","formAudio":{"adivina":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Emanuelps27-adivina.wav"},"examples":[{"text":"Adivina lo que me dijo.","en":"Guess what he told me.","audio":"https://tatoeba.org/en/audio/download/70191","words":[null,null,null,{"g":"me"},{"g":"to say","l":"decir"}],"phrases":[[1,3,"what, that which"]]},{"text":"¿No adivinas lo que estoy haciendo?","en":"Can't you guess what I'm doing?","audio":"https://tatoeba.org/en/audio/download/355102","words":[{"g":"no / not"},null,null,null,{"g":"to be","l":"estar"},{"g":"to do","l":"hacer"}],"phrases":[[2,4,"what, that which"]]},{"text":"Adivina qué me pasó.","en":"Guess what happened to me.","audio":"https://tatoeba.org/en/audio/download/735546","words":[null,{"g":"what"},{"g":"me"},{"g":"to pass","l":"pasar"}]},{"text":"Adivina quién soy.","en":"Guess who I am.","audio":"https://tatoeba.org/en/audio/download/821235","words":[null,{"g":"who"},{"g":"to be","l":"ser"}]},{"text":"¡Apuesto que no adivinas lo que me sucedió hoy!","en":"I'll bet you can't guess what happened to me today.","words":[{"g":"handsome, good-looking"},{"g":"that"},{"g":"no / not"},null,null,null,{"g":"me"},{"g":"to happen","l":"suceder"},{"g":"today, tonight"}],"phrases":[[4,6,"what, that which"]]}]}