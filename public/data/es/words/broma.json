{"id":"broma","lemma":"broma","pos":"noun","rank":621,"glosses":["joke, prank, practical joke","banter (plural)","shipworm"],"ipa":"/ˈbɾoma/","gender":"f","forms":{"plural":"bromas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-broma.wav","examples":[{"text":"No es una broma.","en":"It's no joke.","audio":"https://tatoeba.org/en/audio/download/438066"},{"text":"Me encantan las bromas.","en":"I love practical jokes.","audio":"https://tatoeba.org/en/audio/download/519226"},{"text":"No es ninguna broma.","en":"It is no joke.","audio":"https://tatoeba.org/en/audio/download/441837"},{"text":"Nunca entiendes mis bromas.","en":"You never get my jokes.","audio":"https://tatoeba.org/en/audio/download/831495"},{"text":"¿Es esto una broma?","en":"Is this a hoax?","audio":"https://tatoeba.org/en/audio/download/441072"}]}