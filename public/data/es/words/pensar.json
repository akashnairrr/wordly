{"id":"pensar","lemma":"pensar","pos":"verb","rank":203,"glosses":["to think, ponder","to reflect, think through","to think of, think that (have an opinion on)"],"ipa":"/penˈsaɾ/","conjugation":{"indicative":{"present":{"1s":"pienso","2s":"piensas","3s":"piensa","1p":"pensamos","2p":"pensáis","3p":"piensan"},"imperfect":{"1s":"pensaba","2s":"pensabas","3s":"pensaba","1p":"pensábamos","2p":"pensabais","3p":"pensaban"},"preterite":{"1s":"pensé","2s":"pensaste","3s":"pensó","1p":"pensamos","2p":"pensasteis","3p":"pensaron"},"future":{"1s":"pensaré","2s":"pensarás","3s":"pensará","1p":"pensaremos","2p":"pensaréis","3p":"pensarán"},"conditional":{"1s":"pensaría","2s":"pensarías","3s":"pensaría","1p":"pensaríamos","2p":"pensaríais","3p":"pensarían"}},"subjunctive":{"present":{"1s":"piense","2s":"pienses","3s":"piense","1p":"pensemos","2p":"penséis","3p":"piensen"},"imperfect":{"1s":"pensara","2s":"pensaras","3s":"pensara","1p":"pensáramos","2p":"pensarais","3p":"pensaran"}},"imperative":{"affirmative":{"2s":"piensa","3s":"piense","1p":"pensemos","2p":"pensad","3p":"piensen"},"negative":{"2s":"pienses","3s":"piense","1p":"pensemos","2p":"penséis","3p":"piensen"}}},"nonFinite":{"gerund":"pensando","participle":"pensado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q1321_%28spa%29-Rodelar-pensar.wav","examples":[{"text":"¡Dejadme pensar un minuto!","en":"Let me think a minute.","audio":"https://tatoeba.org/en/audio/download/100971"},{"text":"Estoy pensando en ti.","en":"I'm thinking of you.","audio":"https://tatoeba.org/en/audio/download/449952"},{"text":"He pensado en ti.","en":"I thought about you.","audio":"https://tatoeba.org/en/audio/download/525517"},{"text":"Yo pienso que puedo.","en":"I think I can.","audio":"https://tatoeba.org/en/audio/download/440519"},{"text":"Di lo que piensas.","en":"Speak your mind.","audio":"https://tatoeba.org/en/audio/download/519185"}]}