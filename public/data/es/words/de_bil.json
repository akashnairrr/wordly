{"id":"de_bil","lemma":"débil","pos":"adj","rank":1238,"glosses":["weak"],"ipa":"/ˈdebil/","forms":{"femininePlural":"débiles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5e/LL-Q1321_%28spa%29-AdrianAbdulBaha-d%C3%A9bil.wav","examples":[{"text":"Ella es demasiado débil.","en":"She is too weak.","audio":"https://tatoeba.org/en/audio/download/442066"},{"text":"Mis piernas son débiles.","en":"My legs are weak.","audio":"https://tatoeba.org/en/audio/download/734500"},{"text":"Mi pulso es débil.","en":"My pulse is slow.","audio":"https://tatoeba.org/en/audio/download/556813"},{"text":"El guerrero conoce sus puntos fuertes y débiles.","en":"The warrior is conscious of both his strength and his weakness.","audio":"https://tatoeba.org/en/audio/download/704256"},{"text":"Es un poco débil.","en":"It's a bit flimsy.","audio":"https://tatoeba.org/en/audio/download/800229"}]}