{"id":"mundo","lemma":"mundo","pos":"noun","rank":126,"glosses":["world, earth (human collective existence)","world, globe (the Earth)","world (planet, especially one which is inhabitable)"],"ipa":"/ˈmundo/","gender":"m","forms":{"plural":"mundos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q1321_%28spa%29-Precision27-mundo.wav","formAudio":{"mundos":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Eavqwiki-mundos.wav"},"examples":[{"text":"Tenemos todo el tiempo del mundo.","en":"We have all the time in the world.","audio":"https://tatoeba.org/en/audio/download/352854","words":[{"g":"to have","l":"tener"},null,null,null,{"g":"of the"},null],"phrases":[[1,4,"all the time, always"]]},{"text":"No soy de este mundo.","en":"I'm not from this world.","audio":"https://tatoeba.org/en/audio/download/639857","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"of / from"},{"g":"this"},null]},{"text":"El mundo es un lugar grande.","en":"The world is a big place.","audio":"https://tatoeba.org/en/audio/download/600206","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"a"},{"g":"place"},{"g":"big, large"}]},{"text":"Eso no ocurre en mi mundo.","en":"That doesn't happen in my world.","audio":"https://tatoeba.org/en/audio/download/831350","words":[{"g":"that","l":"ése"},{"g":"no / not"},{"g":"to happen, to occur","l":"ocurrir"},{"g":"in / on"},{"g":"my"},null]},{"text":"Tengo el mejor trabajo del mundo.","en":"I have the best job in the world.","audio":"https://tatoeba.org/en/audio/download/594710","words":[{"g":"to have","l":"tener"},{"g":"the"},{"g":"better"},{"g":"work, job"},{"g":"of the"},null]}]}