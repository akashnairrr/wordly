{"id":"paso","lemma":"paso","pos":"noun","rank":392,"glosses":["step, footstep","pace (rough distance of a brisk stride)","paso, Spanish pace (a traditional unit of length equivalent to about 1.4 m)"],"ipa":"/ˈpaso/","gender":"m","forms":{"plural":"pasos"},"examples":[{"text":"Es un gran paso.","en":"It's a big step.","audio":"https://tatoeba.org/en/audio/download/441938","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Ahora da un paso atrás.","en":"Now step back.","audio":"https://tatoeba.org/en/audio/download/181000","words":[{"g":"now"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null,{"g":"behind"}]},{"text":"Tienes que aprender paso a paso.","en":"You must learn step by step.","audio":"https://tatoeba.org/en/audio/download/554028","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to learn"},null,{"g":"to"},null]},{"text":"Él escuchó pasos.","en":"He heard footsteps.","words":[{"g":"he"},{"g":"to listen to","l":"escuchar"},null]},{"text":"Paso mi tiempo libre con mis pequeños.","en":"I spend my free time with my kids.","audio":"https://tatoeba.org/en/audio/download/606577","words":[null,{"g":"my"},null,null,{"g":"with"},{"g":"my"},{"g":"small","l":"pequeño"}],"phrases":[[2,4,"free time"]]}]}