{"id":"fi_sico","lemma":"físico","pos":"adj","rank":2339,"glosses":["physical"],"ipa":"/ˈfisiko/","forms":{"feminine":"física","masculinePlural":"físicos","femininePlural":"físicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q1321_%28spa%29-AdrianAbdulBaha-f%C3%ADsico.wav","formAudio":{"física":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-AdrianAbdulBaha-f%C3%ADsica.wav"},"examples":[{"text":"Su padre es físico.","en":"His father is a physicist.","words":[{"g":"his / her / your"},{"g":"father, parent"},{"g":"to be","l":"ser"},null]},{"text":"El contacto físico con niños es muy importante.","en":"Physical contact with a child is very important.","words":[{"g":"the"},{"g":"contact"},null,{"g":"with"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"ser"},null,{"g":"important"}]},{"text":"Los problemas del chico son físicos, no mentales.","en":"The boy's problems are physical, not mental.","words":[{"g":"the / them"},{"g":"problem","l":"problema"},{"g":"of the"},{"g":"boy"},{"g":"to be","l":"ser"},null,{"g":"no / not"},{"g":"mental","l":"mental"}]},{"text":"Él sabe de física.","en":"He understands physics.","audio":"https://tatoeba.org/en/audio/download/461582","words":[{"g":"he"},{"g":"to know, to understand","l":"saber"},{"g":"of / from"},null]},{"text":"Tom es un físico muy elogiado.","en":"Tom is a highly acclaimed physicist.","words":[null,{"g":"to be","l":"ser"},{"g":"a"},null,null,null]}]}