{"id":"cuerda","lemma":"cuerda","pos":"noun","rank":1614,"glosses":["rope, cord, string","chord","string (of a musical stringed instrument)"],"ipa":"/ˈkweɾda/","gender":"f","forms":{"plural":"cuerdas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q1321_%28spa%29-Rodelar-cuerda.wav","examples":[{"text":"Dale cuerda al reloj.","en":"Wind the clock.","audio":"https://tatoeba.org/en/audio/download/441373"},{"text":"Tom desató las cuerdas.","en":"Tom untied the ropes."},{"text":"¿Dónde está la cuerda?","en":"Where's the rope?","audio":"https://tatoeba.org/en/audio/download/512900"},{"text":"Tom compró tres juegos de cuerdas de guitarra.","en":"Tom bought three sets of guitar strings."},{"text":"Mantén tensa la cuerda.","en":"Keep the rope taut.","audio":"https://tatoeba.org/en/audio/download/630274"}]}