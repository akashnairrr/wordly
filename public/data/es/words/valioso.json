{"id":"valioso","lemma":"valioso","pos":"adj","rank":2806,"glosses":["valuable"],"ipa":"/baˈljoso/","forms":{"feminine":"valiosa","masculinePlural":"valiosos","femininePlural":"valiosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-Marreromarco-valioso.wav","examples":[{"text":"Esa fue una experiencia valiosa.","en":"That was a valuable experience.","words":[{"g":"that","l":"ese"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"experience"},null]},{"text":"Ella lleva puesto un valioso anillo.","en":"She is wearing a valuable ring.","words":[{"g":"she"},{"g":"to take somewhere","l":"llevar"},{"g":"put"},{"g":"a"},null,{"g":"ring"}]},{"text":"Nada es más valioso que la salud.","en":"Nothing is more valuable than health.","audio":"https://tatoeba.org/en/audio/download/34493","words":[{"g":"nothing"},null,null,null,{"g":"that"},{"g":"the / her"},{"g":"bless you"}],"phrases":[[1,3,"furthermore"]]},{"text":"Hoy he aprendido una valiosa lección.","en":"Today I've learned a valuable lesson.","words":[{"g":"today, tonight"},{"g":"to have","l":"haber"},{"g":"to learn","l":"aprender"},{"g":"a"},null,{"g":"lesson"}]},{"text":"Ella posee muchos libros valiosos.","en":"She has many valuable books.","audio":"https://tatoeba.org/en/audio/download/526979","words":[{"g":"she"},{"g":"to possess","l":"poseer"},{"g":"much","l":"mucho"},{"g":"book","l":"libro"},null]}]}