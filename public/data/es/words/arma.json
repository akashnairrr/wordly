{"id":"arma","lemma":"arma","pos":"noun","rank":362,"glosses":["weapon, arm"],"ipa":"/ˈaɾma/","gender":"f","forms":{"plural":"armas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-AdrianAbdulBaha-arma.wav","formAudio":{"armas":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Marreromarco-armas.wav"},"examples":[{"text":"Tom tenía un arma.","en":"Tom had a gun.","audio":"https://tatoeba.org/en/audio/download/799408"},{"text":"Portar armas es ilegal.","en":"It's against the law to carry weapons.","audio":"https://tatoeba.org/en/audio/download/519319"},{"text":"Ella disparó un arma.","en":"She shot a gun.","audio":"https://tatoeba.org/en/audio/download/441129"},{"text":"¿Qué clase de armas tenían?","en":"What kind of weapons did they have?","audio":"https://tatoeba.org/en/audio/download/551895"},{"text":"¿Quién tiene el arma?","en":"Who has the gun?","audio":"https://tatoeba.org/en/audio/download/442258"}]}