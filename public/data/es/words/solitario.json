{"id":"solitario","lemma":"solitario","pos":"adj","rank":2081,"glosses":["lonely, solitary","alone"],"ipa":"/soliˈtaɾjo/","forms":{"feminine":"solitaria","masculinePlural":"solitarios","femininePlural":"solitarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-AdrianAbdulBaha-solitario.wav","examples":[{"text":"Soy un hombre solitario.","en":"I'm a lonely man.","audio":"https://tatoeba.org/en/audio/download/442588","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},null]},{"text":"Yo siempre fui una persona solitaria.","en":"I was always a loner.","audio":"https://tatoeba.org/en/audio/download/453554","words":[{"g":"I"},{"g":"always"},{"g":"to go","l":"ir"},{"g":"a"},{"g":"person (an individual"},null]},{"text":"Me encanta jugar al solitario.","en":"I love playing solitaire.","audio":"https://tatoeba.org/en/audio/download/581659","words":[{"g":"me"},{"g":"to charm, to enchant","l":"encantar"},{"g":"to play"},{"g":"to the"},null]},{"text":"Él es muy solitario.","en":"He's very lonely.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,null]},{"text":"Ella vivió una vida solitaria.","en":"She led a solitary life.","words":[{"g":"she"},{"g":"to live","l":"vivir"},{"g":"a"},{"g":"life"},null]}]}