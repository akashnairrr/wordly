{"id":"fabuloso","lemma":"fabuloso","pos":"adj","rank":2407,"glosses":["fable, myth, legend; fabulous (of or relating to fable, myth, or legend)","fabulous (marvelous, extraordinary, incredible)"],"ipa":"/fabuˈloso/","forms":{"feminine":"fabulosa","masculinePlural":"fabulosos","femininePlural":"fabulosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-Emanuelps27-fabuloso.wav","examples":[{"text":"Sé que harás un trabajo fabuloso.","en":"I know you'll do a wonderful job.","audio":"https://tatoeba.org/en/audio/download/515039","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to do","l":"hacer"},{"g":"a"},{"g":"work, job"},null]},{"text":"Esto es fabuloso.","en":"This is really great.","audio":"https://tatoeba.org/en/audio/download/454806","words":[{"g":"this"},{"g":"to be","l":"ser"},null]},{"text":"Hoy es un día fabuloso.","en":"Today is a fabulous day.","words":[{"g":"today, tonight"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"day"},null]},{"text":"Luces fabulosa.","en":"You look fabulous.","audio":"https://tatoeba.org/en/audio/download/450553","words":[{"g":"light","l":"luz"},null]},{"text":"¡Qué tiempo más fabuloso!","en":"What wonderful weather!","audio":"https://tatoeba.org/en/audio/download/1061672","words":[{"g":"what"},{"g":"time"},{"g":"more"},null]}]}