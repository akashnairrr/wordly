{"id":"olor","lemma":"olor","pos":"noun","rank":1340,"glosses":["smell, scent, odor","whiff (i.e. hint)"],"ipa":"/oˈloɾ/","gender":"m","forms":{"plural":"olores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q1321_%28spa%29-AdrianAbdulBaha-olor.wav","examples":[{"text":"¿Qué es ese olor?","en":"What's that smell?","audio":"https://tatoeba.org/en/audio/download/449184","words":[{"g":"what"},{"g":"to be","l":"ser"},{"g":"that"},null]},{"text":"No me importa el olor.","en":"I don't mind the smell.","audio":"https://tatoeba.org/en/audio/download/630047","words":[null,null,null,{"g":"the"},null],"phrases":[[0,3,"I don't care!"]]},{"text":"Ese olor me está poniendo malo.","en":"The smell's making me sick.","audio":"https://tatoeba.org/en/audio/download/191393","words":[{"g":"that"},null,{"g":"me"},{"g":"to be","l":"estar"},{"g":"to put, to place","l":"poner"},{"g":"bad"}]},{"text":"Me gusta el olor de los libros viejos.","en":"I like the smell of old books.","audio":"https://tatoeba.org/en/audio/download/1156792","words":[null,null,{"g":"the"},null,{"g":"of / from"},{"g":"the / them"},{"g":"book","l":"libro"},{"g":"old person","l":"viejo"}],"phrases":[[0,2,"like, thumbs up"]]},{"text":"Me encanta el olor del café por la mañana.","en":"I love the smell of coffee in the morning.","audio":"https://tatoeba.org/en/audio/download/609273","words":[{"g":"me"},{"g":"to charm, to enchant","l":"encantar"},{"g":"the"},null,{"g":"of the"},{"g":"coffee"},{"g":"for / by"},{"g":"the / her"},{"g":"tomorrow"}]}]}