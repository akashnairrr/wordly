{"id":"olor","lemma":"olor","pos":"noun","rank":1340,"glosses":["smell, scent, odor","whiff (i.e. hint)"],"ipa":"/oˈloɾ/","gender":"m","forms":{"plural":"olores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q1321_%28spa%29-AdrianAbdulBaha-olor.wav","examples":[{"text":"¿Qué es ese olor?","en":"What's that smell?","audio":"https://tatoeba.org/en/audio/download/449184","words":[{"g":"what"},{"g":"to be","l":"ser"},{"g":"that"},null]},{"text":"No me importa el olor.","en":"I don't mind the smell.","audio":"https://tatoeba.org/en/audio/download/630047","words":[null,null,null,{"g":"the"},null],"phrases":[[0,3,"I don't care!"]]},{"text":"Sé lo que es ese olor.","en":"I know what that smell is.","words":[{"g":"to know, to understand","l":"saber"},null,null,{"g":"to be","l":"ser"},{"g":"that"},null],"phrases":[[1,3,"what, that which"]]},{"text":"Ese olor me está poniendo malo.","en":"The smell's making me sick.","audio":"https://tatoeba.org/en/audio/download/191393","words":[{"g":"that"},null,{"g":"me"},{"g":"to be","l":"estar"},{"g":"to put, to place","l":"poner"},{"g":"bad"}]},{"text":"Esta leche tiene un olor extraño.","en":"This milk has a peculiar smell.","words":[{"g":"this","l":"este"},{"g":"milk"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"strange"}]}]}