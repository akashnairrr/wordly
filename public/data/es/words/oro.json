{"id":"oro","lemma":"oro","pos":"noun","rank":659,"glosses":["gold.","or","A suit in a Spanish deck of cards."],"ipa":"/ˈoɾo/","gender":"m","forms":{"plural":"oros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Millars-oro.wav","examples":[{"text":"El tiempo es oro.","en":"Time is money.","audio":"https://tatoeba.org/en/audio/download/501210"},{"text":"¿Es de oro puro?","en":"Is that pure gold?","audio":"https://tatoeba.org/en/audio/download/444244"},{"text":"El silencio es oro.","en":"Silence is golden.","audio":"https://tatoeba.org/en/audio/download/444348"},{"text":"El silencio vale oro.","en":"Silence is golden.","audio":"https://tatoeba.org/en/audio/download/444460"},{"text":"Fuimos a buscar oro.","en":"We went in search of gold.","audio":"https://tatoeba.org/en/audio/download/587247"}]}