{"id":"copa","lemma":"copa","pos":"noun","rank":952,"glosses":["stemmed glass, glass, goblet or its content","cocktail, drink","crown, treetop"],"ipa":"/ˈkopa/","gender":"f","forms":{"plural":"copas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-AdrianAbdulBaha-copa.wav","examples":[{"text":"La copa se quebró.","en":"The cup broke.","audio":"https://tatoeba.org/en/audio/download/501228"},{"text":"Quiero unas cuantas copas vacías.","en":"I want a few empty glasses.","audio":"https://tatoeba.org/en/audio/download/527343"},{"text":"Tomaré una copa de champaña.","en":"I'll take a glass of champagne.","audio":"https://tatoeba.org/en/audio/download/586747"},{"text":"Sólo tomé dos copas de vino.","en":"I only had two glasses of wine.","audio":"https://tatoeba.org/en/audio/download/557780"},{"text":"¿Te gustaría una copa de vino?","en":"Would you like a glass of wine?","audio":"https://tatoeba.org/en/audio/download/598982"}]}