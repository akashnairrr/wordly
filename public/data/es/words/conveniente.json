{"id":"conveniente","lemma":"conveniente","pos":"adj","rank":3226,"glosses":["convenient","opportune, suitable"],"ipa":"/kombeˈnjente/","forms":{"femininePlural":"convenientes"},"examples":[{"text":"Haz el trabajo como creas conveniente.","en":"Do the job as you see fit.","audio":"https://tatoeba.org/en/audio/download/553977","words":[{"g":"to do","l":"hacer"},{"g":"the"},{"g":"work, job"},{"g":"as"},{"g":"to create","l":"crear"},null]},{"text":"Es mucho más conveniente.","en":"It's much more convenient.","words":[{"g":"to be","l":"ser"},{"g":"much"},{"g":"more"},null]},{"text":"Un teléfono es algo conveniente.","en":"The telephone is a convenience.","words":[{"g":"a"},{"g":"telephone"},{"g":"to be","l":"ser"},{"g":"something, anything"},null]},{"text":"Eso sí es conveniente, ¿no?","en":"That's useful, isn't it?","words":[{"g":"that","l":"ése"},{"g":"yes"},{"g":"to be","l":"ser"},null,{"g":"no / not"}]},{"text":"Por favor, venga cuando lo crea conveniente.","en":"Please come when it is convenient.","audio":"https://tatoeba.org/en/audio/download/929044","words":[null,null,{"g":"A cheer or expression…"},{"g":"when"},{"g":"it / him"},{"g":"to create","l":"crear"},null],"phrases":[[0,2,"please"]]}]}