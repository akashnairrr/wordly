{"id":"sombrero","lemma":"sombrero","pos":"noun","rank":1181,"glosses":["hat","butterfly pea (Clitorea ternatea)"],"ipa":"/somˈbɾeɾo/","gender":"m","forms":{"plural":"sombreros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d4/LL-Q1321_%28spa%29-AdrianAbdulBaha-sombrero.wav","examples":[{"text":"Yo perdí mi sombrero.","en":"I lost my hat.","audio":"https://tatoeba.org/en/audio/download/440324"},{"text":"No me gusta ninguno de estos sombreros.","en":"I don't like any of these hats.","audio":"https://tatoeba.org/en/audio/download/645425"},{"text":"Él no llevaba sombrero.","en":"He had no hat on.","audio":"https://tatoeba.org/en/audio/download/37759"},{"text":"Nos quitamos los sombreros.","en":"We took our hats off."},{"text":"El sombrero es tuyo.","en":"The hat is yours.","audio":"https://tatoeba.org/en/audio/download/444241"}]}