{"id":"millonario","lemma":"millonario","pos":"adj","rank":4021,"glosses":["big money/big-money, millions of","millionaire"],"ipa":"/miʝoˈnaɾjo/","forms":{"feminine":"millonaria","masculinePlural":"millonarios","femininePlural":"millonarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q1321_%28spa%29-Emanuelps27-millonario.wav","examples":[{"text":"Nació pobre, pero murió siendo millonario.","en":"He was born poor, but died a millionaire.","audio":"https://tatoeba.org/en/audio/download/1061632","words":[{"g":"to be born","l":"nacer"},{"g":"poor"},{"g":"but"},{"g":"to die","l":"morir"},{"g":"to be","l":"ser"},null]},{"text":"Desearía ser millonario.","en":"I wish I were a millionaire.","audio":"https://tatoeba.org/en/audio/download/509884","words":[{"g":"to wish","l":"desear"},{"g":"to be"},null]},{"text":"Vive como si fuera millonario.","en":"He lives as if he were a millionaire.","words":[{"g":"to applaud","l":"vivar"},null,null,{"g":"outside, out"},null],"phrases":[[1,3,"as if"]]},{"text":"Yo querría ser millonario.","en":"I'd like to be a millionaire.","audio":"https://tatoeba.org/en/audio/download/524874","words":[{"g":"I"},{"g":"to desire","l":"querer"},{"g":"to be"},null]},{"text":"Piensan que soy millonario.","en":"They think I'm a millionaire.","words":[{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"to be","l":"ser"},null]}]}