{"id":"trago","lemma":"trago","pos":"noun","rank":984,"glosses":["gulp, sip","alcoholic drink; booze","difficulty, problem, issue"],"ipa":"/ˈtɾaɡo/","gender":"m","forms":{"plural":"tragos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-Marreromarco-trago.wav","examples":[{"text":"No me lo trago.","en":"I don't buy it.","audio":"https://tatoeba.org/en/audio/download/440852"},{"text":"No aceptes tragos de extraños.","en":"Don't accept drinks from strangers."},{"text":"¿Qué tal un trago?","en":"How about a drink?","audio":"https://tatoeba.org/en/audio/download/443766"},{"text":"Solo me he tomado dos o tres tragos.","en":"I've only had two or three drinks."},{"text":"¿Quién necesita un trago?","en":"Who needs a drink?","audio":"https://tatoeba.org/en/audio/download/449768"}]}