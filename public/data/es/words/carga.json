{"id":"carga","lemma":"carga","pos":"noun","rank":1109,"glosses":["load","burden","cargo"],"ipa":"/ˈkaɾɡa/","gender":"f","forms":{"plural":"cargas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-AdrianAbdulBaha-carga.wav","examples":[{"text":"Es un barco de carga.","en":"It's a cargo ship.","audio":"https://tatoeba.org/en/audio/download/443865"},{"text":"Me carga ver cine mudo.","en":"I hate silent movies.","audio":"https://tatoeba.org/en/audio/download/454439"},{"text":"Los electrones tienen carga eléctrica negativa.","en":"Electrons have a negative electric charge.","audio":"https://tatoeba.org/en/audio/download/416074"},{"text":"El puente cederá ante una carga tan pesada.","en":"The bridge will give way under such a heavy load.","audio":"https://tatoeba.org/en/audio/download/705566"},{"text":"Tenemos que aligerar la carga.","en":"We have to lighten the load."}]}