{"id":"dejado","lemma":"dejado","pos":"adj","rank":584,"glosses":["sloppy, lax (person)"],"ipa":"/deˈxado/","forms":{"feminine":"dejada","masculinePlural":"dejados","femininePlural":"dejadas"},"examples":[{"text":"¿Quién te ha dejado hacer esto?","en":"Who gave you permission to do this?","audio":"https://tatoeba.org/en/audio/download/611968","words":[{"g":"who"},{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"to do"},{"g":"this"}]},{"text":"¿Quién ha dejado la puerta abierta?","en":"Who left the door open?","audio":"https://tatoeba.org/en/audio/download/459437","words":[{"g":"who"},{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"door"},{"g":"the act of opening"}]},{"text":"Él ha dejado a su familia.","en":"He has left his family.","audio":"https://tatoeba.org/en/audio/download/70150","words":[{"g":"he"},{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"his / her / your"},{"g":"family"}]},{"text":"Alguien se lo habrá dejado ahí.","en":"Someone must've left it there.","audio":"https://tatoeba.org/en/audio/download/422673","words":[{"g":"someone, somebody"},{"g":"oneself"},{"g":"it / him"},{"g":"to have","l":"haber"},null,{"g":"there"}]},{"text":"Él no ha dejado ningún mensaje.","en":"He hasn't left any message.","audio":"https://tatoeba.org/en/audio/download/639134","words":[{"g":"he"},{"g":"no / not"},{"g":"to have","l":"haber"},null,null,{"g":"message"}]}]}