{"id":"pimienta","lemma":"pimienta","pos":"noun","rank":4326,"glosses":["pepper (herb, peppercorns)"],"ipa":"/piˈmjenta/","gender":"f","forms":{"plural":"pimientas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-AdrianAbdulBaha-pimienta.wav","examples":[{"text":"Pon un poco más de pimienta.","en":"Add a little more pepper.","audio":"https://tatoeba.org/en/audio/download/1061948","words":[{"g":"to put, to place","l":"poner"},null,null,{"g":"more"},{"g":"of / from"},null],"phrases":[[1,3,"a bit"]]},{"text":"¿Lo quieres con pimienta?","en":"Do you want pepper on it?","words":[{"g":"it / him"},{"g":"to desire","l":"querer"},{"g":"with"},null]},{"text":"¿Podrías pasarme la pimienta, por favor?","en":"Could you pass me the pepper, please?","audio":"https://tatoeba.org/en/audio/download/608515","words":[{"g":"to be able to, can","l":"poder"},{"g":"to pass","l":"pasar"},{"g":"the / her"},null,null,null],"phrases":[[4,6,"please"]]},{"text":"No pongas tanta pimienta en la sopa.","en":"Don't put so much pepper in the soup.","audio":"https://tatoeba.org/en/audio/download/730398","words":[{"g":"no / not"},{"g":"to put, to place","l":"poner"},{"g":"copy","l":"tanto"},null,{"g":"in / on"},{"g":"the / her"},{"g":"soup"}]},{"text":"Disculpe, ¿podría pasarme la sal y la pimienta?","en":"Excuse me, could you pass me the salt and pepper?","audio":"https://tatoeba.org/en/audio/download/612393","words":[{"g":"excuse me"},{"g":"to be able to, can","l":"poder"},{"g":"to pass","l":"pasar"},{"g":"the / her"},{"g":"salt"},{"g":"and"},{"g":"the / her"},null]}]}