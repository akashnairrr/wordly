{"id":"mama_","lemma":"mamá","pos":"noun","rank":150,"glosses":["mum, mom","a term of affection for a woman"],"ipa":"/maˈma/","gender":"f","forms":{"plural":"mamás","masculine":"papá","masculinePlural":"papás"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-AdrianAbdulBaha-mam%C3%A1.wav","formAudio":{"papá":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q1321_%28spa%29-Marreromarco-pap%C3%A1.wav"},"examples":[{"text":"Quiero a mi mamá.","en":"I love my mom.","audio":"https://tatoeba.org/en/audio/download/440395"},{"text":"Amo a mi papá.","en":"I love my dad.","audio":"https://tatoeba.org/en/audio/download/501365"},{"text":"¿Dónde están tus papás?","en":"Where are your parents?","audio":"https://tatoeba.org/en/audio/download/461832"},{"text":"¡Mamá, estoy en casa!","en":"I'm home, Mom!","audio":"https://tatoeba.org/en/audio/download/636678"},{"text":"Mi papá estaba ocupado.","en":"My father was busy.","audio":"https://tatoeba.org/en/audio/download/450247"}]}