{"id":"sen_ora","lemma":"señora","pos":"noun","rank":218,"glosses":["Ms; a title or form of address for a woman; formerly for a married, divorced, or widowed woman and now commonly for any adult woman regardless of marital status, depending on the region","lady","wife"],"ipa":"/seˈɲoɾa/","gender":"f","forms":{"plural":"señoras","masculine":"señor","masculinePlural":"señores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1ora.wav","formAudio":{"señor":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-se%C3%B1or.wav"},"examples":[{"text":"No conozco a esa señora.","en":"I don't know that lady.","audio":"https://tatoeba.org/en/audio/download/630072","words":[{"g":"no / not"},{"g":"to know","l":"conocer"},{"g":"to"},{"g":"that","l":"ese"},null]},{"text":"¿Quién es la señora del sombrero rojo?","en":"Who's the woman with the red hat?","audio":"https://tatoeba.org/en/audio/download/684590","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"the / her"},null,{"g":"of the"},{"g":"hat"},{"g":"red"}]},{"text":"La señora de allí es mi madre.","en":"That woman over there is my mother.","audio":"https://tatoeba.org/en/audio/download/430153","words":[{"g":"the / her"},null,{"g":"of / from"},{"g":"there"},{"g":"to be","l":"ser"},{"g":"my"},{"g":"mother"}]},{"text":"Por aquí, señora.","en":"Over here, ma'am.","words":[{"g":"for / by"},{"g":"here"},null]},{"text":"¿Cuál es su nombre, señor?","en":"What is your name, sir?","audio":"https://tatoeba.org/en/audio/download/78266","words":[null,null,null,null,null],"phrases":[[0,4,"what is your name?"]]}]}