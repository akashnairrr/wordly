{"id":"robo","lemma":"robo","pos":"noun","rank":1059,"glosses":["robbery, theft"],"ipa":"/ˈrobo/","gender":"m","forms":{"plural":"robos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q1321_%28spa%29-Marreromarco-robo.wav","examples":[{"text":"¿Cómo denuncio un robo?","en":"How do I report a theft?","audio":"https://tatoeba.org/en/audio/download/70201"},{"text":"Hemos tenido tres robos sin resolver.","en":"We've got three unsolved burglaries.","audio":"https://tatoeba.org/en/audio/download/803623"},{"text":"A veces robo cosas.","en":"I sometimes steal stuff.","audio":"https://tatoeba.org/en/audio/download/518641"},{"text":"Ha habido una oleada de robos en mi vecindario.","en":"There has been a rash of burglaries in my neighborhood.","audio":"https://tatoeba.org/en/audio/download/691624"},{"text":"Ha habido un robo.","en":"There's been a burglary.","audio":"https://tatoeba.org/en/audio/download/803622"}]}