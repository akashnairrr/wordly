{"id":"conmigo","lemma":"conmigo","pos":"adv","rank":160,"glosses":["with me","with myself"],"ipa":"/komˈmiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Rodrigo5260-conmigo.wav","examples":[{"text":"No seas irrespetuoso conmigo.","en":"Don't sass me.","audio":"https://tatoeba.org/en/audio/download/440137"},{"text":"Él es amable conmigo.","en":"He's kind to me.","audio":"https://tatoeba.org/en/audio/download/40519"},{"text":"Reúnete conmigo esta noche.","en":"Meet me tonight.","audio":"https://tatoeba.org/en/audio/download/441965"},{"text":"Yo hablo conmigo mismo.","en":"I talk to myself.","audio":"https://tatoeba.org/en/audio/download/442640"},{"text":"Ella está enfadada conmigo.","en":"She is mad at me.","audio":"https://tatoeba.org/en/audio/download/442880"}]}