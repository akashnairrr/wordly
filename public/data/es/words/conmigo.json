{"id":"conmigo","lemma":"conmigo","pos":"adv","rank":158,"glosses":["with me","with myself"],"ipa":"/komˈmiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/22/LL-Q1321_%28spa%29-Rodrigo5260-conmigo.wav","examples":[{"text":"¿Tienes algún problema conmigo?","en":"Do you have a problem with me?","audio":"https://tatoeba.org/en/audio/download/333779","words":[{"g":"to have","l":"tener"},null,{"g":"problem"},null]},{"text":"Ahora ven conmigo.","en":"Come with me now.","audio":"https://tatoeba.org/en/audio/download/78804","words":[{"g":"now"},{"g":"to come","l":"venir"},null]},{"text":"Puedes vivir conmigo.","en":"You can live with me.","audio":"https://tatoeba.org/en/audio/download/454986","words":[{"g":"to be able to, can","l":"poder"},{"g":"to live"},null]},{"text":"¿No te gusta jugar conmigo?","en":"Don't you like playing with me?","audio":"https://tatoeba.org/en/audio/download/1152341","words":[{"g":"no / not"},{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"to play"},null]},{"text":"¿Todavía quieres hablar conmigo?","en":"Do you still want to talk to me?","audio":"https://tatoeba.org/en/audio/download/512891","words":[{"g":"still, yet"},{"g":"to desire","l":"querer"},{"g":"to talk"},null]}]}