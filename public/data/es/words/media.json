{"id":"media","lemma":"media","pos":"noun","rank":622,"glosses":["half (one of two equal parts of any whole)","synonym of cuarto, half-fanega (a traditional unit of dry measure equivalent to about 27.8 L)","stocking (long thin leggings worn by women)"],"ipa":"/ˈmedja/","gender":"f","forms":{"plural":"medias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/21/LL-Q1321_%28spa%29-AdrianAbdulBaha-media.wav","examples":[{"text":"Estará aquí en media hora.","en":"He will be here in half an hour.","audio":"https://tatoeba.org/en/audio/download/354570","words":[{"g":"to be","l":"estar"},{"g":"here"},{"g":"in / on"},null,{"g":"hour"}]},{"text":"El trabajo está a medias.","en":"The job is half done.","audio":"https://tatoeba.org/en/audio/download/68508","words":[{"g":"the"},{"g":"work, job"},{"g":"to be","l":"estar"},{"g":"to"},null]},{"text":"Ella me hizo esperar media hora.","en":"She made me wait for half an hour.","audio":"https://tatoeba.org/en/audio/download/352745","words":[{"g":"she"},{"g":"me"},{"g":"to do","l":"hacer"},{"g":"to hope"},null,{"g":"hour"}]},{"text":"No dejes tu trabajo a medias.","en":"Don't leave your work half done.","audio":"https://tatoeba.org/en/audio/download/354748","words":[{"g":"no / not"},{"g":"to leave","l":"dejar"},{"g":"your"},{"g":"work, job"},{"g":"to"},null]},{"text":"Por favor, espera media hora.","en":"Please wait half an hour.","audio":"https://tatoeba.org/en/audio/download/45957","words":[null,null,{"g":"wait"},null,{"g":"hour"}],"phrases":[[0,2,"please"]]}]}