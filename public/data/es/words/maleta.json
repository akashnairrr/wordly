{"id":"maleta","lemma":"maleta","pos":"noun","rank":1881,"glosses":["suitcase (large piece of luggage)","schoolbag","trunk, boot (of a car)"],"ipa":"/maˈleta/","gender":"f","forms":{"plural":"maletas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2f/LL-Q1321_%28spa%29-AdrianAbdulBaha-maleta.wav","examples":[{"text":"Esa es mi maleta.","en":"That's my suitcase.","audio":"https://tatoeba.org/en/audio/download/799810"},{"text":"¿Dónde están tus maletas?","en":"Where are your suitcases?","audio":"https://tatoeba.org/en/audio/download/515225"},{"text":"Déjame cargar tu maleta.","en":"Let me carry your bag.","audio":"https://tatoeba.org/en/audio/download/462030"},{"text":"¿Tiene usted más maletas?","en":"Do you have more suitcases?","audio":"https://tatoeba.org/en/audio/download/765516"},{"text":"Mi maleta está rota.","en":"My suitcase is broken.","audio":"https://tatoeba.org/en/audio/download/460476"}]}