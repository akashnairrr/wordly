{"id":"despejado","lemma":"despejado","pos":"adj","rank":2154,"glosses":["clear, all-clear (free of obstacles)","clear (free of clouds)"],"ipa":"/despeˈxado/","forms":{"feminine":"despejada","masculinePlural":"despejados","femininePlural":"despejadas"},"examples":[{"text":"Es un día despejado.","en":"It's a clear day.","audio":"https://tatoeba.org/en/audio/download/1187424","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"day"},null]},{"text":"El cielo está despejado.","en":"The sky is clear.","audio":"https://tatoeba.org/en/audio/download/444248","words":[{"g":"the"},{"g":"sky"},{"g":"to be","l":"estar"},null]},{"text":"El cielo está despejado casi todos los días.","en":"The sky is clear almost every day.","audio":"https://tatoeba.org/en/audio/download/687237","words":[{"g":"the"},{"g":"sky"},{"g":"to be","l":"estar"},null,{"g":"almost"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"day","l":"día"}]},{"text":"Cuando salí, estaba despejado.","en":"The sky was clear when I left home.","words":[{"g":"when"},{"g":"to go out","l":"salir"},{"g":"to be","l":"estar"},null]},{"text":"La policía ha despejado la plaza.","en":"The police have cleared the square.","words":[{"g":"the / her"},{"g":"Civility"},{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"plaza, town square"}]}]}