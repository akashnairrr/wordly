{"id":"mirada","lemma":"mirada","pos":"noun","rank":1153,"glosses":["look, glance"],"ipa":"/miˈɾada/","gender":"f","forms":{"plural":"miradas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Marreromarco-mirada.wav","examples":[{"text":"Su mirada expresaba su alegría.","en":"Her look expressed her joy.","audio":"https://tatoeba.org/en/audio/download/639618"},{"text":"Las miradas se cruzaron.","en":"Their eyes met.","audio":"https://tatoeba.org/en/audio/download/441082"},{"text":"Ella fijó su mirada en mí.","en":"She stared at me.","audio":"https://tatoeba.org/en/audio/download/442969"},{"text":"Si las miradas matasen, yo ya estaría muerto.","en":"If looks could kill, I'd be dead by now.","audio":"https://tatoeba.org/en/audio/download/688955"},{"text":"Ella fijó la mirada en mí.","en":"She stared at me.","audio":"https://tatoeba.org/en/audio/download/442970"}]}