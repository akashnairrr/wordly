{"id":"mirada","lemma":"mirada","pos":"noun","rank":1151,"glosses":["look, glance"],"ipa":"/miˈɾada/","gender":"f","forms":{"plural":"miradas"},"order":1245,"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Marreromarco-mirada.wav","examples":[{"text":"Su mirada te dice que te ama.","en":"Her look says that she loves you.","words":[{"g":"his / her / your"},null,{"g":"you"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"you"},{"g":"lady of the house"}]},{"text":"Echa una mirada a tu alrededor.","en":"Take a look around you.","audio":"https://tatoeba.org/en/audio/download/461610","words":[{"g":"to throw","l":"echar"},{"g":"a"},null,{"g":"to"},{"g":"your"},{"g":"around"}]},{"text":"¡Papá, juega conmigo a las miradas!","en":"Daddy, let's have a staring contest.","words":[{"g":"dad"},{"g":"to play","l":"jugar"},{"g":"with me"},{"g":"to"},{"g":"the / them"},null]}]}