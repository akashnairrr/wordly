{"id":"directamente","lemma":"directamente","pos":"adv","rank":1121,"glosses":["directly, firsthand","outright"],"ipa":"/diˌɾeɡtaˈmente/","order":1219,"examples":[{"text":"Obtuve la información directamente de él.","en":"I got the information from him directly.","audio":"https://tatoeba.org/en/audio/download/689404","words":[{"g":"to obtain","l":"obtener"},{"g":"the / her"},{"g":"information, data"},null,{"g":"of / from"},{"g":"he"}]},{"text":"Ella le miró directamente a los ojos.","en":"She looked him right in the eye.","audio":"https://tatoeba.org/en/audio/download/354106","words":[{"g":"she"},{"g":"him / her"},{"g":"to look at","l":"mirar"},null,{"g":"to"},{"g":"the / them"},{"g":"eye","l":"ojo"}]},{"text":"Ella se reportará directamente conmigo.","en":"She will report directly to me.","words":[{"g":"she"},{"g":"oneself"},null,null,{"g":"with me"}]}]}