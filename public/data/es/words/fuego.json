{"id":"fuego","lemma":"fuego","pos":"noun","rank":413,"glosses":["fire"],"ipa":"/ˈfweɡo/","gender":"m","forms":{"plural":"fuegos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Rodelar-fuego.wav","examples":[{"text":"El fuego se extinguió.","en":"The fire is out.","audio":"https://tatoeba.org/en/audio/download/442037"},{"text":"¿Son legales los fuegos artificiales en Australia?","en":"Are fireworks legal in Australia?","audio":"https://tatoeba.org/en/audio/download/302425"},{"text":"Fuego a mi orden.","en":"Fire on my command.","audio":"https://tatoeba.org/en/audio/download/799969"},{"text":"Ayer hubo una explosión en la fábrica de fuegos artificiales.","en":"Yesterday, an explosion occurred at the fireworks factory.","audio":"https://tatoeba.org/en/audio/download/77679"},{"text":"Los soldados abrieron fuego.","en":"The soldiers fired.","audio":"https://tatoeba.org/en/audio/download/501301"}]}