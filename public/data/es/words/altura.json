{"id":"altura","lemma":"altura","pos":"noun","rank":1641,"glosses":["height","altitude","heaven"],"ipa":"/alˈtuɾa/","gender":"f","forms":{"plural":"alturas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-AdrianAbdulBaha-altura.wav","examples":[{"text":"¿A qué altura puedes saltar?","en":"How high can you jump?","audio":"https://tatoeba.org/en/audio/download/453565"},{"text":"Me dan miedo las alturas.","en":"I'm afraid of heights.","audio":"https://tatoeba.org/en/audio/download/454068"},{"text":"¿Qué altura tiene el monte Fuji?","en":"How high is Mt. Fuji?","audio":"https://tatoeba.org/en/audio/download/453693"},{"text":"A estas alturas ya deberías saberlo.","en":"You should know that by now.","audio":"https://tatoeba.org/en/audio/download/642333"},{"text":"Tom tampoco te saca demasiada altura.","en":"Tom isn't much taller than you.","audio":"https://tatoeba.org/en/audio/download/801450"}]}