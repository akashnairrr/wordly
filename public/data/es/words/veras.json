{"id":"veras","lemma":"veras","pos":"noun","rank":693,"glosses":["truth; reality","serious things"],"ipa":"/ˈbeɾas/","gender":"f","examples":[{"text":"Yo de veras te amo.","en":"I do love you.","audio":"https://tatoeba.org/en/audio/download/440227"},{"text":"Ahora lo digo de veras.","en":"I mean it this time.","audio":"https://tatoeba.org/en/audio/download/523393"},{"text":"Me gustan de veras los mariscos.","en":"I really like seafood.","audio":"https://tatoeba.org/en/audio/download/522187"},{"text":"De veras me gusta ese carro.","en":"I really like that car.","audio":"https://tatoeba.org/en/audio/download/461941"},{"text":"¿De veras que no te gusto?","en":"Do you really not like me?","audio":"https://tatoeba.org/en/audio/download/462080"}]}