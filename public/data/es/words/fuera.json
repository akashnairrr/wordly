{"id":"fuera","lemma":"fuera","pos":"adv","rank":122,"glosses":["outside, out","out"],"ipa":"/ˈfweɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q1321_%28spa%29-AdrianAbdulBaha-fuera.wav","examples":[{"text":"¡Fuera de mi coche!","en":"Get out of my car.","audio":"https://tatoeba.org/en/audio/download/201725","words":[null,{"g":"of / from"},{"g":"my"},{"g":"car, automobile"}]},{"text":"Dejó que me fuera.","en":"He let me go.","audio":"https://tatoeba.org/en/audio/download/637183","words":[{"g":"to leave","l":"dejar"},{"g":"that"},{"g":"me"},null]},{"text":"Yo hice que él se fuera.","en":"I made him go.","audio":"https://tatoeba.org/en/audio/download/440333","words":[{"g":"I"},{"g":"to do","l":"hacer"},{"g":"that"},{"g":"he"},{"g":"oneself"},null]},{"text":"Me sentí fuera de lugar.","en":"I felt out of place.","audio":"https://tatoeba.org/en/audio/download/77933","words":[{"g":"me"},{"g":"to feel","l":"sentir"},null,{"g":"of / from"},{"g":"place"}]},{"text":"Ojalá yo fuera más joven.","en":"I wish I were younger.","audio":"https://tatoeba.org/en/audio/download/453158","words":[{"g":"I wish"},{"g":"I"},null,{"g":"more"},{"g":"young, youthful"}]}]}