{"id":"fuera","lemma":"fuera","pos":"adv","rank":123,"glosses":["outside, out","out"],"ipa":"/ˈfweɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/3/34/LL-Q1321_%28spa%29-AdrianAbdulBaha-fuera.wav","examples":[{"text":"Dejó que me fuera.","en":"He let me go.","audio":"https://tatoeba.org/en/audio/download/637183"},{"text":"Deja al perro fuera.","en":"Keep the dog out.","audio":"https://tatoeba.org/en/audio/download/39786"},{"text":"Fuera de mi cama.","en":"Get out of my bed.","audio":"https://tatoeba.org/en/audio/download/221538"},{"text":"¡Fuera de mi coche!","en":"Get out of my car.","audio":"https://tatoeba.org/en/audio/download/201725"},{"text":"El balón salió fuera.","en":"The ball went out.","audio":"https://tatoeba.org/en/audio/download/873670"}]}