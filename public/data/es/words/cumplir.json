{"id":"cumplir","lemma":"cumplir","pos":"verb","rank":1549,"glosses":["to fulfil, to fulfill, to meet, to deliver (e.g., requirements, prerequisites, promise, vow)","to achieve, to accomplish, to carry out, to perform, to complete, to discharge, to fulfil (e.g., one's duties, responsibilities)","to turn a certain age (may be succeeded by los)"],"ipa":"/kumˈpliɾ/","conjugation":{"indicative":{"present":{"1s":"cumplo","2s":"cumples","3s":"cumple","1p":"cumplimos","2p":"cumplís","3p":"cumplen"},"imperfect":{"1s":"cumplía","2s":"cumplías","3s":"cumplía","1p":"cumplíamos","2p":"cumplíais","3p":"cumplían"},"preterite":{"1s":"cumplí","2s":"cumpliste","3s":"cumplió","1p":"cumplimos","2p":"cumplisteis","3p":"cumplieron"},"future":{"1s":"cumpliré","2s":"cumplirás","3s":"cumplirá","1p":"cumpliremos","2p":"cumpliréis","3p":"cumplirán"},"conditional":{"1s":"cumpliría","2s":"cumplirías","3s":"cumpliría","1p":"cumpliríamos","2p":"cumpliríais","3p":"cumplirían"}},"subjunctive":{"present":{"1s":"cumpla","2s":"cumplas","3s":"cumpla","1p":"cumplamos","2p":"cumpláis","3p":"cumplan"},"imperfect":{"1s":"cumpliera","2s":"cumplieras","3s":"cumpliera","1p":"cumpliéramos","2p":"cumplierais","3p":"cumplieran"}},"imperative":{"affirmative":{"2s":"cumple","3s":"cumpla","1p":"cumplamos","2p":"cumplid","3p":"cumplan"},"negative":{"2s":"cumplas","3s":"cumpla","1p":"cumplamos","2p":"cumpláis","3p":"cumplan"}}},"nonFinite":{"gerund":"cumpliendo","participle":"cumplido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-AdrianAbdulBaha-cumplir.wav","examples":[{"text":"Debemos cumplir sus órdenes.","en":"We must execute his orders.","audio":"https://tatoeba.org/en/audio/download/734457"},{"text":"No estás cumpliendo con tu parte.","en":"You're not doing your share.","audio":"https://tatoeba.org/en/audio/download/585857"},{"text":"Pretendía ser un cumplido.","en":"I meant it as a compliment.","audio":"https://tatoeba.org/en/audio/download/450771"},{"text":"Mañana cumplo catorce años.","en":"I will be fourteen years old tomorrow.","audio":"https://tatoeba.org/en/audio/download/735753"},{"text":"Si no cumples con tu deber, la gente te mirará por encima del hombro.","en":"If you don't do your duty, people will look down on you.","audio":"https://tatoeba.org/en/audio/download/692702"}]}