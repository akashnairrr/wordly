{"id":"fe","lemma":"fe","pos":"noun","rank":959,"glosses":["faith"],"ipa":"/ˈfe/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8b/LL-Q1321_%28spa%29-AdrianAbdulBaha-fe.wav","examples":[{"text":"Tengo fe en ti.","en":"I have faith in you.","audio":"https://tatoeba.org/en/audio/download/450391"},{"text":"La fe mueve montañas.","en":"Faith moves mountains.","audio":"https://tatoeba.org/en/audio/download/820168"},{"text":"Lo hicimos de buena fe.","en":"We meant well.","audio":"https://tatoeba.org/en/audio/download/450873"},{"text":"Lo hicieron de buena fe.","en":"They meant well.","audio":"https://tatoeba.org/en/audio/download/450900"},{"text":"La fe puede mover montañas.","en":"Faith can move mountains.","audio":"https://tatoeba.org/en/audio/download/551751"}]}