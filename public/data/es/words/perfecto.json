{"id":"perfecto","lemma":"perfecto","pos":"adj","rank":457,"glosses":["perfect"],"ipa":"/peɾˈfeɡto/","forms":{"feminine":"perfecta","masculinePlural":"perfectos","femininePlural":"perfectas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-Marreromarco-perfecto.wav","examples":[{"text":"Es un día perfecto.","en":"It's a perfect day.","audio":"https://tatoeba.org/en/audio/download/450659"},{"text":"Somos la pareja perfecta.","en":"We are a perfect match.","audio":"https://tatoeba.org/en/audio/download/459275"},{"text":"Tom y Mary son perfectos el uno para el otro.","en":"Tom and Mary are a perfect match for each other."},{"text":"No existen personas perfectas.","en":"Perfect people don't exist."},{"text":"Tiene un cuerpo perfecto.","en":"He has a perfect body.","audio":"https://tatoeba.org/en/audio/download/702912"}]}