{"id":"importancia","lemma":"importancia","pos":"noun","rank":1482,"glosses":["importance"],"ipa":"/impoɾˈtanθja/","gender":"f","forms":{"plural":"importancias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Marreromarco-importancia.wav","examples":[{"text":"El asunto no tiene importancia.","en":"The matter is of no importance.","words":[{"g":"the"},{"g":"matter"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Es un error sin importancia.","en":"That's a trivial error.","audio":"https://tatoeba.org/en/audio/download/639445","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"error"},{"g":"without"},null]},{"text":"Este problema es de gran importancia.","en":"This matter is of great importance.","words":[{"g":"this"},{"g":"problem"},{"g":"to be","l":"ser"},{"g":"of / from"},null,null]},{"text":"Todo tiene su importancia.","en":"All things have a purpose.","words":[{"g":"all"},{"g":"to have","l":"tener"},{"g":"his / her / your"},null]},{"text":"Ella subrayó la importancia de la educación.","en":"She emphasized the importance of education.","audio":"https://tatoeba.org/en/audio/download/705689","words":[{"g":"she"},null,{"g":"the / her"},null,null,null,{"g":"education"}],"phrases":[[4,6,"of the"]]}]}