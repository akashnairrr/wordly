{"id":"curiosidad","lemma":"curiosidad","pos":"noun","rank":1620,"glosses":["curiosity"],"ipa":"/kuɾjosiˈdad/","gender":"f","forms":{"plural":"curiosidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-AdrianAbdulBaha-curiosidad.wav","examples":[{"text":"Lo hice por curiosidad.","en":"I did it out of curiosity.","audio":"https://tatoeba.org/en/audio/download/78712"},{"text":"¿Por qué tenías tanta curiosidad?","en":"Why were you so curious?","audio":"https://tatoeba.org/en/audio/download/1152570"},{"text":"La curiosidad mató al gato.","en":"Curiosity killed the cat.","audio":"https://tatoeba.org/en/audio/download/537847"},{"text":"Lo hizo simplemente por curiosidad.","en":"He did it simply out of curiosity.","audio":"https://tatoeba.org/en/audio/download/1189063"},{"text":"Los niños sienten curiosidad por todo.","en":"Children are curious about everything.","audio":"https://tatoeba.org/en/audio/download/537889"}]}