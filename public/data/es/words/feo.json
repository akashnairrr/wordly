{"id":"feo","lemma":"feo","pos":"adj","rank":1708,"glosses":["ugly","in poor condition","bad, gross, mean, nasty"],"ipa":"/ˈfeo/","forms":{"feminine":"fea","masculinePlural":"feos","femininePlural":"feas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e5/LL-Q1321_%28spa%29-AdrianAbdulBaha-feo.wav","examples":[{"text":"Esto podría ponerse feo.","en":"This might get ugly.","audio":"https://tatoeba.org/en/audio/download/448287"},{"text":"Es una situación fea.","en":"It's an ugly situation.","audio":"https://tatoeba.org/en/audio/download/461205"},{"text":"Son feos.","en":"They're ugly.","audio":"https://tatoeba.org/en/audio/download/438611"},{"text":"Algunas crías de pájaro son feas.","en":"Some baby birds are ugly."},{"text":"¡Qué conjunto tan feo!","en":"What an ugly outfit!","audio":"https://tatoeba.org/en/audio/download/455407"}]}