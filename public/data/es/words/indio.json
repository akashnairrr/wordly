{"id":"indio","lemma":"indio","pos":"adj","rank":1380,"glosses":["Indian (from India)","Indian, Native American"],"ipa":"/ˈindjo/","forms":{"feminine":"india","masculinePlural":"indios","femininePlural":"indias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q1321_%28spa%29-Millars-indio.wav","formAudio":{"india":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q1321_%28spa%29-Rodelar-India.wav"},"examples":[{"text":"Mumbai es la capital del estado indio de Maharashtra.","en":"Mumbai is the capital of the Indian state of Maharashtra."},{"text":"Él ha estado en la India.","en":"He has been to India.","audio":"https://tatoeba.org/en/audio/download/636532"},{"text":"Al principio, los indios eran amables.","en":"At first, the Indians were friendly.","audio":"https://tatoeba.org/en/audio/download/687899"},{"text":"Somos conejillos de Indias.","en":"We're guinea pigs.","audio":"https://tatoeba.org/en/audio/download/459401"},{"text":"Importamos el té de la India.","en":"We import tea from India.","audio":"https://tatoeba.org/en/audio/download/39912"}]}