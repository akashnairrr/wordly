{"id":"marca","lemma":"marca","pos":"noun","rank":1160,"glosses":["brand (of clothing etc.)","brand (for cattle)","mark (left on a surface)"],"ipa":"/ˈmaɾka/","gender":"f","forms":{"plural":"marcas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Marreromarco-marca.wav","examples":[{"text":"Tom marca la diferencia.","en":"Tom makes a difference.","audio":"https://tatoeba.org/en/audio/download/302020","words":[null,null,{"g":"the / her"},{"g":"difference"}]},{"text":"Ponga una marca en esta página.","en":"Put a mark on this page.","audio":"https://tatoeba.org/en/audio/download/594641","words":[{"g":"to put, to place","l":"poner"},{"g":"a"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"page"}]},{"text":"Mis dedos dejaron marcas en el vaso.","en":"My fingers left marks on the glass.","words":[{"g":"my"},{"g":"digit: finger or toe","l":"dedo"},{"g":"to leave","l":"dejar"},null,{"g":"in / on"},{"g":"the"},{"g":"drinking glass"}]},{"text":"¿Cuál es tu marca de jabón favorita?","en":"What's your favorite brand of soap?","audio":"https://tatoeba.org/en/audio/download/611067","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"of / from"},{"g":"soap"},{"g":"favorite/favourite","l":"favorito"}]},{"text":"Tom solo lleva ropa de marca.","en":"Tom only wears brand-name clothes.","words":[null,{"g":"sole"},{"g":"to take somewhere","l":"llevar"},{"g":"garment"},{"g":"of / from"},null]}]}