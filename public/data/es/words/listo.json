{"id":"listo","lemma":"listo","pos":"adj","rank":320,"glosses":["clever, smart","ready, set, all set, prepared, poised, up, down","alert"],"ipa":"/ˈlisto/","forms":{"feminine":"lista","masculinePlural":"listos","femininePlural":"listas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q1321_%28spa%29-Marreromarco-listo.wav","formAudio":{"lista":"https://upload.wikimedia.org/wikipedia/commons/1/12/LL-Q1321_%28spa%29-AdrianAbdulBaha-lista.wav"},"examples":[{"text":"Estoy listo para irme.","en":"I'm ready to go.","audio":"https://tatoeba.org/en/audio/download/64770"},{"text":"¡La cena está lista!","en":"Dinner's ready!","audio":"https://tatoeba.org/en/audio/download/103415"},{"text":"Los perros son listos.","en":"Dogs are smart.","audio":"https://tatoeba.org/en/audio/download/440683"},{"text":"¿Están ya listas mis fotos?","en":"Are my pictures ready now?","audio":"https://tatoeba.org/en/audio/download/410536"},{"text":"Es un chico listo.","en":"He's a smart boy.","audio":"https://tatoeba.org/en/audio/download/636989"}]}