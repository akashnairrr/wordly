{"id":"sorpresa","lemma":"sorpresa","pos":"noun","rank":673,"glosses":["surprise (something not expected)","upset (unexpected victory)"],"ipa":"/soɾˈpɾesa/","gender":"f","forms":{"plural":"sorpresas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2c/LL-Q1321_%28spa%29-Marreromarco-sorpresa.wav","examples":[{"text":"Fue una gran sorpresa.","en":"It was a big surprise.","audio":"https://tatoeba.org/en/audio/download/460920"},{"text":"Me gustan las sorpresas.","en":"I like surprises.","audio":"https://tatoeba.org/en/audio/download/442797"},{"text":"Quiero darle una sorpresa.","en":"I want to surprise him.","audio":"https://tatoeba.org/en/audio/download/534631"},{"text":"¿Te gustan las sorpresas?","en":"Do you like surprises?","audio":"https://tatoeba.org/en/audio/download/454612"},{"text":"Detesto las fiestas sorpresa.","en":"I hate surprise parties.","audio":"https://tatoeba.org/en/audio/download/461953"}]}