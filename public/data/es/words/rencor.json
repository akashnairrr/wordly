{"id":"rencor","lemma":"rencor","pos":"noun","rank":3710,"glosses":["grudge, rancor/rancour, spite"],"ipa":"/renˈkoɾ/","gender":"m","forms":{"plural":"rencores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-rencor.wav","examples":[{"text":"No te guardo rencor.","en":"I bear no grudge against you.","audio":"https://tatoeba.org/en/audio/download/806072","words":[{"g":"no / not"},{"g":"you"},{"g":"to save","l":"guardar"},null]},{"text":"Él guardaba rencor contra mí.","en":"He bore a grudge against me.","words":[{"g":"he"},{"g":"to save","l":"guardar"},null,{"g":"antidote"},{"g":"me"}]},{"text":"Tom hizo eso solo por rencor.","en":"Tom just did that for spite.","audio":"https://tatoeba.org/en/audio/download/804016","words":[null,{"g":"to do","l":"hacer"},{"g":"that","l":"ése"},{"g":"sole"},{"g":"for / by"},null]},{"text":"No es propio de Tom tener rencor.","en":"It's not like Tom to hold a grudge.","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"own"},{"g":"of / from"},null,{"g":"to have"},null]},{"text":"Tom no es de los que guardan rencor.","en":"Tom is not one to hold grudges.","words":[null,{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"of / from"},{"g":"the / them"},{"g":"that"},{"g":"to save","l":"guardar"},null]}]}