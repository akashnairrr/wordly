{"id":"permanente","lemma":"permanente","pos":"noun","rank":2776,"glosses":["perm, permanent wave, permanent","permanent marker"],"ipa":"/peɾmaˈnente/","gender":"f","forms":{"plural":"permanentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-permanente.wav","examples":[{"text":"No tengo un empleo permanente.","en":"I don't have a permanent job.","audio":"https://tatoeba.org/en/audio/download/425087","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"job, employment"},null]},{"text":"La muerte es permanente.","en":"Death is permanent.","audio":"https://tatoeba.org/en/audio/download/721689","words":[{"g":"the / her"},{"g":"death"},{"g":"to be","l":"ser"},null]},{"text":"Creo que es un cambio permanente.","en":"I think it's a permanent change.","audio":"https://tatoeba.org/en/audio/download/765552","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"change, shift"},null]},{"text":"Por favor, dame tu dirección permanente.","en":"Please give me your permanent address.","words":[null,null,{"g":"to give, to give out","l":"dar"},{"g":"your"},{"g":"direction"},null],"phrases":[[0,2,"please"]]},{"text":"He estado en contacto permanente con Tom.","en":"I've been in constant contact with Tom.","words":[{"g":"to have","l":"haber"},{"g":"country, land"},{"g":"in / on"},{"g":"contact"},null,{"g":"with"},null]}]}