{"id":"cuero","lemma":"cuero","pos":"noun","rank":2799,"glosses":["leather","animal skin, hide","football (ball)"],"ipa":"/ˈkweɾo/","gender":"m","forms":{"plural":"cueros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-AdrianAbdulBaha-cuero.wav","examples":[{"text":"Ella me dio un bolso de cuero.","en":"She gave me a bag made of leather.","audio":"https://tatoeba.org/en/audio/download/598979","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"purse"},{"g":"of / from"},null]},{"text":"Este bolso está hecho de cuero.","en":"This bag is made of leather.","words":[{"g":"this"},{"g":"purse"},{"g":"to be","l":"estar"},{"g":"done, completed"},{"g":"of / from"},null]},{"text":"Mi nuevo par de zapatos es de cuero.","en":"My new pair of shoes are made of leather.","words":[{"g":"my"},{"g":"new"},{"g":"pair"},{"g":"of / from"},{"g":"shoe","l":"zapato"},{"g":"to be","l":"ser"},{"g":"of / from"},null]},{"text":"Los zapatos de cuero cuestan mucho más.","en":"Leather shoes cost much more.","audio":"https://tatoeba.org/en/audio/download/642047","words":[{"g":"the / them"},{"g":"shoe","l":"zapato"},{"g":"of / from"},null,{"g":"to cost","l":"costar"},{"g":"much"},{"g":"more"}]},{"text":"Voy a comprar un cinturón de cuero.","en":"I'm going to buy a leather belt.","audio":"https://tatoeba.org/en/audio/download/594600","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to buy"},{"g":"a"},{"g":"belt"},{"g":"of / from"},null]}]}