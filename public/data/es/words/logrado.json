{"id":"logrado","lemma":"logrado","pos":"adj","rank":2330,"glosses":["successful"],"ipa":"/loˈɡɾado/","forms":{"feminine":"lograda","masculinePlural":"logrados","femininePlural":"logradas"},"examples":[{"text":"¿Qué has logrado?","en":"What have you accomplished?","words":[{"g":"what"},{"g":"to have","l":"haber"},null]},{"text":"Sin tu ayuda no lo habría logrado.","en":"If it were not for your help, I could not succeed.","audio":"https://tatoeba.org/en/audio/download/691801","words":[{"g":"without"},{"g":"your"},{"g":"help, aid"},{"g":"no / not"},{"g":"it / him"},{"g":"to have","l":"haber"},null]},{"text":"Ella había logrado su objetivo.","en":"She had achieved her objective.","audio":"https://tatoeba.org/en/audio/download/1253534","words":[{"g":"she"},{"g":"makes pluperfect to…"},null,{"g":"his / her / your"},{"g":"objective"}]},{"text":"Eso ya lo hemos logrado.","en":"We've already achieved that.","audio":"https://tatoeba.org/en/audio/download/548329","words":[{"g":"that","l":"ése"},{"g":"now"},{"g":"it / him"},{"g":"heme","l":"hemo"},null]},{"text":"Hemos logrado algunas buenas cosas.","en":"We accomplished some good things.","words":[{"g":"heme","l":"hemo"},null,{"g":"someone","l":"alguno"},{"g":"hello"},{"g":"thing","l":"cosa"}]}]}