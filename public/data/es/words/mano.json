{"id":"mano","lemma":"mano","pos":"noun","rank":268,"glosses":["hand","front foot","round; hand"],"ipa":"/ˈmano/","gender":"f","forms":{"plural":"manos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Rodrigo5260-mano.wav","formAudio":{"manos":"https://upload.wikimedia.org/wikipedia/commons/9/93/LL-Q1321_%28spa%29-GlyphEnjoyer-manos.wav"},"examples":[{"text":"Yo necesito una mano.","en":"I need a hand.","audio":"https://tatoeba.org/en/audio/download/440346"},{"text":"Tiene unas manos grandes.","en":"He has big hands.","audio":"https://tatoeba.org/en/audio/download/534584"},{"text":"Nos dimos la mano.","en":"We shook hands.","audio":"https://tatoeba.org/en/audio/download/821350"},{"text":"Me lavé las manos.","en":"I washed my hands.","audio":"https://tatoeba.org/en/audio/download/800412"},{"text":"Fue hecho a mano.","en":"It was handmade.","audio":"https://tatoeba.org/en/audio/download/636819"}]}