{"id":"doscientos","lemma":"doscientos","pos":"num","rank":4470,"glosses":["two hundred"],"ipa":"/dosˈθjentos/","order":4471,"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9a/LL-Q1321_%28spa%29-Marreromarco-doscientos.wav","examples":[{"text":"Nadie puede vivir doscientos años.","en":"Nobody can live to be two hundred years old.","audio":"https://tatoeba.org/en/audio/download/594235","words":[{"g":"no one"},{"g":"to be able to, can","l":"poder"},{"g":"to live"},null,{"g":"year","l":"año"}]},{"text":"Este río tiene doscientos kilómetros de largo.","en":"This river is two hundred kilometers long.","words":[{"g":"this"},{"g":"river"},{"g":"to have","l":"tener"},null,{"g":"kilometre","l":"kilómetro"},{"g":"of / from"},{"g":"long"}]},{"text":"Doscientos dólares son harto para mí.","en":"Two hundred dollars is a lot to me.","words":[null,{"g":"dollar","l":"dólar"},{"g":"to be","l":"ser"},{"g":"tired, fed up"},null,null],"phrases":[[4,6,"in my opinion"]]}]}