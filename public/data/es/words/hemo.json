{"id":"hemo","lemma":"hemo","pos":"noun","rank":172,"glosses":["heme"],"ipa":"/ˈemo/","gender":"m","forms":{"plural":"hemos"},"formAudio":{"hemos":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-Wikipedian-walker-hemos.wav"},"examples":[{"text":"No hemos visto nada.","en":"We saw nothing.","audio":"https://tatoeba.org/en/audio/download/441279"},{"text":"Hemos venido a casa.","en":"We've come home.","audio":"https://tatoeba.org/en/audio/download/442285"},{"text":"Hemos oído un ruido.","en":"We heard a noise.","audio":"https://tatoeba.org/en/audio/download/550371"},{"text":"Lo hemos hecho peor.","en":"We've done worse.","audio":"https://tatoeba.org/en/audio/download/443953"},{"text":"¿Qué nos hemos perdido?","en":"What did we miss?","audio":"https://tatoeba.org/en/audio/download/821252"}]}