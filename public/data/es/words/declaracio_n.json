{"id":"declaracio_n","lemma":"declaración","pos":"noun","rank":1294,"glosses":["statement","declaration","tax return"],"ipa":"/deklaɾaˈθjon/","gender":"f","forms":{"plural":"declaraciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/67/LL-Q1321_%28spa%29-AdrianAbdulBaha-declaraci%C3%B3n.wav","formAudio":{"declaraciones":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-GlyphEnjoyer-declaraciones.wav"},"examples":[{"text":"¡Qué declaración más absurda!","en":"What a foolish statement!","audio":"https://tatoeba.org/en/audio/download/804112"},{"text":"Estoy de acuerdo con esa declaración.","en":"I agree with that statement.","audio":"https://tatoeba.org/en/audio/download/598536"},{"text":"Su declaración no deja lugar a dudas.","en":"His statement doesn't leave room for any doubt.","audio":"https://tatoeba.org/en/audio/download/693045"},{"text":"¿Te gustaría hacer una declaración?","en":"Would you like to make a statement?"},{"text":"Creo que tu declaración es incorrecta.","en":"I believe your statement is incorrect."}]}