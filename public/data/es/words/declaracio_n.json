{"id":"declaracio_n","lemma":"declaración","pos":"noun","rank":1291,"glosses":["statement","declaration","tax return"],"ipa":"/deklaɾaˈθjon/","gender":"f","forms":{"plural":"declaraciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/67/LL-Q1321_%28spa%29-AdrianAbdulBaha-declaraci%C3%B3n.wav","formAudio":{"declaraciones":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-GlyphEnjoyer-declaraciones.wav"},"examples":[{"text":"Estoy de acuerdo con esa declaración.","en":"I agree with that statement.","audio":"https://tatoeba.org/en/audio/download/598536","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"that","l":"ese"},null],"phrases":[[1,4,"according to"]]},{"text":"¿Te gustaría hacer una declaración?","en":"Would you like to make a statement?","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"to do"},{"g":"a"},null]},{"text":"¿Tú crees en la declaración del testigo?","en":"Do you believe the witness's statement?","words":[{"g":"you"},{"g":"to believe","l":"creer"},{"g":"in / on"},{"g":"the / her"},null,{"g":"of the"},{"g":"witness"}]},{"text":"Su declaración no deja lugar a dudas.","en":"His statement doesn't leave room for any doubt.","audio":"https://tatoeba.org/en/audio/download/693045","words":[{"g":"his / her / your"},null,{"g":"no / not"},{"g":"rest"},{"g":"place"},{"g":"to"},{"g":"doubt","l":"duda"}]},{"text":"¡Qué declaración más absurda!","en":"What a foolish statement!","audio":"https://tatoeba.org/en/audio/download/804112","words":[{"g":"what"},null,{"g":"more"},{"g":"absurd","l":"absurdo"}]}]}