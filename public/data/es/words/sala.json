{"id":"sala","lemma":"sala","pos":"noun","rank":595,"glosses":["room (a separate part of a building)","large hall","ward (section of a hospital)"],"ipa":"/ˈsala/","gender":"f","forms":{"plural":"salas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-AdrianAbdulBaha-sala.wav","examples":[{"text":"¿Conoces la sala de la reunión?","en":"Do you know which room the meeting will be in?","audio":"https://tatoeba.org/en/audio/download/451389","words":[{"g":"to know","l":"conocer"},{"g":"the / her"},null,null,null,{"g":"meeting"}],"phrases":[[3,5,"of the"]]},{"text":"No hay nadie en la sala.","en":"There's no one in the room.","audio":"https://tatoeba.org/en/audio/download/527034","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"no one"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"¿Sabes en qué sala será la reunión?","en":"Do you know which room the meeting will be in?","audio":"https://tatoeba.org/en/audio/download/451388","words":[{"g":"to know, to understand","l":"saber"},{"g":"in / on"},{"g":"what"},null,{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"meeting"}]},{"text":"Espere en la sala de espera.","en":"Wait in the waiting room.","audio":"https://tatoeba.org/en/audio/download/34683","words":[{"g":"to hope","l":"esperar"},{"g":"in / on"},{"g":"the / her"},null,{"g":"of / from"},{"g":"wait"}]},{"text":"¿Dónde está la sala de estar?","en":"Where's the waiting room?","audio":"https://tatoeba.org/en/audio/download/820349","words":[null,null,{"g":"the / her"},null,{"g":"of / from"},{"g":"to be"}],"phrases":[[0,2,"where are you?"]]}]}