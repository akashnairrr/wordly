{"id":"rana","lemma":"rana","pos":"noun","rank":3383,"glosses":["frog"],"ipa":"/ˈrana/","gender":"f","forms":{"plural":"ranas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-Millars-rana.wav","examples":[{"text":"Una rana salió del agua.","en":"A frog came out of the water.","audio":"https://tatoeba.org/en/audio/download/641706","words":[{"g":"a"},null,{"g":"to go out","l":"salir"},{"g":"of the"},{"g":"water"}]},{"text":"Oí que él come ranas.","en":"I hear that he eats frogs.","audio":"https://tatoeba.org/en/audio/download/518011","words":[{"g":"to hear","l":"oír"},{"g":"that"},{"g":"he"},{"g":"to eat","l":"comer"},null]},{"text":"¿Eso es una rana?","en":"Is that a frog?","words":[null,null,{"g":"a"},null],"phrases":[[0,2,"that's it"]]},{"text":"Las ranas no tienen cuello.","en":"Frogs don't have necks.","audio":"https://tatoeba.org/en/audio/download/831405","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"neck"}]},{"text":"Tengo una rana en mi garganta.","en":"I've got a frog in my throat.","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"in / on"},{"g":"my"},{"g":"throat"}]}]}