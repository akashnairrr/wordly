{"id":"cierre","lemma":"cierre","pos":"noun","rank":1914,"glosses":["shutting, closing","shutting device, fastener; buckle, clasp","shutter, blind"],"ipa":"/ˈθjere/","gender":"m","forms":{"plural":"cierres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a5/LL-Q1321_%28spa%29-Marreromarco-cierre.wav","examples":[{"text":"Por favor, cierre la puerta.","en":"Shut the door, will you?","audio":"https://tatoeba.org/en/audio/download/552945","words":[null,null,null,{"g":"the / her"},{"g":"door"}],"phrases":[[0,2,"please"]]},{"text":"Cierre sus libros.","en":"Close your books.","audio":"https://tatoeba.org/en/audio/download/443116","words":[null,{"g":"his, her, its, their"},{"g":"book","l":"libro"}]},{"text":"Cierre el gas.","en":"Turn off the gas.","audio":"https://tatoeba.org/en/audio/download/443861","words":[null,{"g":"the"},{"g":"gas"}]},{"text":"No cierre los ojos.","en":"Don't shut your eyes.","audio":"https://tatoeba.org/en/audio/download/39953","words":[{"g":"no / not"},null,{"g":"the / them"},{"g":"eye","l":"ojo"}]},{"text":"¿Puedes hacer que se cierre la puerta?","en":"Can you get the door to shut?","words":[{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"that"},{"g":"oneself"},null,{"g":"the / her"},{"g":"door"}]}]}