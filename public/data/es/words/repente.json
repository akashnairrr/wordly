{"id":"repente","lemma":"repente","pos":"noun","rank":861,"glosses":["attack, upsurge","fit, sudden movement"],"ipa":"/reˈpente/","gender":"m","forms":{"plural":"repentes"},"examples":[{"text":"Todo sucedió de repente.","en":"Everything happened all at once.","audio":"https://tatoeba.org/en/audio/download/519515","words":[{"g":"all"},{"g":"to happen","l":"suceder"},{"g":"of / from"},null]},{"text":"De repente dejó de hablar.","en":"He suddenly stopped talking.","audio":"https://tatoeba.org/en/audio/download/600102","words":[{"g":"of / from"},null,{"g":"to leave","l":"dejar"},{"g":"of / from"},{"g":"to talk"}]},{"text":"Se murió de repente.","en":"He died suddenly.","audio":"https://tatoeba.org/en/audio/download/933831","words":[{"g":"oneself"},{"g":"to die","l":"morir"},{"g":"of / from"},null]},{"text":"De repente me sentí cansado.","en":"I suddenly felt tired.","audio":"https://tatoeba.org/en/audio/download/722257","words":[{"g":"of / from"},null,{"g":"me"},{"g":"to feel","l":"sentir"},{"g":"tired, weary, wearied"}]},{"text":"De repente, mi madre comenzó a cantar.","en":"Suddenly, my mother started singing.","audio":"https://tatoeba.org/en/audio/download/589753","words":[{"g":"of / from"},null,{"g":"my"},{"g":"mother"},{"g":"to begin, to commence","l":"comenzar"},{"g":"to"},{"g":"to sing"}]}]}