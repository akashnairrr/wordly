{"id":"repente","lemma":"repente","pos":"noun","rank":864,"glosses":["attack, upsurge","fit, sudden movement"],"ipa":"/reˈpente/","gender":"m","forms":{"plural":"repentes"},"examples":[{"text":"Se murió de repente.","en":"He died suddenly.","audio":"https://tatoeba.org/en/audio/download/933831"},{"text":"No frenes de repente.","en":"Don't brake suddenly.","audio":"https://tatoeba.org/en/audio/download/800816"},{"text":"De repente, me desmayé.","en":"Suddenly, I blacked out.","audio":"https://tatoeba.org/en/audio/download/1061647"},{"text":"Todo sucedió de repente.","en":"Everything happened all at once.","audio":"https://tatoeba.org/en/audio/download/519515"},{"text":"De repente me sentí cansado.","en":"I suddenly felt tired.","audio":"https://tatoeba.org/en/audio/download/722257"}]}