{"id":"llanto","lemma":"llanto","pos":"noun","rank":4687,"glosses":["crying"],"ipa":"/ˈʝanto/","gender":"m","forms":{"plural":"llantos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q1321_%28spa%29-Marreromarco-llanto.wav","examples":[{"text":"La niña rompió en llanto.","en":"The girl broke into tears.","words":[{"g":"the / her"},{"g":"girl"},{"g":"to break","l":"romper"},{"g":"in / on"},null]},{"text":"La niña se arrulló con su propio llanto.","en":"The baby cried herself to sleep.","audio":"https://tatoeba.org/en/audio/download/300618","words":[{"g":"the / her"},{"g":"girl"},{"g":"oneself"},null,{"g":"with"},{"g":"his / her / your"},{"g":"own"},null]},{"text":"Al oír la noticia, ella colapsó en llanto.","en":"When she heard the news, she broke down crying.","words":[{"g":"to the"},{"g":"to hear"},{"g":"the / her"},{"g":"notice"},{"g":"she"},{"g":"to cause to collapse","l":"colapsar"},{"g":"in / on"},null]},{"text":"Rompe en llanto.","en":"He's beginning to cry.","audio":"https://tatoeba.org/en/audio/download/730045","words":[{"g":"to break","l":"romper"},{"g":"in / on"},null]},{"text":"La risa es más contagiosa que el llanto.","en":"Laughter is more contagious than crying.","words":[{"g":"the / her"},{"g":"laugh, laughter"},null,null,{"g":"contagious","l":"contagioso"},{"g":"that"},{"g":"the"},null],"phrases":[[2,4,"furthermore"]]}]}