{"id":"sino","lemma":"sino","pos":"conj","rank":481,"glosses":["but (rather) (after a negative clause)","except, apart from","only, solely (in a negative clause)"],"ipa":"/ˈsino/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q1321_%28spa%29-Precision27-sino.wav","examples":[{"text":"No fui sino que me quedé en casa.","en":"I didn't go, but stayed at home.","audio":"https://tatoeba.org/en/audio/download/806095","words":[{"g":"no / not"},{"g":"to go","l":"ir"},null,{"g":"that"},{"g":"me"},{"g":"to be , to end up","l":"quedar"},null,null],"phrases":[[6,8,"home"]]},{"text":"Fui no una vez, sino dos.","en":"I went not once, but twice.","audio":"https://tatoeba.org/en/audio/download/639695","words":[{"g":"to go","l":"ir"},{"g":"no / not"},null,null,null,{"g":"dung, excrement"}],"phrases":[[2,4,"once"]]},{"text":"No soy médico, sino profesor.","en":"I'm a teacher, not a doctor.","audio":"https://tatoeba.org/en/audio/download/354762","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"doctor"},null,{"g":"professor"}]},{"text":"No es una carretera, sino un camino.","en":"It isn't a road, but a path.","audio":"https://tatoeba.org/en/audio/download/821409","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"road, highway"},null,{"g":"a"},{"g":"way, route"}]},{"text":"No tenía otra posibilidad, sino sólo hacerlo.","en":"You had no choice but to do it.","audio":"https://tatoeba.org/en/audio/download/585925","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"someone else","l":"otro"},{"g":"possibility"},null,null,{"g":"to do","l":"hacer"}]}]}