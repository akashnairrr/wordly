{"id":"promesa","lemma":"promesa","pos":"noun","rank":1480,"glosses":["promise"],"ipa":"/pɾoˈmesa/","gender":"f","forms":{"plural":"promesas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-Marreromarco-promesa.wav","examples":[{"text":"No olvides tu promesa.","en":"Don't forget your promise.","audio":"https://tatoeba.org/en/audio/download/594671","words":[{"g":"no / not"},{"g":"to forget","l":"olvidar"},{"g":"your"},null]},{"text":"Promesas son promesas.","en":"A promise is a promise.","audio":"https://tatoeba.org/en/audio/download/459703","words":[null,{"g":"to be","l":"ser"},null]},{"text":"Quiero que me hagas una promesa.","en":"I want you to make me a promise.","audio":"https://tatoeba.org/en/audio/download/522341","words":[{"g":"to desire","l":"querer"},{"g":"that"},{"g":"me"},{"g":"to do","l":"hacer"},{"g":"a"},null]},{"text":"Debes cumplir tus promesas.","en":"You should fulfill your promises.","audio":"https://tatoeba.org/en/audio/download/512848","words":[{"g":"to owe","l":"deber"},{"g":"to fulfil"},{"g":"your"},null]},{"text":"Perdóname por haber roto mi promesa.","en":"Forgive me for breaking my promise.","audio":"https://tatoeba.org/en/audio/download/35072","words":[{"g":"to pardon","l":"perdonar"},{"g":"for / by"},{"g":"to have"},{"g":"broken"},{"g":"my"},null]}]}