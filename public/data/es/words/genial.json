{"id":"genial","lemma":"genial","pos":"adj","rank":216,"glosses":["great, very good","genial, pleasant","splendid, gorgeous"],"ipa":"/xeˈnjal/","forms":{"femininePlural":"geniales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-Marreromarco-genial.wav","examples":[{"text":"Es un libro genial.","en":"It's a good book.","audio":"https://tatoeba.org/en/audio/download/101945"},{"text":"Ellos son niños geniales.","en":"They're nice kids.","audio":"https://tatoeba.org/en/audio/download/448915"},{"text":"Este tío es genial.","en":"This guy is great.","audio":"https://tatoeba.org/en/audio/download/636801"},{"text":"Mis padres son geniales.","en":"My parents are great.","audio":"https://tatoeba.org/en/audio/download/454993"},{"text":"Esto es muy genial.","en":"This is very cool.","audio":"https://tatoeba.org/en/audio/download/799451"}]}