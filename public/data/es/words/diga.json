{"id":"diga","lemma":"diga","pos":"intj","rank":394,"glosses":["way to say hello on the telephone"],"ipa":"/ˈdiɡa/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Wikipedian-walker-diga.wav","examples":[{"text":"¿Cuánto malo quieres que te diga?","en":"How bad do you want to know?","audio":"https://tatoeba.org/en/audio/download/300095","words":[{"g":"how much"},{"g":"bad"},{"g":"to desire","l":"querer"},{"g":"that"},{"g":"you"},null]},{"text":"¡No diga ni una palabra!","en":"Don't say anything.","audio":"https://tatoeba.org/en/audio/download/139981","words":[{"g":"no / not"},null,{"g":"Forms an emphatic…"},{"g":"a"},{"g":"word"}]},{"text":"No se lo diga a mi novia.","en":"Don't tell my girlfriend.","audio":"https://tatoeba.org/en/audio/download/81891","words":[{"g":"no / not"},{"g":"oneself"},{"g":"it / him"},null,{"g":"to"},{"g":"my"},{"g":"a type of sweet roll"}]},{"text":"No me importa lo que él diga.","en":"I don't care what he says.","audio":"https://tatoeba.org/en/audio/download/1154783","words":[null,null,null,null,null,{"g":"he"},null],"phrases":[[0,3,"I don't care!"],[3,5,"what, that which"]]},{"text":"Será mejor que te diga la verdad.","en":"I'd better tell you the truth.","audio":"https://tatoeba.org/en/audio/download/642080","words":[{"g":"to be","l":"ser"},{"g":"better"},{"g":"that"},{"g":"you"},null,null,null],"phrases":[[5,7,"honestly, to be honest"]]}]}