{"id":"jaula","lemma":"jaula","pos":"noun","rank":2468,"glosses":["cage","crate"],"ipa":"/ˈxaula/","gender":"f","forms":{"plural":"jaulas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-AdrianAbdulBaha-jaula.wav","examples":[{"text":"La jaula está abierta.","en":"The cage is open.","audio":"https://tatoeba.org/en/audio/download/443521","words":[{"g":"the / her"},null,{"g":"to be","l":"estar"},{"g":"the act of opening"}]},{"text":"Él abrió las jaulas.","en":"He opened the cages.","audio":"https://tatoeba.org/en/audio/download/450321","words":[{"g":"he"},{"g":"to open, open up","l":"abrir"},{"g":"the / them"},null]},{"text":"El mono está en la jaula.","en":"The monkey is in the cage.","words":[{"g":"the"},{"g":"monkey"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"El mundo es una jaula de locos.","en":"The world is a madhouse.","audio":"https://tatoeba.org/en/audio/download/733089","words":[{"g":"the"},{"g":"world, earth"},{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[5,7,"crazy"]]},{"text":"Los leones rugían en sus jaulas.","en":"The lions roared in their cages.","audio":"https://tatoeba.org/en/audio/download/687573","words":[{"g":"the / them"},{"g":"lion","l":"león"},null,{"g":"in / on"},{"g":"his, her, its, their"},null]}]}