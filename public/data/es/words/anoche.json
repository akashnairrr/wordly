{"id":"anoche","lemma":"anoche","pos":"adv","rank":398,"glosses":["last night"],"ipa":"/aˈnot͡ʃe/","audio":"https://upload.wikimedia.org/wikipedia/commons/4/48/LL-Q1321_%28spa%29-Marreromarco-anoche.wav","examples":[{"text":"Anoche vi a Tom.","en":"I saw Tom last night.","audio":"https://tatoeba.org/en/audio/download/138285"},{"text":"Yo estuve ahí anoche.","en":"I was there last night.","audio":"https://tatoeba.org/en/audio/download/458679"},{"text":"¿Os fue bien anoche?","en":"How did it go last night?","audio":"https://tatoeba.org/en/audio/download/611879"},{"text":"Anoche tuve un sueño.","en":"I had a dream last night.","audio":"https://tatoeba.org/en/audio/download/721866"},{"text":"Anoche leí un libro.","en":"I read a book last night.","audio":"https://tatoeba.org/en/audio/download/600198"}]}