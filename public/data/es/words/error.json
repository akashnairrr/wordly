{"id":"error","lemma":"error","pos":"noun","rank":487,"glosses":["error"],"ipa":"/eˈroɾ/","gender":"m","forms":{"plural":"errores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/60/LL-Q1321_%28spa%29-AdrianAbdulBaha-error.wav","examples":[{"text":"Se cometió un error.","en":"An error was made.","audio":"https://tatoeba.org/en/audio/download/519465"},{"text":"A menudo cometemos errores.","en":"We often make mistakes.","audio":"https://tatoeba.org/en/audio/download/460480"},{"text":"Él cometió un error.","en":"He made a mistake.","audio":"https://tatoeba.org/en/audio/download/444200"},{"text":"Aún cometo muchos errores.","en":"I still make many mistakes.","audio":"https://tatoeba.org/en/audio/download/450767"},{"text":"Este fue mi error.","en":"This was my fault.","audio":"https://tatoeba.org/en/audio/download/799345"}]}