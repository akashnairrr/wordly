{"id":"rico","lemma":"rico","pos":"adj","rank":911,"glosses":["rich (having a lot of money and possessions)","luxurious","tasty, yummy"],"ipa":"/ˈriko/","forms":{"feminine":"rica","masculinePlural":"ricos","femininePlural":"ricas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q1321_%28spa%29-AdrianAbdulBaha-rico.wav","examples":[{"text":"Yo ya soy rico.","en":"I'm already rich.","audio":"https://tatoeba.org/en/audio/download/442702"},{"text":"Sé que eres rica.","en":"I know you are rich.","audio":"https://tatoeba.org/en/audio/download/125471"},{"text":"Los dos somos ricos.","en":"We're both rich.","audio":"https://tatoeba.org/en/audio/download/274505"},{"text":"Las mandarinas son ricas en vitaminas.","en":"Mandarin oranges are rich in vitamins.","audio":"https://tatoeba.org/en/audio/download/412416"},{"text":"Mi tío es rico.","en":"My uncle is rich.","audio":"https://tatoeba.org/en/audio/download/442931"}]}