{"id":"deja","lemma":"deja","pos":"noun","rank":259,"glosses":["rest (that remaining after cutting textiles)"],"ipa":"/ˈdexa/","gender":"f","forms":{"plural":"dejas"},"examples":[{"text":"Deja ir a Tom.","en":"Let Tom go.","audio":"https://tatoeba.org/en/audio/download/302167"},{"text":"¿Me dejas tu bolígrafo?","en":"May I use your pen?","audio":"https://tatoeba.org/en/audio/download/637088"},{"text":"Deja que pague yo.","en":"Let me pay.","audio":"https://tatoeba.org/en/audio/download/87321"},{"text":"¿Me dejas un boli?","en":"Can you loan me a pen?","audio":"https://tatoeba.org/en/audio/download/453356"},{"text":"Deja venir a Tom.","en":"Let Tom come.","audio":"https://tatoeba.org/en/audio/download/152881"}]}