{"id":"adentro","lemma":"adentro","pos":"adv","rank":702,"glosses":["inside (especially implying a motion into)"],"ipa":"/aˈdentɾo/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-Marreromarco-adentro.wav","examples":[{"text":"Él no está adentro.","en":"He's not in.","audio":"https://tatoeba.org/en/audio/download/501235"},{"text":"Pase adentro, por favor.","en":"Please come in.","audio":"https://tatoeba.org/en/audio/download/441084"},{"text":"Ella se fue adentro.","en":"She went inside.","audio":"https://tatoeba.org/en/audio/download/442026"},{"text":"Lleva adentro a Tom.","en":"Take Tom inside.","audio":"https://tatoeba.org/en/audio/download/800063"},{"text":"No hay nada adentro.","en":"There's nothing inside.","audio":"https://tatoeba.org/en/audio/download/460216"}]}