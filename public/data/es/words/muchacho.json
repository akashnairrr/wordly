{"id":"muchacho","lemma":"muchacho","pos":"noun","rank":582,"glosses":["boy or young adult","term of address"],"ipa":"/muˈt͡ʃat͡ʃo/","gender":"m","forms":{"plural":"muchachos","feminine":"muchacha","femininePlural":"muchachas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-muchacho.wav","formAudio":{"muchacha":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-AdrianAbdulBaha-muchacha.wav"},"examples":[{"text":"¿Quién es este muchacho?","en":"Who is this boy?","audio":"https://tatoeba.org/en/audio/download/442238","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"this"},null]},{"text":"Debe ser un buen muchacho.","en":"He must be a good boy.","audio":"https://tatoeba.org/en/audio/download/453161","words":[{"g":"to owe","l":"deber"},{"g":"to be"},{"g":"a"},null,null]},{"text":"¿Dónde están las otras muchachas?","en":"Where are the other girls?","audio":"https://tatoeba.org/en/audio/download/586636","words":[{"g":"where"},{"g":"to be","l":"estar"},{"g":"the / them"},{"g":"someone else","l":"otro"},null]},{"text":"Veo a la muchacha.","en":"I see the girl.","audio":"https://tatoeba.org/en/audio/download/799931","words":[{"g":"to see, to spot","l":"ver"},{"g":"to"},{"g":"the / her"},null]},{"text":"Él ya no es un muchacho.","en":"He is no longer a boy.","audio":"https://tatoeba.org/en/audio/download/454178","words":[{"g":"he"},null,null,{"g":"to be","l":"ser"},{"g":"a"},null],"phrases":[[1,3,"no longer"]]}]}