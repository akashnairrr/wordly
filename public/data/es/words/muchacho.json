{"id":"muchacho","lemma":"muchacho","pos":"noun","rank":585,"glosses":["boy or young adult","term of address"],"ipa":"/muˈt͡ʃat͡ʃo/","gender":"m","forms":{"plural":"muchachos","feminine":"muchacha","femininePlural":"muchachas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-muchacho.wav","formAudio":{"muchacha":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-AdrianAbdulBaha-muchacha.wav"},"examples":[{"text":"¿Quién es este muchacho?","en":"Who is this boy?","audio":"https://tatoeba.org/en/audio/download/442238"},{"text":"Conocí a todos aquellos muchachos.","en":"I knew every one of those guys.","audio":"https://tatoeba.org/en/audio/download/297788"},{"text":"Veo a la muchacha.","en":"I see the girl.","audio":"https://tatoeba.org/en/audio/download/799931"},{"text":"Odio ese tipo de muchachas.","en":"I hate girls like that.","audio":"https://tatoeba.org/en/audio/download/518725"},{"text":"Es un muchacho encantador.","en":"He's a lovely young man.","audio":"https://tatoeba.org/en/audio/download/702955"}]}