{"id":"u_til","lemma":"útil","pos":"adj","rank":1466,"glosses":["useful"],"ipa":"/ˈutil/","forms":{"femininePlural":"útiles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-AdrianAbdulBaha-%C3%BAtil.wav","examples":[{"text":"Este libro nos será muy útil.","en":"This book will be very useful to us.","audio":"https://tatoeba.org/en/audio/download/34959","words":[{"g":"this"},{"g":"book"},{"g":"us"},{"g":"to be","l":"ser"},null,null]},{"text":"Esa información no es muy útil.","en":"That's not a useful piece of information.","audio":"https://tatoeba.org/en/audio/download/538206","words":[{"g":"that","l":"ese"},{"g":"information, data"},{"g":"no / not"},{"g":"to be","l":"ser"},null,null]},{"text":"Los caballos son animales útiles.","en":"Horses are useful animals.","audio":"https://tatoeba.org/en/audio/download/731533","words":[{"g":"the / them"},{"g":"horse","l":"caballo"},{"g":"to be","l":"ser"},{"g":"animal","l":"animal"},null]},{"text":"Haz algo útil.","en":"Do something useful.","words":[{"g":"to do","l":"hacer"},{"g":"something, anything"},null]},{"text":"Me gusta inventar cosas útiles.","en":"I like to invent useful things.","audio":"https://tatoeba.org/en/audio/download/552961","words":[null,null,{"g":"to invent"},{"g":"thing","l":"cosa"},null],"phrases":[[0,2,"like, thumbs up"]]}]}