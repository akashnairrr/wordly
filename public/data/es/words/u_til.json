{"id":"u_til","lemma":"útil","pos":"adj","rank":1469,"glosses":["useful"],"ipa":"/ˈutil/","forms":{"femininePlural":"útiles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-AdrianAbdulBaha-%C3%BAtil.wav","examples":[{"text":"Tomás quiere ser útil.","en":"Tom wants to be useful.","audio":"https://tatoeba.org/en/audio/download/458873"},{"text":"Los caballos son animales útiles.","en":"Horses are useful animals.","audio":"https://tatoeba.org/en/audio/download/731533"},{"text":"Aprender francés es útil.","en":"Learning French is useful.","audio":"https://tatoeba.org/en/audio/download/302548"},{"text":"Me gusta inventar cosas útiles.","en":"I like to invent useful things.","audio":"https://tatoeba.org/en/audio/download/552961"},{"text":"Hablar inglés es útil.","en":"Speaking English is useful.","audio":"https://tatoeba.org/en/audio/download/706849"}]}