{"id":"u_til","lemma":"útil","pos":"adj","rank":1466,"glosses":["useful"],"ipa":"/ˈutil/","forms":{"femininePlural":"útiles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-AdrianAbdulBaha-%C3%BAtil.wav","examples":[{"text":"Puede que esto te sea útil.","en":"This may be of use to you.","audio":"https://tatoeba.org/en/audio/download/606456","words":[null,null,{"g":"this"},{"g":"you"},{"g":"to be","l":"ser"},null],"phrases":[[0,2,"it may be that"]]},{"text":"Los caballos son animales útiles.","en":"Horses are useful animals.","audio":"https://tatoeba.org/en/audio/download/731533","words":[{"g":"the / them"},{"g":"horse","l":"caballo"},{"g":"to be","l":"ser"},{"g":"animal","l":"animal"},null]},{"text":"Este libro nos será muy útil.","en":"This book will be very useful to us.","audio":"https://tatoeba.org/en/audio/download/34959","words":[{"g":"this"},{"g":"book"},{"g":"us"},{"g":"to be","l":"ser"},null,null]},{"text":"No es útil.","en":"It's not useful.","audio":"https://tatoeba.org/en/audio/download/541126","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Me gusta inventar cosas útiles.","en":"I like to invent useful things.","audio":"https://tatoeba.org/en/audio/download/552961","words":[null,null,{"g":"to invent"},{"g":"thing","l":"cosa"},null],"phrases":[[0,2,"like, thumbs up"]]}]}