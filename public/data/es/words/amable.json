{"id":"amable","lemma":"amable","pos":"adj","rank":625,"glosses":["kind, amiable, gracious","affable"],"ipa":"/aˈmable/","forms":{"femininePlural":"amables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q1321_%28spa%29-Marreromarco-amable.wav","examples":[{"text":"Ella es muy amable con nosotros.","en":"She is very kind to us.","audio":"https://tatoeba.org/en/audio/download/639569","words":[{"g":"she"},{"g":"to be","l":"ser"},null,null,{"g":"with"},{"g":"we"}]},{"text":"Él y tú sois ambos muy amables.","en":"You and he are both very kind.","audio":"https://tatoeba.org/en/audio/download/554059","words":[{"g":"he"},{"g":"and"},{"g":"you"},{"g":"to be","l":"ser"},{"g":"both"},null,null]},{"text":"Sé amable con aquellos a tu alrededor.","en":"Be kind to those around you.","audio":"https://tatoeba.org/en/audio/download/705179","words":[{"g":"to know, to understand","l":"saber"},null,{"g":"with"},{"g":"that (over there","l":"aquel"},{"g":"to"},{"g":"your"},{"g":"around"}]},{"text":"Son muy amables conmigo.","en":"They are very kind to me.","audio":"https://tatoeba.org/en/audio/download/151874","words":[{"g":"to be","l":"ser"},null,null,{"g":"with me"}]},{"text":"Fue muy amable de tu parte ayudarnos.","en":"It was very kind of you to help us.","audio":"https://tatoeba.org/en/audio/download/722212","words":[{"g":"to be","l":"ser"},null,null,{"g":"of / from"},{"g":"your"},{"g":"part"},{"g":"to help","l":"ayudar"}]}]}