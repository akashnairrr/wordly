{"id":"amable","lemma":"amable","pos":"adj","rank":628,"glosses":["kind, amiable, gracious","affable"],"ipa":"/aˈmable/","forms":{"femininePlural":"amables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/02/LL-Q1321_%28spa%29-Marreromarco-amable.wav","examples":[{"text":"Él es muy amable.","en":"He is very kind.","audio":"https://tatoeba.org/en/audio/download/441497"},{"text":"Son muy amables conmigo.","en":"They are very kind to me.","audio":"https://tatoeba.org/en/audio/download/151874"},{"text":"Él es amable conmigo.","en":"He's kind to me.","audio":"https://tatoeba.org/en/audio/download/40519"},{"text":"Gracias por sus amables palabras.","en":"Thank you for your kind words.","audio":"https://tatoeba.org/en/audio/download/606616"},{"text":"El niño es amable.","en":"The boy is kind.","audio":"https://tatoeba.org/en/audio/download/442008"}]}