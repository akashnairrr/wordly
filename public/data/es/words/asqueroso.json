{"id":"asqueroso","lemma":"asqueroso","pos":"adj","rank":1576,"glosses":["disgusting, repulsive, gross, distasteful"],"ipa":"/askeˈɾoso/","forms":{"feminine":"asquerosa","masculinePlural":"asquerosos","femininePlural":"asquerosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0e/LL-Q1321_%28spa%29-Marreromarco-asqueroso.wav","examples":[{"text":"Tom es un asqueroso.","en":"Tom is a creep.","audio":"https://tatoeba.org/en/audio/download/799867"},{"text":"Eso es realmente asqueroso.","en":"That's really disgusting.","audio":"https://tatoeba.org/en/audio/download/803536"},{"text":"Este material es asqueroso.","en":"This stuff is disgusting.","audio":"https://tatoeba.org/en/audio/download/803538"},{"text":"Fumar es un hábito asqueroso.","en":"Smoking is a disgusting habit.","audio":"https://tatoeba.org/en/audio/download/803541"},{"text":"¡Sos un asqueroso bolacero!","en":"You're a filthy liar!"}]}