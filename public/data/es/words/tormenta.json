{"id":"tormenta","lemma":"tormenta","pos":"noun","rank":1338,"glosses":["storm","thunderstorm, lightning storm"],"ipa":"/toɾˈmenta/","gender":"f","forms":{"plural":"tormentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c2/LL-Q1321_%28spa%29-AdrianAbdulBaha-tormenta.wav","examples":[{"text":"Se acerca una gran tormenta.","en":"There's a big storm coming.","audio":"https://tatoeba.org/en/audio/download/704308"},{"text":"Los huracanes son tormentas violentas.","en":"Hurricanes are violent storms.","audio":"https://tatoeba.org/en/audio/download/642075"},{"text":"Una gran tormenta se aproxima.","en":"There's a big storm coming.","audio":"https://tatoeba.org/en/audio/download/704309"},{"text":"Debemos estar preparados para enfrentarnos a tormentas violentas.","en":"We have to be prepared to cope with violent storms.","audio":"https://tatoeba.org/en/audio/download/833084"},{"text":"Va a haber una tormenta.","en":"There's going to be a storm.","audio":"https://tatoeba.org/en/audio/download/730575"}]}