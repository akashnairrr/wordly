{"id":"tormenta","lemma":"tormenta","pos":"noun","rank":1335,"glosses":["storm","thunderstorm, lightning storm"],"ipa":"/toɾˈmenta/","gender":"f","forms":{"plural":"tormentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c2/LL-Q1321_%28spa%29-AdrianAbdulBaha-tormenta.wav","examples":[{"text":"Viene una tormenta.","en":"A storm is coming.","audio":"https://tatoeba.org/en/audio/download/443763","words":[{"g":"to come","l":"venir"},{"g":"a"},null]},{"text":"Tras la tormenta llegó la calma.","en":"After the storm, it was calm.","audio":"https://tatoeba.org/en/audio/download/333122","words":[{"g":"after"},{"g":"the / her"},null,{"g":"to arrive, get","l":"llegar"},{"g":"the / her"},{"g":"calm"}]},{"text":"Esta tormenta también pasará.","en":"This storm will also pass.","words":[{"g":"this","l":"este"},null,{"g":"also, too, as well"},{"g":"to pass","l":"pasar"}]},{"text":"Se acerca una gran tormenta.","en":"There's a big storm coming.","audio":"https://tatoeba.org/en/audio/download/704308","words":[{"g":"oneself"},{"g":"only used in acerca de…"},{"g":"a"},null,null]},{"text":"Los huracanes son tormentas violentas.","en":"Hurricanes are violent storms.","audio":"https://tatoeba.org/en/audio/download/642075","words":[{"g":"the / them"},{"g":"hurricane","l":"huracán"},{"g":"to be","l":"ser"},null,{"g":"violent","l":"violento"}]}]}