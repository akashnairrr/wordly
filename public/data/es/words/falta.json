{"id":"falta","lemma":"falta","pos":"noun","rank":400,"glosses":["lack, shortage","absence","day absent"],"ipa":"/ˈfalta/","gender":"f","forms":{"plural":"faltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Marreromarco-falta.wav","examples":[{"text":"¿Hace falta que yo vaya allá?","en":"Do I need to go there?","audio":"https://tatoeba.org/en/audio/download/453807","words":[{"g":"to do","l":"hacer"},null,{"g":"that"},{"g":"I"},{"g":"what a ..."},{"g":"there"}]},{"text":"Me falta pintura.","en":"I need paint.","audio":"https://tatoeba.org/en/audio/download/438158","words":[{"g":"me"},null,{"g":"painting"}]},{"text":"Hay muchas faltas en esta traducción.","en":"There are a lot of mistakes in this translation.","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"translation"}]},{"text":"No nos falta de nada.","en":"We lack nothing.","audio":"https://tatoeba.org/en/audio/download/636900","words":[{"g":"no / not"},{"g":"us"},null,null,null],"phrases":[[3,5,"it's nothing"]]},{"text":"A mí me falta experiencia.","en":"I lack experience.","audio":"https://tatoeba.org/en/audio/download/767686","words":[{"g":"to"},{"g":"me"},{"g":"me"},null,{"g":"experience"}]}]}