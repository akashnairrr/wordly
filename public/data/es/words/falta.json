{"id":"falta","lemma":"falta","pos":"noun","rank":400,"glosses":["lack, shortage","absence","day absent"],"ipa":"/ˈfalta/","gender":"f","forms":{"plural":"faltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Marreromarco-falta.wav","examples":[{"text":"Siempre nos falta dinero.","en":"We're always short on money.","audio":"https://tatoeba.org/en/audio/download/78108","words":[{"g":"always"},{"g":"us"},null,{"g":"money"}]},{"text":"No falta nadie.","en":"There's no one missing.","audio":"https://tatoeba.org/en/audio/download/460306","words":[{"g":"no / not"},null,{"g":"no one"}]},{"text":"No me hace falta el dinero.","en":"Lack of money is not a problem for me.","audio":"https://tatoeba.org/en/audio/download/578224","words":[{"g":"no / not"},{"g":"me"},{"g":"to do","l":"hacer"},null,{"g":"the"},{"g":"money"}]},{"text":"Hay muchas faltas en esta traducción.","en":"There are a lot of mistakes in this translation.","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"translation"}]},{"text":"Haré lo que haga falta.","en":"I'll do whatever it takes.","audio":"https://tatoeba.org/en/audio/download/599309","words":[{"g":"to do","l":"hacer"},null,null,{"g":"to do","l":"hacer"},null],"phrases":[[1,3,"what, that which"]]}]}