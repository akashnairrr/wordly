{"id":"falta","lemma":"falta","pos":"noun","rank":403,"glosses":["lack, shortage","absence","day absent"],"ipa":"/ˈfalta/","gender":"f","forms":{"plural":"faltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Marreromarco-falta.wav","examples":[{"text":"Lo echo en falta.","en":"I miss it.","audio":"https://tatoeba.org/en/audio/download/412220"},{"text":"Todavía cometo muchas faltas.","en":"I still make many mistakes.","audio":"https://tatoeba.org/en/audio/download/450766"},{"text":"No nos falta nada.","en":"We lack nothing.","audio":"https://tatoeba.org/en/audio/download/636901"},{"text":"Hay muchas faltas en esta traducción.","en":"There are a lot of mistakes in this translation."},{"text":"Me falta un calcetín.","en":"I'm missing a sock.","audio":"https://tatoeba.org/en/audio/download/449120"}]}