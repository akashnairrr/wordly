{"id":"comedor","lemma":"comedor","pos":"noun","rank":2803,"glosses":["dining room","eatery","cafeteria, canteen (staff restaurant)"],"ipa":"/komeˈdoɾ/","gender":"m","forms":{"plural":"comedores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q1321_%28spa%29-AdrianAbdulBaha-comedor.wav","examples":[{"text":"¿Dónde está el comedor?","en":"Where's the dining room?","audio":"https://tatoeba.org/en/audio/download/582506","words":[null,null,{"g":"the"},null],"phrases":[[0,2,"where are you?"]]},{"text":"Me gusta comer en el comedor.","en":"I like to eat in the cafeteria.","words":[null,null,{"g":"to eat"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"El coche-comedor va a la cabeza del tren.","en":"The dining car's at the front end of the train.","words":[{"g":"the"},{"g":"car, automobile"},null,{"g":"okay"},null,null,null,{"g":"of the"},{"g":"train"}],"phrases":[[4,7,"in charge"]]},{"text":"Nos vemos en el comedor.","en":"I'll meet you in the lunchroom.","words":[null,null,{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"cheers, goodbye"]]},{"text":"Nuestra casa tiene siete habitaciones, incluyendo el comedor.","en":"Our house has seven rooms including the dining room.","audio":"https://tatoeba.org/en/audio/download/635075","words":[{"g":"our, ours, to us","l":"nuestro"},{"g":"house"},{"g":"to have","l":"tener"},{"g":"seven"},{"g":"room","l":"habitación"},{"g":"to include","l":"incluir"},{"g":"the"},null]}]}