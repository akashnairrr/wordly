{"id":"amor","lemma":"amor","pos":"noun","rank":188,"glosses":["love","love affair"],"ipa":"/aˈmoɾ/","gender":"m","forms":{"plural":"amores"},"formAudio":{"amores":"https://upload.wikimedia.org/wikipedia/commons/b/b8/LL-Q1321_%28spa%29-Eavqwiki-amores.wav"},"examples":[{"text":"El amor es ciego.","en":"Love is blind.","audio":"https://tatoeba.org/en/audio/download/501081"},{"text":"El amor no muere.","en":"Love doesn't die.","audio":"https://tatoeba.org/en/audio/download/442852"},{"text":"El amor es inmortal.","en":"Love is immortal.","audio":"https://tatoeba.org/en/audio/download/538361"},{"text":"El amor vence todo.","en":"Love conquers all.","audio":"https://tatoeba.org/en/audio/download/798890"},{"text":"No era amor verdadero.","en":"It wasn't real love.","audio":"https://tatoeba.org/en/audio/download/34931"}]}