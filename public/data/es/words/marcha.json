{"id":"marcha","lemma":"marcha","pos":"noun","rank":856,"glosses":["march","departure","gear (of a motor vehicle, a particular combination or choice of interlocking gears)"],"ipa":"/ˈmaɾt͡ʃa/","gender":"f","forms":{"plural":"marchas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-Marreromarco-marcha.wav","examples":[{"text":"Me fui de marcha.","en":"I went hiking.","audio":"https://tatoeba.org/en/audio/download/440512"},{"text":"Esa moto tiene cambio automático de marchas.","en":"That motorcycle is an automatic.","audio":"https://tatoeba.org/en/audio/download/410800"},{"text":"¿Quién puso en marcha Disneyland?","en":"Who started Disneyland?","audio":"https://tatoeba.org/en/audio/download/412450"},{"text":"¿A qué hora te marchas?","en":"What time are you leaving?"},{"text":"El semáforo en verde significa marcha.","en":"A green light means go.","audio":"https://tatoeba.org/en/audio/download/417771"}]}