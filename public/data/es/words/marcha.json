{"id":"marcha","lemma":"marcha","pos":"noun","rank":854,"glosses":["march","departure","gear (of a motor vehicle, a particular combination or choice of interlocking gears)"],"ipa":"/ˈmaɾt͡ʃa/","gender":"f","forms":{"plural":"marchas"},"order":988,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-Marreromarco-marcha.wav","examples":[{"text":"Me fui de marcha.","en":"I went hiking.","audio":"https://tatoeba.org/en/audio/download/440512","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"of / from"},null]},{"text":"No pude poner mi coche en marcha.","en":"I couldn't get my car started.","audio":"https://tatoeba.org/en/audio/download/515129","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to put, to place"},{"g":"my"},{"g":"car, automobile"},{"g":"in / on"},null]},{"text":"El barco llevaba muy buena marcha.","en":"The ship traveled at a good speed.","words":[{"g":"the"},{"g":"boat"},{"g":"to take somewhere","l":"llevar"},{"g":"very"},{"g":"good","l":"bueno"},null]}]}