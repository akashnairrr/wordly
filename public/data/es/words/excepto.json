{"id":"excepto","lemma":"excepto","pos":"prep","rank":760,"glosses":["except"],"ipa":"/e(ɡ)ˈθebto/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/06/LL-Q1321_%28spa%29-AdrianAbdulBaha-excepto.wav","examples":[{"text":"Todos se fueron excepto nosotros.","en":"Everyone went except us.","audio":"https://tatoeba.org/en/audio/download/735093","words":[{"g":"all","l":"todo"},{"g":"oneself"},{"g":"to go","l":"ir"},null,{"g":"we"}]},{"text":"Nadie es perfecto, excepto yo.","en":"No one's perfect, except me.","audio":"https://tatoeba.org/en/audio/download/694518","words":[null,null,null,null,{"g":"I"}],"phrases":[[0,3,"nobody's perfect"]]},{"text":"Cualquier día me va bien, excepto el lunes.","en":"Any day will do except Monday.","audio":"https://tatoeba.org/en/audio/download/302978","words":[null,{"g":"day"},{"g":"me"},{"g":"okay"},{"g":"well"},null,{"g":"the"},{"g":"Monday"}]},{"text":"Haré cualquier cosa excepto eso.","en":"I will do anything but that.","audio":"https://tatoeba.org/en/audio/download/703614","words":[{"g":"to do","l":"hacer"},null,{"g":"thing"},null,{"g":"that","l":"ése"}]},{"text":"Tom me dio todo excepto lo que yo quería.","en":"Tom gave me everything except what I wanted.","audio":"https://tatoeba.org/en/audio/download/802306","words":[null,{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"all"},null,null,null,{"g":"I"},{"g":"to desire","l":"querer"}],"phrases":[[5,7,"what, that which"]]}]}