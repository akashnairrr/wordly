{"id":"adonde","lemma":"adonde","pos":"adv","rank":1907,"glosses":["to where, whither","whereto"],"ipa":"/aˈdonde/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Marreromarco-adonde.wav","examples":[{"text":"Su perro le sigue adonde vaya.","en":"His dog follows him wherever he goes.","audio":"https://tatoeba.org/en/audio/download/687458","words":[{"g":"his / her / your"},{"g":"dog"},{"g":"him / her"},{"g":"to follow","l":"seguir"},null,{"g":"what a ..."}]},{"text":"Yo voy adonde yo quiera.","en":"I go where I please.","audio":"https://tatoeba.org/en/audio/download/449375","words":[{"g":"I"},{"g":"to go","l":"ir"},null,{"g":"I"},{"g":"to desire","l":"querer"}]},{"text":"No tengo otro sitio adonde ir.","en":"I have nowhere else to go.","audio":"https://tatoeba.org/en/audio/download/538222","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"someone else"},{"g":"site, place"},null,{"g":"to go"}]},{"text":"Te dije adonde ir.","en":"I told you where to go.","words":[{"g":"you"},{"g":"to say","l":"decir"},null,{"g":"to go"}]},{"text":"Pueden irse adonde quieran.","en":"You can go wherever you want.","audio":"https://tatoeba.org/en/audio/download/721405","words":[{"g":"to be able to, can","l":"poder"},{"g":"to go","l":"ir"},null,{"g":"to desire","l":"querer"}]}]}