{"id":"almuerzo","lemma":"almuerzo","pos":"noun","rank":1198,"glosses":["lunch"],"ipa":"/alˈmweɾθo/","gender":"m","forms":{"plural":"almuerzos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-Eavqwiki-almuerzo.wav","formAudio":{"almuerzos":"https://upload.wikimedia.org/wikipedia/commons/0/06/LL-Q1321_%28spa%29-Eavqwiki-almuerzos.wav"},"examples":[{"text":"El almuerzo está preparado.","en":"Lunch is ready.","audio":"https://tatoeba.org/en/audio/download/440914"},{"text":"Es hora del almuerzo.","en":"It's lunch time.","audio":"https://tatoeba.org/en/audio/download/441858"},{"text":"Yo traeré el almuerzo.","en":"I'll bring lunch.","audio":"https://tatoeba.org/en/audio/download/442760"},{"text":"Te debo un almuerzo.","en":"I owe you a lunch.","audio":"https://tatoeba.org/en/audio/download/443932"},{"text":"Comí un almuerzo liviano.","en":"I ate a light lunch.","audio":"https://tatoeba.org/en/audio/download/449025"}]}