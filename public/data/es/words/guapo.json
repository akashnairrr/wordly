{"id":"guapo","lemma":"guapo","pos":"adj","rank":1249,"glosses":["good-looking; handsome, pretty (describes a man or a woman)","smart or elegant","cool"],"ipa":"/ˈɡwapo/","forms":{"feminine":"guapa","masculinePlural":"guapos","femininePlural":"guapas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-guapo.wav","examples":[{"text":"¿Ella es más guapa que yo?","en":"Is she more beautiful than me?","audio":"https://tatoeba.org/en/audio/download/642150","words":[{"g":"she"},null,null,null,{"g":"that"},{"g":"I"}],"phrases":[[1,3,"furthermore"]]},{"text":"Soy más guapo que tú.","en":"I'm prettier than you.","audio":"https://tatoeba.org/en/audio/download/639180","words":[{"g":"to be","l":"ser"},{"g":"more"},null,{"g":"that"},{"g":"you"}]},{"text":"Me gusta, ¡es tan guapa!","en":"I like her. She's so beautiful!","audio":"https://tatoeba.org/en/audio/download/645594","words":[null,null,{"g":"to be","l":"ser"},{"g":"so, as"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"¿Piensas que eres guapo?","en":"Do you think you're handsome?","audio":"https://tatoeba.org/en/audio/download/582612","words":[{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"to be","l":"ser"},null]},{"text":"Las dos hermanas son muy guapas.","en":"Both sisters are very beautiful.","audio":"https://tatoeba.org/en/audio/download/609622","words":[{"g":"the / them"},{"g":"dung, excrement"},{"g":"sister","l":"hermana"},{"g":"to be","l":"ser"},null,null]}]}