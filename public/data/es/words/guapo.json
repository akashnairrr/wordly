{"id":"guapo","lemma":"guapo","pos":"adj","rank":1252,"glosses":["good-looking; handsome, pretty (describes a man or a woman)","smart or elegant","cool"],"ipa":"/ˈɡwapo/","forms":{"feminine":"guapa","masculinePlural":"guapos","femininePlural":"guapas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-guapo.wav","examples":[{"text":"Él es muy guapo.","en":"He is very handsome.","audio":"https://tatoeba.org/en/audio/download/449853"},{"text":"Ella es muy guapa.","en":"She's very pretty.","audio":"https://tatoeba.org/en/audio/download/37298"},{"text":"Tiene dos hijos muy guapos.","en":"He has two beautiful boys.","audio":"https://tatoeba.org/en/audio/download/933865"},{"text":"Las dos hermanas son muy guapas.","en":"Both sisters are very beautiful.","audio":"https://tatoeba.org/en/audio/download/609622"},{"text":"Es un hombre guapo.","en":"He is a handsome man.","audio":"https://tatoeba.org/en/audio/download/68294"}]}