{"id":"guapo","lemma":"guapo","pos":"adj","rank":1249,"glosses":["good-looking; handsome, pretty (describes a man or a woman)","smart or elegant","cool"],"ipa":"/ˈɡwapo/","forms":{"feminine":"guapa","masculinePlural":"guapos","femininePlural":"guapas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-guapo.wav","examples":[{"text":"Mi hermana era una mujer guapa.","en":"My sister was a beautiful woman.","audio":"https://tatoeba.org/en/audio/download/645642","words":[{"g":"my"},{"g":"sister"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"woman"},null]},{"text":"Es un hombre guapo.","en":"He is a handsome man.","audio":"https://tatoeba.org/en/audio/download/68294","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},null]},{"text":"Es alto y guapo.","en":"He is tall and handsome.","audio":"https://tatoeba.org/en/audio/download/933925","words":[{"g":"to be","l":"ser"},{"g":"tall"},{"g":"and"},null]},{"text":"Ella es realmente guapa.","en":"She is really cute.","audio":"https://tatoeba.org/en/audio/download/450099","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"really"},null]},{"text":"Las dos hermanas son muy guapas.","en":"Both sisters are very beautiful.","audio":"https://tatoeba.org/en/audio/download/609622","words":[{"g":"the / them"},{"g":"dung, excrement"},{"g":"sister","l":"hermana"},{"g":"to be","l":"ser"},null,null]}]}