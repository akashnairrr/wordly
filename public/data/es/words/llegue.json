{"id":"llegue","lemma":"llegue","pos":"noun","rank":878,"glosses":["stab; stabbing"],"ipa":"/ˈʝeɡe/","gender":"m","forms":{"plural":"llegues"},"order":1008,"examples":[{"text":"Le daré tu mensaje cuando llegue.","en":"I'll give him your message when he comes.","audio":"https://tatoeba.org/en/audio/download/1061688","words":[{"g":"him / her"},{"g":"to give, to give out","l":"dar"},{"g":"your"},{"g":"message"},{"g":"when"},null]},{"text":"La reunión habrá terminado cuando llegue.","en":"The meeting will have ended by the time I get there.","audio":"https://tatoeba.org/en/audio/download/422385","words":[{"g":"the / her"},{"g":"meeting"},{"g":"to have","l":"haber"},{"g":"finished"},{"g":"when"},null]},{"text":"Llegue a tiempo.","en":"Be on time.","audio":"https://tatoeba.org/en/audio/download/439095","words":[null,null,null],"phrases":[[1,3,"in time"]]}]}