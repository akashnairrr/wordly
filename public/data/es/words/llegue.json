{"id":"llegue","lemma":"llegue","pos":"noun","rank":880,"glosses":["stab; stabbing"],"ipa":"/ˈʝeɡe/","gender":"m","forms":{"plural":"llegues"},"examples":[{"text":"Perdona que llegue tarde.","en":"I'm sorry I'm late.","audio":"https://tatoeba.org/en/audio/download/449813"},{"text":"Quiero que llegues aquí temprano.","en":"I want you to get here early.","audio":"https://tatoeba.org/en/audio/download/741229"},{"text":"Estoy deseando que llegue.","en":"I'm looking forward to it.","audio":"https://tatoeba.org/en/audio/download/615948"},{"text":"Cenaremos cuando llegues a casa.","en":"We'll have dinner when you get home.","audio":"https://tatoeba.org/en/audio/download/606511"},{"text":"Quien llegue primero, ganará.","en":"Whoever gets there first, wins.","audio":"https://tatoeba.org/en/audio/download/424991"}]}