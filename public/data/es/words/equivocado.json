{"id":"equivocado","lemma":"equivocado","pos":"adj","rank":766,"glosses":["mistaken, wrong"],"ipa":"/ekiboˈkado/","forms":{"feminine":"equivocada","masculinePlural":"equivocados","femininePlural":"equivocadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q1321_%28spa%29-Emanuelps27-equivocado.wav","examples":[{"text":"Puede que esté equivocado.","en":"Maybe I'm wrong.","audio":"https://tatoeba.org/en/audio/download/441838"},{"text":"Agarraste la llave equivocada.","en":"You took the wrong key.","audio":"https://tatoeba.org/en/audio/download/462133"},{"text":"No están equivocados del todo.","en":"You are not at all wrong.","audio":"https://tatoeba.org/en/audio/download/586526"},{"text":"La gente suele tomar las decisiones equivocadas.","en":"People often make bad choices.","audio":"https://tatoeba.org/en/audio/download/518694"},{"text":"Yo podría estar equivocado.","en":"I could be wrong.","audio":"https://tatoeba.org/en/audio/download/442414"}]}