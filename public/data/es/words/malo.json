{"id":"malo","lemma":"malo","pos":"adj","rank":338,"glosses":["bad (of bad quality)","bad (at/with something)","bad (in a bad state)"],"ipa":"/ˈmalo/","forms":{"feminine":"mala","masculinePlural":"malos","femininePlural":"malas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-Rodelar-malo.wav","formAudio":{"mala":"https://upload.wikimedia.org/wikipedia/commons/c/c4/LL-Q1321_%28spa%29-Marreromarco-mala.wav"},"examples":[{"text":"¿Qué tan malo es?","en":"How bad is it?","audio":"https://tatoeba.org/en/audio/download/440095"},{"text":"Tienes muy mala cara.","en":"You look awful.","audio":"https://tatoeba.org/en/audio/download/541044"},{"text":"Tengo días buenos y malos.","en":"I have good days and bad days.","audio":"https://tatoeba.org/en/audio/download/873710"},{"text":"Tengo malas noticias para ti.","en":"I have bad news for you.","audio":"https://tatoeba.org/en/audio/download/459006"},{"text":"Su hijo está malo.","en":"His son is ill.","audio":"https://tatoeba.org/en/audio/download/221745"}]}