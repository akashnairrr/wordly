{"id":"direccio_n","lemma":"dirección","pos":"noun","rank":578,"glosses":["direction","address","management, or running of a business or organisation"],"ipa":"/diɾeɡˈθjon/","gender":"f","forms":{"plural":"direcciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q1321_%28spa%29-AdrianAbdulBaha-direcci%C3%B3n.wav","examples":[{"text":"Aquí está mi dirección.","en":"Here's my address.","audio":"https://tatoeba.org/en/audio/download/443597"},{"text":"Huyeron en todas direcciones.","en":"They fled in all directions.","audio":"https://tatoeba.org/en/audio/download/707092"},{"text":"Acá está la dirección.","en":"Here's the address.","audio":"https://tatoeba.org/en/audio/download/449055"},{"text":"Sé tan cortés como puedas cuando pides direcciones.","en":"Try to be as polite as you can when asking directions.","audio":"https://tatoeba.org/en/audio/download/517963"},{"text":"He olvidado su dirección.","en":"I forgot his address.","audio":"https://tatoeba.org/en/audio/download/453372"}]}