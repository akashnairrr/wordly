{"id":"defecto","lemma":"defecto","pos":"noun","rank":4375,"glosses":["defect, fault, deficiency","flaw, imperfection","default"],"ipa":"/deˈfeɡto/","gender":"m","forms":{"plural":"defectos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d8/LL-Q1321_%28spa%29-Marreromarco-defecto.wav","examples":[{"text":"Todos tenemos defectos.","en":"We all have flaws.","audio":"https://tatoeba.org/en/audio/download/448847","words":[{"g":"all","l":"todo"},{"g":"to have","l":"tener"},null]},{"text":"Este plan no tiene defectos.","en":"This plan has no flaws.","audio":"https://tatoeba.org/en/audio/download/76990","words":[{"g":"this"},{"g":"plan"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Todo hombre tiene sus defectos.","en":"Every man has his faults.","audio":"https://tatoeba.org/en/audio/download/599012","words":[{"g":"all"},{"g":"man"},{"g":"to have","l":"tener"},{"g":"his, her, its, their"},null]},{"text":"¿Estás usando las configuraciones por defecto?","en":"Are you using the default settings?","audio":"https://tatoeba.org/en/audio/download/1187603","words":[{"g":"to be","l":"estar"},{"g":"to use","l":"usar"},{"g":"the / them"},null,{"g":"for / by"},null]},{"text":"Ella tiene sus defectos, pero me gusta.","en":"She has her faults, but I like her.","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"his, her, its, their"},null,{"g":"but"},null,null],"phrases":[[5,7,"like, thumbs up"]]}]}