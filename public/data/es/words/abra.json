{"id":"abra","lemma":"abra","pos":"noun","rank":1757,"glosses":["small bay, inlet","glade, clearing"],"ipa":"/ˈabɾa/","gender":"f","forms":{"plural":"abras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/65/LL-Q1321_%28spa%29-Marreromarco-abra.wav","examples":[{"text":"Abra la caja fuerte.","en":"Open the safe.","audio":"https://tatoeba.org/en/audio/download/501558"},{"text":"No abras las puertas.","en":"Don't open the doors.","audio":"https://tatoeba.org/en/audio/download/731840"},{"text":"Abra bien sus ojos.","en":"Take a good look.","audio":"https://tatoeba.org/en/audio/download/443082"},{"text":"No le abras la puerta a nadie.","en":"Don't open the door for anybody.","audio":"https://tatoeba.org/en/audio/download/354604"},{"text":"No abra la puerta.","en":"Don't open the door.","audio":"https://tatoeba.org/en/audio/download/449885"}]}