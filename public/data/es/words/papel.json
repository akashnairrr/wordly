{"id":"papel","lemma":"papel","pos":"noun","rank":638,"glosses":["paper","role"],"ipa":"/paˈpel/","gender":"m","forms":{"plural":"papeles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-AdrianAbdulBaha-papel.wav","examples":[{"text":"Consígueme algo de papel.","en":"Get me some paper.","audio":"https://tatoeba.org/en/audio/download/443338"},{"text":"¿Dónde están tus papeles?","en":"Where are your papers?","audio":"https://tatoeba.org/en/audio/download/461937"},{"text":"Consígame algo de papel.","en":"Get me some paper.","audio":"https://tatoeba.org/en/audio/download/443339"},{"text":"Se volaron los papeles.","en":"The papers got blown away.","audio":"https://tatoeba.org/en/audio/download/639713"},{"text":"Necesito algo de papel.","en":"I need some paper.","audio":"https://tatoeba.org/en/audio/download/58852"}]}