{"id":"gusto","lemma":"gusto","pos":"noun","rank":517,"glosses":["taste (sense)","taste (flavour)","liking, preference, aesthetic preference"],"ipa":"/ˈɡusto/","gender":"m","forms":{"plural":"gustos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-Marreromarco-gusto.wav","examples":[{"text":"Le gusto a Tom.","en":"Tom likes me.","audio":"https://tatoeba.org/en/audio/download/799555"},{"text":"Es cuestión de gustos.","en":"It's a question of taste.","audio":"https://tatoeba.org/en/audio/download/519184"},{"text":"Gusto a la gente.","en":"People like me.","audio":"https://tatoeba.org/en/audio/download/425215"},{"text":"Para gustos hay colores.","en":"There's no accounting for taste.","audio":"https://tatoeba.org/en/audio/download/524853"},{"text":"Da gusto estar aquí.","en":"I love being here.","audio":"https://tatoeba.org/en/audio/download/422575"}]}