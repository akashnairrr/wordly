{"id":"suerte","lemma":"suerte","pos":"noun","rank":245,"glosses":["luck, fortune","lot, fate","sort, kind, type"],"ipa":"/ˈsweɾte/","gender":"f","forms":{"plural":"suertes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Eavqwiki-suerte.wav","formAudio":{"suertes":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-Eavqwiki-suertes.wav"},"examples":[{"text":"La suerte está en mi contra.","en":"Luck is against me.","audio":"https://tatoeba.org/en/audio/download/798948","words":[{"g":"the / her"},null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"my"},{"g":"antidote"}]},{"text":"Nosotros quizás podríamos tener suerte.","en":"We might get lucky.","audio":"https://tatoeba.org/en/audio/download/800239","words":[{"g":"we"},null,{"g":"to be able to, can","l":"poder"},{"g":"to have"},null]},{"text":"¡De verdad que no tengo suerte!","en":"I really am unlucky!","audio":"https://tatoeba.org/en/audio/download/131750","words":[null,null,{"g":"that"},{"g":"no / not"},{"g":"to have","l":"tener"},null],"phrases":[[0,2,"really"]]},{"text":"Te deseo buena suerte.","en":"I wish you good luck.","audio":"https://tatoeba.org/en/audio/download/453318","words":[{"g":"you"},{"g":"desire, wish"},{"g":"good","l":"bueno"},null]},{"text":"Hoy es mi día de suerte.","en":"Today is my lucky day.","audio":"https://tatoeba.org/en/audio/download/50320","words":[{"g":"today, tonight"},{"g":"to be","l":"ser"},{"g":"my"},{"g":"day"},{"g":"of / from"},null]}]}