{"id":"suerte","lemma":"suerte","pos":"noun","rank":248,"glosses":["luck, fortune","lot, fate","sort, kind, type"],"ipa":"/ˈsweɾte/","gender":"f","forms":{"plural":"suertes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Eavqwiki-suerte.wav","formAudio":{"suertes":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-Eavqwiki-suertes.wav"},"examples":[{"text":"La suerte está echada.","en":"The die is cast.","audio":"https://tatoeba.org/en/audio/download/35747"},{"text":"La suerte no existe.","en":"Luck doesn't exist.","audio":"https://tatoeba.org/en/audio/download/799820"},{"text":"Supongo que tuve suerte.","en":"I guess I was lucky.","audio":"https://tatoeba.org/en/audio/download/449474"},{"text":"Espero que haya suerte.","en":"I hope it goes well.","audio":"https://tatoeba.org/en/audio/download/298922"},{"text":"Deséame suerte por favor.","en":"Please wish me luck.","audio":"https://tatoeba.org/en/audio/download/526683"}]}