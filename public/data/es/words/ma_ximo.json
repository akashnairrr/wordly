{"id":"ma_ximo","lemma":"máximo","pos":"adj","rank":1644,"glosses":["maximum","greatest","utmost"],"ipa":"/ˈmaɡsimo/","forms":{"feminine":"máxima","masculinePlural":"máximos","femininePlural":"máximas"},"order":1694,"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-AdrianAbdulBaha-m%C3%A1ximo.wav","formAudio":{"máxima":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Emanuelps27-m%C3%A1xima.wav"},"examples":[{"text":"Quiere vivir lo máximo posible.","en":"He wants to live as long as he can.","audio":"https://tatoeba.org/en/audio/download/585976","words":[{"g":"to desire","l":"querer"},{"g":"to live"},{"g":"it / him"},null,{"g":"possible"}]},{"text":"Iré contigo máximo hasta el puente.","en":"I'll go with you as far as the bridge.","words":[{"g":"to go","l":"ir"},{"g":"with you"},null,{"g":"until"},{"g":"the"},{"g":"bridge"}]},{"text":"Todos tenemos que vivir la vida al máximo.","en":"We all need to live life to the fullest.","audio":"https://tatoeba.org/en/audio/download/515304","words":[{"g":"all","l":"todo"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to live"},null,null,{"g":"to the"},null],"phrases":[[4,6,"the game"]]}]}