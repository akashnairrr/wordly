{"id":"ma_ximo","lemma":"máximo","pos":"adj","rank":1646,"glosses":["maximum","greatest","utmost"],"ipa":"/ˈmaɡsimo/","forms":{"feminine":"máxima","masculinePlural":"máximos","femininePlural":"máximas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-AdrianAbdulBaha-m%C3%A1ximo.wav","formAudio":{"máxima":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Emanuelps27-m%C3%A1xima.wav"},"examples":[{"text":"Prometimos esforzarnos al máximo.","en":"We promised to do our best.","audio":"https://tatoeba.org/en/audio/download/871452"},{"text":"No excedas la máxima velocidad.","en":"Don't exceed the speed limit.","audio":"https://tatoeba.org/en/audio/download/553736"},{"text":"Quiere vivir lo máximo posible.","en":"He wants to live as long as he can.","audio":"https://tatoeba.org/en/audio/download/585976"},{"text":"Ella recibió la pena máxima de diez años.","en":"She received the maximum sentence of ten years.","audio":"https://tatoeba.org/en/audio/download/874712"},{"text":"Ella pagará el máximo de cincuenta dólares.","en":"She will pay 50 dollars at most.","audio":"https://tatoeba.org/en/audio/download/788388"}]}