{"id":"apariencia","lemma":"apariencia","pos":"noun","rank":2682,"glosses":["appearance (semblance, or apparent likeness)","appearance (personal presence)"],"ipa":"/apaˈɾjenθja/","gender":"f","forms":{"plural":"apariencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fb/LL-Q1321_%28spa%29-AdrianAbdulBaha-apariencia.wav","examples":[{"text":"Tiene mucho orgullo en su apariencia.","en":"He has too much pride in his appearance.","words":[{"g":"to have","l":"tener"},{"g":"much"},{"g":"pride"},{"g":"in / on"},{"g":"his / her / your"},null]},{"text":"Ella consiguió mantener las apariencias.","en":"She managed to keep up appearances.","audio":"https://tatoeba.org/en/audio/download/687456","words":[{"g":"she"},{"g":"to achieve","l":"conseguir"},{"g":"to keep"},{"g":"the / them"},null]},{"text":"¿Estás feliz con tu apariencia?","en":"Are you happy with how you look?","words":[{"g":"to be","l":"estar"},{"g":"happy, merry"},{"g":"with"},{"g":"your"},null]},{"text":"Las apariencias pueden ser engañosas.","en":"Looks can be deceptive.","audio":"https://tatoeba.org/en/audio/download/630657","words":[{"g":"the / them"},null,{"g":"to be able to, can","l":"poder"},{"g":"to be"},{"g":"deceitful, deceptive","l":"engañoso"}]},{"text":"No me gusta su apariencia.","en":"I don't like his looks.","words":[{"g":"no / not"},null,null,{"g":"his / her / your"},null],"phrases":[[1,3,"like, thumbs up"]]}]}