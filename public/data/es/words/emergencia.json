{"id":"emergencia","lemma":"emergencia","pos":"noun","rank":1057,"glosses":["emergency","emergence"],"ipa":"/emeɾˈxenθja/","gender":"f","forms":{"plural":"emergencias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-AdrianAbdulBaha-emergencia.wav","examples":[{"text":"¿Cuál es la emergencia?","en":"What's the emergency?","audio":"https://tatoeba.org/en/audio/download/454059"},{"text":"Repórtelo a la sala de emergencias.","en":"Report to the emergency room."},{"text":"Es una emergencia, Tom.","en":"It's an emergency, Tom.","audio":"https://tatoeba.org/en/audio/download/270293"},{"text":"Comuníquelo a la sala de emergencias.","en":"Report to the emergency room."},{"text":"¿Cuál es su emergencia?","en":"What is your emergency?","audio":"https://tatoeba.org/en/audio/download/461867"}]}