{"id":"fallo","lemma":"fallo","pos":"noun","rank":2838,"glosses":["mistake","failure","verdict, decision"],"ipa":"/ˈfaʝo/","gender":"m","forms":{"plural":"fallos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q1321_%28spa%29-Marreromarco-fallo.wav","examples":[{"text":"Fue tu fallo.","en":"It was your mistake.","audio":"https://tatoeba.org/en/audio/download/448431","words":[{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Pienso que todos hemos tenido fallos.","en":"I think we've all made mistakes.","audio":"https://tatoeba.org/en/audio/download/299243","words":[{"g":"animal feed"},{"g":"that"},{"g":"all","l":"todo"},{"g":"heme","l":"hemo"},{"g":"to have","l":"tener"},null]},{"text":"Este fallo no es mío.","en":"That's not my mistake.","audio":"https://tatoeba.org/en/audio/download/299091","words":[{"g":"this"},null,{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"mine"}]},{"text":"Siempre encuentra fallos en la gente.","en":"He is always finding fault with other people.","audio":"https://tatoeba.org/en/audio/download/706002","words":[{"g":"always"},{"g":"to meet","l":"encontrar"},null,{"g":"in / on"},{"g":"the / her"},{"g":"people"}]},{"text":"Nunca fallo.","en":"I never fail.","audio":"https://tatoeba.org/en/audio/download/578410","words":[{"g":"never"},null]}]}