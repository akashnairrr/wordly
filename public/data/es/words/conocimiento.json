{"id":"conocimiento","lemma":"conocimiento","pos":"noun","rank":1566,"glosses":["knowledge","awareness (state of knowing something)","consciousness (state of having cognition and sensation)"],"ipa":"/konoθiˈmjento/","gender":"m","forms":{"plural":"conocimientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-conocimiento.wav","examples":[{"text":"Mi tío tiene un buen conocimiento del francés.","en":"My uncle has a good knowledge of French.","audio":"https://tatoeba.org/en/audio/download/607937","words":[{"g":"my"},{"g":"uncle"},{"g":"to have","l":"tener"},{"g":"a"},null,null,{"g":"of the"},{"g":"French"}]},{"text":"De repente, perdí el conocimiento.","en":"Suddenly, I blacked out.","audio":"https://tatoeba.org/en/audio/download/703751","words":[null,null,{"g":"to lose","l":"perder"},{"g":"the"},null],"phrases":[[0,2,"suddenly"]]},{"text":"El hombre era una fuente de conocimientos.","en":"The man was a fountain of knowledge.","words":[{"g":"the"},{"g":"man"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"spring , fountain"},{"g":"of / from"},null]},{"text":"¿Perdiste el conocimiento después del accidente?","en":"Did you lose consciousness after the accident?","words":[{"g":"to lose","l":"perder"},{"g":"the"},null,{"g":"later"},{"g":"of the"},{"g":"accident"}]},{"text":"Mis conocimientos de japonés son más bien pobres.","en":"My knowledge of Japanese is rather poor.","words":[{"g":"my"},null,{"g":"of / from"},{"g":"of Japan"},{"g":"to be","l":"ser"},null,null,{"g":"poor","l":"pobre"}],"phrases":[[5,7,"rather, slightly"]]}]}