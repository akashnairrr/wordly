{"id":"conductor","lemma":"conductor","pos":"noun","rank":1576,"glosses":["driver","motorist","presenter; host (of a television show)"],"ipa":"/konduɡˈtoɾ/","gender":"m","forms":{"plural":"conductores","feminine":"conductora","femininePlural":"conductoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q1321_%28spa%29-AdrianAbdulBaha-conductor.wav","examples":[{"text":"Mi padre es conductor de autobús.","en":"My father is a bus driver.","audio":"https://tatoeba.org/en/audio/download/765632","words":[{"g":"my"},{"g":"father, parent"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"bus, coach"}]},{"text":"¿Conoces al conductor del autobús?","en":"Do you know the bus driver?","audio":"https://tatoeba.org/en/audio/download/532303","words":[{"g":"to know","l":"conocer"},{"g":"to the"},null,{"g":"of the"},{"g":"bus, coach"}]},{"text":"Muchos conductores abandonaron sus coches en la nieve.","en":"Many drivers abandoned their cars in the snow.","audio":"https://tatoeba.org/en/audio/download/705363","words":[{"g":"much","l":"mucho"},null,{"g":"to abandon, to leave","l":"abandonar"},{"g":"his, her, its, their"},{"g":"car, automobile","l":"coche"},{"g":"in / on"},{"g":"the / her"},{"g":"snow"}]},{"text":"Él es mal conductor.","en":"He is a bad driver.","audio":"https://tatoeba.org/en/audio/download/450493","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"badly, poorly, ill"},null]},{"text":"Eres un buen conductor.","en":"You're a good driver.","audio":"https://tatoeba.org/en/audio/download/519625","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null]}]}