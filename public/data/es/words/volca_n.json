{"id":"volca_n","lemma":"volcán","pos":"noun","rank":4544,"glosses":["volcano"],"ipa":"/bolˈkan/","gender":"m","forms":{"plural":"volcanes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-AdrianAbdulBaha-volc%C3%A1n.wav","examples":[{"text":"Es peligroso vivir cerca de un volcán.","en":"It's dangerous to live near a volcano.","audio":"https://tatoeba.org/en/audio/download/568246","words":[{"g":"to be","l":"ser"},{"g":"perilous, dangerous"},{"g":"to live"},null,null,{"g":"a"},null],"phrases":[[3,5,"close to"]]},{"text":"El volcán se ha activado de nuevo.","en":"The volcano has become active again.","audio":"https://tatoeba.org/en/audio/download/937517","words":[{"g":"the"},null,{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"activated, enabled"},null,null],"phrases":[[5,7,"again"]]},{"text":"Islandia tiene muchos volcanes.","en":"Iceland has many volcanoes.","audio":"https://tatoeba.org/en/audio/download/734480","words":[null,{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},null]},{"text":"Si hay casas cerca, un volcán puede crear un desastre.","en":"If there are houses nearby, a volcano can create a disaster.","words":[{"g":"if, whether"},{"g":"to have","l":"haber"},{"g":"house","l":"casa"},{"g":"close"},{"g":"a"},null,{"g":"to be able to, can","l":"poder"},{"g":"to create"},{"g":"a"},{"g":"disaster"}]},{"text":"Hay muchos volcanes activos en Japón.","en":"There are many active volcanoes in Japan.","audio":"https://tatoeba.org/en/audio/download/590315","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"active","l":"activo"},{"g":"in / on"},{"g":"Japanese"}]}]}