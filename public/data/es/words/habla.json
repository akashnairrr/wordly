{"id":"habla","lemma":"habla","pos":"noun","rank":334,"glosses":["speech (faculty of speech)","speaking (action)"],"ipa":"/ˈabla/","gender":"f","forms":{"plural":"hablas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8e/LL-Q1321_%28spa%29-AdrianAbdulBaha-habla.wav","formAudio":{"hablas":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-Wikipedian-walker-hablas.wav"},"examples":[{"text":"Habla en voz baja.","en":"Speak softly.","audio":"https://tatoeba.org/en/audio/download/438906"},{"text":"Sé que hablas francés.","en":"I know you speak French.","audio":"https://tatoeba.org/en/audio/download/302504"},{"text":"Ella habla con franqueza.","en":"She speaks frankly.","audio":"https://tatoeba.org/en/audio/download/448398"},{"text":"Me gusta cómo hablas.","en":"I like the way you talk.","audio":"https://tatoeba.org/en/audio/download/460430"},{"text":"Habla por ti mismo.","en":"Speak for yourself.","audio":"https://tatoeba.org/en/audio/download/448401"}]}