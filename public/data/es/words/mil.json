{"id":"mil","lemma":"mil","pos":"noun","rank":492,"glosses":["thousand (1000 units of something) (usually in an indefinite sense)"],"ipa":"/ˈmil/","gender":"m","forms":{"plural":"miles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-AdrianAbdulBaha-mil.wav","formAudio":{"miles":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Precision27-miles.wav"},"examples":[{"text":"Ella tiene dos mil libros.","en":"She has two thousand books.","audio":"https://tatoeba.org/en/audio/download/34941","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null,{"g":"book","l":"libro"}]},{"text":"Tengo mil cosas que hacer.","en":"I have a ton of stuff to do.","audio":"https://tatoeba.org/en/audio/download/1152200","words":[{"g":"to have","l":"tener"},null,{"g":"thing","l":"cosa"},{"g":"that"},{"g":"to do"}]},{"text":"Murieron casi tres mil personas.","en":"Almost three thousand people died.","audio":"https://tatoeba.org/en/audio/download/598486","words":[{"g":"to die","l":"morir"},{"g":"almost"},{"g":"three"},null,{"g":"person (an individual","l":"persona"}]},{"text":"Hay diez mil estudiantes en esta universidad.","en":"There are ten thousand students in this university.","audio":"https://tatoeba.org/en/audio/download/703533","words":[{"g":"to have","l":"haber"},{"g":"A"},null,{"g":"student","l":"estudiante"},{"g":"in / on"},{"g":"this","l":"este"},{"g":"university, college"}]},{"text":"¿Mil yenes son suficiente?","en":"Is one thousand yen enough?","audio":"https://tatoeba.org/en/audio/download/607917","words":[null,{"g":"yen","l":"yen"},{"g":"to be","l":"ser"},{"g":"sufficient, enough"}]}]}