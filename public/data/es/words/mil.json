{"id":"mil","lemma":"mil","pos":"noun","rank":495,"glosses":["thousand (1000 units of something) (usually in an indefinite sense)"],"ipa":"/ˈmil/","gender":"m","forms":{"plural":"miles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-AdrianAbdulBaha-mil.wav","formAudio":{"miles":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Precision27-miles.wav"},"examples":[{"text":"¿Mil yenes son suficientes?","en":"Is a thousand yen enough?","audio":"https://tatoeba.org/en/audio/download/585827"},{"text":"Miles perdieron su trabajo.","en":"Thousands of people lost their jobs.","audio":"https://tatoeba.org/en/audio/download/585787"},{"text":"¿Mil yenes son suficiente?","en":"Is one thousand yen enough?","audio":"https://tatoeba.org/en/audio/download/607917"},{"text":"Miles se quedaron sin trabajo.","en":"Thousands of people lost their jobs.","audio":"https://tatoeba.org/en/audio/download/585786"},{"text":"Tengo mil quinientas vacas.","en":"I have fifteen hundred cows.","audio":"https://tatoeba.org/en/audio/download/531609"}]}