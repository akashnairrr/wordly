{"id":"contra","lemma":"contra","pos":"noun","rank":224,"glosses":["antidote","counterpunch","counterattack"],"ipa":"/ˈkontɾa/","gender":"f","forms":{"plural":"contras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/66/LL-Q1321_%28spa%29-Precision27-contra.wav","formAudio":{"contras":"https://upload.wikimedia.org/wikipedia/commons/8/81/LL-Q1321_%28spa%29-Eavqwiki-contras.wav"},"examples":[{"text":"Yo estoy en contra.","en":"I'm against it.","audio":"https://tatoeba.org/en/audio/download/525397"},{"text":"Choqué contra un árbol.","en":"I ran into a tree.","audio":"https://tatoeba.org/en/audio/download/444432"},{"text":"Es contra las reglas.","en":"It's against the rules.","audio":"https://tatoeba.org/en/audio/download/461372"},{"text":"Ninguno votó en contra.","en":"No one voted against it.","audio":"https://tatoeba.org/en/audio/download/586380"},{"text":"Ella testificó contra él.","en":"She testified against him.","audio":"https://tatoeba.org/en/audio/download/70041"}]}