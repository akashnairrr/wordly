{"id":"caja","lemma":"caja","pos":"noun","rank":550,"glosses":["box, case","bank","cash desk"],"ipa":"/ˈkaxa/","gender":"f","forms":{"plural":"cajas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9c/LL-Q1321_%28spa%29-AdrianAbdulBaha-caja.wav","examples":[{"text":"Abra la caja fuerte.","en":"Open the safe.","audio":"https://tatoeba.org/en/audio/download/501558"},{"text":"¿Abriste todas las cajas?","en":"Did you open all the boxes?","audio":"https://tatoeba.org/en/audio/download/585948"},{"text":"Esto es una caja.","en":"This is a box.","audio":"https://tatoeba.org/en/audio/download/798012"},{"text":"Las cajas no están alineadas.","en":"The boxes aren't lined up.","audio":"https://tatoeba.org/en/audio/download/731466"},{"text":"La caja está aquí.","en":"The box is here.","audio":"https://tatoeba.org/en/audio/download/819790"}]}