{"id":"salido","lemma":"salido","pos":"adj","rank":926,"glosses":["sticking out","on heat","horny"],"ipa":"/saˈlido/","forms":{"feminine":"salida","masculinePlural":"salidos","femininePlural":"salidas"},"formAudio":{"salida":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-AdrianAbdulBaha-salida.wav"},"examples":[{"text":"Mi madre ha salido.","en":"My mother is out.","audio":"https://tatoeba.org/en/audio/download/443050"},{"text":"Estoy registrando mi salida.","en":"I'm checking out.","audio":"https://tatoeba.org/en/audio/download/501411"},{"text":"El edificio tiene salidas por todos lados.","en":"The building has exits on all sides."},{"text":"Ha salido la luna.","en":"The moon has come out.","audio":"https://tatoeba.org/en/audio/download/460968"},{"text":"Le mostraré la salida.","en":"I'll walk you out.","audio":"https://tatoeba.org/en/audio/download/523387"}]}