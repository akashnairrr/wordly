{"id":"salido","lemma":"salido","pos":"adj","rank":923,"glosses":["sticking out","on heat","horny"],"ipa":"/saˈlido/","forms":{"feminine":"salida","masculinePlural":"salidos","femininePlural":"salidas"},"formAudio":{"salida":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-AdrianAbdulBaha-salida.wav"},"examples":[{"text":"Mi madre ha salido.","en":"My mother is out.","audio":"https://tatoeba.org/en/audio/download/443050","words":[{"g":"my"},{"g":"mother"},{"g":"to have","l":"haber"},null]},{"text":"¿No habías salido?","en":"Didn't you go out?","audio":"https://tatoeba.org/en/audio/download/444395","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null]},{"text":"No deberías haber salido con mi novia.","en":"You'd better not have gone out with my girlfriend.","audio":"https://tatoeba.org/en/audio/download/691508","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to have"},null,{"g":"with"},{"g":"my"},{"g":"a type of sweet roll"}]},{"text":"Ha salido la luna.","en":"The moon has come out.","audio":"https://tatoeba.org/en/audio/download/460968","words":[{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"moon"}]},{"text":"El sol aún no ha salido.","en":"The sun hasn't risen yet.","audio":"https://tatoeba.org/en/audio/download/585768","words":[{"g":"the"},{"g":"sun"},{"g":"still, yet"},{"g":"no / not"},{"g":"to have","l":"haber"},null]}]}