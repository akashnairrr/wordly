{"id":"salido","lemma":"salido","pos":"adj","rank":923,"glosses":["sticking out","on heat","horny"],"ipa":"/saˈlido/","forms":{"feminine":"salida","masculinePlural":"salidos","femininePlural":"salidas"},"formAudio":{"salida":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-AdrianAbdulBaha-salida.wav"},"examples":[{"text":"Mi madre ha salido.","en":"My mother is out.","audio":"https://tatoeba.org/en/audio/download/443050","words":[{"g":"my"},{"g":"mother"},{"g":"to have","l":"haber"},null]},{"text":"Hoy no ha salido el sol.","en":"The sun hasn't come out today.","audio":"https://tatoeba.org/en/audio/download/523647","words":[{"g":"today, tonight"},{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"sun"}]},{"text":"Deberías haber salido media hora antes.","en":"You should have left half an hour earlier.","audio":"https://tatoeba.org/en/audio/download/610718","words":[{"g":"to owe","l":"deber"},{"g":"to have"},null,null,null,{"g":"earlier"}],"phrases":[[3,5,"half-hour"]]},{"text":"Ha salido la luna.","en":"The moon has come out.","audio":"https://tatoeba.org/en/audio/download/460968","words":[{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"moon"}]},{"text":"Parece que él ha salido del país.","en":"He seems to have left the country.","audio":"https://tatoeba.org/en/audio/download/733628","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"he"},{"g":"to have","l":"haber"},null,{"g":"of the"},{"g":"country"}]}]}