{"id":"dormido","lemma":"dormido","pos":"adj","rank":1191,"glosses":["asleep, sleeping","numb"],"ipa":"/doɾˈmido/","forms":{"feminine":"dormida","masculinePlural":"dormidos","femininePlural":"dormidas"},"examples":[{"text":"¿Qué tal has dormido?","en":"How'd you sleep?","audio":"https://tatoeba.org/en/audio/download/798046"},{"text":"Mi hija está profundamente dormida.","en":"My daughter is fast asleep.","audio":"https://tatoeba.org/en/audio/download/71008"},{"text":"Los niños están dormidos.","en":"The kids are asleep.","audio":"https://tatoeba.org/en/audio/download/39717"},{"text":"Pensé que estaban dormidas.","en":"I thought you were asleep."},{"text":"Tom se cayó dormido.","en":"Tom fell asleep.","audio":"https://tatoeba.org/en/audio/download/799170"}]}