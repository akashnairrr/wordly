{"id":"dormido","lemma":"dormido","pos":"adj","rank":1188,"glosses":["asleep, sleeping","numb"],"ipa":"/doɾˈmido/","forms":{"feminine":"dormida","masculinePlural":"dormidos","femininePlural":"dormidas"},"examples":[{"text":"Parece estar dormido.","en":"He seems to be asleep.","audio":"https://tatoeba.org/en/audio/download/35039","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},null]},{"text":"¿Ha dormido bien?","en":"Did she sleep well?","audio":"https://tatoeba.org/en/audio/download/637137","words":[{"g":"to have","l":"haber"},null,{"g":"well"}]},{"text":"Todos estábamos dormidos.","en":"We were all asleep.","audio":"https://tatoeba.org/en/audio/download/501466","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},null]},{"text":"Tengo algo dormida la mano izquierda.","en":"I have some numbness in my left hand.","audio":"https://tatoeba.org/en/audio/download/531865","words":[{"g":"to have","l":"tener"},{"g":"something, anything"},null,{"g":"the / her"},null,null],"phrases":[[4,6,"left hand"]]},{"text":"Puede que mi padre esté dormido.","en":"My father may be sleeping.","audio":"https://tatoeba.org/en/audio/download/48355","words":[null,null,{"g":"my"},{"g":"father, parent"},{"g":"to be","l":"estar"},null],"phrases":[[0,2,"it may be that"]]}]}