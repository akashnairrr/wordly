{"id":"terminado","lemma":"terminado","pos":"adj","rank":530,"glosses":["finished"],"ipa":"/teɾmiˈnado/","forms":{"feminine":"terminada","masculinePlural":"terminados","femininePlural":"terminadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-AdrianAbdulBaha-terminado.wav","examples":[{"text":"¿Lo has terminado?","en":"Have you finished it?","audio":"https://tatoeba.org/en/audio/download/38573","words":[{"g":"it / him"},{"g":"to have","l":"haber"},null]},{"text":"¿Ya has terminado el trabajo?","en":"Have you finished the work yet?","audio":"https://tatoeba.org/en/audio/download/551582","words":[{"g":"now"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"work, job"}]},{"text":"¿Has terminado tu parte del trabajo?","en":"Have you finished your share of the work?","audio":"https://tatoeba.org/en/audio/download/689121","words":[{"g":"to have","l":"haber"},null,{"g":"your"},{"g":"part"},{"g":"of the"},{"g":"work, job"}]},{"text":"Hemos terminado el trabajo para hoy.","en":"We have finished the work for today.","audio":"https://tatoeba.org/en/audio/download/635502","words":[{"g":"heme","l":"hemo"},null,{"g":"the"},{"g":"work, job"},{"g":"for"},{"g":"today, tonight"}]},{"text":"Mi tarea al fin estaba terminada.","en":"My homework was finally finished.","words":[{"g":"my"},{"g":"task"},null,null,{"g":"to be","l":"estar"},null],"phrases":[[2,4,"at last"]]}]}