{"id":"terminado","lemma":"terminado","pos":"adj","rank":533,"glosses":["finished"],"ipa":"/teɾmiˈnado/","forms":{"feminine":"terminada","masculinePlural":"terminados","femininePlural":"terminadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/ba/LL-Q1321_%28spa%29-AdrianAbdulBaha-terminado.wav","examples":[{"text":"He terminado de comer.","en":"I'm done eating.","audio":"https://tatoeba.org/en/audio/download/567546"},{"text":"La negociación está terminada.","en":"The negotiation is off."},{"text":"Importamos materia prima y exportamos los productos terminados.","en":"We import raw materials and export the finished products.","audio":"https://tatoeba.org/en/audio/download/705424"},{"text":"El verano ha terminado.","en":"Summer has ended.","audio":"https://tatoeba.org/en/audio/download/442977"},{"text":"Mi tarea al fin estaba terminada.","en":"My homework was finally finished."}]}