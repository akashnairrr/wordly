{"id":"busca","lemma":"busca","pos":"noun","rank":702,"glosses":["search (an attempt to find something)"],"ipa":"/ˈbuska/","gender":"f","forms":{"plural":"buscas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-Marreromarco-busca.wav","examples":[{"text":"¿Qué busca usted?","en":"What are you looking for?","audio":"https://tatoeba.org/en/audio/download/509774","words":[{"g":"what"},null,{"g":"you (formal)"}]},{"text":"Todo el mundo busca la felicidad.","en":"Everyone seeks happiness.","audio":"https://tatoeba.org/en/audio/download/527499","words":[null,null,null,null,{"g":"the / her"},{"g":"happiness"}],"phrases":[[0,3,"everyone, everybody"]]},{"text":"Fuimos en busca de oro.","en":"We went in search of gold.","audio":"https://tatoeba.org/en/audio/download/587246","words":[{"g":"to go","l":"ir"},{"g":"in / on"},null,{"g":"of / from"},{"g":"gold."}]},{"text":"Busca allí.","en":"Look in there.","audio":"https://tatoeba.org/en/audio/download/424945","words":[null,{"g":"there"}]},{"text":"Él busca un mejor trabajo.","en":"He is after a better job.","words":[{"g":"he"},null,{"g":"a"},{"g":"better"},{"g":"work, job"}]}]}