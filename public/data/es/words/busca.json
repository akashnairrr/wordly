{"id":"busca","lemma":"busca","pos":"noun","rank":705,"glosses":["search (an attempt to find something)"],"ipa":"/ˈbuska/","gender":"f","forms":{"plural":"buscas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-Marreromarco-busca.wav","examples":[{"text":"Fuimos en busca de oro.","en":"We went in search of gold.","audio":"https://tatoeba.org/en/audio/download/587246"},{"text":"¿Por qué las buscas?","en":"Why are you looking for them?","audio":"https://tatoeba.org/en/audio/download/352167"},{"text":"Todo el mundo busca la felicidad.","en":"Everyone seeks happiness.","audio":"https://tatoeba.org/en/audio/download/527499"},{"text":"¿Qué es lo que buscas?","en":"What is it that you're looking for?","audio":"https://tatoeba.org/en/audio/download/769708"},{"text":"Busca esa palabra en el diccionario.","en":"Look that word up in the dictionary.","audio":"https://tatoeba.org/en/audio/download/707036"}]}