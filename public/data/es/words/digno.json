{"id":"digno","lemma":"digno","pos":"adj","rank":2731,"glosses":["worthy","honorable","dignified, respectful"],"ipa":"/ˈdiɡno/","forms":{"feminine":"digna","masculinePlural":"dignos","femininePlural":"dignas"},"order":2737,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Marreromarco-digno.wav","examples":[{"text":"¡Qué hombre tan digno!","en":"What a dignified man!","audio":"https://tatoeba.org/en/audio/download/637156","words":[{"g":"what"},{"g":"man"},{"g":"so, as"},null]},{"text":"No todos los libros son dignos de ser leídos.","en":"Not all books are worth reading.","words":[{"g":"no / not"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"book","l":"libro"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"to be"},{"g":"well-read","l":"leído"}]},{"text":"Sus temerarias acciones son dignas de una medalla.","en":"His brave action is worthy of a medal.","audio":"https://tatoeba.org/en/audio/download/64759","words":[{"g":"his, her, its, their"},null,{"g":"action, act, deed","l":"acción"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"a"},{"g":"medal"}]}]}