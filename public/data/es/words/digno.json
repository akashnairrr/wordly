{"id":"digno","lemma":"digno","pos":"adj","rank":2730,"glosses":["worthy","honorable","dignified, respectful"],"ipa":"/ˈdiɡno/","forms":{"feminine":"digna","masculinePlural":"dignos","femininePlural":"dignas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Marreromarco-digno.wav","examples":[{"text":"¡Qué hombre tan digno!","en":"What a dignified man!","audio":"https://tatoeba.org/en/audio/download/637156","words":[{"g":"what"},{"g":"man"},{"g":"so, as"},null]},{"text":"Sus temerarias acciones son dignas de una medalla.","en":"His brave action is worthy of a medal.","audio":"https://tatoeba.org/en/audio/download/64759","words":[{"g":"his, her, its, their"},null,{"g":"action, act, deed","l":"acción"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"a"},{"g":"medal"}]},{"text":"No todos los libros son dignos de ser leídos.","en":"Not all books are worth reading.","words":[{"g":"no / not"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"book","l":"libro"},{"g":"to be","l":"ser"},null,{"g":"of / from"},{"g":"to be"},{"g":"well-read","l":"leído"}]},{"text":"Tom parece ser digno de confianza, ¿a que sí?","en":"Tom is very dependable, isn't he?","audio":"https://tatoeba.org/en/audio/download/801377","words":[null,{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},null,null,null,null,null,null],"phrases":[[4,6,"close"],[6,9,"isn't it?"]]},{"text":"Tom es muy trabajador y digno de confianza.","en":"Tom is hardworking and dependable.","words":[null,{"g":"to be","l":"ser"},null,{"g":"worker"},{"g":"and"},null,null,null],"phrases":[[6,8,"close"]]}]}