{"id":"tambie_n","lemma":"también","pos":"adv","rank":89,"glosses":["also, too, as well","so"],"ipa":"/tamˈbjen/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-tambi%C3%A9n.wav","examples":[{"text":"Yo también tengo 17 años.","en":"I'm 17, too.","audio":"https://tatoeba.org/en/audio/download/35755"},{"text":"¿Puedo ir yo también?","en":"Can I go, too?","audio":"https://tatoeba.org/en/audio/download/440125"},{"text":"Yo lo vi, también.","en":"I saw it, too.","audio":"https://tatoeba.org/en/audio/download/440377"},{"text":"¿También puedo venir yo?","en":"Can I come too?","audio":"https://tatoeba.org/en/audio/download/440595"},{"text":"Él también lo vio.","en":"He also saw it.","audio":"https://tatoeba.org/en/audio/download/550058"}]}