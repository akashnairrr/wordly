{"id":"final","lemma":"final","pos":"adj","rank":316,"glosses":["final (last, ultimate)","final (conclusive, decisive)"],"ipa":"/fiˈnal/","forms":{"femininePlural":"finales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-AdrianAbdulBaha-final.wav","examples":[{"text":"Al final no vino.","en":"In the end, he did not come.","audio":"https://tatoeba.org/en/audio/download/641981","words":[{"g":"to the"},null,{"g":"no / not"},{"g":"to come","l":"venir"}]},{"text":"¿Es esa tu decisión final?","en":"Is that your final decision?","words":[{"g":"to be","l":"ser"},{"g":"that","l":"ese"},{"g":"your"},{"g":"decision"},null]},{"text":"No puedo ver el final.","en":"I can't see the end.","audio":"https://tatoeba.org/en/audio/download/201685","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"the"},null]},{"text":"Es el final del año.","en":"It's the end of the year.","audio":"https://tatoeba.org/en/audio/download/301207","words":[{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of the"},{"g":"year"}]},{"text":"Eso ocurrió a finales de octubre.","en":"That happened in late October.","words":[{"g":"that","l":"ése"},{"g":"to happen, to occur","l":"ocurrir"},{"g":"to"},null,{"g":"of / from"},{"g":"October"}]}]}