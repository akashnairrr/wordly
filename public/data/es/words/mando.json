{"id":"mando","lemma":"mando","pos":"noun","rank":1067,"glosses":["command","remote control","controller, gamepad, joypad"],"ipa":"/ˈmando/","gender":"m","forms":{"plural":"mandos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-mando.wav","examples":[{"text":"¿Quién está al mando?","en":"Who's in charge?","audio":"https://tatoeba.org/en/audio/download/442250"},{"text":"Los mandos del avión no funcionaban.","en":"The controls of the plane were out of order."},{"text":"Tom está al mando.","en":"Tom is in command.","audio":"https://tatoeba.org/en/audio/download/799965"},{"text":"Tú estás al mando.","en":"You're in command.","audio":"https://tatoeba.org/en/audio/download/448738"},{"text":"Ahora estoy al mando.","en":"I'm in command now.","audio":"https://tatoeba.org/en/audio/download/448739"}]}