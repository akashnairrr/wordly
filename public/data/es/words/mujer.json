{"id":"mujer","lemma":"mujer","pos":"noun","rank":149,"glosses":["woman","wife"],"ipa":"/muˈxeɾ/","gender":"f","forms":{"plural":"mujeres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-Precision27-mujer.wav","formAudio":{"mujeres":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-Marreromarco-mujeres.wav"},"examples":[{"text":"Ella es mi mujer.","en":"She's my wife.","audio":"https://tatoeba.org/en/audio/download/765396"},{"text":"Me gustan las mujeres.","en":"I like women.","audio":"https://tatoeba.org/en/audio/download/438146"},{"text":"¿Cómo está tu mujer?","en":"How's the wife?","audio":"https://tatoeba.org/en/audio/download/441491"},{"text":"Las mujeres me odian.","en":"Women hate me.","audio":"https://tatoeba.org/en/audio/download/443101"},{"text":"Para a esa mujer.","en":"Stop that woman.","audio":"https://tatoeba.org/en/audio/download/424958"}]}