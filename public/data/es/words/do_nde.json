{"id":"do_nde","lemma":"dónde","pos":"adv","rank":78,"glosses":["where?; in what place?"],"ipa":"/ˈdonde/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q1321_%28spa%29-Rodelar-d%C3%B3nde.wav","examples":[{"text":"Mira por dónde caminas.","en":"Mind your step.","audio":"https://tatoeba.org/en/audio/download/734360"},{"text":"¿Dónde está mi bolso?","en":"Where's my bag?","audio":"https://tatoeba.org/en/audio/download/140438"},{"text":"¿Dónde está mi coche?","en":"Where's my car?","audio":"https://tatoeba.org/en/audio/download/441323"},{"text":"¿Dónde está mi té?","en":"Where's my tea?","audio":"https://tatoeba.org/en/audio/download/92601"},{"text":"¿A dónde fue él?","en":"Where did he go?","audio":"https://tatoeba.org/en/audio/download/501134"}]}