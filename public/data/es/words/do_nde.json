{"id":"do_nde","lemma":"dónde","pos":"adv","rank":78,"glosses":["where?; in what place?"],"ipa":"/ˈdonde/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q1321_%28spa%29-Rodelar-d%C3%B3nde.wav","examples":[{"text":"¿Dónde hacen eso?","en":"Where do they do that?","audio":"https://tatoeba.org/en/audio/download/461782","words":[null,{"g":"to do","l":"hacer"},{"g":"that","l":"ése"}]},{"text":"¿Dónde puedo comprar café?","en":"Where can I buy coffee?","audio":"https://tatoeba.org/en/audio/download/461988","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to buy"},{"g":"coffee"}]},{"text":"¿De dónde vino?","en":"Where did he come from?","audio":"https://tatoeba.org/en/audio/download/461802","words":[{"g":"of / from"},null,{"g":"to come","l":"venir"}]},{"text":"Sabes dónde trabajo.","en":"You know where I work.","audio":"https://tatoeba.org/en/audio/download/459351","words":[{"g":"to know, to understand","l":"saber"},null,{"g":"work, job"}]},{"text":"La pregunta ahora es dónde.","en":"The question now is where.","audio":"https://tatoeba.org/en/audio/download/506519","words":[{"g":"the / her"},{"g":"question"},{"g":"now"},{"g":"to be","l":"ser"},null]}]}