{"id":"rara","lemma":"rara","pos":"noun","rank":1435,"glosses":["Rufous-tailed plantcutter (Phytotoma rara)"],"ipa":"/ˈraɾa/","gender":"f","forms":{"plural":"raras"},"examples":[{"text":"Esta leche huele rara.","en":"This milk smells funny.","audio":"https://tatoeba.org/en/audio/download/505975"},{"text":"Él tiene ideas raras.","en":"He has strange ideas.","audio":"https://tatoeba.org/en/audio/download/453563"},{"text":"Rara vez veo documentales.","en":"I rarely watch documentaries.","audio":"https://tatoeba.org/en/audio/download/551157"},{"text":"Las cosas se pusieron raras.","en":"Things got weird.","audio":"https://tatoeba.org/en/audio/download/444492"},{"text":"¿Viste alguna cosa rara?","en":"Did you notice anything out of the ordinary?","audio":"https://tatoeba.org/en/audio/download/850261"}]}