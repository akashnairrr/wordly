{"id":"puro","lemma":"puro","pos":"adj","rank":1679,"glosses":["pure, clear","alone, sheer, mere, just, nothing less than"],"ipa":"/ˈpuɾo/","forms":{"feminine":"pura","masculinePlural":"puros","femininePlural":"puras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-AdrianAbdulBaha-puro.wav","examples":[{"text":"¿Es de oro puro?","en":"Is that pure gold?","audio":"https://tatoeba.org/en/audio/download/444244"},{"text":"El agua es pura.","en":"The water is pure.","audio":"https://tatoeba.org/en/audio/download/450112"},{"text":"¿Fumas puros?","en":"Do you smoke cigars?","audio":"https://tatoeba.org/en/audio/download/821246"},{"text":"Ella tiene un corazón puro.","en":"She has a pure heart.","audio":"https://tatoeba.org/en/audio/download/636717"},{"text":"Tom era pura grasa.","en":"Tom was just plain fat.","audio":"https://tatoeba.org/en/audio/download/302003"}]}