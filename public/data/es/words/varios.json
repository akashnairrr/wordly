{"id":"varios","lemma":"varios","pos":"det","rank":1173,"glosses":["various, several"],"ipa":"/ˈbaɾjos/","forms":{"femininePlural":"varias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Precision27-varios.wav","examples":[{"text":"Ella me dio varios libros.","en":"She gave me several books.","audio":"https://tatoeba.org/en/audio/download/639110","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"book","l":"libro"}]},{"text":"Me quedaré aquí por varios días.","en":"I'm going to stay here for several days.","audio":"https://tatoeba.org/en/audio/download/78338","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"here"},{"g":"for / by"},null,{"g":"day","l":"día"}]},{"text":"No he comido en varios días.","en":"I haven't eaten for days.","audio":"https://tatoeba.org/en/audio/download/581554","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"having had lunch"},{"g":"in / on"},null,{"g":"day","l":"día"}]},{"text":"Hay varios tipos de café.","en":"There are various kinds of coffee.","audio":"https://tatoeba.org/en/audio/download/1187984","words":[{"g":"to have","l":"haber"},null,{"g":"kind","l":"tipo"},{"g":"of / from"},{"g":"coffee"}]},{"text":"Tengo varios amigos que hablan bien francés.","en":"I have several friends who speak French well.","audio":"https://tatoeba.org/en/audio/download/456710","words":[{"g":"to have","l":"tener"},null,{"g":"friend","l":"amigo"},{"g":"that"},{"g":"to talk","l":"hablar"},{"g":"well"},{"g":"French"}]}]}