{"id":"varios","lemma":"varios","pos":"det","rank":1176,"glosses":["various, several"],"ipa":"/ˈbaɾjos/","forms":{"femininePlural":"varias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Precision27-varios.wav","examples":[{"text":"Estoy estudiando varios idiomas.","en":"I study many languages.","audio":"https://tatoeba.org/en/audio/download/516216"},{"text":"Él vino varias veces.","en":"He came several times.","audio":"https://tatoeba.org/en/audio/download/34689"},{"text":"Conozco a varios canadienses.","en":"I know several Canadians.","audio":"https://tatoeba.org/en/audio/download/302326"},{"text":"Varias carreteras permanecen cerradas.","en":"Many highways remain closed.","audio":"https://tatoeba.org/en/audio/download/684680"},{"text":"Tengo varios amigos canadienses.","en":"I have several Canadian friends.","audio":"https://tatoeba.org/en/audio/download/302348"}]}