{"id":"gordo","lemma":"gordo","pos":"noun","rank":1287,"glosses":["fat man","the grand prize in a lottery","honey"],"ipa":"/ˈɡoɾdo/","gender":"m","forms":{"plural":"gordos","feminine":"gorda","femininePlural":"gordas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Rodelar-gordo.wav","formAudio":{"gorda":"https://upload.wikimedia.org/wikipedia/commons/1/1e/LL-Q1321_%28spa%29-Marreromarco-gorda.wav"},"examples":[{"text":"Yo soy demasiado gordo.","en":"I'm too fat.","audio":"https://tatoeba.org/en/audio/download/438406"},{"text":"Muy pocos hombres gordos tienen narices largas.","en":"Very few fat men have long noses."},{"text":"¿Pensáis que estoy gorda?","en":"Do you think I'm fat?","audio":"https://tatoeba.org/en/audio/download/77134"},{"text":"Las personas gordas son difíciles de secuestrar.","en":"Fat people are hard to kidnap."},{"text":"Es bajo y gordo.","en":"He's short and fat.","audio":"https://tatoeba.org/en/audio/download/637003"}]}