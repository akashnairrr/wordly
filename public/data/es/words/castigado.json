{"id":"castigado","lemma":"castigado","pos":"adj","rank":3401,"glosses":["punished","grounded (confined to one's room for some misdemeanor)"],"ipa":"/kastiˈɡado/","forms":{"feminine":"castigada","masculinePlural":"castigados","femininePlural":"castigadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/07/LL-Q1321_%28spa%29-Wikipedian-walker-castigado.wav","examples":[{"text":"Él será castigado.","en":"He will be punished.","audio":"https://tatoeba.org/en/audio/download/68253","words":[{"g":"he"},{"g":"to be","l":"ser"},null]},{"text":"Ambos niños fueron castigados.","en":"Both children were punished.","audio":"https://tatoeba.org/en/audio/download/516427","words":[{"g":"both"},{"g":"child, boy","l":"niño"},{"g":"to go","l":"ir"},null]},{"text":"No serás castigada.","en":"You won't be punished.","audio":"https://tatoeba.org/en/audio/download/126265","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Deben ser castigados.","en":"They must be punished.","audio":"https://tatoeba.org/en/audio/download/83533","words":[{"g":"to owe","l":"deber"},{"g":"to be"},null]},{"text":"Exijo que sea castigado.","en":"I demand that he be punished.","audio":"https://tatoeba.org/en/audio/download/552138","words":[{"g":"to demand","l":"exigir"},{"g":"that"},{"g":"to be","l":"ser"},null]}]}