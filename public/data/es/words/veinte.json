{"id":"veinte","lemma":"veinte","pos":"num","rank":1516,"glosses":["twenty"],"ipa":"/ˈbeinte/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a6/LL-Q1321_%28spa%29-AdrianAbdulBaha-veinte.wav","examples":[{"text":"Cuatro por cinco, veinte.","en":"Four times five is 20.","audio":"https://tatoeba.org/en/audio/download/524958"},{"text":"Veinte familias viven aquí.","en":"Twenty families live here.","audio":"https://tatoeba.org/en/audio/download/600027"},{"text":"Camino veinte millas al día.","en":"I walk twenty miles a day.","audio":"https://tatoeba.org/en/audio/download/72266"},{"text":"Acaba de cumplir los veinte.","en":"She has just turned twenty.","audio":"https://tatoeba.org/en/audio/download/69869"},{"text":"El edificio tiene veinte pisos.","en":"The building has twenty floors.","audio":"https://tatoeba.org/en/audio/download/733508"}]}