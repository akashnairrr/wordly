{"id":"pelea","lemma":"pelea","pos":"noun","rank":756,"glosses":["fight, brawl","struggle (physical)","quarrel, argument"],"ipa":"/peˈlea/","gender":"f","forms":{"plural":"peleas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q1321_%28spa%29-Marreromarco-pelea.wav","examples":[{"text":"La pelea comienza ahora.","en":"The fight begins now.","audio":"https://tatoeba.org/en/audio/download/636892"},{"text":"Las peleas limítrofes eran comunes.","en":"Border fights were common."},{"text":"No comencemos una pelea.","en":"Let's not start a fight.","audio":"https://tatoeba.org/en/audio/download/512860"},{"text":"Puedo pelear mis propias peleas.","en":"I can fight my own battles."},{"text":"Tuvieron una pelea de almohadas.","en":"They had a pillow fight.","audio":"https://tatoeba.org/en/audio/download/639707"}]}