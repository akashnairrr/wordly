{"id":"magia","lemma":"magia","pos":"noun","rank":1085,"glosses":["magic","spell, charm, conjuration","wizardry (skill, ability)"],"ipa":"/ˈmaxja/","gender":"f","forms":{"plural":"magias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q1321_%28spa%29-AdrianAbdulBaha-magia.wav","examples":[{"text":"Yo creo en la magia.","en":"I believe in magic.","audio":"https://tatoeba.org/en/audio/download/449370"},{"text":"¿Quieres ver algo de magia?","en":"Do you want to see some magic?","audio":"https://tatoeba.org/en/audio/download/76921"},{"text":"Tom me enseñó un truco de magia.","en":"Tom showed me a magic trick.","audio":"https://tatoeba.org/en/audio/download/300104"},{"text":"Tom me mostró un truco de magia.","en":"Tom showed me a magic trick.","audio":"https://tatoeba.org/en/audio/download/300105"},{"text":"Tom practica magia negra.","en":"Tom practices black magic."}]}