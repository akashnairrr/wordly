{"id":"miedo","lemma":"miedo","pos":"noun","rank":263,"glosses":["fear"],"ipa":"/ˈmjedo/","gender":"m","forms":{"plural":"miedos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-AdrianAbdulBaha-miedo.wav","examples":[{"text":"Eso me da miedo.","en":"That scares me.","audio":"https://tatoeba.org/en/audio/download/450946"},{"text":"Eso no da miedo.","en":"That's not scary.","audio":"https://tatoeba.org/en/audio/download/443414"},{"text":"Tom me da miedo.","en":"Tom frightens me.","audio":"https://tatoeba.org/en/audio/download/191442"},{"text":"Tengo miedo de ir.","en":"I am afraid to go.","audio":"https://tatoeba.org/en/audio/download/69379"},{"text":"Tengo miedo de ti.","en":"I'm afraid of you.","audio":"https://tatoeba.org/en/audio/download/451005"}]}