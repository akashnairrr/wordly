{"id":"miedo","lemma":"miedo","pos":"noun","rank":260,"glosses":["fear"],"ipa":"/ˈmjedo/","gender":"m","forms":{"plural":"miedos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-AdrianAbdulBaha-miedo.wav","examples":[{"text":"¿Tiene ella miedo de la muerte?","en":"Is she afraid of death?","audio":"https://tatoeba.org/en/audio/download/705369","words":[{"g":"to have","l":"tener"},{"g":"she"},null,null,null,{"g":"death"}],"phrases":[[3,5,"of the"]]},{"text":"Él tiene miedo de su padre.","en":"He is afraid of his father.","audio":"https://tatoeba.org/en/audio/download/34707","words":[{"g":"he"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"his / her / your"},{"g":"father, parent"}]},{"text":"¿No tienes miedo de mí?","en":"Aren't you afraid of me?","audio":"https://tatoeba.org/en/audio/download/456724","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"me"}]},{"text":"Ella tenía miedo del perro.","en":"She was afraid of the dog.","audio":"https://tatoeba.org/en/audio/download/39347","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"of the"},{"g":"dog"}]},{"text":"Había miedo en sus ojos.","en":"There was fear in her eyes.","audio":"https://tatoeba.org/en/audio/download/703623","words":[{"g":"makes pluperfect to…"},null,{"g":"in / on"},{"g":"his, her, its, their"},{"g":"eye","l":"ojo"}]}]}