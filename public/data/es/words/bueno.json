{"id":"bueno","lemma":"bueno","pos":"adj","rank":47,"glosses":["good (of good quality)","good (at/with something)","good (in a good state)"],"ipa":"/ˈbweno/","forms":{"feminine":"buena","masculinePlural":"buenos","femininePlural":"buenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-Rodelar-bueno.wav","formAudio":{"buena":"https://upload.wikimedia.org/wikipedia/commons/2/2f/LL-Q1321_%28spa%29-Marreromarco-buena.wav","buenas":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Emanuelps27-buenas.wav"},"examples":[{"text":"Bueno, estoy de acuerdo.","en":"OK. I agree.","audio":"https://tatoeba.org/en/audio/download/438695"},{"text":"La cerveza es buena.","en":"Beer's good.","audio":"https://tatoeba.org/en/audio/download/103390"},{"text":"Son buenos para nada.","en":"You're useless.","audio":"https://tatoeba.org/en/audio/download/441449"},{"text":"Tengo muy buenas noticias.","en":"I have great news.","audio":"https://tatoeba.org/en/audio/download/443320"},{"text":"Yo puedo ser bueno.","en":"I can be good.","audio":"https://tatoeba.org/en/audio/download/440156"}]}