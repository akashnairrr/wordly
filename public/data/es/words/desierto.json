{"id":"desierto","lemma":"desierto","pos":"adj","rank":1610,"glosses":["desert","empty (of people)","uninhabited"],"ipa":"/deˈsjeɾto/","forms":{"feminine":"desierta","masculinePlural":"desiertos","femininePlural":"desiertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-AdrianAbdulBaha-desierto.wav","examples":[{"text":"Me gustaba caminar solo por la playa desierta.","en":"I liked walking alone on the deserted beach.","audio":"https://tatoeba.org/en/audio/download/608629","words":[{"g":"me"},{"g":"to like in a general…","l":"gustar"},{"g":"to walk"},{"g":"sole"},{"g":"for / by"},{"g":"the / her"},{"g":"beach"},null]},{"text":"Odio el desierto.","en":"I hate the desert.","audio":"https://tatoeba.org/en/audio/download/443664","words":[{"g":"hate"},{"g":"the"},null]},{"text":"El centro comercial está desierto.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/453931","words":[{"g":"the"},null,null,{"g":"to be","l":"estar"},null],"phrases":[[1,3,"mall, shopping centre"]]},{"text":"La sala está desierta.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/455373","words":[{"g":"the / her"},{"g":"room"},{"g":"to be","l":"estar"},null]},{"text":"Aquí las calles están desiertas a partir de las siete.","en":"Around here, they roll up the sidewalks at 7 o'clock.","audio":"https://tatoeba.org/en/audio/download/692879","words":[{"g":"here"},{"g":"the / them"},{"g":"street","l":"calle"},{"g":"to be","l":"estar"},null,null,null,null,{"g":"the / them"},{"g":"seven"}],"phrases":[[5,8,"from"]]}]}