{"id":"desierto","lemma":"desierto","pos":"adj","rank":1613,"glosses":["desert","empty (of people)","uninhabited"],"ipa":"/deˈsjeɾto/","forms":{"feminine":"desierta","masculinePlural":"desiertos","femininePlural":"desiertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-AdrianAbdulBaha-desierto.wav","examples":[{"text":"El centro comercial está desierto.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/453931"},{"text":"La sala está desierta.","en":"The mall is deserted.","audio":"https://tatoeba.org/en/audio/download/455373"},{"text":"Los camellos son los barcos de los desiertos.","en":"Camels are the ships of the deserts."},{"text":"Aquí las calles están desiertas a partir de las siete.","en":"Around here, they roll up the sidewalks at 7 o'clock.","audio":"https://tatoeba.org/en/audio/download/692879"},{"text":"El lugar está casi desierto.","en":"The place is almost deserted.","audio":"https://tatoeba.org/en/audio/download/804128"}]}