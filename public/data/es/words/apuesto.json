{"id":"apuesto","lemma":"apuesto","pos":"adj","rank":757,"glosses":["handsome, good-looking (person)"],"ipa":"/aˈpwesto/","forms":{"feminine":"apuesta","masculinePlural":"apuestos","femininePlural":"apuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q1321_%28spa%29-Akhram-apuesto.wav","formAudio":{"apuesta":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q1321_%28spa%29-Marreromarco-apuesta.wav"},"examples":[{"text":"Apuesto a que llego antes que usted.","en":"I bet I get there before you.","audio":"https://tatoeba.org/en/audio/download/611612","words":[null,{"g":"to"},{"g":"that"},{"g":"to arrive, get","l":"llegar"},{"g":"earlier"},{"g":"that"},{"g":"you (formal)"}]},{"text":"Me apuesto cinco dólares a que no viene.","en":"I bet five dollars that he will not come.","audio":"https://tatoeba.org/en/audio/download/688866","words":[{"g":"me"},null,{"g":"a five"},{"g":"dollar","l":"dólar"},null,null,null,{"g":"to come","l":"venir"}],"phrases":[[4,7,"I bet"]]},{"text":"Apuesto a que no puedes hacer esto.","en":"I bet you can't do this.","audio":"https://tatoeba.org/en/audio/download/462172","words":[null,null,null,null,{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"this"}],"phrases":[[1,4,"I bet"]]},{"text":"Tom es un joven apuesto.","en":"Tom is a handsome young man.","audio":"https://tatoeba.org/en/audio/download/301177","words":[null,{"g":"to be","l":"ser"},{"g":"a"},{"g":"young, youthful"},null]},{"text":"Apuesto a que es bastante fácil de hacer.","en":"I bet that's pretty easy to do.","audio":"https://tatoeba.org/en/audio/download/439956","words":[null,{"g":"to"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"quite"},{"g":"easy, facile, simple"},{"g":"of / from"},{"g":"to do"}]}]}