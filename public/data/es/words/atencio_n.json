{"id":"atencio_n","lemma":"atención","pos":"noun","rank":476,"glosses":["attention","courtesy","favor"],"ipa":"/atenˈθjon/","gender":"f","forms":{"plural":"atenciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/61/LL-Q1321_%28spa%29-AdrianAbdulBaha-atenci%C3%B3n.wav","examples":[{"text":"No me prestes atención.","en":"Don't mind me.","audio":"https://tatoeba.org/en/audio/download/440056"},{"text":"¡Prestad atención, por favor!","en":"Attention please!","audio":"https://tatoeba.org/en/audio/download/1187340"},{"text":"Les gusta la atención.","en":"They like attention.","audio":"https://tatoeba.org/en/audio/download/448362"},{"text":"Prestar atención a Tom.","en":"Pay attention to Tom.","audio":"https://tatoeba.org/en/audio/download/800961"},{"text":"Inténtalo y presta atención.","en":"Try and pay attention.","audio":"https://tatoeba.org/en/audio/download/501679"}]}