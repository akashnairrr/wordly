{"id":"pare","lemma":"pare","pos":"noun","rank":1800,"glosses":["stop, an act of stopping","stop sign"],"ipa":"/ˈpaɾe/","gender":"m","forms":{"plural":"pares"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q1321_%28spa%29-Marreromarco-pare.wav","examples":[{"text":"Haz que pare.","en":"Just make this stop.","audio":"https://tatoeba.org/en/audio/download/448445","words":[{"g":"to do","l":"hacer"},{"g":"that"},null]},{"text":"Pare la guerra, por favor.","en":"Please stop the war.","words":[null,{"g":"the / her"},{"g":"war, warfare"},null,null],"phrases":[[3,5,"please"]]},{"text":"Pare de hablar enseguida.","en":"Stop speaking right now.","words":[null,{"g":"of / from"},{"g":"to talk"},{"g":"immediately"}]},{"text":"Iremos cuando pare de llover.","en":"We'll go when the rain stops.","audio":"https://tatoeba.org/en/audio/download/537996","words":[{"g":"to go","l":"ir"},{"g":"when"},null,{"g":"of / from"},{"g":"to rain"}]},{"text":"Esperemos hasta que la lluvia pare.","en":"Let's wait for the rain to stop.","audio":"https://tatoeba.org/en/audio/download/585775","words":[{"g":"to hope","l":"esperar"},null,null,{"g":"the / her"},{"g":"rain"},null],"phrases":[[1,3,"until, till"]]}]}