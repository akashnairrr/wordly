{"id":"miembro","lemma":"miembro","pos":"noun","rank":1241,"glosses":["limb (a major appendage of a person or animal)","penis"],"ipa":"/ˈmjembɾo/","gender":"m","forms":{"plural":"miembros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-AdrianAbdulBaha-miembro.wav","formAudio":{"miembros":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Precision27-miembros.wav"},"examples":[{"text":"Soy miembro del equipo.","en":"I'm a member of the team.","audio":"https://tatoeba.org/en/audio/download/524465"},{"text":"Todos los miembros estaban presentes.","en":"All the members were present.","audio":"https://tatoeba.org/en/audio/download/641887"},{"text":"Soy miembro del coro.","en":"I'm a member of the glee club.","audio":"https://tatoeba.org/en/audio/download/806194"},{"text":"El club cuenta con treinta miembros.","en":"The club has thirty members.","audio":"https://tatoeba.org/en/audio/download/928941"},{"text":"Soy miembro del equipo de baloncesto.","en":"I am a member of the basketball team.","audio":"https://tatoeba.org/en/audio/download/568441"}]}