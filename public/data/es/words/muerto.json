{"id":"muerto","lemma":"muerto","pos":"adj","rank":225,"glosses":["dead","exhausted; dead tired","unupdated, inactive, outdated"],"ipa":"/ˈmweɾto/","forms":{"feminine":"muerta","masculinePlural":"muertos","femininePlural":"muertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q1321_%28spa%29-AdrianAbdulBaha-muerto.wav","examples":[{"text":"No estoy muerto, ¿no?","en":"I'm not dead, am I?","audio":"https://tatoeba.org/en/audio/download/448352","words":[{"g":"no / not"},{"g":"to be","l":"estar"},null,{"g":"no / not"}]},{"text":"Mañana podríamos estar todos muertos.","en":"We could all be dead tomorrow.","audio":"https://tatoeba.org/en/audio/download/532311","words":[{"g":"tomorrow"},{"g":"to be able to, can","l":"poder"},{"g":"to be"},{"g":"all","l":"todo"},null]},{"text":"Ella está muerta.","en":"She is dead.","audio":"https://tatoeba.org/en/audio/download/44887","words":[{"g":"she"},{"g":"to be","l":"estar"},null]},{"text":"¿Cómo sabes que ya está muerto?","en":"How do you know that he's already dead?","audio":"https://tatoeba.org/en/audio/download/76993","words":[{"g":"how"},{"g":"to know, to understand","l":"saber"},{"g":"that"},null,null,null],"phrases":[[3,5,"that's it"]]},{"text":"Mis padres están muertos.","en":"My parents are dead.","audio":"https://tatoeba.org/en/audio/download/449981","words":[{"g":"my"},{"g":"father, parent","l":"padre"},{"g":"to be","l":"estar"},null]}]}