{"id":"muerto","lemma":"muerto","pos":"adj","rank":228,"glosses":["dead","exhausted; dead tired","unupdated, inactive, outdated"],"ipa":"/ˈmweɾto/","forms":{"feminine":"muerta","masculinePlural":"muertos","femininePlural":"muertas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/95/LL-Q1321_%28spa%29-AdrianAbdulBaha-muerto.wav","examples":[{"text":"Estoy muerto de hambre.","en":"I'm starved.","audio":"https://tatoeba.org/en/audio/download/39062"},{"text":"Estoy muerta de cansancio.","en":"I'm dead tired.","audio":"https://tatoeba.org/en/audio/download/38585"},{"text":"Estamos muertos de hambre.","en":"We're famished.","audio":"https://tatoeba.org/en/audio/download/412505"},{"text":"¿Por qué Tom os quiere muertas?","en":"Why would Tom want you dead?"},{"text":"Tom no ha muerto.","en":"Tom isn't dead.","audio":"https://tatoeba.org/en/audio/download/799046"}]}