{"id":"menor","lemma":"menor","pos":"noun","rank":1179,"glosses":["minor (person under the age of majority)","minor (person under 18)","kid, child"],"ipa":"/meˈnoɾ/","gender":"mf","forms":{"plural":"menores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Marreromarco-menor.wav","examples":[{"text":"Yo soy menor que él.","en":"I'm younger than he is.","audio":"https://tatoeba.org/en/audio/download/458649","words":[{"g":"I"},{"g":"to be","l":"ser"},null,{"g":"that"},{"g":"he"}]},{"text":"Él es mi hermano menor.","en":"He's my younger brother.","audio":"https://tatoeba.org/en/audio/download/461402","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"my"},{"g":"brother"},null]},{"text":"¿Tienes hermanos menores?","en":"Do you have younger brothers?","words":[{"g":"to have","l":"tener"},{"g":"brother","l":"hermano"},null]},{"text":"Yo no tengo hermana menor.","en":"I don't have a younger sister.","audio":"https://tatoeba.org/en/audio/download/600108","words":[{"g":"I"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"sister"},null]},{"text":"Yo tengo un hermano mayor y dos hermanas menores.","en":"I have one big brother and two little sisters.","words":[{"g":"I"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"brother"},{"g":"of age"},{"g":"and"},{"g":"dung, excrement"},{"g":"sister","l":"hermana"},null]}]}