{"id":"menor","lemma":"menor","pos":"noun","rank":1182,"glosses":["minor (person under the age of majority)","minor (person under 18)","kid, child"],"ipa":"/meˈnoɾ/","gender":"mf","forms":{"plural":"menores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Marreromarco-menor.wav","examples":[{"text":"Es una herida menor.","en":"It's a minor wound.","audio":"https://tatoeba.org/en/audio/download/547998"},{"text":"Aquí no entran menores.","en":"Minors can't come in here."},{"text":"Es un problema menor.","en":"It's a minor problem.","audio":"https://tatoeba.org/en/audio/download/547999"},{"text":"No es apto para menores.","en":"It isn't suitable for minors."},{"text":"Todavía eres menor de edad.","en":"You're still underage.","audio":"https://tatoeba.org/en/audio/download/459122"}]}