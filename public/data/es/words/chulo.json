{"id":"chulo","lemma":"chulo","pos":"adj","rank":4527,"glosses":["cute, pretty, lovely, cool, nifty","cocky (overly confident, arrogant and boastful)","ordinary, common, vulgar, rascal"],"ipa":"/ˈt͡ʃulo/","forms":{"feminine":"chula","masculinePlural":"chulos","femininePlural":"chulas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-Marreromarco-chulo.wav","examples":[{"text":"Tienes un coche muy chulo.","en":"You have a very nice car.","audio":"https://tatoeba.org/en/audio/download/556950","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"car, automobile"},null,null]},{"text":"¡Qué jardín más chulo!","en":"What a beautiful garden!","audio":"https://tatoeba.org/en/audio/download/611722","words":[{"g":"what"},{"g":"garden"},{"g":"more"},null]},{"text":"María es muy chula.","en":"Mary is a fox.","audio":"https://tatoeba.org/en/audio/download/501346","words":[{"g":"magpie"},{"g":"to be","l":"ser"},null,null]},{"text":"Era bastante chulo.","en":"It was pretty cool.","audio":"https://tatoeba.org/en/audio/download/448421","words":[{"g":"to be","l":"ser"},{"g":"quite"},null]},{"text":"¡Qué niño tan chulo eres!","en":"You're such a cute boy.","words":[{"g":"what"},{"g":"child, boy"},{"g":"so, as"},null,{"g":"to be","l":"ser"}]}]}