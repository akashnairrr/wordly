{"id":"casado","lemma":"casado","pos":"adj","rank":957,"glosses":["married"],"ipa":"/kaˈsado/","forms":{"feminine":"casada","masculinePlural":"casados","femininePlural":"casadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Marreromarco-casado.wav","examples":[{"text":"Él no está casado.","en":"He is unmarried.","audio":"https://tatoeba.org/en/audio/download/441475"},{"text":"Ella no está casada.","en":"She isn't married.","audio":"https://tatoeba.org/en/audio/download/444323"},{"text":"¿Cuánto tiempo llevamos casados?","en":"How long have we been married?","audio":"https://tatoeba.org/en/audio/download/516266"},{"text":"Mis tres hijas ya están casadas.","en":"All three of my daughters are already married.","audio":"https://tatoeba.org/en/audio/download/460719"},{"text":"Soy un hombre casado.","en":"I'm a married man.","audio":"https://tatoeba.org/en/audio/download/443547"}]}