{"id":"cerradura","lemma":"cerradura","pos":"noun","rank":3431,"glosses":["lock"],"ipa":"/θeraˈduɾa/","gender":"f","forms":{"plural":"cerraduras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-AdrianAbdulBaha-cerradura.wav","examples":[{"text":"Cambiaron la cerradura.","en":"They've changed the lock.","audio":"https://tatoeba.org/en/audio/download/557023","words":[{"g":"to change","l":"cambiar"},{"g":"the / her"},null]},{"text":"Esta llave no entra en la cerradura.","en":"This key doesn't fit in the lock.","audio":"https://tatoeba.org/en/audio/download/684382","words":[{"g":"this","l":"este"},{"g":"key"},{"g":"no / not"},{"g":"to enter","l":"entrar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Cambié la cerradura de mi puerta.","en":"I changed the lock on my door.","audio":"https://tatoeba.org/en/audio/download/355342","words":[{"g":"to change","l":"cambiar"},{"g":"the / her"},null,{"g":"of / from"},{"g":"my"},{"g":"door"}]},{"text":"Al abrir la puerta, rompí la cerradura.","en":"When I opened the door, I broke the lock.","audio":"https://tatoeba.org/en/audio/download/935999","words":[{"g":"to the"},null,null,null,{"g":"to break","l":"romper"},{"g":"the / her"},null],"phrases":[[1,4,"to open the door"]]},{"text":"No dejes la llave en la cerradura.","en":"Don't leave the key in the lock.","audio":"https://tatoeba.org/en/audio/download/594697","words":[{"g":"no / not"},{"g":"to leave","l":"dejar"},{"g":"the / her"},{"g":"key"},{"g":"in / on"},{"g":"the / her"},null]}]}