{"id":"ocurrido","lemma":"ocurrido","pos":"adj","rank":1234,"glosses":["unexpected"],"ipa":"/okuˈrido/","forms":{"feminine":"ocurrida","masculinePlural":"ocurridos","femininePlural":"ocurridas"},"examples":[{"text":"¿Por qué ha ocurrido esto?","en":"Why did this happen?","audio":"https://tatoeba.org/en/audio/download/453429"},{"text":"¿Cómo pudo haber ocurrido eso?","en":"How could that have happened?","audio":"https://tatoeba.org/en/audio/download/611897"},{"text":"No puedo explicarme lo ocurrido.","en":"I can't understand what happened.","audio":"https://tatoeba.org/en/audio/download/594621"},{"text":"Se me ha ocurrido una idea.","en":"An idea came to me.","audio":"https://tatoeba.org/en/audio/download/706220"},{"text":"Tom ignora lo que ha ocurrido.","en":"Tom is unaware of what has happened.","audio":"https://tatoeba.org/en/audio/download/806264"}]}