{"id":"doce","lemma":"doce","pos":"num","rank":1669,"glosses":["twelve"],"ipa":"/ˈdoθe/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-AdrianAbdulBaha-doce.wav","examples":[{"text":"Ellos tienen doce hijos.","en":"They have twelve children.","audio":"https://tatoeba.org/en/audio/download/735600"},{"text":"Son casi las doce.","en":"It's almost twelve o'clock.","audio":"https://tatoeba.org/en/audio/download/639310"},{"text":"Un año tiene doce meses.","en":"A year has twelve months.","audio":"https://tatoeba.org/en/audio/download/537887"},{"text":"Mi hermano pequeño tiene doce.","en":"My kid brother is twelve.","audio":"https://tatoeba.org/en/audio/download/514736"},{"text":"¿Por qué hay doce meses?","en":"Why are there twelve months?","audio":"https://tatoeba.org/en/audio/download/540875"}]}