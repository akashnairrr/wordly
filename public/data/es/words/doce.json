{"id":"doce","lemma":"doce","pos":"num","rank":1666,"glosses":["twelve"],"ipa":"/ˈdoθe/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-AdrianAbdulBaha-doce.wav","examples":[{"text":"Un año tiene doce meses.","en":"A year has twelve months.","audio":"https://tatoeba.org/en/audio/download/537887","words":[{"g":"a"},{"g":"year"},{"g":"to have","l":"tener"},null,{"g":"month","l":"mes"}]},{"text":"Ellos tienen doce hijos.","en":"They have twelve children.","audio":"https://tatoeba.org/en/audio/download/735600","words":[{"g":"they","l":"él"},{"g":"to have","l":"tener"},null,{"g":"son","l":"hijo"}]},{"text":"Pasé doce horas en el tren.","en":"I spent twelve hours on the train.","audio":"https://tatoeba.org/en/audio/download/587446","words":[{"g":"to pass","l":"pasar"},null,{"g":"hour","l":"hora"},{"g":"in / on"},{"g":"the"},{"g":"train"}]},{"text":"Mi hermano pequeño tiene doce.","en":"My kid brother is twelve.","audio":"https://tatoeba.org/en/audio/download/514736","words":[{"g":"my"},{"g":"brother"},{"g":"small"},{"g":"to have","l":"tener"},null]},{"text":"¿Por qué hay doce meses?","en":"Why are there twelve months?","audio":"https://tatoeba.org/en/audio/download/540875","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"month","l":"mes"}],"phrases":[[0,2,"why, for what reason"]]}]}