{"id":"cajo_n","lemma":"cajón","pos":"noun","rank":2788,"glosses":["a large box","drawer","cajón (box-shaped percussion instrument)"],"ipa":"/kaˈxon/","gender":"m","forms":{"plural":"cajones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0a/LL-Q1321_%28spa%29-Marreromarco-caj%C3%B3n.wav","examples":[{"text":"Cierra el cajón.","en":"Close the drawer.","audio":"https://tatoeba.org/en/audio/download/456812","words":[{"g":"to close, to shut","l":"cerrar"},{"g":"the"},null]},{"text":"Este cajón es de madera.","en":"That box is made of wood.","audio":"https://tatoeba.org/en/audio/download/519014","words":[{"g":"this"},null,{"g":"to be","l":"ser"},{"g":"of / from"},{"g":"wood"}]},{"text":"Lo metí en el cajón.","en":"I put it in the drawer.","audio":"https://tatoeba.org/en/audio/download/43227","words":[{"g":"it / him"},{"g":"to put in, insert","l":"meter"},{"g":"in / on"},{"g":"the"},null]},{"text":"Todos los cajones del escritorio estaban vacíos.","en":"All the desk drawers were empty.","audio":"https://tatoeba.org/en/audio/download/645538","words":[{"g":"all","l":"todo"},{"g":"the / them"},null,{"g":"of the"},{"g":"writing desk"},{"g":"to be","l":"estar"},{"g":"vacuum, void","l":"vacío"}]},{"text":"Han perdido la llave del cajón.","en":"They've lost the key to the drawer.","words":[{"g":"to have","l":"haber"},{"g":"lost"},{"g":"the / her"},{"g":"key"},{"g":"of the"},null]}]}