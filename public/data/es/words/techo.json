{"id":"techo","lemma":"techo","pos":"noun","rank":1310,"glosses":["ceiling","roof"],"ipa":"/ˈtet͡ʃo/","gender":"m","forms":{"plural":"techos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-Rodrigo5260-techo.wav","formAudio":{"techos":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q1321_%28spa%29-Eavqwiki-techos.wav"},"examples":[{"text":"El techo de mi casa es rojo.","en":"The roof of my house is red.","audio":"https://tatoeba.org/en/audio/download/586732","words":[{"g":"the"},null,{"g":"of / from"},{"g":"my"},{"g":"house"},{"g":"to be","l":"ser"},{"g":"red"}]},{"text":"Él es un sin techo.","en":"He is homeless.","audio":"https://tatoeba.org/en/audio/download/703742","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"without"},null]},{"text":"El techo está en llamas.","en":"The roof is on fire.","audio":"https://tatoeba.org/en/audio/download/419340","words":[{"g":"the"},null,{"g":"to be","l":"estar"},null,null],"phrases":[[3,5,"ablaze"]]},{"text":"Me encanta cómo suena la lluvia en el techo.","en":"I love the sound of rain on the roof.","audio":"https://tatoeba.org/en/audio/download/845524","words":[{"g":"me"},{"g":"to charm, to enchant","l":"encantar"},{"g":"how"},{"g":"to sound, to ring","l":"sonar"},{"g":"the / her"},{"g":"rain"},{"g":"in / on"},{"g":"the"},null]},{"text":"La blanca nieve cubrió los rojos techos.","en":"The white snow covered the red roofs.","words":[{"g":"the / her"},{"g":"minim, half note"},{"g":"snow"},{"g":"to cover","l":"cubrir"},{"g":"the / them"},{"g":"red","l":"rojo"},null]}]}