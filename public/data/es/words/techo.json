{"id":"techo","lemma":"techo","pos":"noun","rank":1310,"glosses":["ceiling","roof"],"ipa":"/ˈtet͡ʃo/","gender":"m","forms":{"plural":"techos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-Rodrigo5260-techo.wav","formAudio":{"techos":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q1321_%28spa%29-Eavqwiki-techos.wav"},"examples":[{"text":"Veo un pájaro en el techo.","en":"I see a bird on the roof.","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"bird"},{"g":"in / on"},{"g":"the"},null]},{"text":"El techo de mi casa es rojo.","en":"The roof of my house is red.","audio":"https://tatoeba.org/en/audio/download/586732","words":[{"g":"the"},null,{"g":"of / from"},{"g":"my"},{"g":"house"},{"g":"to be","l":"ser"},{"g":"red"}]},{"text":"Él es un sin techo.","en":"He is homeless.","audio":"https://tatoeba.org/en/audio/download/703742","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"without"},null]},{"text":"Vi una mosca en el techo.","en":"I saw a fly on the ceiling.","audio":"https://tatoeba.org/en/audio/download/553651","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"fly"},{"g":"in / on"},{"g":"the"},null]},{"text":"Vi a un gato en el techo.","en":"I saw a cat on the roof.","words":[{"g":"to see, to spot","l":"ver"},{"g":"to"},{"g":"a"},{"g":"cat"},{"g":"in / on"},{"g":"the"},null]}]}