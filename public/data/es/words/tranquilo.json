{"id":"tranquilo","lemma":"tranquilo","pos":"adj","rank":548,"glosses":["calm, peaceful, tranquil, quiet"],"ipa":"/tɾanˈkilo/","forms":{"feminine":"tranquila","masculinePlural":"tranquilos","femininePlural":"tranquilas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-AdrianAbdulBaha-tranquilo.wav","examples":[{"text":"¿Cómo puede estar tan tranquilo?","en":"How can you be so calm?","audio":"https://tatoeba.org/en/audio/download/461840","words":[{"g":"how"},{"g":"to be able to, can","l":"poder"},{"g":"to be"},{"g":"so, as"},null]},{"text":"Ella es una mujer tranquila.","en":"She is a quiet woman.","audio":"https://tatoeba.org/en/audio/download/453660","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"woman"},null]},{"text":"Dejé tranquilos a mis amigos.","en":"Leave my friends alone.","audio":"https://tatoeba.org/en/audio/download/1152377","words":[{"g":"to leave","l":"dejar"},null,{"g":"to"},{"g":"my"},{"g":"friend","l":"amigo"}]},{"text":"Tranquilo, que mañana será otro día.","en":"Relax, tomorrow will be another day.","audio":"https://tatoeba.org/en/audio/download/410981","words":[null,{"g":"that"},null,null,null,null],"phrases":[[2,6,"tomorrow is another day"]]},{"text":"Esta habitación es tranquila.","en":"This room is quiet.","audio":"https://tatoeba.org/en/audio/download/123957","words":[{"g":"this","l":"este"},{"g":"room"},{"g":"to be","l":"ser"},null]}]}