{"id":"tranquilo","lemma":"tranquilo","pos":"adj","rank":551,"glosses":["calm, peaceful, tranquil, quiet"],"ipa":"/tɾanˈkilo/","forms":{"feminine":"tranquila","masculinePlural":"tranquilos","femininePlural":"tranquilas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-AdrianAbdulBaha-tranquilo.wav","examples":[{"text":"Tom parece sorprendentemente tranquilo.","en":"Tom seems surprisingly calm.","audio":"https://tatoeba.org/en/audio/download/806511"},{"text":"El área estaba tranquila.","en":"The area was quiet.","audio":"https://tatoeba.org/en/audio/download/450431"},{"text":"Por favor, quédense todos tranquilos.","en":"Please remain calm.","audio":"https://tatoeba.org/en/audio/download/450242"},{"text":"No voy a estar tranquilo.","en":"I won't be quiet.","audio":"https://tatoeba.org/en/audio/download/442746"},{"text":"Esta habitación es tranquila.","en":"This room is quiet.","audio":"https://tatoeba.org/en/audio/download/123957"}]}