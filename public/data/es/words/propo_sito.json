{"id":"propo_sito","lemma":"propósito","pos":"noun","rank":936,"glosses":["purpose","resolution"],"ipa":"/pɾoˈposito/","gender":"m","forms":{"plural":"propósitos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-prop%C3%B3sito.wav","examples":[{"text":"¿Cuál es mi propósito?","en":"What is my purpose?","audio":"https://tatoeba.org/en/audio/download/735503","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"¿Con qué propósito?","en":"For what purpose?","audio":"https://tatoeba.org/en/audio/download/443002","words":[{"g":"with"},{"g":"what"},null]},{"text":"Él me hizo esperar a propósito.","en":"He kept me waiting on purpose.","audio":"https://tatoeba.org/en/audio/download/641835","words":[{"g":"he"},{"g":"me"},{"g":"to do","l":"hacer"},{"g":"to hope"},{"g":"to"},null]},{"text":"¿Cuál es el propósito de la educación?","en":"What is the purpose of education?","audio":"https://tatoeba.org/en/audio/download/684518","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},null,null,null,{"g":"education"}],"phrases":[[4,6,"of the"]]},{"text":"Lo hice a propósito.","en":"I did it on purpose.","audio":"https://tatoeba.org/en/audio/download/821175","words":[{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"to"},null]}]}