{"id":"propo_sito","lemma":"propósito","pos":"noun","rank":936,"glosses":["purpose","resolution"],"ipa":"/pɾoˈposito/","gender":"m","forms":{"plural":"propósitos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-prop%C3%B3sito.wav","examples":[{"text":"¿Cuál es mi propósito?","en":"What is my purpose?","audio":"https://tatoeba.org/en/audio/download/735503","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"¿Con qué propósito?","en":"For what purpose?","audio":"https://tatoeba.org/en/audio/download/443002","words":[{"g":"with"},{"g":"what"},null]},{"text":"Ella lo hizo a propósito.","en":"She did it on purpose.","audio":"https://tatoeba.org/en/audio/download/1195669","words":[{"g":"she"},{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"to"},null]},{"text":"¿Cuál es el propósito de la educación?","en":"What is the purpose of education?","audio":"https://tatoeba.org/en/audio/download/684518","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},null,null,null,{"g":"education"}],"phrases":[[4,6,"of the"]]},{"text":"Él consiguió su propósito.","en":"He achieved his purpose.","words":[{"g":"he"},{"g":"to achieve","l":"conseguir"},{"g":"his / her / your"},null]}]}