{"id":"kilo","lemma":"kilo","pos":"noun","rank":1883,"glosses":["kilo (kilogram)","the letter K in the Spanish spelling alphabet","a million pesetas"],"ipa":"/ˈkilo/","gender":"m","forms":{"plural":"kilos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Marreromarco-kilo.wav","examples":[{"text":"¿Cuánto cuesta medio kilo?","en":"How much for half a kilo?","audio":"https://tatoeba.org/en/audio/download/933813"},{"text":"He engordado tres kilos.","en":"I've gained three kilos.","audio":"https://tatoeba.org/en/audio/download/510120"},{"text":"Deme un kilo de melocotones.","en":"Give me one kilogram of peaches.","audio":"https://tatoeba.org/en/audio/download/451307"},{"text":"Peso más o menos 60 kilos.","en":"I weigh about 60 kilos.","audio":"https://tatoeba.org/en/audio/download/39679"},{"text":"Quiero comprar un kilo de eso.","en":"I want to buy a kilogram of that."}]}