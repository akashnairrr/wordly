{"id":"artista","lemma":"artista","pos":"noun","rank":1374,"glosses":["artist","entertainer, performer, artiste (occupation)"],"ipa":"/aɾˈtista/","gender":"mf","forms":{"plural":"artistas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-AdrianAbdulBaha-artista.wav","examples":[{"text":"Él es un artista nato.","en":"He is a born artist.","audio":"https://tatoeba.org/en/audio/download/636735"},{"text":"Los dos son artistas.","en":"They're both artists.","audio":"https://tatoeba.org/en/audio/download/550169"},{"text":"Él es un artista famoso.","en":"He is a famous artist.","audio":"https://tatoeba.org/en/audio/download/705768"},{"text":"En Nueva York viven muchos artistas famosos.","en":"Many famous artists live in New York.","audio":"https://tatoeba.org/en/audio/download/599041"},{"text":"Es una artista muy talentosa.","en":"She is a gifted artist.","audio":"https://tatoeba.org/en/audio/download/735461"}]}