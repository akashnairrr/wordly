{"id":"culpa","lemma":"culpa","pos":"noun","rank":329,"glosses":["fault","guilt","blame"],"ipa":"/ˈkulpa/","gender":"f","forms":{"plural":"culpas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5e/LL-Q1321_%28spa%29-AdrianAbdulBaha-culpa.wav","examples":[{"text":"Yo tengo la culpa.","en":"I'm to blame.","audio":"https://tatoeba.org/en/audio/download/928962"},{"text":"¿Por qué me culpas por lo que pasó?","en":"Why do you blame me for what happened?","audio":"https://tatoeba.org/en/audio/download/688874"},{"text":"La culpa es mía.","en":"I'm to blame.","audio":"https://tatoeba.org/en/audio/download/221741"},{"text":"Confesó todas sus culpas.","en":"He confessed all his sins."},{"text":"Esto es culpa tuya.","en":"This is on you.","audio":"https://tatoeba.org/en/audio/download/441100"}]}