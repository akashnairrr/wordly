{"id":"ganador","lemma":"ganador","pos":"adj","rank":1729,"glosses":["winning"],"ipa":"/ɡanaˈdoɾ/","forms":{"feminine":"ganadora","masculinePlural":"ganadores","femininePlural":"ganadoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-Marreromarco-ganador.wav","examples":[{"text":"Es bueno ser un ganador.","en":"It is good to be a winner.","words":[{"g":"to be","l":"ser"},{"g":"good"},{"g":"to be"},{"g":"a"},null]},{"text":"Supe que ella sería la ganadora.","en":"I knew she would be the winner.","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"she"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"Tomás es claramente el ganador.","en":"Tom is clearly the winner.","audio":"https://tatoeba.org/en/audio/download/519135","words":[{"g":"to take","l":"tomar"},{"g":"to be","l":"ser"},{"g":"clearly"},{"g":"the"},null]},{"text":"Tenemos poca posibilidad de ser ganadores.","en":"We have little chance of winning.","words":[{"g":"to have","l":"tener"},{"g":"tad"},{"g":"possibility"},{"g":"of / from"},{"g":"to be"},null]},{"text":"Los ganadores no consumen drogas.","en":"Winners don't use drugs.","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"to carry out","l":"consumar"},{"g":"drug","l":"droga"}]}]}