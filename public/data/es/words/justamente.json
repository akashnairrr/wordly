{"id":"justamente","lemma":"justamente","pos":"adv","rank":3249,"glosses":["justly, fairly, fair and square","precisely, exactly"],"ipa":"/ˌxustaˈmente/","examples":[{"text":"Justamente estaba pensando en ti.","en":"I was just thinking about you.","audio":"https://tatoeba.org/en/audio/download/554790","words":[null,{"g":"to be","l":"estar"},{"g":"to think, ponder","l":"pensar"},{"g":"in / on"},{"g":"you","l":"tú"}]},{"text":"¡Me dijo justamente lo contrario!","en":"He told me just the opposite!","audio":"https://tatoeba.org/en/audio/download/768191","words":[{"g":"me"},{"g":"to say","l":"decir"},null,{"g":"it / him"},{"g":"contrary, opposite"}]},{"text":"Había una tienda justamente aquí.","en":"There used to be a store right here.","words":[{"g":"makes pluperfect to…"},{"g":"a"},{"g":"tent"},null,{"g":"here"}]},{"text":"Él actuó justamente hacia mi.","en":"He acted fairly toward me.","words":[{"g":"he"},{"g":"to act, to behave","l":"actuar"},null,{"g":"toward, towards"},{"g":"my"}]},{"text":"¡Él me dijo justamente lo contrario!","en":"He told me just the opposite!","words":[{"g":"he"},{"g":"me"},{"g":"to say","l":"decir"},null,{"g":"it / him"},{"g":"contrary, opposite"}]}]}