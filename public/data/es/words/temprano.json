{"id":"temprano","lemma":"temprano","pos":"adv","rank":731,"glosses":["early, early on"],"ipa":"/temˈpɾano/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-temprano.wav","examples":[{"text":"Me fui del colegio temprano.","en":"I left school early.","audio":"https://tatoeba.org/en/audio/download/448901","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"of the"},{"g":"school"},null]},{"text":"Me despierto muy temprano.","en":"I wake up very early.","audio":"https://tatoeba.org/en/audio/download/80527","words":[{"g":"me"},{"g":"awake"},null,null]},{"text":"Me voy a dormir temprano.","en":"I'll go to bed early.","audio":"https://tatoeba.org/en/audio/download/454360","words":[{"g":"me"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to sleep"},null]},{"text":"Nosotros salimos temprano por la mañana.","en":"We got an early start.","audio":"https://tatoeba.org/en/audio/download/459774","words":[{"g":"we"},{"g":"to go out","l":"salir"},null,{"g":"for / by"},{"g":"the / her"},{"g":"tomorrow"}]},{"text":"Mi madre se levanta temprano.","en":"My mother gets up early.","audio":"https://tatoeba.org/en/audio/download/581965","words":[{"g":"my"},{"g":"mother"},{"g":"oneself"},{"g":"to lift","l":"levantar"},null]}]}