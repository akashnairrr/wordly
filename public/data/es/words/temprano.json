{"id":"temprano","lemma":"temprano","pos":"adv","rank":734,"glosses":["early, early on"],"ipa":"/temˈpɾano/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-temprano.wav","examples":[{"text":"Yo me levanto temprano.","en":"I get up early.","audio":"https://tatoeba.org/en/audio/download/118838"},{"text":"Vuelve a casa temprano.","en":"Come home early.","audio":"https://tatoeba.org/en/audio/download/441328"},{"text":"Él se levanta temprano.","en":"He gets up early.","audio":"https://tatoeba.org/en/audio/download/444237"},{"text":"Estaré en casa temprano.","en":"I'll be home early.","audio":"https://tatoeba.org/en/audio/download/449527"},{"text":"El bus partió temprano.","en":"The bus left early.","audio":"https://tatoeba.org/en/audio/download/798967"}]}