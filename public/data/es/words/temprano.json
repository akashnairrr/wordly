{"id":"temprano","lemma":"temprano","pos":"adv","rank":731,"glosses":["early, early on"],"ipa":"/temˈpɾano/","audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-temprano.wav","examples":[{"text":"Llegué demasiado temprano.","en":"I arrived too early.","audio":"https://tatoeba.org/en/audio/download/450470","words":[{"g":"to arrive, get","l":"llegar"},{"g":"too much"},null]},{"text":"He terminado temprano todo mi trabajo.","en":"I finished all my work early.","audio":"https://tatoeba.org/en/audio/download/587311","words":[{"g":"to have","l":"haber"},{"g":"finished"},null,{"g":"all"},{"g":"my"},{"g":"work, job"}]},{"text":"¿Puedes venir a casa temprano hoy?","en":"Can you come home early today?","audio":"https://tatoeba.org/en/audio/download/606637","words":[{"g":"to be able to, can","l":"poder"},{"g":"to come"},null,null,null,{"g":"today, tonight"}],"phrases":[[2,4,"home"]]},{"text":"Todavía es demasiado temprano.","en":"It's still too early.","audio":"https://tatoeba.org/en/audio/download/519480","words":[{"g":"still, yet"},{"g":"to be","l":"ser"},{"g":"too much"},null]},{"text":"¿A dónde vas tan temprano?","en":"Where are you going so early?","audio":"https://tatoeba.org/en/audio/download/730472","words":[{"g":"to"},{"g":"where"},{"g":"to go","l":"ir"},{"g":"so, as"},null]}]}