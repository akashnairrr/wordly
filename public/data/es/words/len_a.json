{"id":"len_a","lemma":"leña","pos":"noun","rank":3991,"glosses":["firewood, wood (pieces of wood gathered to burn as fuel)","kindling"],"ipa":"/ˈleɲa/","gender":"f","forms":{"plural":"leñas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-le%C3%B1a.wav","examples":[{"text":"¿Puedes ir a buscar leña?","en":"Could you go get some wood for the fire?","audio":"https://tatoeba.org/en/audio/download/611984","words":[{"g":"to be able to, can","l":"poder"},null,null,null,null],"phrases":[[1,4,"to go get, to fetch"]]},{"text":"Necesitamos un poco más de leña.","en":"We need some more firewood.","audio":"https://tatoeba.org/en/audio/download/606701","words":[{"g":"to need","l":"necesitar"},null,null,{"g":"more"},{"g":"of / from"},null],"phrases":[[1,3,"a bit"]]},{"text":"¿Podrías, por favor, poner más leña en el fuego?","en":"Could you please put some more wood on the fire?","audio":"https://tatoeba.org/en/audio/download/425248","words":[{"g":"to be able to, can","l":"poder"},null,null,{"g":"to put, to place"},{"g":"more"},null,{"g":"in / on"},{"g":"the"},{"g":"fire"}],"phrases":[[1,3,"please"]]},{"text":"Echa algo más de leña al fuego.","en":"Put some more wood on the fire.","audio":"https://tatoeba.org/en/audio/download/610995","words":[{"g":"to throw","l":"echar"},{"g":"something, anything"},{"g":"more"},{"g":"of / from"},null,{"g":"to the"},{"g":"fire"}]},{"text":"¿Puedes, por favor, echar más leña al fuego?","en":"Could you please put some more wood on the fire?","audio":"https://tatoeba.org/en/audio/download/425247","words":[{"g":"to be able to, can","l":"poder"},null,null,{"g":"to throw"},{"g":"more"},null,{"g":"to the"},{"g":"fire"}],"phrases":[[1,3,"please"]]}]}