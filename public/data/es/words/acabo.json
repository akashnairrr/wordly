{"id":"acabo","lemma":"acabo","pos":"noun","rank":473,"glosses":["synonym of acabamiento"],"ipa":"/aˈkabo/","gender":"m","forms":{"plural":"acabos"},"examples":[{"text":"Me acabo de levantar.","en":"I just got up.","audio":"https://tatoeba.org/en/audio/download/440237"},{"text":"Acabo de mudarme aquí.","en":"I just moved here.","audio":"https://tatoeba.org/en/audio/download/443987"},{"text":"Me acabo de casar.","en":"I just got married.","audio":"https://tatoeba.org/en/audio/download/448834"},{"text":"Me acabo de despertar.","en":"I've just woken up.","audio":"https://tatoeba.org/en/audio/download/448857"},{"text":"Me acabo de enterar.","en":"I just got the word.","audio":"https://tatoeba.org/en/audio/download/704162"}]}