{"id":"favorito","lemma":"favorito","pos":"adj","rank":1375,"glosses":["favorite/favourite"],"ipa":"/faboˈɾito/","forms":{"feminine":"favorita","masculinePlural":"favoritos","femininePlural":"favoritas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-favorito.wav","examples":[{"text":"Este es mi favorito.","en":"This is my favorite.","audio":"https://tatoeba.org/en/audio/download/799436"},{"text":"Esta es mi favorita.","en":"This is my favorite.","audio":"https://tatoeba.org/en/audio/download/799448"},{"text":"Graham Greene es uno de mis escritores favoritos.","en":"Graham Greene is one of my favorite authors.","audio":"https://tatoeba.org/en/audio/download/806831"},{"text":"Mis favoritas son las manzanas.","en":"I like apples best.","audio":"https://tatoeba.org/en/audio/download/450522"},{"text":"¿Cuál es tu favorito?","en":"Who's your favorite?","audio":"https://tatoeba.org/en/audio/download/453988"}]}