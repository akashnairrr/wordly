{"id":"inocente","lemma":"inocente","pos":"adj","rank":909,"glosses":["innocent"],"ipa":"/inoˈθente/","forms":{"femininePlural":"inocentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-inocente.wav","examples":[{"text":"Él era joven e inocente.","en":"He was young and innocent.","audio":"https://tatoeba.org/en/audio/download/639764","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"young, youthful"},{"g":"and"},null]},{"text":"Nadie cree que es inocente.","en":"No one believes that he is innocent.","audio":"https://tatoeba.org/en/audio/download/594307","words":[{"g":"no one"},{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to be","l":"ser"},null]},{"text":"Son inocentes.","en":"You're innocent.","audio":"https://tatoeba.org/en/audio/download/442348","words":[{"g":"to be","l":"ser"},null]},{"text":"Ella piensa que él es inocente.","en":"She believes that he is innocent.","audio":"https://tatoeba.org/en/audio/download/684368","words":[{"g":"she"},{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"he"},{"g":"to be","l":"ser"},null]},{"text":"Sé que soy inocente.","en":"I know I'm innocent.","audio":"https://tatoeba.org/en/audio/download/449407","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to be","l":"ser"},null]}]}