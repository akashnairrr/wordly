{"id":"inocente","lemma":"inocente","pos":"adj","rank":912,"glosses":["innocent"],"ipa":"/inoˈθente/","forms":{"femininePlural":"inocentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-Marreromarco-inocente.wav","examples":[{"text":"Sé que soy inocente.","en":"I know I'm innocent.","audio":"https://tatoeba.org/en/audio/download/449407"},{"text":"Son inocentes.","en":"You're innocent.","audio":"https://tatoeba.org/en/audio/download/442348"},{"text":"Sé que eres inocente.","en":"I know you're innocent.","audio":"https://tatoeba.org/en/audio/download/459337"},{"text":"Creo que es inocente.","en":"I think she's innocent.","audio":"https://tatoeba.org/en/audio/download/636766"},{"text":"Soy joven e inocente.","en":"I'm young and innocent.","audio":"https://tatoeba.org/en/audio/download/721615"}]}