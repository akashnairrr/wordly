{"id":"necesario","lemma":"necesario","pos":"adj","rank":598,"glosses":["necessary, requisite"],"ipa":"/neθeˈsaɾjo/","forms":{"feminine":"necesaria","masculinePlural":"necesarios","femininePlural":"necesarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Marreromarco-necesario.wav","examples":[{"text":"Eso no es realmente necesario.","en":"That's really not necessary.","audio":"https://tatoeba.org/en/audio/download/519056","words":[{"g":"that","l":"ése"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"really"},null]},{"text":"¿Es necesario que esté aquí mañana?","en":"Do I need to be here tomorrow?","audio":"https://tatoeba.org/en/audio/download/451256","words":[{"g":"to be","l":"ser"},null,{"g":"that"},{"g":"to be","l":"estar"},{"g":"here"},{"g":"tomorrow"}]},{"text":"No tengo la experiencia necesaria.","en":"I don't have enough experience.","audio":"https://tatoeba.org/en/audio/download/422304","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"the / her"},{"g":"experience"},null]},{"text":"Las leyes son necesarias.","en":"Laws are necessary.","audio":"https://tatoeba.org/en/audio/download/448565","words":[{"g":"the / them"},{"g":"law","l":"ley"},{"g":"to be","l":"ser"},null]},{"text":"Haz lo que sea necesario.","en":"Do whatever it takes.","audio":"https://tatoeba.org/en/audio/download/454613","words":[{"g":"to do","l":"hacer"},null,null,null,null],"phrases":[[1,4,"whatever"]]}]}