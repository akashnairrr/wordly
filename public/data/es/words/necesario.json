{"id":"necesario","lemma":"necesario","pos":"adj","rank":598,"glosses":["necessary, requisite"],"ipa":"/neθeˈsaɾjo/","forms":{"feminine":"necesaria","masculinePlural":"necesarios","femininePlural":"necesarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Marreromarco-necesario.wav","examples":[{"text":"Tú eres necesario.","en":"You're necessary.","audio":"https://tatoeba.org/en/audio/download/512977","words":[{"g":"you"},{"g":"to be","l":"ser"},null]},{"text":"No tengo la experiencia necesaria.","en":"I don't have enough experience.","audio":"https://tatoeba.org/en/audio/download/422304","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"the / her"},{"g":"experience"},null]},{"text":"No es necesario que tú hagas eso.","en":"You don't have to do that.","audio":"https://tatoeba.org/en/audio/download/65197","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null,{"g":"that"},{"g":"you"},{"g":"to do","l":"hacer"},{"g":"that","l":"ése"}]},{"text":"Las leyes son necesarias.","en":"Laws are necessary.","audio":"https://tatoeba.org/en/audio/download/448565","words":[{"g":"the / them"},{"g":"law","l":"ley"},{"g":"to be","l":"ser"},null]},{"text":"Hay mucha más agua de la necesaria.","en":"There is more water than is needed.","audio":"https://tatoeba.org/en/audio/download/38164","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},{"g":"more"},{"g":"water"},null,null,null],"phrases":[[4,6,"of the"]]}]}