{"id":"necesario","lemma":"necesario","pos":"adj","rank":601,"glosses":["necessary, requisite"],"ipa":"/neθeˈsaɾjo/","forms":{"feminine":"necesaria","masculinePlural":"necesarios","femininePlural":"necesarias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Marreromarco-necesario.wav","examples":[{"text":"Vendré si es necesario.","en":"I'll come if necessary.","audio":"https://tatoeba.org/en/audio/download/38126"},{"text":"No tengo la experiencia necesaria.","en":"I don't have enough experience.","audio":"https://tatoeba.org/en/audio/download/422304"},{"text":"Espero que hagas los arreglos necesarios.","en":"I expect you to make all the necessary arrangements.","audio":"https://tatoeba.org/en/audio/download/734877"},{"text":"Las leyes son necesarias.","en":"Laws are necessary.","audio":"https://tatoeba.org/en/audio/download/448565"},{"text":"Es necesario que continúe.","en":"I've got to keep going.","audio":"https://tatoeba.org/en/audio/download/297619"}]}