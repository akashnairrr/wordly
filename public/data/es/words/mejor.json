{"id":"mejor","lemma":"mejor","pos":"adj","rank":86,"glosses":["better","better off","improved"],"ipa":"/meˈxoɾ/","forms":{"femininePlural":"mejores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a6/LL-Q1321_%28spa%29-Marreromarco-mejor.wav","examples":[{"text":"El rojo es mejor.","en":"Red is better.","audio":"https://tatoeba.org/en/audio/download/501187"},{"text":"¡Que te mejores pronto!","en":"Get well soon!","audio":"https://tatoeba.org/en/audio/download/798882"},{"text":"Hazlo lo mejor posible.","en":"Try your best.","audio":"https://tatoeba.org/en/audio/download/850170"},{"text":"Es uno de los mejores.","en":"He's one of the best.","audio":"https://tatoeba.org/en/audio/download/636799"},{"text":"Usted es la mejor.","en":"You're the best.","audio":"https://tatoeba.org/en/audio/download/443254"}]}