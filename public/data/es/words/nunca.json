{"id":"nunca","lemma":"nunca","pos":"adv","rank":77,"glosses":["never","ever"],"ipa":"/ˈnunka/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q1321_%28spa%29-AdrianAbdulBaha-nunca.wav","examples":[{"text":"Nunca digas eso.","en":"Never say that.","audio":"https://tatoeba.org/en/audio/download/441209","words":[null,{"g":"to say","l":"decir"},{"g":"that","l":"ése"}]},{"text":"Nunca tendré un hijo.","en":"I will never have a son.","audio":"https://tatoeba.org/en/audio/download/703543","words":[null,{"g":"to have","l":"tener"},{"g":"a"},{"g":"son"}]},{"text":"Nunca tendré una hija.","en":"I will never have a daughter.","audio":"https://tatoeba.org/en/audio/download/703544","words":[null,{"g":"to have","l":"tener"},{"g":"a"},{"g":"daughter"}]},{"text":"Nunca has oído de mí, ¿verdad?","en":"You've never heard of me, have you?","audio":"https://tatoeba.org/en/audio/download/515063","words":[null,{"g":"to have","l":"haber"},{"g":"hearing"},{"g":"of / from"},{"g":"me"},{"g":"truth"}]},{"text":"Nunca lo olvides.","en":"Never forget it.","audio":"https://tatoeba.org/en/audio/download/509818","words":[null,{"g":"it / him"},{"g":"to forget","l":"olvidar"}]}]}