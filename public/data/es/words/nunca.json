{"id":"nunca","lemma":"nunca","pos":"adv","rank":77,"glosses":["never","ever"],"ipa":"/ˈnunka/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/ae/LL-Q1321_%28spa%29-AdrianAbdulBaha-nunca.wav","examples":[{"text":"Yo nunca me preocupo.","en":"I never worry.","audio":"https://tatoeba.org/en/audio/download/440360"},{"text":"No lo hago nunca.","en":"I never do that.","audio":"https://tatoeba.org/en/audio/download/169266"},{"text":"No me rindo nunca.","en":"I never give up.","audio":"https://tatoeba.org/en/audio/download/68043"},{"text":"Nunca dije que no.","en":"I never said no.","audio":"https://tatoeba.org/en/audio/download/441744"},{"text":"Nunca me dejes ir.","en":"Never let me go.","audio":"https://tatoeba.org/en/audio/download/589691"}]}