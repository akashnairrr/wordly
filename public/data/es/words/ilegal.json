{"id":"ilegal","lemma":"ilegal","pos":"adj","rank":1647,"glosses":["illegal, unlawful"],"ipa":"/ileˈɡal/","forms":{"femininePlural":"ilegales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-Marreromarco-ilegal.wav","examples":[{"text":"No hice nada ilegal.","en":"I did nothing illegal.","audio":"https://tatoeba.org/en/audio/download/454211"},{"text":"Las trampas de acero son ilegales.","en":"Steel traps are illegal.","audio":"https://tatoeba.org/en/audio/download/803608"},{"text":"Esto debería ser ilegal.","en":"This should be illegal.","audio":"https://tatoeba.org/en/audio/download/461288"},{"text":"Las peleas de gallos son ilegales en muchos países.","en":"Cockfighting is illegal in many countries."},{"text":"No hicimos nada ilegal.","en":"We didn't do anything illegal.","audio":"https://tatoeba.org/en/audio/download/515181"}]}