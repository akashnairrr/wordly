{"id":"ilegal","lemma":"ilegal","pos":"adj","rank":1644,"glosses":["illegal, unlawful"],"ipa":"/ileˈɡal/","forms":{"femininePlural":"ilegales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-Marreromarco-ilegal.wav","examples":[{"text":"Eso es ilegal.","en":"That's illegal.","audio":"https://tatoeba.org/en/audio/download/441085","words":[null,null,null],"phrases":[[0,2,"that's it"]]},{"text":"No hice nada ilegal.","en":"I did nothing illegal.","audio":"https://tatoeba.org/en/audio/download/454211","words":[{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"nothing"},null]},{"text":"Esto debería ser ilegal.","en":"This should be illegal.","audio":"https://tatoeba.org/en/audio/download/461288","words":[{"g":"this"},{"g":"to owe","l":"deber"},{"g":"to be"},null]},{"text":"Por supuesto que es ilegal.","en":"Of course, this is illegal.","audio":"https://tatoeba.org/en/audio/download/519008","words":[null,null,{"g":"that"},{"g":"to be","l":"ser"},null],"phrases":[[0,2,"of course"]]},{"text":"Las trampas de acero son ilegales.","en":"Steel traps are illegal.","audio":"https://tatoeba.org/en/audio/download/803608","words":[{"g":"the / them"},{"g":"trap, snare","l":"trampa"},null,null,{"g":"to be","l":"ser"},null],"phrases":[[2,4,"steely"]]}]}