{"id":"llegado","lemma":"llegado","pos":"adj","rank":510,"glosses":["arrived, received, delivered"],"ipa":"/ʝeˈɡado/","forms":{"feminine":"llegada","masculinePlural":"llegados","femininePlural":"llegadas"},"formAudio":{"llegada":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q1321_%28spa%29-Marreromarco-llegada.wav"},"examples":[{"text":"¿Ya ha llegado?","en":"Has he arrived yet?","audio":"https://tatoeba.org/en/audio/download/450164","words":[{"g":"now"},{"g":"to have","l":"haber"},null]},{"text":"¿Cuándo has llegado?","en":"When did you arrive?","audio":"https://tatoeba.org/en/audio/download/453224","words":[{"g":"when"},{"g":"to have","l":"haber"},null]},{"text":"Algunos animales pueden sentir la llegada de una tormenta.","en":"Some animals can sense the coming of a storm.","audio":"https://tatoeba.org/en/audio/download/693679","words":[{"g":"someone","l":"alguno"},{"g":"animal","l":"animal"},{"g":"to be able to, can","l":"poder"},{"g":"to feel"},{"g":"the / her"},null,{"g":"of / from"},{"g":"a"},{"g":"storm"}]},{"text":"¿Cómo ha llegado él hasta aquí?","en":"How did he come here?","audio":"https://tatoeba.org/en/audio/download/527040","words":[{"g":"how"},{"g":"to have","l":"haber"},null,{"g":"he"},null,null],"phrases":[[4,6,"so far"]]},{"text":"Ella murió dos días después de su llegada.","en":"She died two days after his arrival.","words":[{"g":"she"},{"g":"to die","l":"morir"},{"g":"dung, excrement"},{"g":"day","l":"día"},null,null,{"g":"his / her / your"},null],"phrases":[[4,6,"after"]]}]}