{"id":"expectativa","lemma":"expectativa","pos":"noun","rank":3871,"glosses":["expectation (that which is expected or looked for)"],"ipa":"/eɡspeɡtaˈtiba/","gender":"f","forms":{"plural":"expectativas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-AdrianAbdulBaha-expectativa.wav","examples":[{"text":"No hay expectativas de victoria.","en":"We have no expectations of victory.","audio":"https://tatoeba.org/en/audio/download/527471","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"victory"}]},{"text":"Quedó por debajo de mis expectativas.","en":"It fell short of my expectation.","words":[{"g":"to be , to end up","l":"quedar"},null,null,null,{"g":"my"},null],"phrases":[[1,4,"below"]]},{"text":"Tu trabajo no cumplió con nuestras expectativas.","en":"Your work didn't come up to our expectations.","audio":"https://tatoeba.org/en/audio/download/77912","words":[{"g":"your"},{"g":"work, job"},{"g":"no / not"},{"g":"to fulfil","l":"cumplir"},{"g":"with"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"No hay ninguna expectativa de que él se recupere.","en":"There is no hope of his recovery.","audio":"https://tatoeba.org/en/audio/download/534347","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"nobody","l":"ninguno"},null,null,null,{"g":"he"},{"g":"oneself"},{"g":"to recover","l":"recuperar"}],"phrases":[[4,6,"that"]]},{"text":"Tom tenía expectativas demasiado altas.","en":"Tom's expectations were too high.","words":[null,{"g":"to have","l":"tener"},null,{"g":"too much"},{"g":"tall","l":"alto"}]}]}