{"id":"objeto","lemma":"objeto","pos":"noun","rank":1856,"glosses":["object","objective; goal"],"ipa":"/obˈxeto/","gender":"m","forms":{"plural":"objetos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f4/LL-Q1321_%28spa%29-Marreromarco-objeto.wav","examples":[{"text":"Vimos un objeto extraño en el cielo.","en":"We saw a strange object in the sky.","audio":"https://tatoeba.org/en/audio/download/706006","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},null,{"g":"strange"},{"g":"in / on"},{"g":"the"},{"g":"sky"}]},{"text":"Había varios objetos en el cuarto.","en":"There were various objects in the room.","audio":"https://tatoeba.org/en/audio/download/599218","words":[{"g":"makes pluperfect to…"},{"g":"various, several"},null,{"g":"in / on"},{"g":"the"},{"g":"fourth"}]},{"text":"Había un objeto en la carretera.","en":"There was something on the road.","audio":"https://tatoeba.org/en/audio/download/417900","words":[{"g":"makes pluperfect to…"},{"g":"a"},null,{"g":"in / on"},{"g":"the / her"},{"g":"road, highway"}]},{"text":"¿Dónde está \"objetos perdidos\"?","en":"Where is the lost and found?","audio":"https://tatoeba.org/en/audio/download/333077","words":[null,null,null,{"g":"lost","l":"perdido"}],"phrases":[[0,2,"where are you?"]]},{"text":"¿Puedes describir el objeto?","en":"Can you describe the object?","words":[{"g":"to be able to, can","l":"poder"},{"g":"to describe"},{"g":"the"},null]}]}