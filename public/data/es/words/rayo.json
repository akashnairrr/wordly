{"id":"rayo","lemma":"rayo","pos":"noun","rank":2209,"glosses":["beam, ray (wave of energy)","a bolt of lightning"],"ipa":"/ˈraʝo/","gender":"m","forms":{"plural":"rayos"},"order":2232,"audio":"https://upload.wikimedia.org/wikipedia/commons/6/69/LL-Q1321_%28spa%29-AdrianAbdulBaha-rayo.wav","examples":[{"text":"Un rayo cayó en esa torre.","en":"Lightning hit that tower.","audio":"https://tatoeba.org/en/audio/download/69878","words":[{"g":"a"},null,{"g":"to fall","l":"caer"},{"g":"in / on"},{"g":"that","l":"ese"},{"g":"tower"}]},{"text":"Después del rayo, vino el trueno.","en":"After the lightning, came the thunder.","audio":"https://tatoeba.org/en/audio/download/704439","words":[{"g":"later"},{"g":"of the"},null,{"g":"to come","l":"venir"},{"g":"the"},{"g":"a clap of thunder"}]},{"text":"¿Qué rayos es esto?","en":"What in the world is this?","audio":"https://tatoeba.org/en/audio/download/598563","words":[{"g":"what"},null,{"g":"to be","l":"ser"},{"g":"this"}]}]}