{"id":"canal","lemma":"canal","pos":"noun","rank":1608,"glosses":["canal, flume, waterway (artificial)","channel (wide strait)","channel"],"ipa":"/kaˈnal/","gender":"m","forms":{"plural":"canales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/eb/LL-Q1321_%28spa%29-AdrianAbdulBaha-canal.wav","examples":[{"text":"No cambies de canal.","en":"Don't change the channel.","audio":"https://tatoeba.org/en/audio/download/582064"},{"text":"Por favor, deja los canales en paz.","en":"Please stop changing channels.","audio":"https://tatoeba.org/en/audio/download/531862"},{"text":"El buzo se tiró al canal.","en":"The frogman jumped into the canal.","audio":"https://tatoeba.org/en/audio/download/703809"},{"text":"¿Puedo ver qué hay en los otros canales?","en":"Can I see what's on the other channels?","audio":"https://tatoeba.org/en/audio/download/586754"},{"text":"Por favor, deja de cambiar de canal.","en":"Please stop changing channels.","audio":"https://tatoeba.org/en/audio/download/531861"}]}