{"id":"aprecio","lemma":"aprecio","pos":"noun","rank":1803,"glosses":["appreciation"],"ipa":"/aˈpɾeθjo/","gender":"m","forms":{"plural":"aprecios"},"examples":[{"text":"Yo aprecio tu ayuda.","en":"I appreciate your help.","audio":"https://tatoeba.org/en/audio/download/458576","words":[{"g":"I"},null,{"g":"your"},{"g":"help, aid"}]},{"text":"De verdad lo aprecio.","en":"I really appreciate it.","audio":"https://tatoeba.org/en/audio/download/461818","words":[null,null,{"g":"it / him"},null],"phrases":[[0,2,"really"]]},{"text":"Aprecio el consejo.","en":"I appreciate the advice.","audio":"https://tatoeba.org/en/audio/download/462186","words":[null,{"g":"the"},{"g":"advice"}]},{"text":"Realmente aprecio eso.","en":"I really appreciate that.","audio":"https://tatoeba.org/en/audio/download/582464","words":[{"g":"really"},null,{"g":"that","l":"ése"}]},{"text":"Aprecio mucho su consejo.","en":"I greatly appreciate your advice.","audio":"https://tatoeba.org/en/audio/download/735497","words":[null,{"g":"much"},{"g":"his / her / your"},{"g":"advice"}]}]}