{"id":"aprecio","lemma":"aprecio","pos":"noun","rank":1806,"glosses":["appreciation"],"ipa":"/aˈpɾeθjo/","gender":"m","forms":{"plural":"aprecios"},"examples":[{"text":"Yo aprecio un desafío.","en":"I enjoy a challenge.","audio":"https://tatoeba.org/en/audio/download/449530"},{"text":"Yo aprecio tu ayuda.","en":"I appreciate your help.","audio":"https://tatoeba.org/en/audio/download/458576"},{"text":"De verdad lo aprecio.","en":"I really appreciate it.","audio":"https://tatoeba.org/en/audio/download/461818"},{"text":"Aprecio toda tu ayuda.","en":"I appreciate all your help.","audio":"https://tatoeba.org/en/audio/download/582576"},{"text":"Realmente aprecio tu ayuda.","en":"I really appreciate your help.","audio":"https://tatoeba.org/en/audio/download/582524"}]}