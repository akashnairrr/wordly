{"id":"apartamento","lemma":"apartamento","pos":"noun","rank":841,"glosses":["flat, apartment"],"ipa":"/apaɾtaˈmento/","gender":"m","forms":{"plural":"apartamentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-AdrianAbdulBaha-apartamento.wav","examples":[{"text":"Estoy en mi apartamento.","en":"I'm in my apartment.","audio":"https://tatoeba.org/en/audio/download/448159"},{"text":"Este edificio tiene 5 pisos y 20 apartamentos.","en":"This building has 5 floors and 20 apartments.","audio":"https://tatoeba.org/en/audio/download/531693"},{"text":"Mi apartamento está cerca.","en":"My apartment is near.","audio":"https://tatoeba.org/en/audio/download/721875"},{"text":"Vivo en un apartamento.","en":"I live in an apartment.","audio":"https://tatoeba.org/en/audio/download/458575"},{"text":"¿Has alquilado un apartamento?","en":"Did you rent an apartment?","audio":"https://tatoeba.org/en/audio/download/582373"}]}