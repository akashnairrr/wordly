{"id":"brillante","lemma":"brillante","pos":"adj","rank":916,"glosses":["bright, brilliant, lustrous, shiny, glowing, sparkly, glittering, glossy","excellent, outstanding, exemplary, scintillating"],"ipa":"/bɾiˈʝante/","forms":{"femininePlural":"brillantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-brillante.wav","examples":[{"text":"Tienes un futuro brillante.","en":"You have a bright future.","audio":"https://tatoeba.org/en/audio/download/519481","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"future"},null]},{"text":"Veo un futuro brillante para ti.","en":"I see a bright future for you.","audio":"https://tatoeba.org/en/audio/download/538090","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"future"},null,{"g":"for"},{"g":"you","l":"tú"}]},{"text":"Ambos son muy brillantes.","en":"Both of them are very brilliant.","audio":"https://tatoeba.org/en/audio/download/707789","words":[{"g":"both"},{"g":"to be","l":"ser"},null,null]},{"text":"Esto es demasiado brillante.","en":"This is too bright.","audio":"https://tatoeba.org/en/audio/download/636533","words":[{"g":"this"},{"g":"to be","l":"ser"},{"g":"too much"},null]},{"text":"Nunca se me ocurren ideas brillantes.","en":"Bright ideas never occur to me.","audio":"https://tatoeba.org/en/audio/download/1187597","words":[{"g":"never"},{"g":"oneself"},{"g":"me"},{"g":"to happen, to occur","l":"ocurrir"},{"g":"idea","l":"idea"},null]}]}