{"id":"brillante","lemma":"brillante","pos":"adj","rank":919,"glosses":["bright, brilliant, lustrous, shiny, glowing, sparkly, glittering, glossy","excellent, outstanding, exemplary, scintillating"],"ipa":"/bɾiˈʝante/","forms":{"femininePlural":"brillantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-brillante.wav","examples":[{"text":"Esto es demasiado brillante.","en":"This is too bright.","audio":"https://tatoeba.org/en/audio/download/636533"},{"text":"Ambos son muy brillantes.","en":"Both of them are very brilliant.","audio":"https://tatoeba.org/en/audio/download/707789"},{"text":"Tienes un futuro brillante.","en":"You have a bright future.","audio":"https://tatoeba.org/en/audio/download/519481"},{"text":"Me gustan los colores brillantes.","en":"I like bright colors.","audio":"https://tatoeba.org/en/audio/download/453389"},{"text":"Ésa es una idea brillante.","en":"That's a brilliant idea.","audio":"https://tatoeba.org/en/audio/download/40185"}]}