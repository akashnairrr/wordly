{"id":"bosque","lemma":"bosque","pos":"noun","rank":901,"glosses":["forest"],"ipa":"/ˈboske/","gender":"m","forms":{"plural":"bosques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Rodelar-bosque.wav","examples":[{"text":"Este bosque necesita nuestra protección.","en":"This forest needs our protection.","audio":"https://tatoeba.org/en/audio/download/688479","words":[{"g":"this"},null,{"g":"to need","l":"necesitar"},{"g":"our, ours, to us","l":"nuestro"},{"g":"protection"}]},{"text":"Nos hemos perdido en el bosque.","en":"We got lost in the woods.","audio":"https://tatoeba.org/en/audio/download/599984","words":[{"g":"us"},{"g":"heme","l":"hemo"},{"g":"lost"},{"g":"in / on"},{"g":"the"},null]},{"text":"Vivo cerca de un bosque.","en":"I live near a forest.","audio":"https://tatoeba.org/en/audio/download/845538","words":[{"g":"alive, living"},null,null,{"g":"a"},null],"phrases":[[1,3,"close to"]]},{"text":"Él vivía solo en el bosque.","en":"He lived alone in the forest.","words":[{"g":"he"},{"g":"to live","l":"vivir"},{"g":"sole"},{"g":"in / on"},{"g":"the"},null]},{"text":"Los árboles no dejan ver el bosque.","en":"You can't see the forest for the trees.","audio":"https://tatoeba.org/en/audio/download/935759","words":[{"g":"the / them"},{"g":"tree","l":"árbol"},{"g":"no / not"},{"g":"to leave","l":"dejar"},{"g":"to see, to spot"},{"g":"the"},null]}]}