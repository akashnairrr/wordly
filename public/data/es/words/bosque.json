{"id":"bosque","lemma":"bosque","pos":"noun","rank":904,"glosses":["forest"],"ipa":"/ˈboske/","gender":"m","forms":{"plural":"bosques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Rodelar-bosque.wav","examples":[{"text":"Entré en el bosque.","en":"I entered the forest.","audio":"https://tatoeba.org/en/audio/download/845537"},{"text":"La Tierra está cubierta de bosques.","en":"The earth is covered with forests."},{"text":"Vivo cerca de un bosque.","en":"I live near a forest.","audio":"https://tatoeba.org/en/audio/download/845538"},{"text":"Un tercio del territorio de Suiza está cubierto de bosques.","en":"A third of Switzerland's territory is covered in forests."},{"text":"Tom está en el bosque.","en":"Tom is in the forest.","audio":"https://tatoeba.org/en/audio/download/353672"}]}