{"id":"bosque","lemma":"bosque","pos":"noun","rank":901,"glosses":["forest"],"ipa":"/ˈboske/","gender":"m","forms":{"plural":"bosques"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Rodelar-bosque.wav","examples":[{"text":"Me perdí en el bosque.","en":"I got lost in the woods.","audio":"https://tatoeba.org/en/audio/download/460431","words":[{"g":"me"},{"g":"to lose","l":"perder"},{"g":"in / on"},{"g":"the"},null]},{"text":"Nos hemos perdido en el bosque.","en":"We got lost in the woods.","audio":"https://tatoeba.org/en/audio/download/599984","words":[{"g":"us"},{"g":"heme","l":"hemo"},{"g":"lost"},{"g":"in / on"},{"g":"the"},null]},{"text":"Todos los días me paseo por el bosque.","en":"I walk in the forest every day.","audio":"https://tatoeba.org/en/audio/download/582320","words":[{"g":"all","l":"todo"},{"g":"the / them"},{"g":"day","l":"día"},{"g":"me"},{"g":"walk, stroll"},{"g":"for / by"},{"g":"the"},null]},{"text":"Vivo cerca de un bosque.","en":"I live near a forest.","audio":"https://tatoeba.org/en/audio/download/845538","words":[{"g":"alive, living"},null,null,{"g":"a"},null],"phrases":[[1,3,"close to"]]},{"text":"Mira lo que he encontrado en el bosque.","en":"Look what I found in the woods.","audio":"https://tatoeba.org/en/audio/download/435695","words":[{"g":"target"},null,null,{"g":"to have","l":"haber"},{"g":"found"},{"g":"in / on"},{"g":"the"},null],"phrases":[[1,3,"what, that which"]]}]}