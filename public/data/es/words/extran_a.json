{"id":"extran_a","lemma":"extraña","pos":"noun","rank":1068,"glosses":["China aster; annual aster"],"ipa":"/e(ɡ)sˈtɾaɲa/","gender":"f","forms":{"plural":"extrañas"},"examples":[{"text":"Fue una extraña noche.","en":"It was a strange night.","audio":"https://tatoeba.org/en/audio/download/721829"},{"text":"Las pinturas de Picasso me parecen extrañas.","en":"Picasso's paintings seem strange to me.","audio":"https://tatoeba.org/en/audio/download/1189070"},{"text":"Esta situación es extraña.","en":"This situation is funny.","audio":"https://tatoeba.org/en/audio/download/67114"},{"text":"Tom murió en extrañas circunstancias.","en":"Tom died in strange circumstances."},{"text":"Su historia suena extraña.","en":"His story sounds strange.","audio":"https://tatoeba.org/en/audio/download/705898"}]}