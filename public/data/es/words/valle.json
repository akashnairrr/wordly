{"id":"valle","lemma":"valle","pos":"noun","rank":2136,"glosses":["valley"],"ipa":"/ˈbaʝe/","gender":"m","forms":{"plural":"valles"},"order":2159,"audio":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1321_%28spa%29-AdrianAbdulBaha-valle.wav","examples":[{"text":"Conoces este valle tan bien como cualquiera.","en":"You know this valley as well as anyone.","words":[{"g":"to know","l":"conocer"},{"g":"this"},null,{"g":"so, as"},null,null,{"g":"anyone"}],"phrases":[[4,6,"synonym of así como"]]},{"text":"Un río corre a través del valle.","en":"A river flows through the valley.","words":[{"g":"a"},{"g":"river"},{"g":"to run, to jog","l":"correr"},{"g":"to"},{"g":"bend, turn"},{"g":"of the"},null]},{"text":"El río atraviesa el valle.","en":"The river runs through the valley.","words":[{"g":"the"},{"g":"river"},{"g":"to cross, to traverse","l":"atravesar"},{"g":"the"},null]}]}