{"id":"camino","lemma":"camino","pos":"noun","rank":225,"glosses":["way, route","road","path"],"ipa":"/kaˈmino/","gender":"m","forms":{"plural":"caminos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Rodelar-camino.wav","examples":[{"text":"Tú diriges el camino.","en":"You lead the way.","audio":"https://tatoeba.org/en/audio/download/444071"},{"text":"Ellos se fueron por caminos separados.","en":"They went their separate ways."},{"text":"Estás en mi camino.","en":"You're in my way.","audio":"https://tatoeba.org/en/audio/download/444125"},{"text":"Terminamos y seguimos nuestros propios caminos.","en":"We broke up and went our own ways."},{"text":"Él bloqueó mi camino.","en":"He blocked my way.","audio":"https://tatoeba.org/en/audio/download/519174"}]}