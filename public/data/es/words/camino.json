{"id":"camino","lemma":"camino","pos":"noun","rank":222,"glosses":["way, route","road","path"],"ipa":"/kaˈmino/","gender":"m","forms":{"plural":"caminos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Rodelar-camino.wav","examples":[{"text":"Yo camino todos los días.","en":"I walk every day.","audio":"https://tatoeba.org/en/audio/download/442636","words":[{"g":"I"},null,{"g":"all","l":"todo"},{"g":"the / them"},{"g":"day","l":"día"}]},{"text":"Estás en mi camino.","en":"You're in my way.","audio":"https://tatoeba.org/en/audio/download/444125","words":[{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"my"},null]},{"text":"¿Sabes el camino?","en":"Do you know the way?","audio":"https://tatoeba.org/en/audio/download/44140","words":[{"g":"to know, to understand","l":"saber"},{"g":"the"},null]},{"text":"No te pongas en mi camino.","en":"Don't stand in my way.","audio":"https://tatoeba.org/en/audio/download/453783","words":[{"g":"no / not"},{"g":"you"},{"g":"to put, to place","l":"poner"},{"g":"in / on"},{"g":"my"},null]},{"text":"Ellos se fueron por caminos separados.","en":"They went their separate ways.","words":[{"g":"they","l":"él"},{"g":"oneself"},{"g":"to go","l":"ir"},{"g":"for / by"},null,{"g":"separated, apart","l":"separado"}]}]}