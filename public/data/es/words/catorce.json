{"id":"catorce","lemma":"catorce","pos":"num","rank":4173,"glosses":["fourteen"],"ipa":"/kaˈtoɾθe/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-AdrianAbdulBaha-catorce.wav","examples":[{"text":"Dos por siete es catorce.","en":"Two times seven is fourteen.","words":[{"g":"dung, excrement"},{"g":"for / by"},{"g":"seven"},{"g":"to be","l":"ser"},null]},{"text":"Mañana cumplo catorce años.","en":"I will be fourteen years old tomorrow.","audio":"https://tatoeba.org/en/audio/download/735753","words":[{"g":"tomorrow"},{"g":"to fulfil","l":"cumplir"},null,{"g":"year","l":"año"}]},{"text":"Voy a cumplir catorce años.","en":"I'm going to be fourteen.","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to fulfil"},null,{"g":"year","l":"año"}]},{"text":"Mi habitación es el número catorce del tercer piso.","en":"My room is number fourteen on the third floor.","words":[{"g":"my"},{"g":"room"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"number"},null,{"g":"of the"},null,{"g":"floor, ground"}]},{"text":"¿Has salido del estado en los últimos catorce días?","en":"Have you left the state within the last 14 days?","words":[{"g":"to have","l":"haber"},{"g":"sticking out"},{"g":"of the"},{"g":"country, land"},{"g":"in / on"},{"g":"the / them"},{"g":"final","l":"último"},null,{"g":"day","l":"día"}]}]}