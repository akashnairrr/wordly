{"id":"oye","lemma":"oye","pos":"intj","rank":157,"glosses":["hey! listen! (call to attract attention of a single person)"],"ipa":"/ˈoʝe/","examples":[{"text":"Oye, basta de quejarse.","en":"Hey, quit complaining.","audio":"https://tatoeba.org/en/audio/download/552170"},{"text":"Oye, ¿por qué lloras?","en":"Hey, why are you crying?","audio":"https://tatoeba.org/en/audio/download/802819"},{"text":"Oye, ¿para dónde vas?","en":"Hey, where are you going?","audio":"https://tatoeba.org/en/audio/download/735835"},{"text":"Oye, ¿quieres entretenerte?, acompáñanos.","en":"Hey, you want to have a lot of fun? Come with us.","audio":"https://tatoeba.org/en/audio/download/599289"},{"text":"Oye, ¿quieres pasarlo bien?, acompáñanos.","en":"Hey, you want to have a lot of fun? Come with us.","audio":"https://tatoeba.org/en/audio/download/599288"}]}