{"id":"oye","lemma":"oye","pos":"intj","rank":155,"glosses":["hey! listen! (call to attract attention of a single person)"],"ipa":"/ˈoʝe/","examples":[{"text":"¿Me oye alguien?","en":"Can anyone hear me?","audio":"https://tatoeba.org/en/audio/download/850356","words":[{"g":"me"},null,{"g":"someone, somebody"}]},{"text":"Oye, ¿para dónde vas?","en":"Hey, where are you going?","audio":"https://tatoeba.org/en/audio/download/735835","words":[null,{"g":"for"},{"g":"where"},{"g":"to go","l":"ir"}]},{"text":"Mi abuelo no oye muy bien.","en":"My grandfather can't hear very well.","audio":"https://tatoeba.org/en/audio/download/1153210","words":[{"g":"my"},{"g":"grandfather"},{"g":"no / not"},null,null,null],"phrases":[[4,6,"very well"]]},{"text":"Oye, ven aquí.","en":"Hey, come here.","audio":"https://tatoeba.org/en/audio/download/425182","words":[null,{"g":"to come","l":"venir"},{"g":"here"}]},{"text":"¡Oye tú! ¿Qué estás haciendo?","en":"Hey, you! What are you doing?","words":[null,{"g":"you"},{"g":"what"},{"g":"to be","l":"estar"},{"g":"to do","l":"hacer"}]}]}