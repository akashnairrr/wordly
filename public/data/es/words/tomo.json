{"id":"tomo","lemma":"tomo","pos":"noun","rank":1342,"glosses":["tome, volume"],"ipa":"/ˈtomo/","gender":"m","forms":{"plural":"tomos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-Marreromarco-tomo.wav","examples":[{"text":"Yo tomo café solo.","en":"I take my coffee black.","audio":"https://tatoeba.org/en/audio/download/526833"},{"text":"Este diccionario tiene doce tomos.","en":"This dictionary has 12 volumes.","audio":"https://tatoeba.org/en/audio/download/1191424"},{"text":"No tomo ningún remedio.","en":"I don't take any medicine.","audio":"https://tatoeba.org/en/audio/download/607973"},{"text":"El diccionario tiene dos tomos.","en":"The dictionary comes in two volumes.","audio":"https://tatoeba.org/en/audio/download/538110"},{"text":"No tomo riesgos innecesarios.","en":"I don't take needless risks.","audio":"https://tatoeba.org/en/audio/download/586544"}]}