{"id":"llamado","lemma":"llamado","pos":"adj","rank":412,"glosses":["called"],"ipa":"/ʝaˈmado/","forms":{"feminine":"llamada","masculinePlural":"llamados","femininePlural":"llamadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-Marreromarco-llamado.wav","formAudio":{"llamada":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1321_%28spa%29-Marreromarco-llamada.wav"},"examples":[{"text":"Me ha llamado Tom.","en":"Tom called me.","audio":"https://tatoeba.org/en/audio/download/128177"},{"text":"Necesito hacer una llamada.","en":"I need to make a phone call.","audio":"https://tatoeba.org/en/audio/download/513185"},{"text":"Tengo tres amigos llamados Tom.","en":"I have three friends named Tom."},{"text":"Voy a hacer algunas llamadas.","en":"I'll make a few calls.","audio":"https://tatoeba.org/en/audio/download/454371"},{"text":"He llamado a seguridad.","en":"I called security.","audio":"https://tatoeba.org/en/audio/download/821302"}]}