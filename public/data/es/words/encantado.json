{"id":"encantado","lemma":"encantado","pos":"adj","rank":984,"glosses":["enchanted, charmed","pleased, delighted","thrilled, overjoyed"],"ipa":"/enkanˈtado/","forms":{"feminine":"encantada","masculinePlural":"encantados","femininePlural":"encantadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-Wikipedian-walker-encantado.wav","examples":[{"text":"Estaría encantado de ir en tu lugar.","en":"I'd be glad to go in your place.","audio":"https://tatoeba.org/en/audio/download/615988","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to go"},{"g":"in / on"},{"g":"your"},{"g":"place"}]},{"text":"La casa está encantada.","en":"The house is haunted.","audio":"https://tatoeba.org/en/audio/download/38563","words":[{"g":"the / her"},{"g":"house"},{"g":"to be","l":"estar"},null]},{"text":"Estaba encantado de ayudar.","en":"I was glad to help.","audio":"https://tatoeba.org/en/audio/download/448862","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to help"}]},{"text":"Estoy encantado de estar aquí.","en":"I'm delighted to be here.","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"to be"},{"g":"here"}]},{"text":"Estamos encantados de que esto ocurriera.","en":"We're glad this happened.","audio":"https://tatoeba.org/en/audio/download/765555","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"this"},{"g":"to happen, to occur","l":"ocurrir"}],"phrases":[[2,4,"that"]]}]}