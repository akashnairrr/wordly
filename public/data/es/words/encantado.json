{"id":"encantado","lemma":"encantado","pos":"adj","rank":987,"glosses":["enchanted, charmed","pleased, delighted","thrilled, overjoyed"],"ipa":"/enkanˈtado/","forms":{"feminine":"encantada","masculinePlural":"encantados","femininePlural":"encantadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8a/LL-Q1321_%28spa%29-Wikipedian-walker-encantado.wav","examples":[{"text":"Estaba encantado de ayudar.","en":"I was glad to help.","audio":"https://tatoeba.org/en/audio/download/448862"},{"text":"La casa está encantada.","en":"The house is haunted.","audio":"https://tatoeba.org/en/audio/download/38563"},{"text":"Estamos encantados de ayudaros.","en":"We are glad to help you.","audio":"https://tatoeba.org/en/audio/download/553609"},{"text":"Estaré encantado de ayudarle.","en":"I will gladly help you.","audio":"https://tatoeba.org/en/audio/download/461070"},{"text":"Tom piensa que su casa está encantada.","en":"Tom thinks his house is haunted.","audio":"https://tatoeba.org/en/audio/download/306546"}]}