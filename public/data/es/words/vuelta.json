{"id":"vuelta","lemma":"vuelta","pos":"noun","rank":311,"glosses":["turn","return","walk"],"ipa":"/ˈbwelta/","gender":"f","forms":{"plural":"vueltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q1321_%28spa%29-Marreromarco-vuelta.wav","examples":[{"text":"Ellas están de vuelta.","en":"They're back.","audio":"https://tatoeba.org/en/audio/download/439222"},{"text":"Mi cabeza está dando vueltas.","en":"My head is spinning.","audio":"https://tatoeba.org/en/audio/download/450214"},{"text":"Lo queremos de vuelta.","en":"We want it back.","audio":"https://tatoeba.org/en/audio/download/442288"},{"text":"No te pases de vueltas, Tom.","en":"Dial it back, Tom.","audio":"https://tatoeba.org/en/audio/download/800092"},{"text":"Bienvenido de vuelta, Tom.","en":"Welcome back, Tom.","audio":"https://tatoeba.org/en/audio/download/799685"}]}