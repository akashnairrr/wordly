{"id":"vuelta","lemma":"vuelta","pos":"noun","rank":308,"glosses":["turn","return","walk"],"ipa":"/ˈbwelta/","gender":"f","forms":{"plural":"vueltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e9/LL-Q1321_%28spa%29-Marreromarco-vuelta.wav","examples":[{"text":"¿Te puedo llamar de vuelta?","en":"May I call you back?","audio":"https://tatoeba.org/en/audio/download/799328","words":[{"g":"you"},{"g":"to be able to, can","l":"poder"},{"g":"to summon, to call"},{"g":"of / from"},null]},{"text":"Ya no hay vuelta atrás.","en":"There's no turning back now.","audio":"https://tatoeba.org/en/audio/download/330689","words":[null,null,{"g":"to have","l":"haber"},null,{"g":"behind"}],"phrases":[[0,2,"no longer"]]},{"text":"El tren se dio la vuelta.","en":"The train flipped over.","audio":"https://tatoeba.org/en/audio/download/506297","words":[{"g":"the"},{"g":"train"},{"g":"oneself"},{"g":"to give, to give out","l":"dar"},{"g":"the / her"},null]},{"text":"¿Cómo se siente estar de vuelta?","en":"How does it feel to be back?","audio":"https://tatoeba.org/en/audio/download/639677","words":[{"g":"how"},{"g":"oneself"},{"g":"to seat","l":"sentar"},{"g":"to be"},{"g":"of / from"},null]},{"text":"Ellos lo quieren de vuelta.","en":"They want it back.","audio":"https://tatoeba.org/en/audio/download/449499","words":[{"g":"they","l":"él"},{"g":"it / him"},{"g":"to desire","l":"querer"},{"g":"of / from"},null]}]}