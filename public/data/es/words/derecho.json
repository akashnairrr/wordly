{"id":"derecho","lemma":"derecho","pos":"noun","rank":455,"glosses":["right (a legal, just or moral entitlement)","law, jurisprudence (the study of laws)","law (the profession of dealing with laws (as lawyers, judges, etc.))"],"ipa":"/deˈɾet͡ʃo/","gender":"m","forms":{"plural":"derechos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q1321_%28spa%29-Precision27-derecho.wav","formAudio":{"derechos":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Precision27-derechos.wav"},"examples":[{"text":"Mi brazo derecho es fuerte.","en":"My right arm is strong.","audio":"https://tatoeba.org/en/audio/download/456598","words":[{"g":"my"},{"g":"arm"},null,{"g":"to be","l":"ser"},{"g":"strong"}]},{"text":"Yo tengo derechos.","en":"I have rights.","audio":"https://tatoeba.org/en/audio/download/440305","words":[{"g":"I"},{"g":"to have","l":"tener"},null]},{"text":"Tengo el derecho a llamar a mi abogado.","en":"I have the right to call my lawyer.","audio":"https://tatoeba.org/en/audio/download/77441","words":[{"g":"to have","l":"tener"},{"g":"the"},null,{"g":"to"},{"g":"to summon, to call"},{"g":"to"},{"g":"my"},{"g":"lawyer"}]},{"text":"Conozco mis derechos.","en":"I know my legal rights.","audio":"https://tatoeba.org/en/audio/download/462005","words":[{"g":"to know","l":"conocer"},{"g":"my"},null]},{"text":"Fui derecho a la cama.","en":"I went straight to bed.","audio":"https://tatoeba.org/en/audio/download/460906","words":[{"g":"to go","l":"ir"},null,{"g":"to"},{"g":"the / her"},{"g":"bed"}]}]}