{"id":"pintor","lemma":"pintor","pos":"noun","rank":3668,"glosses":["painter","housepainter"],"ipa":"/pinˈtoɾ/","gender":"m","forms":{"plural":"pintores","feminine":"pintora","femininePlural":"pintoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d8/LL-Q1321_%28spa%29-AdrianAbdulBaha-pintor.wav","examples":[{"text":"Él es un pintor.","en":"He is a painter.","audio":"https://tatoeba.org/en/audio/download/441522","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"El pintor murió joven.","en":"The painter died young.","audio":"https://tatoeba.org/en/audio/download/734512","words":[{"g":"the"},null,{"g":"to die","l":"morir"},{"g":"young, youthful"}]},{"text":"Conozco a muchos pintores.","en":"I know a lot of painters.","audio":"https://tatoeba.org/en/audio/download/567172","words":[{"g":"to know","l":"conocer"},{"g":"to"},{"g":"much","l":"mucho"},null]},{"text":"Eres un pintor muy bueno.","en":"You're a very good painter.","audio":"https://tatoeba.org/en/audio/download/604995","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null,{"g":"good"}]},{"text":"Nació para ser pintor.","en":"He was born to be a painter.","audio":"https://tatoeba.org/en/audio/download/1187351","words":[{"g":"to be born","l":"nacer"},{"g":"for"},{"g":"to be"},null]}]}