{"id":"preocupado","lemma":"preocupado","pos":"adj","rank":966,"glosses":["worried, concerned"],"ipa":"/pɾeokuˈpado/","forms":{"feminine":"preocupada","masculinePlural":"preocupados","femininePlural":"preocupadas"},"examples":[{"text":"Tom todavía está preocupado.","en":"Tom is still worried.","audio":"https://tatoeba.org/en/audio/download/209775"},{"text":"Estoy preocupada por todos.","en":"I'm worried about everybody.","audio":"https://tatoeba.org/en/audio/download/768011"},{"text":"Estamos preocupados por ti.","en":"We are worried about you.","audio":"https://tatoeba.org/en/audio/download/735832"},{"text":"¿Por qué están tan preocupadas?","en":"Why are you so worried?","audio":"https://tatoeba.org/en/audio/download/459947"},{"text":"Ahora estoy algo preocupado.","en":"I'm a bit worried now.","audio":"https://tatoeba.org/en/audio/download/540701"}]}