{"id":"preocupado","lemma":"preocupado","pos":"adj","rank":963,"glosses":["worried, concerned"],"ipa":"/pɾeokuˈpado/","forms":{"feminine":"preocupada","masculinePlural":"preocupados","femininePlural":"preocupadas"},"examples":[{"text":"Estaba muy preocupado por tu seguridad.","en":"I was very concerned for your safety.","audio":"https://tatoeba.org/en/audio/download/582005","words":[{"g":"to be","l":"estar"},null,null,{"g":"for / by"},{"g":"your"},{"g":"safety, security"}]},{"text":"Ella está preocupada por tu seguridad.","en":"She's worried about your safety.","audio":"https://tatoeba.org/en/audio/download/684406","words":[{"g":"she"},{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"your"},{"g":"safety, security"}]},{"text":"Él parece estar preocupado por algo.","en":"He seems to be worried about something.","audio":"https://tatoeba.org/en/audio/download/705464","words":[{"g":"he"},{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},null,null,null],"phrases":[[4,6,"there is a reason"]]},{"text":"¿Por qué están tan preocupados?","en":"Why are you so worried?","audio":"https://tatoeba.org/en/audio/download/459946","words":[null,null,{"g":"to be","l":"estar"},{"g":"so, as"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Todas están preocupadas por ti.","en":"Everybody's concerned about you.","audio":"https://tatoeba.org/en/audio/download/730510","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},null,{"g":"for / by"},{"g":"you","l":"tú"}]}]}