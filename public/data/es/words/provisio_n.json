{"id":"provisio_n","lemma":"provisión","pos":"noun","rank":3812,"glosses":["provision","provisions, supplies"],"ipa":"/pɾobiˈsjon/","gender":"f","forms":{"plural":"provisiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/28/LL-Q1321_%28spa%29-Emanuelps27-provisi%C3%B3n.wav","examples":[{"text":"Se consumieron todas las provisiones.","en":"All the supplies ran out.","words":[{"g":"oneself"},null,{"g":"all","l":"todo"},{"g":"the / them"},null]},{"text":"Hay abundantes provisiones de comida.","en":"There are abundant food supplies.","words":[{"g":"to have","l":"haber"},{"g":"plentiful, abundant","l":"abundante"},null,{"g":"of / from"},{"g":"food"}]},{"text":"Ten en cuenta que vamos a necesitar provisiones.","en":"Keep in mind that we'll need supplies.","words":[{"g":"to have","l":"tener"},{"g":"in / on"},{"g":"count, tally"},{"g":"that"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to need"},null]},{"text":"Las provisiones se están empezando a acabar.","en":"The supplies are beginning to give out.","words":[{"g":"the / them"},null,{"g":"oneself"},{"g":"to be","l":"estar"},{"g":"to start","l":"empezar"},{"g":"to"},{"g":"to finish"}]},{"text":"Se agotaron las provisiones en poco tiempo.","en":"The provisions ran out after a short time.","words":[{"g":"oneself"},{"g":"to exhaust","l":"agotar"},{"g":"the / them"},null,null,null,{"g":"time"}],"phrases":[[4,6,"any time now"]]}]}