{"id":"encima","lemma":"encima","pos":"adv","rank":472,"glosses":["on top of something","above something","on oneself"],"ipa":"/enˈθima/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-AdrianAbdulBaha-encima.wav","examples":[{"text":"¿Cuánto dinero lleva usted encima?","en":"How much money do you have with you?","audio":"https://tatoeba.org/en/audio/download/551531","words":[{"g":"how much"},{"g":"money"},{"g":"to take somewhere","l":"llevar"},{"g":"you (formal)"},null]},{"text":"No lo pongas encima de mi escritorio.","en":"Don't put it on my desk.","audio":"https://tatoeba.org/en/audio/download/460107","words":[{"g":"no / not"},{"g":"it / him"},{"g":"to put, to place","l":"poner"},null,{"g":"of / from"},{"g":"my"},{"g":"writing desk"}]},{"text":"Déjalo encima de la mesa.","en":"Lay it on the table.","audio":"https://tatoeba.org/en/audio/download/39257","words":[{"g":"to leave","l":"dejar"},null,null,null,{"g":"table"}],"phrases":[[2,4,"of the"]]},{"text":"Las llaves están encima de la mesa.","en":"The keys are on the table.","audio":"https://tatoeba.org/en/audio/download/935795","words":[{"g":"the / them"},{"g":"key","l":"llave"},{"g":"to be","l":"estar"},null,null,null,{"g":"table"}],"phrases":[[4,6,"of the"]]},{"text":"Hay un gato encima de la silla.","en":"There's a cat on the chair.","audio":"https://tatoeba.org/en/audio/download/703584","words":[{"g":"to have","l":"haber"},{"g":"a"},{"g":"cat"},null,null,null,{"g":"chair"}],"phrases":[[4,6,"of the"]]}]}