{"id":"encima","lemma":"encima","pos":"adv","rank":472,"glosses":["on top of something","above something","on oneself"],"ipa":"/enˈθima/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-AdrianAbdulBaha-encima.wav","examples":[{"text":"Nunca le puse la mano encima.","en":"I never laid a finger on her.","audio":"https://tatoeba.org/en/audio/download/642095","words":[{"g":"never"},{"g":"him / her"},{"g":"to put, to place","l":"poner"},{"g":"the / her"},{"g":"hand"},null]},{"text":"Déjalo encima de la mesa.","en":"Lay it on the table.","audio":"https://tatoeba.org/en/audio/download/39257","words":[{"g":"to leave","l":"dejar"},null,null,null,{"g":"table"}],"phrases":[[2,4,"of the"]]},{"text":"¿Cuánto dinero lleva usted encima?","en":"How much money do you have with you?","audio":"https://tatoeba.org/en/audio/download/551531","words":[{"g":"how much"},{"g":"money"},{"g":"to take somewhere","l":"llevar"},{"g":"you (formal)"},null]},{"text":"No pongas nada encima de la caja.","en":"Don't put anything on top of the box.","audio":"https://tatoeba.org/en/audio/download/538106","words":[{"g":"no / not"},{"g":"to put, to place","l":"poner"},{"g":"nothing"},null,null,null,{"g":"box, case"}],"phrases":[[4,6,"of the"]]},{"text":"Veo un libro encima de la mesa.","en":"I see a book on the table.","words":[{"g":"to see, to spot","l":"ver"},{"g":"a"},{"g":"book"},null,null,null,{"g":"table"}],"phrases":[[4,6,"of the"]]}]}