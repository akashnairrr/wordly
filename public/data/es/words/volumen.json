{"id":"volumen","lemma":"volumen","pos":"noun","rank":3012,"glosses":["volume (a three-dimensional measure of space)","volume (a bound book)","volume (strength of sound)"],"ipa":"/boˈlumen/","gender":"m","forms":{"plural":"volúmenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q1321_%28spa%29-Marreromarco-volumen.wav","examples":[{"text":"Sube el volumen.","en":"Turn the volume up.","audio":"https://tatoeba.org/en/audio/download/501093","words":[{"g":"to go up or come up","l":"subir"},{"g":"the"},null]},{"text":"¿Podría bajar el volumen?","en":"Could you turn down the volume?","audio":"https://tatoeba.org/en/audio/download/524939","words":[{"g":"to be able to, can","l":"poder"},{"g":"to go down, come down"},{"g":"the"},null]},{"text":"Necesitamos más volumen.","en":"We need more volume.","words":[{"g":"to need","l":"necesitar"},{"g":"more"},null]},{"text":"Baja el volumen, por favor.","en":"Please turn down the volume.","audio":"https://tatoeba.org/en/audio/download/330637","words":[{"g":"casualty, loss"},{"g":"the"},null,null,null],"phrases":[[3,5,"please"]]},{"text":"Sube un poco el volumen de la radio.","en":"Turn the radio up a little.","audio":"https://tatoeba.org/en/audio/download/35390","words":[{"g":"to go up or come up","l":"subir"},null,null,{"g":"the"},null,null,null,{"g":"radio"}],"phrases":[[1,3,"a bit"],[5,7,"of the"]]}]}