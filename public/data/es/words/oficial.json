{"id":"oficial","lemma":"oficial","pos":"noun","rank":540,"glosses":["officer, official","clerk, functionary","office worker, skilled worker"],"ipa":"/ofiˈθjal/","gender":"mf","forms":{"plural":"oficiales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-oficial.wav","examples":[{"text":"Soy oficial de policía.","en":"I'm a police officer.","audio":"https://tatoeba.org/en/audio/download/549938"},{"text":"Nadie se cree las cifras oficiales.","en":"No one believes the official numbers.","audio":"https://tatoeba.org/en/audio/download/741112"},{"text":"Esta noticia es oficial.","en":"This news is official.","audio":"https://tatoeba.org/en/audio/download/1187357"},{"text":"¿Cuáles son sus obligaciones oficiales de empleo?","en":"What are his official job duties?"},{"text":"Tom fue mi oficial al mando.","en":"Tom was my commanding officer.","audio":"https://tatoeba.org/en/audio/download/803588"}]}