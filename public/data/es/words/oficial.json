{"id":"oficial","lemma":"oficial","pos":"noun","rank":537,"glosses":["officer, official","clerk, functionary","office worker, skilled worker"],"ipa":"/ofiˈθjal/","gender":"mf","forms":{"plural":"oficiales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/79/LL-Q1321_%28spa%29-AdrianAbdulBaha-oficial.wav","examples":[{"text":"Tom fue mi oficial al mando.","en":"Tom was my commanding officer.","audio":"https://tatoeba.org/en/audio/download/803588","words":[null,{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"to the"},{"g":"command"}]},{"text":"El oficial a cargo me dejó entrar.","en":"The official in charge let me in.","audio":"https://tatoeba.org/en/audio/download/1154781","words":[{"g":"the"},null,null,null,{"g":"me"},{"g":"to leave","l":"dejar"},{"g":"to enter"}],"phrases":[[2,4,"in charge"]]},{"text":"Todavía soy tu oficial al mando.","en":"I'm still your commanding officer.","audio":"https://tatoeba.org/en/audio/download/803598","words":[{"g":"still, yet"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"to the"},{"g":"command"}]},{"text":"Nadie se cree las cifras oficiales.","en":"No one believes the official numbers.","audio":"https://tatoeba.org/en/audio/download/741112","words":[{"g":"no one"},{"g":"oneself"},{"g":"to believe","l":"creer"},{"g":"the / them"},{"g":"digit","l":"cifra"},null]},{"text":"¿Cómo llegaste a ser un oficial de policía?","en":"How did you become a police officer?","audio":"https://tatoeba.org/en/audio/download/538335","words":[{"g":"how"},{"g":"to arrive, get","l":"llegar"},{"g":"to"},{"g":"to be"},{"g":"a"},null,{"g":"of / from"},{"g":"Civility"}]}]}