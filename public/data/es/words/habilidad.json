{"id":"habilidad","lemma":"habilidad","pos":"noun","rank":1828,"glosses":["ability, skill"],"ipa":"/abiliˈdad/","gender":"f","forms":{"plural":"habilidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-AdrianAbdulBaha-habilidad.wav","examples":[{"text":"No tengo ninguna habilidad especial.","en":"I have no special skill.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"nobody","l":"ninguno"},null,{"g":"special"}]},{"text":"Tengo muchas habilidades.","en":"I have many abilities.","words":[{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},null]},{"text":"Él confía en su habilidad.","en":"He has confidence in his ability.","words":[{"g":"he"},{"g":"to reassure","l":"confiar"},{"g":"in / on"},{"g":"his / her / your"},null]},{"text":"Ella tiene habilidades psíquicas.","en":"She has psychic abilities.","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"psychic, mental","l":"psíquico"}]},{"text":"El hombre tiene la habilidad de hablar.","en":"Man has the ability to talk.","words":[{"g":"the"},{"g":"man"},{"g":"to have","l":"tener"},{"g":"the / her"},null,{"g":"of / from"},{"g":"to talk"}]}]}