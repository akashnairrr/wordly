{"id":"conseguido","lemma":"conseguido","pos":"adj","rank":1142,"glosses":["achieved","acquired, received"],"ipa":"/konseˈɡido/","forms":{"feminine":"conseguida","masculinePlural":"conseguidos","femininePlural":"conseguidas"},"examples":[{"text":"Lo han conseguido ustedes.","en":"You made it.","audio":"https://tatoeba.org/en/audio/download/425169"},{"text":"Tú has conseguido esconderte.","en":"You've got to hide.","audio":"https://tatoeba.org/en/audio/download/448768"},{"text":"Ella ha conseguido sus metas.","en":"She has achieved her goals.","audio":"https://tatoeba.org/en/audio/download/703818"},{"text":"He conseguido coger el último tren.","en":"I managed to catch the last train.","audio":"https://tatoeba.org/en/audio/download/684298"},{"text":"Tenía que haber conseguido ese ascenso.","en":"I should've gotten that promotion.","audio":"https://tatoeba.org/en/audio/download/611704"}]}