{"id":"conseguido","lemma":"conseguido","pos":"adj","rank":1139,"glosses":["achieved","acquired, received"],"ipa":"/konseˈɡido/","forms":{"feminine":"conseguida","masculinePlural":"conseguidos","femininePlural":"conseguidas"},"examples":[{"text":"Lo han conseguido ustedes.","en":"You made it.","audio":"https://tatoeba.org/en/audio/download/425169","words":[{"g":"it / him"},{"g":"to have","l":"haber"},null,{"g":"you all"}]},{"text":"He conseguido coger el último tren.","en":"I managed to catch the last train.","audio":"https://tatoeba.org/en/audio/download/684298","words":[{"g":"to have","l":"haber"},null,{"g":"to take"},{"g":"the"},{"g":"final"},{"g":"train"}]},{"text":"Deberías estar orgulloso de lo que has conseguido.","en":"You should be proud of what you've accomplished.","audio":"https://tatoeba.org/en/audio/download/409667","words":[{"g":"to owe","l":"deber"},{"g":"to be"},{"g":"proud"},{"g":"of / from"},null,null,{"g":"to have","l":"haber"},null],"phrases":[[4,6,"what, that which"]]},{"text":"Me parece estupendo que hayas conseguido el empleo.","en":"I think it's great that you got that job.","words":[{"g":"me"},{"g":"to seem, to see fit","l":"parecer"},{"g":"stupendous"},{"g":"that"},{"g":"beech, beech tree","l":"haya"},null,{"g":"the"},{"g":"job, employment"}]},{"text":"Tú has conseguido esconderte.","en":"You've got to hide.","audio":"https://tatoeba.org/en/audio/download/448768","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"to hide","l":"esconder"}]}]}