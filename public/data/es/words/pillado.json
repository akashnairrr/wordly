{"id":"pillado","lemma":"pillado","pos":"adj","rank":3163,"glosses":["busted, caught","crazy (in love); head over heels"],"ipa":"/piˈʝado/","forms":{"feminine":"pillada","masculinePlural":"pillados","femininePlural":"pilladas"},"examples":[{"text":"Ya lo he pillado.","en":"I do understand.","audio":"https://tatoeba.org/en/audio/download/424750","words":[{"g":"now"},{"g":"it / him"},{"g":"to have","l":"haber"},null]},{"text":"Me he pillado el dedo con la puerta.","en":"I caught my finger in the door.","audio":"https://tatoeba.org/en/audio/download/705807","words":[{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"the"},{"g":"digit: finger or toe"},{"g":"with"},{"g":"the / her"},{"g":"door"}]},{"text":"Fui pillado con los pantalones bajados.","en":"I was caught with my pants down.","audio":"https://tatoeba.org/en/audio/download/1061818","words":[{"g":"to go","l":"ir"},null,{"g":"with"},{"g":"the / them"},{"g":"pants, trousers"},{"g":"peasant","l":"bajado"}]},{"text":"Mi madre ha pillado un terrible resfriado.","en":"My mother is sick with a bad cold.","audio":"https://tatoeba.org/en/audio/download/527199","words":[{"g":"my"},{"g":"mother"},{"g":"to have","l":"haber"},null,{"g":"a"},{"g":"terrible"},{"g":"a cold"}]},{"text":"Espero que no hayas pillado un resfriado.","en":"I hope you haven't caught a cold.","audio":"https://tatoeba.org/en/audio/download/578154","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"no / not"},{"g":"beech, beech tree","l":"haya"},null,{"g":"a"},{"g":"a cold"}]}]}