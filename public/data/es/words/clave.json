{"id":"clave","lemma":"clave","pos":"noun","rank":1441,"glosses":["key (to a problem or puzzle)","password","code"],"ipa":"/ˈklabe/","gender":"f","forms":{"plural":"claves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-clave.wav","examples":[{"text":"Perdí mi clave.","en":"I lost my key.","audio":"https://tatoeba.org/en/audio/download/440216","words":[{"g":"to lose","l":"perder"},{"g":"my"},null]},{"text":"Tenemos la clave.","en":"We've got the key.","audio":"https://tatoeba.org/en/audio/download/548356","words":[{"g":"to have","l":"tener"},{"g":"the / her"},null]},{"text":"La paciencia es la clave.","en":"Patience is the key.","audio":"https://tatoeba.org/en/audio/download/448564","words":[{"g":"the / her"},{"g":"patience, forbearance"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"Para de hablar en clave.","en":"Stop speaking in riddles.","audio":"https://tatoeba.org/en/audio/download/585173","words":[{"g":"for"},{"g":"of / from"},{"g":"to talk"},{"g":"in / on"},null]},{"text":"Necesitamos tu clave.","en":"We need your key.","words":[{"g":"to need","l":"necesitar"},{"g":"your"},null]}]}