{"id":"sincero","lemma":"sincero","pos":"adj","rank":1959,"glosses":["sincere","honest"],"ipa":"/sinˈθeɾo/","forms":{"feminine":"sincera","masculinePlural":"sinceros","femininePlural":"sinceras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-sincero.wav","examples":[{"text":"Me parece que él es sincero.","en":"It seems to me that he is honest.","audio":"https://tatoeba.org/en/audio/download/531667","words":[{"g":"me"},{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"he"},{"g":"to be","l":"ser"},null]},{"text":"Sea sincera conmigo.","en":"Be honest with me.","audio":"https://tatoeba.org/en/audio/download/443355","words":[{"g":"to be","l":"ser"},null,{"g":"with me"}]},{"text":"Para ser sincero, no me gusta.","en":"To tell the truth, I don't like him.","audio":"https://tatoeba.org/en/audio/download/687490","words":[{"g":"for"},{"g":"to be"},null,{"g":"no / not"},null,null],"phrases":[[4,6,"like, thumbs up"]]},{"text":"Todos los niños son sinceros.","en":"All the boys are honest.","audio":"https://tatoeba.org/en/audio/download/805872","words":[{"g":"all","l":"todo"},{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"ser"},null]},{"text":"Sean sinceras conmigo.","en":"Be honest with me.","audio":"https://tatoeba.org/en/audio/download/443356","words":[{"g":"to be","l":"ser"},null,{"g":"with me"}]}]}