{"id":"sincero","lemma":"sincero","pos":"adj","rank":1962,"glosses":["sincere","honest"],"ipa":"/sinˈθeɾo/","forms":{"feminine":"sincera","masculinePlural":"sinceros","femininePlural":"sinceras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/59/LL-Q1321_%28spa%29-AdrianAbdulBaha-sincero.wav","examples":[{"text":"Tom no es sincero.","en":"Tom is insincere.","audio":"https://tatoeba.org/en/audio/download/799355"},{"text":"Él es una persona muy sincera.","en":"He is a very sincere person.","audio":"https://tatoeba.org/en/audio/download/706803"},{"text":"Todos los niños son sinceros.","en":"All the boys are honest.","audio":"https://tatoeba.org/en/audio/download/805872"},{"text":"Por favor, acepta nuestras más sinceras disculpas.","en":"Please accept our heartfelt apologies."},{"text":"Tienes que ser sincero.","en":"You have to be honest.","audio":"https://tatoeba.org/en/audio/download/459112"}]}