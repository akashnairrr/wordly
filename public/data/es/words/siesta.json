{"id":"siesta","lemma":"siesta","pos":"noun","rank":2846,"glosses":["siesta (a nap, especially an afternoon one taken during the hottest part of the day in some cultures)"],"ipa":"/ˈsjesta/","gender":"f","forms":{"plural":"siestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q1321_%28spa%29-Marreromarco-siesta.wav","examples":[{"text":"Necesito una siesta.","en":"I need a nap.","audio":"https://tatoeba.org/en/audio/download/438144","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"Nunca me echo la siesta.","en":"I never take naps.","audio":"https://tatoeba.org/en/audio/download/353512","words":[{"g":"never"},{"g":"me"},{"g":"to throw","l":"echar"},{"g":"the / her"},null]},{"text":"Necesito una larga siesta.","en":"I need a long nap.","audio":"https://tatoeba.org/en/audio/download/443304","words":[{"g":"to need","l":"necesitar"},{"g":"a"},{"g":"long","l":"largo"},null]},{"text":"Él está durmiendo la siesta.","en":"He's taking a nap.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"to sleep","l":"dormir"},{"g":"the / her"},null]},{"text":"Me echo una siesta casi todos los días.","en":"I have a nap almost every day.","audio":"https://tatoeba.org/en/audio/download/642236","words":[{"g":"me"},{"g":"to throw","l":"echar"},{"g":"a"},null,{"g":"almost"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"day","l":"día"}]}]}