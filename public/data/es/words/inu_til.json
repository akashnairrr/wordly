{"id":"inu_til","lemma":"inútil","pos":"adj","rank":1262,"glosses":["useless, pointless"],"ipa":"/iˈnutil/","forms":{"femininePlural":"inútiles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-Marreromarco-in%C3%BAtil.wav","examples":[{"text":"Nuestro plan fue inútil.","en":"Our plan was unsuccessful.","audio":"https://tatoeba.org/en/audio/download/804373"},{"text":"Tus esfuerzos son inútiles.","en":"Your efforts are futile."},{"text":"Es inútil pedirme dinero.","en":"It is no use asking me for money.","audio":"https://tatoeba.org/en/audio/download/553692"},{"text":"No malgastes tu paga en cosas inútiles.","en":"Don't waste your allowance on useless things."},{"text":"Es inútil discutir con él.","en":"It's no use arguing with him.","audio":"https://tatoeba.org/en/audio/download/832972"}]}