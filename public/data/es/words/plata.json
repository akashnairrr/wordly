{"id":"plata","lemma":"plata","pos":"noun","rank":1550,"glosses":["silver","money, dough"],"ipa":"/ˈplata/","gender":"f","forms":{"plural":"platas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-Millars-plata.wav","examples":[{"text":"Tom no tiene plata.","en":"Tom has no money.","audio":"https://tatoeba.org/en/audio/download/800074"},{"text":"Esto no es plata.","en":"This isn't silver.","audio":"https://tatoeba.org/en/audio/download/819932"},{"text":"¿Dónde está la plata?","en":"Where's the money?","audio":"https://tatoeba.org/en/audio/download/450233"},{"text":"Hoy no tengo plata.","en":"I have no money today.","audio":"https://tatoeba.org/en/audio/download/455259"},{"text":"No tengo mucha plata.","en":"I don't have much money.","audio":"https://tatoeba.org/en/audio/download/459967"}]}