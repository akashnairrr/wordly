{"id":"humor","lemma":"humor","pos":"noun","rank":1139,"glosses":["mood (a mental or emotional state)","humor"],"ipa":"/uˈmoɾ/","gender":"m","forms":{"plural":"humores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Marreromarco-humor.wav","examples":[{"text":"Estoy de mal humor.","en":"I'm in a bad mood.","audio":"https://tatoeba.org/en/audio/download/443982"},{"text":"Estaba de buen humor.","en":"I was in good spirits.","audio":"https://tatoeba.org/en/audio/download/705338"},{"text":"Tengo sentido del humor.","en":"I have a sense of humor.","audio":"https://tatoeba.org/en/audio/download/459089"},{"text":"Tienes sentido del humor.","en":"You have a sense of humor.","audio":"https://tatoeba.org/en/audio/download/39422"},{"text":"Estoy siempre de mal humor.","en":"I'm always moody.","audio":"https://tatoeba.org/en/audio/download/442579"}]}