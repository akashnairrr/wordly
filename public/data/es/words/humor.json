{"id":"humor","lemma":"humor","pos":"noun","rank":1136,"glosses":["mood (a mental or emotional state)","humor"],"ipa":"/uˈmoɾ/","gender":"m","forms":{"plural":"humores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Marreromarco-humor.wav","examples":[{"text":"Yo estaba de buen humor.","en":"I was in a good mood.","audio":"https://tatoeba.org/en/audio/download/851431","words":[{"g":"I"},{"g":"to be","l":"estar"},{"g":"of / from"},null,null]},{"text":"Estoy siempre de mal humor.","en":"I'm always moody.","audio":"https://tatoeba.org/en/audio/download/442579","words":[{"g":"to be","l":"estar"},{"g":"always"},{"g":"of / from"},{"g":"badly, poorly, ill"},null]},{"text":"Él tiene sentido del humor.","en":"He has a sense of humor.","audio":"https://tatoeba.org/en/audio/download/461389","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"sense"},{"g":"of the"},null]},{"text":"Él llegó a casa de muy buen humor.","en":"He came home in high spirits.","audio":"https://tatoeba.org/en/audio/download/693034","words":[{"g":"he"},{"g":"to arrive, get","l":"llegar"},null,null,{"g":"of / from"},null,null,null],"phrases":[[2,4,"home"]]},{"text":"Tom no está de buen humor hoy.","en":"Tom isn't in a good mood today.","audio":"https://tatoeba.org/en/audio/download/297781","words":[null,{"g":"no / not"},{"g":"to be","l":"estar"},{"g":"of / from"},null,null,{"g":"today, tonight"}]}]}