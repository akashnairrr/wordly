{"id":"estudio","lemma":"estudio","pos":"noun","rank":934,"glosses":["study","studio"],"ipa":"/esˈtudjo/","gender":"m","forms":{"plural":"estudios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/14/LL-Q1321_%28spa%29-Marreromarco-estudio.wav","formAudio":{"estudios":"https://upload.wikimedia.org/wikipedia/commons/5/55/LL-Q1321_%28spa%29-GlyphEnjoyer-estudios.wav"},"examples":[{"text":"Estudio francés tres horas por día.","en":"I study French for three hours every day.","audio":"https://tatoeba.org/en/audio/download/515999","words":[null,{"g":"French"},{"g":"three"},{"g":"hour","l":"hora"},{"g":"for / by"},{"g":"day"}]},{"text":"Estudio historia del arte.","en":"I study art history.","audio":"https://tatoeba.org/en/audio/download/450150","words":[null,{"g":"history"},{"g":"of the"},{"g":"art"}]},{"text":"Él se concentraba en sus estudios.","en":"He concentrated on his studies.","audio":"https://tatoeba.org/en/audio/download/645455","words":[{"g":"he"},{"g":"oneself"},null,{"g":"in / on"},{"g":"his, her, its, their"},null]},{"text":"Ya no estudio francés.","en":"I no longer study French.","audio":"https://tatoeba.org/en/audio/download/302518","words":[null,null,null,{"g":"French"}],"phrases":[[0,2,"no longer"]]},{"text":"La enfermedad le hizo dejar los estudios.","en":"Illness made him give up his studies.","audio":"https://tatoeba.org/en/audio/download/689021","words":[{"g":"the / her"},{"g":"illness, disease"},{"g":"him / her"},{"g":"to do","l":"hacer"},{"g":"to leave"},{"g":"the / them"},null]}]}