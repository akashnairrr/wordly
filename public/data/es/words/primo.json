{"id":"primo","lemma":"primo","pos":"adj","rank":1256,"glosses":["first","prime"],"ipa":"/ˈpɾimo/","forms":{"feminine":"prima","masculinePlural":"primos","femininePlural":"primas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-primo.wav","formAudio":{"prima":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q1321_%28spa%29-AdrianAbdulBaha-prima.wav"},"examples":[{"text":"No es mi primo.","en":"He isn't my cousin.","audio":"https://tatoeba.org/en/audio/download/449849"},{"text":"Mi prima me invitó a su boda.","en":"My cousin invited me to her wedding.","audio":"https://tatoeba.org/en/audio/download/608527"},{"text":"Tom tiene tres primos.","en":"Tom has three cousins.","audio":"https://tatoeba.org/en/audio/download/221575"},{"text":"Tom tiene tres primas.","en":"Tom has three cousins.","audio":"https://tatoeba.org/en/audio/download/221576"},{"text":"Tengo un primo abogado.","en":"I have a cousin who is a lawyer.","audio":"https://tatoeba.org/en/audio/download/354728"}]}