{"id":"adicional","lemma":"adicional","pos":"adj","rank":4608,"glosses":["additional (supplemental or added to something)"],"ipa":"/adiθjoˈnal/","forms":{"femininePlural":"adicionales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q1321_%28spa%29-Marreromarco-adicional.wav","examples":[{"text":"¿Cuánto dinero adicional necesitamos?","en":"How much more money do we need?","audio":"https://tatoeba.org/en/audio/download/585875","words":[{"g":"how much"},{"g":"money"},null,{"g":"to need","l":"necesitar"}]},{"text":"Nuestro plan tiene muchas ventajas adicionales.","en":"Our plan has lots of additional advantages.","words":[{"g":"our, ours, to us"},{"g":"plan"},{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},{"g":"advantage","l":"ventaja"},null]},{"text":"Debes reducir los gastos adicionales para vivir dentro de tus posibilidades.","en":"You must cut down on extra expenses in order to live within your means.","words":[{"g":"to owe","l":"deber"},{"g":"to reduce"},{"g":"the / them"},{"g":"expenditure, cost","l":"gasto"},null,{"g":"for"},{"g":"to live"},null,null,{"g":"your"},{"g":"possibility","l":"posibilidad"}],"phrases":[[7,9,"in, inside"]]}]}