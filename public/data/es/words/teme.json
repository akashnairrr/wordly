{"id":"teme","lemma":"teme","pos":"noun","rank":3683,"glosses":["teme (technological meme)"],"ipa":"/ˈteme/","gender":"m","forms":{"plural":"temes"},"examples":[{"text":"Él le teme a la muerte.","en":"He is afraid of death.","audio":"https://tatoeba.org/en/audio/download/453288","words":[{"g":"he"},{"g":"him / her"},null,{"g":"to"},{"g":"the / her"},{"g":"death"}]},{"text":"Ella no le teme a nada.","en":"She is not afraid of anything.","audio":"https://tatoeba.org/en/audio/download/589838","words":[{"g":"she"},{"g":"no / not"},{"g":"him / her"},null,{"g":"to"},{"g":"nothing"}]},{"text":"Un niño quemado le teme al fuego.","en":"A burnt child fears the fire.","words":[{"g":"a"},{"g":"child, boy"},{"g":"burnt"},{"g":"him / her"},null,{"g":"to the"},{"g":"fire"}]},{"text":"Solo un tonto no le teme al mar.","en":"Only a fool doesn't fear the sea.","words":[{"g":"sole"},{"g":"a"},{"g":"stupid"},{"g":"no / not"},{"g":"him / her"},null,{"g":"to the"},{"g":"sea"}]},{"text":"La gente le teme a la guerra.","en":"The people fear war.","words":[{"g":"the / her"},{"g":"people"},{"g":"him / her"},null,{"g":"to"},{"g":"the / her"},{"g":"war, warfare"}]}]}