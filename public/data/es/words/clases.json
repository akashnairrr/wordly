{"id":"clases","lemma":"clases","pos":"noun","rank":1089,"glosses":["tuition"],"ipa":"/ˈklases/","gender":"f","examples":[{"text":"Se terminaron las clases.","en":"School's out.","audio":"https://tatoeba.org/en/audio/download/412256"},{"text":"Se acabaron las clases.","en":"School is out.","audio":"https://tatoeba.org/en/audio/download/412315"},{"text":"¿Cuándo terminan las clases?","en":"When is school over?","audio":"https://tatoeba.org/en/audio/download/455297"},{"text":"Las clases empiezan mañana.","en":"Classes start tomorrow.","audio":"https://tatoeba.org/en/audio/download/460875"},{"text":"Hoy no tengo clases.","en":"I don't have classes today.","audio":"https://tatoeba.org/en/audio/download/64868"}]}