{"id":"pun_etazo","lemma":"puñetazo","pos":"noun","rank":4002,"glosses":["punch with the fist; thump"],"ipa":"/puɲeˈtaθo/","gender":"m","forms":{"plural":"puñetazos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b0/LL-Q1321_%28spa%29-Emanuelps27-pu%C3%B1etazo.wav","examples":[{"text":"Le di un puñetazo en la cara.","en":"I punched him in the face.","audio":"https://tatoeba.org/en/audio/download/639783","words":[{"g":"him / her"},{"g":"Used as a friendly…"},{"g":"a"},null,{"g":"in / on"},{"g":"the / her"},{"g":"face"}]},{"text":"Tom me dio un puñetazo.","en":"Tom punched me.","words":[null,{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null]},{"text":"La mandé un puñetazo a la mandíbula.","en":"I punched his jaw.","words":[{"g":"the / her"},{"g":"to send","l":"mandar"},{"g":"a"},null,{"g":"to"},{"g":"the / her"},{"g":"jaw, mandible"}]},{"text":"¿Por qué le diste un puñetazo a Tom?","en":"Why did you punch Tom?","words":[null,null,{"g":"him / her"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null,{"g":"to"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Fue noqueado de un puñetazo en el primer asalto.","en":"He was knocked out by a punch in the first round.","words":[{"g":"to be","l":"ser"},{"g":"to knock out","l":"noquear"},{"g":"of / from"},{"g":"a"},null,{"g":"in / on"},{"g":"the"},null,{"g":"assault"}]}]}