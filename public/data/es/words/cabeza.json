{"id":"cabeza","lemma":"cabeza","pos":"noun","rank":201,"glosses":["head","mind (in certain phrases)"],"ipa":"/kaˈbeθa/","gender":"f","forms":{"plural":"cabezas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q1321_%28spa%29-Rodrigo5260-cabeza.wav","formAudio":{"cabezas":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Eavqwiki-cabezas.wav"},"examples":[{"text":"¿Te duele la cabeza?","en":"Does your head ache?","audio":"https://tatoeba.org/en/audio/download/58184","words":[{"g":"you"},null,{"g":"the / her"},null]},{"text":"¿Se te ha ido la cabeza?","en":"Are you out of your mind?","audio":"https://tatoeba.org/en/audio/download/80570","words":[{"g":"oneself"},{"g":"you"},{"g":"to have","l":"haber"},{"g":"away with the fairies"},{"g":"the / her"},null]},{"text":"Tenemos diez cabezas de ganado.","en":"We have ten head of cattle.","audio":"https://tatoeba.org/en/audio/download/64627","words":[{"g":"to have","l":"tener"},{"g":"A"},null,{"g":"of / from"},{"g":"livestock, cattle"}]},{"text":"Mi cabeza está dando vueltas.","en":"My head is spinning.","audio":"https://tatoeba.org/en/audio/download/450214","words":[{"g":"my"},null,{"g":"to be","l":"estar"},{"g":"to give, to give out","l":"dar"},{"g":"go-back"}]},{"text":"Dos cabezas son mejores que una.","en":"Two heads are better than one.","words":[{"g":"dung, excrement"},null,{"g":"to be","l":"ser"},{"g":"better","l":"mejor"},{"g":"that"},{"g":"a"}]}]}