{"id":"cabeza","lemma":"cabeza","pos":"noun","rank":204,"glosses":["head","mind (in certain phrases)"],"ipa":"/kaˈbeθa/","gender":"f","forms":{"plural":"cabezas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1c/LL-Q1321_%28spa%29-Rodrigo5260-cabeza.wav","formAudio":{"cabezas":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Eavqwiki-cabezas.wav"},"examples":[{"text":"Me duele la cabeza.","en":"My head aches.","audio":"https://tatoeba.org/en/audio/download/501077"},{"text":"Tenemos diez cabezas de ganado.","en":"We have ten head of cattle.","audio":"https://tatoeba.org/en/audio/download/64627"},{"text":"Le dolía la cabeza.","en":"His head ached.","audio":"https://tatoeba.org/en/audio/download/40168"},{"text":"Hay alrededor de 500 cabezas de ganado en ese rancho.","en":"There are about 500 head of cattle on that ranch.","audio":"https://tatoeba.org/en/audio/download/804472"},{"text":"Él sacudió la cabeza.","en":"He shook his head.","audio":"https://tatoeba.org/en/audio/download/443713"}]}