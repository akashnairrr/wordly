{"id":"forzado","lemma":"forzado","pos":"adj","rank":4259,"glosses":["forced, forcible","far-fetched, unlikely"],"ipa":"/foɾˈθado/","forms":{"feminine":"forzada","masculinePlural":"forzados","femininePlural":"forzadas"},"examples":[{"text":"Fui forzado a ir.","en":"I was forced to go.","audio":"https://tatoeba.org/en/audio/download/449238","words":[{"g":"to go","l":"ir"},null,{"g":"to"},{"g":"to go"}]},{"text":"Era una sonrisa forzada.","en":"It was a forced smile.","audio":"https://tatoeba.org/en/audio/download/636487","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"smile"},null]},{"text":"Fuimos forzados a trabajar duro.","en":"We were forced to work hard.","audio":"https://tatoeba.org/en/audio/download/557845","words":[{"g":"to go","l":"ir"},null,{"g":"to"},{"g":"to work"},{"g":"hard"}]},{"text":"Él fue un líder forzado.","en":"He was a forceful leader.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"leader"},null]},{"text":"La puerta ha sido forzada.","en":"The door has been forced.","words":[{"g":"the / her"},{"g":"door"},{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},null]}]}