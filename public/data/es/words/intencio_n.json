{"id":"intencio_n","lemma":"intención","pos":"noun","rank":1138,"glosses":["intention"],"ipa":"/intenˈθjon/","gender":"f","forms":{"plural":"intenciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Marreromarco-intenci%C3%B3n.wav","examples":[{"text":"Mi intención era buena.","en":"I meant well.","audio":"https://tatoeba.org/en/audio/download/410929"},{"text":"¿Cuáles son sus intenciones?","en":"What are your intentions?","audio":"https://tatoeba.org/en/audio/download/531850"},{"text":"Tenía intención de buscarlo.","en":"I meant to look it up.","audio":"https://tatoeba.org/en/audio/download/41811"},{"text":"No sé cuáles son sus intenciones.","en":"I don't know what her intentions are.","audio":"https://tatoeba.org/en/audio/download/515017"},{"text":"No era mi intención.","en":"It wasn't my intention.","audio":"https://tatoeba.org/en/audio/download/1376"}]}