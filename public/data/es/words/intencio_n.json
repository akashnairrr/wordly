{"id":"intencio_n","lemma":"intención","pos":"noun","rank":1135,"glosses":["intention"],"ipa":"/intenˈθjon/","gender":"f","forms":{"plural":"intenciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-Marreromarco-intenci%C3%B3n.wav","examples":[{"text":"No tengo intención de cambiar.","en":"I have no intention of changing.","audio":"https://tatoeba.org/en/audio/download/354718","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to change"}]},{"text":"Necesito saber tus intenciones.","en":"I need to know your intentions.","words":[{"g":"to need","l":"necesitar"},{"g":"to know, to understand"},{"g":"your"},null]},{"text":"Es mi firme intención hacer esto.","en":"It is my firm intention to do this.","audio":"https://tatoeba.org/en/audio/download/1061654","words":[{"g":"to be","l":"ser"},{"g":"my"},{"g":"firm, steady, secure"},null,{"g":"to do"},{"g":"this"}]},{"text":"¿Cuáles son sus intenciones?","en":"What are your intentions?","audio":"https://tatoeba.org/en/audio/download/531850","words":[{"g":"which one, what, which","l":"cuál"},{"g":"to be","l":"ser"},{"g":"his, her, its, their"},null]},{"text":"¿Cuál es tu verdadera intención?","en":"What's your real purpose?","audio":"https://tatoeba.org/en/audio/download/64722","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},{"g":"true, real","l":"verdadero"},null]}]}