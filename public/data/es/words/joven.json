{"id":"joven","lemma":"joven","pos":"adj","rank":352,"glosses":["young, youthful"],"ipa":"/ˈxoben/","forms":{"femininePlural":"jóvenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-AdrianAbdulBaha-joven.wav","examples":[{"text":"Tu madre es muy joven, ¿verdad?","en":"Your mother is very young, isn't she?","audio":"https://tatoeba.org/en/audio/download/689288","words":[null,null,{"g":"to be","l":"ser"},null,null,{"g":"truth"}],"phrases":[[0,2,"a catch-all retort"]]},{"text":"Ustedes aún son jóvenes.","en":"You're still young.","audio":"https://tatoeba.org/en/audio/download/449945","words":[{"g":"you all"},{"g":"still, yet"},{"g":"to be","l":"ser"},null]},{"text":"Yo también soy joven.","en":"I'm young, too.","audio":"https://tatoeba.org/en/audio/download/550229","words":[null,null,{"g":"to be","l":"ser"},null],"phrases":[[0,2,"me too"]]},{"text":"Nosotros éramos más jóvenes entonces.","en":"We were younger then.","audio":"https://tatoeba.org/en/audio/download/453568","words":[{"g":"we"},{"g":"to be","l":"ser"},{"g":"more"},null,{"g":"then"}]},{"text":"Te ves más joven.","en":"You look younger.","audio":"https://tatoeba.org/en/audio/download/443538","words":[{"g":"you"},{"g":"to see, to spot","l":"ver"},{"g":"more"},null]}]}