{"id":"joven","lemma":"joven","pos":"adj","rank":355,"glosses":["young, youthful"],"ipa":"/ˈxoben/","forms":{"femininePlural":"jóvenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-AdrianAbdulBaha-joven.wav","examples":[{"text":"Él se ve joven.","en":"He looks young.","audio":"https://tatoeba.org/en/audio/download/440563"},{"text":"Ustedes aún son jóvenes.","en":"You're still young.","audio":"https://tatoeba.org/en/audio/download/449945"},{"text":"Yo también soy joven.","en":"I'm young, too.","audio":"https://tatoeba.org/en/audio/download/550229"},{"text":"Ellos aún son jóvenes.","en":"They're still young.","audio":"https://tatoeba.org/en/audio/download/450425"},{"text":"Él no es joven.","en":"He is not young.","audio":"https://tatoeba.org/en/audio/download/636716"}]}