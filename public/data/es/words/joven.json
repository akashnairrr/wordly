{"id":"joven","lemma":"joven","pos":"adj","rank":352,"glosses":["young, youthful"],"ipa":"/ˈxoben/","forms":{"femininePlural":"jóvenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-AdrianAbdulBaha-joven.wav","examples":[{"text":"\"¿Ella es joven?\" \"Sí.\"","en":"\"Is she young?\" \"Yes, she is.\"","audio":"https://tatoeba.org/en/audio/download/641678","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"yes"}]},{"text":"Ellos aún son jóvenes.","en":"They're still young.","audio":"https://tatoeba.org/en/audio/download/450425","words":[{"g":"they","l":"él"},{"g":"still, yet"},{"g":"to be","l":"ser"},null]},{"text":"Él no es joven.","en":"He is not young.","audio":"https://tatoeba.org/en/audio/download/636716","words":[{"g":"he"},{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Mis amigos no son jóvenes.","en":"My friends aren't young.","audio":"https://tatoeba.org/en/audio/download/600056","words":[{"g":"my"},{"g":"friend","l":"amigo"},{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"La noche es joven.","en":"The night is young.","audio":"https://tatoeba.org/en/audio/download/501340","words":[{"g":"the / her"},{"g":"night"},{"g":"to be","l":"ser"},null]}]}