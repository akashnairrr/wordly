{"id":"ele_ctrico","lemma":"eléctrico","pos":"adj","rank":3686,"glosses":["electric, electrical"],"ipa":"/eˈleɡtɾiko/","forms":{"feminine":"eléctrica","masculinePlural":"eléctricos","femininePlural":"eléctricas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Marreromarco-el%C3%A9ctrico.wav","examples":[{"text":"Este reloj es eléctrico.","en":"This clock is electric.","audio":"https://tatoeba.org/en/audio/download/707330","words":[{"g":"this"},{"g":"clock"},{"g":"to be","l":"ser"},null]},{"text":"Compré un coche eléctrico.","en":"I bought an electric car.","audio":"https://tatoeba.org/en/audio/download/639704","words":[{"g":"to buy","l":"comprar"},{"g":"a"},{"g":"car, automobile"},null]},{"text":"Construyeron el primer coche eléctrico.","en":"They built the first electric car.","audio":"https://tatoeba.org/en/audio/download/932232","words":[{"g":"to build","l":"construir"},{"g":"the"},null,{"g":"car, automobile"},null]},{"text":"Los coches eléctricos son silenciosos.","en":"Electric cars are quiet.","audio":"https://tatoeba.org/en/audio/download/409883","words":[{"g":"the / them"},{"g":"car, automobile","l":"coche"},null,{"g":"to be","l":"ser"},{"g":"silent","l":"silencioso"}]},{"text":"Nuestro calefactor eléctrico no funcionó bien.","en":"Our electric heater did not work well.","audio":"https://tatoeba.org/en/audio/download/1189077","words":[{"g":"our, ours, to us"},null,null,{"g":"no / not"},{"g":"to work, to function","l":"funcionar"},{"g":"well"}]}]}