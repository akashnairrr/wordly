{"id":"libre","lemma":"libre","pos":"adj","rank":436,"glosses":["free (not imprisoned or enslaved)","free (unconstrained)","free (without obligations)"],"ipa":"/ˈlibɾe/","forms":{"femininePlural":"libres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q1321_%28spa%29-AdrianAbdulBaha-libre.wav","examples":[{"text":"Voy a estar libre.","en":"I'll be free.","audio":"https://tatoeba.org/en/audio/download/438116"},{"text":"Al fin estamos libres.","en":"We're finally free.","audio":"https://tatoeba.org/en/audio/download/462211"},{"text":"Soy un hombre libre.","en":"I'm a free man.","audio":"https://tatoeba.org/en/audio/download/38582"},{"text":"Al fin somos libres.","en":"We're finally free.","audio":"https://tatoeba.org/en/audio/download/462212"},{"text":"Estaré libre esta noche.","en":"I'm free tonight.","audio":"https://tatoeba.org/en/audio/download/799313"}]}