{"id":"izquierda","lemma":"izquierda","pos":"noun","rank":716,"glosses":["left (side, direction)","left"],"ipa":"/iθˈkjeɾda/","gender":"f","audio":"https://upload.wikimedia.org/wikipedia/commons/3/3f/LL-Q1321_%28spa%29-Rodelar-izquierda.wav","examples":[{"text":"Ella escribe con la mano izquierda.","en":"She writes with her left hand.","audio":"https://tatoeba.org/en/audio/download/560073","words":[{"g":"she"},{"g":"to write","l":"escribir"},{"g":"with"},{"g":"the / her"},{"g":"hand"},null]},{"text":"Es allí a la izquierda.","en":"It's there to the left.","audio":"https://tatoeba.org/en/audio/download/636764","words":[{"g":"to be","l":"ser"},{"g":"there"},{"g":"to"},{"g":"the / her"},null]},{"text":"Gira la llave hacia la izquierda.","en":"Turn the key to the left.","audio":"https://tatoeba.org/en/audio/download/523598","words":[{"g":"tour"},{"g":"the / her"},{"g":"key"},{"g":"toward, towards"},{"g":"the / her"},null]},{"text":"Los servicios están a la izquierda.","en":"The restrooms are on the left.","audio":"https://tatoeba.org/en/audio/download/508425","words":[{"g":"the / them"},{"g":"service","l":"servicio"},{"g":"to be","l":"estar"},{"g":"to"},{"g":"the / her"},null]},{"text":"Miró a izquierda y derecha.","en":"He looked left and right.","audio":"https://tatoeba.org/en/audio/download/734911","words":[{"g":"to look at","l":"mirar"},{"g":"to"},null,{"g":"and"},{"g":"right"}]}]}