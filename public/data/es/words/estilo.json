{"id":"estilo","lemma":"estilo","pos":"noun","rank":845,"glosses":["style (way of doing things)","style (grace; fashionable skill)","style"],"ipa":"/esˈtilo/","gender":"m","forms":{"plural":"estilos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Marreromarco-estilo.wav","examples":[{"text":"Me gusta tu estilo.","en":"I like your style.","audio":"https://tatoeba.org/en/audio/download/443919","words":[null,null,{"g":"your"},null],"phrases":[[0,2,"like, thumbs up"]]},{"text":"No es mi estilo.","en":"It's not my style.","audio":"https://tatoeba.org/en/audio/download/444521","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Ella tiene estilo.","en":"She's fashionable.","audio":"https://tatoeba.org/en/audio/download/444331","words":[{"g":"she"},{"g":"to have","l":"tener"},null]},{"text":"No dije nada por el estilo.","en":"I said nothing of the sort.","audio":"https://tatoeba.org/en/audio/download/76934","words":[{"g":"no / not"},{"g":"to say","l":"decir"},{"g":"nothing"},{"g":"for / by"},{"g":"the"},null]},{"text":"Cada uno tiene su propio estilo.","en":"Everyone has their own style.","words":[null,null,{"g":"to have","l":"tener"},{"g":"his / her / your"},{"g":"own"},null],"phrases":[[0,2,"each, each one"]]}]}