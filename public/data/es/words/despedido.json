{"id":"despedido","lemma":"despedido","pos":"adj","rank":1998,"glosses":["laid off, dismissed (employees)"],"ipa":"/despeˈdido/","forms":{"feminine":"despedida","masculinePlural":"despedidos","femininePlural":"despedidas"},"formAudio":{"despedida":"https://upload.wikimedia.org/wikipedia/commons/d/d6/LL-Q1321_%28spa%29-Marreromarco-despedida.wav"},"examples":[{"text":"Tom fue despedido el lunes.","en":"Tom was fired on Monday.","audio":"https://tatoeba.org/en/audio/download/352049"},{"text":"Quiero darte un beso de despedida.","en":"I want to give you a goodbye kiss.","audio":"https://tatoeba.org/en/audio/download/594557"},{"text":"Muchos empleados tuvieron que ser despedidos debido a recortes presupuestarios.","en":"Many employees had to be laid off due to budget cutbacks.","audio":"https://tatoeba.org/en/audio/download/804161"},{"text":"Las despedidas siempre son tristes.","en":"Goodbyes are always sad.","audio":"https://tatoeba.org/en/audio/download/1602"},{"text":"Todavía no me he despedido.","en":"I haven't said goodbye yet.","audio":"https://tatoeba.org/en/audio/download/1152310"}]}