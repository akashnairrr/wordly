{"id":"fri_a","lemma":"fría","pos":"noun","rank":1417,"glosses":["(cold) beer"],"ipa":"/ˈfɾia/","gender":"f","forms":{"plural":"frías"},"examples":[{"text":"La sopa está fría.","en":"The soup's cold.","audio":"https://tatoeba.org/en/audio/download/442102"},{"text":"Tus manos están frías.","en":"Your hands are cold.","audio":"https://tatoeba.org/en/audio/download/453993"},{"text":"La comida está fría.","en":"The food is cold.","audio":"https://tatoeba.org/en/audio/download/444307"},{"text":"¿Qué bebidas frías tienes?","en":"What cold drinks do you have?","audio":"https://tatoeba.org/en/audio/download/733670"},{"text":"El agua está fría.","en":"The water's cold.","audio":"https://tatoeba.org/en/audio/download/91258"}]}