{"id":"propio","lemma":"propio","pos":"adj","rank":494,"glosses":["own (belonging to)","proper","typical, characteristic"],"ipa":"/ˈpɾopjo/","forms":{"feminine":"propia","masculinePlural":"propios","femininePlural":"propias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q1321_%28spa%29-Marreromarco-propio.wav","examples":[{"text":"Quiero mi propia habitación.","en":"I want my own room.","audio":"https://tatoeba.org/en/audio/download/448324","words":[{"g":"to desire","l":"querer"},{"g":"my"},null,{"g":"room"}]},{"text":"Soy mi propio jefe.","en":"I'm my own boss.","audio":"https://tatoeba.org/en/audio/download/83180","words":[{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"chief"}]},{"text":"Haz eso bajo tu propia responsabilidad.","en":"Do that at your own risk.","audio":"https://tatoeba.org/en/audio/download/704125","words":[{"g":"to do","l":"hacer"},{"g":"that","l":"ése"},{"g":"short"},{"g":"your"},null,{"g":"responsibility"}]},{"text":"Lo vi con mis propios ojos.","en":"I saw it with my own eyes.","audio":"https://tatoeba.org/en/audio/download/526661","words":[{"g":"it / him"},{"g":"to see, to spot","l":"ver"},{"g":"with"},{"g":"my"},null,{"g":"eye","l":"ojo"}]},{"text":"Haz tu propio trabajo.","en":"Do your own work.","audio":"https://tatoeba.org/en/audio/download/443004","words":[{"g":"to do","l":"hacer"},{"g":"your"},null,{"g":"work, job"}]}]}