{"id":"propio","lemma":"propio","pos":"adj","rank":497,"glosses":["own (belonging to)","proper","typical, characteristic"],"ipa":"/ˈpɾopjo/","forms":{"feminine":"propia","masculinePlural":"propios","femininePlural":"propias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q1321_%28spa%29-Marreromarco-propio.wav","examples":[{"text":"Soy mi propio jefe.","en":"I'm my own boss.","audio":"https://tatoeba.org/en/audio/download/83180"},{"text":"Quiero mi propia habitación.","en":"I want my own room.","audio":"https://tatoeba.org/en/audio/download/448324"},{"text":"Tienen sus propios problemas.","en":"They have their own troubles.","audio":"https://tatoeba.org/en/audio/download/582337"},{"text":"Tengo mis propias razones.","en":"I have my own reasons.","audio":"https://tatoeba.org/en/audio/download/453712"},{"text":"Haz tu propio trabajo.","en":"Do your own work.","audio":"https://tatoeba.org/en/audio/download/443004"}]}