{"id":"propio","lemma":"propio","pos":"adj","rank":494,"glosses":["own (belonging to)","proper","typical, characteristic"],"ipa":"/ˈpɾopjo/","forms":{"feminine":"propia","masculinePlural":"propios","femininePlural":"propias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q1321_%28spa%29-Marreromarco-propio.wav","examples":[{"text":"Haz tu propio trabajo.","en":"Do your own work.","audio":"https://tatoeba.org/en/audio/download/443004","words":[{"g":"to do","l":"hacer"},{"g":"your"},null,{"g":"work, job"}]},{"text":"Él tiene su habitación propia.","en":"He has his own room.","audio":"https://tatoeba.org/en/audio/download/501305","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"his / her / your"},{"g":"room"},null]},{"text":"Tienen sus propios problemas.","en":"They have their own troubles.","audio":"https://tatoeba.org/en/audio/download/582337","words":[{"g":"to have","l":"tener"},{"g":"his, her, its, their"},null,{"g":"problem","l":"problema"}]},{"text":"Tengo mis propias razones.","en":"I have my own reasons.","audio":"https://tatoeba.org/en/audio/download/453712","words":[{"g":"to have","l":"tener"},{"g":"my"},null,{"g":"reason","l":"razón"}]},{"text":"Es por tu propia seguridad.","en":"It's for your own safety.","audio":"https://tatoeba.org/en/audio/download/611767","words":[{"g":"to be","l":"ser"},{"g":"for / by"},{"g":"your"},null,{"g":"safety, security"}]}]}