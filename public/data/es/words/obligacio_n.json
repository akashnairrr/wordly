{"id":"obligacio_n","lemma":"obligación","pos":"noun","rank":3156,"glosses":["obligation","bond"],"ipa":"/obliɡaˈθjon/","gender":"f","forms":{"plural":"obligaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-AdrianAbdulBaha-obligaci%C3%B3n.wav","examples":[{"text":"Es nuestra obligación ayudar.","en":"It is our obligation to help.","audio":"https://tatoeba.org/en/audio/download/642140","words":[{"g":"to be","l":"ser"},{"g":"our, ours, to us","l":"nuestro"},null,{"g":"to help"}]},{"text":"No tengo obligación de hacer eso.","en":"I'm not obligated to do that.","audio":"https://tatoeba.org/en/audio/download/450718","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to do"},{"g":"that","l":"ése"}]},{"text":"Uno debe hacer sus obligaciones.","en":"One should do one's duty.","words":[{"g":"one"},{"g":"to owe","l":"deber"},{"g":"to do"},{"g":"his, her, its, their"},null]},{"text":"Es mi obligación ayudarte.","en":"It's my duty to help you.","audio":"https://tatoeba.org/en/audio/download/68504","words":[{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"to help","l":"ayudar"}]},{"text":"Me haré cargo de tus obligaciones.","en":"I'll take over your duties.","audio":"https://tatoeba.org/en/audio/download/804494","words":[{"g":"me"},{"g":"to do","l":"hacer"},{"g":"charge, burden"},{"g":"of / from"},{"g":"your"},null]}]}