{"id":"vistazo","lemma":"vistazo","pos":"noun","rank":808,"glosses":["look, glance"],"ipa":"/bisˈtaθo/","gender":"m","forms":{"plural":"vistazos"},"examples":[{"text":"Déjame echar un vistazo.","en":"Let me take a gander.","audio":"https://tatoeba.org/en/audio/download/800958"},{"text":"¿Quieres echar un vistazo?","en":"Do you want to take a look?","audio":"https://tatoeba.org/en/audio/download/527304"},{"text":"Échale un vistazo a esto.","en":"Check this out.","audio":"https://tatoeba.org/en/audio/download/440624"},{"text":"Yo le echaría un vistazo.","en":"I'd look into it.","audio":"https://tatoeba.org/en/audio/download/532331"},{"text":"Ven y echa un vistazo.","en":"Come and take a look.","audio":"https://tatoeba.org/en/audio/download/819930"}]}