{"id":"reloj","lemma":"reloj","pos":"noun","rank":995,"glosses":["clock","watch, wristwatch"],"ipa":"/reˈlox/","gender":"m","forms":{"plural":"relojes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-reloj.wav","examples":[{"text":"Dale cuerda al reloj.","en":"Wind the clock.","audio":"https://tatoeba.org/en/audio/download/441373"},{"text":"Me gustan los relojes.","en":"I like clocks.","audio":"https://tatoeba.org/en/audio/download/734268"},{"text":"He comprado un reloj.","en":"I bought a watch.","audio":"https://tatoeba.org/en/audio/download/50425"},{"text":"¿Cuántos relojes perdió Tom?","en":"How many watches did Tom lose?","audio":"https://tatoeba.org/en/audio/download/802349"},{"text":"He perdido el reloj.","en":"I lost the watch.","audio":"https://tatoeba.org/en/audio/download/442569"}]}