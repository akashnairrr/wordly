{"id":"pe_simo","lemma":"pésimo","pos":"adj","rank":4401,"glosses":["lousy, rubbish, abysmal, poor, terrible, awful, rotten, horrible, dismal, appalling, dreadful (very bad)"],"ipa":"/ˈpesimo/","forms":{"feminine":"pésima","masculinePlural":"pésimos","femininePlural":"pésimas"},"examples":[{"text":"El tiempo fue pésimo hasta ayer.","en":"The weather was terrible until yesterday.","audio":"https://tatoeba.org/en/audio/download/706214","words":[{"g":"the"},{"g":"time"},{"g":"to be","l":"ser"},null,{"g":"until"},{"g":"yesterday"}]},{"text":"Esta música es pésima.","en":"This music is terrible.","audio":"https://tatoeba.org/en/audio/download/461151","words":[{"g":"this","l":"este"},{"g":"music"},{"g":"to be","l":"ser"},null]},{"text":"Eso fue un pésimo truco.","en":"That was a lousy trick.","audio":"https://tatoeba.org/en/audio/download/461237","words":[{"g":"that","l":"ése"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"gimmick, ploy"}]},{"text":"La comida aquí es pésima.","en":"The food here is terrible.","words":[{"g":"the / her"},{"g":"food"},{"g":"here"},{"g":"to be","l":"ser"},null]},{"text":"Ese es un pésimo consejo.","en":"That's terrible advice.","words":[{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"advice"}]}]}