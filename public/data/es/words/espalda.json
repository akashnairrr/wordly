{"id":"espalda","lemma":"espalda","pos":"noun","rank":769,"glosses":["back","backstroke"],"ipa":"/esˈpalda/","gender":"f","forms":{"plural":"espaldas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Rodelar-espalda.wav","formAudio":{"espaldas":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Mariocrespolara-espaldas.wav"},"examples":[{"text":"Me duele la espalda.","en":"My back aches.","audio":"https://tatoeba.org/en/audio/download/48507"},{"text":"No hablo de ti a tus espaldas.","en":"I don't talk about you behind your back.","audio":"https://tatoeba.org/en/audio/download/1252502"},{"text":"Me quebré la espalda.","en":"I broke my back.","audio":"https://tatoeba.org/en/audio/download/441630"},{"text":"Tom se apoyó de espaldas sobre el sofá.","en":"Tom leaned back on the couch.","audio":"https://tatoeba.org/en/audio/download/803503"},{"text":"Tengo dolor de espalda.","en":"I have a backache.","audio":"https://tatoeba.org/en/audio/download/444082"}]}