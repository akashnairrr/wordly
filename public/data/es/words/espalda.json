{"id":"espalda","lemma":"espalda","pos":"noun","rank":766,"glosses":["back","backstroke"],"ipa":"/esˈpalda/","gender":"f","forms":{"plural":"espaldas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Rodelar-espalda.wav","formAudio":{"espaldas":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Mariocrespolara-espaldas.wav"},"examples":[{"text":"Tengo problemas de espalda.","en":"I have back problems.","audio":"https://tatoeba.org/en/audio/download/454180","words":[{"g":"to have","l":"tener"},{"g":"problem","l":"problema"},{"g":"of / from"},null]},{"text":"Alguien me golpeó en la espalda.","en":"Someone hit me on the back.","words":[{"g":"someone, somebody"},{"g":"me"},{"g":"to hit","l":"golpear"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"No hablo de ti a tus espaldas.","en":"I don't talk about you behind your back.","audio":"https://tatoeba.org/en/audio/download/1252502","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},{"g":"of / from"},{"g":"you","l":"tú"},{"g":"to"},{"g":"your"},null]},{"text":"Vigila mi espalda.","en":"Watch my back.","audio":"https://tatoeba.org/en/audio/download/430224","words":[{"g":"to watch over","l":"vigilar"},{"g":"my"},null]},{"text":"No hables de la gente a sus espaldas.","en":"Don't talk about people behind their backs.","audio":"https://tatoeba.org/en/audio/download/606475","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},null,null,{"g":"people"},{"g":"to"},{"g":"his, her, its, their"},null],"phrases":[[2,4,"of the"]]}]}