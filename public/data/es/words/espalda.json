{"id":"espalda","lemma":"espalda","pos":"noun","rank":766,"glosses":["back","backstroke"],"ipa":"/esˈpalda/","gender":"f","forms":{"plural":"espaldas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Rodelar-espalda.wav","formAudio":{"espaldas":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Mariocrespolara-espaldas.wav"},"examples":[{"text":"Me duele la espalda.","en":"My back aches.","audio":"https://tatoeba.org/en/audio/download/48507","words":[{"g":"me"},null,{"g":"the / her"},null]},{"text":"No hablo de ti a tus espaldas.","en":"I don't talk about you behind your back.","audio":"https://tatoeba.org/en/audio/download/1252502","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},{"g":"of / from"},{"g":"you","l":"tú"},{"g":"to"},{"g":"your"},null]},{"text":"Me acabo de hacer daño en la espalda.","en":"I just hurt my back.","audio":"https://tatoeba.org/en/audio/download/448441","words":[{"g":"me"},{"g":"synonym of acabamiento"},{"g":"of / from"},null,null,{"g":"in / on"},{"g":"the / her"},null],"phrases":[[3,5,"to hurt, injure"]]},{"text":"No hables de la gente a sus espaldas.","en":"Don't talk about people behind their backs.","audio":"https://tatoeba.org/en/audio/download/606475","words":[{"g":"no / not"},{"g":"to talk","l":"hablar"},null,null,{"g":"people"},{"g":"to"},{"g":"his, her, its, their"},null],"phrases":[[2,4,"of the"]]},{"text":"Tengo dolor de espalda.","en":"I have a backache.","audio":"https://tatoeba.org/en/audio/download/444082","words":[{"g":"to have","l":"tener"},{"g":"pain"},{"g":"of / from"},null]}]}