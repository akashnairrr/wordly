{"id":"venga","lemma":"venga","pos":"intj","rank":266,"glosses":["A cheer or expression of support, encouragement, etc.; come on, attaboy","An expression of amazement or surprise; wow, whoa"],"ipa":"/ˈbenɡa/","examples":[{"text":"Venga con nosotros.","en":"Come with us.","audio":"https://tatoeba.org/en/audio/download/438250","words":[null,{"g":"with"},{"g":"we"}]},{"text":"Venga a mi casa.","en":"Come to my house.","audio":"https://tatoeba.org/en/audio/download/728650","words":[null,{"g":"to"},{"g":"my"},{"g":"house"}]},{"text":"¡Venga, corre! ¡Rápido!","en":"Try and hurry up.","audio":"https://tatoeba.org/en/audio/download/850224","words":[null,{"g":"to run, to jog","l":"correr"},{"g":"rapid"}]},{"text":"¿A qué hora quieres que venga?","en":"What time do you want me to come?","audio":"https://tatoeba.org/en/audio/download/684559","words":[{"g":"to"},{"g":"what"},{"g":"hour"},{"g":"to desire","l":"querer"},{"g":"that"},null]},{"text":"Venga él o no, yo iré.","en":"Whether he comes or not, I'll go.","audio":"https://tatoeba.org/en/audio/download/1189093","words":[null,{"g":"he"},{"g":"or"},{"g":"no / not"},{"g":"I"},{"g":"to go","l":"ir"}]}]}