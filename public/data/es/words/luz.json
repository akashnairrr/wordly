{"id":"luz","lemma":"luz","pos":"noun","rank":378,"glosses":["light","lumen","brightness, intelligence"],"ipa":"/ˈluθ/","gender":"f","forms":{"plural":"luces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/35/LL-Q1321_%28spa%29-Rodrigo5260-luz.wav","formAudio":{"luces":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q1321_%28spa%29-AdrianAbdulBaha-luces.wav"},"examples":[{"text":"La luz está encendida.","en":"The light is on.","audio":"https://tatoeba.org/en/audio/download/442039"},{"text":"Las luces están apagadas.","en":"The lights are out.","audio":"https://tatoeba.org/en/audio/download/501152"},{"text":"La luz está prendida.","en":"The light is on.","audio":"https://tatoeba.org/en/audio/download/442174"},{"text":"Se apagaron las luces.","en":"The lights went out.","audio":"https://tatoeba.org/en/audio/download/449341"},{"text":"Se cortó la luz.","en":"The power's out.","audio":"https://tatoeba.org/en/audio/download/442116"}]}