{"id":"poca","lemma":"poca","pos":"noun","rank":2000,"glosses":["tad; bit"],"ipa":"/ˈpoka/","gender":"f","forms":{"plural":"pocas"},"examples":[{"text":"Poca gente sabe cómo hacerlo.","en":"Few people know how to do it.","words":[null,{"g":"people"},{"g":"to know, to understand","l":"saber"},{"g":"how"},{"g":"to do","l":"hacer"}]},{"text":"Poca gente vive en la isla.","en":"Few people live on the island.","audio":"https://tatoeba.org/en/audio/download/1195665","words":[null,{"g":"people"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the / her"},{"g":"island"}]},{"text":"Hay poca agua en el vaso.","en":"There is little water in the glass.","audio":"https://tatoeba.org/en/audio/download/770085","words":[{"g":"to have","l":"haber"},null,{"g":"water"},{"g":"in / on"},{"g":"the"},{"g":"drinking glass"}]},{"text":"Parece que hay poca gente aquí.","en":"There seem to be a few people here.","audio":"https://tatoeba.org/en/audio/download/871873","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to have","l":"haber"},null,{"g":"people"},{"g":"here"}]},{"text":"Tendremos poca nieve este invierno.","en":"We'll have little snow this winter.","audio":"https://tatoeba.org/en/audio/download/589932","words":[{"g":"to have","l":"tener"},null,{"g":"snow"},{"g":"this"},{"g":"winter"}]}]}