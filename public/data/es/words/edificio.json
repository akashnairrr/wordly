{"id":"edificio","lemma":"edificio","pos":"noun","rank":708,"glosses":["building"],"ipa":"/ediˈfiθjo/","gender":"m","forms":{"plural":"edificios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Rodrigo5260-edificio.wav","formAudio":{"edificios":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q1321_%28spa%29-Eavqwiki-edificios.wav"},"examples":[{"text":"Ese edificio es nuestra escuela.","en":"That building is our school.","audio":"https://tatoeba.org/en/audio/download/1152180","words":[{"g":"that"},null,{"g":"to be","l":"ser"},{"g":"our, ours, to us","l":"nuestro"},{"g":"school"}]},{"text":"Este edificio nos pertenece.","en":"This building belongs to us.","audio":"https://tatoeba.org/en/audio/download/582669","words":[{"g":"this"},null,{"g":"us"},{"g":"to belong","l":"pertenecer"}]},{"text":"En este edificio no vive nadie.","en":"No one lives in this building.","audio":"https://tatoeba.org/en/audio/download/355379","words":[{"g":"in / on"},{"g":"this"},null,{"g":"no / not"},{"g":"to applaud","l":"vivar"},{"g":"no one"}]},{"text":"Ahora hay muchos nuevos edificios.","en":"There are a lot of new buildings here now.","words":[{"g":"now"},{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},{"g":"new","l":"nuevo"},null]},{"text":"¿En qué condiciones está el edificio?","en":"What condition is the building in?","audio":"https://tatoeba.org/en/audio/download/687934","words":[{"g":"in / on"},{"g":"what"},{"g":"condition","l":"condición"},{"g":"to be","l":"estar"},{"g":"the"},null]}]}