{"id":"mapa","lemma":"mapa","pos":"noun","rank":1391,"glosses":["map (sheet with geographical information on it)"],"ipa":"/ˈmapa/","gender":"m","forms":{"plural":"mapas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/11/LL-Q1321_%28spa%29-AdrianAbdulBaha-mapa.wav","examples":[{"text":"Tom tiene un mapa.","en":"Tom has a map.","audio":"https://tatoeba.org/en/audio/download/168266"},{"text":"Las líneas azules en los mapas son ríos.","en":"The blue lines on the map represent rivers."},{"text":"Aquí tiene el mapa.","en":"Here's the map.","audio":"https://tatoeba.org/en/audio/download/296152"},{"text":"Aquí está el mapa.","en":"Here is the map.","audio":"https://tatoeba.org/en/audio/download/549958"},{"text":"¿Dónde está el mapa?","en":"Where's the map?","audio":"https://tatoeba.org/en/audio/download/442260"}]}