{"id":"segundo","lemma":"segundo","pos":"noun","rank":338,"glosses":["second (unit of time)","second (short amount of time)","assistant"],"ipa":"/seˈɡundo/","gender":"m","forms":{"plural":"segundos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-AdrianAbdulBaha-segundo.wav","examples":[{"text":"Mi estudio se encuentra en el segundo piso.","en":"My study is upstairs.","audio":"https://tatoeba.org/en/audio/download/453785","words":[{"g":"my"},{"g":"study"},{"g":"oneself"},{"g":"to meet","l":"encontrar"},{"g":"in / on"},{"g":"the"},null,{"g":"floor, ground"}]},{"text":"Te quedan diez segundos de vida.","en":"You have ten seconds left to live.","audio":"https://tatoeba.org/en/audio/download/687300","words":[{"g":"you"},{"g":"to be , to end up","l":"quedar"},{"g":"A"},null,{"g":"of / from"},{"g":"life"}]},{"text":"Te necesito un segundo.","en":"I need you for a second.","audio":"https://tatoeba.org/en/audio/download/301510","words":[{"g":"you"},{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"Relájate unos segundos.","en":"Just relax a minute.","audio":"https://tatoeba.org/en/audio/download/448449","words":[{"g":"to relax, to loosen","l":"relajar"},{"g":"about, approximately"},null]},{"text":"¿Podrías esperar un segundo?","en":"Would you wait a second?","audio":"https://tatoeba.org/en/audio/download/515055","words":[{"g":"to be able to, can","l":"poder"},{"g":"to hope"},{"g":"a"},null]}]}