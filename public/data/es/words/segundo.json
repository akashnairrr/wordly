{"id":"segundo","lemma":"segundo","pos":"noun","rank":341,"glosses":["second (unit of time)","second (short amount of time)","assistant"],"ipa":"/seˈɡundo/","gender":"m","forms":{"plural":"segundos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-AdrianAbdulBaha-segundo.wav","examples":[{"text":"Somos de segundo año.","en":"We're sophomores.","audio":"https://tatoeba.org/en/audio/download/415838"},{"text":"Un minuto tiene sesenta segundos.","en":"One minute has sixty seconds.","audio":"https://tatoeba.org/en/audio/download/590191"},{"text":"Relájate por un segundo.","en":"Relax for a second.","audio":"https://tatoeba.org/en/audio/download/448329"},{"text":"Te quedan diez segundos de vida.","en":"You have ten seconds left to live.","audio":"https://tatoeba.org/en/audio/download/687300"},{"text":"Espera aquí un segundo.","en":"Wait a second here.","audio":"https://tatoeba.org/en/audio/download/501418"}]}