{"id":"resultado","lemma":"resultado","pos":"noun","rank":1180,"glosses":["result, outcome, finding, upshot","product, consequence, output","score"],"ipa":"/resulˈtado/","gender":"m","forms":{"plural":"resultados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-AdrianAbdulBaha-resultado.wav","examples":[{"text":"Nadie ha resultado herido.","en":"Nobody's been hurt.","audio":"https://tatoeba.org/en/audio/download/448584"},{"text":"Los resultados fueron buenos.","en":"The results were good.","audio":"https://tatoeba.org/en/audio/download/301853"},{"text":"¿Cuál fue el resultado?","en":"What was the result?","audio":"https://tatoeba.org/en/audio/download/453801"},{"text":"Los resultados estaban claros.","en":"The results were clear.","audio":"https://tatoeba.org/en/audio/download/765495"},{"text":"Nunca dudé del resultado.","en":"I never doubted the outcome.","audio":"https://tatoeba.org/en/audio/download/803881"}]}