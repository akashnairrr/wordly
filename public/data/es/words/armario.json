{"id":"armario","lemma":"armario","pos":"noun","rank":1570,"glosses":["storage cabinet, wardrobe, cupboard","wardrobe, closet (movable furniture for storing clothes)","locker"],"ipa":"/aɾˈmaɾjo/","gender":"m","forms":{"plural":"armarios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-armario.wav","examples":[{"text":"Escóndete en el armario.","en":"Hide in the closet.","audio":"https://tatoeba.org/en/audio/download/448764"},{"text":"El armario está lleno.","en":"The cupboard is full.","audio":"https://tatoeba.org/en/audio/download/451033"},{"text":"Necesito un nuevo armario.","en":"I need a new wardrobe.","audio":"https://tatoeba.org/en/audio/download/455322"},{"text":"Miré en el armario.","en":"I looked in the cupboard.","audio":"https://tatoeba.org/en/audio/download/50441"},{"text":"¿Qué hay en ese armario?","en":"What's in that closet?","audio":"https://tatoeba.org/en/audio/download/268552"}]}