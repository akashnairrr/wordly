{"id":"armario","lemma":"armario","pos":"noun","rank":1567,"glosses":["storage cabinet, wardrobe, cupboard","wardrobe, closet (movable furniture for storing clothes)","locker"],"ipa":"/aɾˈmaɾjo/","gender":"m","forms":{"plural":"armarios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/36/LL-Q1321_%28spa%29-AdrianAbdulBaha-armario.wav","examples":[{"text":"¿Qué hay en ese armario?","en":"What's in that closet?","audio":"https://tatoeba.org/en/audio/download/268552","words":[null,null,{"g":"in / on"},{"g":"that"},null],"phrases":[[0,2,"what's up?"]]},{"text":"El armario está lleno.","en":"The cupboard is full.","audio":"https://tatoeba.org/en/audio/download/451033","words":[{"g":"the"},null,{"g":"to be","l":"estar"},{"g":"full"}]},{"text":"Necesito un nuevo armario.","en":"I need a new wardrobe.","audio":"https://tatoeba.org/en/audio/download/455322","words":[{"g":"to need","l":"necesitar"},{"g":"a"},{"g":"new"},null]},{"text":"Pon eso en el armario.","en":"Put that in the cupboard.","audio":"https://tatoeba.org/en/audio/download/804034","words":[{"g":"to put, to place","l":"poner"},{"g":"that","l":"ése"},{"g":"in / on"},{"g":"the"},null]},{"text":"Dentro de este armario no hay nada.","en":"There's nothing in this closet.","audio":"https://tatoeba.org/en/audio/download/451032","words":[null,null,{"g":"this"},null,{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"nothing"}],"phrases":[[0,2,"in, inside"]]}]}