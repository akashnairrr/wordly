{"id":"adelantado","lemma":"adelantado","pos":"adj","rank":3250,"glosses":["ahead of one's time, advanced","gifted or advanced for one's age","early, ahead of time"],"ipa":"/adelanˈtado/","forms":{"feminine":"adelantada","masculinePlural":"adelantados","femininePlural":"adelantadas"},"examples":[{"text":"¿Tengo que pagar por adelantado?","en":"Do I have to pay in advance?","audio":"https://tatoeba.org/en/audio/download/523161","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to pay"},{"g":"for / by"},null]},{"text":"El reloj está adelantado.","en":"The clock is fast.","audio":"https://tatoeba.org/en/audio/download/706137","words":[{"g":"the"},{"g":"clock"},{"g":"to be","l":"estar"},null]},{"text":"Mi reloj está adelantado cinco minutos.","en":"My watch is five minutes fast.","audio":"https://tatoeba.org/en/audio/download/594604","words":[{"g":"my"},{"g":"clock"},{"g":"to be","l":"estar"},null,{"g":"a five"},{"g":"minute","l":"minuto"}]},{"text":"Sé que llegué adelantado.","en":"I know I'm early.","audio":"https://tatoeba.org/en/audio/download/442728","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to arrive, get","l":"llegar"},null]},{"text":"Muchas gracias por adelantado.","en":"Thank you in advance.","words":[null,null,{"g":"for / by"},null],"phrases":[[0,2,"Thank you very much"]]}]}