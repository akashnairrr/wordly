{"id":"perio_dico","lemma":"periódico","pos":"adj","rank":1245,"glosses":["periodic"],"ipa":"/peˈɾjodiko/","forms":{"feminine":"periódica","masculinePlural":"periódicos","femininePlural":"periódicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1f/LL-Q1321_%28spa%29-AdrianAbdulBaha-peri%C3%B3dico.wav","examples":[{"text":"Este es un periódico.","en":"This is a newspaper.","audio":"https://tatoeba.org/en/audio/download/799314"},{"text":"Quería estar en los periódicos.","en":"He wanted to be in the newspapers.","audio":"https://tatoeba.org/en/audio/download/684578"},{"text":"Esto es un periódico.","en":"This is a newspaper.","audio":"https://tatoeba.org/en/audio/download/872027"},{"text":"Varios periódicos publicaron esa historia.","en":"Several newspapers published the story.","audio":"https://tatoeba.org/en/audio/download/706501"},{"text":"¿Dónde está el periódico?","en":"Where's the newspaper?","audio":"https://tatoeba.org/en/audio/download/461740"}]}