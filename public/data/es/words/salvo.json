{"id":"salvo","lemma":"salvo","pos":"conj","rank":562,"glosses":["unless"],"ipa":"/ˈsalbo/","audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-Marreromarco-salvo.wav","examples":[{"text":"¿Estoy yo a salvo ahora?","en":"Am I safe now?","audio":"https://tatoeba.org/en/audio/download/438003","words":[{"g":"to be","l":"estar"},{"g":"I"},{"g":"to"},null,{"g":"now"}]},{"text":"Todos se fueron salvo nosotros.","en":"Everyone went except us.","audio":"https://tatoeba.org/en/audio/download/639977","words":[{"g":"all","l":"todo"},{"g":"oneself"},{"g":"to go","l":"ir"},null,{"g":"we"}]},{"text":"Tu secreto está a salvo conmigo.","en":"Your secret's safe with me.","audio":"https://tatoeba.org/en/audio/download/514724","words":[{"g":"your"},{"g":"a secret"},{"g":"to be","l":"estar"},{"g":"to"},null,{"g":"with me"}]},{"text":"Salvo yo, nadie tenía hambre.","en":"Nobody was hungry except me.","audio":"https://tatoeba.org/en/audio/download/582335","words":[null,{"g":"I"},{"g":"no one"},{"g":"to have","l":"tener"},{"g":"hunger"}]},{"text":"Ellos estarán a salvo aquí.","en":"They'll be safe here.","audio":"https://tatoeba.org/en/audio/download/454847","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},{"g":"to"},null,{"g":"here"}]}]}