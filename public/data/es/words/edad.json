{"id":"edad","lemma":"edad","pos":"noun","rank":502,"glosses":["age","time since an event","age (period of time)"],"ipa":"/eˈdad/","gender":"f","forms":{"plural":"edades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-AdrianAbdulBaha-edad.wav","examples":[{"text":"¿Cuál es tu edad?","en":"What's your age?","audio":"https://tatoeba.org/en/audio/download/519526","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Ella le dijo su edad.","en":"She told him her age.","audio":"https://tatoeba.org/en/audio/download/50795","words":[{"g":"she"},{"g":"him / her"},{"g":"to say","l":"decir"},{"g":"his / her / your"},null]},{"text":"Ellos tienen la misma edad.","en":"They're the same age.","audio":"https://tatoeba.org/en/audio/download/454405","words":[{"g":"they","l":"él"},{"g":"to have","l":"tener"},{"g":"the / her"},{"g":"same","l":"mismo"},null]},{"text":"¿Qué edades tienen sus hijos?","en":"How old are your children?","audio":"https://tatoeba.org/en/audio/download/527225","words":[{"g":"what"},null,{"g":"to have","l":"tener"},{"g":"his, her, its, their"},{"g":"son","l":"hijo"}]},{"text":"No nos importa tu edad.","en":"Your age doesn't matter to us.","audio":"https://tatoeba.org/en/audio/download/929760","words":[{"g":"no / not"},{"g":"us"},{"g":"to matter","l":"importar"},{"g":"your"},null]}]}