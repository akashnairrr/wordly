{"id":"edad","lemma":"edad","pos":"noun","rank":505,"glosses":["age","time since an event","age (period of time)"],"ipa":"/eˈdad/","gender":"f","forms":{"plural":"edades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/87/LL-Q1321_%28spa%29-AdrianAbdulBaha-edad.wav","examples":[{"text":"Yo siento mi edad.","en":"I feel my age.","audio":"https://tatoeba.org/en/audio/download/440277"},{"text":"¿Qué edades tienen sus hijos?","en":"How old are your children?","audio":"https://tatoeba.org/en/audio/download/527225"},{"text":"¿Cuál es tu edad?","en":"What's your age?","audio":"https://tatoeba.org/en/audio/download/519526"},{"text":"Esa película es apropiada para personas de todas las edades.","en":"That movie is suitable for people of all ages."},{"text":"La edad no importa.","en":"Age doesn't matter.","audio":"https://tatoeba.org/en/audio/download/789983"}]}