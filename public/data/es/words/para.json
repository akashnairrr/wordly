{"id":"para","lemma":"para","pos":"prep","rank":20,"glosses":["for, to (expressing a recipient)","to, in order to, so, for (expressing the intended purpose of an action)","by, due, due on, due by (expressing a deadline)"],"ipa":"/paɾa/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/08/LL-Q1321_%28spa%29-AdrianAbdulBaha-para.wav","examples":[{"text":"¿No es suficiente para usted?","en":"Isn't it enough for you?","audio":"https://tatoeba.org/en/audio/download/522395","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"sufficient, enough"},null,{"g":"you (formal)"}]},{"text":"Tú no estás para nada de acuerdo, ¿eh?","en":"You don't agree, do you?","audio":"https://tatoeba.org/en/audio/download/704342","words":[{"g":"you"},{"g":"no / not"},{"g":"to be","l":"estar"},null,{"g":"nothing"},null,null,{"g":"hey!"}],"phrases":[[5,7,"agreed"]]},{"text":"¿Para qué me llamaste?","en":"What did you call me for?","audio":"https://tatoeba.org/en/audio/download/819129","words":[null,{"g":"what"},{"g":"me"},{"g":"to summon, to call","l":"llamar"}]},{"text":"Me voy para allá.","en":"I'm going there.","audio":"https://tatoeba.org/en/audio/download/586472","words":[{"g":"me"},{"g":"to go","l":"ir"},null,{"g":"there"}]},{"text":"¡Para de decir eso!","en":"Stop saying that!","audio":"https://tatoeba.org/en/audio/download/443071","words":[null,{"g":"of / from"},{"g":"to say"},{"g":"that","l":"ése"}]}]}