{"id":"movimiento","lemma":"movimiento","pos":"noun","rank":906,"glosses":["movement (physical motion between points in space)","movement (a trend in various fields or social categories)","transaction"],"ipa":"/mobiˈmjento/","gender":"m","forms":{"plural":"movimientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q1321_%28spa%29-Marreromarco-movimiento.wav","examples":[{"text":"Ese movimiento fue un gran error.","en":"That move was a big mistake.","audio":"https://tatoeba.org/en/audio/download/1190593","words":[{"g":"that"},null,{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"error"}]},{"text":"Hay mucho movimiento en esa calle.","en":"There's a lot of traffic on that street.","audio":"https://tatoeba.org/en/audio/download/594649","words":[{"g":"to have","l":"haber"},{"g":"much"},null,{"g":"in / on"},{"g":"that","l":"ese"},{"g":"street"}]},{"text":"¡Un movimiento en falso y estás muerto/muerta!","en":"One false move and you're dead.","words":[{"g":"a"},null,null,null,{"g":"and"},{"g":"to be","l":"estar"},{"g":"dead"},{"g":"dead","l":"muerto"}],"phrases":[[2,4,"falsely, false"]]},{"text":"No hagas movimientos bruscos.","en":"Don't make abrupt moves.","words":[{"g":"no / not"},{"g":"to do","l":"hacer"},null,{"g":"sudden","l":"brusco"}]},{"text":"Es ágil en sus movimientos.","en":"He's quick in his movements.","words":[{"g":"to be","l":"ser"},{"g":"agile"},{"g":"in / on"},{"g":"his, her, its, their"},null]}]}