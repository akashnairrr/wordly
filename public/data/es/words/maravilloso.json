{"id":"maravilloso","lemma":"maravilloso","pos":"adj","rank":665,"glosses":["wonderful, marvelous"],"ipa":"/maɾabiˈʝoso/","forms":{"feminine":"maravillosa","masculinePlural":"maravillosos","femininePlural":"maravillosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Marreromarco-maravilloso.wav","examples":[{"text":"Es maravilloso estar aquí.","en":"It's wonderful to be here.","audio":"https://tatoeba.org/en/audio/download/519209","words":[{"g":"to be","l":"ser"},null,{"g":"to be"},{"g":"here"}]},{"text":"Tengo una idea maravillosa.","en":"I have a wonderful idea.","audio":"https://tatoeba.org/en/audio/download/459093","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"idea"},null]},{"text":"Ella me dio un regalo maravilloso.","en":"She gave me a wonderful present.","audio":"https://tatoeba.org/en/audio/download/353924","words":[{"g":"she"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"present, gift"},null]},{"text":"Ella es una esposa maravillosa.","en":"She is a wonderful wife.","audio":"https://tatoeba.org/en/audio/download/733626","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"wife"},null]},{"text":"Gracias por este regalo maravilloso.","en":"Thank you for the wonderful gift.","audio":"https://tatoeba.org/en/audio/download/353653","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"this"},{"g":"present, gift"},null]}]}