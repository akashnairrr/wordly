{"id":"leve","lemma":"leve","pos":"adj","rank":4567,"glosses":["mild, slight, light","minor, trivial"],"ipa":"/ˈlebe/","forms":{"femininePlural":"leves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-Marreromarco-leve.wav","examples":[{"text":"Tuvimos un leve accidente.","en":"We had a slight accident.","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"accident"}]},{"text":"Hay una leve diferencia.","en":"There's a slight difference.","words":[{"g":"to have","l":"haber"},{"g":"a"},null,{"g":"difference"}]},{"text":"Parece que tengo un leve resfriado.","en":"It seems I have a slight cold.","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"a cold"}]},{"text":"Sonó un leve toque en la puerta.","en":"There was a faint knocking at the door.","words":[{"g":"to sound, to ring","l":"sonar"},{"g":"a"},null,{"g":"a touch"},{"g":"in / on"},{"g":"the / her"},{"g":"door"}]},{"text":"Dijo que tenía un leve resfriado.","en":"She said she had a slight cold.","audio":"https://tatoeba.org/en/audio/download/522333","words":[{"g":"to say","l":"decir"},{"g":"that"},{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"a cold"}]}]}