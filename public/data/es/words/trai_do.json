{"id":"trai_do","lemma":"traído","pos":"adj","rank":876,"glosses":["used, worn (mainly of clothing)"],"ipa":"/tɾaˈido/","forms":{"feminine":"traída","masculinePlural":"traídos","femininePlural":"traídas"},"examples":[{"text":"¿Qué me has traído?","en":"What did you bring me?","audio":"https://tatoeba.org/en/audio/download/222128","words":[{"g":"what"},{"g":"me"},{"g":"to have","l":"haber"},null]},{"text":"He traído a algunos amigos.","en":"I brought some friends with me.","audio":"https://tatoeba.org/en/audio/download/802803","words":[{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"someone","l":"alguno"},{"g":"friend","l":"amigo"}]},{"text":"Te he traído algo de hielo.","en":"I brought you some ice.","audio":"https://tatoeba.org/en/audio/download/459292","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"something, anything"},{"g":"of / from"},{"g":"ice"}]},{"text":"Papá me ha traído en coche.","en":"My father brought me here by car.","audio":"https://tatoeba.org/en/audio/download/581637","words":[{"g":"dad"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"car, automobile"}]},{"text":"A decir verdad, no he traído dinero.","en":"To tell the truth, I have no money with me.","audio":"https://tatoeba.org/en/audio/download/932257","words":[null,null,null,{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"money"}],"phrases":[[0,3,"truth be told"]]}]}