{"id":"trai_do","lemma":"traído","pos":"adj","rank":876,"glosses":["used, worn (mainly of clothing)"],"ipa":"/tɾaˈido/","forms":{"feminine":"traída","masculinePlural":"traídos","femininePlural":"traídas"},"examples":[{"text":"¿Qué me has traído?","en":"What did you bring me?","audio":"https://tatoeba.org/en/audio/download/222128","words":[{"g":"what"},{"g":"me"},{"g":"to have","l":"haber"},null]},{"text":"¿Habéis traído vino?","en":"Did you bring wine?","audio":"https://tatoeba.org/en/audio/download/451137","words":[{"g":"to have","l":"haber"},null,{"g":"to come","l":"venir"}]},{"text":"Te he traído algo de hielo.","en":"I brought you some ice.","audio":"https://tatoeba.org/en/audio/download/459292","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"something, anything"},{"g":"of / from"},{"g":"ice"}]},{"text":"Papá me ha traído en coche.","en":"My father brought me here by car.","audio":"https://tatoeba.org/en/audio/download/581637","words":[{"g":"dad"},{"g":"me"},{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"car, automobile"}]},{"text":"Tom no lo ha traído.","en":"Tom didn't bring it.","audio":"https://tatoeba.org/en/audio/download/197035","words":[null,{"g":"no / not"},{"g":"it / him"},{"g":"to have","l":"haber"},null]}]}