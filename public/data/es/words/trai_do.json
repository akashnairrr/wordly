{"id":"trai_do","lemma":"traído","pos":"adj","rank":879,"glosses":["used, worn (mainly of clothing)"],"ipa":"/tɾaˈido/","forms":{"feminine":"traída","masculinePlural":"traídos","femininePlural":"traídas"},"examples":[{"text":"¿Qué me has traído?","en":"What did you bring me?","audio":"https://tatoeba.org/en/audio/download/222128"},{"text":"Tom no lo ha traído.","en":"Tom didn't bring it.","audio":"https://tatoeba.org/en/audio/download/197035"},{"text":"Desearía haberme traído un paraguas.","en":"I wish I'd bought an umbrella.","audio":"https://tatoeba.org/en/audio/download/605025"},{"text":"He traído a algunos amigos.","en":"I brought some friends with me.","audio":"https://tatoeba.org/en/audio/download/802803"},{"text":"Deberíamos haber traído una linterna.","en":"We should've brought a flashlight.","audio":"https://tatoeba.org/en/audio/download/532294"}]}