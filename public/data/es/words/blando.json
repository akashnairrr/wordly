{"id":"blando","lemma":"blando","pos":"adj","rank":4711,"glosses":["soft","bland","flabby"],"ipa":"/ˈblando/","forms":{"feminine":"blanda","masculinePlural":"blandos","femininePlural":"blandas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q1321_%28spa%29-AdrianAbdulBaha-blando.wav","examples":[{"text":"La niña tiene un corazón blando.","en":"The girl has a soft heart.","words":[{"g":"the / her"},{"g":"girl"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"heart"},null]},{"text":"Mi abuela solo puede comer comida blanda.","en":"My grandmother can only eat soft food.","words":[{"g":"my"},{"g":"grandmother"},{"g":"sole"},{"g":"to be able to, can","l":"poder"},{"g":"to eat"},{"g":"food"},null]},{"text":"Esta silla es blanda y cómoda.","en":"This chair is soft and comfortable.","audio":"https://tatoeba.org/en/audio/download/687975","words":[{"g":"this","l":"este"},{"g":"chair"},{"g":"to be","l":"ser"},null,{"g":"and"},{"g":"chest of drawers"}]},{"text":"Se está volviendo blando ahora que es mayor.","en":"He's getting soft in his old age.","audio":"https://tatoeba.org/en/audio/download/684508","words":[{"g":"oneself"},{"g":"to be","l":"estar"},{"g":"to return","l":"volver"},null,null,null,{"g":"to be","l":"ser"},{"g":"of age"}],"phrases":[[4,6,"now that"]]},{"text":"Ella tiene un corazón blando.","en":"She has a tender heart.","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"heart"},null]}]}