{"id":"general","lemma":"general","pos":"adj","rank":451,"glosses":["general, overall"],"ipa":"/xeneˈɾal/","forms":{"femininePlural":"generales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Precision27-general.wav","formAudio":{"generales":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q1321_%28spa%29-Eavqwiki-generales.wav"},"examples":[{"text":"En general las cosas están bien.","en":"In general, things are all right.","words":[{"g":"in / on"},null,{"g":"the / them"},{"g":"thing","l":"cosa"},{"g":"to be","l":"estar"},{"g":"well"}]},{"text":"Hoy es el ensayo general.","en":"Today is the dress rehearsal.","audio":"https://tatoeba.org/en/audio/download/508471","words":[{"g":"today, tonight"},{"g":"to be","l":"ser"},{"g":"the"},{"g":"essay"},null]},{"text":"En general ha sido un buen viaje.","en":"It's been a nice trip overall.","words":[{"g":"in / on"},null,{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},{"g":"a"},null,null],"phrases":[[5,7,"bon voyage!"]]},{"text":"Tengo una idea general de lo que él quiere decir.","en":"I have a general idea of what he means.","audio":"https://tatoeba.org/en/audio/download/34827","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"idea"},null,{"g":"of / from"},null,null,{"g":"he"},{"g":"to desire","l":"querer"},{"g":"to say"}],"phrases":[[5,7,"what, that which"]]},{"text":"El general les ordenó seguir adelante.","en":"The general commanded them to move on.","words":[{"g":"the"},null,{"g":"them"},{"g":"to order, arrange","l":"ordenar"},null,null],"phrases":[[4,6,"to go on"]]}]}