{"id":"general","lemma":"general","pos":"adj","rank":454,"glosses":["general, overall"],"ipa":"/xeneˈɾal/","forms":{"femininePlural":"generales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Precision27-general.wav","formAudio":{"generales":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q1321_%28spa%29-Eavqwiki-generales.wav"},"examples":[{"text":"Hubo un vitoreo general.","en":"Everyone cheered.","audio":"https://tatoeba.org/en/audio/download/443191"},{"text":"En términos generales, los hombres son más altos que las mujeres.","en":"Generally speaking, men are taller than women."},{"text":"Hubo un chillido general.","en":"Everyone screamed.","audio":"https://tatoeba.org/en/audio/download/799719"},{"text":"Hoy es el ensayo general.","en":"Today is the dress rehearsal.","audio":"https://tatoeba.org/en/audio/download/508471"},{"text":"General Motors despidió a 76.000 trabajadores.","en":"General Motors laid off 76,000 workers.","audio":"https://tatoeba.org/en/audio/download/693597"}]}