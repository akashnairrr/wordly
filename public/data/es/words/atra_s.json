{"id":"atra_s","lemma":"atrás","pos":"adv","rank":337,"glosses":["behind","back in time, ago"],"ipa":"/aˈtɾas/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q1321_%28spa%29-Marreromarco-atr%C3%A1s.wav","examples":[{"text":"Da un paso atrás.","en":"Step back.","audio":"https://tatoeba.org/en/audio/download/438926"},{"text":"Él miró hacia atrás.","en":"He looked back.","audio":"https://tatoeba.org/en/audio/download/527151"},{"text":"Detén la cuenta atrás.","en":"Stop the countdown.","audio":"https://tatoeba.org/en/audio/download/448167"},{"text":"Detengan la cuenta atrás.","en":"Stop the countdown.","audio":"https://tatoeba.org/en/audio/download/448168"},{"text":"No me echo atrás.","en":"I'm not backing out.","audio":"https://tatoeba.org/en/audio/download/449502"}]}