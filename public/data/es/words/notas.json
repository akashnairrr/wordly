{"id":"notas","lemma":"notas","pos":"noun","rank":1406,"glosses":["show-off"],"ipa":"/ˈnotas/","gender":"mf","forms":{"plural":"notas"},"examples":[{"text":"Asegúrate de tomar notas.","en":"Make sure to take notes.","audio":"https://tatoeba.org/en/audio/download/871803"},{"text":"¿Notas el sabor del jengibre?","en":"Can you taste the ginger?","audio":"https://tatoeba.org/en/audio/download/915866"},{"text":"Este año tuve malas notas.","en":"I had bad results this year.","audio":"https://tatoeba.org/en/audio/download/639380"},{"text":"Está orgulloso de sus buenas notas.","en":"He's proud of his good grades.","audio":"https://tatoeba.org/en/audio/download/641853"},{"text":"¿Me prestas tus notas de historia?","en":"Can I borrow your history notes?","audio":"https://tatoeba.org/en/audio/download/616212"}]}