{"id":"sur","lemma":"sur","pos":"noun","rank":816,"glosses":["south"],"ipa":"/ˈsuɾ/","gender":"m","forms":{"plural":"sures"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-AdrianAbdulBaha-sur.wav","examples":[{"text":"Id hacia el sur.","en":"Head south.","audio":"https://tatoeba.org/en/audio/download/722183"},{"text":"Navegamos hacia el sur.","en":"We're sailing southward.","audio":"https://tatoeba.org/en/audio/download/630266"},{"text":"¿Dónde está la terminal sur?","en":"Where is the south terminal?","audio":"https://tatoeba.org/en/audio/download/333112"},{"text":"Vienen del sur de Francia.","en":"They come from the south of France.","audio":"https://tatoeba.org/en/audio/download/932161"},{"text":"Estas ventanas miran hacia el sur.","en":"These windows look to the south.","audio":"https://tatoeba.org/en/audio/download/767846"}]}