{"id":"cola","lemma":"cola","pos":"noun","rank":1490,"glosses":["tail","line (US), queue (UK)","empennage, aircraft tail"],"ipa":"/ˈkola/","gender":"f","forms":{"plural":"colas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-Rodelar-cola.wav","examples":[{"text":"Mi perro tiene la cola larga.","en":"My dog has a long tail.","audio":"https://tatoeba.org/en/audio/download/460428","words":[{"g":"my"},{"g":"dog"},{"g":"to have","l":"tener"},{"g":"the / her"},null,{"g":"long","l":"largo"}]},{"text":"¿Estás cansado de hacer cola?","en":"Are you tired of waiting in line?","audio":"https://tatoeba.org/en/audio/download/553092","words":[{"g":"to be","l":"estar"},{"g":"tired, weary, wearied"},{"g":"of / from"},{"g":"to do"},null]},{"text":"Llevo toda la mañana en la cola.","en":"I've spent all morning in line.","audio":"https://tatoeba.org/en/audio/download/301089","words":[{"g":"to take somewhere","l":"llevar"},{"g":"all","l":"todo"},{"g":"the / her"},{"g":"tomorrow"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Me he pasado toda la tarde en la cola.","en":"I've been in line all afternoon.","audio":"https://tatoeba.org/en/audio/download/301092","words":[{"g":"me"},{"g":"to have","l":"haber"},{"g":"past"},{"g":"all","l":"todo"},{"g":"the / her"},{"g":"late"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Niño, ponte a la cola como todos.","en":"Hey kid, get in line like everyone else.","audio":"https://tatoeba.org/en/audio/download/301083","words":[{"g":"child, boy"},{"g":"to put, to place","l":"poner"},{"g":"to"},{"g":"the / her"},null,{"g":"as"},{"g":"all","l":"todo"}]}]}