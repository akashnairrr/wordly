{"id":"cola","lemma":"cola","pos":"noun","rank":1493,"glosses":["tail","line (US), queue (UK)","empennage, aircraft tail"],"ipa":"/ˈkola/","gender":"f","forms":{"plural":"colas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-Rodelar-cola.wav","examples":[{"text":"El perro meneaba la cola.","en":"The dog wagged its tail.","audio":"https://tatoeba.org/en/audio/download/586495"},{"text":"Los conejos tienen orejas alargadas y colas cortas.","en":"Rabbits have long ears and short tails.","audio":"https://tatoeba.org/en/audio/download/599152"},{"text":"Mi perro mueve la cola.","en":"My dog is wagging his tail.","audio":"https://tatoeba.org/en/audio/download/551857"},{"text":"¿Estás cansado de hacer cola?","en":"Are you tired of waiting in line?","audio":"https://tatoeba.org/en/audio/download/553092"},{"text":"Era el tercero de la cola.","en":"I was third in line.","audio":"https://tatoeba.org/en/audio/download/333277"}]}