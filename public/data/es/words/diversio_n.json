{"id":"diversio_n","lemma":"diversión","pos":"noun","rank":1353,"glosses":["fun, entertainment, amusement, levity"],"ipa":"/dibeɾˈsjon/","gender":"f","forms":{"plural":"diversiones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Marreromarco-diversi%C3%B3n.wav","examples":[{"text":"Nosotros no tuvimos mucha diversión.","en":"We didn't have much fun.","audio":"https://tatoeba.org/en/audio/download/598913","words":[{"g":"we"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},null]},{"text":"Solo quiero tener un poco de diversión.","en":"I just want to have a little fun.","audio":"https://tatoeba.org/en/audio/download/806207","words":[{"g":"sole"},{"g":"to desire","l":"querer"},{"g":"to have"},null,null,{"g":"of / from"},null],"phrases":[[3,5,"a bit"]]},{"text":"Tom fue a un parque de diversiones.","en":"Tom went to an amusement park.","words":[null,{"g":"to be","l":"ser"},{"g":"to"},{"g":"a"},{"g":"park"},{"g":"of / from"},null]},{"text":"Esta no es mi idea de diversión.","en":"This is not my idea of fun.","words":[{"g":"this","l":"este"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"my"},{"g":"idea"},{"g":"of / from"},null]},{"text":"Tom lo hizo por diversión.","en":"Tom did it for fun.","words":[null,{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"for / by"},null]}]}