{"id":"premio","lemma":"premio","pos":"noun","rank":1260,"glosses":["prize, award (honour or reward)","prize (that which may be won)","premium (bonus paid in addition to normal payments)"],"ipa":"/ˈpɾemjo/","gender":"m","forms":{"plural":"premios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q1321_%28spa%29-Marreromarco-premio.wav","examples":[{"text":"¿Cuál es mi premio?","en":"What's my prize?","audio":"https://tatoeba.org/en/audio/download/442261"},{"text":"Me gusta ganar premios.","en":"I like to win prizes.","audio":"https://tatoeba.org/en/audio/download/800917"},{"text":"Tom ganó un premio.","en":"Tom won an award.","audio":"https://tatoeba.org/en/audio/download/353321"},{"text":"Elige uno de estos premios.","en":"Choose one from among these prizes."},{"text":"Gané el primer premio.","en":"I won first place.","audio":"https://tatoeba.org/en/audio/download/443602"}]}