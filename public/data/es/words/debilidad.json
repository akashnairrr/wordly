{"id":"debilidad","lemma":"debilidad","pos":"noun","rank":2428,"glosses":["debility","weakness"],"ipa":"/debiliˈdad/","gender":"f","forms":{"plural":"debilidades"},"order":2441,"audio":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-AdrianAbdulBaha-debilidad.wav","examples":[{"text":"Todo el mundo tiene fortalezas y debilidades.","en":"Everyone has strengths and weaknesses.","audio":"https://tatoeba.org/en/audio/download/733068","words":[null,null,null,{"g":"to have","l":"tener"},{"g":"fortress","l":"fortaleza"},{"g":"and"},null],"phrases":[[0,3,"everyone, everybody"]]},{"text":"Un guerrero asimila su fortaleza y debilidad.","en":"The warrior is conscious of both his strength and his weakness.","words":[{"g":"a"},{"g":"warrior"},null,{"g":"his / her / your"},{"g":"fortress"},{"g":"and"},null]},{"text":"Toda nación, rica o pobre, tiene sus fortalezas y sus debilidades.","en":"Every nation, rich or poor, has its strengths and weaknesses.","audio":"https://tatoeba.org/en/audio/download/693429","words":[{"g":"all","l":"todo"},{"g":"nation"},{"g":"fenugreek"},{"g":"or"},{"g":"poor"},{"g":"to have","l":"tener"},{"g":"his, her, its, their"},{"g":"fortress","l":"fortaleza"},{"g":"and"},{"g":"his, her, its, their"},null]}]}