{"id":"bebida","lemma":"bebida","pos":"noun","rank":1350,"glosses":["drink, beverage","soda (soft drink, pop)"],"ipa":"/beˈbida/","gender":"f","forms":{"plural":"bebidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-AdrianAbdulBaha-bebida.wav","examples":[{"text":"Aquí está tu bebida.","en":"Here's your drink.","audio":"https://tatoeba.org/en/audio/download/443636"},{"text":"Las bebidas eran gratis.","en":"The drinks were free.","audio":"https://tatoeba.org/en/audio/download/454897"},{"text":"Te compraré una bebida.","en":"I'll buy you a drink.","audio":"https://tatoeba.org/en/audio/download/69862"},{"text":"¿Qué bebidas frías tienes?","en":"What cold drinks do you have?","audio":"https://tatoeba.org/en/audio/download/733670"},{"text":"¿Puedo comprarte una bebida?","en":"Can I buy you a drink?","audio":"https://tatoeba.org/en/audio/download/453681"}]}