{"id":"falso","lemma":"falso","pos":"adj","rank":1379,"glosses":["false; untrue","fake; counterfeit"],"ipa":"/ˈfalso/","forms":{"feminine":"falsa","masculinePlural":"falsos","femininePlural":"falsas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1a/LL-Q1321_%28spa%29-AdrianAbdulBaha-falso.wav","examples":[{"text":"Eso es completamente falso.","en":"That's absolutely wrong.","audio":"https://tatoeba.org/en/audio/download/721144"},{"text":"Su identificación era falsa.","en":"His ID was fake.","audio":"https://tatoeba.org/en/audio/download/441533"},{"text":"Los rumores eran falsos.","en":"The rumors were false.","audio":"https://tatoeba.org/en/audio/download/460583"},{"text":"Ambas afirmaciones son falsas.","en":"Both claims are false.","audio":"https://tatoeba.org/en/audio/download/453957"},{"text":"Todo lo que dijiste era falso.","en":"Everything you said was false.","audio":"https://tatoeba.org/en/audio/download/642097"}]}