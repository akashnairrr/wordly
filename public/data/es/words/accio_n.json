{"id":"accio_n","lemma":"acción","pos":"noun","rank":825,"glosses":["action, act, deed (something done)","action (way of motion or functioning)","action (fast-paced activity)"],"ipa":"/aɡˈθjon/","gender":"f","forms":{"plural":"acciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-Rodrigo5260-acci%C3%B3n.wav","formAudio":{"acciones":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-Marreromarco-acciones.wav"},"examples":[{"text":"¡Feliz día de acción de gracias!","en":"Happy Thanksgiving!","audio":"https://tatoeba.org/en/audio/download/448494","words":[{"g":"happy, merry"},{"g":"day"},{"g":"of / from"},null,{"g":"of / from"},{"g":"thank you, thanks"}]},{"text":"Las acciones dicen más que las palabras.","en":"Actions speak louder than words.","audio":"https://tatoeba.org/en/audio/download/586777","words":[{"g":"the / them"},null,{"g":"to say","l":"decir"},null,null,{"g":"the / them"},{"g":"word","l":"palabra"}],"phrases":[[3,5,"apart from"]]},{"text":"Es un hombre de acción.","en":"He is a man of action.","audio":"https://tatoeba.org/en/audio/download/68722","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},{"g":"of / from"},null]},{"text":"Tiene acciones en esta compañía.","en":"He holds stocks in this company.","audio":"https://tatoeba.org/en/audio/download/645426","words":[{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"company"}]},{"text":"Soy responsable de mis propias acciones.","en":"I'm responsible for my own actions.","audio":"https://tatoeba.org/en/audio/download/505884","words":[{"g":"to be","l":"ser"},{"g":"responsible"},{"g":"of / from"},{"g":"my"},{"g":"own","l":"propio"},null]}]}