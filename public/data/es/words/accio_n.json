{"id":"accio_n","lemma":"acción","pos":"noun","rank":825,"glosses":["action, act, deed (something done)","action (way of motion or functioning)","action (fast-paced activity)"],"ipa":"/aɡˈθjon/","gender":"f","forms":{"plural":"acciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-Rodrigo5260-acci%C3%B3n.wav","formAudio":{"acciones":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-Marreromarco-acciones.wav"},"examples":[{"text":"Es un hombre de acción.","en":"He is a man of action.","audio":"https://tatoeba.org/en/audio/download/68722","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"man"},{"g":"of / from"},null]},{"text":"Necesitamos acciones no palabras.","en":"We need action, not words.","words":[{"g":"to need","l":"necesitar"},null,{"g":"no / not"},{"g":"word","l":"palabra"}]},{"text":"Tiene acciones en esta compañía.","en":"He holds stocks in this company.","audio":"https://tatoeba.org/en/audio/download/645426","words":[{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"this","l":"este"},{"g":"company"}]},{"text":"Su plan fue puesto en acción.","en":"His plan was put into action.","words":[{"g":"his / her / your"},{"g":"plan"},{"g":"to be","l":"ser"},{"g":"put"},{"g":"in / on"},null]},{"text":"Necesitamos menos palabras y más acciones.","en":"We need less talk and more action.","words":[{"g":"to need","l":"necesitar"},{"g":"less, fewer"},{"g":"word","l":"palabra"},{"g":"and"},{"g":"more"},null]}]}