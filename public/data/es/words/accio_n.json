{"id":"accio_n","lemma":"acción","pos":"noun","rank":828,"glosses":["action, act, deed (something done)","action (way of motion or functioning)","action (fast-paced activity)"],"ipa":"/aɡˈθjon/","gender":"f","forms":{"plural":"acciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-Rodrigo5260-acci%C3%B3n.wav","formAudio":{"acciones":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-Marreromarco-acciones.wav"},"examples":[{"text":"Es un hombre de acción.","en":"He is a man of action.","audio":"https://tatoeba.org/en/audio/download/68722"},{"text":"Tiene acciones en esta compañía.","en":"He holds stocks in this company.","audio":"https://tatoeba.org/en/audio/download/645426"},{"text":"Toda acción tiene sus consecuencias.","en":"Every action has its consequence.","audio":"https://tatoeba.org/en/audio/download/354037"},{"text":"Él invirtió su dinero en acciones.","en":"He invested his money in stocks.","audio":"https://tatoeba.org/en/audio/download/354654"},{"text":"¡Feliz día de acción de gracias!","en":"Happy Thanksgiving!","audio":"https://tatoeba.org/en/audio/download/448494"}]}