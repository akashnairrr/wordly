{"id":"meta","lemma":"meta","pos":"noun","rank":1797,"glosses":["goal, target"],"ipa":"/ˈmeta/","gender":"f","forms":{"plural":"metas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-Marreromarco-meta.wav","examples":[{"text":"Él alcanzó su meta.","en":"He reached his goal.","audio":"https://tatoeba.org/en/audio/download/450464"},{"text":"No te metas conmigo.","en":"Don't mess with me.","audio":"https://tatoeba.org/en/audio/download/450728"},{"text":"Ésa no es la meta.","en":"That isn't the goal.","audio":"https://tatoeba.org/en/audio/download/298936"},{"text":"No metas nada de ruido.","en":"You have to be very quiet.","audio":"https://tatoeba.org/en/audio/download/611822"},{"text":"Mi meta es ser feliz.","en":"My goal is to be happy.","audio":"https://tatoeba.org/en/audio/download/460563"}]}