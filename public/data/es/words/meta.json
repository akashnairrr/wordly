{"id":"meta","lemma":"meta","pos":"noun","rank":1794,"glosses":["goal, target"],"ipa":"/ˈmeta/","gender":"f","forms":{"plural":"metas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-Marreromarco-meta.wav","examples":[{"text":"Mi meta es ser feliz.","en":"My goal is to be happy.","audio":"https://tatoeba.org/en/audio/download/460563","words":[{"g":"my"},null,{"g":"to be","l":"ser"},{"g":"to be"},{"g":"happy, merry"}]},{"text":"Estoy un paso más cerca de mi meta.","en":"I'm one step closer to my goal.","audio":"https://tatoeba.org/en/audio/download/351970","words":[{"g":"to be","l":"estar"},{"g":"a"},{"g":"step, footstep"},{"g":"more"},null,null,{"g":"my"},null],"phrases":[[4,6,"close to"]]},{"text":"Ésa no es la meta.","en":"That isn't the goal.","audio":"https://tatoeba.org/en/audio/download/298936","words":[{"g":"that one","l":"ése"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"¿Cuál es tu meta en la vida?","en":"What's your aim in life?","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"in / on"},null,null],"phrases":[[5,7,"the game"]]},{"text":"Meta usted el dinero dentro del bolsillo.","en":"Put the money in your pocket.","words":[null,{"g":"you (formal)"},{"g":"the"},{"g":"money"},{"g":"inside"},{"g":"of the"},{"g":"pocket"}]}]}