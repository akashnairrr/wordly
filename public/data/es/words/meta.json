{"id":"meta","lemma":"meta","pos":"noun","rank":1793,"glosses":["goal, target"],"ipa":"/ˈmeta/","gender":"f","forms":{"plural":"metas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-Marreromarco-meta.wav","examples":[{"text":"Mi meta es ser feliz.","en":"My goal is to be happy.","audio":"https://tatoeba.org/en/audio/download/460563","words":[{"g":"my"},null,{"g":"to be","l":"ser"},{"g":"to be"},{"g":"happy, merry"}]},{"text":"Ésa no es la meta.","en":"That isn't the goal.","audio":"https://tatoeba.org/en/audio/download/298936","words":[{"g":"that one","l":"ése"},{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"Él alcanzó su meta.","en":"He reached his goal.","audio":"https://tatoeba.org/en/audio/download/450464","words":[{"g":"he"},{"g":"to reach","l":"alcanzar"},{"g":"his / her / your"},null]},{"text":"Alcanzamos nuestra meta.","en":"We reached our goal.","audio":"https://tatoeba.org/en/audio/download/454202","words":[{"g":"to reach","l":"alcanzar"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"¿Cuál es tu meta en la vida?","en":"What's your aim in life?","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"in / on"},null,null],"phrases":[[5,7,"the game"]]}]}