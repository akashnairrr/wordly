{"id":"cuchillo","lemma":"cuchillo","pos":"noun","rank":1053,"glosses":["knife","blade of knife"],"ipa":"/kuˈt͡ʃiʝo/","gender":"m","forms":{"plural":"cuchillos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q1321_%28spa%29-AdrianAbdulBaha-cuchillo.wav","examples":[{"text":"El cuchillo está desafilado.","en":"The knife is dull.","audio":"https://tatoeba.org/en/audio/download/448560"},{"text":"Se ha perdido uno de los cuchillos.","en":"One of the knives is missing.","audio":"https://tatoeba.org/en/audio/download/532282"},{"text":"El cuchillo está amellado.","en":"The knife is dull.","audio":"https://tatoeba.org/en/audio/download/523341"},{"text":"Mantengan a los niños alejados de los cuchillos.","en":"Keep the children away from the knives.","audio":"https://tatoeba.org/en/audio/download/689276"},{"text":"El cuchillo está romo.","en":"The knife is dull.","audio":"https://tatoeba.org/en/audio/download/448627"}]}