{"id":"sumamente","lemma":"sumamente","pos":"adv","rank":4476,"glosses":["most","highly","extremely"],"ipa":"/ˌsumaˈmente/","examples":[{"text":"Esto es un asunto sumamente serio.","en":"This is a very serious issue.","audio":"https://tatoeba.org/en/audio/download/77479","words":[{"g":"this"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"matter"},null,{"g":"serious"}]},{"text":"Él es una persona sumamente importante.","en":"He is a most important person.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"person (an individual"},null,{"g":"important"}]},{"text":"Me hizo sumamente feliz.","en":"It made me supremely happy.","words":[{"g":"me"},{"g":"to do","l":"hacer"},null,{"g":"happy, merry"}]},{"text":"Ella es sumamente sensible al frío.","en":"She is exceedingly sensitive to the cold.","audio":"https://tatoeba.org/en/audio/download/703670","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"sensitive"},{"g":"to the"},{"g":"cold"}]},{"text":"Este vino es sumamente exquisito.","en":"This wine is extremely delicious.","words":[{"g":"this"},{"g":"to come","l":"venir"},{"g":"to be","l":"ser"},null,{"g":"exquisite"}]}]}