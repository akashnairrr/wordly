{"id":"olvido","lemma":"olvido","pos":"noun","rank":2280,"glosses":["oblivion","forgetting, ending of memory","idea meaning an abstract place to put what is wanted to be forgotten, as in the collocation consign to oblivion"],"ipa":"/olˈbido/","gender":"m","forms":{"plural":"olvidos"},"order":2300,"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Marreromarco-olvido.wav","examples":[{"text":"Nunca olvido una cara.","en":"I never forget a face.","audio":"https://tatoeba.org/en/audio/download/430390","words":[{"g":"never"},null,{"g":"a"},{"g":"face"}]},{"text":"Nunca olvido un nombre.","en":"I never forget a name.","audio":"https://tatoeba.org/en/audio/download/169267","words":[{"g":"never"},null,{"g":"a"},{"g":"name"}]},{"text":"No olvido a mis amigos.","en":"I don't forget my friends.","words":[{"g":"no / not"},null,{"g":"to"},{"g":"my"},{"g":"friend","l":"amigo"}]}]}