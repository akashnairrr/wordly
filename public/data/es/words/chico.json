{"id":"chico","lemma":"chico","pos":"noun","rank":193,"glosses":["boy; kid","guy, lad","term of address equivalent to English guys, feminine form chicas"],"ipa":"/ˈt͡ʃiko/","gender":"m","forms":{"plural":"chicos","feminine":"chica","femininePlural":"chicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-AdrianAbdulBaha-chico.wav","formAudio":{"chica":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-AdrianAbdulBaha-chica.wav"},"examples":[{"text":"Conozco al chico.","en":"I know the boy.","audio":"https://tatoeba.org/en/audio/download/440765","words":[{"g":"to know","l":"conocer"},{"g":"to the"},null]},{"text":"¿Dónde están los chicos?","en":"Where are the boys?","audio":"https://tatoeba.org/en/audio/download/42496","words":[{"g":"where"},{"g":"to be","l":"estar"},{"g":"the / them"},null]},{"text":"¿Quién es ese chico?","en":"Who's that boy?","audio":"https://tatoeba.org/en/audio/download/119317","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"that"},null]},{"text":"¿Tienen hambre, chicos?","en":"Are you guys hungry?","audio":"https://tatoeba.org/en/audio/download/616273","words":[{"g":"to have","l":"tener"},{"g":"hunger"},null]},{"text":"Él es un chico amable.","en":"He is a kind boy.","audio":"https://tatoeba.org/en/audio/download/442425","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"kind"}]}]}