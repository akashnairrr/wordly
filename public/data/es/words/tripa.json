{"id":"tripa","lemma":"tripa","pos":"noun","rank":4639,"glosses":["tripe","intestine; gut","belly"],"ipa":"/ˈtɾipa/","gender":"f","forms":{"plural":"tripas"},"formAudio":{"tripas":"https://upload.wikimedia.org/wikipedia/commons/b/b4/LL-Q1321_%28spa%29-Rodelar-tripas.wav"},"examples":[{"text":"Haz de tripas corazón.","en":"Bite the bullet.","audio":"https://tatoeba.org/en/audio/download/301179","words":[{"g":"to do","l":"hacer"},{"g":"of / from"},null,{"g":"heart"}]},{"text":"El médico me palpó la tripa.","en":"The doctor felt my stomach.","audio":"https://tatoeba.org/en/audio/download/416184","words":[{"g":"the"},{"g":"doctor"},{"g":"me"},null,{"g":"the / her"},null]},{"text":"Me duele la tripa.","en":"I have a stomachache.","audio":"https://tatoeba.org/en/audio/download/41868","words":[{"g":"me"},{"g":"to hurt","l":"doler"},{"g":"the / her"},null]},{"text":"No comas demasiado, no te vaya a dar dolor de tripa.","en":"Don't get a stomachache by eating too much.","audio":"https://tatoeba.org/en/audio/download/693489","words":[{"g":"no / not"},{"g":"comma","l":"coma"},{"g":"too much"},{"g":"no / not"},{"g":"you"},{"g":"what a ..."},{"g":"to"},{"g":"to give, to give out"},{"g":"pain"},{"g":"of / from"},null]},{"text":"Tom dijo que le dolía la tripa y se fue de la habitación.","en":"Tom said he had a stomachache and left the room.","audio":"https://tatoeba.org/en/audio/download/802500","words":[null,{"g":"to say","l":"decir"},{"g":"that"},{"g":"him / her"},{"g":"to hurt","l":"doler"},{"g":"the / her"},null,{"g":"and"},{"g":"oneself"},{"g":"to be","l":"ser"},null,null,{"g":"room"}],"phrases":[[10,12,"of the"]]}]}