{"id":"tiempo","lemma":"tiempo","pos":"noun","rank":75,"glosses":["time","a while, period of time, long time, length of time, indeterminate amount of time","tense"],"ipa":"/ˈtjempo/","gender":"m","forms":{"plural":"tiempos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Precision27-tiempo.wav","formAudio":{"tiempos":"https://upload.wikimedia.org/wikipedia/commons/7/7a/LL-Q1321_%28spa%29-GlyphEnjoyer-tiempos.wav"},"examples":[{"text":"Se acabó el tiempo.","en":"Time's up.","audio":"https://tatoeba.org/en/audio/download/438435"},{"text":"Los tiempos eran duros.","en":"Times were hard.","audio":"https://tatoeba.org/en/audio/download/442152"},{"text":"Esto toma su tiempo.","en":"It takes time.","audio":"https://tatoeba.org/en/audio/download/440540"},{"text":"Los tiempos han cambiado.","en":"Times have changed.","audio":"https://tatoeba.org/en/audio/download/501195"},{"text":"Esto lleva su tiempo.","en":"It takes time.","audio":"https://tatoeba.org/en/audio/download/440541"}]}