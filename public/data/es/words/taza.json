{"id":"taza","lemma":"taza","pos":"noun","rank":1495,"glosses":["cup, mug","toilet bowl"],"ipa":"/ˈtaθa/","gender":"f","forms":{"plural":"tazas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-AdrianAbdulBaha-taza.wav","examples":[{"text":"Me gusta esta taza.","en":"I like this cup.","audio":"https://tatoeba.org/en/audio/download/441677"},{"text":"Me tomé dos tazas de café.","en":"I had two cups of coffee.","audio":"https://tatoeba.org/en/audio/download/38061"},{"text":"La taza es preciosa.","en":"The cup is nice.","audio":"https://tatoeba.org/en/audio/download/734358"},{"text":"Por favor, tráiganos dos tazas de café.","en":"Please bring us two cups of coffee.","audio":"https://tatoeba.org/en/audio/download/568164"},{"text":"La taza está vacía.","en":"The cup is empty.","audio":"https://tatoeba.org/en/audio/download/516464"}]}