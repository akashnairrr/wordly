{"id":"menudo","lemma":"menudo","pos":"adj","rank":950,"glosses":["what (a/an) (intensifier, followed by a noun)","small, tiny","insignificant"],"ipa":"/meˈnudo/","forms":{"feminine":"menuda","masculinePlural":"menudos","femininePlural":"menudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Marreromarco-menudo.wav","examples":[{"text":"Vengo acá a menudo.","en":"I come here often.","audio":"https://tatoeba.org/en/audio/download/443893"},{"text":"Menuda pesadilla.","en":"This is a nightmare.","audio":"https://tatoeba.org/en/audio/download/448887"},{"text":"A menudo vengo aquí.","en":"I often come here.","audio":"https://tatoeba.org/en/audio/download/800379"},{"text":"Me resfrío a menudo.","en":"I often catch colds.","audio":"https://tatoeba.org/en/audio/download/449060"},{"text":"¿Comes afuera a menudo?","en":"Do you eat out often?","audio":"https://tatoeba.org/en/audio/download/453143"}]}