{"id":"tuya","lemma":"tuya","pos":"noun","rank":653,"glosses":["(Thuja) thuja"],"ipa":"/ˈtuʝa/","gender":"f","forms":{"plural":"tuyas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1321_%28spa%29-Marreromarco-tuya.wav","examples":[{"text":"Esto es culpa tuya.","en":"This is on you.","audio":"https://tatoeba.org/en/audio/download/441100"},{"text":"Estoy deseando tener noticias tuyas.","en":"I am looking forward to hearing from you soon.","audio":"https://tatoeba.org/en/audio/download/552868"},{"text":"¿Esta bicicleta es tuya?","en":"Is this bike yours?","audio":"https://tatoeba.org/en/audio/download/450632"},{"text":"Mis piernas no son tan largas como las tuyas.","en":"My legs aren't as long as yours.","audio":"https://tatoeba.org/en/audio/download/450805"},{"text":"Esto es cosa tuya.","en":"This is your doing.","audio":"https://tatoeba.org/en/audio/download/501446"}]}