{"id":"ma_s","lemma":"más","pos":"adv","rank":36,"glosses":["more; -er (used to make comparisons)","most; -est (used to make superlatives)","furthermore"],"ipa":"/ˈmas/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-AdrianAbdulBaha-m%C3%A1s.wav","examples":[{"text":"Yo soy más rápido.","en":"I'm faster.","audio":"https://tatoeba.org/en/audio/download/438819"},{"text":"Yo soy más alto.","en":"I am taller.","audio":"https://tatoeba.org/en/audio/download/46569"},{"text":"Quiero más de eso.","en":"I need more.","audio":"https://tatoeba.org/en/audio/download/450350"},{"text":"Quiero un poco más.","en":"I need more.","audio":"https://tatoeba.org/en/audio/download/442666"},{"text":"Mira desde más cerca.","en":"Look closer.","audio":"https://tatoeba.org/en/audio/download/439114"}]}