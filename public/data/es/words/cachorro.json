{"id":"cachorro","lemma":"cachorro","pos":"noun","rank":3819,"glosses":["puppy","cub (the young of certain other animals, generally mammals)","pup (young of foxes, seals or sea lions)"],"ipa":"/kaˈt͡ʃoro/","gender":"m","forms":{"plural":"cachorros","feminine":"cachorra","femininePlural":"cachorras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-Marreromarco-cachorro.wav","examples":[{"text":"Quiero un cachorro.","en":"I want a puppy.","audio":"https://tatoeba.org/en/audio/download/516698","words":[{"g":"to desire","l":"querer"},{"g":"a"},null]},{"text":"El cachorro quiere dormir.","en":"The puppy wants to sleep.","words":[{"g":"the"},null,{"g":"to desire","l":"querer"},{"g":"to sleep"}]},{"text":"El gatito está entre los cachorros.","en":"The kitten is between the puppies.","words":[{"g":"the"},{"g":"kitten"},{"g":"to be","l":"estar"},{"g":"between"},{"g":"the / them"},null]},{"text":"Nuestra madre nos compró un cachorro.","en":"Our mother bought us a puppy.","words":[{"g":"our, ours, to us","l":"nuestro"},{"g":"mother"},{"g":"us"},{"g":"to buy","l":"comprar"},{"g":"a"},null]},{"text":"Voy a tener un cachorro.","en":"I'm getting a puppy.","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to have"},{"g":"a"},null]}]}