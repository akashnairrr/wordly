{"id":"que","lemma":"que","pos":"conj","rank":2,"glosses":["that","than","indicates reason; because, for"],"ipa":"/ke/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Precision27-que.wav","examples":[{"text":"Yo decía que sí.","en":"I said yes.","audio":"https://tatoeba.org/en/audio/download/412326"},{"text":"Deja que pague yo.","en":"Let me pay.","audio":"https://tatoeba.org/en/audio/download/87321"},{"text":"Dije que te detuvieras.","en":"I said stop.","audio":"https://tatoeba.org/en/audio/download/425194"},{"text":"Yo voté que sí.","en":"I voted yes.","audio":"https://tatoeba.org/en/audio/download/586358"},{"text":"Es posible que nieve.","en":"It may snow.","audio":"https://tatoeba.org/en/audio/download/424577"}]}