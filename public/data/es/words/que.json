{"id":"que","lemma":"que","pos":"conj","rank":2,"glosses":["that","than","indicates reason; because, for"],"ipa":"/ke/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Precision27-que.wav","examples":[{"text":"¿Tienes que hacer eso ahora?","en":"Do you have to do that now?","audio":"https://tatoeba.org/en/audio/download/506268","words":[{"g":"to have","l":"tener"},null,{"g":"to do"},{"g":"that","l":"ése"},{"g":"now"}]},{"text":"Sé que él sabe.","en":"I know that he knows.","audio":"https://tatoeba.org/en/audio/download/77179","words":[{"g":"to know, to understand","l":"saber"},null,{"g":"he"},{"g":"to know, to understand","l":"saber"}]},{"text":"Necesito más que eso.","en":"I need more than that.","audio":"https://tatoeba.org/en/audio/download/454455","words":[{"g":"to need","l":"necesitar"},{"g":"more"},null,{"g":"that","l":"ése"}]},{"text":"Todavía tenemos que hacerlo.","en":"We still have to do that.","audio":"https://tatoeba.org/en/audio/download/585773","words":[{"g":"still, yet"},{"g":"to have","l":"tener"},null,{"g":"to do","l":"hacer"}]},{"text":"¿Tendré que dar una clase?","en":"Will I have to give a lecture?","audio":"https://tatoeba.org/en/audio/download/702947","words":[{"g":"to have","l":"tener"},null,{"g":"to give, to give out"},{"g":"a"},{"g":"lecture"}]}]}