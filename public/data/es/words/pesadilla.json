{"id":"pesadilla","lemma":"pesadilla","pos":"noun","rank":1593,"glosses":["nightmare","bane"],"ipa":"/pesaˈdiʝa/","gender":"f","forms":{"plural":"pesadillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-Marreromarco-pesadilla.wav","examples":[{"text":"He tenido una pesadilla.","en":"I had a nightmare.","audio":"https://tatoeba.org/en/audio/download/444180"},{"text":"Las pesadillas dan miedo.","en":"Nightmares are scary.","audio":"https://tatoeba.org/en/audio/download/800930"},{"text":"Esto es una pesadilla.","en":"This is a nightmare.","audio":"https://tatoeba.org/en/audio/download/448888"},{"text":"A menudo tengo pesadillas.","en":"I often have bad dreams.","audio":"https://tatoeba.org/en/audio/download/501084"},{"text":"Fue solo una pesadilla.","en":"It was just a bad dream."}]}