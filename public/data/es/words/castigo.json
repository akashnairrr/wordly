{"id":"castigo","lemma":"castigo","pos":"noun","rank":1714,"glosses":["punishment"],"ipa":"/kasˈtiɡo/","gender":"m","forms":{"plural":"castigos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4c/LL-Q1321_%28spa%29-AdrianAbdulBaha-castigo.wav","examples":[{"text":"Se merece el castigo.","en":"He deserves the punishment.","audio":"https://tatoeba.org/en/audio/download/524386"},{"text":"Tom se merecía el castigo.","en":"Tom deserved the punishment.","audio":"https://tatoeba.org/en/audio/download/330766"},{"text":"El que roba merece castigo.","en":"A person who steals deserves punishment.","audio":"https://tatoeba.org/en/audio/download/1195676"},{"text":"Ellos se escaparon de su castigo.","en":"They escaped being punished."},{"text":"Su castigo fue severo, pero justo.","en":"Their punishment was harsh, but just."}]}