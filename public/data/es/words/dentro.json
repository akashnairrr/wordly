{"id":"dentro","lemma":"dentro","pos":"adv","rank":236,"glosses":["inside (for space)","indoors","within, in (for time)"],"ipa":"/ˈdentɾo/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-Marreromarco-dentro.wav","examples":[{"text":"Él no está dentro.","en":"He is not in.","audio":"https://tatoeba.org/en/audio/download/412352"},{"text":"¿Está usted ahí dentro?","en":"Are you in there?","audio":"https://tatoeba.org/en/audio/download/412372"},{"text":"Me esconderé aquí dentro.","en":"I'll hide in here.","audio":"https://tatoeba.org/en/audio/download/443601"},{"text":"¿Puedo esconderme aquí dentro?","en":"Can I hide in here?","audio":"https://tatoeba.org/en/audio/download/448769"},{"text":"Nos quedamos todos dentro.","en":"No one is to leave.","audio":"https://tatoeba.org/en/audio/download/448864"}]}