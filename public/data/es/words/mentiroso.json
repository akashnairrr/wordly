{"id":"mentiroso","lemma":"mentiroso","pos":"adj","rank":1564,"glosses":["having the qualities of a liar","having lies"],"ipa":"/mentiˈɾoso/","forms":{"feminine":"mentirosa","masculinePlural":"mentirosos","femininePlural":"mentirosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-Marreromarco-mentiroso.wav","examples":[{"text":"¿Me estás llamando mentirosa?","en":"Are you calling me a liar?","audio":"https://tatoeba.org/en/audio/download/163073","words":[{"g":"me"},{"g":"to be","l":"estar"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"Me dijiste que era un mentiroso.","en":"You said I was a liar.","audio":"https://tatoeba.org/en/audio/download/152158","words":[{"g":"me"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Tom es un mentiroso, ¿no lo es?","en":"Tom is a liar, isn't he?","audio":"https://tatoeba.org/en/audio/download/803905","words":[null,{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"no / not"},{"g":"it / him"},{"g":"to be","l":"ser"}]},{"text":"Los abogados son todos unos mentirosos.","en":"Lawyers are all liars.","audio":"https://tatoeba.org/en/audio/download/49686","words":[{"g":"the / them"},{"g":"lawyer","l":"abogado"},{"g":"to be","l":"ser"},{"g":"all","l":"todo"},{"g":"about, approximately"},null]},{"text":"¡Eres una mentirosa de mierda!","en":"You're a filthy liar!","audio":"https://tatoeba.org/en/audio/download/558923","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null,null],"phrases":[[3,5,"shitty"]]}]}