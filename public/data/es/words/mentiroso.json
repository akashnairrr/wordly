{"id":"mentiroso","lemma":"mentiroso","pos":"adj","rank":1564,"glosses":["having the qualities of a liar","having lies"],"ipa":"/mentiˈɾoso/","forms":{"feminine":"mentirosa","masculinePlural":"mentirosos","femininePlural":"mentirosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b1/LL-Q1321_%28spa%29-Marreromarco-mentiroso.wav","examples":[{"text":"Ella le llamó mentiroso.","en":"She called him a liar.","audio":"https://tatoeba.org/en/audio/download/70114","words":[{"g":"she"},{"g":"him / her"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"¿Me estás llamando mentirosa?","en":"Are you calling me a liar?","audio":"https://tatoeba.org/en/audio/download/163073","words":[{"g":"me"},{"g":"to be","l":"estar"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"Él es un mentiroso.","en":"He's a liar.","audio":"https://tatoeba.org/en/audio/download/438476","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"¿Estás diciendo que soy una mentirosa?","en":"Are you saying that I'm a liar?","audio":"https://tatoeba.org/en/audio/download/355052","words":[{"g":"to be","l":"estar"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Los abogados son todos unos mentirosos.","en":"Lawyers are all liars.","audio":"https://tatoeba.org/en/audio/download/49686","words":[{"g":"the / them"},{"g":"lawyer","l":"abogado"},{"g":"to be","l":"ser"},{"g":"all","l":"todo"},{"g":"about, approximately"},null]}]}