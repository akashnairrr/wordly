{"id":"ra_pido","lemma":"rápido","pos":"noun","rank":229,"glosses":["rapid (part of a river)","express train"],"ipa":"/ˈrapido/","gender":"m","forms":{"plural":"rápidos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q1321_%28spa%29-Rodrigo5260-r%C3%A1pido.wav","examples":[{"text":"Yo soy más rápido.","en":"I'm faster.","audio":"https://tatoeba.org/en/audio/download/438819"},{"text":"Son menos rápidos que yo.","en":"You all aren't as fast as I am.","audio":"https://tatoeba.org/en/audio/download/690843"},{"text":"Los niños corren rápido.","en":"Boys run fast.","audio":"https://tatoeba.org/en/audio/download/437928"},{"text":"Nos apasionan los coches rápidos.","en":"We're passionate about fast cars.","audio":"https://tatoeba.org/en/audio/download/301392"},{"text":"Él es muy rápido.","en":"He's very fast.","audio":"https://tatoeba.org/en/audio/download/636556"}]}