{"id":"an_o","lemma":"año","pos":"noun","rank":101,"glosses":["year","age"],"ipa":"/ˈaɲo/","gender":"m","forms":{"plural":"años"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q1321_%28spa%29-Precision27-a%C3%B1o.wav","formAudio":{"años":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-Precision27-a%C3%B1os.wav"},"examples":[{"text":"¿En qué año estamos?","en":"What year is it?","audio":"https://tatoeba.org/en/audio/download/442235"},{"text":"Él tiene ocho años.","en":"He is eight.","audio":"https://tatoeba.org/en/audio/download/40566"},{"text":"Fue el año pasado.","en":"It was last year.","audio":"https://tatoeba.org/en/audio/download/704157"},{"text":"Yo también tengo 17 años.","en":"I'm 17, too.","audio":"https://tatoeba.org/en/audio/download/35755"},{"text":"Somos de segundo año.","en":"We're sophomores.","audio":"https://tatoeba.org/en/audio/download/415838"}]}