{"id":"examen","lemma":"examen","pos":"noun","rank":1273,"glosses":["exam, examination, test"],"ipa":"/eɡˈsamen/","gender":"m","forms":{"plural":"exámenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2b/LL-Q1321_%28spa%29-Marreromarco-examen.wav","examples":[{"text":"El examen fue fácil.","en":"The exam was easy.","audio":"https://tatoeba.org/en/audio/download/630614"},{"text":"He aprobado todos mis exámenes.","en":"I passed all my tests.","audio":"https://tatoeba.org/en/audio/download/455103"},{"text":"¿Cómo salió el examen?","en":"How did the exam go?","audio":"https://tatoeba.org/en/audio/download/540891"},{"text":"No quiero suspender mis exámenes.","en":"I don't want to fail my exams.","audio":"https://tatoeba.org/en/audio/download/38032"},{"text":"Teníamos un examen oral.","en":"We had an oral exam.","audio":"https://tatoeba.org/en/audio/download/35125"}]}