{"id":"tripulacio_n","lemma":"tripulación","pos":"noun","rank":1845,"glosses":["crew of a ship, plane, or other craft"],"ipa":"/tɾipulaˈθjon/","gender":"f","forms":{"plural":"tripulaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-tripulaci%C3%B3n.wav","examples":[{"text":"Necesito una tripulación.","en":"I need a crew.","audio":"https://tatoeba.org/en/audio/download/440234","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"Son una buena tripulación.","en":"They're a good crew.","audio":"https://tatoeba.org/en/audio/download/833122","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"good","l":"bueno"},null]},{"text":"Toda la tripulación fue salvada.","en":"The whole crew was saved.","audio":"https://tatoeba.org/en/audio/download/587400","words":[{"g":"all","l":"todo"},{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"bran","l":"salvado"}]},{"text":"¡A toda la tripulación, abandonen la nave!","en":"All hands, abandon ship!","words":[{"g":"to"},{"g":"all","l":"todo"},{"g":"the / her"},null,{"g":"to abandon, to leave","l":"abandonar"},{"g":"the / her"},{"g":"ship, vessel"}]},{"text":"La tripulación abandonó el barco.","en":"The crew abandoned the ship.","words":[{"g":"the / her"},null,{"g":"to abandon, to leave","l":"abandonar"},{"g":"the"},{"g":"boat"}]}]}