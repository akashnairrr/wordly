{"id":"justo","lemma":"justo","pos":"adv","rank":263,"glosses":["right, just","exactly","tightly"],"ipa":"/ˈxusto/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-AdrianAbdulBaha-justo.wav","examples":[{"text":"Espera justo aquí.","en":"Wait right here.","audio":"https://tatoeba.org/en/audio/download/442270","words":[{"g":"wait"},null,{"g":"here"}]},{"text":"Estaré justo detrás de ti.","en":"I'll be right behind you.","audio":"https://tatoeba.org/en/audio/download/515090","words":[{"g":"to be","l":"estar"},null,null,null,{"g":"you","l":"tú"}],"phrases":[[2,4,"behind"]]},{"text":"Él estaba justo detrás de mí.","en":"He was just behind me.","audio":"https://tatoeba.org/en/audio/download/453703","words":[{"g":"he"},{"g":"to be","l":"estar"},null,null,null,{"g":"me"}],"phrases":[[3,5,"behind"]]},{"text":"Están justo afuera.","en":"They're right outside.","audio":"https://tatoeba.org/en/audio/download/461206","words":[{"g":"to be","l":"estar"},null,{"g":"out, outside"}]},{"text":"Es justo lo que necesitamos.","en":"It's just what we need.","audio":"https://tatoeba.org/en/audio/download/461626","words":[{"g":"to be","l":"ser"},null,null,null,{"g":"to need","l":"necesitar"}],"phrases":[[2,4,"what, that which"]]}]}