{"id":"junta","lemma":"junta","pos":"noun","rank":1713,"glosses":["board, council, committee","joint, gasket","meeting (a gathering for a purpose)"],"ipa":"/ˈxunta/","gender":"f","forms":{"plural":"juntas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-Marreromarco-junta.wav","formAudio":{"juntas":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-Wikipedian-walker-juntas.wav"},"examples":[{"text":"Trabajamos juntas como un equipo.","en":"We work together as a team.","audio":"https://tatoeba.org/en/audio/download/921376","words":[{"g":"to work","l":"trabajar"},null,{"g":"as"},{"g":"a"},{"g":"team"}]},{"text":"No podemos posponer la junta.","en":"We can't postpone the meeting.","audio":"https://tatoeba.org/en/audio/download/845518","words":[{"g":"no / not"},{"g":"to prune","l":"podar"},{"g":"to postpone"},{"g":"the / her"},null]},{"text":"No pueden vernos juntas.","en":"We can't be seen together.","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot","l":"ver"},null]},{"text":"Necesitáis trabajar juntas.","en":"You need to work together.","words":[{"g":"to need","l":"necesitar"},{"g":"to work"},null]},{"text":"Tomamos decisiones juntas.","en":"We make decisions together.","words":[{"g":"to take","l":"tomar"},{"g":"decision","l":"decisión"},null]}]}