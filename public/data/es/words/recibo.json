{"id":"recibo","lemma":"recibo","pos":"noun","rank":2082,"glosses":["receipt (written acknowledgement of e.g. a sale)","bill (for e.g. electricity or water services)","living room"],"ipa":"/reˈθibo/","gender":"m","forms":{"plural":"recibos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Marreromarco-recibo.wav","examples":[{"text":"Pedí un recibo.","en":"I asked for a receipt.","audio":"https://tatoeba.org/en/audio/download/611277","words":[{"g":"to ask for something","l":"pedir"},{"g":"a"},null]},{"text":"¿Puedo ver tu recibo?","en":"Can I see your receipt?","words":[{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"your"},null]},{"text":"Aquí está mi recibo.","en":"Here's my receipt.","audio":"https://tatoeba.org/en/audio/download/444077","words":[{"g":"here"},{"g":"to be","l":"estar"},{"g":"my"},null]},{"text":"¿Me puede dar un recibo?","en":"Could I get a receipt?","audio":"https://tatoeba.org/en/audio/download/505924","words":[{"g":"me"},{"g":"to be able to, can","l":"poder"},{"g":"to give, to give out"},{"g":"a"},null]},{"text":"Necesitaré un recibo por eso.","en":"I'll need a receipt for that.","audio":"https://tatoeba.org/en/audio/download/586559","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null,{"g":"for / by"},{"g":"that","l":"ése"}]}]}