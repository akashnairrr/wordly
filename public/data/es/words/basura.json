{"id":"basura","lemma":"basura","pos":"noun","rank":647,"glosses":["trash, waste, garbage, rubbish, nonsense","something trashy or undesirable"],"ipa":"/baˈsuɾa/","gender":"f","forms":{"plural":"basuras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/09/LL-Q1321_%28spa%29-AdrianAbdulBaha-basura.wav","examples":[{"text":"Lleva afuera la basura.","en":"Take the garbage out.","audio":"https://tatoeba.org/en/audio/download/454795"},{"text":"No arrojes basura aquí.","en":"Don't throw trash here.","audio":"https://tatoeba.org/en/audio/download/460102"},{"text":"No tires basura aquí.","en":"Don't dump garbage here.","audio":"https://tatoeba.org/en/audio/download/459780"},{"text":"Tengo que sacar la basura.","en":"I have to take out the garbage.","audio":"https://tatoeba.org/en/audio/download/586020"},{"text":"Ya he sacado la basura.","en":"I've already taken out the trash.","audio":"https://tatoeba.org/en/audio/download/1061858"}]}