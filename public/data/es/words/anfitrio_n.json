{"id":"anfitrio_n","lemma":"anfitrión","pos":"noun","rank":4215,"glosses":["host (one which receives a guest)"],"ipa":"/anfiˈtɾjon/","gender":"m","forms":{"plural":"anfitriones","feminine":"anfitriona","femininePlural":"anfitrionas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/76/LL-Q1321_%28spa%29-Marreromarco-anfitri%C3%B3n.wav","examples":[{"text":"Nuestro anfitrión nos ofreció un trago.","en":"Our host offered us a drink.","words":[{"g":"our, ours, to us"},null,{"g":"us"},{"g":"to offer","l":"ofrecer"},{"g":"a"},{"g":"gulp, sip"}]},{"text":"¿Quién es el anfitrión en la fiesta de hoy?","en":"Who's hosting today's party?","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"in / on"},{"g":"the / her"},{"g":"party"},{"g":"of / from"},{"g":"today, tonight"}]},{"text":"El anfitrión cortó el pavo para los invitados.","en":"The host cut the turkey for the guests.","words":[{"g":"the"},null,{"g":"to cut","l":"cortar"},{"g":"the"},{"g":"turkey"},{"g":"for"},{"g":"the / them"},{"g":"invited","l":"invitado"}]},{"text":"España es el país anfitrión de las Olimpiadas de 1992.","en":"Spain is the host country for the Olympics in 1992.","words":[null,{"g":"to be","l":"ser"},{"g":"the"},{"g":"country"},null,{"g":"of / from"},{"g":"the / them"},{"g":"olympiad","l":"olimpiada"},{"g":"of / from"}]}]}