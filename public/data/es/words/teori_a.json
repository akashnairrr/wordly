{"id":"teori_a","lemma":"teoría","pos":"noun","rank":1218,"glosses":["theory"],"ipa":"/teoˈɾia/","gender":"f","forms":{"plural":"teorías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7e/LL-Q1321_%28spa%29-Marreromarco-teor%C3%ADa.wav","examples":[{"text":"Es solo una teoría.","en":"It's just a theory.","audio":"https://tatoeba.org/en/audio/download/799033"},{"text":"No quiero escuchar tus teorías.","en":"I don't want to hear your theories.","audio":"https://tatoeba.org/en/audio/download/594771"},{"text":"¿Cuál es tu teoría?","en":"What's your theory?","audio":"https://tatoeba.org/en/audio/download/501296"},{"text":"No estoy interesada en ninguna de tus teorías.","en":"I'm not interested in any of your theories."},{"text":"He revisado mi teoría.","en":"I revised my theory.","audio":"https://tatoeba.org/en/audio/download/135896"}]}