{"id":"pronto","lemma":"pronto","pos":"adj","rank":243,"glosses":["prompt, on time","ready"],"ipa":"/ˈpɾonto/","forms":{"feminine":"pronta","masculinePlural":"prontos","femininePlural":"prontas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Marreromarco-pronto.wav","examples":[{"text":"¡Que te mejores pronto!","en":"Get well soon!","audio":"https://tatoeba.org/en/audio/download/798882","words":[{"g":"that"},{"g":"you"},{"g":"better","l":"mejor"},null]},{"text":"Me voy a casa pronto todos los días.","en":"I go home early every day.","audio":"https://tatoeba.org/en/audio/download/139508","words":[{"g":"me"},{"g":"to go","l":"ir"},null,null,null,{"g":"all","l":"todo"},{"g":"the / them"},{"g":"day","l":"día"}],"phrases":[[2,4,"home"]]},{"text":"¿Por qué vino pronto a casa?","en":"Why did she come home early?","audio":"https://tatoeba.org/en/audio/download/333081","words":[null,null,{"g":"to come","l":"venir"},null,null,null],"phrases":[[0,2,"why, for what reason"],[4,6,"home"]]},{"text":"¿Vamos a verte pronto?","en":"Are we going to see you soon?","audio":"https://tatoeba.org/en/audio/download/585901","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to see, to spot","l":"ver"},null]},{"text":"Esperamos una pronta resolución del asunto.","en":"We expect an early settlement of the affair.","words":[{"g":"to hope","l":"esperar"},{"g":"a"},null,{"g":"resolution"},{"g":"of the"},{"g":"matter"}]}]}