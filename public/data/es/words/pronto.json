{"id":"pronto","lemma":"pronto","pos":"adj","rank":243,"glosses":["prompt, on time","ready"],"ipa":"/ˈpɾonto/","forms":{"feminine":"pronta","masculinePlural":"prontos","femininePlural":"prontas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Marreromarco-pronto.wav","examples":[{"text":"Lo haré tan pronto como pueda.","en":"I'll do it as soon as I can.","audio":"https://tatoeba.org/en/audio/download/518260","words":[{"g":"it / him"},{"g":"to do","l":"hacer"},{"g":"so, as"},null,{"g":"as"},{"g":"to be able to, can","l":"poder"}]},{"text":"Él llegó demasiado pronto.","en":"He arrived too early.","audio":"https://tatoeba.org/en/audio/download/453089","words":[{"g":"he"},{"g":"to arrive, get","l":"llegar"},{"g":"too much"},null]},{"text":"Ven pronto aquí.","en":"Come here soon.","audio":"https://tatoeba.org/en/audio/download/424871","words":[{"g":"to come","l":"venir"},null,{"g":"here"}]},{"text":"Estaré allí pronto.","en":"I'll be there shortly.","audio":"https://tatoeba.org/en/audio/download/455429","words":[{"g":"to be","l":"estar"},{"g":"there"},null]},{"text":"Espero verte pronto.","en":"I hope to see you soon.","audio":"https://tatoeba.org/en/audio/download/461047","words":[{"g":"to hope","l":"esperar"},{"g":"to see, to spot","l":"ver"},null]}]}