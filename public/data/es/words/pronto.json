{"id":"pronto","lemma":"pronto","pos":"adj","rank":246,"glosses":["prompt, on time","ready"],"ipa":"/ˈpɾonto/","forms":{"feminine":"pronta","masculinePlural":"prontos","femininePlural":"prontas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-Marreromarco-pronto.wav","examples":[{"text":"¡Que te mejores pronto!","en":"Get well soon!","audio":"https://tatoeba.org/en/audio/download/798882"},{"text":"Esperamos una pronta resolución del asunto.","en":"We expect an early settlement of the affair."},{"text":"Vuelve pronto a casa.","en":"Come home early.","audio":"https://tatoeba.org/en/audio/download/582361"},{"text":"Puede que llueva pronto.","en":"It may rain soon.","audio":"https://tatoeba.org/en/audio/download/442802"},{"text":"Él se cansó pronto.","en":"He got tired soon.","audio":"https://tatoeba.org/en/audio/download/525391"}]}