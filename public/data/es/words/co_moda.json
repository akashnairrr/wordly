{"id":"co_moda","lemma":"cómoda","pos":"noun","rank":2346,"glosses":["chest of drawers"],"ipa":"/ˈkomoda/","gender":"f","forms":{"plural":"cómodas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Marreromarco-c%C3%B3moda.wav","examples":[{"text":"Tengo una casa cómoda.","en":"I have a comfortable house.","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"house"},null]},{"text":"Esta silla es muy cómoda.","en":"This chair is very comfortable.","audio":"https://tatoeba.org/en/audio/download/645237","words":[{"g":"this","l":"este"},{"g":"chair"},{"g":"to be","l":"ser"},null,null]},{"text":"Espero que estés cómoda aquí.","en":"I hope you'll be comfortable here.","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"to be","l":"estar"},null,{"g":"here"}]},{"text":"¿Está usted cómoda?","en":"Are you comfortable?","audio":"https://tatoeba.org/en/audio/download/276220","words":[{"g":"to be","l":"estar"},{"g":"you (formal)"},null]},{"text":"Se siente cómoda en su casa.","en":"She feels at ease in their home.","audio":"https://tatoeba.org/en/audio/download/645345","words":[{"g":"oneself"},{"g":"to seat","l":"sentar"},null,{"g":"in / on"},{"g":"his / her / your"},{"g":"house"}]}]}