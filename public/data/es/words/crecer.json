{"id":"crecer","lemma":"crecer","pos":"verb","rank":1790,"glosses":["to grow"],"ipa":"/kɾeˈθeɾ/","conjugation":{"indicative":{"present":{"1s":"crezco","2s":"creces","3s":"crece","1p":"crecemos","2p":"crecéis","3p":"crecen"},"imperfect":{"1s":"crecía","2s":"crecías","3s":"crecía","1p":"crecíamos","2p":"crecíais","3p":"crecían"},"preterite":{"1s":"crecí","2s":"creciste","3s":"creció","1p":"crecimos","2p":"crecisteis","3p":"crecieron"},"future":{"1s":"creceré","2s":"crecerás","3s":"crecerá","1p":"creceremos","2p":"creceréis","3p":"crecerán"},"conditional":{"1s":"crecería","2s":"crecerías","3s":"crecería","1p":"creceríamos","2p":"creceríais","3p":"crecerían"}},"subjunctive":{"present":{"1s":"crezca","2s":"crezcas","3s":"crezca","1p":"crezcamos","2p":"crezcáis","3p":"crezcan"},"imperfect":{"1s":"creciera","2s":"crecieras","3s":"creciera","1p":"creciéramos","2p":"crecierais","3p":"crecieran"}},"imperative":{"affirmative":{"2s":"crece","3s":"crezca","1p":"crezcamos","2p":"creced","3p":"crezcan"},"negative":{"2s":"crezcas","3s":"crezca","1p":"crezcamos","2p":"crezcáis","3p":"crezcan"}}},"nonFinite":{"gerund":"creciendo","participle":"crecido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/51/LL-Q1321_%28spa%29-AdrianAbdulBaha-crecer.wav","examples":[{"text":"Tu pelo volverá a crecer.","en":"Your hair will grow back.","audio":"https://tatoeba.org/en/audio/download/552927"},{"text":"A medida que fue creciendo, se fue haciendo más hermosa.","en":"The older she grew, the more beautiful she became.","audio":"https://tatoeba.org/en/audio/download/928965"},{"text":"He crecido como persona desde entonces.","en":"I've grown as a person since then.","audio":"https://tatoeba.org/en/audio/download/826126"},{"text":"¿Por qué no creces?","en":"Why don't you grow up?","audio":"https://tatoeba.org/en/audio/download/459927"},{"text":"El arroz crece en países cálidos.","en":"Rice grows in warm countries.","audio":"https://tatoeba.org/en/audio/download/706767"}]}