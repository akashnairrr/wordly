{"id":"au_n","lemma":"aún","pos":"adv","rank":164,"glosses":["still, yet","even (implying an extreme example in the case mentioned)"],"ipa":"/aˈun/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-Marreromarco-a%C3%BAn.wav","examples":[{"text":"¿Aún te duele?","en":"Are you still sore?","audio":"https://tatoeba.org/en/audio/download/722262","words":[null,{"g":"you"},null]},{"text":"¿Qué puedo hacer aún?","en":"What more can I do?","audio":"https://tatoeba.org/en/audio/download/78035","words":[{"g":"what"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},null]},{"text":"Ustedes aún son jóvenes.","en":"You're still young.","audio":"https://tatoeba.org/en/audio/download/449945","words":[{"g":"you all"},null,{"g":"to be","l":"ser"},{"g":"young, youthful","l":"joven"}]},{"text":"Aún no me he decidido.","en":"I haven't decided yet.","audio":"https://tatoeba.org/en/audio/download/453706","words":[null,{"g":"no / not"},{"g":"me"},{"g":"to have","l":"haber"},{"g":"decided"}]},{"text":"Nadie me ha matado aún.","en":"Nobody's killed me yet.","audio":"https://tatoeba.org/en/audio/download/460541","words":[{"g":"no one"},{"g":"me"},{"g":"to have","l":"haber"},{"g":"loser"},null]}]}