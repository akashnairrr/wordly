{"id":"au_n","lemma":"aún","pos":"adv","rank":164,"glosses":["still, yet","even (implying an extreme example in the case mentioned)"],"ipa":"/aˈun/","audio":"https://upload.wikimedia.org/wikipedia/commons/d/d3/LL-Q1321_%28spa%29-Marreromarco-a%C3%BAn.wav","examples":[{"text":"Aún lo necesito.","en":"I still need it.","audio":"https://tatoeba.org/en/audio/download/797986","words":[null,{"g":"it / him"},{"g":"to need","l":"necesitar"}]},{"text":"Aún te odio.","en":"I still hate you.","audio":"https://tatoeba.org/en/audio/download/442693","words":[null,{"g":"you"},{"g":"hate"}]},{"text":"No funciona aún.","en":"It's not yet working.","audio":"https://tatoeba.org/en/audio/download/455325","words":[{"g":"no / not"},{"g":"to work, to function","l":"funcionar"},null]},{"text":"¿Qué puedo hacer aún?","en":"What more can I do?","audio":"https://tatoeba.org/en/audio/download/78035","words":[{"g":"what"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},null]},{"text":"Él aún está en cama.","en":"He is still in bed.","audio":"https://tatoeba.org/en/audio/download/706677","words":[{"g":"he"},null,{"g":"to be","l":"estar"},null,null],"phrases":[[3,5,"abed, in bed"]]}]}