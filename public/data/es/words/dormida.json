{"id":"dormida","lemma":"dormida","pos":"noun","rank":2483,"glosses":["sleep (act of sleeping)","sleeping place (for cattle)","moulting (of a silkworm)"],"ipa":"/doɾˈmida/","gender":"f","forms":{"plural":"dormidas"},"order":2495,"examples":[{"text":"Tengo algo dormida la mano izquierda.","en":"I have some numbness in my left hand.","audio":"https://tatoeba.org/en/audio/download/531865","words":[{"g":"to have","l":"tener"},{"g":"something, anything"},null,{"g":"the / her"},null,null],"phrases":[[4,6,"left hand"]]},{"text":"La niña, llorando, se quedó dormida.","en":"The baby cried herself to sleep.","audio":"https://tatoeba.org/en/audio/download/300619","words":[{"g":"the / her"},{"g":"girl"},{"g":"to cry, to weep","l":"llorar"},{"g":"oneself"},{"g":"to be , to end up","l":"quedar"},null]},{"text":"¿Por qué no estás dormida?","en":"Why aren't you asleep?","words":[null,null,{"g":"no / not"},{"g":"to be","l":"estar"},null],"phrases":[[0,2,"why, for what reason"]]}]}