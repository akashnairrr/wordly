{"id":"punta","lemma":"punta","pos":"noun","rank":1975,"glosses":["tip, point, end","pinch, bit (small amount)"],"ipa":"/ˈpunta/","gender":"f","forms":{"plural":"puntas"},"order":2008,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/84/LL-Q1321_%28spa%29-Marreromarco-punta.wav","examples":[{"text":"Lo tengo en la punta de la lengua.","en":"It's on the tip of my tongue.","audio":"https://tatoeba.org/en/audio/download/35832","words":[{"g":"it / him"},{"g":"to have","l":"tener"},{"g":"in / on"},{"g":"the / her"},null,null,null,{"g":"tongue"}],"phrases":[[5,7,"of the"]]},{"text":"Voy a la otra punta del mundo.","en":"I'm going to the other side of the world.","audio":"https://tatoeba.org/en/audio/download/505212","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"the / her"},{"g":"someone else","l":"otro"},null,{"g":"of the"},{"g":"world, earth"}]},{"text":"Tengo las puntas abiertas.","en":"I have split ends.","audio":"https://tatoeba.org/en/audio/download/518648","words":[{"g":"to have","l":"tener"},{"g":"the / them"},null,{"g":"open, unlocked","l":"abierto"}]}]}