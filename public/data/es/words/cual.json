{"id":"cual","lemma":"cual","pos":"pron","rank":434,"glosses":["suchlike, like (which), such as"],"ipa":"/ˈkwal/","forms":{"plural":"cuales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-GlyphEnjoyer-cual.wav","examples":[{"text":"No hay papel en cual escribir.","en":"There is no paper to write on.","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"paper"},{"g":"in / on"},null,{"g":"to write"}]},{"text":"Estaba duro cual piedra.","en":"It was hard as rock.","audio":"https://tatoeba.org/en/audio/download/721395","words":[{"g":"to be","l":"estar"},{"g":"hard"},null,{"g":"stone"}]},{"text":"Veamos cual es el resultado.","en":"Let's see what the outcome is.","audio":"https://tatoeba.org/en/audio/download/803882","words":[{"g":"to see, to spot","l":"ver"},null,{"g":"to be","l":"ser"},{"g":"the"},{"g":"result"}]},{"text":"Ellos no tienen ni idea de cuales son nuestros problemas.","en":"They have no idea what our problems are.","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to have","l":"tener"},null,null,{"g":"of / from"},null,{"g":"to be","l":"ser"},{"g":"our, ours, to us","l":"nuestro"},{"g":"problem","l":"problema"}],"phrases":[[3,5,"no idea"]]},{"text":"Era tal cual.","en":"It was like that.","audio":"https://tatoeba.org/en/audio/download/704156","words":[{"g":"to be","l":"ser"},{"g":"such"},null]}]}