{"id":"sudor","lemma":"sudor","pos":"noun","rank":3705,"glosses":["sweat"],"ipa":"/suˈdoɾ/","gender":"m","forms":{"plural":"sudores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c7/LL-Q1321_%28spa%29-AdrianAbdulBaha-sudor.wav","examples":[{"text":"Él estaba cubierto en sudor.","en":"He was covered with sweat.","audio":"https://tatoeba.org/en/audio/download/70149","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"covered"},{"g":"in / on"},null]},{"text":"El sudor gotea de su cara.","en":"Sweat is dripping from his face.","words":[{"g":"the"},null,{"g":"to drip","l":"gotear"},{"g":"of / from"},{"g":"his / her / your"},{"g":"face"}]},{"text":"Su cara estaba empapada en sudor.","en":"Her face was drenched with sweat.","words":[{"g":"his / her / your"},{"g":"face"},{"g":"to be","l":"estar"},{"g":"sodden, drenched","l":"empapado"},{"g":"in / on"},null]},{"text":"Su pelo está mojado con el sudor.","en":"Her hair is wet with sweat.","words":[{"g":"his / her / your"},{"g":"hair"},{"g":"to be","l":"estar"},{"g":"wet"},{"g":"with"},{"g":"the"},null]},{"text":"Se secó el sudor de la cara.","en":"He wiped the sweat off his face.","words":[{"g":"oneself"},{"g":"to dry","l":"secar"},{"g":"the"},null,null,null,{"g":"face"}],"phrases":[[4,6,"of the"]]}]}