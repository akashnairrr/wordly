{"id":"posicio_n","lemma":"posición","pos":"noun","rank":767,"glosses":["position"],"ipa":"/posiˈθjon/","gender":"f","forms":{"plural":"posiciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q1321_%28spa%29-AdrianAbdulBaha-posici%C3%B3n.wav","examples":[{"text":"Tom está en posición.","en":"Tom is in position.","audio":"https://tatoeba.org/en/audio/download/799125"},{"text":"Adopten la posición de impacto.","en":"Brace yourselves for impact.","audio":"https://tatoeba.org/en/audio/download/703304"},{"text":"Está fuera de posición.","en":"He's out of position."},{"text":"Por favor entiende mi posición.","en":"Please understand my position."},{"text":"Tom me explicó su posición.","en":"Tom explained his position to me."}]}