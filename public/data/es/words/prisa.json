{"id":"prisa","lemma":"prisa","pos":"noun","rank":600,"glosses":["hurry, rush, urgency"],"ipa":"/ˈpɾisa/","gender":"f","forms":{"plural":"prisas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q1321_%28spa%29-Marreromarco-prisa.wav","examples":[{"text":"¿Cuál es la prisa?","en":"What's the hurry?","audio":"https://tatoeba.org/en/audio/download/443352","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"¿Tenéis mucha prisa?","en":"Are you in a rush?","audio":"https://tatoeba.org/en/audio/download/505356","words":[{"g":"to have","l":"tener"},{"g":"much","l":"mucho"},null]},{"text":"¿A qué viene esa prisa?","en":"What's all the hurry?","audio":"https://tatoeba.org/en/audio/download/532312","words":[{"g":"to"},{"g":"what"},{"g":"to come","l":"venir"},{"g":"that","l":"ese"},null]},{"text":"No hace falta que te des prisa.","en":"You don't have to hurry.","audio":"https://tatoeba.org/en/audio/download/554023","words":[{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"lack, shortage"},{"g":"that"},{"g":"you"},{"g":"of","l":"de"},null]},{"text":"Tengo que darme prisa.","en":"I must hurry.","audio":"https://tatoeba.org/en/audio/download/534733","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to give, to give out","l":"dar"},null]}]}