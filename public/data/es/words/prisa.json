{"id":"prisa","lemma":"prisa","pos":"noun","rank":603,"glosses":["hurry, rush, urgency"],"ipa":"/ˈpɾisa/","gender":"f","forms":{"plural":"prisas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/72/LL-Q1321_%28spa%29-Marreromarco-prisa.wav","examples":[{"text":"Tengo que darme prisa.","en":"I must hurry.","audio":"https://tatoeba.org/en/audio/download/534733"},{"text":"Tom se dará prisa.","en":"Tom will hurry.","audio":"https://tatoeba.org/en/audio/download/799073"},{"text":"Por favor, date prisa.","en":"Hurry up, please.","audio":"https://tatoeba.org/en/audio/download/135413"},{"text":"¿Cuál es la prisa?","en":"What's the hurry?","audio":"https://tatoeba.org/en/audio/download/443352"},{"text":"Tienes que darte prisa.","en":"You have to hurry.","audio":"https://tatoeba.org/en/audio/download/449891"}]}