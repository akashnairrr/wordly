{"id":"desaparecido","lemma":"desaparecido","pos":"adj","rank":1133,"glosses":["disappeared, missing"],"ipa":"/desapaɾeˈθido/","forms":{"feminine":"desaparecida","masculinePlural":"desaparecidos","femininePlural":"desaparecidas"},"examples":[{"text":"Mis zapatos han desaparecido.","en":"My shoes are gone.","audio":"https://tatoeba.org/en/audio/download/73788"},{"text":"Los polis están buscando los documentos desaparecidos.","en":"The cops are searching for the missing documents.","audio":"https://tatoeba.org/en/audio/download/704525"},{"text":"El dolor ha desaparecido.","en":"The pain has gone.","audio":"https://tatoeba.org/en/audio/download/525599"},{"text":"Ha desaparecido una chica.","en":"There's a girl missing.","audio":"https://tatoeba.org/en/audio/download/460982"},{"text":"La nieve ha desaparecido.","en":"The snow has disappeared.","audio":"https://tatoeba.org/en/audio/download/70210"}]}