{"id":"desaparecido","lemma":"desaparecido","pos":"adj","rank":1130,"glosses":["disappeared, missing"],"ipa":"/desapaɾeˈθido/","forms":{"feminine":"desaparecida","masculinePlural":"desaparecidos","femininePlural":"desaparecidas"},"examples":[{"text":"Mis zapatos han desaparecido.","en":"My shoes are gone.","audio":"https://tatoeba.org/en/audio/download/73788","words":[{"g":"my"},{"g":"shoe","l":"zapato"},{"g":"to have","l":"haber"},null]},{"text":"El dolor ha desaparecido.","en":"The pain has gone.","audio":"https://tatoeba.org/en/audio/download/525599","words":[{"g":"the"},{"g":"pain"},{"g":"to have","l":"haber"},null]},{"text":"Ha desaparecido una chica.","en":"There's a girl missing.","audio":"https://tatoeba.org/en/audio/download/460982","words":[{"g":"to have","l":"haber"},null,{"g":"a"},{"g":"gal, chick"}]},{"text":"Los polis están buscando los documentos desaparecidos.","en":"The cops are searching for the missing documents.","audio":"https://tatoeba.org/en/audio/download/704525","words":[{"g":"the / them"},{"g":"polis"},{"g":"to be","l":"estar"},{"g":"to seek","l":"buscar"},{"g":"the / them"},{"g":"document, paper","l":"documento"},null]},{"text":"La nieve ha desaparecido.","en":"The snow has disappeared.","audio":"https://tatoeba.org/en/audio/download/70210","words":[{"g":"the / her"},{"g":"snow"},{"g":"to have","l":"haber"},null]}]}