{"id":"nota","lemma":"nota","pos":"noun","rank":860,"glosses":["note, memo","note","mark, academic score"],"ipa":"/ˈnota/","gender":"f","forms":{"plural":"notas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q1321_%28spa%29-AdrianAbdulBaha-nota.wav","examples":[{"text":"Me dejó una nota.","en":"She left me a note.","audio":"https://tatoeba.org/en/audio/download/637197"},{"text":"Asegúrate de tomar notas.","en":"Make sure to take notes.","audio":"https://tatoeba.org/en/audio/download/871803"},{"text":"Se nota que estás inquieta.","en":"I can tell that you're worried.","audio":"https://tatoeba.org/en/audio/download/532320"},{"text":"¿Notas el sabor del jengibre?","en":"Can you taste the ginger?","audio":"https://tatoeba.org/en/audio/download/915866"},{"text":"Por favor, toma nota de esto.","en":"Please take note of that.","audio":"https://tatoeba.org/en/audio/download/249323"}]}