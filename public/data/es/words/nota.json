{"id":"nota","lemma":"nota","pos":"noun","rank":857,"glosses":["note, memo","note","mark, academic score"],"ipa":"/ˈnota/","gender":"f","forms":{"plural":"notas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5b/LL-Q1321_%28spa%29-AdrianAbdulBaha-nota.wav","examples":[{"text":"Me dejó una nota.","en":"She left me a note.","audio":"https://tatoeba.org/en/audio/download/637197","words":[{"g":"me"},{"g":"to leave","l":"dejar"},{"g":"a"},null]},{"text":"Te iba a dejar una nota.","en":"I was going to leave you a note.","audio":"https://tatoeba.org/en/audio/download/541279","words":[{"g":"you"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to leave"},{"g":"a"},null]},{"text":"Toma nota para que no te olvides.","en":"Write it down so you don't forget.","audio":"https://tatoeba.org/en/audio/download/798408","words":[{"g":"conquest"},null,null,null,{"g":"no / not"},{"g":"you"},{"g":"to forget","l":"olvidar"}],"phrases":[[2,4,"so that"]]},{"text":"Por favor, toma nota de esto.","en":"Please take note of that.","audio":"https://tatoeba.org/en/audio/download/249323","words":[null,null,{"g":"conquest"},null,{"g":"of / from"},{"g":"this"}],"phrases":[[0,2,"please"]]},{"text":"Dejé una nota debajo de la puerta.","en":"I left a note under the door.","audio":"https://tatoeba.org/en/audio/download/552262","words":[{"g":"to leave","l":"dejar"},{"g":"a"},null,null,null,{"g":"the / her"},{"g":"door"}],"phrases":[[3,5,"below"]]}]}