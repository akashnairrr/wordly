{"id":"amarillo","lemma":"amarillo","pos":"adj","rank":2374,"glosses":["yellow or golden (colour)","or (colour on a coat of arms)"],"ipa":"/amaˈɾiʝo/","forms":{"feminine":"amarilla","masculinePlural":"amarillos","femininePlural":"amarillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0a/LL-Q1321_%28spa%29-Rodelar-amarillo.wav","formAudio":{"amarilla":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Marreromarco-amarilla.wav","amarillos":"https://upload.wikimedia.org/wikipedia/commons/4/46/LL-Q1321_%28spa%29-Marreromarco-amarillos.wav","amarillas":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q1321_%28spa%29-Marreromarco-amarillas.wav"},"examples":[{"text":"Aquí hay una rosa amarilla.","en":"Here's a yellow rose.","audio":"https://tatoeba.org/en/audio/download/1086602","words":[{"g":"here"},{"g":"to have","l":"haber"},{"g":"a"},{"g":"rose"},null]},{"text":"La puerta de la oficina es amarilla.","en":"The door of the office is yellow.","audio":"https://tatoeba.org/en/audio/download/590299","words":[{"g":"the / her"},{"g":"door"},null,null,{"g":"office"},{"g":"to be","l":"ser"},null],"phrases":[[2,4,"of the"]]},{"text":"Este cuaderno es amarillo.","en":"This notebook is yellow.","audio":"https://tatoeba.org/en/audio/download/872061","words":[{"g":"this"},{"g":"notebook"},{"g":"to be","l":"ser"},null]},{"text":"Todas las flores del jardín son amarillas.","en":"All the flowers in the garden are yellow.","audio":"https://tatoeba.org/en/audio/download/688834","words":[{"g":"all","l":"todo"},null,null,{"g":"of the"},{"g":"garden"},{"g":"to be","l":"ser"},null],"phrases":[[1,3,"a town in Chalatenango…"]]},{"text":"Están amarillos.","en":"They're yellow.","audio":"https://tatoeba.org/en/audio/download/732339","words":[{"g":"to be","l":"estar"},null]}]}