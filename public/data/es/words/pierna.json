{"id":"pierna","lemma":"pierna","pos":"noun","rank":1075,"glosses":["leg (lower limb of a human)"],"ipa":"/ˈpjeɾna/","gender":"f","forms":{"plural":"piernas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Rodelar-pierna.wav","examples":[{"text":"¿Qué le pasó a tu pierna?","en":"What happened to your leg?","audio":"https://tatoeba.org/en/audio/download/606543","words":[{"g":"what"},{"g":"him / her"},{"g":"to pass","l":"pasar"},{"g":"to"},{"g":"your"},null]},{"text":"Mis piernas me están matando.","en":"My legs are killing me.","audio":"https://tatoeba.org/en/audio/download/460528","words":[{"g":"my"},null,{"g":"me"},{"g":"to be","l":"estar"},{"g":"to kill, slay","l":"matar"}]},{"text":"Me duele la pierna.","en":"My leg hurts.","audio":"https://tatoeba.org/en/audio/download/438425","words":[{"g":"me"},null,{"g":"the / her"},null]},{"text":"Levanta las piernas.","en":"Lift your legs up.","audio":"https://tatoeba.org/en/audio/download/871814","words":[{"g":"to lift","l":"levantar"},{"g":"the / them"},null]},{"text":"Creo que me he roto la pierna.","en":"I think I broke my leg.","audio":"https://tatoeba.org/en/audio/download/461871","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"me"},{"g":"to have","l":"haber"},{"g":"broken"},{"g":"the / her"},null]}]}