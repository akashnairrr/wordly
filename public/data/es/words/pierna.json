{"id":"pierna","lemma":"pierna","pos":"noun","rank":1078,"glosses":["leg (lower limb of a human)"],"ipa":"/ˈpjeɾna/","gender":"f","forms":{"plural":"piernas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ef/LL-Q1321_%28spa%29-Rodelar-pierna.wav","examples":[{"text":"Me duele la pierna.","en":"My leg hurts.","audio":"https://tatoeba.org/en/audio/download/438425"},{"text":"Él tiene piernas largas.","en":"He has long legs.","audio":"https://tatoeba.org/en/audio/download/442426"},{"text":"Me rompí la pierna.","en":"I broke my leg.","audio":"https://tatoeba.org/en/audio/download/68250"},{"text":"Me duelen las piernas.","en":"My legs are sore.","audio":"https://tatoeba.org/en/audio/download/550390"},{"text":"Te rompiste una pierna.","en":"You broke your leg.","audio":"https://tatoeba.org/en/audio/download/449736"}]}