{"id":"hierba","lemma":"hierba","pos":"noun","rank":1785,"glosses":["grass (plant of the family Poaceae or plant that resembles grasses)","herb (plant used to flavour food)","herb (plant used in medicine)"],"ipa":"/ˈʝeɾba/","gender":"f","forms":{"plural":"hierbas"},"order":1827,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8c/LL-Q1321_%28spa%29-Rodelar-hierba.wav","examples":[{"text":"Algunos niños están jugando en la hierba.","en":"Some children are playing on the grass.","audio":"https://tatoeba.org/en/audio/download/689405","words":[{"g":"someone","l":"alguno"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"estar"},{"g":"to play","l":"jugar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Nuestro jardín estaba lleno de malas hierbas.","en":"Our garden was full of weeds.","audio":"https://tatoeba.org/en/audio/download/641718","words":[{"g":"our, ours, to us"},{"g":"garden"},{"g":"to be","l":"estar"},{"g":"full"},null,null,null],"phrases":[[4,6,"with bad intentions"]]},{"text":"¿Por qué la hierba es verde?","en":"Why is grass green?","words":[null,null,{"g":"the / her"},null,{"g":"to be","l":"ser"},{"g":"green"}],"phrases":[[0,2,"why, for what reason"]]}]}