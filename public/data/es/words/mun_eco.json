{"id":"mun_eco","lemma":"muñeco","pos":"noun","rank":3719,"glosses":["doll","puppet","attractive male"],"ipa":"/muˈɲeko/","gender":"m","forms":{"plural":"muñecos","feminine":"muñeca","femininePlural":"muñecas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q1321_%28spa%29-Emanuelps27-mu%C3%B1eco.wav","formAudio":{"muñeca":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-AdrianAbdulBaha-mu%C3%B1eca.wav"},"examples":[{"text":"¿Quién hizo el muñeco de nieve?","en":"Who built the snowman?","audio":"https://tatoeba.org/en/audio/download/44194","words":[{"g":"who"},{"g":"to do","l":"hacer"},{"g":"the"},null,{"g":"of / from"},{"g":"snow"}]},{"text":"Ella hizo el muñeco para mí.","en":"She made the doll for me.","words":[{"g":"she"},{"g":"to do","l":"hacer"},{"g":"the"},null,null,null],"phrases":[[4,6,"in my opinion"]]},{"text":"Es divertido hacer muñecos de nieve en invierno.","en":"It's fun to build a snowman in winter.","audio":"https://tatoeba.org/en/audio/download/688997","words":[{"g":"to be","l":"ser"},{"g":"entertaining"},{"g":"to do"},null,{"g":"of / from"},{"g":"snow"},{"g":"in / on"},{"g":"winter"}]},{"text":"¿Quién ha hecho ese muñeco de nieve?","en":"Who built the snowman?","audio":"https://tatoeba.org/en/audio/download/802355","words":[{"g":"who"},{"g":"to have","l":"haber"},{"g":"done, completed"},{"g":"that"},null,{"g":"of / from"},{"g":"snow"}]},{"text":"Mi hermano me dio un muñeco adorable.","en":"My brother gave me a cute doll.","words":[{"g":"my"},{"g":"brother"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"a"},null,{"g":"adorable"}]}]}