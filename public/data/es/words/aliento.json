{"id":"aliento","lemma":"aliento","pos":"noun","rank":1945,"glosses":["breath"],"ipa":"/aˈljento/","gender":"m","forms":{"plural":"alientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Marreromarco-aliento.wav","examples":[{"text":"Tom está sin aliento.","en":"Tom is winded.","audio":"https://tatoeba.org/en/audio/download/799060"},{"text":"Tom parece sin aliento.","en":"Tom looks winded.","audio":"https://tatoeba.org/en/audio/download/799214"},{"text":"Me quedé sin aliento.","en":"I ran out of breath.","audio":"https://tatoeba.org/en/audio/download/34791"},{"text":"Ahórrate tu aliento, Tom.","en":"Save your breath, Tom.","audio":"https://tatoeba.org/en/audio/download/804007"},{"text":"No desperdicies tu aliento.","en":"Don't waste your breath.","audio":"https://tatoeba.org/en/audio/download/460109"}]}