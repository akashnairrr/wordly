{"id":"aliento","lemma":"aliento","pos":"noun","rank":1942,"glosses":["breath"],"ipa":"/aˈljento/","gender":"m","forms":{"plural":"alientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Marreromarco-aliento.wav","examples":[{"text":"Me quedé sin aliento.","en":"I ran out of breath.","audio":"https://tatoeba.org/en/audio/download/34791","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"without"},null]},{"text":"Tom se quedó sin aliento.","en":"Tom gasped.","audio":"https://tatoeba.org/en/audio/download/799662","words":[null,{"g":"oneself"},{"g":"to be , to end up","l":"quedar"},{"g":"without"},null]},{"text":"Tengo mal aliento.","en":"I have bad breath.","audio":"https://tatoeba.org/en/audio/download/443762","words":[{"g":"to have","l":"tener"},{"g":"badly, poorly, ill"},null]},{"text":"Te deja sin aliento.","en":"She leaves you breathless.","words":[{"g":"you"},{"g":"rest"},{"g":"without"},null]},{"text":"Tom está sin aliento y necesita hacer un descanso.","en":"Tom is out of breath and needs to take a break.","audio":"https://tatoeba.org/en/audio/download/806208","words":[null,{"g":"to be","l":"estar"},{"g":"without"},null,{"g":"and"},{"g":"to need","l":"necesitar"},{"g":"to do"},{"g":"a"},{"g":"rest, break"}]}]}