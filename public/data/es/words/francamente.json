{"id":"francamente","lemma":"francamente","pos":"adv","rank":2325,"glosses":["frankly"],"ipa":"/ˌfɾankaˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Precision27-francamente.wav","examples":[{"text":"Francamente hablando, lo odio.","en":"Frankly speaking, I hate him.","audio":"https://tatoeba.org/en/audio/download/519474","words":[null,{"g":"to talk","l":"hablar"},{"g":"it / him"},{"g":"hate"}]},{"text":"Francamente, ella no me gusta.","en":"Frankly speaking, I don't like her.","audio":"https://tatoeba.org/en/audio/download/764771","words":[null,{"g":"she"},{"g":"no / not"},null,null],"phrases":[[3,5,"like, thumbs up"]]},{"text":"Hablando francamente, no me gusta tu idea.","en":"Frankly speaking, I don't like your idea.","audio":"https://tatoeba.org/en/audio/download/514903","words":[{"g":"to talk","l":"hablar"},null,{"g":"no / not"},null,null,{"g":"your"},{"g":"idea"}],"phrases":[[3,5,"like, thumbs up"]]},{"text":"Francamente hablando, no quiero trabajar con él.","en":"Frankly speaking, I don't want to work with him.","audio":"https://tatoeba.org/en/audio/download/599061","words":[null,{"g":"to talk","l":"hablar"},{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to work"},{"g":"with"},{"g":"he"}]},{"text":"Francamente hablando, yo no estoy de acuerdo contigo.","en":"Frankly speaking, I don't agree with you.","words":[null,{"g":"to talk","l":"hablar"},{"g":"I"},{"g":"no / not"},{"g":"to be","l":"estar"},null,null,{"g":"with you"}],"phrases":[[5,7,"agreed"]]}]}