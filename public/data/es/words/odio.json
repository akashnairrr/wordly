{"id":"odio","lemma":"odio","pos":"noun","rank":463,"glosses":["hate, hatred, loathing (strong aversion; intense dislike)","odium (hatred coupled with disgust)"],"ipa":"/ˈodjo/","gender":"m","forms":{"plural":"odios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-AdrianAbdulBaha-odio.wav","examples":[{"text":"Yo odio la arena.","en":"I hate sand.","audio":"https://tatoeba.org/en/audio/download/438735","words":[{"g":"I"},null,{"g":"the / her"},{"g":"sand, gravel"}]},{"text":"Odio mi trabajo.","en":"I hate my job.","audio":"https://tatoeba.org/en/audio/download/440219","words":[null,{"g":"my"},{"g":"work, job"}]},{"text":"Yo me odio a mí mismo.","en":"I hate myself.","audio":"https://tatoeba.org/en/audio/download/440296","words":[{"g":"I"},{"g":"me"},null,{"g":"to"},{"g":"me"},{"g":"same"}]},{"text":"Odio a mi jefe.","en":"I hate my boss.","audio":"https://tatoeba.org/en/audio/download/440871","words":[null,{"g":"to"},{"g":"my"},{"g":"chief"}]},{"text":"Aún te odio.","en":"I still hate you.","audio":"https://tatoeba.org/en/audio/download/442693","words":[{"g":"still, yet"},{"g":"you"},null]}]}