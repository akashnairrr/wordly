{"id":"odio","lemma":"odio","pos":"noun","rank":466,"glosses":["hate, hatred, loathing (strong aversion; intense dislike)","odium (hatred coupled with disgust)"],"ipa":"/ˈodjo/","gender":"m","forms":{"plural":"odios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-AdrianAbdulBaha-odio.wav","examples":[{"text":"Odio a los perros.","en":"I hate dogs.","audio":"https://tatoeba.org/en/audio/download/501385"},{"text":"Odio a las ratas.","en":"I hate rats.","audio":"https://tatoeba.org/en/audio/download/501324"},{"text":"Yo odio la arena.","en":"I hate sand.","audio":"https://tatoeba.org/en/audio/download/438735"},{"text":"Odio a los insectos.","en":"I hate insects.","audio":"https://tatoeba.org/en/audio/download/440825"},{"text":"Odio a los abogados.","en":"I hate lawyers.","audio":"https://tatoeba.org/en/audio/download/440816"}]}