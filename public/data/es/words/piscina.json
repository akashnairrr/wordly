{"id":"piscina","lemma":"piscina","pos":"noun","rank":1605,"glosses":["swimming pool","fishpond","piscina"],"ipa":"/pisˈθina/","gender":"f","forms":{"plural":"piscinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-AdrianAbdulBaha-piscina.wav","examples":[{"text":"La piscina está llena.","en":"The pool is full.","audio":"https://tatoeba.org/en/audio/download/833118"},{"text":"Se han vaciado las piscinas.","en":"The pools were drained.","audio":"https://tatoeba.org/en/audio/download/769671"},{"text":"La piscina estaba llena.","en":"The pool was full.","audio":"https://tatoeba.org/en/audio/download/819789"},{"text":"Las piscinas olímpicas largas miden cincuenta metros.","en":"Olympic-size swimming pools are fifty meters long.","audio":"https://tatoeba.org/en/audio/download/410401"},{"text":"Está nadando en la piscina.","en":"He is swimming in the pool.","audio":"https://tatoeba.org/en/audio/download/1187418"}]}