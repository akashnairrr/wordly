{"id":"piscina","lemma":"piscina","pos":"noun","rank":1602,"glosses":["swimming pool","fishpond","piscina"],"ipa":"/pisˈθina/","gender":"f","forms":{"plural":"piscinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-AdrianAbdulBaha-piscina.wav","examples":[{"text":"Puedes usar la piscina del hotel.","en":"You can use the hotel's swimming pool.","audio":"https://tatoeba.org/en/audio/download/1191459","words":[{"g":"to be able to, can","l":"poder"},{"g":"to use"},{"g":"the / her"},null,{"g":"of the"},{"g":"hotel"}]},{"text":"No había nadie en la piscina.","en":"No one was in the swimming pool.","audio":"https://tatoeba.org/en/audio/download/531818","words":[{"g":"no / not"},{"g":"makes pluperfect to…"},{"g":"no one"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Hay tres niños en la piscina.","en":"There are three children in the swimming pool.","audio":"https://tatoeba.org/en/audio/download/765265","words":[{"g":"to have","l":"haber"},{"g":"three"},{"g":"child, boy","l":"niño"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"¿Por qué estás en mi piscina?","en":"Why are you in my pool?","audio":"https://tatoeba.org/en/audio/download/823843","words":[null,null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"my"},null],"phrases":[[0,2,"why, for what reason"]]},{"text":"Se han vaciado las piscinas.","en":"The pools were drained.","audio":"https://tatoeba.org/en/audio/download/769671","words":[{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to empty","l":"vaciar"},{"g":"the / them"},null]}]}