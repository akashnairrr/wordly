{"id":"ejemplo","lemma":"ejemplo","pos":"noun","rank":776,"glosses":["example","instance"],"ipa":"/eˈxemplo/","gender":"m","forms":{"plural":"ejemplos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a1/LL-Q1321_%28spa%29-AdrianAbdulBaha-ejemplo.wav","examples":[{"text":"Dame un ejemplo diferente.","en":"Give me a different example.","audio":"https://tatoeba.org/en/audio/download/705610"},{"text":"¿Puedes poner algunos ejemplos?","en":"Can you give some examples?","audio":"https://tatoeba.org/en/audio/download/721300"},{"text":"Tuve que dar el ejemplo.","en":"I had to set an example.","audio":"https://tatoeba.org/en/audio/download/458840"},{"text":"Los ejemplos de este diccionario son fáciles de entender.","en":"The examples in this dictionary are easy to understand.","audio":"https://tatoeba.org/en/audio/download/34644"},{"text":"Tengo que poner un ejemplo.","en":"I have to set an example.","audio":"https://tatoeba.org/en/audio/download/515036"}]}