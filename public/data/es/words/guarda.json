{"id":"guarda","lemma":"guarda","pos":"noun","rank":1683,"glosses":["guard, ward, keeper","ticket inspector"],"ipa":"/ˈɡwaɾda/","gender":"mf","forms":{"plural":"guardas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/68/LL-Q1321_%28spa%29-Marreromarco-guarda.wav","examples":[{"text":"Ella guarda los secretos.","en":"She keeps secrets.","audio":"https://tatoeba.org/en/audio/download/444325"},{"text":"Sé dónde guardas tu pistola.","en":"I know where you keep your gun.","audio":"https://tatoeba.org/en/audio/download/297748"},{"text":"Guarda el secreto, por favor.","en":"Keep it secret, please.","audio":"https://tatoeba.org/en/audio/download/460743"},{"text":"¿Guardas tu dinero en un banco?","en":"Do you keep your money in a bank?"},{"text":"Guarda el dinero por mí, por favor.","en":"Keep this money for me.","audio":"https://tatoeba.org/en/audio/download/460811"}]}