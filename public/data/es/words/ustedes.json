{"id":"ustedes","lemma":"ustedes","pos":"pron","rank":193,"glosses":["you (plural), you guys, y'all, yous, yinz, ye"],"ipa":"/usˈtedes/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/0a/LL-Q1321_%28spa%29-Rodrigo5260-ustedes.wav","examples":[{"text":"Lo han conseguido ustedes.","en":"You made it.","audio":"https://tatoeba.org/en/audio/download/425169"},{"text":"A ustedes les conocen.","en":"They know you.","audio":"https://tatoeba.org/en/audio/download/501408"},{"text":"¿Ustedes no tienen calor?","en":"Aren't you hot?","audio":"https://tatoeba.org/en/audio/download/440691"},{"text":"Estoy orgulloso de ustedes.","en":"I'm proud of you.","audio":"https://tatoeba.org/en/audio/download/47553"},{"text":"¿Están todos ustedes listos?","en":"Are you all ready?","audio":"https://tatoeba.org/en/audio/download/444160"}]}