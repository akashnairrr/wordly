{"id":"serio","lemma":"serio","pos":"adj","rank":177,"glosses":["serious, earnest, sober, solemn (without humor)","serious, grave, deep (important, weighty)","serious (really intending what was said)"],"ipa":"/ˈseɾjo/","forms":{"feminine":"seria","masculinePlural":"serios","femininePlural":"serias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q1321_%28spa%29-Marreromarco-serio.wav","examples":[{"text":"Lo digo en serio.","en":"I mean it.","audio":"https://tatoeba.org/en/audio/download/438292"},{"text":"Casarse es cosa seria.","en":"Getting married is a serious matter.","audio":"https://tatoeba.org/en/audio/download/735695"},{"text":"Tom tiene serios problemas de salud.","en":"Tom has serious health problems.","audio":"https://tatoeba.org/en/audio/download/354073"},{"text":"Tengo serias dudas al respecto.","en":"I highly doubt that.","audio":"https://tatoeba.org/en/audio/download/101067"},{"text":"No voy en serio.","en":"I'm not serious.","audio":"https://tatoeba.org/en/audio/download/441891"}]}