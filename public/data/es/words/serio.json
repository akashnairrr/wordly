{"id":"serio","lemma":"serio","pos":"adj","rank":175,"glosses":["serious, earnest, sober, solemn (without humor)","serious, grave, deep (important, weighty)","serious (really intending what was said)"],"ipa":"/ˈseɾjo/","forms":{"feminine":"seria","masculinePlural":"serios","femininePlural":"serias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/80/LL-Q1321_%28spa%29-Marreromarco-serio.wav","examples":[{"text":"Tengo un problema serio.","en":"I have a serious problem.","audio":"https://tatoeba.org/en/audio/download/590361","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"problem"},null]},{"text":"¿Es algo serio?","en":"Is it anything serious?","audio":"https://tatoeba.org/en/audio/download/461581","words":[{"g":"to be","l":"ser"},{"g":"something, anything"},null]},{"text":"Ella es una persona seria.","en":"She is a serious person.","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"person (an individual"},null]},{"text":"Parece que es serio.","en":"It seems to be serious.","audio":"https://tatoeba.org/en/audio/download/459798","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to be","l":"ser"},null]},{"text":"Tenemos una situación seria entre manos.","en":"We have a serious situation on our hands.","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"situation"},null,{"g":"between"},{"g":"hand","l":"mano"}]}]}