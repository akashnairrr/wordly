{"id":"si_","lemma":"sí","pos":"pron","rank":24,"glosses":["himself, herself, itself, themself, themselves","yourself, yourselves"],"ipa":"/ˈsi/","audio":"https://upload.wikimedia.org/wikipedia/commons/b/bf/LL-Q1321_%28spa%29-AdrianAbdulBaha-s%C3%AD.wav","examples":[{"text":"Yo decía que sí.","en":"I said yes.","audio":"https://tatoeba.org/en/audio/download/412326"},{"text":"Yo voté que sí.","en":"I voted yes.","audio":"https://tatoeba.org/en/audio/download/586358"},{"text":"Sí que lo quiero.","en":"I do want it.","audio":"https://tatoeba.org/en/audio/download/50537"},{"text":"Sí, me gusta Tom.","en":"I do like Tom.","audio":"https://tatoeba.org/en/audio/download/799795"},{"text":"Sí, tú me gustas.","en":"I do like you.","audio":"https://tatoeba.org/en/audio/download/440189"}]}