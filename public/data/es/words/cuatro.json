{"id":"cuatro","lemma":"cuatro","pos":"noun","rank":295,"glosses":["a four-stringed guitar with the first string a fifth below, instead of a fourth above, the second"],"ipa":"/ˈkwatɾo/","gender":"m","forms":{"plural":"cuatros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Precision27-cuatro.wav","examples":[{"text":"Mi madre tiene cuatro hermanos.","en":"My mother has four brothers.","audio":"https://tatoeba.org/en/audio/download/514792","words":[{"g":"my"},{"g":"mother"},{"g":"to have","l":"tener"},null,{"g":"brother","l":"hermano"}]},{"text":"Mi primo ya tiene cuatro años.","en":"My cousin is already four years old.","audio":"https://tatoeba.org/en/audio/download/687798","words":[{"g":"my"},{"g":"first"},{"g":"now"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Tienes cuatro perros.","en":"You have four dogs.","audio":"https://tatoeba.org/en/audio/download/636446","words":[{"g":"to have","l":"tener"},null,{"g":"dog","l":"perro"}]},{"text":"Dos y dos son cuatro.","en":"Two and two are four.","audio":"https://tatoeba.org/en/audio/download/639332","words":[{"g":"dung, excrement"},{"g":"and"},{"g":"dung, excrement"},{"g":"to be","l":"ser"},null]},{"text":"Cuatro por cinco, veinte.","en":"Four times five is 20.","audio":"https://tatoeba.org/en/audio/download/524958","words":[null,{"g":"for / by"},{"g":"a five"},{"g":"twenty"}]}]}