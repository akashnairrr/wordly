{"id":"cuatro","lemma":"cuatro","pos":"noun","rank":298,"glosses":["a four-stringed guitar with the first string a fifth below, instead of a fourth above, the second"],"ipa":"/ˈkwatɾo/","gender":"m","forms":{"plural":"cuatros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Precision27-cuatro.wav","examples":[{"text":"Cuatro por cinco, veinte.","en":"Four times five is 20.","audio":"https://tatoeba.org/en/audio/download/524958"},{"text":"Estoy de cuatro meses.","en":"I'm four months pregnant.","audio":"https://tatoeba.org/en/audio/download/704516"},{"text":"Él tiene cuatro móviles.","en":"He has four mobile phones.","audio":"https://tatoeba.org/en/audio/download/639831"},{"text":"Tenemos cuatro habitaciones arriba.","en":"We have four bedrooms upstairs.","audio":"https://tatoeba.org/en/audio/download/734492"},{"text":"Un perro tiene cuatro patas.","en":"A dog has four legs.","audio":"https://tatoeba.org/en/audio/download/37961"}]}