{"id":"mato","lemma":"mato","pos":"noun","rank":1716,"glosses":["bushes"],"ipa":"/ˈmato/","gender":"m","forms":{"plural":"matos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a5/LL-Q1321_%28spa%29-Marreromarco-mato.wav","examples":[{"text":"Casi me mato.","en":"I almost got killed.","audio":"https://tatoeba.org/en/audio/download/448219","words":[{"g":"almost"},{"g":"me"},null]},{"text":"Así mato dos pájaros de un tiro.","en":"That way I kill two birds with one stone.","audio":"https://tatoeba.org/en/audio/download/1608","words":[{"g":"like this"},null,{"g":"dung, excrement"},{"g":"bird","l":"pájaro"},{"g":"of / from"},{"g":"a"},{"g":"throw"}]},{"text":"Si no regresas a tiempo a la reunión, te mato.","en":"If you don't make it back in time for the meeting, I'll kill you.","words":[null,null,{"g":"to return","l":"regresar"},null,null,{"g":"to"},{"g":"the / her"},{"g":"meeting"},{"g":"you"},null],"phrases":[[0,2,"if not"],[3,5,"in time"]]}]}