{"id":"imposible","lemma":"imposible","pos":"adj","rank":571,"glosses":["impossible","unable","out of the question"],"ipa":"/impoˈsible/","forms":{"femininePlural":"imposibles"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-AdrianAbdulBaha-imposible.wav","examples":[{"text":"Vivir sin aire es imposible.","en":"To live without air is impossible.","audio":"https://tatoeba.org/en/audio/download/735463","words":[{"g":"to live"},{"g":"without"},{"g":"air"},{"g":"to be","l":"ser"},null]},{"text":"Es imposible para mí.","en":"It's impossible for me.","audio":"https://tatoeba.org/en/audio/download/461603","words":[{"g":"to be","l":"ser"},null,null,null],"phrases":[[2,4,"in my opinion"]]},{"text":"Ahora es imposible salir.","en":"It's impossible to go out now.","audio":"https://tatoeba.org/en/audio/download/519432","words":[{"g":"now"},{"g":"to be","l":"ser"},null,{"g":"to go out"}]},{"text":"Es imposible vivir en esa isla.","en":"It's impossible to live on that island.","audio":"https://tatoeba.org/en/audio/download/599102","words":[{"g":"to be","l":"ser"},null,{"g":"to live"},{"g":"in / on"},{"g":"that","l":"ese"},{"g":"island"}]},{"text":"Habría sido imposible sin tu ayuda.","en":"It would've been impossible without your help.","audio":"https://tatoeba.org/en/audio/download/1153223","words":[{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},null,{"g":"without"},{"g":"your"},{"g":"help, aid"}]}]}