{"id":"alma","lemma":"alma","pos":"noun","rank":651,"glosses":["soul","web (strip of material between flanges)"],"ipa":"/ˈalma/","gender":"f","forms":{"plural":"almas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/43/LL-Q1321_%28spa%29-AdrianAbdulBaha-alma.wav","formAudio":{"almas":"https://upload.wikimedia.org/wikipedia/commons/c/cd/LL-Q1321_%28spa%29-Emanuelps27-almas.wav"},"examples":[{"text":"Tu alma me pertenece.","en":"Your soul belongs to me.","words":[{"g":"your"},null,{"g":"me"},{"g":"to belong","l":"pertenecer"}]},{"text":"No había ni un alma.","en":"Not a soul was to be seen.","words":[{"g":"no / not"},{"g":"makes pluperfect to…"},{"g":"Forms an emphatic…"},{"g":"a"},null]},{"text":"Es un pueblo de tres mil almas.","en":"It's a town of 3,000 people.","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"town, village"},{"g":"of / from"},null,null,null],"phrases":[[4,6,"three thousand"]]},{"text":"Tu alma necesita ser salvada.","en":"Your soul needs to be saved.","audio":"https://tatoeba.org/en/audio/download/642027","words":[{"g":"your"},null,{"g":"to need","l":"necesitar"},{"g":"to be"},{"g":"bran","l":"salvado"}]},{"text":"¿Piensa usted que los animales tienen alma?","en":"Do you think animals have souls?","audio":"https://tatoeba.org/en/audio/download/610872","words":[{"g":"to think, ponder","l":"pensar"},{"g":"you (formal)"},{"g":"that"},{"g":"the / them"},{"g":"animal","l":"animal"},{"g":"to have","l":"tener"},null]}]}