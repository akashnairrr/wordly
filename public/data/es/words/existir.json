{"id":"existir","lemma":"existir","pos":"verb","rank":748,"glosses":["to exist"],"ipa":"/eɡsisˈtiɾ/","conjugation":{"indicative":{"present":{"1s":"existo","2s":"existes","3s":"existe","1p":"existimos","2p":"existís","3p":"existen"},"imperfect":{"1s":"existía","2s":"existías","3s":"existía","1p":"existíamos","2p":"existíais","3p":"existían"},"preterite":{"1s":"existí","2s":"exististe","3s":"existió","1p":"existimos","2p":"exististeis","3p":"existieron"},"future":{"1s":"existiré","2s":"existirás","3s":"existirá","1p":"existiremos","2p":"existiréis","3p":"existirán"},"conditional":{"1s":"existiría","2s":"existirías","3s":"existiría","1p":"existiríamos","2p":"existiríais","3p":"existirían"}},"subjunctive":{"present":{"1s":"exista","2s":"existas","3s":"exista","1p":"existamos","2p":"existáis","3p":"existan"},"imperfect":{"1s":"existiera","2s":"existieras","3s":"existiera","1p":"existiéramos","2p":"existierais","3p":"existieran"}},"imperative":{"affirmative":{"2s":"existe","3s":"exista","1p":"existamos","2p":"existid","3p":"existan"},"negative":{"2s":"existas","3s":"exista","1p":"existamos","2p":"existáis","3p":"existan"}}},"nonFinite":{"gerund":"existiendo","participle":"existido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-AdrianAbdulBaha-existir.wav","examples":[{"text":"Sin agua no podemos existir.","en":"Without water, we cannot exist.","audio":"https://tatoeba.org/en/audio/download/833033"},{"text":"Tiene que haber existido un acuerdo tácito entre ellos.","en":"There must've been a tacit understanding between them.","audio":"https://tatoeba.org/en/audio/download/422647"},{"text":"Tom ni siquiera sabe que existo.","en":"Tom doesn't even know I exist."},{"text":"La suerte no existe.","en":"Luck doesn't exist.","audio":"https://tatoeba.org/en/audio/download/799820"},{"text":"Los fantasmas no existen.","en":"Ghosts don't exist.","audio":"https://tatoeba.org/en/audio/download/636932"}]}