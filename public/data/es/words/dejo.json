{"id":"dejo","lemma":"dejo","pos":"noun","rank":889,"glosses":["accent","aftertaste","end, finish, termination"],"ipa":"/ˈdexo/","gender":"m","forms":{"plural":"dejos"},"examples":[{"text":"Yo lo dejo caer.","en":"I let it fall.","audio":"https://tatoeba.org/en/audio/download/440315"},{"text":"Yo los dejo ir.","en":"I let them go.","audio":"https://tatoeba.org/en/audio/download/440317"},{"text":"Yo te dejo ganar.","en":"I let you win.","audio":"https://tatoeba.org/en/audio/download/440319"},{"text":"Dejo entrar al gato.","en":"I let the cat in.","audio":"https://tatoeba.org/en/audio/download/68494"},{"text":"Lo dejo para ti.","en":"I'm leaving it to you.","audio":"https://tatoeba.org/en/audio/download/461023"}]}