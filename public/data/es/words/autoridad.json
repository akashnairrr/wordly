{"id":"autoridad","lemma":"autoridad","pos":"noun","rank":1781,"glosses":["authority (the power to enforce rules or give orders)","authority (persons in command)","authority (a person accepted as a source of reliable information on a subject)"],"ipa":"/autoɾiˈdad/","gender":"f","forms":{"plural":"autoridades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9e/LL-Q1321_%28spa%29-AdrianAbdulBaha-autoridad.wav","formAudio":{"autoridades":"https://upload.wikimedia.org/wikipedia/commons/7/71/LL-Q1321_%28spa%29-Precision27-autoridades.wav"},"examples":[{"text":"No tengo autoridad para darte permiso.","en":"I don't have the authority to give you permission.","audio":"https://tatoeba.org/en/audio/download/538255","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"for"},{"g":"to give, to give out","l":"dar"},{"g":"permission"}]},{"text":"Han dado parte a las autoridades.","en":"They reported it to the authorities.","words":[{"g":"to have","l":"haber"},{"g":"a die or dice"},{"g":"part"},{"g":"to"},{"g":"the / them"},null]},{"text":"Él abusa de su autoridad.","en":"He abuses his authority.","audio":"https://tatoeba.org/en/audio/download/461459","words":[{"g":"he"},{"g":"to abuse, to betray","l":"abusar"},{"g":"of / from"},{"g":"his / her / your"},null]},{"text":"Es una autoridad en su campo.","en":"She is a leader in her field.","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"in / on"},{"g":"his / her / your"},{"g":"countryside, country"}]},{"text":"Tú estás sin autoridad.","en":"You're powerless.","audio":"https://tatoeba.org/en/audio/download/443686","words":[{"g":"you"},{"g":"to be","l":"estar"},{"g":"without"},null]}]}