{"id":"todavi_a","lemma":"todavía","pos":"adv","rank":198,"glosses":["still, yet","even, still"],"ipa":"/todaˈbia/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-AdrianAbdulBaha-todav%C3%ADa.wav","examples":[{"text":"Todavía no lo sé.","en":"I don't know yet.","audio":"https://tatoeba.org/en/audio/download/442391"},{"text":"¿Está Tom despierto todavía?","en":"Is Tom awake yet?","audio":"https://tatoeba.org/en/audio/download/800181"},{"text":"Todavía no está seco.","en":"It's not dry yet.","audio":"https://tatoeba.org/en/audio/download/586169"},{"text":"Todavía no puedes irte.","en":"You can't go yet.","audio":"https://tatoeba.org/en/audio/download/443810"},{"text":"Él está enfadado todavía.","en":"He is still angry.","audio":"https://tatoeba.org/en/audio/download/444097"}]}