{"id":"decente","lemma":"decente","pos":"adj","rank":1998,"glosses":["decent (showing integrity and moral uprightness)","decent (good enough; okay)","clean, tidy"],"ipa":"/deˈθente/","forms":{"femininePlural":"decentes"},"examples":[{"text":"Mary, ¿estás decente?","en":"Mary, are you decent?","audio":"https://tatoeba.org/en/audio/download/557862","words":[null,{"g":"to be","l":"estar"},null]},{"text":"Tom parece un tipo decente, ¿no?","en":"Tom is very dependable, isn't he?","audio":"https://tatoeba.org/en/audio/download/801379","words":[null,{"g":"to seem, to see fit","l":"parecer"},{"g":"a"},{"g":"kind"},null,{"g":"no / not"}]},{"text":"Creo que son personas decentes.","en":"I think they're honest people.","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"person (an individual","l":"persona"},null]},{"text":"Tom es del tipo de gente decente.","en":"Tom is a decent sort of guy.","audio":"https://tatoeba.org/en/audio/download/306290","words":[null,{"g":"to be","l":"ser"},{"g":"of the"},{"g":"kind"},{"g":"of / from"},{"g":"people"},null]},{"text":"No tengo un vestido decente para tal ocasión.","en":"I don't have a dress good enough for such an occasion.","audio":"https://tatoeba.org/en/audio/download/635538","words":[{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"a"},{"g":"dressed"},null,{"g":"for"},{"g":"such"},{"g":"occasion"}]}]}