{"id":"motor","lemma":"motor","pos":"noun","rank":1461,"glosses":["motor (mechanical device)","engine","driving force, driver, mover"],"ipa":"/moˈtoɾ/","gender":"m","forms":{"plural":"motores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q1321_%28spa%29-AdrianAbdulBaha-motor.wav","examples":[{"text":"El motor se detuvo.","en":"The engine died.","audio":"https://tatoeba.org/en/audio/download/442036"},{"text":"Todos los motores están en buen estado.","en":"All the engines are in good condition.","audio":"https://tatoeba.org/en/audio/download/915887"},{"text":"El motor no arranca.","en":"The engine won't start.","audio":"https://tatoeba.org/en/audio/download/461349"},{"text":"Armo motores de auto.","en":"I assemble car engines."},{"text":"Este motor anda bien.","en":"This engine works well.","audio":"https://tatoeba.org/en/audio/download/461084"}]}