{"id":"paciente","lemma":"paciente","pos":"adj","rank":811,"glosses":["patient"],"ipa":"/paˈθjente/","forms":{"femininePlural":"pacientes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1321_%28spa%29-Marreromarco-paciente.wav","examples":[{"text":"Soy un hombre paciente.","en":"I'm a patient man.","audio":"https://tatoeba.org/en/audio/download/122947"},{"text":"Tenemos que ser pacientes.","en":"We have to be patient.","audio":"https://tatoeba.org/en/audio/download/195436"},{"text":"No soy ningún paciente.","en":"I'm not a patient.","audio":"https://tatoeba.org/en/audio/download/443605"},{"text":"Tres pacientes murieron anoche.","en":"Three patients died last night.","audio":"https://tatoeba.org/en/audio/download/585884"},{"text":"Él era muy paciente.","en":"He was very patient.","audio":"https://tatoeba.org/en/audio/download/450535"}]}