{"id":"pelirrojo","lemma":"pelirrojo","pos":"adj","rank":4587,"glosses":["redheaded"],"ipa":"/peliˈroxo/","forms":{"feminine":"pelirroja","masculinePlural":"pelirrojos","femininePlural":"pelirrojas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/70/LL-Q1321_%28spa%29-AdrianAbdulBaha-pelirrojo.wav","examples":[{"text":"Hoy Tom es pelirrojo.","en":"Tom has red hair today.","words":[{"g":"today, tonight"},null,{"g":"to be","l":"ser"},null]},{"text":"A Tom le gustan las pelirrojas.","en":"Tom likes redheads.","words":[{"g":"to"},null,{"g":"him / her"},{"g":"to like in a general…","l":"gustar"},{"g":"the / them"},null]},{"text":"Los pelirrojos comúnmente tienen pecas.","en":"Redheads often have freckles.","words":[{"g":"the / them"},null,{"g":"commonly"},{"g":"to have","l":"tener"},{"g":"freckle","l":"peca"}]},{"text":"Ese vestido combina con su cabello pelirrojo.","en":"That dress matches her red hair.","words":[{"g":"that"},{"g":"dressed"},{"g":"to combine","l":"combinar"},{"g":"with"},{"g":"his / her / your"},{"g":"hair"},null]},{"text":"Los pelirrojos tienden a tener pecas.","en":"Red-haired people tend to have freckles.","words":[{"g":"the / them"},null,{"g":"to tend to","l":"tender"},{"g":"to"},{"g":"to have"},{"g":"freckle","l":"peca"}]}]}