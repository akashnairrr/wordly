{"id":"interesado","lemma":"interesado","pos":"adj","rank":1499,"glosses":["interested","acquisitive, grabby","opportunistic"],"ipa":"/inteɾeˈsado/","forms":{"feminine":"interesada","masculinePlural":"interesados","femininePlural":"interesadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-Emanuelps27-interesado.wav","examples":[{"text":"Tom no parece interesado.","en":"Tom doesn't seem interested.","audio":"https://tatoeba.org/en/audio/download/306309"},{"text":"Está interesada en la música.","en":"She is interested in music.","audio":"https://tatoeba.org/en/audio/download/639617"},{"text":"Tus amigos están muy interesados por tu salud.","en":"Your friends are really concerned about your health.","audio":"https://tatoeba.org/en/audio/download/553930"},{"text":"Estoy interesado en el inglés.","en":"I am interested in English.","audio":"https://tatoeba.org/en/audio/download/639935"},{"text":"Sé que tengo una opinión interesada.","en":"I know I have a biased opinion.","audio":"https://tatoeba.org/en/audio/download/297776"}]}