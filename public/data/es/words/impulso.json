{"id":"impulso","lemma":"impulso","pos":"noun","rank":3073,"glosses":["drive, urge","impulse, pulse"],"ipa":"/imˈpulso/","gender":"m","forms":{"plural":"impulsos"},"order":3078,"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-impulso.wav","examples":[{"text":"Tengo un impulso de comprar algo.","en":"I have an urge to buy something.","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"of / from"},{"g":"to buy"},{"g":"something, anything"}]},{"text":"Empezó con mucho impulso.","en":"He got off to a flying start.","words":[{"g":"to start","l":"empezar"},null,null,null],"phrases":[[1,3,"by far"]]},{"text":"No pude resistir el impulso de aplaudir.","en":"I couldn't resist the urge to applaud.","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to tolerate"},{"g":"the"},null,{"g":"of / from"},{"g":"to applaud"}]}]}