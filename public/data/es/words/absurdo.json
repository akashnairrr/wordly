{"id":"absurdo","lemma":"absurdo","pos":"adj","rank":2226,"glosses":["absurd, preposterous, ludicrous, ridiculous"],"ipa":"/abˈsuɾdo/","forms":{"feminine":"absurda","masculinePlural":"absurdos","femininePlural":"absurdas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-AdrianAbdulBaha-absurdo.wav","examples":[{"text":"Eso es absurdo.","en":"That's absurd.","audio":"https://tatoeba.org/en/audio/download/501280","words":[null,null,null],"phrases":[[0,2,"that's it"]]},{"text":"No seas absurda.","en":"Don't be absurd.","audio":"https://tatoeba.org/en/audio/download/441516","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Suena absurdo.","en":"That sounds absurd.","audio":"https://tatoeba.org/en/audio/download/732417","words":[{"g":"to sound, to ring","l":"sonar"},null]},{"text":"¡Pero qué absurda idea!","en":"What an absurd idea!","audio":"https://tatoeba.org/en/audio/download/734385","words":[{"g":"but"},{"g":"what"},null,{"g":"idea"}]},{"text":"Las reglas son absurdas.","en":"The rules are absurd.","words":[{"g":"the / them"},{"g":"rule","l":"regla"},{"g":"to be","l":"ser"},null]}]}