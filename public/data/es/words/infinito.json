{"id":"infinito","lemma":"infinito","pos":"adj","rank":4324,"glosses":["infinite","unlimited, boundless, unbounded","endless, countless"],"ipa":"/infiˈnito/","forms":{"feminine":"infinita","masculinePlural":"infinitos","femininePlural":"infinitas"},"order":4325,"audio":"https://upload.wikimedia.org/wikipedia/commons/9/99/LL-Q1321_%28spa%29-Marreromarco-infinito.wav","examples":[{"text":"El universo es infinito.","en":"The universe is endless.","audio":"https://tatoeba.org/en/audio/download/639240","words":[{"g":"the"},{"g":"universe"},{"g":"to be","l":"ser"},null]},{"text":"No puedo esperar hasta el infinito.","en":"I can't wait forever.","audio":"https://tatoeba.org/en/audio/download/454607","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to hope"},{"g":"until"},{"g":"the"},null]},{"text":"Las posibilidades son infinitas.","en":"The possibilities are endless.","words":[{"g":"the / them"},{"g":"possibility","l":"posibilidad"},{"g":"to be","l":"ser"},null]}]}