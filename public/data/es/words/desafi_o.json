{"id":"desafi_o","lemma":"desafío","pos":"noun","rank":1810,"glosses":["challenge","defiance, provocation"],"ipa":"/desaˈfio/","gender":"m","forms":{"plural":"desafíos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/42/LL-Q1321_%28spa%29-Marreromarco-desaf%C3%ADo.wav","examples":[{"text":"Yo aprecio un desafío.","en":"I enjoy a challenge.","audio":"https://tatoeba.org/en/audio/download/449530"},{"text":"Te desafío a hacerlo público.","en":"I defy you to make it public.","audio":"https://tatoeba.org/en/audio/download/693066"},{"text":"Te desafío a que intentes pararme.","en":"I dare you to try to stop me.","audio":"https://tatoeba.org/en/audio/download/333159"},{"text":"Yo considero a los obstáculos como un desafío.","en":"I see obstacles as challenges.","audio":"https://tatoeba.org/en/audio/download/65078"},{"text":"Este es un desafío.","en":"This is a challenge."}]}