{"id":"taxi","lemma":"taxi","pos":"noun","rank":974,"glosses":["taxi"],"ipa":"/ˈtaɡsi/","gender":"m","forms":{"plural":"taxis"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-taxi.wav","examples":[{"text":"Él me consiguió un taxi.","en":"He found me a taxi.","audio":"https://tatoeba.org/en/audio/download/515029","words":[{"g":"he"},{"g":"me"},{"g":"to achieve","l":"conseguir"},{"g":"a"},null]},{"text":"Haga usted el favor de llamar un taxi.","en":"Please call a taxi.","audio":"https://tatoeba.org/en/audio/download/449355","words":[{"g":"to do","l":"hacer"},{"g":"you (formal)"},{"g":"the"},null,null,{"g":"to summon, to call"},{"g":"a"},null],"phrases":[[3,5,"please"]]},{"text":"Yo no uso taxis, a menos que sea absolutamente necesario.","en":"I don't use taxis unless it's absolutely necessary.","audio":"https://tatoeba.org/en/audio/download/65191","words":[{"g":"I"},{"g":"no / not"},{"g":"use"},null,null,null,null,{"g":"to be","l":"ser"},{"g":"absolutely"},{"g":"necessary, requisite"}],"phrases":[[4,7,"unless"]]},{"text":"Te llamaré un taxi.","en":"I'll call you a cab.","audio":"https://tatoeba.org/en/audio/download/449709","words":[{"g":"you"},{"g":"to summon, to call","l":"llamar"},{"g":"a"},null]},{"text":"Tuve que caminar porque no había taxis.","en":"Since there were no taxis, I had to walk.","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to walk"},{"g":"because"},{"g":"no / not"},{"g":"makes pluperfect to…"},null]}]}