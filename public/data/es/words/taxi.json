{"id":"taxi","lemma":"taxi","pos":"noun","rank":977,"glosses":["taxi"],"ipa":"/ˈtaɡsi/","gender":"m","forms":{"plural":"taxis"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-AdrianAbdulBaha-taxi.wav","examples":[{"text":"Tomás necesita un taxi.","en":"Tom needs a cab.","audio":"https://tatoeba.org/en/audio/download/442173"},{"text":"Yo no uso taxis, a menos que sea absolutamente necesario.","en":"I don't use taxis unless it's absolutely necessary.","audio":"https://tatoeba.org/en/audio/download/65191"},{"text":"Hay un taxi esperando.","en":"A cab is waiting.","audio":"https://tatoeba.org/en/audio/download/443097"},{"text":"¿Por qué suelen ser amarillos los taxis?","en":"Why are taxis usually yellow?"},{"text":"Te llamaré un taxi.","en":"I'll call you a cab.","audio":"https://tatoeba.org/en/audio/download/449709"}]}