{"id":"quieto","lemma":"quieto","pos":"adj","rank":1378,"glosses":["calm","still"],"ipa":"/ˈkjeto/","forms":{"feminine":"quieta","masculinePlural":"quietos","femininePlural":"quietas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-quieto.wav","examples":[{"text":"Siéntate y quédate quieto.","en":"Sit still.","audio":"https://tatoeba.org/en/audio/download/438995"},{"text":"Ella se quedó quieta.","en":"She kept quiet.","audio":"https://tatoeba.org/en/audio/download/441122"},{"text":"¡Quédense quietos! El bebé está durmiendo.","en":"Keep quiet. The baby is sleeping."},{"text":"Ten las manos quietas.","en":"Keep your hands to yourself.","audio":"https://tatoeba.org/en/audio/download/586914"},{"text":"Quédate quieto un momento.","en":"Be quiet for a moment.","audio":"https://tatoeba.org/en/audio/download/453609"}]}