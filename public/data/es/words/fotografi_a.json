{"id":"fotografi_a","lemma":"fotografía","pos":"noun","rank":1807,"glosses":["photograph","photography"],"ipa":"/fotoɡɾaˈfia/","gender":"f","forms":{"plural":"fotografías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f9/LL-Q1321_%28spa%29-AdrianAbdulBaha-fotograf%C3%ADa.wav","examples":[{"text":"Ella tiene una fotografía.","en":"She has a picture.","audio":"https://tatoeba.org/en/audio/download/444321"},{"text":"Estaba viendo fotografías viejas.","en":"I was looking at old pictures.","audio":"https://tatoeba.org/en/audio/download/734449"},{"text":"Me gusta mucho esta fotografía.","en":"I really like this picture.","audio":"https://tatoeba.org/en/audio/download/731444"},{"text":"Mi pasatiempo es tomar fotografías.","en":"My hobby is taking pictures.","audio":"https://tatoeba.org/en/audio/download/537842"},{"text":"¿Me puedo quedar esta fotografía?","en":"May I keep this photograph?","audio":"https://tatoeba.org/en/audio/download/582094"}]}