{"id":"tira","lemma":"tira","pos":"noun","rank":1548,"glosses":["tie, ribbon","strip","ages; yonks"],"ipa":"/ˈtiɾa/","gender":"f","forms":{"plural":"tiras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ca/LL-Q1321_%28spa%29-Marreromarco-tira.wav","examples":[{"text":"Tira una moneda al aire.","en":"Flip a coin.","audio":"https://tatoeba.org/en/audio/download/501725"},{"text":"Ve cortando la carne en tiras.","en":"Cut the meat into strips.","audio":"https://tatoeba.org/en/audio/download/451180"},{"text":"Sólo tira de la cadena.","en":"Just flush the toilet.","audio":"https://tatoeba.org/en/audio/download/302008"},{"text":"Él hizo tiras las fotos.","en":"He tore the photographs into pieces."},{"text":"Por favor, tira de la cuerda.","en":"Please pull the rope.","audio":"https://tatoeba.org/en/audio/download/821229"}]}