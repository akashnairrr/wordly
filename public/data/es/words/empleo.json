{"id":"empleo","lemma":"empleo","pos":"noun","rank":1442,"glosses":["job, employment","use, application"],"ipa":"/emˈpleo/","gender":"m","forms":{"plural":"empleos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-Marreromarco-empleo.wav","examples":[{"text":"Él está buscando empleo.","en":"He is after a job.","audio":"https://tatoeba.org/en/audio/download/444220"},{"text":"Los trabajadores perdieron sus empleos.","en":"Workers lost their jobs."},{"text":"Tengo un buen empleo.","en":"I have a good job.","audio":"https://tatoeba.org/en/audio/download/443875"},{"text":"La inversión del gobierno creará muchos empleos.","en":"The government's investment will create many jobs."},{"text":"Él cambió de empleo.","en":"He changed his job.","audio":"https://tatoeba.org/en/audio/download/450368"}]}