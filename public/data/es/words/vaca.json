{"id":"vaca","lemma":"vaca","pos":"noun","rank":1983,"glosses":["cow (adult female of the species Bos taurus)","beef","leather"],"ipa":"/ˈbaka/","gender":"f","forms":{"plural":"vacas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/58/LL-Q1321_%28spa%29-Millars-vaca.wav","examples":[{"text":"Tom tiene una vaca.","en":"Tom has a cow.","audio":"https://tatoeba.org/en/audio/download/799340"},{"text":"Las vacas comen pasto.","en":"Cows eat grass.","audio":"https://tatoeba.org/en/audio/download/440604"},{"text":"Aprendí a ordeñar una vaca.","en":"I learned to milk a cow.","audio":"https://tatoeba.org/en/audio/download/83164"},{"text":"Las vacas dan leche.","en":"Cows give milk.","audio":"https://tatoeba.org/en/audio/download/636422"},{"text":"¿Es esto una vaca o un búfalo?","en":"Is that a cow or a buffalo?","audio":"https://tatoeba.org/en/audio/download/704685"}]}