{"id":"disponible","lemma":"disponible","pos":"adj","rank":1867,"glosses":["available"],"ipa":"/dispoˈnible/","forms":{"femininePlural":"disponibles"},"examples":[{"text":"Estoy disponible esta noche.","en":"I'm free tonight.","audio":"https://tatoeba.org/en/audio/download/64567"},{"text":"¿Qué alternativas de pago están disponibles?","en":"What payment options are available?"},{"text":"¿Queda aún algún asiento disponible?","en":"Are any seats still available?","audio":"https://tatoeba.org/en/audio/download/704036"},{"text":"Hay 250 copias disponibles de nuestra tienda oficial.","en":"250 copies are available from our official shop."},{"text":"El médico no está disponible.","en":"The doctor isn't available now.","audio":"https://tatoeba.org/en/audio/download/929010"}]}