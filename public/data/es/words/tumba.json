{"id":"tumba","lemma":"tumba","pos":"noun","rank":1388,"glosses":["grave, tomb"],"ipa":"/ˈtumba/","gender":"f","forms":{"plural":"tumbas"},"order":1461,"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-AdrianAbdulBaha-tumba.wav","examples":[{"text":"Ellos cavaron una tumba.","en":"They dug a grave.","audio":"https://tatoeba.org/en/audio/download/443939","words":[{"g":"they","l":"él"},{"g":"to excavate, dig","l":"cavar"},{"g":"a"},null]},{"text":"Él está cavando su propia tumba.","en":"He's digging his own grave.","audio":"https://tatoeba.org/en/audio/download/1190575","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"to excavate, dig","l":"cavar"},{"g":"his / her / your"},{"g":"own","l":"propio"},null]},{"text":"Visité la tumba de mi padre.","en":"I visited my father's grave.","words":[{"g":"to visit","l":"visitar"},{"g":"the / her"},null,{"g":"of / from"},{"g":"my"},{"g":"father, parent"}]}]}