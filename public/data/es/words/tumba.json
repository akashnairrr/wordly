{"id":"tumba","lemma":"tumba","pos":"noun","rank":1390,"glosses":["grave, tomb"],"ipa":"/ˈtumba/","gender":"f","forms":{"plural":"tumbas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-AdrianAbdulBaha-tumba.wav","examples":[{"text":"Ellos cavaron una tumba.","en":"They dug a grave.","audio":"https://tatoeba.org/en/audio/download/443939"},{"text":"Está cavando su propia tumba.","en":"He's digging his own grave.","audio":"https://tatoeba.org/en/audio/download/639109"},{"text":"Tom visitó la tumba de Mary.","en":"Tom visited Mary's grave.","audio":"https://tatoeba.org/en/audio/download/104566"},{"text":"Él está cavando su propia tumba.","en":"He's digging his own grave.","audio":"https://tatoeba.org/en/audio/download/1190575"},{"text":"Tom tiene un pie en la tumba.","en":"Tom has one foot in the grave.","audio":"https://tatoeba.org/en/audio/download/801274"}]}