{"id":"fa_cilmente","lemma":"fácilmente","pos":"adv","rank":1642,"glosses":["easily"],"ipa":"/ˌfaθilˈmente/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/1b/LL-Q1321_%28spa%29-Marreromarco-f%C3%A1cilmente.wav","examples":[{"text":"Yo no lloro fácilmente.","en":"I don't cry easily.","audio":"https://tatoeba.org/en/audio/download/39242"},{"text":"Yo me enojo fácilmente.","en":"I get angry easily.","audio":"https://tatoeba.org/en/audio/download/450752"},{"text":"Él se cansa fácilmente.","en":"He gets tired easily.","audio":"https://tatoeba.org/en/audio/download/35903"},{"text":"No me ofendo fácilmente.","en":"I'm not easily offended.","audio":"https://tatoeba.org/en/audio/download/518844"},{"text":"Encontré fácilmente su casa.","en":"I found his house easily.","audio":"https://tatoeba.org/en/audio/download/932996"}]}