{"id":"alivio","lemma":"alivio","pos":"noun","rank":2627,"glosses":["relief"],"ipa":"/aˈlibjo/","gender":"m","forms":{"plural":"alivios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q1321_%28spa%29-Marreromarco-alivio.wav","examples":[{"text":"Eso es un alivio.","en":"That's a relief.","audio":"https://tatoeba.org/en/audio/download/442031","words":[null,null,{"g":"a"},null],"phrases":[[0,2,"that's it"]]},{"text":"¡Qué alivio!","en":"What a relief!","audio":"https://tatoeba.org/en/audio/download/442990","words":[{"g":"what"},null]},{"text":"Ella dio un suspiro de alivio.","en":"She gave out a sigh of relief.","words":[{"g":"she"},{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"to sigh","l":"suspirar"},{"g":"of / from"},null]},{"text":"Su madre suspiró de alivio.","en":"His mother sighed with relief.","words":[{"g":"his / her / your"},{"g":"mother"},null,{"g":"of / from"},null]},{"text":"Para mi alivio, vino a casa sano y salvo.","en":"To my relief, he came home safe and sound.","audio":"https://tatoeba.org/en/audio/download/693423","words":[{"g":"for"},{"g":"my"},null,{"g":"to come","l":"venir"},null,null,null,null,null],"phrases":[[4,6,"home"],[6,9,"safe and sound"]]}]}