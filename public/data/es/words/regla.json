{"id":"regla","lemma":"regla","pos":"noun","rank":826,"glosses":["rule (regulation, norm)","ruler (measuring stick)","menstruation, period"],"ipa":"/ˈreɡla/","gender":"f","forms":{"plural":"reglas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a3/LL-Q1321_%28spa%29-AdrianAbdulBaha-regla.wav","examples":[{"text":"¿Conoces las reglas del juego?","en":"Do you know the rules of the game?","audio":"https://tatoeba.org/en/audio/download/733297","words":[{"g":"to know","l":"conocer"},{"g":"the / them"},null,{"g":"of the"},{"g":"play"}]},{"text":"Necesito una regla.","en":"I need a ruler.","audio":"https://tatoeba.org/en/audio/download/152862","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null]},{"text":"Recuerda esta regla.","en":"Remember this rule.","audio":"https://tatoeba.org/en/audio/download/448930","words":[{"g":"to remember","l":"recordar"},{"g":"this","l":"este"},null]},{"text":"Las reglas han cambiado.","en":"The rules have changed.","audio":"https://tatoeba.org/en/audio/download/460972","words":[{"g":"the / them"},null,{"g":"to have","l":"haber"},{"g":"changed"}]},{"text":"Tenemos reglas.","en":"We have rules.","audio":"https://tatoeba.org/en/audio/download/443284","words":[{"g":"to have","l":"tener"},null]}]}