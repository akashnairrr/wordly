{"id":"tiro","lemma":"tiro","pos":"noun","rank":1068,"glosses":["throw (the act of throwing something)","shot; gunshot (the result of launching a projectile or bullet)","range (the distance from a person or sensor to an object)"],"ipa":"/ˈtiɾo/","gender":"m","forms":{"plural":"tiros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-Marreromarco-tiro.wav","examples":[{"text":"¡Buen tiro!","en":"Nice shot!","audio":"https://tatoeba.org/en/audio/download/438940","words":[null,null]},{"text":"Te pego un tiro.","en":"I'll shoot you.","audio":"https://tatoeba.org/en/audio/download/440796","words":[{"g":"you"},{"g":"a trick consisting of…"},{"g":"a"},null]},{"text":"Oímos tiros.","en":"We heard gunfire.","audio":"https://tatoeba.org/en/audio/download/412481","words":[{"g":"to hear","l":"oír"},null]},{"text":"¿Alguien escuchó el tiro?","en":"Did anyone hear the gun shot?","audio":"https://tatoeba.org/en/audio/download/582415","words":[{"g":"someone, somebody"},{"g":"to listen to","l":"escuchar"},{"g":"the"},null]},{"text":"Escucharon tiros.","en":"They heard gunfire.","audio":"https://tatoeba.org/en/audio/download/415787","words":[{"g":"to listen to","l":"escuchar"},null]}]}