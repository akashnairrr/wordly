{"id":"tiro","lemma":"tiro","pos":"noun","rank":1068,"glosses":["throw (the act of throwing something)","shot; gunshot (the result of launching a projectile or bullet)","range (the distance from a person or sensor to an object)"],"ipa":"/ˈtiɾo/","gender":"m","forms":{"plural":"tiros"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-Marreromarco-tiro.wav","examples":[{"text":"¡Qué buen tiro!","en":"What a good shot!","words":[{"g":"what"},null,null]},{"text":"Fue sólo un tiro en la oscuridad.","en":"It was just a shot in the dark.","words":[{"g":"to be","l":"ser"},null,{"g":"a"},null,{"g":"in / on"},{"g":"the / her"},{"g":"darkness"}]},{"text":"Oímos tiros.","en":"We heard gunfire.","audio":"https://tatoeba.org/en/audio/download/412481","words":[{"g":"to hear","l":"oír"},null]},{"text":"¿Alguien escuchó el tiro?","en":"Did anyone hear the gun shot?","audio":"https://tatoeba.org/en/audio/download/582415","words":[{"g":"someone, somebody"},{"g":"to listen to","l":"escuchar"},{"g":"the"},null]},{"text":"Te pego un tiro.","en":"I'll shoot you.","audio":"https://tatoeba.org/en/audio/download/440796","words":[{"g":"you"},{"g":"a trick consisting of…"},{"g":"a"},null]}]}