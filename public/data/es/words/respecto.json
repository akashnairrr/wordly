{"id":"respecto","lemma":"respecto","pos":"noun","rank":786,"glosses":["respect, regard, connection, relation, relationship"],"ipa":"/resˈpeɡto/","gender":"m","forms":{"plural":"respectos"},"examples":[{"text":"Déjame pensar al respecto.","en":"Let me think about it.","audio":"https://tatoeba.org/en/audio/download/461773"},{"text":"Él bromeó al respecto.","en":"He made a joke about it.","audio":"https://tatoeba.org/en/audio/download/1191464"},{"text":"¿Qué opináis al respecto?","en":"What do you think about it?","audio":"https://tatoeba.org/en/audio/download/915961"},{"text":"¿Qué puedo hacer al respecto?","en":"What can I do?","audio":"https://tatoeba.org/en/audio/download/768087"},{"text":"Tengo serias dudas al respecto.","en":"I highly doubt that.","audio":"https://tatoeba.org/en/audio/download/101067"}]}