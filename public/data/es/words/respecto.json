{"id":"respecto","lemma":"respecto","pos":"noun","rank":783,"glosses":["respect, regard, connection, relation, relationship"],"ipa":"/resˈpeɡto/","gender":"m","forms":{"plural":"respectos"},"examples":[{"text":"¿Qué puedo hacer al respecto?","en":"What can I do?","audio":"https://tatoeba.org/en/audio/download/768087","words":[{"g":"what"},{"g":"to be able to, can","l":"poder"},{"g":"to do"},{"g":"to the"},null]},{"text":"Quizá deberíamos hacer algo al respecto.","en":"Perhaps we should do something about it.","audio":"https://tatoeba.org/en/audio/download/609989","words":[{"g":"perhaps, maybe"},{"g":"to owe","l":"deber"},{"g":"to do"},{"g":"something, anything"},{"g":"to the"},null]},{"text":"Quiero ser claro al respecto.","en":"I want to be clear about that.","audio":"https://tatoeba.org/en/audio/download/642338","words":[{"g":"to desire","l":"querer"},{"g":"to be"},{"g":"clear"},{"g":"to the"},null]},{"text":"No podemos hacer nada al respecto.","en":"We can do nothing about it.","audio":"https://tatoeba.org/en/audio/download/600103","words":[{"g":"no / not"},{"g":"to prune","l":"podar"},{"g":"to do"},{"g":"nothing"},{"g":"to the"},null]},{"text":"Déjame pensar al respecto.","en":"Let me think about it.","audio":"https://tatoeba.org/en/audio/download/461773","words":[{"g":"to leave","l":"dejar"},{"g":"to think, ponder"},{"g":"to the"},null]}]}