{"id":"batalla","lemma":"batalla","pos":"noun","rank":895,"glosses":["battle"],"ipa":"/baˈtaʝa/","gender":"f","forms":{"plural":"batallas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Eavqwiki-batalla.wav","formAudio":{"batallas":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-Eavqwiki-batallas.wav"},"examples":[{"text":"Fue herido en la batalla.","en":"He was wounded in the battle.","audio":"https://tatoeba.org/en/audio/download/531848","words":[{"g":"to be","l":"ser"},{"g":"hurt, injured"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Oí el sonido de la batalla.","en":"I heard the sound of battle.","words":[{"g":"to hear","l":"oír"},{"g":"the"},{"g":"sound, noise"},null,null,null],"phrases":[[3,5,"of the"]]},{"text":"Yo solo puedo pelear mis batallas.","en":"I can fight my battles myself.","words":[{"g":"I"},{"g":"sole"},{"g":"to be able to, can","l":"poder"},{"g":"to fight"},{"g":"my"},null]},{"text":"Nuestro hijo murió en batalla.","en":"Our son was killed in action.","words":[{"g":"our, ours, to us"},{"g":"son"},{"g":"to die","l":"morir"},{"g":"in / on"},null]},{"text":"Puedes ganar todas las batallas, pero perder la guerra.","en":"You can win all the battles yet lose the war.","audio":"https://tatoeba.org/en/audio/download/606735","words":[{"g":"to be able to, can","l":"poder"},{"g":"to gain"},{"g":"all","l":"todo"},{"g":"the / them"},null,{"g":"but"},{"g":"to lose"},{"g":"the / her"},{"g":"war, warfare"}]}]}