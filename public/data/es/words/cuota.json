{"id":"cuota","lemma":"cuota","pos":"noun","rank":4944,"glosses":["quota","installment (portion of debt)"],"ipa":"/ˈkwota/","gender":"f","forms":{"plural":"cuotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ea/LL-Q1321_%28spa%29-Marreromarco-cuota.wav","examples":[{"text":"¿Has terminado tu cuota del trabajo?","en":"Have you finished your share of the work?","audio":"https://tatoeba.org/en/audio/download/634812","words":[{"g":"to have","l":"haber"},{"g":"finished"},{"g":"your"},null,{"g":"of the"},{"g":"work, job"}]},{"text":"Tuvo su cuota de suerte.","en":"He had his share of luck.","audio":"https://tatoeba.org/en/audio/download/805950","words":[{"g":"to have","l":"tener"},{"g":"his / her / your"},null,{"g":"of / from"},{"g":"luck, fortune"}]},{"text":"No puedo permitirme la cuota.","en":"I can't afford the fees.","audio":"https://tatoeba.org/en/audio/download/523501","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to allow, permit","l":"permitir"},{"g":"the / her"},null]},{"text":"Las cuotas son recaudadas en Octubre.","en":"Dues are collected in October.","audio":"https://tatoeba.org/en/audio/download/804356","words":[{"g":"the / them"},null,{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"October"}]},{"text":"No hay cuota de admisión para los niños menores de cinco años.","en":"There is no admission fee for children under five.","audio":"https://tatoeba.org/en/audio/download/515889","words":[{"g":"no / not"},{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"admittance"},{"g":"for"},{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"minor","l":"menor"},{"g":"of / from"},{"g":"a five"},{"g":"year","l":"año"}]}]}