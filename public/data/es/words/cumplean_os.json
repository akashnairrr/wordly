{"id":"cumplean_os","lemma":"cumpleaños","pos":"noun","rank":591,"glosses":["birthday"],"ipa":"/kumpleˈaɲos/","gender":"m","forms":{"plural":"cumpleaños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/50/LL-Q1321_%28spa%29-AdrianAbdulBaha-cumplea%C3%B1os.wav","examples":[{"text":"No es mi cumpleaños.","en":"It's not my birthday.","audio":"https://tatoeba.org/en/audio/download/550170"},{"text":"Él olvidó mi cumpleaños.","en":"He forgot my birthday.","audio":"https://tatoeba.org/en/audio/download/721808"},{"text":"¿Cómo estuvo tu cumpleaños?","en":"How was your birthday?","audio":"https://tatoeba.org/en/audio/download/453872"},{"text":"¿Cómo estuvo su cumpleaños?","en":"How was your birthday?","audio":"https://tatoeba.org/en/audio/download/453873"},{"text":"Mañana es su cumpleaños.","en":"Tomorrow is her birthday.","audio":"https://tatoeba.org/en/audio/download/44205"}]}