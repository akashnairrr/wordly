{"id":"suen_o","lemma":"sueño","pos":"noun","rank":495,"glosses":["sleep, slumber","sleepiness"],"ipa":"/ˈsweɲo/","gender":"m","forms":{"plural":"sueños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q1321_%28spa%29-AdrianAbdulBaha-sue%C3%B1o.wav","examples":[{"text":"¿Cuántas horas de sueño necesitas?","en":"How many hours of sleep do you need?","audio":"https://tatoeba.org/en/audio/download/1577","words":[{"g":"how many"},{"g":"hour","l":"hora"},{"g":"of / from"},null,{"g":"to need","l":"necesitar"}]},{"text":"Sigue tus sueños.","en":"Follow your dreams.","audio":"https://tatoeba.org/en/audio/download/448614","words":[{"g":"to follow","l":"seguir"},{"g":"your"},null]},{"text":"¿Todavía tienes sueño?","en":"Are you still sleepy?","audio":"https://tatoeba.org/en/audio/download/449651","words":[{"g":"still, yet"},{"g":"to have","l":"tener"},null]},{"text":"Te veré en mis sueños.","en":"I'll see you in my dreams.","audio":"https://tatoeba.org/en/audio/download/585952","words":[{"g":"you"},{"g":"to see, to spot","l":"ver"},{"g":"in / on"},{"g":"my"},null]},{"text":"Tengo un sueño secreto.","en":"I have a secret dream.","audio":"https://tatoeba.org/en/audio/download/454592","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"a secret"}]}]}