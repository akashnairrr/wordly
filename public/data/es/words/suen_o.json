{"id":"suen_o","lemma":"sueño","pos":"noun","rank":498,"glosses":["sleep, slumber","sleepiness"],"ipa":"/ˈsweɲo/","gender":"m","forms":{"plural":"sueños"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e3/LL-Q1321_%28spa%29-AdrianAbdulBaha-sue%C3%B1o.wav","examples":[{"text":"¿Te ha entrado sueño?","en":"Are you sleepy?","audio":"https://tatoeba.org/en/audio/download/633976"},{"text":"No recuerdo mis sueños.","en":"I don't remember my dreams.","audio":"https://tatoeba.org/en/audio/download/594399"},{"text":"¿Ha sido un sueño?","en":"Was it a dream?","audio":"https://tatoeba.org/en/audio/download/770247"},{"text":"Nuestros sueños se hicieron realidad.","en":"Our dreams came true.","audio":"https://tatoeba.org/en/audio/download/68664"},{"text":"Tienes cara de sueño.","en":"You look tired.","audio":"https://tatoeba.org/en/audio/download/441451"}]}