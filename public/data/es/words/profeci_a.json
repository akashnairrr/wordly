{"id":"profeci_a","lemma":"profecía","pos":"noun","rank":4659,"glosses":["prophecy","prediction"],"ipa":"/pɾofeˈθia/","gender":"f","forms":{"plural":"profecías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0c/LL-Q1321_%28spa%29-Emanuelps27-profec%C3%ADa.wav","examples":[{"text":"La profecía se hizo realidad.","en":"The prophecy came true.","audio":"https://tatoeba.org/en/audio/download/460845","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to do","l":"hacer"},{"g":"reality"}]},{"text":"No es una profecía.","en":"It isn't a prophecy.","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Su profecía se cumplió.","en":"His prophecy was fulfilled.","words":[{"g":"his / her / your"},null,{"g":"oneself"},{"g":"to fulfil","l":"cumplir"}]},{"text":"Se ha cumplido tu profecía.","en":"Your prophecy has come true.","audio":"https://tatoeba.org/en/audio/download/641854","words":[{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to fulfil","l":"cumplir"},{"g":"your"},null]},{"text":"La profecía se ha cumplido.","en":"The prophecy is fulfilled.","words":[{"g":"the / her"},null,{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to fulfil","l":"cumplir"}]}]}