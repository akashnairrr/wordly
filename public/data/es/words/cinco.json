{"id":"cinco","lemma":"cinco","pos":"noun","rank":270,"glosses":["a five"],"ipa":"/ˈθinko/","gender":"m","forms":{"plural":"cincos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Precision27-cinco.wav","examples":[{"text":"Nos vemos a las cinco.","en":"See you at five.","audio":"https://tatoeba.org/en/audio/download/937480","words":[null,null,{"g":"to"},{"g":"the / them"},null],"phrases":[[0,2,"cheers, goodbye"]]},{"text":"Te debo cinco dólares.","en":"I owe you five dollars.","audio":"https://tatoeba.org/en/audio/download/67531","words":[{"g":"you"},{"g":"to owe","l":"deber"},null,{"g":"dollar","l":"dólar"}]},{"text":"Mi padre tiene cinco hermanos.","en":"My father has five siblings.","audio":"https://tatoeba.org/en/audio/download/552786","words":[{"g":"my"},{"g":"father, parent"},{"g":"to have","l":"tener"},null,{"g":"brother","l":"hermano"}]},{"text":"Ella tiene cinco años menos que yo.","en":"She's five years younger than me.","audio":"https://tatoeba.org/en/audio/download/935846","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"},{"g":"less, fewer"},{"g":"that"},{"g":"I"}]},{"text":"Mi abuelo murió hace cinco años.","en":"My grandfather died five years ago.","audio":"https://tatoeba.org/en/audio/download/568172","words":[{"g":"my"},{"g":"grandfather"},{"g":"to die","l":"morir"},{"g":"to do","l":"hacer"},null,{"g":"year","l":"año"}]}]}