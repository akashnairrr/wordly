{"id":"cinco","lemma":"cinco","pos":"noun","rank":273,"glosses":["a five"],"ipa":"/ˈθinko/","gender":"m","forms":{"plural":"cincos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Precision27-cinco.wav","examples":[{"text":"Vi a cinco hombres.","en":"I saw five men.","audio":"https://tatoeba.org/en/audio/download/440777"},{"text":"Cuatro por cinco, veinte.","en":"Four times five is 20.","audio":"https://tatoeba.org/en/audio/download/524958"},{"text":"Ella tiene cinco años.","en":"She is five years old.","audio":"https://tatoeba.org/en/audio/download/39914"},{"text":"Te debo cinco dólares.","en":"I owe you five dollars.","audio":"https://tatoeba.org/en/audio/download/67531"},{"text":"Él habla cinco idiomas.","en":"He speaks five languages.","audio":"https://tatoeba.org/en/audio/download/524842"}]}