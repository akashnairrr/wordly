{"id":"cinco","lemma":"cinco","pos":"noun","rank":270,"glosses":["a five"],"ipa":"/ˈθinko/","gender":"m","forms":{"plural":"cincos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Precision27-cinco.wav","examples":[{"text":"Te debo cinco dólares.","en":"I owe you five dollars.","audio":"https://tatoeba.org/en/audio/download/67531","words":[{"g":"you"},{"g":"to owe","l":"deber"},null,{"g":"dollar","l":"dólar"}]},{"text":"Tenemos cinco dedos en cada mano.","en":"We have five fingers on each hand.","audio":"https://tatoeba.org/en/audio/download/585905","words":[{"g":"to have","l":"tener"},null,{"g":"digit: finger or toe","l":"dedo"},{"g":"in / on"},{"g":"each"},{"g":"hand"}]},{"text":"Ella tiene cinco años.","en":"She is five years old.","audio":"https://tatoeba.org/en/audio/download/39914","words":[{"g":"she"},{"g":"to have","l":"tener"},null,{"g":"year","l":"año"}]},{"text":"Dame cinco días.","en":"Give me five days.","audio":"https://tatoeba.org/en/audio/download/44394","words":[{"g":"to give, to give out","l":"dar"},null,{"g":"day","l":"día"}]},{"text":"Tienes cinco minutos.","en":"You've got five minutes.","audio":"https://tatoeba.org/en/audio/download/517300","words":[{"g":"to have","l":"tener"},null,{"g":"minute","l":"minuto"}]}]}