{"id":"evento","lemma":"evento","pos":"noun","rank":1877,"glosses":["event"],"ipa":"/eˈbento/","gender":"m","forms":{"plural":"eventos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e5/LL-Q1321_%28spa%29-Emanuelps27-evento.wav","examples":[{"text":"Es un evento religioso.","en":"It's a religious event.","audio":"https://tatoeba.org/en/audio/download/567783"},{"text":"Tom ama los eventos deportivos.","en":"Tom loves sports events."},{"text":"El evento es el lunes.","en":"The event is on Monday.","audio":"https://tatoeba.org/en/audio/download/352298"},{"text":"Es una historia basada en eventos reales.","en":"It's a story based on a real event."},{"text":"No podía prever este evento.","en":"I couldn't have predicted this happening.","audio":"https://tatoeba.org/en/audio/download/551507"}]}