{"id":"secreto","lemma":"secreto","pos":"noun","rank":491,"glosses":["a secret","secrecy"],"ipa":"/seˈkɾeto/","gender":"m","forms":{"plural":"secretos"},"order":707,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Marreromarco-secreto.wav","examples":[{"text":"¿Cuál es el secreto?","en":"What's the secret?","audio":"https://tatoeba.org/en/audio/download/449122","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},null]},{"text":"No tengo secretos contigo.","en":"I have no secrets from you.","audio":"https://tatoeba.org/en/audio/download/524973","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"with you"}]},{"text":"Él parece conocer el secreto.","en":"He seems to know the secret.","audio":"https://tatoeba.org/en/audio/download/705017","words":[{"g":"he"},{"g":"to seem, to see fit","l":"parecer"},{"g":"to know"},{"g":"the"},null]}]}