{"id":"secreto","lemma":"secreto","pos":"noun","rank":490,"glosses":["a secret","secrecy"],"ipa":"/seˈkɾeto/","gender":"m","forms":{"plural":"secretos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Marreromarco-secreto.wav","examples":[{"text":"¿Cuál es el secreto?","en":"What's the secret?","audio":"https://tatoeba.org/en/audio/download/449122","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the"},null]},{"text":"No tengo secretos contigo.","en":"I have no secrets from you.","audio":"https://tatoeba.org/en/audio/download/524973","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"with you"}]},{"text":"¿Hay algún plan secreto?","en":"Is there some secret plan?","audio":"https://tatoeba.org/en/audio/download/920124","words":[{"g":"to have","l":"haber"},null,{"g":"plan"},null]},{"text":"Él parece conocer el secreto.","en":"He seems to know the secret.","audio":"https://tatoeba.org/en/audio/download/705017","words":[{"g":"he"},{"g":"to seem, to see fit","l":"parecer"},{"g":"to know"},{"g":"the"},null]},{"text":"Ella guarda los secretos.","en":"She keeps secrets.","audio":"https://tatoeba.org/en/audio/download/444325","words":[{"g":"she"},{"g":"guard, ward, keeper"},{"g":"the / them"},null]}]}