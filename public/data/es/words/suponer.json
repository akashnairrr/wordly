{"id":"suponer","lemma":"suponer","pos":"verb","rank":230,"glosses":["to suppose, to surmise, to assume, to guess, to imagine, to figure, to say, to take it","to presume, to expect","to pose (e.g. a risk, a threat, a danger)"],"ipa":"/supoˈneɾ/","conjugation":{"indicative":{"present":{"1s":"supongo","2s":"supones","3s":"supone","1p":"suponemos","2p":"suponéis","3p":"suponen"},"imperfect":{"1s":"suponía","2s":"suponías","3s":"suponía","1p":"suponíamos","2p":"suponíais","3p":"suponían"},"preterite":{"1s":"supuse","2s":"supusiste","3s":"supuso","1p":"supusimos","2p":"supusisteis","3p":"supusieron"},"future":{"1s":"supondré","2s":"supondrás","3s":"supondrá","1p":"supondremos","2p":"supondréis","3p":"supondrán"},"conditional":{"1s":"supondría","2s":"supondrías","3s":"supondría","1p":"supondríamos","2p":"supondríais","3p":"supondrían"}},"subjunctive":{"present":{"1s":"suponga","2s":"supongas","3s":"suponga","1p":"supongamos","2p":"supongáis","3p":"supongan"},"imperfect":{"1s":"supusiera","2s":"supusieras","3s":"supusiera","1p":"supusiéramos","2p":"supusierais","3p":"supusieran"}},"imperative":{"affirmative":{"2s":"supón","3s":"suponga","1p":"supongamos","2p":"suponed","3p":"supongan"},"negative":{"2s":"supongas","3s":"suponga","1p":"supongamos","2p":"supongáis","3p":"supongan"}}},"nonFinite":{"gerund":"suponiendo","participle":"supuesto"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/ab/LL-Q1321_%28spa%29-Marreromarco-suponer.wav","examples":[{"text":"Yo supongo que te gusta.","en":"I suppose you like her.","audio":"https://tatoeba.org/en/audio/download/458598","words":[{"g":"I"},null,{"g":"that"},{"g":"you"},{"g":"to like in a general…","l":"gustar"}]},{"text":"¿Qué se supone que tengo que comer?","en":"What should I eat?","audio":"https://tatoeba.org/en/audio/download/768227","words":[{"g":"what"},{"g":"oneself"},null,{"g":"that"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to eat"}]},{"text":"Simplemente supuse que no te importaría.","en":"I just assumed