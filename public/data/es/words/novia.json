{"id":"novia","lemma":"novia","pos":"noun","rank":493,"glosses":["a type of sweet roll"],"ipa":"/ˈnobja/","gender":"f","forms":{"plural":"novias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-AdrianAbdulBaha-novia.wav","examples":[{"text":"Ella es mi novia.","en":"She is my girlfriend.","audio":"https://tatoeba.org/en/audio/download/34802","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"my"},null]},{"text":"Yo no conozco a la novia.","en":"I don't know the bride.","audio":"https://tatoeba.org/en/audio/download/458747","words":[{"g":"I"},{"g":"no / not"},{"g":"to know","l":"conocer"},{"g":"to"},{"g":"the / her"},null]},{"text":"Mi novia está llorando.","en":"My girlfriend is crying.","audio":"https://tatoeba.org/en/audio/download/518930","words":[{"g":"my"},null,{"g":"to be","l":"estar"},{"g":"to cry, to weep","l":"llorar"}]},{"text":"No se lo digas a mi novia.","en":"Don't tell my girlfriend.","audio":"https://tatoeba.org/en/audio/download/81888","words":[{"g":"no / not"},{"g":"oneself"},{"g":"it / him"},{"g":"to say","l":"decir"},{"g":"to"},{"g":"my"},null]},{"text":"¿Tom tiene novia?","en":"Does Tom have a girlfriend?","audio":"https://tatoeba.org/en/audio/download/58693","words":[null,{"g":"to have","l":"tener"},null]}]}