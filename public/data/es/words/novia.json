{"id":"novia","lemma":"novia","pos":"noun","rank":496,"glosses":["a type of sweet roll"],"ipa":"/ˈnobja/","gender":"f","forms":{"plural":"novias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-AdrianAbdulBaha-novia.wav","examples":[{"text":"Él no tiene novia.","en":"He has no girlfriend.","audio":"https://tatoeba.org/en/audio/download/524403"},{"text":"Todos mis amigos tienen novias.","en":"All my friends have girlfriends.","audio":"https://tatoeba.org/en/audio/download/825973"},{"text":"Ella es mi novia.","en":"She is my girlfriend.","audio":"https://tatoeba.org/en/audio/download/34802"},{"text":"Todas mis amigas tienen novias.","en":"All my friends have girlfriends.","audio":"https://tatoeba.org/en/audio/download/825974"},{"text":"Mi novia está llorando.","en":"My girlfriend is crying.","audio":"https://tatoeba.org/en/audio/download/518930"}]}