{"id":"concierto","lemma":"concierto","pos":"noun","rank":1651,"glosses":["concert","concerto"],"ipa":"/konˈθjeɾto/","gender":"m","forms":{"plural":"conciertos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-AdrianAbdulBaha-concierto.wav","examples":[{"text":"Fui a un concierto.","en":"I went to a concert.","audio":"https://tatoeba.org/en/audio/download/449116"},{"text":"Ellos dieron una serie de conciertos.","en":"They gave a series of concerts.","audio":"https://tatoeba.org/en/audio/download/589907"},{"text":"Su concierto fue genial.","en":"His concert was great.","audio":"https://tatoeba.org/en/audio/download/454184"},{"text":"¿Cuántos conciertos para fagot escribió Vivaldi?","en":"How many bassoon concertos did Vivaldi write?","audio":"https://tatoeba.org/en/audio/download/858068"},{"text":"¿Te gustó el concierto?","en":"Did you enjoy the concert?","audio":"https://tatoeba.org/en/audio/download/585862"}]}