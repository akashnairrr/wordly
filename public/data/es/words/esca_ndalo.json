{"id":"esca_ndalo","lemma":"escándalo","pos":"noun","rank":2131,"glosses":["scandal"],"ipa":"/esˈkandalo/","gender":"m","forms":{"plural":"escándalos"},"order":2154,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/ce/LL-Q1321_%28spa%29-Marreromarco-esc%C3%A1ndalo.wav","examples":[{"text":"¡Qué escándalo!","en":"What a scandal!","audio":"https://tatoeba.org/en/audio/download/732414","words":[{"g":"what"},null]},{"text":"No quiero hacer de esto un escándalo.","en":"I don't want to make a big deal out of this.","audio":"https://tatoeba.org/en/audio/download/506306","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},null,null,{"g":"this"},{"g":"a"},null],"phrases":[[2,4,"to make as if"]]},{"text":"El escándalo arruinó su carrera.","en":"The scandal ruined his career.","words":[{"g":"the"},null,{"g":"to ruin","l":"arruinar"},{"g":"his / her / your"},{"g":"race"}]}]}