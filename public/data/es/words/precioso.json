{"id":"precioso","lemma":"precioso","pos":"adj","rank":1165,"glosses":["precious","gorgeous","cute"],"ipa":"/pɾeˈθjoso/","forms":{"feminine":"preciosa","masculinePlural":"preciosos","femininePlural":"preciosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-AdrianAbdulBaha-precioso.wav","examples":[{"text":"El tiempo es precioso.","en":"The weather is beautiful.","audio":"https://tatoeba.org/en/audio/download/929715"},{"text":"La taza es preciosa.","en":"The cup is nice.","audio":"https://tatoeba.org/en/audio/download/734358"},{"text":"Estos árboles son preciosos.","en":"These trees are beautiful.","audio":"https://tatoeba.org/en/audio/download/409685"},{"text":"Las montañas son preciosas.","en":"The mountains are beautiful.","audio":"https://tatoeba.org/en/audio/download/306317"},{"text":"Estamos desperdiciando tiempo precioso.","en":"We're wasting precious time.","audio":"https://tatoeba.org/en/audio/download/523206"}]}