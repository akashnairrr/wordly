{"id":"medida","lemma":"medida","pos":"noun","rank":1812,"glosses":["measurement; measure, gauge","degree, extent","action, step, sanction"],"ipa":"/meˈdida/","gender":"f","forms":{"plural":"medidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/78/LL-Q1321_%28spa%29-Marreromarco-medida.wav","formAudio":{"medidas":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1321_%28spa%29-Precision27-medidas.wav"},"examples":[{"text":"Todo está hecho a la medida.","en":"It's all custom made.","audio":"https://tatoeba.org/en/audio/download/800801","words":[{"g":"all"},{"g":"to be","l":"estar"},{"g":"done, completed"},{"g":"to"},{"g":"the / her"},null]},{"text":"Te puedo entender en cierta medida.","en":"I can understand you to some extent.","words":[{"g":"you"},{"g":"to be able to, can","l":"poder"},{"g":"to understand"},{"g":"in / on"},{"g":"a certain, a specific","l":"cierto"},null]},{"text":"Déjeme tomarle las medidas, por favor.","en":"Please allow me to measure you.","words":[{"g":"to leave","l":"dejar"},{"g":"to take","l":"tomar"},{"g":"the / them"},null,null,null],"phrases":[[4,6,"please"]]},{"text":"¿Cuál es tu medida de cintura?","en":"What's your waist size?","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"of / from"},{"g":"waist"}]},{"text":"Se requieren medidas inmediatas.","en":"Prompt action is necessary.","audio":"https://tatoeba.org/en/audio/download/735624","words":[{"g":"oneself"},{"g":"to require, need","l":"requerir"},null,null]}]}