{"id":"barco","lemma":"barco","pos":"noun","rank":581,"glosses":["boat (usually with a concave hull)"],"ipa":"/ˈbaɾko/","gender":"m","forms":{"plural":"barcos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-AdrianAbdulBaha-barco.wav","formAudio":{"barcos":"https://upload.wikimedia.org/wikipedia/commons/e/e2/LL-Q1321_%28spa%29-Marreromarco-barcos.wav"},"examples":[{"text":"El barco se hunde.","en":"The ship is sinking.","audio":"https://tatoeba.org/en/audio/download/450479"},{"text":"Sé mucho de barcos.","en":"I know a lot about ships.","audio":"https://tatoeba.org/en/audio/download/513097"},{"text":"Nací en un barco.","en":"I was born on a ship.","audio":"https://tatoeba.org/en/audio/download/162864"},{"text":"El hierro se utiliza en la construcción de barcos.","en":"Iron is used in building ships.","audio":"https://tatoeba.org/en/audio/download/589816"},{"text":"¿En qué barco estabas?","en":"What ship were you on?","audio":"https://tatoeba.org/en/audio/download/461605"}]}