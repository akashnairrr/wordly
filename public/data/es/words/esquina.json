{"id":"esquina","lemma":"esquina","pos":"noun","rank":1332,"glosses":["corner"],"ipa":"/esˈkina/","gender":"f","forms":{"plural":"esquinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-AdrianAbdulBaha-esquina.wav","examples":[{"text":"Está en la esquina.","en":"It's at the corner.","audio":"https://tatoeba.org/en/audio/download/735640","words":[{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Hay un banco en la esquina.","en":"There's a bank on the corner.","audio":"https://tatoeba.org/en/audio/download/611607","words":[{"g":"to have","l":"haber"},{"g":"a"},{"g":"bank"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Él vive a la vuelta de la esquina.","en":"He lives just around the corner.","audio":"https://tatoeba.org/en/audio/download/354602","words":[{"g":"he"},{"g":"to applaud","l":"vivar"},{"g":"to"},{"g":"the / her"},{"g":"turn"},null,null,null],"phrases":[[5,7,"of the"]]},{"text":"Gira a la izquierda en la esquina.","en":"Turn left at the corner.","words":[{"g":"tour"},{"g":"to"},{"g":"the / her"},{"g":"left"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"En la siguiente esquina, gira hacia la derecha.","en":"At the next corner, turn right.","words":[{"g":"in / on"},{"g":"the / her"},{"g":"following"},null,{"g":"tour"},{"g":"toward, towards"},{"g":"the / her"},{"g":"right"}]}]}