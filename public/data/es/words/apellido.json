{"id":"apellido","lemma":"apellido","pos":"noun","rank":1985,"glosses":["surname, last name","a trait, activity, or action closely associated with or aptly describing a person; an appellation"],"ipa":"/apeˈʝido/","gender":"m","forms":{"plural":"apellidos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c3/LL-Q1321_%28spa%29-Guergana-apellido.wav","examples":[{"text":"No entendí tu apellido.","en":"I didn't catch your last name.","audio":"https://tatoeba.org/en/audio/download/514767"},{"text":"Escriba su nombre y apellidos.","en":"Write your full name.","audio":"https://tatoeba.org/en/audio/download/119325"},{"text":"¿Cómo se escribe tu apellido?","en":"How is your last name written?","audio":"https://tatoeba.org/en/audio/download/553867"},{"text":"¿Me puede decir su apellido?","en":"Can you tell me your last name?","audio":"https://tatoeba.org/en/audio/download/1152267"},{"text":"¿Cómo se pronuncia tu apellido?","en":"How do you pronounce your last name?","audio":"https://tatoeba.org/en/audio/download/589880"}]}