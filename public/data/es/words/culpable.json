{"id":"culpable","lemma":"culpable","pos":"adj","rank":822,"glosses":["guilty, culpable","guilty (having a sense of guilt)"],"ipa":"/kulˈpable/","forms":{"femininePlural":"culpables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q1321_%28spa%29-Marreromarco-culpable.wav","examples":[{"text":"Yo me sentí culpable.","en":"I felt guilty.","audio":"https://tatoeba.org/en/audio/download/440284"},{"text":"Ahora me siento culpable.","en":"Now I feel guilty.","audio":"https://tatoeba.org/en/audio/download/443647"},{"text":"Admitió que era culpable.","en":"He admitted that he was guilty.","audio":"https://tatoeba.org/en/audio/download/524364"},{"text":"Él es culpable de robo.","en":"He is guilty of theft.","audio":"https://tatoeba.org/en/audio/download/35108"},{"text":"Él es culpable de asesinato.","en":"He is guilty of murder.","audio":"https://tatoeba.org/en/audio/download/636426"}]}