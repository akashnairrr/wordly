{"id":"rato","lemma":"rato","pos":"noun","rank":670,"glosses":["a while, bit (a short period of time)","time"],"ipa":"/ˈrato/","gender":"m","forms":{"plural":"ratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-Millars-rato.wav","examples":[{"text":"Resérvate para otro rato.","en":"Save your strength.","audio":"https://tatoeba.org/en/audio/download/448508"},{"text":"Hemos pasado buenos ratos aquí, ¿verdad?","en":"We had some good times here, didn't we?","audio":"https://tatoeba.org/en/audio/download/506578"},{"text":"¿Puedo dormir un rato?","en":"Can I sleep for a bit?","audio":"https://tatoeba.org/en/audio/download/567255"},{"text":"Hemos pasado buenos ratos aquí, ¿a que sí?","en":"We had some good times here, didn't we?","audio":"https://tatoeba.org/en/audio/download/506577"},{"text":"¿Se quedó mucho rato?","en":"Did he stay very long?","audio":"https://tatoeba.org/en/audio/download/636775"}]}