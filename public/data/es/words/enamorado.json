{"id":"enamorado","lemma":"enamorado","pos":"adj","rank":1119,"glosses":["infatuated, having a crush on, feeling love or attraction for another","enamored, in love, smitten"],"ipa":"/enamoˈɾado/","forms":{"feminine":"enamorada","masculinePlural":"enamorados","femininePlural":"enamoradas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/08/LL-Q1321_%28spa%29-Marreromarco-enamorado.wav","examples":[{"text":"Creo que estoy enamorado.","en":"I think I'm in love.","audio":"https://tatoeba.org/en/audio/download/448881"},{"text":"Debes de estar enamorada.","en":"You must be in love.","audio":"https://tatoeba.org/en/audio/download/454533"},{"text":"Ellos parecen estar enamorados.","en":"They seem to be in love with each other.","audio":"https://tatoeba.org/en/audio/download/524429"},{"text":"¿Habéis estado enamoradas alguna vez?","en":"Have you ever been in love?","audio":"https://tatoeba.org/en/audio/download/104541"},{"text":"Estoy enamorado de ella.","en":"I'm in love with her.","audio":"https://tatoeba.org/en/audio/download/453091"}]}