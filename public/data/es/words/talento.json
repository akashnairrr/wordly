{"id":"talento","lemma":"talento","pos":"noun","rank":1282,"glosses":["talent"],"ipa":"/taˈlento/","gender":"m","forms":{"plural":"talentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-AdrianAbdulBaha-talento.wav","examples":[{"text":"No tengo talento.","en":"I have no talent.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Le falta talento para ser actor.","en":"He lacks the talent to be an actor.","audio":"https://tatoeba.org/en/audio/download/594298","words":[{"g":"him / her"},{"g":"lack, shortage"},null,{"g":"for"},{"g":"to be"},{"g":"actor"}]},{"text":"Él hace buen uso de sus talentos.","en":"He makes good use of his talents.","words":[{"g":"he"},{"g":"to do","l":"hacer"},null,{"g":"use"},{"g":"of / from"},{"g":"his, her, its, their"},null]},{"text":"Admiro su talento.","en":"I admire his talent.","audio":"https://tatoeba.org/en/audio/download/453789","words":[{"g":"to admire","l":"admirar"},{"g":"his / her / your"},null]},{"text":"Él tiene mucho talento.","en":"He's very talented.","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"much"},null]}]}