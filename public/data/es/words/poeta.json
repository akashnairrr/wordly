{"id":"poeta","lemma":"poeta","pos":"noun","rank":3016,"glosses":["poet (person who writes poems)"],"ipa":"/poˈeta/","gender":"mf","forms":{"plural":"poetas","feminine":"poeta","femininePlural":"poetas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-AdrianAbdulBaha-poeta.wav","examples":[{"text":"No todos pueden ser poetas.","en":"Not everyone can be a poet.","audio":"https://tatoeba.org/en/audio/download/587361","words":[{"g":"no / not"},{"g":"all","l":"todo"},{"g":"to be able to, can","l":"poder"},{"g":"to be"},null]},{"text":"¿Cuál es tu poeta favorito?","en":"Who's your favorite poet?","audio":"https://tatoeba.org/en/audio/download/79966","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null,{"g":"favorite/favourite"}]},{"text":"Él piensa que es un gran poeta.","en":"He thinks that he is a great poet.","audio":"https://tatoeba.org/en/audio/download/582055","words":[{"g":"he"},{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Ella no es poeta sino novelista.","en":"She is not a poet but a novelist.","audio":"https://tatoeba.org/en/audio/download/522006","words":[{"g":"she"},{"g":"no / not"},{"g":"to be","l":"ser"},null,{"g":"but"},{"g":"novelist"}]},{"text":"Los poetas escriben poemas.","en":"Poets write poems.","audio":"https://tatoeba.org/en/audio/download/636736","words":[{"g":"the / them"},null,{"g":"to write","l":"escribir"},{"g":"poem","l":"poema"}]}]}