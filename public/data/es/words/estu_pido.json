{"id":"estu_pido","lemma":"estúpido","pos":"adj","rank":553,"glosses":["stupid"],"ipa":"/esˈtupido/","forms":{"feminine":"estúpida","masculinePlural":"estúpidos","femininePlural":"estúpidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-est%C3%BApido.wav","examples":[{"text":"No soy tan estúpido como piensas.","en":"I'm not as stupid as you think I am.","audio":"https://tatoeba.org/en/audio/download/518075","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"so, as"},null,{"g":"as"},{"g":"to think, ponder","l":"pensar"}]},{"text":"Es una ley estúpida.","en":"It's a stupid law.","audio":"https://tatoeba.org/en/audio/download/443503","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"law"},null]},{"text":"No son estúpidos.","en":"They're not stupid.","audio":"https://tatoeba.org/en/audio/download/501310","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"No hay preguntas estúpidas.","en":"There are no stupid questions.","audio":"https://tatoeba.org/en/audio/download/525494","words":[{"g":"no / not"},{"g":"to have","l":"haber"},{"g":"question","l":"pregunta"},null]},{"text":"Él no es estúpido.","en":"He's not stupid.","audio":"https://tatoeba.org/en/audio/download/441481","words":[{"g":"he"},{"g":"no / not"},{"g":"to be","l":"ser"},null]}]}