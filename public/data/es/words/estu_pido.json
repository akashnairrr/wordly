{"id":"estu_pido","lemma":"estúpido","pos":"adj","rank":556,"glosses":["stupid"],"ipa":"/esˈtupido/","forms":{"feminine":"estúpida","masculinePlural":"estúpidos","femininePlural":"estúpidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-AdrianAbdulBaha-est%C3%BApido.wav","examples":[{"text":"Yo me siento estúpido.","en":"I feel stupid.","audio":"https://tatoeba.org/en/audio/download/440281"},{"text":"Es una ley estúpida.","en":"It's a stupid law.","audio":"https://tatoeba.org/en/audio/download/443503"},{"text":"Cometimos algunos estúpidos errores.","en":"We made some stupid mistakes.","audio":"https://tatoeba.org/en/audio/download/582460"},{"text":"No hay preguntas estúpidas.","en":"There are no stupid questions.","audio":"https://tatoeba.org/en/audio/download/525494"},{"text":"Tom no es estúpido.","en":"Tom isn't dumb.","audio":"https://tatoeba.org/en/audio/download/798915"}]}