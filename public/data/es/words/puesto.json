{"id":"puesto","lemma":"puesto","pos":"adj","rank":430,"glosses":["put, placed, set, positioned","prepared","written"],"ipa":"/ˈpwesto/","forms":{"feminine":"puesta","masculinePlural":"puestos","femininePlural":"puestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q1321_%28spa%29-Marreromarco-puesto.wav","examples":[{"text":"¿Está libre este puesto?","en":"Is this seat taken?","audio":"https://tatoeba.org/en/audio/download/449084"},{"text":"Debería llevar puesta una corbata.","en":"I should've worn a tie.","audio":"https://tatoeba.org/en/audio/download/456729"},{"text":"Los prisioneros han sido puestos en libertad.","en":"The prisoners have been released.","audio":"https://tatoeba.org/en/audio/download/582613"},{"text":"Llevo puestas las luces antiniebla.","en":"My fog lights are on.","audio":"https://tatoeba.org/en/audio/download/425111"},{"text":"¿Qué lleva puesto Tom?","en":"What's Tom wearing?","audio":"https://tatoeba.org/en/audio/download/798969"}]}