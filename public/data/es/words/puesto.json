{"id":"puesto","lemma":"puesto","pos":"adj","rank":427,"glosses":["put, placed, set, positioned","prepared","written"],"ipa":"/ˈpwesto/","forms":{"feminine":"puesta","masculinePlural":"puestos","femininePlural":"puestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f5/LL-Q1321_%28spa%29-Marreromarco-puesto.wav","examples":[{"text":"¿Cuál es tu puesto?","en":"What's your position?","audio":"https://tatoeba.org/en/audio/download/532146","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Mamá ha puesto la mesa.","en":"Mom set the table.","audio":"https://tatoeba.org/en/audio/download/45857","words":[{"g":"mum, mom"},{"g":"to have","l":"haber"},null,{"g":"the / her"},{"g":"table"}]},{"text":"Ellos fueron puestos en prisión.","en":"They were put in prison.","words":[{"g":"they","l":"él"},{"g":"to go","l":"ir"},null,{"g":"in / on"},{"g":"prison"}]},{"text":"Nuestra casa está puesta en venta.","en":"Our house is up for sale.","audio":"https://tatoeba.org/en/audio/download/306557","words":[{"g":"our, ours, to us","l":"nuestro"},{"g":"house"},{"g":"to be","l":"estar"},null,null,null],"phrases":[[4,6,"for sale"]]},{"text":"Te has puesto tan alto.","en":"You've grown so tall.","audio":"https://tatoeba.org/en/audio/download/453943","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"so, as"},{"g":"tall"}]}]}