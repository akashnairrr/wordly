{"id":"caso","lemma":"caso","pos":"noun","rank":213,"glosses":["case (situation or fact)","case (instance of a medical condition)","case"],"ipa":"/ˈkaso/","gender":"m","forms":{"plural":"casos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-Precision27-caso.wav","formAudio":{"casos":"https://upload.wikimedia.org/wikipedia/commons/0/0a/LL-Q1321_%28spa%29-Eavqwiki-casos.wav"},"examples":[{"text":"No le hagas caso.","en":"Ignore him.","audio":"https://tatoeba.org/en/audio/download/636547"},{"text":"Los dos casos no están relacionados.","en":"The two cases aren't related."},{"text":"No me hizo caso.","en":"He ignored me.","audio":"https://tatoeba.org/en/audio/download/567216"},{"text":"Los casos como este verdaderamente importan.","en":"Cases like this really do matter."},{"text":"El caso está cerrado.","en":"The case is closed.","audio":"https://tatoeba.org/en/audio/download/501143"}]}