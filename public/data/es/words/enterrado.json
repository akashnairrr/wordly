{"id":"enterrado","lemma":"enterrado","pos":"adj","rank":2574,"glosses":["buried"],"ipa":"/enteˈrado/","forms":{"feminine":"enterrada","masculinePlural":"enterrados","femininePlural":"enterradas"},"examples":[{"text":"Él está muerto y enterrado ahora.","en":"He is dead and buried now.","words":[{"g":"he"},{"g":"to be","l":"estar"},{"g":"dead"},{"g":"and"},null,{"g":"now"}]},{"text":"Ella ha enterrado a su único hijo.","en":"She has buried her only son.","audio":"https://tatoeba.org/en/audio/download/641886","words":[{"g":"she"},{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"his / her / your"},{"g":"only"},{"g":"son"}]},{"text":"Sus cenizas están enterradas aquí.","en":"His ashes are buried here.","audio":"https://tatoeba.org/en/audio/download/639473","words":[{"g":"his, her, its, their"},{"g":"ash","l":"cenizo"},{"g":"to be","l":"estar"},null,{"g":"here"}]},{"text":"Estábamos buscando un tesoro enterrado.","en":"We were looking for buried treasure.","audio":"https://tatoeba.org/en/audio/download/599973","words":[{"g":"to be","l":"estar"},{"g":"to seek","l":"buscar"},{"g":"a"},{"g":"treasure"},null]},{"text":"Esta es la lista de todas las personas enterradas aquí.","en":"This is the list of all the people buried here.","words":[{"g":"this","l":"este"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"list, roll"},{"g":"of / from"},{"g":"all","l":"todo"},{"g":"the / them"},{"g":"person (an individual","l":"persona"},null,{"g":"here"}]}]}