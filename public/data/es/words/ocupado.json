{"id":"ocupado","lemma":"ocupado","pos":"adj","rank":800,"glosses":["occupied","busy"],"ipa":"/okuˈpado/","forms":{"feminine":"ocupada","masculinePlural":"ocupados","femininePlural":"ocupadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/af/LL-Q1321_%28spa%29-AdrianAbdulBaha-ocupado.wav","examples":[{"text":"Tom estaba tan ocupado.","en":"Tom was so busy.","audio":"https://tatoeba.org/en/audio/download/799786"},{"text":"No estoy ocupada ahora.","en":"I'm not busy now.","audio":"https://tatoeba.org/en/audio/download/735620"},{"text":"Ustedes han estado ocupados.","en":"You have been busy.","audio":"https://tatoeba.org/en/audio/download/448119"},{"text":"Dile que estamos ocupadas.","en":"Tell her we're busy.","audio":"https://tatoeba.org/en/audio/download/735233"},{"text":"Él ha estado ocupado.","en":"He has been busy.","audio":"https://tatoeba.org/en/audio/download/442422"}]}