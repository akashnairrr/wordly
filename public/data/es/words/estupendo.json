{"id":"estupendo","lemma":"estupendo","pos":"adj","rank":927,"glosses":["stupendous","marvellous","fantastic"],"ipa":"/estuˈpendo/","forms":{"feminine":"estupenda","masculinePlural":"estupendos","femininePlural":"estupendas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5a/LL-Q1321_%28spa%29-Marreromarco-estupendo.wav","examples":[{"text":"Esto se ve estupendo.","en":"This looks great.","audio":"https://tatoeba.org/en/audio/download/425139"},{"text":"Pasé una estupenda noche.","en":"I had a great night.","audio":"https://tatoeba.org/en/audio/download/449190"},{"text":"Están estupendos.","en":"They look great.","audio":"https://tatoeba.org/en/audio/download/424700"},{"text":"¡Traemos estupendas noticias!","en":"We have some great news!"},{"text":"Este lugar es estupendo.","en":"This place is great.","audio":"https://tatoeba.org/en/audio/download/448291"}]}