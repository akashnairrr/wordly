{"id":"capita_n","lemma":"capitán","pos":"noun","rank":336,"glosses":["captain (leader)"],"ipa":"/kapiˈtan/","gender":"m","forms":{"plural":"capitanes","feminine":"capitana","femininePlural":"capitanas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-AdrianAbdulBaha-capit%C3%A1n.wav","examples":[{"text":"Me llaman capitán.","en":"They call me captain.","audio":"https://tatoeba.org/en/audio/download/453945","words":[{"g":"me"},{"g":"to summon, to call","l":"llamar"},null]},{"text":"El capitán nos dio la bienvenida.","en":"The captain welcomed us.","audio":"https://tatoeba.org/en/audio/download/639510","words":[{"g":"the"},null,{"g":"us"},{"g":"to give, to give out","l":"dar"},{"g":"the / her"},{"g":"welcome"}]},{"text":"¿Quién es el capitán de este barco?","en":"Who's the captain of this ship?","audio":"https://tatoeba.org/en/audio/download/522440","words":[{"g":"who"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of / from"},{"g":"this"},{"g":"boat"}]},{"text":"Él es el capitán de un equipo.","en":"He's the captain of a team.","audio":"https://tatoeba.org/en/audio/download/639637","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of / from"},{"g":"a"},{"g":"team"}]},{"text":"Queremos que seas el capitán del equipo.","en":"We want you to be the team captain.","audio":"https://tatoeba.org/en/audio/download/594747","words":[{"g":"to desire","l":"querer"},{"g":"that"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of the"},{"g":"team"}]}]}