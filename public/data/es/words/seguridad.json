{"id":"seguridad","lemma":"seguridad","pos":"noun","rank":366,"glosses":["safety, security","self-confidence"],"ipa":"/seɡuɾiˈdad/","gender":"f","forms":{"plural":"seguridades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-AdrianAbdulBaha-seguridad.wav","examples":[{"text":"He llamado a seguridad.","en":"I called security.","audio":"https://tatoeba.org/en/audio/download/821302"},{"text":"Lo sé con seguridad.","en":"I know it for sure.","audio":"https://tatoeba.org/en/audio/download/449408"},{"text":"¿Puedes garantizar nuestra seguridad?","en":"Can you guarantee our safety?","audio":"https://tatoeba.org/en/audio/download/600237"},{"text":"¿Hay actualizaciones de seguridad?","en":"Are there any security updates?","audio":"https://tatoeba.org/en/audio/download/439830"},{"text":"No lo sé con seguridad.","en":"I don't know for sure.","audio":"https://tatoeba.org/en/audio/download/454997"}]}