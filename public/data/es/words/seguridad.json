{"id":"seguridad","lemma":"seguridad","pos":"noun","rank":363,"glosses":["safety, security","self-confidence"],"ipa":"/seɡuɾiˈdad/","gender":"f","forms":{"plural":"seguridades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-AdrianAbdulBaha-seguridad.wav","examples":[{"text":"¡Llama a seguridad!","en":"Call security!","audio":"https://tatoeba.org/en/audio/download/440082","words":[{"g":"flame"},{"g":"to"},null]},{"text":"Es por tu propia seguridad.","en":"It's for your own safety.","audio":"https://tatoeba.org/en/audio/download/611767","words":[{"g":"to be","l":"ser"},{"g":"for / by"},{"g":"your"},{"g":"own","l":"propio"},null]},{"text":"Ella está preocupada por tu seguridad.","en":"She's worried about your safety.","audio":"https://tatoeba.org/en/audio/download/684406","words":[{"g":"she"},{"g":"to be","l":"estar"},{"g":"worried, concerned","l":"preocupado"},{"g":"for / by"},{"g":"your"},null]},{"text":"Estaba muy preocupado por tu seguridad.","en":"I was very concerned for your safety.","audio":"https://tatoeba.org/en/audio/download/582005","words":[{"g":"to be","l":"estar"},null,{"g":"worried, concerned"},{"g":"for / by"},{"g":"your"},null]},{"text":"He llamado a seguridad.","en":"I called security.","audio":"https://tatoeba.org/en/audio/download/821302","words":[{"g":"to have","l":"haber"},{"g":"called"},{"g":"to"},null]}]}