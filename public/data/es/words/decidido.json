{"id":"decidido","lemma":"decidido","pos":"adj","rank":982,"glosses":["decided","purposeful","determined"],"ipa":"/deθiˈdido/","forms":{"feminine":"decidida","masculinePlural":"decididos","femininePlural":"decididas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Txtdgtl-decidido.wav","examples":[{"text":"Han decidido no venir.","en":"They've decided not to come.","audio":"https://tatoeba.org/en/audio/download/330790"},{"text":"Estoy decidida a ganar esta lucha.","en":"I'm determined to win this fight."},{"text":"¿Ya os habéis decidido?","en":"Have you made up your mind yet?","audio":"https://tatoeba.org/en/audio/download/721765"},{"text":"Estoy decidida a ganar esta pelea.","en":"I'm determined to win this fight."},{"text":"He decidido hacerlo sola.","en":"I've decided to do that by myself.","audio":"https://tatoeba.org/en/audio/download/430282"}]}