{"id":"decidido","lemma":"decidido","pos":"adj","rank":979,"glosses":["decided","purposeful","determined"],"ipa":"/deθiˈdido/","forms":{"feminine":"decidida","masculinePlural":"decididos","femininePlural":"decididas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/89/LL-Q1321_%28spa%29-Txtdgtl-decidido.wav","examples":[{"text":"¿Todavía no te has decidido?","en":"Haven't you decided yet?","audio":"https://tatoeba.org/en/audio/download/458980","words":[{"g":"still, yet"},{"g":"no / not"},{"g":"you"},{"g":"to have","l":"haber"},null]},{"text":"Me he decidido.","en":"I made my decision.","audio":"https://tatoeba.org/en/audio/download/449897","words":[{"g":"me"},{"g":"to have","l":"haber"},null]},{"text":"Eres decidida.","en":"You're decisive.","audio":"https://tatoeba.org/en/audio/download/442364","words":[{"g":"to be","l":"ser"},null]},{"text":"He decidido que me quedaré aquí.","en":"I decided to stay here.","audio":"https://tatoeba.org/en/audio/download/71181","words":[{"g":"to have","l":"haber"},null,{"g":"that"},{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"here"}]},{"text":"Estoy decidida a ganar esta lucha.","en":"I'm determined to win this fight.","words":[{"g":"to be","l":"estar"},null,{"g":"to"},{"g":"to gain"},{"g":"this","l":"este"},{"g":"fight, fighting, fray"}]}]}