{"id":"cantidad","lemma":"cantidad","pos":"noun","rank":1029,"glosses":["amount","quantity","figure"],"ipa":"/kantiˈdad/","gender":"f","forms":{"plural":"cantidades"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-AdrianAbdulBaha-cantidad.wav","examples":[{"text":"Es una cantidad considerable.","en":"It's a large amount.","audio":"https://tatoeba.org/en/audio/download/449353"},{"text":"Hay una cantidad limitada.","en":"Quantities are limited.","audio":"https://tatoeba.org/en/audio/download/460949"},{"text":"Prefiero calidad a cantidad.","en":"I prefer quality to quantity.","audio":"https://tatoeba.org/en/audio/download/524812"},{"text":"Cualquier cantidad de dinero servirá.","en":"Any amount of money will do.","audio":"https://tatoeba.org/en/audio/download/1061757"},{"text":"Él bebe demasiada cantidad de cerveza.","en":"He drinks too much beer.","audio":"https://tatoeba.org/en/audio/download/527481"}]}