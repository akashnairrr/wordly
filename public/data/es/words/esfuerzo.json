{"id":"esfuerzo","lemma":"esfuerzo","pos":"noun","rank":1440,"glosses":["effort, endeavor"],"ipa":"/esˈfweɾθo/","gender":"m","forms":{"plural":"esfuerzos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3e/LL-Q1321_%28spa%29-Marreromarco-esfuerzo.wav","examples":[{"text":"Fue un esfuerzo colectivo.","en":"It was a group effort.","audio":"https://tatoeba.org/en/audio/download/460918"},{"text":"Deberíamos considerar unir esfuerzos.","en":"We should consider a combined effort.","audio":"https://tatoeba.org/en/audio/download/704383"},{"text":"Gracias por el esfuerzo.","en":"Thanks for the effort.","audio":"https://tatoeba.org/en/audio/download/460837"},{"text":"Sus esfuerzos fueron en vano.","en":"His efforts were in vain.","audio":"https://tatoeba.org/en/audio/download/1152176"},{"text":"El esfuerzo se verá recompensado.","en":"It's going to pay off.","audio":"https://tatoeba.org/en/audio/download/302012"}]}