{"id":"foto","lemma":"foto","pos":"noun","rank":528,"glosses":["photo, photograph"],"ipa":"/ˈfoto/","gender":"f","forms":{"plural":"fotos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/44/LL-Q1321_%28spa%29-AdrianAbdulBaha-foto.wav","examples":[{"text":"Él sacó una foto.","en":"He took a picture.","audio":"https://tatoeba.org/en/audio/download/443894"},{"text":"Tom vio las fotos.","en":"Tom saw the pictures.","audio":"https://tatoeba.org/en/audio/download/801489"},{"text":"Él tomó una foto.","en":"He took a picture.","audio":"https://tatoeba.org/en/audio/download/443895"},{"text":"Esas fotos son suyas.","en":"Those photos are hers.","audio":"https://tatoeba.org/en/audio/download/461096"},{"text":"Me encanta esta foto.","en":"I love this photo.","audio":"https://tatoeba.org/en/audio/download/444341"}]}