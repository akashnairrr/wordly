{"id":"alarma","lemma":"alarma","pos":"noun","rank":1632,"glosses":["alarm (a summons to arms)","alarm (a sound intended to give notice of approaching danger)","alarm (a mechanical device for rousing attention)"],"ipa":"/aˈlaɾma/","gender":"f","forms":{"plural":"alarmas"},"order":1683,"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-alarma.wav","examples":[{"text":"Da la alarma.","en":"Sound the alarm.","audio":"https://tatoeba.org/en/audio/download/722119","words":[{"g":"to give, to give out","l":"dar"},{"g":"the / her"},null]},{"text":"Era una falsa alarma.","en":"It was a false alarm.","audio":"https://tatoeba.org/en/audio/download/454064","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"false","l":"falso"},null]},{"text":"Olvidé poner la alarma.","en":"I forgot to set the alarm.","words":[{"g":"to forget","l":"olvidar"},{"g":"to put, to place"},{"g":"the / her"},null]}]}