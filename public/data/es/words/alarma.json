{"id":"alarma","lemma":"alarma","pos":"noun","rank":1634,"glosses":["alarm (a summons to arms)","alarm (a sound intended to give notice of approaching danger)","alarm (a mechanical device for rousing attention)"],"ipa":"/aˈlaɾma/","gender":"f","forms":{"plural":"alarmas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Marreromarco-alarma.wav","examples":[{"text":"Haz sonar la alarma.","en":"Sound the alarm.","audio":"https://tatoeba.org/en/audio/download/722120"},{"text":"Tomás instaló un sistema de alarmas en su casa.","en":"Tom installed an alarm system in his house.","audio":"https://tatoeba.org/en/audio/download/732819"},{"text":"Era una falsa alarma.","en":"It was a false alarm.","audio":"https://tatoeba.org/en/audio/download/454064"},{"text":"Hoy tuvimos dos falsas alarmas.","en":"Today, we had two false alarms."},{"text":"Tom apagó la alarma.","en":"Tom turned off the alarm.","audio":"https://tatoeba.org/en/audio/download/165550"}]}