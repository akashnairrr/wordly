{"id":"demora","lemma":"demora","pos":"noun","rank":4395,"glosses":["delay"],"ipa":"/deˈmoɾa/","gender":"f","forms":{"plural":"demoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Marreromarco-demora.wav","examples":[{"text":"Deberían hacerlo sin demora.","en":"You ought to do that right away.","audio":"https://tatoeba.org/en/audio/download/462104","words":[{"g":"to owe","l":"deber"},{"g":"to do","l":"hacer"},{"g":"without"},null]},{"text":"Es necesario discutir el problema sin demora.","en":"It's necessary to discuss the problem without delay.","words":[{"g":"to be","l":"ser"},{"g":"necessary, requisite"},{"g":"to discuss, to argue"},{"g":"the"},{"g":"problem"},{"g":"without"},null]},{"text":"Siento la demora en contestar.","en":"I'm sorry for the delay in responding.","audio":"https://tatoeba.org/en/audio/download/705879","words":[{"g":"to seat","l":"sentar"},{"g":"the / her"},null,{"g":"in / on"},{"g":"to reply"}]},{"text":"Nos disculpamos por la demora.","en":"We apologize for the delay.","words":[{"g":"us"},{"g":"to excuse","l":"disculpar"},{"g":"for / by"},{"g":"the / her"},null]},{"text":"¿Cuánto tiempo crees que demora en llegar al aeropuerto?","en":"How long do you think it will take to go to the airport?","words":[null,null,{"g":"to believe","l":"creer"},{"g":"that"},null,{"g":"in / on"},{"g":"to arrive, get"},{"g":"to the"},{"g":"airport"}],"phrases":[[0,2,"how long"]]}]}