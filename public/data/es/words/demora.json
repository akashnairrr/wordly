{"id":"demora","lemma":"demora","pos":"noun","rank":4397,"glosses":["delay"],"ipa":"/deˈmoɾa/","gender":"f","forms":{"plural":"demoras"},"order":4398,"audio":"https://upload.wikimedia.org/wikipedia/commons/9/90/LL-Q1321_%28spa%29-Marreromarco-demora.wav","examples":[{"text":"Deberían hacerlo sin demora.","en":"You ought to do that right away.","audio":"https://tatoeba.org/en/audio/download/462104","words":[{"g":"to owe","l":"deber"},{"g":"to do","l":"hacer"},{"g":"without"},null]},{"text":"Es necesario discutir el problema sin demora.","en":"It's necessary to discuss the problem without delay.","words":[{"g":"to be","l":"ser"},{"g":"necessary, requisite"},{"g":"to discuss, to argue"},{"g":"the"},{"g":"problem"},{"g":"without"},null]},{"text":"Siento la demora en contestar.","en":"I'm sorry for the delay in responding.","audio":"https://tatoeba.org/en/audio/download/705879","words":[{"g":"to seat","l":"sentar"},{"g":"the / her"},null,{"g":"in / on"},{"g":"to reply"}]}]}