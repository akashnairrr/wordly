{"id":"colgado","lemma":"colgado","pos":"adj","rank":2951,"glosses":["hanging","crazy","frustrated, left behind, deceived"],"ipa":"/kolˈɡado/","forms":{"feminine":"colgada","masculinePlural":"colgados","femininePlural":"colgadas"},"examples":[{"text":"Esa pintura está colgada boca abajo.","en":"The picture is hung upside down.","audio":"https://tatoeba.org/en/audio/download/706632","words":[{"g":"that","l":"ese"},{"g":"painting"},{"g":"to be","l":"estar"},null,null,null],"phrases":[[4,6,"face-down/face down"]]},{"text":"Estamos colgados.","en":"We're stranded.","audio":"https://tatoeba.org/en/audio/download/441297","words":[{"g":"to be","l":"estar"},null]},{"text":"El calendario está colgado en la pared.","en":"The calendar is hanging on the wall.","words":[{"g":"the"},{"g":"calendar"},{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"the / her"},{"g":"wall"}]},{"text":"Un retrato de mi abuelo está colgado en la pared.","en":"My grandfather's picture is on the wall.","audio":"https://tatoeba.org/en/audio/download/609254","words":[{"g":"a"},{"g":"portrait"},{"g":"of / from"},{"g":"my"},{"g":"grandfather"},{"g":"to be","l":"estar"},null,{"g":"in / on"},{"g":"the / her"},{"g":"wall"}]},{"text":"Sé que Tom no me dejaría colgada.","en":"I know Tom wouldn't leave me stranded.","audio":"https://tatoeba.org/en/audio/download/803466","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},null,{"g":"no / not"},{"g":"me"},{"g":"to leave","l":"dejar"},null]}]}