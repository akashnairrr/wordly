{"id":"papa","lemma":"papa","pos":"noun","rank":1031,"glosses":["potato","chips, crisps (packaged thin, salted, fried slice of potato)"],"ipa":"/ˈpapa/","gender":"f","forms":{"plural":"papas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/df/LL-Q1321_%28spa%29-Millars-papa.wav","examples":[{"text":"Comimos sopa de papa.","en":"We ate potato soup.","audio":"https://tatoeba.org/en/audio/download/501489"},{"text":"Cueza usted esas papas.","en":"Boil those potatoes.","audio":"https://tatoeba.org/en/audio/download/586865"},{"text":"Nosotros comimos sopa de papa.","en":"We ate potato soup.","audio":"https://tatoeba.org/en/audio/download/501490"},{"text":"Papas grandes por favor.","en":"Large fries, please.","audio":"https://tatoeba.org/en/audio/download/799949"},{"text":"¿Quién será el próximo papa?","en":"Who will be the next pope?"}]}