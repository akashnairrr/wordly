{"id":"pleno","lemma":"pleno","pos":"adj","rank":3882,"glosses":["full (containing the maximum amount possible)","plenary","fulfilling"],"ipa":"/ˈpleno/","forms":{"feminine":"plena","masculinePlural":"plenos","femininePlural":"plenas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-AdrianAbdulBaha-pleno.wav","examples":[{"text":"Estamos en pleno verano.","en":"We're in the middle of summer.","audio":"https://tatoeba.org/en/audio/download/301024","words":[{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"summer"}]},{"text":"Garantizamos nuestro pleno apoyo.","en":"We guarantee our full support.","audio":"https://tatoeba.org/en/audio/download/858096","words":[{"g":"to guarantee","l":"garantizar"},{"g":"our, ours, to us"},null,{"g":"support"}]},{"text":"Tengo plena confianza en mi médico.","en":"I have complete faith in my doctor.","words":[{"g":"to have","l":"tener"},null,{"g":"confidence, trust"},{"g":"in / on"},{"g":"my"},{"g":"doctor"}]},{"text":"No es bueno regar las plantas a pleno sol.","en":"It's not good to water plants in direct sunlight.","audio":"https://tatoeba.org/en/audio/download/301681","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"good"},{"g":"to irrigate"},{"g":"the / them"},{"g":"plant or of the…","l":"planta"},{"g":"to"},null,{"g":"sun"}]},{"text":"Tom gritó a pleno pulmón.","en":"Tom screamed at the top of his lungs.","audio":"https://tatoeba.org/en/audio/download/801924","words":[null,{"g":"to shout","l":"gritar"},{"g":"to"},null,{"g":"lung"}]}]}