{"id":"crimen","lemma":"crimen","pos":"noun","rank":680,"glosses":["crime","violent crime"],"ipa":"/ˈkɾimen/","gender":"m","forms":{"plural":"crímenes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/96/LL-Q1321_%28spa%29-AdrianAbdulBaha-crimen.wav","examples":[{"text":"El crimen no paga.","en":"Crime doesn't pay.","audio":"https://tatoeba.org/en/audio/download/444434"},{"text":"¿Qué crímenes has cometido?","en":"What crimes have you committed?","audio":"https://tatoeba.org/en/audio/download/585863"},{"text":"El crimen no compensa.","en":"Crime doesn't pay.","audio":"https://tatoeba.org/en/audio/download/221687"},{"text":"¿Qué crímenes ha cometido usted?","en":"What crimes have you committed?","audio":"https://tatoeba.org/en/audio/download/585864"},{"text":"Ha cometido un crimen.","en":"She committed a crime.","audio":"https://tatoeba.org/en/audio/download/68575"}]}