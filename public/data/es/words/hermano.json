{"id":"hermano","lemma":"hermano","pos":"noun","rank":202,"glosses":["brother","sibling","bro, dude (friendly term of address for a male of similar age.)"],"ipa":"/eɾˈmano/","gender":"m","forms":{"plural":"hermanos","feminine":"hermana","femininePlural":"hermanas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/67/LL-Q1321_%28spa%29-AdrianAbdulBaha-hermano.wav","formAudio":{"hermanos":"https://upload.wikimedia.org/wikipedia/commons/b/b2/LL-Q1321_%28spa%29-Wikipedian-walker-hermanos.wav","hermana":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-AdrianAbdulBaha-hermana.wav"},"examples":[{"text":"Tengo un hermano gemelo.","en":"I have a twin.","audio":"https://tatoeba.org/en/audio/download/440262"},{"text":"Ellos son mis hermanos.","en":"They are my brothers.","audio":"https://tatoeba.org/en/audio/download/524448"},{"text":"Tengo una hermana gemela.","en":"I have a twin.","audio":"https://tatoeba.org/en/audio/download/440235"},{"text":"Llama a tus hermanas.","en":"Call your sisters.","audio":"https://tatoeba.org/en/audio/download/636721"},{"text":"Lo hizo mi hermano.","en":"My brother did.","audio":"https://tatoeba.org/en/audio/download/636703"}]}