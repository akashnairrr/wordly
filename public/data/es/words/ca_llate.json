{"id":"ca_llate","lemma":"cállate","pos":"intj","rank":476,"glosses":["shut up!"],"ipa":"/ˈkaʝate/","examples":[{"text":"Cállate, por favor.","en":"Please shut up.","audio":"https://tatoeba.org/en/audio/download/441145","words":[null,null,null],"phrases":[[1,3,"please"]]},{"text":"Cállate y hazlo.","en":"Shut up and do it.","audio":"https://tatoeba.org/en/audio/download/604965","words":[null,{"g":"and"},{"g":"to do","l":"hacer"}]},{"text":"Haz el favor y cállate.","en":"Just please be quiet.","audio":"https://tatoeba.org/en/audio/download/454909","words":[{"g":"to do","l":"hacer"},{"g":"the"},{"g":"favor/favour"},{"g":"and"},null]},{"text":"Por favor cállate y déjame terminar.","en":"Please be quiet and let me finish.","audio":"https://tatoeba.org/en/audio/download/582003","words":[null,null,null,{"g":"and"},{"g":"to leave","l":"dejar"},{"g":"to finish"}],"phrases":[[0,2,"please"]]},{"text":"¡Cállate y sigue trabajando!","en":"Shut up and keep working!","words":[null,{"g":"and"},{"g":"to follow","l":"seguir"},{"g":"to work","l":"trabajar"}]}]}