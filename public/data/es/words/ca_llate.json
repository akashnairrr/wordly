{"id":"ca_llate","lemma":"cállate","pos":"intj","rank":479,"glosses":["shut up!"],"ipa":"/ˈkaʝate/","examples":[{"text":"Haz el favor y cállate.","en":"Just please be quiet.","audio":"https://tatoeba.org/en/audio/download/454909"},{"text":"Por favor cállate y déjame terminar.","en":"Please be quiet and let me finish.","audio":"https://tatoeba.org/en/audio/download/582003"},{"text":"¡Cállate y sigue trabajando!","en":"Shut up and keep working!"},{"text":"Cállate y déjame pensar.","en":"Shut up and let me think."},{"text":"Hazme un favor y cállate.","en":"Do me a favor and shut up."}]}