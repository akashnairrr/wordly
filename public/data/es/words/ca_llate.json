{"id":"ca_llate","lemma":"cállate","pos":"intj","rank":476,"glosses":["shut up!"],"ipa":"/ˈkaʝate/","examples":[{"text":"Cállate y hazlo.","en":"Shut up and do it.","audio":"https://tatoeba.org/en/audio/download/604965","words":[null,{"g":"and"},{"g":"to do","l":"hacer"}]},{"text":"Hazme un favor y cállate.","en":"Do me a favor and shut up.","words":[{"g":"to do","l":"hacer"},{"g":"a"},{"g":"favor/favour"},{"g":"and"},null]},{"text":"Cállate y déjame pensar.","en":"Shut up and let me think.","words":[null,{"g":"and"},{"g":"to leave","l":"dejar"},{"g":"to think, ponder"}]},{"text":"Por favor cállate y déjame terminar.","en":"Please be quiet and let me finish.","audio":"https://tatoeba.org/en/audio/download/582003","words":[null,null,null,{"g":"and"},{"g":"to leave","l":"dejar"},{"g":"to finish"}],"phrases":[[0,2,"please"]]},{"text":"¡Cállate y sigue trabajando!","en":"Shut up and keep working!","words":[null,{"g":"and"},{"g":"to follow","l":"seguir"},{"g":"to work","l":"trabajar"}]}]}