{"id":"ah","lemma":"ah","pos":"intj","rank":205,"glosses":["ah (expression of relief, realization, awe)","ah (expression of woe, grief)"],"ipa":"/ˈa/","examples":[{"text":"Ah, eso está mucho mejor.","en":"Ah, that's much better.","audio":"https://tatoeba.org/en/audio/download/636752"},{"text":"Ah, ya sé dónde estamos.","en":"Oh, I know where we are now.","audio":"https://tatoeba.org/en/audio/download/831328"},{"text":"\"Ah\" es una interjección.","en":"\"Ah\" is an interjection."},{"text":"Ah, entiendo.","en":"Oh, I got it.","audio":"https://tatoeba.org/en/audio/download/637229"},{"text":"¡Ah! ¡Que barato!","en":"Wow! That's cheap!","audio":"https://tatoeba.org/en/audio/download/798932"}]}