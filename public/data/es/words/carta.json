{"id":"carta","lemma":"carta","pos":"noun","rank":572,"glosses":["letter (document)","map","menu (list of dishes in a restaurant)"],"ipa":"/ˈkaɾta/","gender":"f","forms":{"plural":"cartas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/73/LL-Q1321_%28spa%29-AdrianAbdulBaha-carta.wav","examples":[{"text":"He leído una carta.","en":"I read a letter.","audio":"https://tatoeba.org/en/audio/download/636980"},{"text":"Juguemos a las cartas.","en":"Let's play cards.","audio":"https://tatoeba.org/en/audio/download/50391"},{"text":"Él escribió una carta.","en":"He wrote a letter.","audio":"https://tatoeba.org/en/audio/download/524807"},{"text":"Te escribí tres cartas.","en":"I wrote you three letters.","audio":"https://tatoeba.org/en/audio/download/630579"},{"text":"He recibido tu carta.","en":"I got your letter.","audio":"https://tatoeba.org/en/audio/download/444094"}]}