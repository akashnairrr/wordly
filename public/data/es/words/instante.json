{"id":"instante","lemma":"instante","pos":"noun","rank":1985,"glosses":["instant, moment"],"ipa":"/insˈtante/","gender":"m","forms":{"plural":"instantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f2/LL-Q1321_%28spa%29-Marreromarco-instante.wav","examples":[{"text":"El niño murió al instante.","en":"The child died instantly.","audio":"https://tatoeba.org/en/audio/download/732836","words":[null,null,{"g":"to die","l":"morir"},{"g":"to the"},null],"phrases":[[0,2,"the Christ child"]]},{"text":"No quiero perder un instante más.","en":"I don't want to waste a moment more.","audio":"https://tatoeba.org/en/audio/download/590468","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to lose"},{"g":"a"},null,{"g":"more"}]},{"text":"El avión va a aterrizar dentro de instantes.","en":"The plane will land before long.","words":[{"g":"the"},{"g":"aeroplane"},{"g":"okay"},{"g":"to"},{"g":"to land"},null,null,null],"phrases":[[5,7,"in, inside"]]},{"text":"Él vaciló un instante.","en":"He hesitated for a moment.","audio":"https://tatoeba.org/en/audio/download/639600","words":[{"g":"he"},null,{"g":"a"},null]},{"text":"Guardaron silencio por un instante.","en":"They were silent for a moment.","audio":"https://tatoeba.org/en/audio/download/1253360","words":[{"g":"to save","l":"guardar"},{"g":"silence"},{"g":"for / by"},{"g":"a"},null]}]}