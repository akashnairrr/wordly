{"id":"universo","lemma":"universo","pos":"noun","rank":1087,"glosses":["universe"],"ipa":"/uniˈbeɾso/","gender":"m","forms":{"plural":"universos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f7/LL-Q1321_%28spa%29-Eavqwiki-universo.wav","formAudio":{"universos":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-Eavqwiki-universos.wav"},"examples":[{"text":"Dios creó el universo.","en":"God made the universe.","audio":"https://tatoeba.org/en/audio/download/636722"},{"text":"Vivimos en universos diferentes.","en":"We live in different universes.","audio":"https://tatoeba.org/en/audio/download/825952"},{"text":"El universo es infinito.","en":"The universe is endless.","audio":"https://tatoeba.org/en/audio/download/639240"},{"text":"Vivimos en universos distintos.","en":"We live in different universes.","audio":"https://tatoeba.org/en/audio/download/825953"},{"text":"¿Cuántos años tiene el universo?","en":"How old is the universe?","audio":"https://tatoeba.org/en/audio/download/639239"}]}