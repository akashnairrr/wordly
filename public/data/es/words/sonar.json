{"id":"sonar","lemma":"sonar","pos":"verb","rank":438,"glosses":["to sound, to ring","to sound (appear)","to ring a bell, to be familiar"],"ipa":"/soˈnaɾ/","conjugation":{"indicative":{"present":{"1s":"sueno","2s":"suenas","3s":"suena","1p":"sonamos","2p":"sonáis","3p":"suenan"},"imperfect":{"1s":"sonaba","2s":"sonabas","3s":"sonaba","1p":"sonábamos","2p":"sonabais","3p":"sonaban"},"preterite":{"1s":"soné","2s":"sonaste","3s":"sonó","1p":"sonamos","2p":"sonasteis","3p":"sonaron"},"future":{"1s":"sonaré","2s":"sonarás","3s":"sonará","1p":"sonaremos","2p":"sonaréis","3p":"sonarán"},"conditional":{"1s":"sonaría","2s":"sonarías","3s":"sonaría","1p":"sonaríamos","2p":"sonaríais","3p":"sonarían"}},"subjunctive":{"present":{"1s":"suene","2s":"suenes","3s":"suene","1p":"sonemos","2p":"sonéis","3p":"suenen"},"imperfect":{"1s":"sonara","2s":"sonaras","3s":"sonara","1p":"sonáramos","2p":"sonarais","3p":"sonaran"}},"imperative":{"affirmative":{"2s":"suena","3s":"suene","1p":"sonemos","2p":"sonad","3p":"suenen"},"negative":{"2s":"suenes","3s":"suene","1p":"sonemos","2p":"sonéis","3p":"suenen"}}},"nonFinite":{"gerund":"sonando","participle":"sonado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/25/LL-Q1321_%28spa%29-Marreromarco-sonar.wav","examples":[{"text":"Haz sonar la alarma.","en":"Sound the alarm.","audio":"https://tatoeba.org/en/audio/download/722120"},{"text":"¿Está sonando el teléfono?","en":"Is the phone ringing?","audio":"https://tatoeba.org/en/audio/download/636662"},{"text":"Todavía no ha sonado la campana.","en":"The bell hasn't rung yet.","audio":"https://tatoeba.org/en/audio/download/639475"},{"text":"¿Sueno como si estuviera enamorado?","en":"Do I sound like I'm in love?","audio":"https://tatoeba.org/en/audio/download/1152343"},{"text":"Cuando lo dices, suenas como papá.","en":"When you say this, you sound just like father.","audio":"https://tatoeba.org/en/audio/download/693230"}]}