{"id":"decepcio_n","lemma":"decepción","pos":"noun","rank":4066,"glosses":["disappointment, let-down","disillusionment","bummer"],"ipa":"/deθebˈθjon/","gender":"f","forms":{"plural":"decepciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Marreromarco-decepci%C3%B3n.wav","examples":[{"text":"La fiesta fue una gran decepción.","en":"The party was a big disappointment.","audio":"https://tatoeba.org/en/audio/download/705666","words":[{"g":"the / her"},{"g":"party"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"No le decepciones.","en":"Don't disappoint him.","audio":"https://tatoeba.org/en/audio/download/44204","words":[{"g":"no / not"},{"g":"him / her"},null]},{"text":"¡Qué decepción!","en":"What a disappointment!","audio":"https://tatoeba.org/en/audio/download/459561","words":[{"g":"what"},null]},{"text":"He sido una decepción para mis padres.","en":"I've been a disappointment to my parents.","audio":"https://tatoeba.org/en/audio/download/704037","words":[{"g":"to have","l":"haber"},{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"for"},{"g":"my"},{"g":"father, parent","l":"padre"}]},{"text":"¡No me decepciones!","en":"Don't disappoint me.","audio":"https://tatoeba.org/en/audio/download/798929","words":[{"g":"no / not"},{"g":"me"},null]}]}