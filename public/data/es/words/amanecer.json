{"id":"amanecer","lemma":"amanecer","pos":"verb","rank":1893,"glosses":["to dawn","to get light (become light in the morning)","to wake up (cease to sleep)"],"ipa":"/amaneˈθeɾ/","conjugation":{"indicative":{"present":{"3s":"amanece","1s":"amanezco","2s":"amaneces","1p":"amanecemos","2p":"amanecéis","3p":"amanecen"},"imperfect":{"3s":"amanecía","1s":"amanecía","2s":"amanecías","1p":"amanecíamos","2p":"amanecíais","3p":"amanecían"},"preterite":{"3s":"amaneció","1s":"amanecí","2s":"amaneciste","1p":"amanecimos","2p":"amanecisteis","3p":"amanecieron"},"future":{"3s":"amanecerá","1s":"amaneceré","2s":"amanecerás","1p":"amaneceremos","2p":"amaneceréis","3p":"amanecerán"},"conditional":{"3s":"amanecería","1s":"amanecería","2s":"amanecerías","1p":"amaneceríamos","2p":"amaneceríais","3p":"amanecerían"}},"subjunctive":{"present":{"3s":"amanezca","1s":"amanezca","2s":"amanezcas","1p":"amanezcamos","2p":"amanezcáis","3p":"amanezcan"},"imperfect":{"3s":"amaneciera","1s":"amaneciera","2s":"amanecieras","1p":"amaneciéramos","2p":"amanecierais","3p":"amanecieran"}},"imperative":{"affirmative":{"2s":"amanece","3s":"amanezca","1p":"amanezcamos","2p":"amaneced","3p":"amanezcan"},"negative":{"2s":"amanezcas","3s":"amanezca","1p":"amanezcamos","2p":"amanezcáis","3p":"amanezcan"}}},"nonFinite":{"gerund":"amaneciendo","participle":"amanecido"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q1321_%28spa%29-AdrianAbdulBaha-amanecer.wav","examples":[{"text":"El amanecer está cerca.","en":"It's nearly dawn.","audio":"https://tatoeba.org/en/audio/download/442832"},{"text":"Está amaneciendo.","en":"The dawn is breaking.","audio":"https://tatoeba.org/en/audio/download/732552"},{"text":"En verano amanece más temprano que en invierno.","en":"In the summer, it dawns earlier than in the winter."},{"text":"El estanque amaneció completamente helado.","en":"The pond was completely frozen in the morning."},{"text":"Hoy amanecí vacío de ideas.","en":"Today I'm all out of ideas."}]}