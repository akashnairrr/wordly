{"id":"paz","lemma":"paz","pos":"noun","rank":387,"glosses":["peace (warlessness)","peace (a state of tranquility, quiet, and harmony)"],"ipa":"/ˈpaθ/","gender":"f","forms":{"plural":"paces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/54/LL-Q1321_%28spa%29-AdrianAbdulBaha-paz.wav","examples":[{"text":"Me siento en paz.","en":"I feel at ease.","audio":"https://tatoeba.org/en/audio/download/440757"},{"text":"Intentaba hacer las paces.","en":"I was trying to make amends.","audio":"https://tatoeba.org/en/audio/download/526843"},{"text":"Dejadlo en paz, chavales.","en":"Knock it off, guys.","audio":"https://tatoeba.org/en/audio/download/448465"},{"text":"Vinieron a hacer las paces.","en":"They came to make peace.","audio":"https://tatoeba.org/en/audio/download/639340"},{"text":"Ellos viven en paz.","en":"They live in peace.","audio":"https://tatoeba.org/en/audio/download/636715"}]}