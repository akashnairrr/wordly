{"id":"cabello","lemma":"cabello","pos":"noun","rank":1049,"glosses":["hair (mass of hairs)","hair strand"],"ipa":"/kaˈbeʝo/","gender":"m","forms":{"plural":"cabellos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/77/LL-Q1321_%28spa%29-Guergana-cabello.wav","examples":[{"text":"Mi cabello es rubio.","en":"My hair is blond.","audio":"https://tatoeba.org/en/audio/download/798025"},{"text":"Me gusta el cabello corto.","en":"I like short hair.","audio":"https://tatoeba.org/en/audio/download/444080"},{"text":"Ella tiene el cabello largo.","en":"She has long hair.","audio":"https://tatoeba.org/en/audio/download/444322"},{"text":"Ella tiene el cabello corto.","en":"She has short hair.","audio":"https://tatoeba.org/en/audio/download/450228"},{"text":"Mi cabello todavía está mojado.","en":"My hair is still wet.","audio":"https://tatoeba.org/en/audio/download/518842"}]}