{"id":"completo","lemma":"completo","pos":"adj","rank":820,"glosses":["full, complete","completed"],"ipa":"/komˈpleto/","forms":{"feminine":"completa","masculinePlural":"completos","femininePlural":"completas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-AdrianAbdulBaha-completo.wav","formAudio":{"completa":"https://upload.wikimedia.org/wikipedia/commons/d/d2/LL-Q1321_%28spa%29-Marreromarco-completa.wav","completas":"https://upload.wikimedia.org/wikipedia/commons/9/94/LL-Q1321_%28spa%29-Emanuelps27-completas.wav"},"examples":[{"text":"Fue un completo fracaso.","en":"It was a complete failure.","audio":"https://tatoeba.org/en/audio/download/600035"},{"text":"Compra la versión completa.","en":"Buy the full version.","audio":"https://tatoeba.org/en/audio/download/767997"},{"text":"Tom se comió tres completos.","en":"Tom ate three hotdogs."},{"text":"Tengo las obras completas de Shakespeare.","en":"I have the complete works of Shakespeare."},{"text":"Eso es un completo sinsentido.","en":"That's utter nonsense.","audio":"https://tatoeba.org/en/audio/download/461278"}]}