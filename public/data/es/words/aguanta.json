{"id":"aguanta","lemma":"aguanta","pos":"intj","rank":1690,"glosses":["that's crazy","An expression of disbelief at what one has just heard; no way"],"ipa":"/aˈɡwanta/","examples":[{"text":"Aguanta la cuerda.","en":"Hold the rope.","audio":"https://tatoeba.org/en/audio/download/440080","words":[null,{"g":"the / her"},{"g":"rope, cord, string"}]},{"text":"¡Vamos, aguanta ahí!","en":"Come on, hang in there!","words":[{"g":"to go","l":"ir"},null,{"g":"there"}]},{"text":"No aguanta que la traten como a un niño.","en":"She can't stand being treated like a child.","audio":"https://tatoeba.org/en/audio/download/691929","words":[{"g":"no / not"},null,{"g":"that"},{"g":"the / her"},{"g":"to treat","l":"tratar"},{"g":"as"},{"g":"to"},{"g":"a"},{"g":"child, boy"}]},{"text":"Aguanta.","en":"Hang in there.","audio":"https://tatoeba.org/en/audio/download/440115","words":[null]},{"text":"Tom dice que no aguanta más el comportamiento de Mary.","en":"Tom says he can't put up with Mary's behavior any longer.","words":[null,{"g":"to say","l":"decir"},{"g":"that"},{"g":"no / not"},null,{"g":"more"},{"g":"the"},{"g":"behavior"},{"g":"of / from"},null]}]}