{"id":"limpia","lemma":"limpia","pos":"noun","rank":1477,"glosses":["cleansing, cleaning"],"ipa":"/ˈlimpja/","gender":"f","forms":{"plural":"limpias"},"formAudio":{"limpias":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Vanbasten_23-Limpias.wav"},"examples":[{"text":"El agua está limpia.","en":"The water's clean.","audio":"https://tatoeba.org/en/audio/download/501360"},{"text":"Mis manos están limpias.","en":"My hands are clean.","audio":"https://tatoeba.org/en/audio/download/851401"},{"text":"La casa está limpia.","en":"The house is clean.","audio":"https://tatoeba.org/en/audio/download/501377"},{"text":"¿Tienes las manos limpias?","en":"Are your hands clean?","audio":"https://tatoeba.org/en/audio/download/38575"},{"text":"La mesa está limpia.","en":"The table is clean.","audio":"https://tatoeba.org/en/audio/download/1253399"}]}