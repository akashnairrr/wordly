{"id":"leche","lemma":"leche","pos":"noun","rank":972,"glosses":["milk","cum, semen"],"ipa":"/ˈlet͡ʃe/","gender":"f","forms":{"plural":"leches"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1321_%28spa%29-Julie_Samothrace-leche.wav","examples":[{"text":"Me gusta la leche.","en":"I like milk.","audio":"https://tatoeba.org/en/audio/download/438829"},{"text":"Las vacas dan leche.","en":"Cows give milk.","audio":"https://tatoeba.org/en/audio/download/636422"},{"text":"¿Está buena la leche?","en":"Is the milk good?","audio":"https://tatoeba.org/en/audio/download/442617"},{"text":"No puedo beber leche.","en":"I can't drink milk.","audio":"https://tatoeba.org/en/audio/download/116308"},{"text":"La leche se cortó.","en":"The milk went sour.","audio":"https://tatoeba.org/en/audio/download/501173"}]}