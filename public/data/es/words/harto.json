{"id":"harto","lemma":"harto","pos":"adj","rank":1888,"glosses":["tired, fed up","stuffed, sated (having the appetite satisfied)","many"],"ipa":"/ˈaɾto/","forms":{"feminine":"harta","masculinePlural":"hartos","femininePlural":"hartas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-Marreromarco-harto.wav","examples":[{"text":"Estoy harto de ti.","en":"I'm sick of you.","audio":"https://tatoeba.org/en/audio/download/586444"},{"text":"Estoy harta del inglés.","en":"I'm fed up with English.","audio":"https://tatoeba.org/en/audio/download/46108"},{"text":"Todos estamos hartos de esto.","en":"We're all sick of this.","audio":"https://tatoeba.org/en/audio/download/458867"},{"text":"Él me enseñó hartas fotos hermosas.","en":"He showed me a lot of beautiful photos."},{"text":"Empiezo a estar harto.","en":"I'm getting fed up.","audio":"https://tatoeba.org/en/audio/download/586443"}]}