{"id":"harto","lemma":"harto","pos":"adj","rank":1885,"glosses":["tired, fed up","stuffed, sated (having the appetite satisfied)","many"],"ipa":"/ˈaɾto/","forms":{"feminine":"harta","masculinePlural":"hartos","femininePlural":"hartas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-Marreromarco-harto.wav","examples":[{"text":"Me parece que estás harto de mí.","en":"It feels like you're fed up with me.","audio":"https://tatoeba.org/en/audio/download/857936","words":[{"g":"me"},{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"me"}]},{"text":"Estoy harta del inglés.","en":"I'm fed up with English.","audio":"https://tatoeba.org/en/audio/download/46108","words":[{"g":"to be","l":"estar"},null,{"g":"of the"},{"g":"English"}]},{"text":"Todos estamos hartos de esto.","en":"We're all sick of this.","audio":"https://tatoeba.org/en/audio/download/458867","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"this"}]},{"text":"Ya estoy harto.","en":"I'm stuffed.","audio":"https://tatoeba.org/en/audio/download/422694","words":[{"g":"now"},{"g":"to be","l":"estar"},null]},{"text":"Estoy harto de ti.","en":"I'm sick of you.","audio":"https://tatoeba.org/en/audio/download/586444","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"you","l":"tú"}]}]}