{"id":"cobertizo","lemma":"cobertizo","pos":"noun","rank":4816,"glosses":["shed, shack"],"ipa":"/kobeɾˈtiθo/","gender":"m","forms":{"plural":"cobertizos"},"examples":[{"text":"Ellos no tienen un cobertizo.","en":"They don't have a shed.","audio":"https://tatoeba.org/en/audio/download/461667","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"El carro estaba en el cobertizo.","en":"The cart was in the shed.","words":[{"g":"the"},{"g":"cart"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},null]},{"text":"Ellos están o bien en el cobertizo o en el estudio.","en":"They're either in the shed or in the den.","words":[{"g":"they","l":"él"},{"g":"to be","l":"estar"},null,null,{"g":"in / on"},{"g":"the"},null,{"g":"or"},{"g":"in / on"},{"g":"the"},{"g":"study"}],"phrases":[[2,4,"either"]]},{"text":"Tú encontrarás un rastrillo en el cobertizo.","en":"You'll find a rake in the shed.","audio":"https://tatoeba.org/en/audio/download/803688","words":[{"g":"you"},{"g":"to meet","l":"encontrar"},{"g":"a"},{"g":"rake"},{"g":"in / on"},{"g":"the"},null]}]}