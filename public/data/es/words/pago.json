{"id":"pago","lemma":"pago","pos":"noun","rank":1198,"glosses":["pay, payment"],"ipa":"/ˈpaɡo/","gender":"m","forms":{"plural":"pagos"},"examples":[{"text":"¿Dónde pago?","en":"Where should I pay?","audio":"https://tatoeba.org/en/audio/download/448538","words":[{"g":"where"},null]},{"text":"El pago es terrible.","en":"The pay is terrible.","audio":"https://tatoeba.org/en/audio/download/800211","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"terrible"}]},{"text":"¿Dónde pago el gas?","en":"Where do I pay for the gas?","words":[{"g":"where"},null,{"g":"the"},{"g":"gas"}]},{"text":"Creo que el pago es suficiente.","en":"I think the pay is enough.","audio":"https://tatoeba.org/en/audio/download/587213","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"sufficient, enough"}]},{"text":"Tus pagos se retrasan dos meses.","en":"Your payment is now two months overdue.","words":[{"g":"your"},null,{"g":"oneself"},{"g":"to delay","l":"retrasar"},{"g":"dung, excrement"},{"g":"month","l":"mes"}]}]}