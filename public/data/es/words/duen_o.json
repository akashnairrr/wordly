{"id":"duen_o","lemma":"dueño","pos":"noun","rank":1169,"glosses":["owner, proprietor, landlord","master"],"ipa":"/ˈdweɲo/","gender":"m","forms":{"plural":"dueños","feminine":"dueña","femininePlural":"dueñas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q1321_%28spa%29-Rodrigo5260-due%C3%B1o.wav","formAudio":{"dueña":"https://upload.wikimedia.org/wikipedia/commons/2/24/LL-Q1321_%28spa%29-Wikipedian-walker-due%C3%B1a.wav"},"examples":[{"text":"No soy el dueño.","en":"I'm not the owner.","audio":"https://tatoeba.org/en/audio/download/845528"},{"text":"Somos los nuevos dueños.","en":"We're the new owners.","audio":"https://tatoeba.org/en/audio/download/454942"},{"text":"Yo soy dueño de un yate.","en":"I own a yacht.","audio":"https://tatoeba.org/en/audio/download/440367"},{"text":"Muchos dueños de perros sólo los alimentan una vez al día.","en":"Many dog owners only feed their dogs once a day."},{"text":"¿Eres el dueño de esta casa?","en":"Are you the owner of this house?","audio":"https://tatoeba.org/en/audio/download/537859"}]}