{"id":"crisis","lemma":"crisis","pos":"noun","rank":1607,"glosses":["crisis","attack; fit"],"ipa":"/ˈkɾisis/","gender":"f","forms":{"plural":"crisis"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5e/LL-Q1321_%28spa%29-Marreromarco-crisis.wav","examples":[{"text":"Tenemos una crisis.","en":"We have a crisis.","audio":"https://tatoeba.org/en/audio/download/443977","words":[{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"Estamos en medio de una crisis.","en":"We're in the middle of a crisis.","audio":"https://tatoeba.org/en/audio/download/585945","words":[{"g":"to be","l":"estar"},null,null,{"g":"of / from"},{"g":"a"},null],"phrases":[[1,3,"halfway"]]},{"text":"Tom finalmente sufrió una crisis nerviosa.","en":"Tom finally snapped.","audio":"https://tatoeba.org/en/audio/download/800334","words":[null,{"g":"lastly"},{"g":"to suffer","l":"sufrir"},{"g":"a"},null,{"g":"nerve","l":"nervioso"}]},{"text":"Su compañía sobrevivió a la crisis.","en":"Their company survived the crisis.","audio":"https://tatoeba.org/en/audio/download/687394","words":[{"g":"his / her / your"},{"g":"company"},{"g":"to survive","l":"sobrevivir"},{"g":"to"},{"g":"the / her"},null]},{"text":"Vamos a superar esta crisis juntos.","en":"Together, we'll get through this crisis.","audio":"https://tatoeba.org/en/audio/download/633836","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to surpass, exceed"},{"g":"this","l":"este"},null,{"g":"next to","l":"junto"}]}]}