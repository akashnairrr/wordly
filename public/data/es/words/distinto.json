{"id":"distinto","lemma":"distinto","pos":"adv","rank":1762,"glosses":["distinctly"],"ipa":"/disˈtinto/","audio":"https://upload.wikimedia.org/wikipedia/commons/6/64/LL-Q1321_%28spa%29-Marreromarco-distinto.wav","examples":[{"text":"Cada país es distinto.","en":"Every country is different.","audio":"https://tatoeba.org/en/audio/download/508887"},{"text":"Fui por un lugar distinto.","en":"I went a different way.","audio":"https://tatoeba.org/en/audio/download/297596"},{"text":"Se me enseñó algo distinto.","en":"I was taught something different.","audio":"https://tatoeba.org/en/audio/download/78299"},{"text":"No soy distinto de cualquier otro padre.","en":"I'm no different from any other father.","audio":"https://tatoeba.org/en/audio/download/611276"},{"text":"Tom quiere algo distinto.","en":"Tom wants something different."}]}