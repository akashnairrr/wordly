{"id":"demonios","lemma":"demonios","pos":"adv","rank":380,"glosses":["the hell, on earth (for emphasis after a question word)"],"ipa":"/deˈmonjos/","examples":[{"text":"¿Qué demonios es esto?","en":"What in the world is this?","audio":"https://tatoeba.org/en/audio/download/598562"},{"text":"¿Qué demonios significa eso?","en":"What in the world does that mean?","audio":"https://tatoeba.org/en/audio/download/611270"},{"text":"Pero, ¿qué demonios pasa aquí?","en":"What on earth is going on here?","audio":"https://tatoeba.org/en/audio/download/353833"},{"text":"¿Pero qué demonios está pasando aquí?","en":"What's going on anyway?","audio":"https://tatoeba.org/en/audio/download/459988"},{"text":"¿Pero en qué demonios estabas pensando?","en":"What on earth were you thinking?","audio":"https://tatoeba.org/en/audio/download/430168"}]}