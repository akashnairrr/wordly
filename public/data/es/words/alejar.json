{"id":"alejar","lemma":"alejar","pos":"verb","rank":1548,"glosses":["to remove to a distance, put farther away, to lead away, to draw away","to estrange, alienate","to keep at a distance"],"ipa":"/aleˈxaɾ/","conjugation":{"indicative":{"present":{"1s":"alejo","2s":"alejas","3s":"aleja","1p":"alejamos","2p":"alejáis","3p":"alejan"},"imperfect":{"1s":"alejaba","2s":"alejabas","3s":"alejaba","1p":"alejábamos","2p":"alejabais","3p":"alejaban"},"preterite":{"1s":"alejé","2s":"alejaste","3s":"alejó","1p":"alejamos","2p":"alejasteis","3p":"alejaron"},"future":{"1s":"alejaré","2s":"alejarás","3s":"alejará","1p":"alejaremos","2p":"alejaréis","3p":"alejarán"},"conditional":{"1s":"alejaría","2s":"alejarías","3s":"alejaría","1p":"alejaríamos","2p":"alejaríais","3p":"alejarían"}},"subjunctive":{"present":{"1s":"aleje","2s":"alejes","3s":"aleje","1p":"alejemos","2p":"alejéis","3p":"alejen"},"imperfect":{"1s":"alejara","2s":"alejaras","3s":"alejara","1p":"alejáramos","2p":"alejarais","3p":"alejaran"}},"imperative":{"affirmative":{"2s":"aleja","3s":"aleje","1p":"alejemos","2p":"alejad","3p":"alejen"},"negative":{"2s":"alejes","3s":"aleje","1p":"alejemos","2p":"alejéis","3p":"alejen"}}},"nonFinite":{"gerund":"alejando","participle":"alejado"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-Marreromarco-alejar.wav","formAudio":{"aleja":"https://upload.wikimedia.org/wikipedia/commons/6/60/LL-Q1321_%28spa%29-Emanuelps27-aleja.wav"},"examples":[{"text":"El perro se alejó.","en":"The dog went away.","audio":"https://tatoeba.org/en/audio/download/450109","words":[{"g":"the"},{"g":"dog"},{"g":"oneself"},null]},{"text":"No se aleje demasiado.","en":"Don't go too far away.","audio":"https://tatoeba.org/en/audio/download/454213","words":[{"g":"no / not"},{"g":"oneself"},null,{"g":"too much"}]},{"text":"No te alejes de aquí.","en":"Stay close.","audio":"https://tatoeba.org/en/audio/download/438982","words":[{"g":"no / not"},{"g":"you"},null,{"g":"of / from"},{"g":"here"}]},{"text":"Él se alejó corriendo de ella.","en":"He ran away from her.","words":[{"g":"he"},{"g":"oneself"},null,{"g":"to run, to jog","l":"correr"},{"g":"of / from"},{"g":"she"}]},{"text":"Se alejó sin saludarme.","en":"She walked away without acknowledging me.","audio":"https://tatoeba.org/en/audio/download/1253559","words":[{"g":"oneself"},null,{"g":"without"},{"g":"to greet","l":"saludar"}]}]}