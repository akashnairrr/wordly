{"id":"noticia","lemma":"noticia","pos":"noun","rank":462,"glosses":["notice","news, piece of news","message"],"ipa":"/noˈtiθja/","gender":"f","forms":{"plural":"noticias"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Marreromarco-noticia.wav","formAudio":{"noticias":"https://upload.wikimedia.org/wikipedia/commons/8/82/LL-Q1321_%28spa%29-Precision27-noticias.wav"},"examples":[{"text":"¿Es una buena noticia?","en":"Is it good news?","audio":"https://tatoeba.org/en/audio/download/42084"},{"text":"Tengo muy buenas noticias.","en":"I have great news.","audio":"https://tatoeba.org/en/audio/download/443320"},{"text":"Ha circulado esa noticia.","en":"That news got around.","audio":"https://tatoeba.org/en/audio/download/454218"},{"text":"Estoy viendo las noticias.","en":"I'm watching the news.","audio":"https://tatoeba.org/en/audio/download/455408"},{"text":"Esta noticia es oficial.","en":"This news is official.","audio":"https://tatoeba.org/en/audio/download/1187357"}]}