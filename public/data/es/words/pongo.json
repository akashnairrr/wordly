{"id":"pongo","lemma":"pongo","pos":"noun","rank":1284,"glosses":["orangutan"],"ipa":"/ˈponɡo/","gender":"m","forms":{"plural":"pongos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/58/LL-Q1321_%28spa%29-Marreromarco-pongo.wav","examples":[{"text":"Me pongo el pijama.","en":"I put on my pajamas.","audio":"https://tatoeba.org/en/audio/download/450788"},{"text":"Me pongo los pantalones.","en":"I put on my trousers.","audio":"https://tatoeba.org/en/audio/download/34531"},{"text":"Nunca me pongo chaqueta.","en":"I never wear a jacket.","audio":"https://tatoeba.org/en/audio/download/586094"},{"text":"Sólo pongo una condición.","en":"I only have one condition.","audio":"https://tatoeba.org/en/audio/download/586887"},{"text":"Siempre me pongo mi cinturón.","en":"I always wear my seatbelt.","audio":"https://tatoeba.org/en/audio/download/798359"}]}