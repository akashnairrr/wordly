{"id":"pongo","lemma":"pongo","pos":"noun","rank":1281,"glosses":["orangutan"],"ipa":"/ˈponɡo/","gender":"m","forms":{"plural":"pongos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/58/LL-Q1321_%28spa%29-Marreromarco-pongo.wav","examples":[{"text":"Me pongo los pantalones.","en":"I put on my trousers.","audio":"https://tatoeba.org/en/audio/download/34531","words":[{"g":"me"},null,{"g":"the / them"},{"g":"pants, trousers"}]},{"text":"Nunca me pongo chaqueta.","en":"I never wear a jacket.","audio":"https://tatoeba.org/en/audio/download/586094","words":[{"g":"never"},{"g":"me"},null,{"g":"jacket"}]},{"text":"Pongo en peligro mi trabajo en ello.","en":"I'll stake my job on it.","audio":"https://tatoeba.org/en/audio/download/804230","words":[null,null,null,{"g":"my"},{"g":"work, job"},null,null],"phrases":[[1,3,"in danger"],[5,7,"on it"]]},{"text":"Sólo me pongo sombrero en invierno.","en":"I only wear a hat in the winter.","audio":"https://tatoeba.org/en/audio/download/540943","words":[null,{"g":"me"},null,{"g":"hat"},{"g":"in / on"},{"g":"winter"}]},{"text":"Siempre me pongo nervioso en su presencia.","en":"I always get nervous in her presence.","audio":"https://tatoeba.org/en/audio/download/1154782","words":[{"g":"always"},{"g":"me"},null,{"g":"nerve"},{"g":"in / on"},{"g":"his / her / your"},{"g":"presence"}]}]}