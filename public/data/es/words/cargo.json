{"id":"cargo","lemma":"cargo","pos":"noun","rank":712,"glosses":["charge, burden","position, post","debit"],"ipa":"/ˈkaɾɡo/","gender":"m","forms":{"plural":"cargos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-Marreromarco-cargo.wav","examples":[{"text":"Hazte cargo de esto.","en":"Take care of this.","audio":"https://tatoeba.org/en/audio/download/443387"},{"text":"Ambos cargos fueron retirados.","en":"Both charges were withdrawn.","audio":"https://tatoeba.org/en/audio/download/804626"},{"text":"¿Quién estaba a cargo?","en":"Who was in charge?","audio":"https://tatoeba.org/en/audio/download/449508"},{"text":"Niego todos esos cargos.","en":"I deny all those charges."},{"text":"Ella estará a cargo.","en":"She's going to be in charge.","audio":"https://tatoeba.org/en/audio/download/64418"}]}