{"id":"chica","lemma":"chica","pos":"noun","rank":194,"glosses":["gal, chick","A spice made from the Sobralia orchid."],"ipa":"/ˈt͡ʃika/","gender":"f","forms":{"plural":"chicas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1321_%28spa%29-AdrianAbdulBaha-chica.wav","examples":[{"text":"¡Sé una buena chica!","en":"Be a good girl.","audio":"https://tatoeba.org/en/audio/download/599240"},{"text":"Las chicas están locas.","en":"Girls are crazy.","audio":"https://tatoeba.org/en/audio/download/637134"},{"text":"Veo a la chica.","en":"I see the girl.","audio":"https://tatoeba.org/en/audio/download/799930"},{"text":"Conozco a aquellas chicas.","en":"I know those girls.","audio":"https://tatoeba.org/en/audio/download/50323"},{"text":"Conozco a la chica.","en":"I know the girl.","audio":"https://tatoeba.org/en/audio/download/441531"}]}