{"id":"azu_car","lemma":"azúcar","pos":"noun","rank":1586,"glosses":["sugar"],"ipa":"/aˈθukaɾ/","gender":"mf","forms":{"masculine":"azúcar","plural":"azúcares"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-Julie_Samothrace-az%C3%BAcar.wav","examples":[{"text":"El azúcar es dulce.","en":"Sugar is sweet.","audio":"https://tatoeba.org/en/audio/download/636790"},{"text":"Esto no es azúcar.","en":"This isn't sugar.","audio":"https://tatoeba.org/en/audio/download/444008"},{"text":"Necesito algo de azúcar.","en":"I need some sugar.","audio":"https://tatoeba.org/en/audio/download/1191536"},{"text":"No usamos nunca azúcar.","en":"We never use sugar.","audio":"https://tatoeba.org/en/audio/download/68197"},{"text":"Ponle azúcar al té.","en":"Add sugar to the tea.","audio":"https://tatoeba.org/en/audio/download/735734"}]}