{"id":"bebe_","lemma":"bebé","pos":"noun","rank":337,"glosses":["baby"],"ipa":"/beˈbe/","gender":"mf","forms":{"plural":"bebés"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6e/LL-Q1321_%28spa%29-AdrianAbdulBaha-beb%C3%A9.wav","examples":[{"text":"¿Dónde está tu bebé?","en":"Where's your baby?","audio":"https://tatoeba.org/en/audio/download/449548","words":[null,null,{"g":"your"},null],"phrases":[[0,2,"where are you?"]]},{"text":"El bebé necesita a su madre.","en":"The baby needs his mother.","audio":"https://tatoeba.org/en/audio/download/639259","words":[{"g":"the"},null,{"g":"to need","l":"necesitar"},{"g":"to"},{"g":"his / her / your"},{"g":"mother"}]},{"text":"Ese bebé sabe caminar.","en":"That baby knows how to walk.","audio":"https://tatoeba.org/en/audio/download/527493","words":[{"g":"that"},null,{"g":"to know, to understand","l":"saber"},{"g":"to walk"}]},{"text":"¿De dónde vienen los bebés?","en":"Where do babies come from?","words":[{"g":"of / from"},{"g":"where"},{"g":"to come","l":"venir"},{"g":"the / them"},null]},{"text":"Eres un bebé.","en":"You're a baby.","audio":"https://tatoeba.org/en/audio/download/604719","words":[{"g":"to be","l":"ser"},{"g":"a"},null]}]}