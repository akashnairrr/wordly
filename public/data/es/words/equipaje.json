{"id":"equipaje","lemma":"equipaje","pos":"noun","rank":2219,"glosses":["luggage","baggage (portable traveling equipment)"],"ipa":"/ekiˈpaxe/","gender":"m","forms":{"plural":"equipajes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fc/LL-Q1321_%28spa%29-Marreromarco-equipaje.wav","examples":[{"text":"¿Qué hiciste con mi equipaje?","en":"What did you do with my baggage?","words":[{"g":"what"},{"g":"to do","l":"hacer"},{"g":"with"},{"g":"my"},null]},{"text":"He perdido el equipaje.","en":"I lost my luggage.","audio":"https://tatoeba.org/en/audio/download/733757","words":[{"g":"to have","l":"haber"},{"g":"lost"},{"g":"the"},null]},{"text":"¿Has terminado de hacer el equipaje?","en":"Have you finished packing yet?","audio":"https://tatoeba.org/en/audio/download/526772","words":[{"g":"to have","l":"haber"},{"g":"finished"},{"g":"of / from"},{"g":"to do"},{"g":"the"},null]},{"text":"Mi equipaje no llegó. ¿Qué sucedió?","en":"My luggage didn't arrive. What happened?","words":[{"g":"my"},null,{"g":"no / not"},{"g":"to arrive, get","l":"llegar"},{"g":"what"},{"g":"to happen","l":"suceder"}]},{"text":"Haga sitio para el equipaje.","en":"Make room for the baggage.","audio":"https://tatoeba.org/en/audio/download/609923","words":[{"g":"to do","l":"hacer"},{"g":"site, place"},{"g":"for"},{"g":"the"},null]}]}