{"id":"esclavo","lemma":"esclavo","pos":"noun","rank":2366,"glosses":["slave"],"ipa":"/esˈklabo/","gender":"m","forms":{"plural":"esclavos","feminine":"esclava","femininePlural":"esclavas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/58/LL-Q1321_%28spa%29-AdrianAbdulBaha-esclavo.wav","formAudio":{"esclava":"https://upload.wikimedia.org/wikipedia/commons/9/91/LL-Q1321_%28spa%29-Marreromarco-esclava.wav"},"examples":[{"text":"No soy el esclavo de nadie.","en":"I'm nobody's slave.","audio":"https://tatoeba.org/en/audio/download/788680","words":[{"g":"no / not"},{"g":"to be","l":"ser"},{"g":"the"},null,{"g":"of / from"},{"g":"no one"}]},{"text":"Los esclavos hacían la mayor parte del trabajo.","en":"Slaves did most of the work.","audio":"https://tatoeba.org/en/audio/download/1253471","words":[{"g":"the / them"},null,{"g":"to do","l":"hacer"},{"g":"the / her"},{"g":"of age"},{"g":"part"},{"g":"of the"},{"g":"work, job"}]},{"text":"El esclavo intentó huir.","en":"The slave tried to escape.","words":[{"g":"the"},null,{"g":"to try, to attempt","l":"intentar"},{"g":"to flee, to run away"}]},{"text":"Muchos esclavos fueron afrancados.","en":"Many slaves were freed.","words":[{"g":"much","l":"mucho"},null,{"g":"to go","l":"ir"},null]},{"text":"¿Eres un esclavo del hábito?","en":"Are you a creature of habit?","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"of the"},{"g":"habit, custom"}]}]}