{"id":"gigante","lemma":"gigante","pos":"noun","rank":1662,"glosses":["giant","juggernaut"],"ipa":"/xiˈɡante/","gender":"m","forms":{"plural":"gigantes","feminine":"giganta","femininePlural":"gigantas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/05/LL-Q1321_%28spa%29-Marreromarco-gigante.wav","examples":[{"text":"Un pájaro gigante vino volando hacia él.","en":"A gigantic bird came flying toward him.","audio":"https://tatoeba.org/en/audio/download/705526","words":[{"g":"a"},{"g":"bird"},null,{"g":"to come","l":"venir"},{"g":"in flight"},{"g":"toward, towards"},{"g":"he"}]},{"text":"Tokio es una ciudad gigante.","en":"Tokyo is a huge city.","words":[null,{"g":"to be","l":"ser"},{"g":"a"},{"g":"city"},null]},{"text":"Un monstruo gigante viene bajando la montaña.","en":"A huge monster is coming down the mountain.","words":[{"g":"a"},{"g":"monster"},null,{"g":"to come","l":"venir"},{"g":"to go down, come down","l":"bajar"},{"g":"the / her"},{"g":"mountain"}]},{"text":"Los pandas gigantes sólo viven en China.","en":"Giant pandas live only in China.","audio":"https://tatoeba.org/en/audio/download/645280","words":[{"g":"the / them"},{"g":"crooked, bent","l":"pando"},null,null,{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"china"}]},{"text":"¿Qué prefieres: los Gigantes o los Dragones?","en":"Which do you like better, the Giants or the Dragons?","audio":"https://tatoeba.org/en/audio/download/691360","words":[{"g":"what"},{"g":"to prefer","l":"preferir"},{"g":"the / them"},null,{"g":"or"},{"g":"the / them"},{"g":"dragon","l":"dragón"}]}]}