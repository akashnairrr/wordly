{"id":"delicioso","lemma":"delicioso","pos":"adj","rank":1831,"glosses":["delicious, delectable, luscious","delightful"],"ipa":"/deliˈθjoso/","forms":{"feminine":"deliciosa","masculinePlural":"deliciosos","femininePlural":"deliciosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2d/LL-Q1321_%28spa%29-Marreromarco-delicioso.wav","examples":[{"text":"Esto se ve delicioso.","en":"This looks delicious.","audio":"https://tatoeba.org/en/audio/download/455089"},{"text":"La tarta estaba deliciosa.","en":"The pie was delicious.","audio":"https://tatoeba.org/en/audio/download/819388"},{"text":"Los plátanos son deliciosos.","en":"Bananas are delicious."},{"text":"Las galletas estaban deliciosas.","en":"The cookies were delicious.","audio":"https://tatoeba.org/en/audio/download/582492"},{"text":"Se veía tan delicioso.","en":"It looked so delicious.","audio":"https://tatoeba.org/en/audio/download/459356"}]}