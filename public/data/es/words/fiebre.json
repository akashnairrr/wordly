{"id":"fiebre","lemma":"fiebre","pos":"noun","rank":1823,"glosses":["fever"],"ipa":"/ˈfjebɾe/","gender":"f","forms":{"plural":"fiebres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-AdrianAbdulBaha-fiebre.wav","examples":[{"text":"Creo que tengo fiebre.","en":"I think I have a fever.","audio":"https://tatoeba.org/en/audio/download/461915"},{"text":"Parece que tengo fiebre.","en":"I seem to have a temperature.","audio":"https://tatoeba.org/en/audio/download/767707"},{"text":"Tomás murió de fiebre tifoidea.","en":"Tom died of typhus.","audio":"https://tatoeba.org/en/audio/download/519001"},{"text":"Tenía un poco de fiebre.","en":"I had a little fever.","audio":"https://tatoeba.org/en/audio/download/741215"},{"text":"Tengo un poco de fiebre.","en":"I have a small fever.","audio":"https://tatoeba.org/en/audio/download/453282"}]}