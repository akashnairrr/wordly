{"id":"fiebre","lemma":"fiebre","pos":"noun","rank":1820,"glosses":["fever"],"ipa":"/ˈfjebɾe/","gender":"f","forms":{"plural":"fiebres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-AdrianAbdulBaha-fiebre.wav","examples":[{"text":"Yo creo que tengo fiebre.","en":"I seem to have a fever.","audio":"https://tatoeba.org/en/audio/download/458581","words":[{"g":"I"},{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to have","l":"tener"},null]},{"text":"Yo tenía una fiebre muy alta.","en":"I had a very high fever.","audio":"https://tatoeba.org/en/audio/download/458641","words":[{"g":"I"},{"g":"to have","l":"tener"},{"g":"a"},null,null,{"g":"certificate of discharge"}]},{"text":"Tengo fiebre y me duele todo el cuerpo.","en":"I have a fever and I ache all over.","audio":"https://tatoeba.org/en/audio/download/928955","words":[{"g":"to have","l":"tener"},null,{"g":"and"},{"g":"me"},null,{"g":"all"},{"g":"the"},{"g":"body"}]},{"text":"Me quedé en la cama porque tenía fiebre.","en":"I stayed in bed because I had a fever.","audio":"https://tatoeba.org/en/audio/download/871961","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},null,null,null,{"g":"because"},{"g":"to have","l":"tener"},null],"phrases":[[2,5,"in bed"]]},{"text":"Mamá tiene fiebre.","en":"Mom has a fever.","audio":"https://tatoeba.org/en/audio/download/63622","words":[{"g":"mum, mom"},{"g":"to have","l":"tener"},null]}]}