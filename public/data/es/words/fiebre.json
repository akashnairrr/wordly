{"id":"fiebre","lemma":"fiebre","pos":"noun","rank":1819,"glosses":["fever"],"ipa":"/ˈfjebɾe/","gender":"f","forms":{"plural":"fiebres"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0f/LL-Q1321_%28spa%29-AdrianAbdulBaha-fiebre.wav","examples":[{"text":"No tengo fiebre.","en":"I have no fever.","audio":"https://tatoeba.org/en/audio/download/441514","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"¿Tienes fiebre?","en":"Do you have a fever?","audio":"https://tatoeba.org/en/audio/download/50207","words":[{"g":"to have","l":"tener"},null]},{"text":"Mamá tiene fiebre.","en":"Mom has a fever.","audio":"https://tatoeba.org/en/audio/download/63622","words":[{"g":"mum, mom"},{"g":"to have","l":"tener"},null]},{"text":"Tengo un poco de fiebre hoy.","en":"I have a slight fever today.","audio":"https://tatoeba.org/en/audio/download/589825","words":[{"g":"to have","l":"tener"},null,null,{"g":"of / from"},null,{"g":"today, tonight"}],"phrases":[[1,3,"a bit"]]},{"text":"Creo que tengo fiebre.","en":"I think I have a fever.","audio":"https://tatoeba.org/en/audio/download/461915","words":[{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to have","l":"tener"},null]}]}