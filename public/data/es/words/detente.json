{"id":"detente","lemma":"detente","pos":"noun","rank":987,"glosses":["a painted or embroidered image of a saint carried over the heart to ward off danger or attack","an amulet or talisman carried for protection against harm","détente (period of history involving calming of tension)"],"ipa":"/deˈtente/","gender":"m","forms":{"plural":"detentes"},"examples":[{"text":"Detente aquí.","en":"Stop here.","audio":"https://tatoeba.org/en/audio/download/422333","words":[null,{"g":"here"}]},{"text":"Detente ahí.","en":"Stop there.","audio":"https://tatoeba.org/en/audio/download/438738","words":[null,{"g":"there"}]},{"text":"Detente un momento a pensarlo.","en":"Stop and think it over for a minute.","words":[null,null,null,{"g":"to"},{"g":"to think, ponder","l":"pensar"}],"phrases":[[1,3,"one second"]]},{"text":"Detente.","en":"Hold up.","audio":"https://tatoeba.org/en/audio/download/510080","words":[null]},{"text":"Detente. Da cosquillas.","en":"Stop. That tickles.","words":[null,{"g":"to give, to give out","l":"dar"},{"g":"tickling, tickle"}]}]}