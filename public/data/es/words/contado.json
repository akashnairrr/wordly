{"id":"contado","lemma":"contado","pos":"adj","rank":1336,"glosses":["counted","few"],"ipa":"/konˈtado/","forms":{"feminine":"contada","masculinePlural":"contados","femininePlural":"contadas"},"examples":[{"text":"¿Me lo has contado todo?","en":"Have you told me everything?","audio":"https://tatoeba.org/en/audio/download/639845"},{"text":"Sus días están contados.","en":"Her days are numbered.","audio":"https://tatoeba.org/en/audio/download/636442"},{"text":"Son contadas las personas que lo saben.","en":"Very few people know it."},{"text":"Deberías haberme contado la verdad.","en":"You should've told me the truth.","audio":"https://tatoeba.org/en/audio/download/551783"},{"text":"Sus días de político están contados.","en":"His days as a politician are numbered.","audio":"https://tatoeba.org/en/audio/download/689413"}]}