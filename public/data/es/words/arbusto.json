{"id":"arbusto","lemma":"arbusto","pos":"noun","rank":4770,"glosses":["bush, shrub"],"ipa":"/aɾˈbusto/","gender":"m","forms":{"plural":"arbustos"},"order":4770,"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1321_%28spa%29-AdrianAbdulBaha-arbusto.wav","examples":[{"text":"El arbusto se está quemando.","en":"The bush is burning.","audio":"https://tatoeba.org/en/audio/download/77771","words":[{"g":"the"},null,{"g":"oneself"},{"g":"to be","l":"estar"},{"g":"to burn","l":"quemar"}]},{"text":"Algo se está moviendo detrás del arbusto.","en":"Something is moving behind the bush.","words":[{"g":"something, anything"},{"g":"oneself"},{"g":"to be","l":"estar"},{"g":"to move","l":"mover"},{"g":"behind, at the rear"},{"g":"of the"},null]},{"text":"El gato yacía escondido en los arbustos.","en":"The cat lay hidden in the bushes.","words":[{"g":"the"},{"g":"cat"},{"g":"to lie","l":"yacer"},{"g":"hidden"},{"g":"in / on"},{"g":"the / them"},null]}]}