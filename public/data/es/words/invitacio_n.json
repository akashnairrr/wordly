{"id":"invitacio_n","lemma":"invitación","pos":"noun","rank":2052,"glosses":["invitation"],"ipa":"/imbitaˈθjon/","gender":"f","forms":{"plural":"invitaciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q1321_%28spa%29-Marreromarco-invitaci%C3%B3n.wav","examples":[{"text":"Gracias por su invitación.","en":"Thank you for your invitation.","audio":"https://tatoeba.org/en/audio/download/355351","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"his / her / your"},null]},{"text":"Recibí una invitación.","en":"I received an invitation.","audio":"https://tatoeba.org/en/audio/download/38509","words":[{"g":"to receive, get","l":"recibir"},{"g":"a"},null]},{"text":"Ella declinó mi invitación.","en":"She refused my invitation.","audio":"https://tatoeba.org/en/audio/download/735841","words":[{"g":"she"},null,{"g":"my"},null]},{"text":"Ella aceptó nuestra invitación.","en":"She accepted our invitation.","audio":"https://tatoeba.org/en/audio/download/330749","words":[{"g":"she"},{"g":"to accept","l":"aceptar"},{"g":"our, ours, to us","l":"nuestro"},null]},{"text":"La invitación decía \"regalos no, por favor\".","en":"The invitation said, \"No gifts, please.\"","audio":"https://tatoeba.org/en/audio/download/689040","words":[{"g":"the / her"},null,{"g":"to say","l":"decir"},{"g":"present, gift","l":"regalo"},{"g":"no / not"},null,null],"phrases":[[5,7,"please"]]}]}