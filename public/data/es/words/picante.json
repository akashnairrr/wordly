{"id":"picante","lemma":"picante","pos":"adj","rank":3664,"glosses":["hot and spicy, piquant","vulgar, risque"],"ipa":"/piˈkante/","forms":{"femininePlural":"picantes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q1321_%28spa%29-Marreromarco-picante.wav","examples":[{"text":"¿Te gusta la comida picante?","en":"Do you like spicy food?","audio":"https://tatoeba.org/en/audio/download/459276","words":[{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},{"g":"food"},null]},{"text":"Es demasiado picante para mí.","en":"It's too spicy for me.","audio":"https://tatoeba.org/en/audio/download/461588","words":[{"g":"to be","l":"ser"},{"g":"too much"},null,null,null],"phrases":[[3,5,"in my opinion"]]},{"text":"Esta sopa está demasiado picante.","en":"This soup is too spicy.","audio":"https://tatoeba.org/en/audio/download/461108","words":[{"g":"this","l":"este"},{"g":"soup"},{"g":"to be","l":"estar"},{"g":"too much"},null]},{"text":"No deberías comer nada picante.","en":"You shouldn't eat anything spicy.","audio":"https://tatoeba.org/en/audio/download/552750","words":[{"g":"no / not"},{"g":"to owe","l":"deber"},{"g":"to eat"},{"g":"nothing"},null]},{"text":"Espero que te guste la comida picante.","en":"I hope you like spicy food.","words":[{"g":"to hope","l":"esperar"},{"g":"that"},{"g":"you"},{"g":"to like in a general…","l":"gustar"},{"g":"the / her"},{"g":"food"},null]}]}