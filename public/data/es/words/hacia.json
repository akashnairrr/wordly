{"id":"hacia","lemma":"hacia","pos":"prep","rank":242,"glosses":["toward, towards","around, about (indicating time)"],"ipa":"/ˈaθja/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Marreromarco-hacia.wav","examples":[{"text":"Id hacia el sur.","en":"Head south.","audio":"https://tatoeba.org/en/audio/download/722183"},{"text":"No mires hacia arriba.","en":"Don't look up.","audio":"https://tatoeba.org/en/audio/download/440121"},{"text":"Yo miré hacia abajo.","en":"I looked down.","audio":"https://tatoeba.org/en/audio/download/440323"},{"text":"Él miró hacia atrás.","en":"He looked back.","audio":"https://tatoeba.org/en/audio/download/527151"},{"text":"Vivo hacia el norte.","en":"I live upstate.","audio":"https://tatoeba.org/en/audio/download/415799"}]}