{"id":"hacia","lemma":"hacia","pos":"prep","rank":239,"glosses":["toward, towards","around, about (indicating time)"],"ipa":"/ˈaθja/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Marreromarco-hacia.wav","examples":[{"text":"¡Mira hacia atrás!","en":"Look back!","audio":"https://tatoeba.org/en/audio/download/438220","words":[{"g":"target"},null,{"g":"behind"}]},{"text":"¿Hacia dónde está el norte?","en":"Which way is north?","audio":"https://tatoeba.org/en/audio/download/630271","words":[null,null,null,{"g":"the"},{"g":"north"}],"phrases":[[1,3,"where are you?"]]},{"text":"Él me preguntó hacia dónde ir.","en":"He asked me where to go.","audio":"https://tatoeba.org/en/audio/download/37744","words":[{"g":"he"},{"g":"me"},{"g":"to ask","l":"preguntar"},null,{"g":"where"},{"g":"to go"}]},{"text":"Mi actitud hacia él cambió.","en":"My attitude towards him changed.","audio":"https://tatoeba.org/en/audio/download/582381","words":[{"g":"my"},{"g":"posture, pose, stance"},null,{"g":"he"},{"g":"to change","l":"cambiar"}]},{"text":"Mary vino hacia mí en cuanto me vio.","en":"Mary came up to me when she saw me.","audio":"https://tatoeba.org/en/audio/download/801594","words":[null,{"g":"to come","l":"venir"},null,{"g":"me"},null,null,{"g":"me"},{"g":"to see, to spot","l":"ver"}],"phrases":[[4,6,"as soon as"]]}]}