{"id":"hacia","lemma":"hacia","pos":"prep","rank":239,"glosses":["toward, towards","around, about (indicating time)"],"ipa":"/ˈaθja/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/03/LL-Q1321_%28spa%29-Marreromarco-hacia.wav","examples":[{"text":"Él me preguntó hacia dónde ir.","en":"He asked me where to go.","audio":"https://tatoeba.org/en/audio/download/37744","words":[{"g":"he"},{"g":"me"},{"g":"to ask","l":"preguntar"},null,{"g":"where"},{"g":"to go"}]},{"text":"Tienes todo hacia atrás.","en":"You have it all backwards.","audio":"https://tatoeba.org/en/audio/download/299999","words":[{"g":"to have","l":"tener"},{"g":"all"},null,{"g":"behind"}]},{"text":"Llegué aquí hacia las cinco.","en":"I arrived here about five o'clock.","audio":"https://tatoeba.org/en/audio/download/352910","words":[{"g":"to arrive, get","l":"llegar"},{"g":"here"},null,{"g":"the / them"},{"g":"a five"}]},{"text":"Mire hacia adelante.","en":"Look ahead.","audio":"https://tatoeba.org/en/audio/download/439127","words":[{"g":"to look at","l":"mirar"},null,{"g":"forward"}]},{"text":"Vamos hacia allá.","en":"Let's go that way.","audio":"https://tatoeba.org/en/audio/download/443867","words":[{"g":"to go","l":"ir"},null,{"g":"there"}]}]}