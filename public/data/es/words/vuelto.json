{"id":"vuelto","lemma":"vuelto","pos":"noun","rank":502,"glosses":["change (money given back)"],"ipa":"/ˈbwelto/","gender":"m","forms":{"plural":"vueltos"},"examples":[{"text":"¿Te has vuelto loco?","en":"Are you crazy?","audio":"https://tatoeba.org/en/audio/download/437897"},{"text":"Ha vuelto a empezar.","en":"It's started again.","audio":"https://tatoeba.org/en/audio/download/164557"},{"text":"Te has vuelto mejor.","en":"You've gotten better.","audio":"https://tatoeba.org/en/audio/download/454263"},{"text":"Me he vuelto olvidadizo.","en":"I've become forgetful.","audio":"https://tatoeba.org/en/audio/download/804206"},{"text":"Los estudiantes han vuelto.","en":"The students are back.","audio":"https://tatoeba.org/en/audio/download/525437"}]}