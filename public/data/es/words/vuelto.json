{"id":"vuelto","lemma":"vuelto","pos":"noun","rank":499,"glosses":["change (money given back)"],"ipa":"/ˈbwelto/","gender":"m","forms":{"plural":"vueltos"},"examples":[{"text":"¿Te has vuelto loco?","en":"Are you crazy?","audio":"https://tatoeba.org/en/audio/download/437897","words":[{"g":"you"},{"g":"to have","l":"haber"},null,{"g":"crazy"}]},{"text":"He vuelto por ti.","en":"I've come back for you.","audio":"https://tatoeba.org/en/audio/download/195783","words":[{"g":"to have","l":"haber"},null,{"g":"for / by"},{"g":"you","l":"tú"}]},{"text":"Ha vuelto a salir el sol.","en":"The sun has come out again.","audio":"https://tatoeba.org/en/audio/download/523779","words":[{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"to go out"},{"g":"the"},{"g":"sun"}]},{"text":"Ellos han vuelto.","en":"They've come back.","audio":"https://tatoeba.org/en/audio/download/448844","words":[{"g":"they","l":"él"},{"g":"to have","l":"haber"},null]},{"text":"¿Ya has vuelto a casa?","en":"Are you back home now?","audio":"https://tatoeba.org/en/audio/download/221678","words":[{"g":"now"},{"g":"to have","l":"haber"},null,null,null],"phrases":[[3,5,"home"]]}]}