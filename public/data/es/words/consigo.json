{"id":"consigo","lemma":"consigo","pos":"adv","rank":1578,"glosses":["with himself, herself, itself, themselves"],"ipa":"/konˈsiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Rodrigo5260-consigo.wav","examples":[{"text":"Yo tampoco consigo verle.","en":"I can't see him either.","audio":"https://tatoeba.org/en/audio/download/636744"},{"text":"No consigo recordar su nombre.","en":"His name escapes me.","audio":"https://tatoeba.org/en/audio/download/514834"},{"text":"No consigo encontrar mi reloj.","en":"I can't find my watch.","audio":"https://tatoeba.org/en/audio/download/58170"},{"text":"No consigo abrir la puerta.","en":"I can't open the door.","audio":"https://tatoeba.org/en/audio/download/454841"},{"text":"Lleve usted el dinero consigo.","en":"Take the money with you.","audio":"https://tatoeba.org/en/audio/download/515948"}]}