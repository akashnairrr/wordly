{"id":"consigo","lemma":"consigo","pos":"adv","rank":1576,"glosses":["with himself, herself, itself, themselves"],"ipa":"/konˈsiɡo/","order":1630,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Rodrigo5260-consigo.wav","examples":[{"text":"Lleve usted el dinero consigo.","en":"Take the money with you.","audio":"https://tatoeba.org/en/audio/download/515948","words":[{"g":"to take somewhere","l":"llevar"},{"g":"you (formal)"},{"g":"the"},{"g":"money"},null]},{"text":"No consigo abrir la puerta.","en":"I can't open the door.","audio":"https://tatoeba.org/en/audio/download/454841","words":[{"g":"no / not"},null,null,null,null],"phrases":[[2,5,"to open the door"]]},{"text":"Cuanto más consigo, más quiero.","en":"The more I get, the more I want.","audio":"https://tatoeba.org/en/audio/download/687523","words":[{"g":"as much [of]"},{"g":"more"},null,{"g":"more"},{"g":"to desire","l":"querer"}]}]}