{"id":"consigo","lemma":"consigo","pos":"adv","rank":1575,"glosses":["with himself, herself, itself, themselves"],"ipa":"/konˈsiɡo/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/88/LL-Q1321_%28spa%29-Rodrigo5260-consigo.wav","examples":[{"text":"No consigo encontrar mi reloj.","en":"I can't find my watch.","audio":"https://tatoeba.org/en/audio/download/58170","words":[{"g":"no / not"},null,{"g":"to meet"},{"g":"my"},{"g":"clock"}]},{"text":"Yo tampoco consigo verle.","en":"I can't see him either.","audio":"https://tatoeba.org/en/audio/download/636744","words":[{"g":"I"},{"g":"neither"},null,{"g":"to see, to spot","l":"ver"}]},{"text":"Lleve usted el dinero consigo.","en":"Take the money with you.","audio":"https://tatoeba.org/en/audio/download/515948","words":[{"g":"to take somewhere","l":"llevar"},{"g":"you (formal)"},{"g":"the"},{"g":"money"},null]},{"text":"¿Cómo consigo que mi perro coma comida para perros?","en":"How do I get my dog to eat dog food?","audio":"https://tatoeba.org/en/audio/download/611036","words":[{"g":"how"},null,{"g":"that"},{"g":"my"},{"g":"dog"},{"g":"comma"},{"g":"food"},{"g":"for"},{"g":"dog","l":"perro"}]},{"text":"No consigo recordar su nombre.","en":"His name escapes me.","audio":"https://tatoeba.org/en/audio/download/514834","words":[{"g":"no / not"},null,{"g":"to remember"},{"g":"his / her / your"},{"g":"name"}]}]}