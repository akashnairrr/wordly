{"id":"vergu_enza","lemma":"vergüenza","pos":"noun","rank":1088,"glosses":["shame","embarrassment"],"ipa":"/beɾˈɡwenθa/","gender":"f","forms":{"plural":"vergüenzas"},"order":1189,"audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-AdrianAbdulBaha-verg%C3%BCenza.wav","examples":[{"text":"No tengas vergüenza de ser pobre.","en":"Don't be ashamed of being poor.","audio":"https://tatoeba.org/en/audio/download/587304","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to be"},{"g":"poor"}]},{"text":"Me da vergüenza salir vestido así.","en":"I'm ashamed to go out dressed like this.","audio":"https://tatoeba.org/en/audio/download/635504","words":[{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"to go out"},{"g":"dressed"},{"g":"like this"}]},{"text":"Ella no tiene vergüenza.","en":"She has no shame.","words":[{"g":"she"},{"g":"no / not"},{"g":"to have","l":"tener"},null]}]}