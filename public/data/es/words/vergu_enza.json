{"id":"vergu_enza","lemma":"vergüenza","pos":"noun","rank":1087,"glosses":["shame","embarrassment"],"ipa":"/beɾˈɡwenθa/","gender":"f","forms":{"plural":"vergüenzas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1321_%28spa%29-AdrianAbdulBaha-verg%C3%BCenza.wav","examples":[{"text":"No tengas vergüenza de ser pobre.","en":"Don't be ashamed of being poor.","audio":"https://tatoeba.org/en/audio/download/587304","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"to be"},{"g":"poor"}]},{"text":"Me da vergüenza salir vestido así.","en":"I'm ashamed to go out dressed like this.","audio":"https://tatoeba.org/en/audio/download/635504","words":[{"g":"me"},{"g":"to give, to give out","l":"dar"},null,{"g":"to go out"},{"g":"dressed"},{"g":"like this"}]},{"text":"Ella no tiene vergüenza.","en":"She has no shame.","words":[{"g":"she"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Trajo la vergüenza a su familia.","en":"He has brought shame upon his family.","audio":"https://tatoeba.org/en/audio/download/687807","words":[{"g":"to bring","l":"traer"},{"g":"the / her"},null,{"g":"to"},{"g":"his / her / your"},{"g":"family"}]},{"text":"Tengo vergüenza de mí mismo.","en":"I'm ashamed of myself.","audio":"https://tatoeba.org/en/audio/download/453132","words":[{"g":"to have","l":"tener"},null,{"g":"of / from"},{"g":"me"},{"g":"same"}]}]}