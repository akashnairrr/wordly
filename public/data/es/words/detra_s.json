{"id":"detra_s","lemma":"detrás","pos":"adv","rank":432,"glosses":["behind, at the rear","after"],"ipa":"/deˈtɾas/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q1321_%28spa%29-AdrianAbdulBaha-detr%C3%A1s.wav","examples":[{"text":"Está detrás de él.","en":"I'm behind him.","audio":"https://tatoeba.org/en/audio/download/440735"},{"text":"Estoy detrás de ti.","en":"I'm behind you.","audio":"https://tatoeba.org/en/audio/download/800292"},{"text":"Mira detrás de ti.","en":"Look behind you.","audio":"https://tatoeba.org/en/audio/download/50586"},{"text":"Corrieron detrás de Tom.","en":"They took off after Tom.","audio":"https://tatoeba.org/en/audio/download/801319"},{"text":"Tom está detrás de ti.","en":"Tom is behind you.","audio":"https://tatoeba.org/en/audio/download/799017"}]}