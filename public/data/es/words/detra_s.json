{"id":"detra_s","lemma":"detrás","pos":"adv","rank":429,"glosses":["behind, at the rear","after"],"ipa":"/deˈtɾas/","audio":"https://upload.wikimedia.org/wikipedia/commons/0/0b/LL-Q1321_%28spa%29-AdrianAbdulBaha-detr%C3%A1s.wav","examples":[{"text":"Están justo detrás de vosotros.","en":"They're right behind you.","audio":"https://tatoeba.org/en/audio/download/639694","words":[{"g":"to be","l":"estar"},{"g":"right, just"},null,{"g":"of / from"},{"g":"you all"}]},{"text":"Mi casa está detrás de ese puente.","en":"My house is beyond that bridge.","audio":"https://tatoeba.org/en/audio/download/519665","words":[{"g":"my"},{"g":"house"},{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"that"},{"g":"bridge"}]},{"text":"Oí a alguien decir mi nombre desde detrás.","en":"I heard someone call my name from behind.","audio":"https://tatoeba.org/en/audio/download/635382","words":[{"g":"to hear","l":"oír"},{"g":"to"},{"g":"someone, somebody"},{"g":"to say"},{"g":"my"},{"g":"name"},{"g":"since"},null]},{"text":"¿Qué es ese edificio detrás del hospital?","en":"What's that building behind the hospital?","audio":"https://tatoeba.org/en/audio/download/582401","words":[{"g":"what"},{"g":"to be","l":"ser"},{"g":"that"},{"g":"building"},null,{"g":"of the"},{"g":"hospital"}]},{"text":"Estoy detrás de ti.","en":"I'm behind you.","audio":"https://tatoeba.org/en/audio/download/800292","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"you","l":"tú"}]}]}