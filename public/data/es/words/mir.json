{"id":"mir","lemma":"mir","pos":"noun","rank":1559,"glosses":["resident (physician in training)"],"ipa":"/ˈmiɾ/","gender":"mf","forms":{"plural":"mires"},"examples":[{"text":"No mires hacia arriba.","en":"Don't look up.","audio":"https://tatoeba.org/en/audio/download/440121"},{"text":"No me mires así.","en":"Don't give me that look.","audio":"https://tatoeba.org/en/audio/download/460122"},{"text":"A mí no me mires.","en":"It's not my fault.","audio":"https://tatoeba.org/en/audio/download/46564"},{"text":"No mires a la gente.","en":"Don't stare at people.","audio":"https://tatoeba.org/en/audio/download/453561"},{"text":"No mires en mi cuarto.","en":"Don't look into my room.","audio":"https://tatoeba.org/en/audio/download/460064"}]}