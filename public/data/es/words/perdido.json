{"id":"perdido","lemma":"perdido","pos":"adj","rank":406,"glosses":["lost"],"ipa":"/peɾˈdido/","forms":{"feminine":"perdida","masculinePlural":"perdidos","femininePlural":"perdidas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d9/LL-Q1321_%28spa%29-AdrianAbdulBaha-perdido.wav","examples":[{"text":"He perdido la llave.","en":"I lost my key.","audio":"https://tatoeba.org/en/audio/download/440211"},{"text":"Hay una cuchara perdida.","en":"There is a spoon missing.","audio":"https://tatoeba.org/en/audio/download/585761"},{"text":"Los archivos están perdidos.","en":"The files are missing.","audio":"https://tatoeba.org/en/audio/download/460492"},{"text":"Creo que estáis perdidas.","en":"I think you're lost."},{"text":"He perdido mi llave.","en":"I lost my key.","audio":"https://tatoeba.org/en/audio/download/38307"}]}