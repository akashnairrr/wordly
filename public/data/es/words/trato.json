{"id":"trato","lemma":"trato","pos":"noun","rank":452,"glosses":["treatment (the process or manner of treating someone or something)","deal, bargain, agreement","behaviour"],"ipa":"/ˈtɾato/","gender":"m","forms":{"plural":"tratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q1321_%28spa%29-AdrianAbdulBaha-trato.wav","examples":[{"text":"Yo hice un trato.","en":"I made a deal.","audio":"https://tatoeba.org/en/audio/download/440332","words":[{"g":"I"},{"g":"to do","l":"hacer"},{"g":"a"},null]},{"text":"Es un buen trato.","en":"It's a good deal.","audio":"https://tatoeba.org/en/audio/download/442652","words":[{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Nuestro trato sigue en pie.","en":"Our deal is still on.","audio":"https://tatoeba.org/en/audio/download/633838","words":[{"g":"our, ours, to us"},null,{"g":"to follow","l":"seguir"},null,null],"phrases":[[3,5,"Not gone"]]},{"text":"Trato de hacer lo que puedo.","en":"I try to do what I can.","audio":"https://tatoeba.org/en/audio/download/458932","words":[null,{"g":"of / from"},{"g":"to do"},null,null,{"g":"to be able to, can","l":"poder"}],"phrases":[[3,5,"what, that which"]]},{"text":"Ellos no hicieron un trato.","en":"They didn't make a deal.","audio":"https://tatoeba.org/en/audio/download/598599","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"a"},null]}]}