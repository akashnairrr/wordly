{"id":"trato","lemma":"trato","pos":"noun","rank":452,"glosses":["treatment (the process or manner of treating someone or something)","deal, bargain, agreement","behaviour"],"ipa":"/ˈtɾato/","gender":"m","forms":{"plural":"tratos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q1321_%28spa%29-AdrianAbdulBaha-trato.wav","examples":[{"text":"Siempre trato de decir la verdad.","en":"I always try to tell the truth.","audio":"https://tatoeba.org/en/audio/download/594252","words":[{"g":"always"},null,{"g":"of / from"},{"g":"to say"},null,null],"phrases":[[4,6,"honestly, to be honest"]]},{"text":"Un trato es un trato.","en":"A deal is a deal.","audio":"https://tatoeba.org/en/audio/download/442887","words":[{"g":"a"},null,{"g":"to be","l":"ser"},{"g":"a"},null]},{"text":"Nuestro trato sigue en pie.","en":"Our deal is still on.","audio":"https://tatoeba.org/en/audio/download/633838","words":[{"g":"our, ours, to us"},null,{"g":"to follow","l":"seguir"},null,null],"phrases":[[3,5,"Not gone"]]},{"text":"Ellos no hicieron un trato.","en":"They didn't make a deal.","audio":"https://tatoeba.org/en/audio/download/598599","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"to do","l":"hacer"},{"g":"a"},null]},{"text":"Trato de hacer lo que puedo.","en":"I try to do what I can.","audio":"https://tatoeba.org/en/audio/download/458932","words":[null,{"g":"of / from"},{"g":"to do"},null,null,{"g":"to be able to, can","l":"poder"}],"phrases":[[3,5,"what, that which"]]}]}