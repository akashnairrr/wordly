{"id":"bien","lemma":"bien","pos":"adv","rank":26,"glosses":["well (adverbial form of bueno)","well; fine; okay (state of being satisfied with the status quo)","properly"],"ipa":"/ˈbjen/","audio":"https://upload.wikimedia.org/wikipedia/commons/e/ec/LL-Q1321_%28spa%29-Precision27-bien.wav","examples":[{"text":"Lo sé bien.","en":"I know it well.","audio":"https://tatoeba.org/en/audio/download/440817","words":[{"g":"it / him"},{"g":"to know, to understand","l":"saber"},null]},{"text":"La conozco bien.","en":"I know her well.","audio":"https://tatoeba.org/en/audio/download/68079","words":[{"g":"the / her"},{"g":"to know","l":"conocer"},null]},{"text":"Me conoces bien.","en":"You know me so well.","audio":"https://tatoeba.org/en/audio/download/454924","words":[{"g":"me"},{"g":"to know","l":"conocer"},null]},{"text":"Nos conoce muy bien.","en":"He knows us very well.","audio":"https://tatoeba.org/en/audio/download/524919","words":[{"g":"us"},{"g":"to know","l":"conocer"},null,null]},{"text":"Él conoce bien la ciudad.","en":"He knows the city well.","audio":"https://tatoeba.org/en/audio/download/551813","words":[{"g":"he"},{"g":"to know","l":"conocer"},null,{"g":"the / her"},{"g":"city"}]}]}