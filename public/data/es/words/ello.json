{"id":"ello","lemma":"ello","pos":"pron","rank":332,"glosses":["it, neuter third-person subject and disjunctive pronoun"],"ipa":"/ˈeʝo/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/86/LL-Q1321_%28spa%29-Marreromarco-ello.wav","examples":[{"text":"¿Puedes responder a ello?","en":"Can you answer it?","audio":"https://tatoeba.org/en/audio/download/443660","words":[{"g":"to be able to, can","l":"poder"},{"g":"to answer, to reply"},{"g":"to"},null]},{"text":"Pongo en peligro mi trabajo en ello.","en":"I'll stake my job on it.","audio":"https://tatoeba.org/en/audio/download/804230","words":[{"g":"orangutan"},null,null,{"g":"my"},{"g":"work, job"},{"g":"in / on"},null],"phrases":[[1,3,"in danger"]]},{"text":"Pondré mi vida en riesgo con ello.","en":"I'll stake my life on it.","audio":"https://tatoeba.org/en/audio/download/804231","words":[{"g":"to put, to place","l":"poner"},null,null,{"g":"in / on"},{"g":"risk"},{"g":"with"},null],"phrases":[[1,3,"my honey, my love"]]},{"text":"¿Por qué no hablamos de ello ahora?","en":"Why don't we talk about it now?","audio":"https://tatoeba.org/en/audio/download/301204","words":[null,null,{"g":"no / not"},{"g":"to talk","l":"hablar"},{"g":"of / from"},null,{"g":"now"}],"phrases":[[0,2,"why, for what reason"]]},{"text":"Me dijiste que podías con ello.","en":"You told me you could handle it.","audio":"https://tatoeba.org/en/audio/download/522338","words":[{"g":"me"},{"g":"to say","l":"decir"},{"g":"that"},{"g":"to be able to, can","l":"poder"},{"g":"with"},null]}]}