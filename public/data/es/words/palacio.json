{"id":"palacio","lemma":"palacio","pos":"noun","rank":1515,"glosses":["palace","mansion"],"ipa":"/paˈlaθjo/","gender":"m","forms":{"plural":"palacios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-AdrianAbdulBaha-palacio.wav","examples":[{"text":"Ella me guió al palacio.","en":"She guided me to the palace.","words":[{"g":"she"},{"g":"me"},null,{"g":"to the"},null]},{"text":"El palacio tiene una alta torre.","en":"The palace has a tall tower.","words":[{"g":"the"},null,{"g":"to have","l":"tener"},{"g":"a"},{"g":"certificate of discharge"},{"g":"tower"}]},{"text":"El rey y su familia viven en el palacio real.","en":"The king and his family live in the royal palace.","words":[{"g":"the"},{"g":"king"},{"g":"and"},{"g":"his / her / your"},{"g":"family"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the"},null,{"g":"real"}]},{"text":"Alguna vez el rey vivió en ese palacio.","en":"The king once lived in that palace.","words":[null,null,{"g":"the"},{"g":"king"},{"g":"to live","l":"vivir"},{"g":"in / on"},{"g":"that"},null],"phrases":[[0,2,"ever"]]},{"text":"El palacio estaba cautelosamente resguardado.","en":"The palace was heavily guarded.","words":[{"g":"the"},null,{"g":"to be","l":"estar"},null,null]}]}