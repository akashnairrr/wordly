{"id":"fri_o","lemma":"frío","pos":"adj","rank":713,"glosses":["cold (having a low temperature)","cool","cold (unfriendly, emotionally distant or unfeeling)"],"ipa":"/ˈfɾio/","forms":{"feminine":"fría","masculinePlural":"fríos","femininePlural":"frías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Rodelar-fr%C3%ADo.wav","examples":[{"text":"Hoy hace mucho frío, ¿no te parece?","en":"It's very cold today, don't you think?","audio":"https://tatoeba.org/en/audio/download/858640","words":[{"g":"today, tonight"},{"g":"to do","l":"hacer"},{"g":"much"},null,{"g":"no / not"},{"g":"you"},{"g":"to seem, to see fit","l":"parecer"}]},{"text":"No me importa el frío.","en":"I don't mind the cold.","audio":"https://tatoeba.org/en/audio/download/453383","words":[null,null,null,{"g":"the"},null],"phrases":[[0,3,"I don't care!"]]},{"text":"Tengo los pies fríos.","en":"My feet are cold.","audio":"https://tatoeba.org/en/audio/download/442936","words":[{"g":"to have","l":"tener"},{"g":"the / them"},{"g":"foot","l":"pie"},null]},{"text":"¿Hizo frío ayer?","en":"Was it cold yesterday?","audio":"https://tatoeba.org/en/audio/download/460847","words":[{"g":"to do","l":"hacer"},null,{"g":"yesterday"}]},{"text":"Odio los días fríos de invierno.","en":"I hate cold winter days.","audio":"https://tatoeba.org/en/audio/download/459955","words":[{"g":"hate"},{"g":"the / them"},{"g":"day","l":"día"},null,{"g":"of / from"},{"g":"winter"}]}]}