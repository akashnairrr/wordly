{"id":"fri_o","lemma":"frío","pos":"adj","rank":716,"glosses":["cold (having a low temperature)","cool","cold (unfriendly, emotionally distant or unfeeling)"],"ipa":"/ˈfɾio/","forms":{"feminine":"fría","masculinePlural":"fríos","femininePlural":"frías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/19/LL-Q1321_%28spa%29-Rodelar-fr%C3%ADo.wav","examples":[{"text":"Me agrada el frío.","en":"I like the cold.","audio":"https://tatoeba.org/en/audio/download/441679"},{"text":"La sopa está fría.","en":"The soup's cold.","audio":"https://tatoeba.org/en/audio/download/442102"},{"text":"Tengo los pies fríos.","en":"My feet are cold.","audio":"https://tatoeba.org/en/audio/download/442936"},{"text":"Tus manos están frías.","en":"Your hands are cold.","audio":"https://tatoeba.org/en/audio/download/453993"},{"text":"Sé que hace frío.","en":"I know it's cold.","audio":"https://tatoeba.org/en/audio/download/442729"}]}