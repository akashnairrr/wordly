{"id":"permiso","lemma":"permiso","pos":"noun","rank":657,"glosses":["permission","license","leave (absence from work)"],"ipa":"/peɾˈmiso/","gender":"m","forms":{"plural":"permisos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-Marreromarco-permiso.wav","examples":[{"text":"¿Puedo ver tu permiso?","en":"May I see your license?","audio":"https://tatoeba.org/en/audio/download/459527","words":[{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot"},{"g":"your"},null]},{"text":"¿Quién te ha dado permiso para hacerlo?","en":"Who gave you permission to do this?","audio":"https://tatoeba.org/en/audio/download/611969","words":[{"g":"who"},{"g":"you"},{"g":"to have","l":"haber"},{"g":"a die or dice"},null,{"g":"for"},{"g":"to do","l":"hacer"}]},{"text":"No necesito tu permiso.","en":"I don't need your permission.","audio":"https://tatoeba.org/en/audio/download/524462","words":[{"g":"no / not"},{"g":"to need","l":"necesitar"},{"g":"your"},null]},{"text":"Tienes mi permiso para irte.","en":"You have my permission to leave.","audio":"https://tatoeba.org/en/audio/download/598102","words":[{"g":"to have","l":"tener"},{"g":"my"},null,{"g":"for"},{"g":"to go","l":"ir"}]},{"text":"Él quería mi permiso para usar el teléfono.","en":"He wanted my permission to use the telephone.","audio":"https://tatoeba.org/en/audio/download/929608","words":[{"g":"he"},{"g":"to desire","l":"querer"},{"g":"my"},null,{"g":"for"},{"g":"to use"},{"g":"the"},{"g":"telephone"}]}]}