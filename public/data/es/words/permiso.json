{"id":"permiso","lemma":"permiso","pos":"noun","rank":660,"glosses":["permission","license","leave (absence from work)"],"ipa":"/peɾˈmiso/","gender":"m","forms":{"plural":"permisos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-Marreromarco-permiso.wav","examples":[{"text":"Con su permiso, caballeros.","en":"Excuse me, gentlemen.","audio":"https://tatoeba.org/en/audio/download/845732"},{"text":"¿Puedo ver tu permiso?","en":"May I see your license?","audio":"https://tatoeba.org/en/audio/download/459527"},{"text":"No necesito tu permiso.","en":"I don't need your permission.","audio":"https://tatoeba.org/en/audio/download/524462"},{"text":"Primero deberías pedir permiso.","en":"You should ask for permission first.","audio":"https://tatoeba.org/en/audio/download/687796"},{"text":"Tienes mi permiso para irte.","en":"You have my permission to leave.","audio":"https://tatoeba.org/en/audio/download/598102"}]}