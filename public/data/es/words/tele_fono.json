{"id":"tele_fono","lemma":"teléfono","pos":"noun","rank":318,"glosses":["telephone (a telecommunication device used for two-way talking with another person)","rotary dial telephone","mobile phone"],"ipa":"/teˈlefono/","gender":"m","forms":{"plural":"teléfonos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/da/LL-Q1321_%28spa%29-AdrianAbdulBaha-tel%C3%A9fono.wav","examples":[{"text":"Tomás llamó por teléfono.","en":"Tom phoned.","audio":"https://tatoeba.org/en/audio/download/501617"},{"text":"Todos los teléfonos estaban sonando.","en":"All the phones were ringing.","audio":"https://tatoeba.org/en/audio/download/506396"},{"text":"¿Quién llamó por teléfono?","en":"Who phoned?","audio":"https://tatoeba.org/en/audio/download/439165"},{"text":"No funciona ninguno de los teléfonos.","en":"None of the telephones are working.","audio":"https://tatoeba.org/en/audio/download/687561"},{"text":"Estoy en el teléfono.","en":"I'm on the phone.","audio":"https://tatoeba.org/en/audio/download/523519"}]}