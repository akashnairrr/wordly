{"id":"atentamente","lemma":"atentamente","pos":"adv","rank":4414,"glosses":["attentively","politely","best regards (polite closing of a letter)"],"ipa":"/aˌtentaˈmente/","examples":[{"text":"Escucha atentamente lo que digo.","en":"Listen carefully to what I say.","audio":"https://tatoeba.org/en/audio/download/354834","words":[{"g":"listening"},null,null,null,{"g":"I mean"}],"phrases":[[2,4,"what, that which"]]},{"text":"Esta vez vigilaré atentamente.","en":"I'll watch carefully this time.","audio":"https://tatoeba.org/en/audio/download/605008","words":[{"g":"this","l":"este"},{"g":"time, instance"},{"g":"to watch over","l":"vigilar"},null]},{"text":"Todos estaban escuchando atentamente.","en":"Everyone was listening very carefully.","audio":"https://tatoeba.org/en/audio/download/587268","words":[{"g":"all","l":"todo"},{"g":"to be","l":"estar"},{"g":"to listen to","l":"escuchar"},null]},{"text":"Me miró atentamente.","en":"He stared at me.","audio":"https://tatoeba.org/en/audio/download/821272","words":[{"g":"me"},{"g":"to look at","l":"mirar"},null]},{"text":"Escuché atentamente.","en":"I listened carefully.","audio":"https://tatoeba.org/en/audio/download/353619","words":[{"g":"to listen to","l":"escuchar"},null]}]}