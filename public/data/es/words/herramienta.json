{"id":"herramienta","lemma":"herramienta","pos":"noun","rank":2353,"glosses":["a tool, an implement"],"ipa":"/eraˈmjenta/","gender":"f","forms":{"plural":"herramientas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/48/LL-Q1321_%28spa%29-AdrianAbdulBaha-herramienta.wav","formAudio":{"herramientas":"https://upload.wikimedia.org/wikipedia/commons/4/4a/LL-Q1321_%28spa%29-AdrianAbdulBaha-herramientas.wav"},"examples":[{"text":"Necesitamos algunas herramientas.","en":"We need some tools.","audio":"https://tatoeba.org/en/audio/download/501355","words":[{"g":"to need","l":"necesitar"},{"g":"someone","l":"alguno"},null]},{"text":"Hay muchas herramientas en la caja.","en":"There are a lot of tools in the box.","audio":"https://tatoeba.org/en/audio/download/1195671","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},null,{"g":"in / on"},{"g":"the / her"},{"g":"box, case"}]},{"text":"Me traje mis herramientas.","en":"I brought my tools.","audio":"https://tatoeba.org/en/audio/download/798028","words":[{"g":"me"},{"g":"suit"},{"g":"my"},null]},{"text":"Necesitamos una herramienta con que abrirla.","en":"We need a tool to open it with.","words":[{"g":"to need","l":"necesitar"},{"g":"a"},null,{"g":"with"},{"g":"that"},{"g":"to open, open up","l":"abrir"}]},{"text":"Ojalá nadie tome mis herramientas.","en":"I hope no one takes my tools.","words":[{"g":"I wish"},{"g":"no one"},{"g":"to take","l":"tomar"},{"g":"my"},null]}]}