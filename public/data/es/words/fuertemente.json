{"id":"fuertemente","lemma":"fuertemente","pos":"adv","rank":4981,"glosses":["strongly, hard, severely, heavily"],"ipa":"/ˌfweɾteˈmente/","examples":[{"text":"Te golpearon fuertemente.","en":"You got hit hard.","audio":"https://tatoeba.org/en/audio/download/444065","words":[{"g":"you"},{"g":"to hit","l":"golpear"},null]},{"text":"Sentí mi corazón latir fuertemente.","en":"I felt my heart beating violently.","words":[{"g":"to feel","l":"sentir"},{"g":"my"},{"g":"heart"},{"g":"to beat, throb"},null]},{"text":"Su esposo es fuertemente dependiente de drogas.","en":"Her husband is heavily dependent on drugs.","words":[{"g":"his / her / your"},{"g":"husband"},{"g":"to be","l":"ser"},null,{"g":"dependent"},{"g":"of / from"},{"g":"drug","l":"droga"}]},{"text":"Agarra fuertemente.","en":"Hang on.","audio":"https://tatoeba.org/en/audio/download/437829","words":[{"g":"to grab or take hold of","l":"agarrar"},null]},{"text":"Ella cerró la puerta fuertemente destrás de ella.","en":"She closed the door tightly behind her.","words":[{"g":"she"},{"g":"to close, to shut","l":"cerrar"},{"g":"the / her"},{"g":"door"},null,null,{"g":"of / from"},{"g":"she"}]}]}