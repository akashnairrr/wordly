{"id":"agradable","lemma":"agradable","pos":"adj","rank":703,"glosses":["agreeable, pleasant"],"ipa":"/aɡɾaˈdable/","forms":{"femininePlural":"agradables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-Marreromarco-agradable.wav","examples":[{"text":"Ella es una persona agradable.","en":"She is a pleasant person.","audio":"https://tatoeba.org/en/audio/download/552012","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"person (an individual"},null]},{"text":"¡Qué agradable sorpresa!","en":"What a pleasant surprise!","audio":"https://tatoeba.org/en/audio/download/196015","words":[{"g":"what"},null,{"g":"surprise"}]},{"text":"Hace un día agradable hoy.","en":"It is a pleasant day today.","audio":"https://tatoeba.org/en/audio/download/703535","words":[{"g":"to do","l":"hacer"},{"g":"a"},{"g":"day"},null,{"g":"today, tonight"}]},{"text":"Son niños agradables.","en":"They're nice kids.","audio":"https://tatoeba.org/en/audio/download/448916","words":[{"g":"to be","l":"ser"},{"g":"child, boy","l":"niño"},null]},{"text":"¡Qué sorpresa tan agradable verte aquí!","en":"What a pleasant surprise to see you here!","audio":"https://tatoeba.org/en/audio/download/932970","words":[{"g":"what"},{"g":"surprise"},{"g":"so, as"},null,{"g":"to see, to spot","l":"ver"},{"g":"here"}]}]}