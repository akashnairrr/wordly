{"id":"huevos","lemma":"huevos","pos":"noun","rank":1095,"glosses":["guts, balls (courage, bravery)"],"ipa":"/ˈw̝ebos/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/cb/LL-Q1321_%28spa%29-Marreromarco-huevos.wav","examples":[{"text":"Las aves ponen huevos.","en":"Birds lay eggs.","audio":"https://tatoeba.org/en/audio/download/440559"},{"text":"¿Dónde están los huevos?","en":"Where are the eggs?","audio":"https://tatoeba.org/en/audio/download/604807"},{"text":"Ella coció los huevos.","en":"She boiled the eggs.","audio":"https://tatoeba.org/en/audio/download/41920"},{"text":"¿Los cocodrilos ponen huevos?","en":"Do alligators lay eggs?","audio":"https://tatoeba.org/en/audio/download/819907"},{"text":"Quiero algunos huevos frescos.","en":"I want some fresh eggs.","audio":"https://tatoeba.org/en/audio/download/70211"}]}