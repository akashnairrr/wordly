{"id":"sin","lemma":"sin","pos":"prep","rank":92,"glosses":["without"],"ipa":"/ˈsin/","audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-sin.wav","examples":[{"text":"Estamos sin un duro.","en":"We're broke.","audio":"https://tatoeba.org/en/audio/download/424607"},{"text":"Muévete sin hacer ruido.","en":"Move quietly.","audio":"https://tatoeba.org/en/audio/download/438921"},{"text":"Tom está sin aliento.","en":"Tom is winded.","audio":"https://tatoeba.org/en/audio/download/799060"},{"text":"Me quedé sin palabras.","en":"I was speechless.","audio":"https://tatoeba.org/en/audio/download/80258"},{"text":"Tom parece sin aliento.","en":"Tom looks winded.","audio":"https://tatoeba.org/en/audio/download/799214"}]}