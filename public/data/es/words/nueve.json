{"id":"nueve","lemma":"nueve","pos":"noun","rank":849,"glosses":["the digit or figure 9"],"ipa":"/ˈnwebe/","gender":"m","forms":{"plural":"nueves"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/be/LL-Q1321_%28spa%29-AdrianAbdulBaha-nueve.wav","examples":[{"text":"Necesito nueve horas de sueño.","en":"I need nine hours of sleep.","audio":"https://tatoeba.org/en/audio/download/594237"},{"text":"Él volvió a las nueve.","en":"He came back at nine o'clock.","audio":"https://tatoeba.org/en/audio/download/527051"},{"text":"Él dijo: \"son las nueve.\"","en":"He said, \"It's nine o'clock.\"","audio":"https://tatoeba.org/en/audio/download/333006"},{"text":"La escuela empieza a las nueve.","en":"School begins at 9.","audio":"https://tatoeba.org/en/audio/download/34484"},{"text":"La reunión terminó a las nueve.","en":"The meeting finished at nine.","audio":"https://tatoeba.org/en/audio/download/706579"}]}