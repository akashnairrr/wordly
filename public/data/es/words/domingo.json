{"id":"domingo","lemma":"domingo","pos":"noun","rank":1263,"glosses":["Sunday"],"ipa":"/doˈminɡo/","gender":"m","forms":{"plural":"domingos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9c/LL-Q1321_%28spa%29-Precision27-domingo.wav","formAudio":{"domingos":"https://upload.wikimedia.org/wikipedia/commons/b/b9/LL-Q1321_%28spa%29-Eavqwiki-domingos.wav"},"examples":[{"text":"Estoy libre el domingo.","en":"I'm free on Sunday.","audio":"https://tatoeba.org/en/audio/download/450205"},{"text":"Trabajo incluso los domingos.","en":"I work even on Sunday.","audio":"https://tatoeba.org/en/audio/download/116312"},{"text":"Me voy el domingo.","en":"I'm leaving on Sunday.","audio":"https://tatoeba.org/en/audio/download/453531"},{"text":"No trabajo los domingos.","en":"I don't work on Sundays.","audio":"https://tatoeba.org/en/audio/download/459843"},{"text":"Mantén el domingo libre.","en":"Keep next Sunday free.","audio":"https://tatoeba.org/en/audio/download/460519"}]}