{"id":"reaccio_n","lemma":"reacción","pos":"noun","rank":1889,"glosses":["reaction","recoil","reactionary political faction or movement"],"ipa":"/reaɡˈθjon/","gender":"f","forms":{"plural":"reacciones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Marreromarco-reacci%C3%B3n.wav","examples":[{"text":"¿Esperas una reacción violenta?","en":"Do you expect a backlash?","audio":"https://tatoeba.org/en/audio/download/804559"},{"text":"Empezó una reacción en cadena.","en":"It started a chain reaction.","audio":"https://tatoeba.org/en/audio/download/552937"},{"text":"Tuve una reacción similar.","en":"I had a similar reaction."},{"text":"¿Ocurre alguna reacción adversa?","en":"Is there any adverse reaction?"},{"text":"¿Cuál fue la reacción de Tom?","en":"What was Tom's reaction?"}]}