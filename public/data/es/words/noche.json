{"id":"noche","lemma":"noche","pos":"noun","rank":107,"glosses":["night (the period between sunset and sunrise)","evening (after sunset)"],"ipa":"/ˈnot͡ʃe/","gender":"f","forms":{"plural":"noches"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/58/LL-Q1321_%28spa%29-Rodrigo5260-noche.wav","formAudio":{"noches":"https://upload.wikimedia.org/wikipedia/commons/7/7b/LL-Q1321_%28spa%29-Eavqwiki-noches.wav"},"examples":[{"text":"Reúnete conmigo esta noche.","en":"Meet me tonight.","audio":"https://tatoeba.org/en/audio/download/441965"},{"text":"Di buenas noches, Tom.","en":"Say good night, Tom.","audio":"https://tatoeba.org/en/audio/download/799316"},{"text":"Nos vemos esta noche.","en":"See you tonight.","audio":"https://tatoeba.org/en/audio/download/442113"},{"text":"Da las buenas noches, Tom.","en":"Say good night, Tom.","audio":"https://tatoeba.org/en/audio/download/799317"},{"text":"Esta noche estoy ocupado.","en":"I'm busy tonight.","audio":"https://tatoeba.org/en/audio/download/293974"}]}