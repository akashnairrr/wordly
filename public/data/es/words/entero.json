{"id":"entero","lemma":"entero","pos":"adj","rank":1276,"glosses":["whole; entire","intact, unbroken"],"ipa":"/enˈteɾo/","forms":{"feminine":"entera","masculinePlural":"enteros","femininePlural":"enteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-entero.wav","examples":[{"text":"Es un número entero.","en":"It's a whole number.","audio":"https://tatoeba.org/en/audio/download/541244","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"number"},null]},{"text":"Su familia entera es así.","en":"His whole family is like that.","words":[{"g":"his / her / your"},{"g":"family"},null,{"g":"to be","l":"ser"},{"g":"like this"}]},{"text":"Tengo el día entero libre.","en":"I have the whole day free.","words":[{"g":"to have","l":"tener"},{"g":"the"},{"g":"day"},null,{"g":"free"}]},{"text":"He estado esperando tres horas enteras.","en":"I have waited a full three hours.","audio":"https://tatoeba.org/en/audio/download/599225","words":[{"g":"to have","l":"haber"},{"g":"country, land"},{"g":"to hope","l":"esperar"},{"g":"three"},{"g":"hour","l":"hora"},null]},{"text":"Leí el libro entero.","en":"I read the entire book.","audio":"https://tatoeba.org/en/audio/download/460932","words":[{"g":"to read","l":"leer"},{"g":"the"},{"g":"book"},null]}]}