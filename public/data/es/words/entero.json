{"id":"entero","lemma":"entero","pos":"adj","rank":1279,"glosses":["whole; entire","intact, unbroken"],"ipa":"/enˈteɾo/","forms":{"feminine":"entera","masculinePlural":"enteros","femininePlural":"enteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-entero.wav","examples":[{"text":"Es un número entero.","en":"It's a whole number.","audio":"https://tatoeba.org/en/audio/download/541244"},{"text":"Él se comió la manzana entera.","en":"He ate the whole apple.","audio":"https://tatoeba.org/en/audio/download/636553"},{"text":"He estado esperando tres horas enteras.","en":"I have waited a full three hours.","audio":"https://tatoeba.org/en/audio/download/599225"},{"text":"Leí el libro entero.","en":"I read the entire book.","audio":"https://tatoeba.org/en/audio/download/460932"},{"text":"Quisiera ocupar la mañana entera en esto.","en":"I would like to spend the whole morning like this.","audio":"https://tatoeba.org/en/audio/download/77595"}]}