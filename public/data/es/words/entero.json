{"id":"entero","lemma":"entero","pos":"adj","rank":1276,"glosses":["whole; entire","intact, unbroken"],"ipa":"/enˈteɾo/","forms":{"feminine":"entera","masculinePlural":"enteros","femininePlural":"enteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-entero.wav","examples":[{"text":"Es un número entero.","en":"It's a whole number.","audio":"https://tatoeba.org/en/audio/download/541244","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"number"},null]},{"text":"Tengo el día entero libre.","en":"I have the whole day free.","words":[{"g":"to have","l":"tener"},{"g":"the"},{"g":"day"},null,{"g":"free"}]},{"text":"Leí el libro entero.","en":"I read the entire book.","audio":"https://tatoeba.org/en/audio/download/460932","words":[{"g":"to read","l":"leer"},{"g":"the"},{"g":"book"},null]},{"text":"Él es conocido en el país entero.","en":"He is known to the entire country.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"known"},{"g":"in / on"},{"g":"the"},{"g":"country"},null]},{"text":"Hay mucha lluvia el año entero.","en":"There's lots of rain all year.","words":[{"g":"to have","l":"haber"},{"g":"much","l":"mucho"},{"g":"rain"},{"g":"the"},{"g":"year"},null]}]}