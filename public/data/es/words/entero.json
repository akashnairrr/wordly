{"id":"entero","lemma":"entero","pos":"adj","rank":1276,"glosses":["whole; entire","intact, unbroken"],"ipa":"/enˈteɾo/","forms":{"feminine":"entera","masculinePlural":"enteros","femininePlural":"enteras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/26/LL-Q1321_%28spa%29-Marreromarco-entero.wav","examples":[{"text":"Me quedé en casa el verano entero.","en":"I was at home all summer.","audio":"https://tatoeba.org/en/audio/download/871938","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},null,null,{"g":"the"},{"g":"summer"},null],"phrases":[[2,4,"home"]]},{"text":"Ayer me pasé el día entero durmiendo.","en":"I slept all day yesterday.","audio":"https://tatoeba.org/en/audio/download/104791","words":[{"g":"yesterday"},{"g":"me"},{"g":"to pass","l":"pasar"},{"g":"the"},{"g":"day"},null,{"g":"to sleep","l":"dormir"}]},{"text":"He estado esperando tres horas enteras.","en":"I have waited a full three hours.","audio":"https://tatoeba.org/en/audio/download/599225","words":[{"g":"to have","l":"haber"},{"g":"country, land"},{"g":"to hope","l":"esperar"},{"g":"three"},{"g":"hour","l":"hora"},null]},{"text":"Yo no pude dormir la noche entera.","en":"I couldn't sleep all night.","words":[{"g":"I"},{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to sleep"},{"g":"the / her"},{"g":"night"},null]},{"text":"No te enteras de lo que te estoy diciendo.","en":"You aren't listening to what I'm saying.","audio":"https://tatoeba.org/en/audio/download/689541","words":[{"g":"no / not"},{"g":"you"},null,{"g":"of / from"},null,null,{"g":"you"},{"g":"to be","l":"estar"},{"g":"to say","l":"decir"}],"phrases":[[4,6,"what, that which"]]}]}