{"id":"hambriento","lemma":"hambriento","pos":"adj","rank":3054,"glosses":["very hungry, famished","hungry"],"ipa":"/amˈbɾjento/","forms":{"feminine":"hambrienta","masculinePlural":"hambrientos","femininePlural":"hambrientas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-Marreromarco-hambriento.wav","examples":[{"text":"El perro parece hambriento.","en":"The dog looks hungry.","audio":"https://tatoeba.org/en/audio/download/35736","words":[{"g":"the"},{"g":"dog"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"Todos ellos están hambrientos.","en":"They are all hungry.","audio":"https://tatoeba.org/en/audio/download/448558","words":[{"g":"all","l":"todo"},{"g":"they","l":"él"},{"g":"to be","l":"estar"},null]},{"text":"¿Sabes lo que es estar realmente hambriento?","en":"Do you know what it is like to be really hungry?","audio":"https://tatoeba.org/en/audio/download/568148","words":[{"g":"to know, to understand","l":"saber"},null,null,{"g":"to be","l":"ser"},{"g":"to be"},{"g":"really"},null],"phrases":[[1,3,"what, that which"]]},{"text":"¿Están muy hambrientas?","en":"Are you very hungry?","audio":"https://tatoeba.org/en/audio/download/915695","words":[{"g":"to be","l":"estar"},null,null]},{"text":"Mucha gente en el mundo está hambrienta.","en":"Many people in the world are hungry.","audio":"https://tatoeba.org/en/audio/download/929620","words":[{"g":"much","l":"mucho"},{"g":"people"},{"g":"in / on"},{"g":"the"},{"g":"world, earth"},{"g":"to be","l":"estar"},null]}]}