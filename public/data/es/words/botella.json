{"id":"botella","lemma":"botella","pos":"noun","rank":1065,"glosses":["bottle","tank (closed container for liquids or gases)"],"ipa":"/boˈteʝa/","gender":"f","forms":{"plural":"botellas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fe/LL-Q1321_%28spa%29-AdrianAbdulBaha-botella.wav","examples":[{"text":"La botella está llena.","en":"The bottle is full.","audio":"https://tatoeba.org/en/audio/download/501255"},{"text":"Compré dos botellas de leche.","en":"I bought two bottles of milk.","audio":"https://tatoeba.org/en/audio/download/333011"},{"text":"La botella está vacía.","en":"The bottle is empty.","audio":"https://tatoeba.org/en/audio/download/449186"},{"text":"La cesta está llena de botellas.","en":"The basket is full of bottles.","audio":"https://tatoeba.org/en/audio/download/559172"},{"text":"¿Quién rompió la botella?","en":"Who broke the bottle?","audio":"https://tatoeba.org/en/audio/download/551399"}]}