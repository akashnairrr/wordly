{"id":"pasarlo","lemma":"pasarlo","pos":"verb","rank":4510,"glosses":["to enjoy (oneself in a certain way)"],"ipa":"/paˈsaɾlo/","conjugation":{"indicative":{"present":{"1s":"lo paso","2s":"lo pasas","3s":"lo pasa","1p":"lo pasamos","2p":"lo pasáis","3p":"lo pasan"},"imperfect":{"1s":"lo pasaba","2s":"lo pasabas","3s":"lo pasaba","1p":"lo pasábamos","2p":"lo pasabais","3p":"lo pasaban"},"preterite":{"1s":"lo pasé","2s":"lo pasaste","3s":"lo pasó","1p":"lo pasamos","2p":"lo pasasteis","3p":"lo pasaron"},"future":{"1s":"lo pasaré","2s":"lo pasarás","3s":"lo pasará","1p":"lo pasaremos","2p":"lo pasaréis","3p":"lo pasarán"},"conditional":{"1s":"lo pasaría","2s":"lo pasarías","3s":"lo pasaría","1p":"lo pasaríamos","2p":"lo pasaríais","3p":"lo pasarían"}},"subjunctive":{"present":{"1s":"lo pase","2s":"lo pases","3s":"lo pase","1p":"lo pasemos","2p":"lo paséis","3p":"lo pasen"},"imperfect":{"1s":"lo pasara","2s":"lo pasaras","3s":"lo pasara","1p":"lo pasáramos","2p":"lo pasarais","3p":"lo pasaran"}},"imperative":{"affirmative":{"2s":"pásalo","3s":"páselo","1p":"pasémoslo","2p":"pasadlo","3p":"pásenlo"},"negative":{"2s":"lo pases","3s":"lo pase","1p":"lo pasemos","2p":"lo paséis","3p":"lo pasen"}}},"nonFinite":{"gerund":"pasándolo","participle":"lo pasado"},"examples":[{"text":"Ahora vete a pasarlo bien.","en":"Now, go have a good time.","audio":"https://tatoeba.org/en/audio/download/692079","words":[{"g":"now"},{"g":"to go","l":"ir"},{"g":"to"},null,{"g":"well"}]},{"text":"Lo importante es pasarlo bien.","en":"It's all about having fun.","audio":"https://tatoeba.org/en/audio/download/611339","words":[{"g":"it / him"},{"g":"important"},{"g":"to be","l":"ser"},null,{"g":"well"}]},{"text":"¿Cree usted que podré pasarlo?","en":"Do you think I can get by with it?","words":[{"g":"to believe","l":"creer"},{"g":"you (formal)"},{"g":"that"},{"g":"to be able to, can","l":"poder"},null]},{"text":"Oye, ¿quieres pasarlo bien?, acompáñanos.","en":"Hey, you want to have a lot of fun? Come