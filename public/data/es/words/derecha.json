{"id":"derecha","lemma":"derecha","pos":"noun","rank":663,"glosses":["right (direction)","right (ensemble of right-wing political parties; political conservatives as a group)"],"ipa":"/deˈɾet͡ʃa/","gender":"f","forms":{"plural":"derechas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Rodrigo5260-derecha.wav","examples":[{"text":"Me duele la pierna derecha.","en":"My right leg hurts.","audio":"https://tatoeba.org/en/audio/download/449220","words":[{"g":"me"},null,{"g":"the / her"},{"g":"leg"},null]},{"text":"Gira a la derecha.","en":"Turn right.","audio":"https://tatoeba.org/en/audio/download/438265","words":[{"g":"tour"},{"g":"to"},{"g":"the / her"},null]},{"text":"El cuarto de baño está a la derecha.","en":"The bathroom is on the right.","audio":"https://tatoeba.org/en/audio/download/508424","words":[{"g":"the"},null,null,null,{"g":"to be","l":"estar"},{"g":"to"},{"g":"the / her"},null],"phrases":[[1,4,"bathroom"]]},{"text":"¿Qué es esa cosa en tu mano derecha?","en":"What's that thing in your right hand?","words":[{"g":"what"},{"g":"to be","l":"ser"},{"g":"that","l":"ese"},{"g":"thing"},{"g":"in / on"},{"g":"your"},{"g":"hand"},null]},{"text":"Las paredes en la vieja casa no estaban derechas.","en":"The walls in the old house were not straight.","words":[{"g":"the / them"},{"g":"wall","l":"pared"},{"g":"in / on"},null,null,{"g":"house"},{"g":"no / not"},{"g":"to be","l":"estar"},null],"phrases":[[3,5,"A three-note melody"]]}]}