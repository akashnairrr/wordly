{"id":"accidente","lemma":"accidente","pos":"noun","rank":545,"glosses":["accident (unexpected event with negative consequences)","accidental","feature"],"ipa":"/aɡθiˈdente/","gender":"m","forms":{"plural":"accidentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/56/LL-Q1321_%28spa%29-AdrianAbdulBaha-accidente.wav","formAudio":{"accidentes":"https://upload.wikimedia.org/wikipedia/commons/d/d1/LL-Q1321_%28spa%29-Emanuelps27-accidentes.wav"},"examples":[{"text":"¿Viste el accidente?","en":"Did you see the accident?","audio":"https://tatoeba.org/en/audio/download/1152091","words":[{"g":"you know"},{"g":"the"},null]},{"text":"Su hijo murió en el accidente.","en":"Her son was killed in the accident.","audio":"https://tatoeba.org/en/audio/download/730250","words":[{"g":"his / her / your"},{"g":"son"},{"g":"to die","l":"morir"},{"g":"in / on"},{"g":"the"},null]},{"text":"Ella tuvo dos accidentes en un año.","en":"She had two accidents within a year.","audio":"https://tatoeba.org/en/audio/download/1189532","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},null,{"g":"in / on"},{"g":"a"},{"g":"year"}]},{"text":"No vi el accidente.","en":"I didn't see the accident.","audio":"https://tatoeba.org/en/audio/download/765397","words":[{"g":"no / not"},{"g":"to see, to spot","l":"ver"},{"g":"the"},null]},{"text":"Fue un terrible accidente.","en":"It was a terrible accident.","audio":"https://tatoeba.org/en/audio/download/519352","words":[{"g":"to be","l":"ser"},{"g":"a"},{"g":"terrible"},null]}]}