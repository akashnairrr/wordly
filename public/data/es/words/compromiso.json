{"id":"compromiso","lemma":"compromiso","pos":"noun","rank":1480,"glosses":["commitment","engagement, appointment","compromise"],"ipa":"/kompɾoˈmiso/","gender":"m","forms":{"plural":"compromisos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Marreromarco-compromiso.wav","examples":[{"text":"Tom firmó un compromiso.","en":"Tom signed a pledge.","audio":"https://tatoeba.org/en/audio/download/800985"},{"text":"Tom casi nunca llega tarde a sus compromisos.","en":"Tom is hardly ever late for appointments."},{"text":"Se logró un compromiso.","en":"A compromise was reached.","audio":"https://tatoeba.org/en/audio/download/512961"},{"text":"Tom casi nunca llega atrasado a sus compromisos.","en":"Tom is almost never late for appointments."},{"text":"Se alcanzó un compromiso.","en":"A compromise was reached.","audio":"https://tatoeba.org/en/audio/download/512962"}]}