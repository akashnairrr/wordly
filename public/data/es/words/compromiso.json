{"id":"compromiso","lemma":"compromiso","pos":"noun","rank":1477,"glosses":["commitment","engagement, appointment","compromise"],"ipa":"/kompɾoˈmiso/","gender":"m","forms":{"plural":"compromisos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Marreromarco-compromiso.wav","examples":[{"text":"Tengo otro compromiso.","en":"I have another engagement.","audio":"https://tatoeba.org/en/audio/download/509939","words":[{"g":"to have","l":"tener"},{"g":"someone else"},null]},{"text":"Llegué tarde al compromiso.","en":"I was late for the appointment.","audio":"https://tatoeba.org/en/audio/download/735763","words":[{"g":"to arrive, get","l":"llegar"},{"g":"late"},{"g":"to the"},null]},{"text":"Tom casi nunca llega tarde a sus compromisos.","en":"Tom is hardly ever late for appointments.","words":[null,{"g":"almost"},{"g":"never"},{"g":"to arrive, get","l":"llegar"},{"g":"late"},{"g":"to"},{"g":"his, her, its, their"},null]},{"text":"No puedo ir con usted, tengo un compromiso.","en":"I can't go with you. I have an engagement.","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to go"},{"g":"with"},{"g":"you (formal)"},{"g":"to have","l":"tener"},{"g":"a"},null]},{"text":"Tom tiene miedo al compromiso.","en":"Tom is afraid of commitment.","words":[null,{"g":"to have","l":"tener"},{"g":"fear"},{"g":"to the"},null]}]}