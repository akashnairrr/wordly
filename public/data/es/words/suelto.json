{"id":"suelto","lemma":"suelto","pos":"adj","rank":2772,"glosses":["free, loose, undone","isolated, separate","free, agile, fluent"],"ipa":"/ˈswelto/","forms":{"feminine":"suelta","masculinePlural":"sueltos","femininePlural":"sueltas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/93/LL-Q1321_%28spa%29-AdrianAbdulBaha-suelto.wav","examples":[{"text":"Ella lleva el pelo suelto.","en":"She wears her hair loose.","audio":"https://tatoeba.org/en/audio/download/456422","words":[{"g":"she"},{"g":"to take somewhere","l":"llevar"},{"g":"the"},{"g":"hair"},null]},{"text":"¿Tienes algo suelto?","en":"Do you have any small change?","audio":"https://tatoeba.org/en/audio/download/531783","words":[{"g":"to have","l":"tener"},{"g":"something, anything"},null]},{"text":"Me quedan tres dólares sueltos.","en":"I have just three dollars left.","audio":"https://tatoeba.org/en/audio/download/531855","words":[{"g":"me"},{"g":"to be , to end up","l":"quedar"},{"g":"three"},{"g":"dollar","l":"dólar"},null]},{"text":"Dejó al perro suelto en el jardín.","en":"He let the dog loose in the garden.","audio":"https://tatoeba.org/en/audio/download/608826","words":[{"g":"to leave","l":"dejar"},{"g":"to the"},{"g":"dog"},null,{"g":"in / on"},{"g":"the"},{"g":"garden"}]},{"text":"No tengo suelto.","en":"I have no small change on me.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null]}]}