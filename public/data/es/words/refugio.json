{"id":"refugio","lemma":"refugio","pos":"noun","rank":1884,"glosses":["refuge","safety"],"ipa":"/reˈfuxjo/","gender":"m","forms":{"plural":"refugios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6b/LL-Q1321_%28spa%29-Marreromarco-refugio.wav","examples":[{"text":"Vamos a necesitar refugio.","en":"We'll need shelter.","audio":"https://tatoeba.org/en/audio/download/501314","words":[{"g":"to go","l":"ir"},{"g":"to"},{"g":"to need"},null]},{"text":"El viejo dio refugio al niño.","en":"The old man gave the child shelter.","words":[{"g":"the"},{"g":"old person"},{"g":"to give, to give out","l":"dar"},null,{"g":"to the"},{"g":"child, boy"}]},{"text":"Él buscó refugio de la lluvia.","en":"He sought shelter from the rain.","words":[{"g":"he"},{"g":"to seek","l":"buscar"},null,null,null,{"g":"rain"}],"phrases":[[3,5,"of the"]]},{"text":"La gente inventó refugios para protegerse a si mismos.","en":"People devised shelters in order to protect themselves.","words":[{"g":"the / her"},{"g":"people"},{"g":"to invent","l":"inventar"},null,{"g":"for"},{"g":"to protect, to defend","l":"proteger"},{"g":"to"},{"g":"if, whether"},{"g":"same","l":"mismo"}]},{"text":"Ella dio refugio al desertor.","en":"She harbored the deserter.","words":[{"g":"she"},{"g":"to give, to give out","l":"dar"},null,{"g":"to the"},{"g":"deserting"}]}]}