{"id":"recie_n","lemma":"recién","pos":"adv","rank":1349,"glosses":["recently; new-, newly, freshly","just now, recently","only, just"],"ipa":"/reˈθjen/","examples":[{"text":"Recién acabo de terminar mi trabajo.","en":"I've just finished my work.","words":[null,{"g":"synonym of acabamiento"},{"g":"of / from"},{"g":"to finish"},{"g":"my"},{"g":"work, job"}]},{"text":"¿Dónde puedes conseguir el mejor pan recién hecho?","en":"Where can you get the best fresh bread?","audio":"https://tatoeba.org/en/audio/download/705451","words":[{"g":"where"},{"g":"to be able to, can","l":"poder"},{"g":"to achieve"},{"g":"the"},{"g":"better"},{"g":"bread"},null,{"g":"done, completed"}]},{"text":"Somos recién casados.","en":"We're newlyweds.","audio":"https://tatoeba.org/en/audio/download/412489","words":[{"g":"to be","l":"ser"},null,{"g":"married","l":"casado"}]},{"text":"La pared está recién pintada.","en":"The wall is freshly painted.","words":[{"g":"the / her"},{"g":"wall"},{"g":"to be","l":"estar"},null,{"g":"paint"}]},{"text":"Tengo café, té, agua y zumo recién hecho.","en":"I have coffee, tea, water and freshly made juice.","audio":"https://tatoeba.org/en/audio/download/1156073","words":[{"g":"to have","l":"tener"},{"g":"coffee"},{"g":"tea"},{"g":"water"},{"g":"and"},{"g":"juice"},null,{"g":"done, completed"}]}]}