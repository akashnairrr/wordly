{"id":"carrera","lemma":"carrera","pos":"noun","rank":590,"glosses":["race","run (act of running)","run"],"ipa":"/kaˈreɾa/","gender":"f","forms":{"plural":"carreras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fa/LL-Q1321_%28spa%29-Marreromarco-carrera.wav","examples":[{"text":"La carrera ha terminado.","en":"The race is over.","audio":"https://tatoeba.org/en/audio/download/444468"},{"text":"Tom ganó tres carreras.","en":"Tom won three races.","audio":"https://tatoeba.org/en/audio/download/298918"},{"text":"Tom ganó la carrera.","en":"Tom won the race.","audio":"https://tatoeba.org/en/audio/download/734470"},{"text":"Me gustan las carreras de caballos.","en":"I like horse races.","audio":"https://tatoeba.org/en/audio/download/449340"},{"text":"La carrera estaba arreglada.","en":"The race was fixed.","audio":"https://tatoeba.org/en/audio/download/501294"}]}