{"id":"pensamiento","lemma":"pensamiento","pos":"noun","rank":1692,"glosses":["thought","thinking","pansy (flower)"],"ipa":"/pensaˈmjento/","gender":"m","forms":{"plural":"pensamientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-pensamiento.wav","examples":[{"text":"Gracias por compartir tus pensamientos.","en":"Thanks for sharing your thoughts.","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"to share"},{"g":"your"},null]},{"text":"¡Qué pensamiento!","en":"What a thought!","audio":"https://tatoeba.org/en/audio/download/441420","words":[{"g":"what"},null]},{"text":"¡Qué pensamiento tan extraño!","en":"What a strange thought!","words":[{"g":"what"},null,{"g":"so, as"},{"g":"strange"}]},{"text":"Ella traspasó sus pensamientos al papel.","en":"She put down her thoughts on paper.","words":[{"g":"she"},null,{"g":"his, her, its, their"},null,{"g":"to the"},{"g":"paper"}]},{"text":"Ese pensamiento me aterrorizó.","en":"That thought terrified me.","words":[{"g":"that"},null,{"g":"me"},{"g":"to terrify","l":"aterrorizar"}]}]}