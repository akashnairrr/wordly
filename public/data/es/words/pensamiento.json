{"id":"pensamiento","lemma":"pensamiento","pos":"noun","rank":1692,"glosses":["thought","thinking","pansy (flower)"],"ipa":"/pensaˈmjento/","gender":"m","forms":{"plural":"pensamientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7f/LL-Q1321_%28spa%29-AdrianAbdulBaha-pensamiento.wav","examples":[{"text":"¡Qué pensamiento!","en":"What a thought!","audio":"https://tatoeba.org/en/audio/download/441420","words":[{"g":"what"},null]},{"text":"Gracias por compartir tus pensamientos.","en":"Thanks for sharing your thoughts.","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"to share"},{"g":"your"},null]},{"text":"¡Qué pensamiento tan extraño!","en":"What a strange thought!","words":[{"g":"what"},null,{"g":"so, as"},{"g":"strange"}]},{"text":"Tom parece estar perdido en sus pensamientos.","en":"Tom seems to be absorbed in thought.","words":[null,{"g":"to seem, to see fit","l":"parecer"},{"g":"to be"},{"g":"lost"},{"g":"in / on"},{"g":"his, her, its, their"},null]},{"text":"Los pensamientos se expresan con palabras.","en":"Thoughts are expressed by means of words.","audio":"https://tatoeba.org/en/audio/download/693787","words":[{"g":"the / them"},null,{"g":"oneself"},{"g":"to express","l":"expresar"},{"g":"with"},{"g":"word","l":"palabra"}]}]}