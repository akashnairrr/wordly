{"id":"laboral","lemma":"laboral","pos":"adj","rank":4650,"glosses":["labor"],"ipa":"/laboˈɾal/","forms":{"femininePlural":"laborales"},"examples":[{"text":"Nuestro entorno laboral fue bueno.","en":"Our working environment was good.","audio":"https://tatoeba.org/en/audio/download/741272","words":[{"g":"our, ours, to us"},{"g":"surroundings"},null,{"g":"to be","l":"ser"},{"g":"good"}]},{"text":"Quieren mejorar sus condiciones laborales.","en":"They want to better their working conditions.","audio":"https://tatoeba.org/en/audio/download/692366","words":[{"g":"to desire","l":"querer"},{"g":"to make better"},{"g":"his, her, its, their"},{"g":"condition","l":"condición"},null]},{"text":"No te preocupes. Esto son gastos laborales.","en":"Don't worry. These are work expenses.","audio":"https://tatoeba.org/en/audio/download/1187438","words":[null,null,null,{"g":"this"},{"g":"to be","l":"ser"},{"g":"expenditure, cost","l":"gasto"},null],"phrases":[[0,3,"don't worry"]]},{"text":"Ellos reclaman una reducción de su horario laboral.","en":"They are demanding shorter working hours.","words":[{"g":"they","l":"él"},{"g":"to reclaim","l":"reclamar"},{"g":"a"},{"g":"reduction"},{"g":"of / from"},{"g":"his / her / your"},{"g":"timetable, schedule"},null]}]}