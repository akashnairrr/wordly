{"id":"probable","lemma":"probable","pos":"adj","rank":1360,"glosses":["probable, likely","provable"],"ipa":"/pɾoˈbable/","forms":{"femininePlural":"probables"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/7c/LL-Q1321_%28spa%29-Marreromarco-probable.wav","examples":[{"text":"Simplemente no parece probable.","en":"It just doesn't seem likely.","audio":"https://tatoeba.org/en/audio/download/306307"},{"text":"La precipitación es poco probable.","en":"Rain is unlikely.","audio":"https://tatoeba.org/en/audio/download/443179"},{"text":"Es probable que él venga.","en":"He is likely to come.","audio":"https://tatoeba.org/en/audio/download/453624"},{"text":"Eso es muy poco probable.","en":"That's highly unlikely.","audio":"https://tatoeba.org/en/audio/download/461275"},{"text":"Es probable que estés equivocado.","en":"You are probably wrong.","audio":"https://tatoeba.org/en/audio/download/522435"}]}