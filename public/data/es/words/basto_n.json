{"id":"basto_n","lemma":"bastón","pos":"noun","rank":3872,"glosses":["walking stick, staff, cane","baton (in a marching band)","riband"],"ipa":"/basˈton/","gender":"m","forms":{"plural":"bastones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/75/LL-Q1321_%28spa%29-Marreromarco-bast%C3%B3n.wav","examples":[{"text":"Dame mi bastón.","en":"Give me my cane.","audio":"https://tatoeba.org/en/audio/download/441608","words":[{"g":"to give, to give out","l":"dar"},{"g":"my"},null]},{"text":"¿Dónde está mi bastón?","en":"Where's my cane?","audio":"https://tatoeba.org/en/audio/download/442292","words":[null,null,{"g":"my"},null],"phrases":[[0,2,"where are you?"]]},{"text":"Mi abuelo no puede caminar sin su bastón.","en":"My grandfather can't walk without his cane.","words":[{"g":"my"},{"g":"grandfather"},{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to walk"},{"g":"without"},{"g":"his / her / your"},null]},{"text":"Se apoya en un bastón.","en":"He's leaning on a cane.","words":[{"g":"oneself"},{"g":"to lean","l":"apoyar"},{"g":"in / on"},{"g":"a"},null]},{"text":"Él caminaba con un bastón en su mano.","en":"He was walking with a stick in his hand.","words":[{"g":"he"},{"g":"to walk","l":"caminar"},{"g":"with"},{"g":"a"},null,{"g":"in / on"},{"g":"his / her / your"},{"g":"hand"}]}]}