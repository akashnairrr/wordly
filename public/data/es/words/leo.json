{"id":"leo","lemma":"leo","pos":"adj","rank":1140,"glosses":["Leo"],"ipa":"/ˈleo/","forms":{"femininePlural":"leos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/47/LL-Q1321_%28spa%29-AdrianAbdulBaha-leo.wav","examples":[{"text":"Con frecuencia leo libros.","en":"I often read books.","audio":"https://tatoeba.org/en/audio/download/103804"},{"text":"Yo no leo sus novelas.","en":"I do not read his novels.","audio":"https://tatoeba.org/en/audio/download/639176"},{"text":"Leo el New York Times.","en":"I read The New York Times.","audio":"https://tatoeba.org/en/audio/download/44195"},{"text":"Leo toda clase de libros.","en":"I read all kinds of books.","audio":"https://tatoeba.org/en/audio/download/47616"},{"text":"Yo usualmente leo mientras como.","en":"I usually read while I eat.","audio":"https://tatoeba.org/en/audio/download/518192"}]}