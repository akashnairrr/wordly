{"id":"ri_o","lemma":"río","pos":"noun","rank":835,"glosses":["river"],"ipa":"/ˈrio/","gender":"m","forms":{"plural":"ríos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q1321_%28spa%29-Rodelar-r%C3%ADo.wav","examples":[{"text":"El río es amplio.","en":"The river is wide.","audio":"https://tatoeba.org/en/audio/download/519454"},{"text":"Hay muchos ríos en esa isla.","en":"There are many rivers on that island.","audio":"https://tatoeba.org/en/audio/download/557483"},{"text":"Nadé en el río.","en":"I swam in the river.","audio":"https://tatoeba.org/en/audio/download/222244"},{"text":"Las líneas azules en el mapa representan ríos.","en":"Blue lines on the map designate rivers."},{"text":"El río es peligroso.","en":"The river is dangerous.","audio":"https://tatoeba.org/en/audio/download/519539"}]}