{"id":"pasada","lemma":"pasada","pos":"noun","rank":998,"glosses":["transit, crossing","moment, time","turn, run, instance"],"ipa":"/paˈsada/","gender":"f","forms":{"plural":"pasadas"},"examples":[{"text":"Su padre murió la semana pasada.","en":"Her father passed away last week.","audio":"https://tatoeba.org/en/audio/download/687679","words":[{"g":"his / her / your"},{"g":"father, parent"},{"g":"to die","l":"morir"},{"g":"the / her"},{"g":"week"},null]},{"text":"La semana pasada estaba en el hospital.","en":"I was in the hospital last week.","audio":"https://tatoeba.org/en/audio/download/594356","words":[{"g":"the / her"},{"g":"week"},null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},{"g":"hospital"}]},{"text":"La semana pasada él estuvo enfermo.","en":"He was sick last week.","audio":"https://tatoeba.org/en/audio/download/527045","words":[{"g":"the / her"},{"g":"week"},null,{"g":"he"},{"g":"to be","l":"estar"},{"g":"sick, ill"}]},{"text":"¿Viste la televisión la pasada noche?","en":"Did you watch TV last night?","audio":"https://tatoeba.org/en/audio/download/531569","words":[{"g":"you know"},{"g":"the / her"},{"g":"television"},{"g":"the / her"},null,{"g":"night"}]},{"text":"Ocurrió una cosa terrible la semana pasada.","en":"A terrible thing happened last week.","audio":"https://tatoeba.org/en/audio/download/515061","words":[{"g":"to happen, to occur","l":"ocurrir"},{"g":"a"},{"g":"thing"},{"g":"terrible"},{"g":"the / her"},{"g":"week"},null]}]}