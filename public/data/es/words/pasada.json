{"id":"pasada","lemma":"pasada","pos":"noun","rank":1001,"glosses":["transit, crossing","moment, time","turn, run, instance"],"ipa":"/paˈsada/","gender":"f","forms":{"plural":"pasadas"},"examples":[{"text":"Nos conocimos la semana pasada.","en":"We met last week.","audio":"https://tatoeba.org/en/audio/download/119085"},{"text":"A veces la mente nos juega malas pasadas.","en":"Sometimes our minds play tricks on us.","audio":"https://tatoeba.org/en/audio/download/1155970"},{"text":"La vi la semana pasada.","en":"I saw her last week.","audio":"https://tatoeba.org/en/audio/download/45402"},{"text":"Ella siempre usa pilchas pasadas de moda.","en":"She always wears clothes which are out of fashion."},{"text":"Lo vi la semana pasada.","en":"I saw him last week.","audio":"https://tatoeba.org/en/audio/download/448656"}]}