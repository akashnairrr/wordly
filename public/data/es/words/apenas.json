{"id":"apenas","lemma":"apenas","pos":"adv","rank":725,"glosses":["barely, scarcely","recently, just","as soon as"],"ipa":"/aˈpenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-Marreromarco-apenas.wav","examples":[{"text":"Apenas te conozco.","en":"I barely know you.","audio":"https://tatoeba.org/en/audio/download/443889","words":[null,{"g":"you"},{"g":"to know","l":"conocer"}]},{"text":"Apenas puedo entender qué me está diciendo.","en":"I can barely understand what he's saying.","audio":"https://tatoeba.org/en/audio/download/1189103","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to understand"},{"g":"what"},{"g":"me"},{"g":"to be","l":"estar"},{"g":"to say","l":"decir"}]},{"text":"Apenas puede hablar.","en":"He can hardly speak.","audio":"https://tatoeba.org/en/audio/download/450497","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to talk"}]},{"text":"Apenas consigo verla.","en":"I can barely see it.","audio":"https://tatoeba.org/en/audio/download/83231","words":[null,{"g":"with himself"},{"g":"to see, to spot","l":"ver"}]},{"text":"Tom apenas puede caminar.","en":"Tom can barely walk.","audio":"https://tatoeba.org/en/audio/download/799136","words":[null,null,{"g":"to be able to, can","l":"poder"},{"g":"to walk"}]}]}