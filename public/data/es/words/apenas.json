{"id":"apenas","lemma":"apenas","pos":"adv","rank":725,"glosses":["barely, scarcely","recently, just","as soon as"],"ipa":"/aˈpenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-Marreromarco-apenas.wav","examples":[{"text":"Apenas te conozco.","en":"I barely know you.","audio":"https://tatoeba.org/en/audio/download/443889","words":[null,{"g":"you"},{"g":"to know","l":"conocer"}]},{"text":"Apenas puedo verlo.","en":"I can barely see it.","audio":"https://tatoeba.org/en/audio/download/80575","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to see, to spot","l":"ver"}]},{"text":"Apenas podía trabajar.","en":"I was barely able to work.","audio":"https://tatoeba.org/en/audio/download/512008","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to work"}]},{"text":"Ahora apenas tengo dinero.","en":"I have little money now.","audio":"https://tatoeba.org/en/audio/download/526598","words":[{"g":"now"},null,{"g":"to have","l":"tener"},{"g":"money"}]},{"text":"Estuve aquí apenas ayer.","en":"I was just here yesterday.","audio":"https://tatoeba.org/en/audio/download/512915","words":[{"g":"to be","l":"estar"},{"g":"here"},null,{"g":"yesterday"}]}]}