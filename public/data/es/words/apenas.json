{"id":"apenas","lemma":"apenas","pos":"adv","rank":728,"glosses":["barely, scarcely","recently, just","as soon as"],"ipa":"/aˈpenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/a/a2/LL-Q1321_%28spa%29-Marreromarco-apenas.wav","examples":[{"text":"Tom apenas puede caminar.","en":"Tom can barely walk.","audio":"https://tatoeba.org/en/audio/download/799136"},{"text":"Ahora apenas tengo dinero.","en":"I have little money now.","audio":"https://tatoeba.org/en/audio/download/526598"},{"text":"Ella apenas comió nada.","en":"She hardly ate anything.","audio":"https://tatoeba.org/en/audio/download/526719"},{"text":"Tom apenas come nada.","en":"Tom hardly eats anything.","audio":"https://tatoeba.org/en/audio/download/806528"},{"text":"Estuve aquí apenas ayer.","en":"I was just here yesterday.","audio":"https://tatoeba.org/en/audio/download/512915"}]}