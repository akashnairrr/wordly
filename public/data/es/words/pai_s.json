{"id":"pai_s","lemma":"país","pos":"noun","rank":397,"glosses":["country (the territory of a nation)","country, land (a set region of land having particular human occupation or agreed limits)"],"ipa":"/paˈis/","gender":"m","forms":{"plural":"países"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Precision27-pa%C3%ADs.wav","formAudio":{"países":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Precision27-pa%C3%ADses.wav"},"examples":[{"text":"Mi país me necesita.","en":"My country needs me.","audio":"https://tatoeba.org/en/audio/download/550389","words":[{"g":"my"},null,{"g":"me"},{"g":"to need","l":"necesitar"}]},{"text":"¿Qué sabes de mi país?","en":"What do you know about my country?","audio":"https://tatoeba.org/en/audio/download/823262","words":[{"g":"what"},{"g":"to know, to understand","l":"saber"},{"g":"of / from"},{"g":"my"},null]},{"text":"Ambos países están en paz ahora.","en":"Both countries are now at peace.","audio":"https://tatoeba.org/en/audio/download/590375","words":[{"g":"both"},null,{"g":"to be","l":"estar"},null,null,{"g":"now"}],"phrases":[[3,5,"in peace"]]},{"text":"Ella vive en el país.","en":"She lives in the country.","audio":"https://tatoeba.org/en/audio/download/639568","words":[{"g":"she"},{"g":"to applaud","l":"vivar"},{"g":"in / on"},{"g":"the"},null]},{"text":"Ellos vienen del mismo país.","en":"They come from the same country.","audio":"https://tatoeba.org/en/audio/download/77688","words":[{"g":"they","l":"él"},{"g":"to come","l":"venir"},null,null,null],"phrases":[[2,4,"thereof"]]}]}