{"id":"pai_s","lemma":"país","pos":"noun","rank":400,"glosses":["country (the territory of a nation)","country, land (a set region of land having particular human occupation or agreed limits)"],"ipa":"/paˈis/","gender":"m","forms":{"plural":"países"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Precision27-pa%C3%ADs.wav","formAudio":{"países":"https://upload.wikimedia.org/wikipedia/commons/e/e1/LL-Q1321_%28spa%29-Precision27-pa%C3%ADses.wav"},"examples":[{"text":"Mi país me necesita.","en":"My country needs me.","audio":"https://tatoeba.org/en/audio/download/550389"},{"text":"¿Qué países has visitado?","en":"Which countries have you visited?","audio":"https://tatoeba.org/en/audio/download/524872"},{"text":"Nadie conoce mi país.","en":"Nobody knows my country.","audio":"https://tatoeba.org/en/audio/download/639756"},{"text":"El arroz crece en países cálidos.","en":"Rice grows in warm countries.","audio":"https://tatoeba.org/en/audio/download/706767"},{"text":"¿De qué país eres?","en":"What country are you from?","audio":"https://tatoeba.org/en/audio/download/1571"}]}