{"id":"contento","lemma":"contento","pos":"adj","rank":1147,"glosses":["content","happy, glad","pleased, chuffed (British)"],"ipa":"/konˈtento/","forms":{"feminine":"contenta","masculinePlural":"contentos","femininePlural":"contentas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-AdrianAbdulBaha-contento.wav","formAudio":{"contenta":"https://upload.wikimedia.org/wikipedia/commons/4/48/LL-Q1321_%28spa%29-Marreromarco-contenta.wav"},"examples":[{"text":"Tom se ve contento.","en":"Tom looks perky.","audio":"https://tatoeba.org/en/audio/download/799872"},{"text":"Ella siempre está contenta.","en":"She is always cheerful.","audio":"https://tatoeba.org/en/audio/download/38905"},{"text":"Se les ve contentos hoy.","en":"They look happy today.","audio":"https://tatoeba.org/en/audio/download/459237"},{"text":"Parecen contentas.","en":"They look happy.","audio":"https://tatoeba.org/en/audio/download/424611"},{"text":"Yo no estoy contento.","en":"I'm not satisfied.","audio":"https://tatoeba.org/en/audio/download/451011"}]}