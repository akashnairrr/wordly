{"id":"frente","lemma":"frente","pos":"noun","rank":464,"glosses":["forehead, brow"],"ipa":"/ˈfɾente/","gender":"f","forms":{"plural":"frentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Precision27-frente.wav","formAudio":{"frentes":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-Eavqwiki-frentes.wav"},"examples":[{"text":"Tu frente está caliente.","en":"Your forehead is hot.","audio":"https://tatoeba.org/en/audio/download/851413","words":[{"g":"your"},null,{"g":"to be","l":"estar"},{"g":"hot, warm"}]},{"text":"¿Qué hay frente a ti?","en":"What's in front of you?","audio":"https://tatoeba.org/en/audio/download/850142","words":[null,null,null,{"g":"to"},{"g":"you","l":"tú"}],"phrases":[[0,2,"what's up?"]]},{"text":"Él me besó en la frente.","en":"He kissed me on the forehead.","audio":"https://tatoeba.org/en/audio/download/333000","words":[{"g":"he"},{"g":"me"},{"g":"to kiss","l":"besar"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"Alguien está en la puerta del frente.","en":"Someone is at the front door.","audio":"https://tatoeba.org/en/audio/download/78180","words":[{"g":"someone, somebody"},{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the / her"},{"g":"door"},{"g":"of the"},null]},{"text":"Hay un banco en frente del hotel.","en":"There's a bank in front of the hotel.","audio":"https://tatoeba.org/en/audio/download/568154","words":[{"g":"to have","l":"haber"},{"g":"a"},{"g":"bank"},{"g":"in / on"},null,{"g":"of the"},{"g":"hotel"}]}]}