{"id":"frente","lemma":"frente","pos":"noun","rank":464,"glosses":["forehead, brow"],"ipa":"/ˈfɾente/","gender":"f","forms":{"plural":"frentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Precision27-frente.wav","formAudio":{"frentes":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-Eavqwiki-frentes.wav"},"examples":[{"text":"Mantén tu frente en alto.","en":"Keep your chin up.","audio":"https://tatoeba.org/en/audio/download/444059","words":[{"g":"to keep","l":"mantener"},{"g":"your"},null,null,null],"phrases":[[3,5,"high up"]]},{"text":"Tu frente está caliente.","en":"Your forehead is hot.","audio":"https://tatoeba.org/en/audio/download/851413","words":[{"g":"your"},null,{"g":"to be","l":"estar"},{"g":"hot, warm"}]},{"text":"¿Qué hay frente a ti?","en":"What's in front of you?","audio":"https://tatoeba.org/en/audio/download/850142","words":[null,null,null,{"g":"to"},{"g":"you","l":"tú"}],"phrases":[[0,2,"what's up?"]]},{"text":"Hay un lago en frente de mi casa.","en":"There is a lake in front of my house.","audio":"https://tatoeba.org/en/audio/download/608538","words":[{"g":"to have","l":"haber"},{"g":"a"},{"g":"lake"},{"g":"in / on"},null,{"g":"of / from"},{"g":"my"},{"g":"house"}]},{"text":"Había un árbol alto frente a mi casa.","en":"There was a tall tree in front of my house.","audio":"https://tatoeba.org/en/audio/download/615917","words":[{"g":"makes pluperfect to…"},{"g":"a"},{"g":"tree"},{"g":"tall"},null,{"g":"to"},{"g":"my"},{"g":"house"}]}]}