{"id":"frente","lemma":"frente","pos":"noun","rank":467,"glosses":["forehead, brow"],"ipa":"/ˈfɾente/","gender":"f","forms":{"plural":"frentes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Precision27-frente.wav","formAudio":{"frentes":"https://upload.wikimedia.org/wikipedia/commons/a/ac/LL-Q1321_%28spa%29-Eavqwiki-frentes.wav"},"examples":[{"text":"Nos sentamos al frente.","en":"We sat in the front.","audio":"https://tatoeba.org/en/audio/download/455150"},{"text":"Tu frente está caliente.","en":"Your forehead is hot.","audio":"https://tatoeba.org/en/audio/download/851413"},{"text":"Da un paso al frente.","en":"Step forward.","audio":"https://tatoeba.org/en/audio/download/438978"},{"text":"Mantén tu frente en alto.","en":"Keep your chin up.","audio":"https://tatoeba.org/en/audio/download/444059"},{"text":"¿Qué hay frente a ti?","en":"What's in front of you?","audio":"https://tatoeba.org/en/audio/download/850142"}]}