{"id":"escondido","lemma":"escondido","pos":"adj","rank":1976,"glosses":["hidden"],"ipa":"/eskonˈdido/","forms":{"feminine":"escondida","masculinePlural":"escondidos","femininePlural":"escondidas"},"examples":[{"text":"Tom todavía está escondido.","en":"Tom is still hiding.","audio":"https://tatoeba.org/en/audio/download/799991"},{"text":"¿Querés jugar a la escondida?","en":"Do you want to play hide and seek?"},{"text":"Se rumorea que hay tesoros escondidos allí.","en":"It's rumored there are treasures hidden there.","audio":"https://tatoeba.org/en/audio/download/635480"},{"text":"Estabais escuchando a escondidas.","en":"You were eavesdropping.","audio":"https://tatoeba.org/en/audio/download/415808"},{"text":"¿Dónde estaba Tom escondido?","en":"Where was Tom hiding?","audio":"https://tatoeba.org/en/audio/download/803629"}]}