{"id":"depo_sito","lemma":"depósito","pos":"noun","rank":2028,"glosses":["deposit","store, stock, depot, warehouse, repository","tank, reservoir"],"ipa":"/deˈposito/","gender":"m","forms":{"plural":"depósitos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/04/LL-Q1321_%28spa%29-Marreromarco-dep%C3%B3sito.wav","examples":[{"text":"No quiero perder mi depósito.","en":"I don't want to lose my deposit.","words":[{"g":"no / not"},{"g":"to desire","l":"querer"},{"g":"to lose"},{"g":"my"},null]},{"text":"Llena el depósito.","en":"Fill up the tank.","audio":"https://tatoeba.org/en/audio/download/194668","words":[{"g":"full","l":"lleno"},{"g":"the"},null]},{"text":"¿Requiere usted un depósito?","en":"Do you require a deposit?","audio":"https://tatoeba.org/en/audio/download/515240","words":[{"g":"to require, need","l":"requerir"},{"g":"you (formal)"},{"g":"a"},null]},{"text":"Con el depósito lleno me da para una semana.","en":"A full tank lasts me a week.","audio":"https://tatoeba.org/en/audio/download/690808","words":[{"g":"with"},{"g":"the"},null,{"g":"full"},{"g":"me"},{"g":"to give, to give out","l":"dar"},{"g":"for"},{"g":"a"},{"g":"week"}]},{"text":"En la parte inferior iba el depósito de gasolina.","en":"The gasoline tank was underneath.","words":[{"g":"in / on"},{"g":"the / her"},{"g":"part"},{"g":"inferior"},{"g":"to go","l":"ir"},{"g":"the"},null,{"g":"of / from"},{"g":"petrol, gasoline"}]}]}