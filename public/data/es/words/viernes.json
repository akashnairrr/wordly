{"id":"viernes","lemma":"viernes","pos":"noun","rank":1106,"glosses":["Friday"],"ipa":"/ˈbjeɾnes/","gender":"m","forms":{"plural":"viernes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/18/LL-Q1321_%28spa%29-Precision27-viernes.wav","examples":[{"text":"Al fin es viernes.","en":"Finally, it's Friday.","audio":"https://tatoeba.org/en/audio/download/453684"},{"text":"Comen pescado los viernes.","en":"They eat fish on Fridays.","audio":"https://tatoeba.org/en/audio/download/639870"},{"text":"¿Qué harás el viernes?","en":"What will you do on Friday?","audio":"https://tatoeba.org/en/audio/download/616259"},{"text":"Tengo una cita el viernes.","en":"I have a date on Friday.","audio":"https://tatoeba.org/en/audio/download/459087"},{"text":"Propongo que salgamos el viernes.","en":"I suggest we go out on Friday.","audio":"https://tatoeba.org/en/audio/download/1607"}]}