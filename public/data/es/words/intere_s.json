{"id":"intere_s","lemma":"interés","pos":"noun","rank":1206,"glosses":["interest (a fraction of the amount of what was borrowed)","interest (attention that is given to something or someone)","interest (an involvement or stake in an undertaking)"],"ipa":"/inteˈɾes/","gender":"m","forms":{"plural":"intereses"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/49/LL-Q1321_%28spa%29-AdrianAbdulBaha-inter%C3%A9s.wav","formAudio":{"intereses":"https://upload.wikimedia.org/wikipedia/commons/d/dc/LL-Q1321_%28spa%29-GlyphEnjoyer-intereses.wav"},"examples":[{"text":"Agradezco tu interés.","en":"I appreciate your interest.","audio":"https://tatoeba.org/en/audio/download/515278","words":[{"g":"to thank","l":"agradecer"},{"g":"your"},null]},{"text":"Eso no tiene interés.","en":"That's not interesting.","audio":"https://tatoeba.org/en/audio/download/461062","words":[{"g":"that","l":"ése"},{"g":"no / not"},{"g":"to have","l":"tener"},null]},{"text":"Tom parece tener un interés real.","en":"Tom looks genuinely interested.","audio":"https://tatoeba.org/en/audio/download/801375","words":[null,{"g":"to seem, to see fit","l":"parecer"},{"g":"to have"},{"g":"a"},null,{"g":"real"}]},{"text":"Tengo interés en tomar fotos.","en":"I'm interested in taking pictures.","audio":"https://tatoeba.org/en/audio/download/526837","words":[{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"to take"},{"g":"photo, photograph","l":"foto"}]},{"text":"No tengo interés en hacer eso ahora.","en":"I'm not interested in doing that now.","audio":"https://tatoeba.org/en/audio/download/427923","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"in / on"},{"g":"to do"},{"g":"that","l":"ése"},{"g":"now"}]}]}