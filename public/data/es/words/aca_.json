{"id":"aca_","lemma":"acá","pos":"adv","rank":610,"glosses":["here (in the speaker's location)","as of, up to (used with a time phrase to represent continuity up to the present)"],"ipa":"/aˈka/","audio":"https://upload.wikimedia.org/wikipedia/commons/2/23/LL-Q1321_%28spa%29-Guergana-ac%C3%A1.wav","examples":[{"text":"¿Puede escribir su nombre acá?","en":"Can you write your name here?","audio":"https://tatoeba.org/en/audio/download/598978","words":[{"g":"to be able to, can","l":"poder"},{"g":"to write"},{"g":"his / her / your"},{"g":"name"},null]},{"text":"¿Podrías venir acá?","en":"Would you please come over here?","audio":"https://tatoeba.org/en/audio/download/606664","words":[{"g":"to be able to, can","l":"poder"},{"g":"to come"},null]},{"text":"Ven acá.","en":"Come over here.","audio":"https://tatoeba.org/en/audio/download/437311","words":[{"g":"to come","l":"venir"},null]},{"text":"Todavía estoy acá.","en":"I'm still here.","audio":"https://tatoeba.org/en/audio/download/440983","words":[{"g":"still, yet"},{"g":"to be","l":"estar"},null]},{"text":"Quiero trabajar acá.","en":"I want to work here.","audio":"https://tatoeba.org/en/audio/download/449285","words":[{"g":"to desire","l":"querer"},{"g":"to work"},null]}]}