{"id":"apropiado","lemma":"apropiado","pos":"adj","rank":2248,"glosses":["appropriate, suitable"],"ipa":"/apɾoˈpjado/","forms":{"feminine":"apropiada","masculinePlural":"apropiados","femininePlural":"apropiadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/63/LL-Q1321_%28spa%29-Marreromarco-apropiado.wav","examples":[{"text":"No creo que sea apropiado.","en":"I'm not sure that's suitable.","audio":"https://tatoeba.org/en/audio/download/586602","words":[{"g":"no / not"},{"g":"to believe","l":"creer"},{"g":"that"},{"g":"to be","l":"ser"},null]},{"text":"Ella es apropiada para ese trabajo.","en":"She is fit for the job.","audio":"https://tatoeba.org/en/audio/download/706785","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"for"},{"g":"that"},{"g":"work, job"}]},{"text":"Esta canción parecía apropiada.","en":"This song seemed appropriate.","words":[{"g":"this","l":"este"},{"g":"song"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"No me parece apropiado.","en":"I don't think it's appropriate.","audio":"https://tatoeba.org/en/audio/download/506651","words":[{"g":"no / not"},{"g":"me"},{"g":"to seem, to see fit","l":"parecer"},null]},{"text":"Esta película es apropiada para niños.","en":"This movie is suitable for children.","words":[{"g":"this","l":"este"},{"g":"film"},{"g":"to be","l":"ser"},null,{"g":"for"},{"g":"child, boy","l":"niño"}]}]}