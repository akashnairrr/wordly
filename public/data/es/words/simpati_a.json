{"id":"simpati_a","lemma":"simpatía","pos":"noun","rank":4724,"glosses":["sympathy","friendliness, niceness"],"ipa":"/simpaˈtia/","gender":"f","forms":{"plural":"simpatías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-Emanuelps27-simpat%C3%ADa.wav","examples":[{"text":"Te agradezco tu simpatía.","en":"I thank you for your sympathy.","audio":"https://tatoeba.org/en/audio/download/803912","words":[{"g":"you"},{"g":"to thank","l":"agradecer"},{"g":"your"},null]},{"text":"Sentimos simpatía hacia ella.","en":"We felt sympathy for her.","audio":"https://tatoeba.org/en/audio/download/803910","words":[{"g":"to feel","l":"sentir"},null,{"g":"toward, towards"},{"g":"she"}]},{"text":"Tom cuenta con mi simpatía.","en":"Tom has my sympathy.","words":[null,{"g":"count, tally"},{"g":"with"},{"g":"my"},null]},{"text":"A menudo descubres que la simpatía se convierte en amor.","en":"You often find that sympathy turns into love.","words":[null,null,{"g":"to discover","l":"descubrir"},{"g":"that"},{"g":"the / her"},null,{"g":"oneself"},{"g":"to turn into","l":"convertir"},{"g":"in / on"},{"g":"love"}],"phrases":[[0,2,"often, oftentimes"]]},{"text":"Tom sintió simpatía hacia Mary.","en":"Tom felt sympathy for Mary.","audio":"https://tatoeba.org/en/audio/download/803911","words":[null,{"g":"to feel","l":"sentir"},null,{"g":"toward, towards"},null]}]}