{"id":"atado","lemma":"atado","pos":"adj","rank":3096,"glosses":["tied, tied up, tied down","confused","timid"],"ipa":"/aˈtado/","forms":{"feminine":"atada","masculinePlural":"atados","femininePlural":"atadas"},"examples":[{"text":"Tengo las manos atadas.","en":"My hands are tied.","audio":"https://tatoeba.org/en/audio/download/444518","words":[{"g":"to have","l":"tener"},{"g":"the / them"},{"g":"hand","l":"mano"},null]},{"text":"Estaba atado de pies y manos.","en":"He was bound hand and foot.","words":[{"g":"to be","l":"estar"},null,{"g":"of / from"},{"g":"foot","l":"pie"},{"g":"and"},{"g":"hand","l":"mano"}]},{"text":"Deja a tu perro atado al árbol.","en":"Keep your dog chained up to the tree.","audio":"https://tatoeba.org/en/audio/download/688840","words":[{"g":"rest"},{"g":"to"},{"g":"your"},{"g":"dog"},null,{"g":"to the"},{"g":"tree"}]},{"text":"Vuestras manos están atadas.","en":"Your hands are tied.","audio":"https://tatoeba.org/en/audio/download/800994","words":[{"g":"yours","l":"vuestro"},{"g":"hand","l":"mano"},{"g":"to be","l":"estar"},null]},{"text":"Le encontramos atado y amordazado.","en":"We found him bound and gagged.","audio":"https://tatoeba.org/en/audio/download/645640","words":[{"g":"him / her"},{"g":"to meet","l":"encontrar"},null,{"g":"and"},null]}]}