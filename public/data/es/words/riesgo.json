{"id":"riesgo","lemma":"riesgo","pos":"noun","rank":1001,"glosses":["risk; the possibility of harm or an unfavorable outcome from random chance"],"ipa":"/ˈrjesɡo/","gender":"m","forms":{"plural":"riesgos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-AdrianAbdulBaha-riesgo.wav","examples":[{"text":"¿Para qué correr el riesgo?","en":"Why take a chance?","audio":"https://tatoeba.org/en/audio/download/630254","words":[null,null,{"g":"to run, to jog"},{"g":"the"},null],"phrases":[[0,2,"what for?"]]},{"text":"Tom conocía los riesgos.","en":"Tom knew the risks.","audio":"https://tatoeba.org/en/audio/download/92633","words":[null,{"g":"to know","l":"conocer"},{"g":"the / them"},null]},{"text":"¿Existe algún riesgo?","en":"Are there any risks?","audio":"https://tatoeba.org/en/audio/download/448542","words":[{"g":"to exist","l":"existir"},null,null]},{"text":"Odio correr riesgos.","en":"I hate taking risks.","audio":"https://tatoeba.org/en/audio/download/39972","words":[{"g":"hate"},{"g":"to run, to jog"},null]},{"text":"Pondré mi vida en riesgo con ello.","en":"I'll stake my life on it.","audio":"https://tatoeba.org/en/audio/download/804231","words":[{"g":"to put, to place","l":"poner"},null,null,{"g":"in / on"},null,{"g":"with"},{"g":"it"}],"phrases":[[1,3,"my honey, my love"]]}]}