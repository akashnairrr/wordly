{"id":"riesgo","lemma":"riesgo","pos":"noun","rank":1004,"glosses":["risk; the possibility of harm or an unfavorable outcome from random chance"],"ipa":"/ˈrjesɡo/","gender":"m","forms":{"plural":"riesgos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9d/LL-Q1321_%28spa%29-AdrianAbdulBaha-riesgo.wav","examples":[{"text":"Demasiado está en riesgo.","en":"Too much is at stake.","audio":"https://tatoeba.org/en/audio/download/455383"},{"text":"Tom conocía los riesgos.","en":"Tom knew the risks.","audio":"https://tatoeba.org/en/audio/download/92633"},{"text":"Estamos en grave riesgo.","en":"We're in grave danger.","audio":"https://tatoeba.org/en/audio/download/461334"},{"text":"Esos son los riesgos.","en":"Those are the risks.","audio":"https://tatoeba.org/en/audio/download/799457"},{"text":"¿Quieres correr ese riesgo?","en":"Do you want to take that risk?","audio":"https://tatoeba.org/en/audio/download/820241"}]}