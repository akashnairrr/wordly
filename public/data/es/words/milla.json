{"id":"milla","lemma":"milla","pos":"noun","rank":1544,"glosses":["English or American mile (a unit of distance equivalent to about 1.6 km)","milla, Spanish mile (a traditional unit of distance equivalent to 1,000 pasos, about 1.4 km)"],"ipa":"/ˈmiʝa/","gender":"f","forms":{"plural":"millas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a0/LL-Q1321_%28spa%29-Marreromarco-milla.wav","examples":[{"text":"Todavía tenemos diez millas por delante.","en":"We still have ten miles to go.","audio":"https://tatoeba.org/en/audio/download/645355","words":[{"g":"still, yet"},{"g":"to have","l":"tener"},{"g":"A"},null,null,null],"phrases":[[4,6,"forward"]]},{"text":"Él puede nadar una milla.","en":"He can swim a mile.","audio":"https://tatoeba.org/en/audio/download/450049","words":[{"g":"he"},{"g":"to be able to, can","l":"poder"},{"g":"to swim"},{"g":"a"},null]},{"text":"Camino veinte millas al día.","en":"I walk twenty miles a day.","audio":"https://tatoeba.org/en/audio/download/72266","words":[{"g":"way, route"},{"g":"twenty"},null,null,null],"phrases":[[3,5,"per day"]]},{"text":"La casa está a dos millas.","en":"The house is two miles off.","words":[{"g":"the / her"},{"g":"house"},{"g":"to be","l":"estar"},{"g":"to"},{"g":"dung, excrement"},null]},{"text":"Caminé alrededor de una milla.","en":"I walked about a mile.","audio":"https://tatoeba.org/en/audio/download/454085","words":[{"g":"to walk","l":"caminar"},null,null,{"g":"a"},null],"phrases":[[1,3,"around, approximately"]]}]}