{"id":"lobo","lemma":"lobo","pos":"noun","rank":1571,"glosses":["wolf (wild Canis lupus)"],"ipa":"/ˈlobo/","gender":"m","forms":{"plural":"lobos","feminine":"loba","femininePlural":"lobas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6f/LL-Q1321_%28spa%29-Millars-lobo.wav","formAudio":{"loba":"https://upload.wikimedia.org/wikipedia/commons/3/3d/LL-Q1321_%28spa%29-AdrianAbdulBaha-loba.wav"},"examples":[{"text":"¿Acaso es un lobo?","en":"Is it a wolf?","audio":"https://tatoeba.org/en/audio/download/438137"},{"text":"Hay lobos ahí afuera.","en":"There are wolves out there.","audio":"https://tatoeba.org/en/audio/download/831285"},{"text":"Tú no puedes domesticar un lobo.","en":"You can't tame a wolf.","audio":"https://tatoeba.org/en/audio/download/803873"},{"text":"¿Hay lobos por aquí todavía?","en":"Are there still wolves around here?","audio":"https://tatoeba.org/en/audio/download/412413"},{"text":"Un lobo no puede ser domesticado.","en":"A wolf cannot be tamed.","audio":"https://tatoeba.org/en/audio/download/1195619"}]}