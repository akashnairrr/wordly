{"id":"ojala_","lemma":"ojalá","pos":"adv","rank":842,"glosses":["I wish","I hope"],"ipa":"/oxaˈla/","order":977,"audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-ojal%C3%A1.wav","examples":[{"text":"Ojalá pudiera estar contigo.","en":"I wish I could be with you.","audio":"https://tatoeba.org/en/audio/download/919981","words":[null,{"g":"to be able to, can","l":"poder"},{"g":"to be"},{"g":"with you"}]},{"text":"Ojalá la hubiera visto.","en":"I wish I had seen her.","audio":"https://tatoeba.org/en/audio/download/39618","words":[null,{"g":"the / her"},{"g":"to have","l":"haber"},{"g":"seen"}]},{"text":"Ojalá tengas suerte.","en":"I hope you're lucky.","audio":"https://tatoeba.org/en/audio/download/450197","words":[null,{"g":"to have","l":"tener"},{"g":"luck, fortune"}]}]}