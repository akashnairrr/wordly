{"id":"ojala_","lemma":"ojalá","pos":"adv","rank":844,"glosses":["I wish","I hope"],"ipa":"/oxaˈla/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-ojal%C3%A1.wav","examples":[{"text":"Ojalá te vaya bien.","en":"I hope you do fine.","audio":"https://tatoeba.org/en/audio/download/450194"},{"text":"Ojalá tuviera un coche.","en":"I wish I had a car.","audio":"https://tatoeba.org/en/audio/download/70216"},{"text":"Ojalá la hubiera conocido.","en":"I wish I'd met her.","audio":"https://tatoeba.org/en/audio/download/69825"},{"text":"Ojalá él estuviera aquí.","en":"I wish he were here.","audio":"https://tatoeba.org/en/audio/download/38884"},{"text":"Ojalá tuviéramos un auto.","en":"I wish we had a car.","audio":"https://tatoeba.org/en/audio/download/449767"}]}