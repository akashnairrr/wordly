{"id":"ojala_","lemma":"ojalá","pos":"adv","rank":841,"glosses":["I wish","I hope"],"ipa":"/oxaˈla/","audio":"https://upload.wikimedia.org/wikipedia/commons/8/83/LL-Q1321_%28spa%29-Marreromarco-ojal%C3%A1.wav","examples":[{"text":"¡Ojalá hubiese seguido tu consejo!","en":"If I'd only taken your advice!","audio":"https://tatoeba.org/en/audio/download/703014","words":[null,{"g":"to have","l":"haber"},{"g":"often"},{"g":"your"},{"g":"advice"}]},{"text":"¡Ojalá lo supiera!","en":"If only I knew!","audio":"https://tatoeba.org/en/audio/download/511987","words":[null,{"g":"it / him"},{"g":"to know, to understand","l":"saber"}]},{"text":"Ojalá te vaya bien.","en":"I hope you do fine.","audio":"https://tatoeba.org/en/audio/download/450194","words":[null,{"g":"you"},{"g":"what a ..."},{"g":"well"}]},{"text":"Ojalá me hubiera encontrado con ella.","en":"I wish I'd met her.","audio":"https://tatoeba.org/en/audio/download/69826","words":[null,{"g":"me"},{"g":"to have","l":"haber"},{"g":"found"},{"g":"with"},{"g":"she"}]},{"text":"Ojalá yo fuera más joven.","en":"I wish I were younger.","audio":"https://tatoeba.org/en/audio/download/453158","words":[null,{"g":"I"},{"g":"outside, out"},{"g":"more"},{"g":"young, youthful"}]}]}