{"id":"sentimiento","lemma":"sentimiento","pos":"noun","rank":935,"glosses":["feeling"],"ipa":"/sentiˈmjento/","gender":"m","forms":{"plural":"sentimientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-Marreromarco-sentimiento.wav","examples":[{"text":"Tengo sentimientos por ti.","en":"I have feelings for you.","audio":"https://tatoeba.org/en/audio/download/459097","words":[{"g":"to have","l":"tener"},null,{"g":"for / by"},{"g":"you","l":"tú"}]},{"text":"Es difícil hablar de tus sentimientos.","en":"It's hard to talk about your feelings.","audio":"https://tatoeba.org/en/audio/download/582477","words":[{"g":"to be","l":"ser"},{"g":"difficult"},{"g":"to talk"},{"g":"of / from"},{"g":"your"},null]},{"text":"El sentimiento es mutuo.","en":"The feeling is mutual.","audio":"https://tatoeba.org/en/audio/download/461542","words":[{"g":"the"},null,{"g":"to be","l":"ser"},{"g":"mutual"}]},{"text":"Siento que entiendo tus sentimientos.","en":"I feel that I understand your feelings.","words":[{"g":"to seat","l":"sentar"},{"g":"that"},{"g":"to understand","l":"entender"},{"g":"your"},null]},{"text":"Puede que haya herido sus sentimientos.","en":"I may have hurt his feelings.","audio":"https://tatoeba.org/en/audio/download/333128","words":[null,null,{"g":"beech, beech tree"},{"g":"hurt, injured"},{"g":"his, her, its, their"},null],"phrases":[[0,2,"it may be that"]]}]}