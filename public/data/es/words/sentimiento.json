{"id":"sentimiento","lemma":"sentimiento","pos":"noun","rank":938,"glosses":["feeling"],"ipa":"/sentiˈmjento/","gender":"m","forms":{"plural":"sentimientos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-Marreromarco-sentimiento.wav","examples":[{"text":"El sentimiento es mutuo.","en":"The feeling is mutual.","audio":"https://tatoeba.org/en/audio/download/461542"},{"text":"Tengo sentimientos por ti.","en":"I have feelings for you.","audio":"https://tatoeba.org/en/audio/download/459097"},{"text":"Te acompaño en el sentimiento.","en":"You have my sympathy.","audio":"https://tatoeba.org/en/audio/download/453776"},{"text":"No enseñes tus sentimientos.","en":"Don't let your feelings show.","audio":"https://tatoeba.org/en/audio/download/64377"},{"text":"Tom dijo que apreciaba el sentimiento.","en":"Tom said he appreciated that.","audio":"https://tatoeba.org/en/audio/download/801336"}]}