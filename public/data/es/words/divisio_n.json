{"id":"divisio_n","lemma":"división","pos":"noun","rank":1949,"glosses":["division, divide","split, splitting, cleavage","branch, division (section of an institution or organization)"],"ipa":"/dibiˈsjon/","gender":"f","forms":{"plural":"divisiones"},"order":1983,"audio":"https://upload.wikimedia.org/wikipedia/commons/1/1d/LL-Q1321_%28spa%29-Marreromarco-divisi%C3%B3n.wav","examples":[{"text":"Hay una gran división en el partido.","en":"There's a serious split in the party.","words":[{"g":"to have","l":"haber"},{"g":"a"},null,null,{"g":"in / on"},{"g":"the"},{"g":"party"}]},{"text":"Se han rendido dos divisiones.","en":"Two divisions have surrendered.","words":[{"g":"oneself"},{"g":"to have","l":"haber"},{"g":"to conquer","l":"rendir"},{"g":"dung, excrement"},null]},{"text":"Un comandante tuvo que tomar el mando de la división.","en":"A major had to take command of the division.","words":[{"g":"a"},{"g":"commander"},{"g":"to have","l":"tener"},{"g":"that"},{"g":"to take"},{"g":"the"},{"g":"command"},null,null,null],"phrases":[[7,9,"of the"]]}]}