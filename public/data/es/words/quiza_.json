{"id":"quiza_","lemma":"quizá","pos":"adv","rank":223,"glosses":["perhaps, maybe"],"ipa":"/kiˈθa/","audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-Marreromarco-quiz%C3%A1.wav","examples":[{"text":"Quizá Tom está muerto.","en":"Maybe Tom is dead.","audio":"https://tatoeba.org/en/audio/download/799315"},{"text":"Quizá no fuera Tom.","en":"Maybe it wasn't Tom.","audio":"https://tatoeba.org/en/audio/download/251586"},{"text":"Quizá me merezco esto.","en":"Maybe I deserve this.","audio":"https://tatoeba.org/en/audio/download/501669"},{"text":"Quizá solo esté loco.","en":"Maybe I'm just crazy.","audio":"https://tatoeba.org/en/audio/download/800992"},{"text":"Quizá no sea joven.","en":"Maybe he's not young.","audio":"https://tatoeba.org/en/audio/download/137832"}]}