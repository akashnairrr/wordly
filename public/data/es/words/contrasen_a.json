{"id":"contrasen_a","lemma":"contraseña","pos":"noun","rank":3162,"glosses":["password","countersign, shibboleth (response to a sign or signal)"],"ipa":"/kontɾaˈseɲa/","gender":"f","forms":{"plural":"contraseñas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-AdrianAbdulBaha-contrase%C3%B1a.wav","examples":[{"text":"¿Cuál es la contraseña?","en":"What's the password?","audio":"https://tatoeba.org/en/audio/download/821224","words":[{"g":"which one, what, which"},{"g":"to be","l":"ser"},{"g":"the / her"},null]},{"text":"Olvidé mi contraseña.","en":"I've forgotten my password.","audio":"https://tatoeba.org/en/audio/download/857793","words":[{"g":"to forget","l":"olvidar"},{"g":"my"},null]},{"text":"Él sabe cómo cambiar su contraseña.","en":"He knows how to change his password.","words":[{"g":"he"},{"g":"to know, to understand","l":"saber"},{"g":"how"},{"g":"to change"},{"g":"his / her / your"},null]},{"text":"No me sé la contraseña.","en":"I don't know the password.","audio":"https://tatoeba.org/en/audio/download/522448","words":[{"g":"no / not"},{"g":"me"},{"g":"to know, to understand","l":"saber"},{"g":"the / her"},null]},{"text":"Puedes entrar solamente si conoces nuestra contraseña.","en":"You can come in if and only if you know our password.","audio":"https://tatoeba.org/en/audio/download/703919","words":[{"g":"to be able to, can","l":"poder"},{"g":"to enter"},{"g":"only, alone, merely"},{"g":"if, whether"},{"g":"to know","l":"conocer"},{"g":"our, ours, to us","l":"nuestro"},null]}]}