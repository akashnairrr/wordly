{"id":"atascado","lemma":"atascado","pos":"adj","rank":3435,"glosses":["blocked, stuck, jammed","pig-headed"],"ipa":"/atasˈkado/","forms":{"feminine":"atascada","masculinePlural":"atascados","femininePlural":"atascadas"},"order":3438,"examples":[{"text":"La puerta está atascada.","en":"The door's stuck.","audio":"https://tatoeba.org/en/audio/download/768335","words":[{"g":"the / her"},{"g":"door"},{"g":"to be","l":"estar"},null]},{"text":"En mi vida había estado tanto tiempo atascado.","en":"I've never been stuck for so long in my life.","audio":"https://tatoeba.org/en/audio/download/300983","words":[{"g":"in / on"},null,null,{"g":"makes pluperfect to…"},{"g":"country, land"},{"g":"copy"},{"g":"time"},null],"phrases":[[1,3,"my honey, my love"]]},{"text":"Estamos atascados.","en":"We're stuck.","words":[{"g":"to be","l":"estar"},null]}]}