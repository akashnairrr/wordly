{"id":"elegido","lemma":"elegido","pos":"noun","rank":1597,"glosses":["chosenness, selectness"],"ipa":"/eleˈxido/","gender":"m","forms":{"plural":"elegidos","feminine":"elegida","femininePlural":"elegidas"},"examples":[{"text":"Usted no fue elegido.","en":"You weren't elected.","audio":"https://tatoeba.org/en/audio/download/454833"},{"text":"Fueron elegidos al azar.","en":"They were chosen at random.","audio":"https://tatoeba.org/en/audio/download/585886"},{"text":"Ella consiguió hacerse elegida como alcalde.","en":"She succeeded in getting herself elected as mayor."},{"text":"Tom Jackson fue elegido alcalde.","en":"Tom Jackson was elected mayor.","audio":"https://tatoeba.org/en/audio/download/803619"},{"text":"Hemos sido elegidos.","en":"We've been chosen.","audio":"https://tatoeba.org/en/audio/download/1253401"}]}