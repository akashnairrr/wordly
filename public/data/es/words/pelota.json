{"id":"pelota","lemma":"pelota","pos":"noun","rank":1496,"glosses":["ball (a round or ellipsoidal object)","ball game","testicle"],"ipa":"/peˈlota/","gender":"f","forms":{"plural":"pelotas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/d5/LL-Q1321_%28spa%29-Marreromarco-pelota.wav","examples":[{"text":"La pelota está inflada.","en":"The balloon is filled with air.","audio":"https://tatoeba.org/en/audio/download/1195623"},{"text":"Ella está en pelotas.","en":"She's as naked as a jaybird.","audio":"https://tatoeba.org/en/audio/download/642217"},{"text":"Lanza la pelota hacia Tom.","en":"Toss the ball to Tom.","audio":"https://tatoeba.org/en/audio/download/804267"},{"text":"No me rompas las pelotas.","en":"Don't bother me.","audio":"https://tatoeba.org/en/audio/download/799985"},{"text":"La pelota golpeó la cerca.","en":"The ball hit the fence.","audio":"https://tatoeba.org/en/audio/download/460970"}]}