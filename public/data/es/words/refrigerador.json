{"id":"refrigerador","lemma":"refrigerador","pos":"adj","rank":3564,"glosses":["cooling, refrigerating, refrigerated"],"ipa":"/refɾixeɾaˈdoɾ/","forms":{"feminine":"refrigeradora","masculinePlural":"refrigeradores","femininePlural":"refrigeradoras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/00/LL-Q1321_%28spa%29-Marreromarco-refrigerador.wav","examples":[{"text":"La puerta del refrigerador estaba abierta.","en":"The refrigerator door was open.","audio":"https://tatoeba.org/en/audio/download/582565","words":[{"g":"the / her"},{"g":"door"},{"g":"of the"},null,{"g":"to be","l":"estar"},{"g":"the act of opening"}]},{"text":"La leche está en el refrigerador.","en":"The milk is in the fridge.","words":[null,null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"amazing, very good"]]},{"text":"Nuestro refrigerador no funciona.","en":"Our refrigerator isn't working.","words":[{"g":"our, ours, to us"},null,{"g":"no / not"},{"g":"to work, to function","l":"funcionar"}]},{"text":"Yo nunca he visto un refrigerador rojo.","en":"I have never seen a red refrigerator.","audio":"https://tatoeba.org/en/audio/download/599156","words":[{"g":"I"},{"g":"never"},{"g":"to have","l":"haber"},{"g":"seen"},{"g":"a"},null,{"g":"red"}]},{"text":"No queda carne en el refrigerador.","en":"There is no meat left in the fridge.","words":[{"g":"no / not"},{"g":"curfew"},{"g":"flesh"},{"g":"in / on"},{"g":"the"},null]}]}