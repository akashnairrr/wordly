{"id":"voz","lemma":"voz","pos":"noun","rank":491,"glosses":["voice","term; word"],"ipa":"/ˈboθ/","gender":"f","forms":{"plural":"voces"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/bd/LL-Q1321_%28spa%29-AdrianAbdulBaha-voz.wav","formAudio":{"voces":"https://upload.wikimedia.org/wikipedia/commons/c/c0/LL-Q1321_%28spa%29-Marreromarco-voces.wav"},"examples":[{"text":"Habla en voz baja.","en":"Speak softly.","audio":"https://tatoeba.org/en/audio/download/438906"},{"text":"Al teléfono, sus voces suenan parecidas.","en":"Their voices sound similar over the phone."},{"text":"Tom perdió la voz.","en":"Tom lost his voice.","audio":"https://tatoeba.org/en/audio/download/798888"},{"text":"Sus voces suenan parecidas por el teléfono.","en":"Their voices sound similar over the phone."},{"text":"Ella alzó la voz.","en":"She raised her voice.","audio":"https://tatoeba.org/en/audio/download/44371"}]}