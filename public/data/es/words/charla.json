{"id":"charla","lemma":"charla","pos":"noun","rank":1513,"glosses":["talk, chat"],"ipa":"/ˈt͡ʃaɾla/","gender":"f","forms":{"plural":"charlas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/57/LL-Q1321_%28spa%29-Marreromarco-charla.wav","examples":[{"text":"Hemos tenido una charla.","en":"We just had a talk.","audio":"https://tatoeba.org/en/audio/download/501507"},{"text":"Di una breve charla.","en":"I gave a short talk.","audio":"https://tatoeba.org/en/audio/download/333803"},{"text":"Charla con tus amigos.","en":"Chat with your friends.","audio":"https://tatoeba.org/en/audio/download/300612"},{"text":"Prefiero no dar una charla.","en":"I'd rather not give a speech.","audio":"https://tatoeba.org/en/audio/download/430109"},{"text":"Tengamos una charla con Tom.","en":"Let's go have a chat with Tom.","audio":"https://tatoeba.org/en/audio/download/300605"}]}