{"id":"salvado","lemma":"salvado","pos":"noun","rank":1906,"glosses":["bran"],"ipa":"/salˈbado/","gender":"m","forms":{"plural":"salvados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2a/LL-Q1321_%28spa%29-Marreromarco-salvado.wav","examples":[{"text":"Nos habéis salvado a todas.","en":"You saved us all.","audio":"https://tatoeba.org/en/audio/download/126138"},{"text":"Te he salvado la vida.","en":"I saved your life.","audio":"https://tatoeba.org/en/audio/download/91722"},{"text":"Me ha salvado la vida.","en":"You saved my life.","audio":"https://tatoeba.org/en/audio/download/450647"},{"text":"Alguien ha salvado mi vida.","en":"Someone saved my life.","audio":"https://tatoeba.org/en/audio/download/64185"},{"text":"Nos hemos salvado de milagro.","en":"We dodged a bullet on that one.","audio":"https://tatoeba.org/en/audio/download/722540"}]}