{"id":"salvado","lemma":"salvado","pos":"noun","rank":1903,"glosses":["bran"],"ipa":"/salˈbado/","gender":"m","forms":{"plural":"salvados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/2a/LL-Q1321_%28spa%29-Marreromarco-salvado.wav","examples":[{"text":"Nos habéis salvado a todas.","en":"You saved us all.","audio":"https://tatoeba.org/en/audio/download/126138","words":[{"g":"us"},{"g":"to have","l":"haber"},null,{"g":"to"},{"g":"all","l":"todo"}]},{"text":"Te he salvado la vida.","en":"I saved your life.","audio":"https://tatoeba.org/en/audio/download/91722","words":[{"g":"you"},{"g":"to have","l":"haber"},null,null,null],"phrases":[[3,5,"the game"]]},{"text":"Alguien ha salvado mi vida.","en":"Someone saved my life.","audio":"https://tatoeba.org/en/audio/download/64185","words":[{"g":"someone, somebody"},{"g":"to have","l":"haber"},null,null,null],"phrases":[[3,5,"my honey, my love"]]},{"text":"No pienses que me has salvado la vida.","en":"Don't think you saved my life.","audio":"https://tatoeba.org/en/audio/download/1156092","words":[{"g":"no / not"},{"g":"to think, ponder","l":"pensar"},{"g":"that"},{"g":"me"},{"g":"to have","l":"haber"},null,null,null],"phrases":[[6,8,"the game"]]},{"text":"Nos hemos salvado de milagro.","en":"We dodged a bullet on that one.","audio":"https://tatoeba.org/en/audio/download/722540","words":[{"g":"us"},{"g":"heme","l":"hemo"},null,null,null],"phrases":[[3,5,"miraculously"]]}]}