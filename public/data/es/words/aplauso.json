{"id":"aplauso","lemma":"aplauso","pos":"noun","rank":3378,"glosses":["applause (act of applauding)"],"ipa":"/aˈplauso/","gender":"m","forms":{"plural":"aplausos"},"order":3381,"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q1321_%28spa%29-Marreromarco-aplauso.wav","examples":[{"text":"Por favor, contengan su aplauso.","en":"Please hold your applause.","audio":"https://tatoeba.org/en/audio/download/915721","words":[null,null,{"g":"to contain","l":"contener"},{"g":"his / her / your"},null],"phrases":[[0,2,"please"]]},{"text":"Él recibió ovaciones y aplausos.","en":"He received cheers and applause.","words":[{"g":"he"},{"g":"to receive, get","l":"recibir"},null,{"g":"and"},null]},{"text":"Los aplausos eran ensordecedores.","en":"The cheers were deafening.","words":[{"g":"the / them"},null,{"g":"to be","l":"ser"},null]}]}