{"id":"mudo","lemma":"mudo","pos":"adj","rank":3862,"glosses":["mute, dumb (not having the power of speech)","silent, speechless (not speaking)","being a water sign"],"ipa":"/ˈmudo/","forms":{"feminine":"muda","masculinePlural":"mudos","femininePlural":"mudas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/30/LL-Q1321_%28spa%29-AdrianAbdulBaha-mudo.wav","formAudio":{"muda":"https://upload.wikimedia.org/wikipedia/commons/7/7d/LL-Q1321_%28spa%29-Marreromarco-muda.wav"},"examples":[{"text":"Él permaneció mudo.","en":"He remained dumb.","audio":"https://tatoeba.org/en/audio/download/800027","words":[{"g":"he"},{"g":"to stay, remain, stand","l":"permanecer"},null]},{"text":"Me mudo el mes que viene.","en":"I'm moving next month.","audio":"https://tatoeba.org/en/audio/download/568216","words":[{"g":"me"},null,{"g":"the"},{"g":"month"},{"g":"that"},{"g":"to come","l":"venir"}]},{"text":"Me carga ver cine mudo.","en":"I hate silent movies.","audio":"https://tatoeba.org/en/audio/download/454439","words":[{"g":"me"},{"g":"load"},{"g":"to see, to spot"},{"g":"cinema, moviehouse"},null]},{"text":"Nos quedamos mudos con estupor.","en":"We were struck dumb with astonishment.","words":[{"g":"us"},{"g":"to be , to end up","l":"quedar"},null,{"g":"with"},null]},{"text":"Al hablar, todos se quedaron mudos.","en":"When he spoke, everyone became silent.","words":[{"g":"to the"},{"g":"to talk"},{"g":"all","l":"todo"},{"g":"oneself"},{"g":"to be , to end up","l":"quedar"},null]}]}