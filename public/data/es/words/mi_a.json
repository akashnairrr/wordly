{"id":"mi_a","lemma":"mía","pos":"noun","rank":423,"glosses":["a regiment of 100 soldiers in the Spanish protectorate of Morocco."],"ipa":"/ˈmia/","gender":"f","forms":{"plural":"mías"},"audio":"https://upload.wikimedia.org/wikipedia/commons/d/db/LL-Q1321_%28spa%29-AdrianAbdulBaha-m%C3%ADa.wav","examples":[{"text":"Es de parte mía.","en":"It's on me.","audio":"https://tatoeba.org/en/audio/download/438377"},{"text":"Las mías son peores.","en":"Mine are worse.","audio":"https://tatoeba.org/en/audio/download/872418"},{"text":"Yo quiero la mía.","en":"I want mine.","audio":"https://tatoeba.org/en/audio/download/412307"},{"text":"Éstas son las mías.","en":"These are mine.","audio":"https://tatoeba.org/en/audio/download/412318"},{"text":"La culpa es mía.","en":"I'm to blame.","audio":"https://tatoeba.org/en/audio/download/221741"}]}