{"id":"curioso","lemma":"curioso","pos":"adj","rank":1768,"glosses":["curious, inquisitive (person)","interesting","funny, strange, odd"],"ipa":"/kuˈɾjoso/","forms":{"feminine":"curiosa","masculinePlural":"curiosos","femininePlural":"curiosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q1321_%28spa%29-Marreromarco-curioso.wav","examples":[{"text":"Soy tan curioso como tú.","en":"I'm just as curious as you.","audio":"https://tatoeba.org/en/audio/download/578447","words":[{"g":"to be","l":"ser"},{"g":"so, as"},null,{"g":"as"},{"g":"you"}]},{"text":"Ella es curiosa por naturaleza.","en":"She's inquisitive by nature.","audio":"https://tatoeba.org/en/audio/download/641928","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"for / by"},{"g":"nature"}]},{"text":"Los niños pequeños son muy curiosos.","en":"Small children are very curious.","audio":"https://tatoeba.org/en/audio/download/687654","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"small","l":"pequeño"},{"g":"to be","l":"ser"},null,null]},{"text":"¡Qué curioso!","en":"How curious!","audio":"https://tatoeba.org/en/audio/download/59216","words":[{"g":"what"},null]},{"text":"Los niños son muy curiosos y hacen muchas preguntas.","en":"Children are very curious and ask many questions.","audio":"https://tatoeba.org/en/audio/download/1187633","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"to be","l":"ser"},null,null,{"g":"and"},{"g":"to do","l":"hacer"},{"g":"much","l":"mucho"},{"g":"question","l":"pregunta"}]}]}