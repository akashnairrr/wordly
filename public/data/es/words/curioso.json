{"id":"curioso","lemma":"curioso","pos":"adj","rank":1768,"glosses":["curious, inquisitive (person)","interesting","funny, strange, odd"],"ipa":"/kuˈɾjoso/","forms":{"feminine":"curiosa","masculinePlural":"curiosos","femininePlural":"curiosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q1321_%28spa%29-Marreromarco-curioso.wav","examples":[{"text":"Ella es curiosa por naturaleza.","en":"She's inquisitive by nature.","audio":"https://tatoeba.org/en/audio/download/641928","words":[{"g":"she"},{"g":"to be","l":"ser"},null,{"g":"for / by"},{"g":"nature"}]},{"text":"Soy muy curioso.","en":"I'm very curious.","audio":"https://tatoeba.org/en/audio/download/1195644","words":[{"g":"to be","l":"ser"},null,null]},{"text":"Los niños pequeños son muy curiosos.","en":"Small children are very curious.","audio":"https://tatoeba.org/en/audio/download/687654","words":[{"g":"the / them"},{"g":"child, boy","l":"niño"},{"g":"small","l":"pequeño"},{"g":"to be","l":"ser"},null,null]},{"text":"Soy tan curioso como tú.","en":"I'm just as curious as you.","audio":"https://tatoeba.org/en/audio/download/578447","words":[{"g":"to be","l":"ser"},{"g":"so, as"},null,{"g":"as"},{"g":"you"}]},{"text":"Él era demasiado curioso.","en":"He was too curious.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"too much"},null]}]}