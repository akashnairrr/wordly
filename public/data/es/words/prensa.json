{"id":"prensa","lemma":"prensa","pos":"noun","rank":1007,"glosses":["press (print-based media)","press (machine)","press (exercise)"],"ipa":"/ˈpɾensa/","gender":"f","forms":{"plural":"prensas"},"order":1119,"audio":"https://upload.wikimedia.org/wikipedia/commons/1/11/LL-Q1321_%28spa%29-Marreromarco-prensa.wav","examples":[{"text":"La prensa bombardeó al ministro con preguntas.","en":"The press besieged the minister with questions.","words":[{"g":"the / her"},null,null,{"g":"to the"},{"g":"minister"},{"g":"with"},{"g":"question","l":"pregunta"}]},{"text":"La prensa confirmó los rumores.","en":"The press confirmed the rumors.","words":[{"g":"the / her"},null,{"g":"to confirm","l":"confirmar"},{"g":"the / them"},{"g":"rumor","l":"rumor"}]},{"text":"El presidente dará una conferencia de prensa hoy más tarde.","en":"The president will hold a press conference later today.","words":[{"g":"the"},null,{"g":"to give, to give out","l":"dar"},{"g":"a"},{"g":"conference"},{"g":"of / from"},null,{"g":"today, tonight"},null,null],"phrases":[[8,10,"later"]]}]}