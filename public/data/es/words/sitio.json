{"id":"sitio","lemma":"sitio","pos":"noun","rank":382,"glosses":["site, place","taxi stand","ranch"],"ipa":"/ˈsitjo/","gender":"m","forms":{"plural":"sitios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/f1/LL-Q1321_%28spa%29-AdrianAbdulBaha-sitio.wav","examples":[{"text":"Este es mi sitio.","en":"This is my spot.","audio":"https://tatoeba.org/en/audio/download/799444"},{"text":"Había dos sitios libres.","en":"Two seats were vacant.","audio":"https://tatoeba.org/en/audio/download/460766"},{"text":"¿Dónde está mi sitio?","en":"Where is my seat?","audio":"https://tatoeba.org/en/audio/download/40470"},{"text":"No he estado en ninguno de esos sitios.","en":"I've been to neither of those places.","audio":"https://tatoeba.org/en/audio/download/609602"},{"text":"Este sitio es nuestro.","en":"This place is ours.","audio":"https://tatoeba.org/en/audio/download/501449"}]}