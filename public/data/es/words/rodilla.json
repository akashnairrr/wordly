{"id":"rodilla","lemma":"rodilla","pos":"noun","rank":1651,"glosses":["knee (joint or region of the joint in the middle part of the leg between the thigh and the shank)"],"ipa":"/roˈdiʝa/","gender":"f","forms":{"plural":"rodillas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-Rodelar-rodilla.wav","examples":[{"text":"Ponte de rodillas.","en":"Get on your knees.","audio":"https://tatoeba.org/en/audio/download/609247","words":[{"g":"to put, to place","l":"poner"},{"g":"of / from"},null]},{"text":"Tom se golpeó su rodilla.","en":"Tom banged his knee.","audio":"https://tatoeba.org/en/audio/download/799973","words":[null,{"g":"oneself"},{"g":"to hit","l":"golpear"},{"g":"his / her / your"},null]},{"text":"Al caer se hizo daño en la rodilla.","en":"He hurt his knee when he fell.","audio":"https://tatoeba.org/en/audio/download/333616","words":[{"g":"to the"},{"g":"to fall"},{"g":"oneself"},{"g":"to do","l":"hacer"},{"g":"damage"},{"g":"in / on"},{"g":"the / her"},null]},{"text":"¿No te vas a sentar en mis rodillas?","en":"Won't you sit on my knee?","audio":"https://tatoeba.org/en/audio/download/639186","words":[{"g":"no / not"},{"g":"you"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to seat"},{"g":"in / on"},{"g":"my"},null]},{"text":"Me di un golpe en la rodilla.","en":"I bumped my knee.","words":[{"g":"me"},{"g":"Used as a friendly…"},{"g":"a"},{"g":"hit, blow, strike"},{"g":"in / on"},{"g":"the / her"},null]}]}