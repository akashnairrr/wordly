{"id":"rodilla","lemma":"rodilla","pos":"noun","rank":1652,"glosses":["knee (joint or region of the joint in the middle part of the leg between the thigh and the shank)"],"ipa":"/roˈdiʝa/","gender":"f","forms":{"plural":"rodillas"},"order":1702,"audio":"https://upload.wikimedia.org/wikipedia/commons/a/a8/LL-Q1321_%28spa%29-Rodelar-rodilla.wav","examples":[{"text":"Ponte de rodillas.","en":"Get on your knees.","audio":"https://tatoeba.org/en/audio/download/609247","words":[{"g":"to put, to place","l":"poner"},{"g":"of / from"},null]},{"text":"Él se golpeó en su rodilla.","en":"He banged his knee.","words":[{"g":"he"},{"g":"oneself"},{"g":"to hit","l":"golpear"},{"g":"in / on"},{"g":"his / her / your"},null]},{"text":"¿No te vas a sentar en mis rodillas?","en":"Won't you sit on my knee?","audio":"https://tatoeba.org/en/audio/download/639186","words":[{"g":"no / not"},{"g":"you"},{"g":"to go","l":"ir"},{"g":"to"},{"g":"to seat"},{"g":"in / on"},{"g":"my"},null]}]}