{"id":"mostrador","lemma":"mostrador","pos":"noun","rank":4107,"glosses":["counter"],"ipa":"/mostɾaˈdoɾ/","gender":"m","forms":{"plural":"mostradores"},"examples":[{"text":"Por favor, pague en el mostrador.","en":"Please pay at this counter.","audio":"https://tatoeba.org/en/audio/download/804362","words":[null,null,{"g":"to pay","l":"pagar"},{"g":"in / on"},{"g":"the"},null],"phrases":[[0,2,"please"]]},{"text":"Tom se apoyó sobre el mostrador.","en":"Tom leaned on the counter.","audio":"https://tatoeba.org/en/audio/download/803498","words":[null,{"g":"oneself"},{"g":"to lean","l":"apoyar"},{"g":"envelope"},{"g":"the"},null]},{"text":"Tom se sentó en un taburete en el mostrador.","en":"Tom sat on a stool at the counter.","audio":"https://tatoeba.org/en/audio/download/804296","words":[null,{"g":"oneself"},{"g":"to seat","l":"sentar"},{"g":"in / on"},{"g":"a"},{"g":"stool, barstool"},{"g":"in / on"},{"g":"the"},null]},{"text":"Recoja su boleto en el mostrador, por favor.","en":"Please pick up your ticket at the counter.","words":[{"g":"to collect","l":"recoger"},{"g":"his / her / your"},{"g":"ticket"},{"g":"in / on"},{"g":"the"},null,null,null],"phrases":[[6,8,"please"]]},{"text":"Tom saltó sobre el mostrador para robar dinero de la caja registradora.","en":"Tom jumped over the counter to steal money from the cash register.","words":[null,{"g":"to jump","l":"saltar"},{"g":"envelope"},{"g":"the"},null,{"g":"for"},{"g":"to rob"},{"g":"money"},null,null,null,null],"phrases":[[8,10,"of the"],[10,12,"cash register"]]}]}