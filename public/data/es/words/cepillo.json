{"id":"cepillo","lemma":"cepillo","pos":"noun","rank":3611,"glosses":["brush","plane (tool for smoothing wood; for carpentry)","poor box"],"ipa":"/θeˈpiʝo/","gender":"m","forms":{"plural":"cepillos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/f/fd/LL-Q1321_%28spa%29-AdrianAbdulBaha-cepillo.wav","examples":[{"text":"¿Dónde puedo comprar un cepillo?","en":"Where can I buy a brush?","audio":"https://tatoeba.org/en/audio/download/515929","words":[{"g":"where"},{"g":"to be able to, can","l":"poder"},{"g":"to buy"},{"g":"a"},null]},{"text":"Este cepillo de dientes es demasiado suave.","en":"This toothbrush is too soft.","audio":"https://tatoeba.org/en/audio/download/873675","words":[{"g":"this"},null,{"g":"of / from"},{"g":"tooth","l":"diente"},{"g":"to be","l":"ser"},{"g":"too much"},{"g":"smooth, soft, fluffy"}]},{"text":"Me cepillo los dientes después de comer.","en":"I brush my teeth after eating.","audio":"https://tatoeba.org/en/audio/download/609752","words":[{"g":"me"},null,{"g":"the / them"},{"g":"tooth","l":"diente"},null,null,{"g":"to eat"}],"phrases":[[4,6,"after"]]},{"text":"Me cepillo los dientes dos veces al día.","en":"I brush my teeth twice a day.","audio":"https://tatoeba.org/en/audio/download/806816","words":[{"g":"me"},null,{"g":"the / them"},{"g":"tooth","l":"diente"},{"g":"dung, excrement"},{"g":"by, times"},null,null],"phrases":[[6,8,"per day"]]},{"text":"Este cepillo está hecho de pelo de camello.","en":"This brush is made from camel hair.","audio":"https://tatoeba.org/en/audio/download/687725","words":[{"g":"this"},null,{"g":"to be","l":"estar"},{"g":"done, completed"},{"g":"of / from"},{"g":"hair"},{"g":"of / from"},{"g":"camel"}]}]}