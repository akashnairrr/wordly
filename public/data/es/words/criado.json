{"id":"criado","lemma":"criado","pos":"noun","rank":3176,"glosses":["servant"],"ipa":"/ˈkɾjado/","gender":"m","forms":{"plural":"criados","feminine":"criada","femininePlural":"criadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/7/74/LL-Q1321_%28spa%29-Marreromarco-criado.wav","examples":[{"text":"Fui criado por mi abuela.","en":"I was brought up by my grandmother.","audio":"https://tatoeba.org/en/audio/download/551933","words":[{"g":"to go","l":"ir"},null,{"g":"for / by"},{"g":"my"},{"g":"grandmother"}]},{"text":"No tiene criado ninguno.","en":"He has no servants at all.","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"nobody"}]},{"text":"Él fue criado en una familia artística.","en":"He was raised in an artistic family.","words":[{"g":"he"},{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"a"},{"g":"family"},{"g":"artistic","l":"artístico"}]},{"text":"Fue criada por su abuelo.","en":"She was brought up by her grandfather.","audio":"https://tatoeba.org/en/audio/download/689249","words":[{"g":"to be","l":"ser"},null,{"g":"for / by"},{"g":"his / her / your"},{"g":"grandfather"}]},{"text":"La criada dejó el empleo.","en":"The maid gave up her job.","words":[{"g":"the / her"},null,{"g":"to leave","l":"dejar"},{"g":"the"},{"g":"job, employment"}]}]}