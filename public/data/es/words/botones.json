{"id":"botones","lemma":"botones","pos":"noun","rank":3175,"glosses":["bellboy"],"ipa":"/boˈtones/","gender":"mf","forms":{"plural":"botones"},"audio":"https://upload.wikimedia.org/wikipedia/commons/b/b3/LL-Q1321_%28spa%29-AdrianAbdulBaha-botones.wav","examples":[{"text":"Esta chaqueta tiene botones.","en":"This jacket has buttons.","words":[{"g":"this","l":"este"},{"g":"jacket"},{"g":"to have","l":"tener"},null]},{"text":"Hay botones en el abrigo.","en":"There are buttons on the coat.","words":[{"g":"to have","l":"haber"},null,{"g":"in / on"},{"g":"the"},{"g":"overcoat"}]},{"text":"Por favor cose estos botones.","en":"Please sew these buttons on.","audio":"https://tatoeba.org/en/audio/download/804306","words":[null,null,{"g":"to sew","l":"coser"},{"g":"this","l":"este"},null],"phrases":[[0,2,"please"]]},{"text":"El botones le acompañará a su habitación.","en":"The bellboy will show you to your room.","words":[{"g":"the"},null,{"g":"him / her"},{"g":"to accompany","l":"acompañar"},{"g":"to"},{"g":"his / her / your"},{"g":"room"}]},{"text":"Uno de los botones de mi abrigo se salió.","en":"One of the buttons has come off my coat.","words":[{"g":"one"},{"g":"of / from"},{"g":"the / them"},null,{"g":"of / from"},{"g":"my"},{"g":"overcoat"},{"g":"oneself"},{"g":"to go out","l":"salir"}]}]}