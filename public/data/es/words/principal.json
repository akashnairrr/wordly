{"id":"principal","lemma":"principal","pos":"adj","rank":843,"glosses":["main, most important","essential"],"ipa":"/pɾinθiˈpal/","forms":{"femininePlural":"principales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/33/LL-Q1321_%28spa%29-AdrianAbdulBaha-principal.wav","formAudio":{"principales":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-GlyphEnjoyer-principales.wav"},"examples":[{"text":"Ese es el portón principal.","en":"That's the main gate.","audio":"https://tatoeba.org/en/audio/download/800776"},{"text":"Esta es una de las reglas principales.","en":"This is one of the basic rules.","audio":"https://tatoeba.org/en/audio/download/802020"},{"text":"Éste es nuestro principal objetivo.","en":"This is our main goal.","audio":"https://tatoeba.org/en/audio/download/461038"},{"text":"¿Cuáles son las principales importaciones de Australia?","en":"What are Australia's major imports?","audio":"https://tatoeba.org/en/audio/download/302436"},{"text":"Éste es nuestro objetivo principal.","en":"This is our main objective.","audio":"https://tatoeba.org/en/audio/download/551641"}]}