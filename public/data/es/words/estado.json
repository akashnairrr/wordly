{"id":"estado","lemma":"estado","pos":"noun","rank":130,"glosses":["country, land (any broad area or territory)","state (a province, particularly a fairly autonomous one within a federation)","state, status (a condition)"],"ipa":"/esˈtado/","gender":"m","forms":{"plural":"estados"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3c/LL-Q1321_%28spa%29-Precision27-Estado.wav","formAudio":{"estados":"https://upload.wikimedia.org/wikipedia/commons/5/5f/LL-Q1321_%28spa%29-Precision27-Estados.wav"},"examples":[{"text":"¿Dónde has estado esta semana?","en":"Where have you been this week?","audio":"https://tatoeba.org/en/audio/download/616046","words":[{"g":"where"},{"g":"to have","l":"haber"},null,{"g":"this","l":"este"},{"g":"week"}]},{"text":"¿Dónde has estado todo este tiempo?","en":"Where have you been all this time?","audio":"https://tatoeba.org/en/audio/download/352512","words":[{"g":"where"},{"g":"to have","l":"haber"},null,{"g":"all"},{"g":"this"},{"g":"time"}]},{"text":"¿Dónde has estado toda la noche?","en":"Where have you been all night?","audio":"https://tatoeba.org/en/audio/download/609282","words":[{"g":"where"},{"g":"to have","l":"haber"},null,{"g":"all","l":"todo"},{"g":"the / her"},{"g":"night"}]},{"text":"Hemos estado trabajando duro en esto.","en":"We've been working hard on this.","audio":"https://tatoeba.org/en/audio/download/611766","words":[{"g":"heme","l":"hemo"},null,{"g":"to work","l":"trabajar"},{"g":"hard"},{"g":"in / on"},{"g":"this"}]},{"text":"Nadie ha estado aquí.","en":"No one's been here.","audio":"https://tatoeba.org/en/audio/download/448573","words":[{"g":"no one"},{"g":"to have","l":"haber"},null,{"g":"here"}]}]}