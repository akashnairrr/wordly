{"id":"verano","lemma":"verano","pos":"noun","rank":875,"glosses":["summer"],"ipa":"/beˈɾano/","gender":"m","forms":{"plural":"veranos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/4/4d/LL-Q1321_%28spa%29-AdrianAbdulBaha-verano.wav","examples":[{"text":"El verano se acabó.","en":"Summer has ended.","audio":"https://tatoeba.org/en/audio/download/442907"},{"text":"Todos los veranos voy al campo.","en":"I go to the country every summer."},{"text":"El verano ha terminado.","en":"Summer has ended.","audio":"https://tatoeba.org/en/audio/download/442977"},{"text":"Tom va de campamento todos los veranos.","en":"Tom goes camping every summer."},{"text":"Se acerca el verano.","en":"Summer is coming.","audio":"https://tatoeba.org/en/audio/download/636798"}]}