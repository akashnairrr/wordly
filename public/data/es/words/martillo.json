{"id":"martillo","lemma":"martillo","pos":"noun","rank":2890,"glosses":["hammer (a tool with a heavy head and a handle used for pounding)","malleus","auction house"],"ipa":"/maɾˈtiʝo/","gender":"m","forms":{"plural":"martillos"},"order":2895,"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-AdrianAbdulBaha-martillo.wav","examples":[{"text":"¿Dónde está el martillo?","en":"Where's the hammer?","audio":"https://tatoeba.org/en/audio/download/483128","words":[null,null,{"g":"the"},null],"phrases":[[0,2,"where are you?"]]},{"text":"Ella le golpeó con un martillo.","en":"She hit him with a hammer.","audio":"https://tatoeba.org/en/audio/download/47531","words":[{"g":"she"},{"g":"him / her"},{"g":"to hit","l":"golpear"},{"g":"with"},{"g":"a"},null]},{"text":"No puedo hacerlo sin un martillo.","en":"I can't do it without a hammer.","audio":"https://tatoeba.org/en/audio/download/594432","words":[{"g":"no / not"},{"g":"to be able to, can","l":"poder"},{"g":"to do","l":"hacer"},{"g":"without"},{"g":"a"},null]}]}