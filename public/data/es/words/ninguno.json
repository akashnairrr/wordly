{"id":"ninguno","lemma":"ninguno","pos":"pron","rank":274,"glosses":["nobody; no one","none; neither, any"],"ipa":"/ninˈɡuno/","forms":{"feminine":"ninguna","masculinePlural":"ningunos","femininePlural":"ningunas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Marreromarco-ninguno.wav","formAudio":{"ninguna":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-GlyphEnjoyer-ninguna.wav"},"examples":[{"text":"No me gusta ninguno.","en":"I like neither of them.","audio":"https://tatoeba.org/en/audio/download/519234"},{"text":"No es ninguna broma.","en":"It is no joke.","audio":"https://tatoeba.org/en/audio/download/441837"},{"text":"No tomé ningunas medidas de precaución.","en":"I didn't take any precautions."},{"text":"Ninguno vino a ayudarme.","en":"No one came to help me.","audio":"https://tatoeba.org/en/audio/download/460146"},{"text":"No tengo ninguna duda.","en":"I have no doubts.","audio":"https://tatoeba.org/en/audio/download/41287"}]}