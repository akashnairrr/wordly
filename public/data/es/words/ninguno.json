{"id":"ninguno","lemma":"ninguno","pos":"pron","rank":271,"glosses":["nobody; no one","none; neither, any"],"ipa":"/ninˈɡuno/","forms":{"feminine":"ninguna","masculinePlural":"ningunos","femininePlural":"ningunas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Marreromarco-ninguno.wav","formAudio":{"ninguna":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-GlyphEnjoyer-ninguna.wav"},"examples":[{"text":"¡De ninguna manera!","en":"No way!","audio":"https://tatoeba.org/en/audio/download/943053","words":[{"g":"of / from"},null,{"g":"way"}]},{"text":"No me gusta ninguno de ellos.","en":"I like none of them.","audio":"https://tatoeba.org/en/audio/download/450206","words":[{"g":"no / not"},null,null,null,{"g":"of / from"},{"g":"they","l":"él"}],"phrases":[[1,3,"like, thumbs up"]]},{"text":"No nos queda ninguna bala.","en":"We're out of bullets.","audio":"https://tatoeba.org/en/audio/download/454947","words":[{"g":"no / not"},{"g":"us"},{"g":"curfew"},null,{"g":"bullet"}]},{"text":"Ninguno de nosotros es perfecto.","en":"None of us is perfect.","audio":"https://tatoeba.org/en/audio/download/460070","words":[null,{"g":"of / from"},{"g":"we"},{"g":"to be","l":"ser"},{"g":"perfect"}]},{"text":"La primera vez no me hizo ninguna gracia.","en":"At first I didn't like it.","audio":"https://tatoeba.org/en/audio/download/451074","words":[{"g":"the / her"},null,null,{"g":"no / not"},{"g":"me"},{"g":"to do","l":"hacer"},null,{"g":"grace, charm"}],"phrases":[[1,3,"first time"]]}]}