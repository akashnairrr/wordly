{"id":"ninguno","lemma":"ninguno","pos":"pron","rank":271,"glosses":["nobody; no one","none; neither, any"],"ipa":"/ninˈɡuno/","forms":{"feminine":"ninguna","masculinePlural":"ningunos","femininePlural":"ningunas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3a/LL-Q1321_%28spa%29-Marreromarco-ninguno.wav","formAudio":{"ninguna":"https://upload.wikimedia.org/wikipedia/commons/9/9f/LL-Q1321_%28spa%29-GlyphEnjoyer-ninguna.wav"},"examples":[{"text":"No tengo ninguna prueba de ello.","en":"I have no proof of that.","audio":"https://tatoeba.org/en/audio/download/459913","words":[{"g":"no / not"},{"g":"to have","l":"tener"},null,{"g":"proof"},{"g":"of / from"},{"g":"it"}]},{"text":"Ninguno quería venir.","en":"Nobody wanted to come.","audio":"https://tatoeba.org/en/audio/download/769734","words":[null,{"g":"to desire","l":"querer"},{"g":"to come"}]},{"text":"Esto no es ninguna broma.","en":"This is no joke.","audio":"https://tatoeba.org/en/audio/download/77071","words":[{"g":"this"},{"g":"no / not"},{"g":"to be","l":"ser"},null,{"g":"joke"}]},{"text":"Ninguno de mis padres está vivo.","en":"Neither of my parents are alive.","audio":"https://tatoeba.org/en/audio/download/733704","words":[null,{"g":"of / from"},{"g":"my"},{"g":"father, parent","l":"padre"},{"g":"to be","l":"estar"},{"g":"alive, living"}]},{"text":"Ninguno de mis hermanos estará allí.","en":"Neither of my brothers will be there.","audio":"https://tatoeba.org/en/audio/download/460375","words":[null,{"g":"of / from"},{"g":"my"},{"g":"brother","l":"hermano"},{"g":"to be","l":"estar"},{"g":"there"}]}]}