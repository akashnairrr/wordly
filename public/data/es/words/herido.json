{"id":"herido","lemma":"herido","pos":"adj","rank":1013,"glosses":["hurt, injured"],"ipa":"/eˈɾido/","forms":{"feminine":"herida","masculinePlural":"heridos","femininePlural":"heridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Marreromarco-herido.wav","formAudio":{"herida":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-AdrianAbdulBaha-herida.wav","heridos":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-GlyphEnjoyer-heridos.wav"},"examples":[{"text":"Ellos no me han herido.","en":"They haven't hurt me.","audio":"https://tatoeba.org/en/audio/download/454009","words":[{"g":"they","l":"él"},{"g":"no / not"},{"g":"me"},{"g":"to have","l":"haber"},null]},{"text":"Nadie salió herido.","en":"No one got hurt.","audio":"https://tatoeba.org/en/audio/download/442082","words":[{"g":"no one"},{"g":"to go out","l":"salir"},null]},{"text":"Hubo tres heridos.","en":"Three were wounded.","audio":"https://tatoeba.org/en/audio/download/501665","words":[{"g":"to have","l":"haber"},{"g":"three"},null]},{"text":"¿Has resultado herido?","en":"Have you been injured?","audio":"https://tatoeba.org/en/audio/download/454490","words":[{"g":"to have","l":"haber"},{"g":"result"},null]},{"text":"Fue herido en la guerra.","en":"He was wounded in the war.","audio":"https://tatoeba.org/en/audio/download/586842","words":[{"g":"to be","l":"ser"},null,{"g":"in / on"},{"g":"the / her"},{"g":"war, warfare"}]}]}