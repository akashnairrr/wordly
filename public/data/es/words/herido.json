{"id":"herido","lemma":"herido","pos":"adj","rank":1016,"glosses":["hurt, injured"],"ipa":"/eˈɾido/","forms":{"feminine":"herida","masculinePlural":"heridos","femininePlural":"heridas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/20/LL-Q1321_%28spa%29-Marreromarco-herido.wav","formAudio":{"herida":"https://upload.wikimedia.org/wikipedia/commons/e/e6/LL-Q1321_%28spa%29-AdrianAbdulBaha-herida.wav","heridos":"https://upload.wikimedia.org/wikipedia/commons/3/31/LL-Q1321_%28spa%29-GlyphEnjoyer-heridos.wav"},"examples":[{"text":"El niño resultó herido.","en":"The kid got hurt.","audio":"https://tatoeba.org/en/audio/download/444265"},{"text":"La herida se curó.","en":"The wound healed.","audio":"https://tatoeba.org/en/audio/download/443879"},{"text":"Tres de ellos resultaron heridos.","en":"Three were wounded.","audio":"https://tatoeba.org/en/audio/download/501666"},{"text":"Tres personas resultaron heridas.","en":"Three people were wounded.","audio":"https://tatoeba.org/en/audio/download/582564"},{"text":"Nadie ha sido herido.","en":"No one's been hurt.","audio":"https://tatoeba.org/en/audio/download/448120"}]}