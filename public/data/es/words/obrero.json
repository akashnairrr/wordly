{"id":"obrero","lemma":"obrero","pos":"adj","rank":4352,"glosses":["worker; working class"],"ipa":"/oˈbɾeɾo/","forms":{"feminine":"obrera","masculinePlural":"obreros","femininePlural":"obreras"},"audio":"https://upload.wikimedia.org/wikipedia/commons/6/6c/LL-Q1321_%28spa%29-AdrianAbdulBaha-obrero.wav","formAudio":{"obrera":"https://upload.wikimedia.org/wikipedia/commons/6/65/LL-Q1321_%28spa%29-Marreromarco-obrera.wav"},"examples":[{"text":"Muchos de los obreros murieron de hambre.","en":"Many of the workers died of hunger.","audio":"https://tatoeba.org/en/audio/download/37867","words":[{"g":"much","l":"mucho"},{"g":"of / from"},{"g":"the / them"},null,{"g":"to die","l":"morir"},{"g":"of / from"},{"g":"hunger"}]},{"text":"Los obreros no bajaron a la mina aquella noche.","en":"The workmen didn't go down into the mine that night.","words":[{"g":"the / them"},null,{"g":"no / not"},{"g":"to go down, come down","l":"bajar"},{"g":"to"},{"g":"the / her"},{"g":"mine"},{"g":"that (over there","l":"aquel"},{"g":"night"}]}]}