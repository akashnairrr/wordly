{"id":"oi_do","lemma":"oído","pos":"noun","rank":372,"glosses":["hearing","inner ear; ear (used to refer to the ear as an internal organ, or its function of hearing)"],"ipa":"/oˈido/","gender":"m","forms":{"plural":"oídos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/2/29/LL-Q1321_%28spa%29-Eavqwiki-o%C3%ADdo.wav","formAudio":{"oídos":"https://upload.wikimedia.org/wikipedia/commons/3/39/LL-Q1321_%28spa%29-Eavqwiki-o%C3%ADdos.wav"},"examples":[{"text":"¿Qué has oído?","en":"What have you heard?","audio":"https://tatoeba.org/en/audio/download/454058","words":[{"g":"what"},{"g":"to have","l":"haber"},null]},{"text":"Nunca has oído de mí, ¿verdad?","en":"You've never heard of me, have you?","audio":"https://tatoeba.org/en/audio/download/515063","words":[{"g":"never"},{"g":"to have","l":"haber"},null,{"g":"of / from"},{"g":"me"},{"g":"truth"}]},{"text":"Soy todo oídos.","en":"I'm all ears.","audio":"https://tatoeba.org/en/audio/download/636526","words":[{"g":"to be","l":"ser"},{"g":"all"},null]},{"text":"Jamás había oído tal cosa.","en":"I've never heard of such a thing.","audio":"https://tatoeba.org/en/audio/download/527437","words":[{"g":"never"},{"g":"makes pluperfect to…"},null,{"g":"such"},{"g":"thing"}]},{"text":"Lo he oído todo.","en":"I've heard it all.","audio":"https://tatoeba.org/en/audio/download/453806","words":[{"g":"it / him"},{"g":"to have","l":"haber"},null,{"g":"all"}]}]}