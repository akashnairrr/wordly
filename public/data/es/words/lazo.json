{"id":"lazo","lemma":"lazo","pos":"noun","rank":3898,"glosses":["bow (type of knot)","ribbon","lasso"],"ipa":"/ˈlaθo/","gender":"m","forms":{"plural":"lazos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-Marreromarco-lazo.wav","examples":[{"text":"¿Puede usted hacer un lazo?","en":"Can you tie a bow?","audio":"https://tatoeba.org/en/audio/download/443872","words":[{"g":"to be able to, can","l":"poder"},{"g":"you (formal)"},{"g":"to do"},{"g":"a"},null]},{"text":"Este lazo va muy bien con tu camisa.","en":"This tie goes very well with your shirt.","words":[{"g":"this"},null,{"g":"okay"},null,null,{"g":"with"},{"g":"your"},{"g":"shirt"}],"phrases":[[3,5,"very well"]]},{"text":"Un zorro cayó en el lazo.","en":"A fox was caught in the snare.","words":[{"g":"a"},{"g":"fox"},{"g":"to fall","l":"caer"},{"g":"in / on"},{"g":"the"},null]},{"text":"La chica llevaba en el pelo un lazo amarillo.","en":"The girl wore a yellow ribbon in her hair.","audio":"https://tatoeba.org/en/audio/download/691713","words":[{"g":"the / her"},{"g":"gal, chick"},{"g":"to take somewhere","l":"llevar"},{"g":"in / on"},{"g":"the"},{"g":"hair"},{"g":"a"},null,{"g":"yellow or golden"}]},{"text":"He olvidado cómo hacer el lazo de la pajarita.","en":"I've forgotten how to tie a bow tie.","audio":"https://tatoeba.org/en/audio/download/804175","words":[{"g":"to have","l":"haber"},{"g":"forgotten"},{"g":"how"},{"g":"to do"},{"g":"the"},null,null,null,{"g":"bowtie","l":"pajarito"}],"phrases":[[6,8,"of the"]]}]}