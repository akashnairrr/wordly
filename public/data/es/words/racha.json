{"id":"racha","lemma":"racha","pos":"noun","rank":4518,"glosses":["gust of wind, squall","streak (of luck, good or bad)","TikTok streak"],"ipa":"/ˈrat͡ʃa/","gender":"f","forms":{"plural":"rachas"},"order":4519,"examples":[{"text":"Tuve una racha de mala suerte.","en":"I had a run of bad luck.","audio":"https://tatoeba.org/en/audio/download/458836","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"of / from"},null,null],"phrases":[[4,6,"bad luck"]]},{"text":"Tom está en una racha de suerte.","en":"Tom is on a winning streak.","audio":"https://tatoeba.org/en/audio/download/300060","words":[null,{"g":"to be","l":"estar"},{"g":"in / on"},{"g":"a"},null,{"g":"of / from"},{"g":"luck, fortune"}]},{"text":"Esa racha de suerte no durará para siempre.","en":"This lucky streak won't last forever.","words":[{"g":"that","l":"ese"},null,{"g":"of / from"},{"g":"luck, fortune"},{"g":"no / not"},{"g":"to last","l":"durar"},null,null],"phrases":[[6,8,"forever"]]}]}