{"id":"suelta","lemma":"suelta","pos":"noun","rank":1795,"glosses":["release (act of releasing)","hopple, hobble, pastern, fetter to fix the feet of an animal"],"ipa":"/ˈswelta/","gender":"f","forms":{"plural":"sueltas"},"examples":[{"text":"Suelta mi brazo.","en":"Let go of my arm.","audio":"https://tatoeba.org/en/audio/download/442600","words":[null,{"g":"my"},{"g":"arm"}]},{"text":"Suelta la cuerda.","en":"Let go of the rope.","audio":"https://tatoeba.org/en/audio/download/450615","words":[null,{"g":"the / her"},{"g":"rope, cord, string"}]},{"text":"¡Suelta el cuchillo!","en":"Drop the knife!","audio":"https://tatoeba.org/en/audio/download/440704","words":[null,{"g":"the"},{"g":"knife"}]},{"text":"¡Suelta la pistola!","en":"Drop the gun!","words":[null,{"g":"the / her"},{"g":"pistol, handgun"}]},{"text":"Es fácil perder el equilibrio en grava suelta.","en":"It's easy to lose your footing on loose gravel.","audio":"https://tatoeba.org/en/audio/download/803892","words":[{"g":"to be","l":"ser"},{"g":"easy, facile, simple"},{"g":"to lose"},{"g":"the"},{"g":"equilibrium, balance"},{"g":"in / on"},{"g":"gravel"},null]}]}