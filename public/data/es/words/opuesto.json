{"id":"opuesto","lemma":"opuesto","pos":"adj","rank":3831,"glosses":["opposed to a thing, against","the opposite to another thing","something contrary to another"],"ipa":"/oˈpwesto/","forms":{"feminine":"opuesta","masculinePlural":"opuestos","femininePlural":"opuestas"},"order":3833,"audio":"https://upload.wikimedia.org/wikipedia/commons/9/92/LL-Q1321_%28spa%29-Emanuelps27-opuesto.wav","examples":[{"text":"Tenemos el problema opuesto.","en":"We have the opposite problem.","words":[{"g":"to have","l":"tener"},{"g":"the"},{"g":"problem"},null]},{"text":"Es justo lo opuesto.","en":"It's just the opposite.","words":[{"g":"to be","l":"ser"},{"g":"right, just"},{"g":"it / him"},null]},{"text":"Norte es la dirección opuesta al sur.","en":"North is the opposite direction from south.","words":[{"g":"north"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"direction"},null,{"g":"to the"},{"g":"south"}]}]}