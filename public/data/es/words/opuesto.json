{"id":"opuesto","lemma":"opuesto","pos":"adj","rank":3829,"glosses":["opposed to a thing, against","the opposite to another thing","something contrary to another"],"ipa":"/oˈpwesto/","forms":{"feminine":"opuesta","masculinePlural":"opuestos","femininePlural":"opuestas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/9/92/LL-Q1321_%28spa%29-Emanuelps27-opuesto.wav","examples":[{"text":"Tenemos el problema opuesto.","en":"We have the opposite problem.","words":[{"g":"to have","l":"tener"},{"g":"the"},{"g":"problem"},null]},{"text":"Es justo lo opuesto.","en":"It's just the opposite.","words":[{"g":"to be","l":"ser"},{"g":"right, just"},{"g":"it / him"},null]},{"text":"Norte es la dirección opuesta al sur.","en":"North is the opposite direction from south.","words":[{"g":"north"},{"g":"to be","l":"ser"},{"g":"the / her"},{"g":"direction"},null,{"g":"to the"},{"g":"south"}]},{"text":"Los opuestos se atraen.","en":"Opposites attract.","words":[{"g":"the / them"},null,{"g":"oneself"},{"g":"to attract, to lure","l":"atraer"}]},{"text":"Se fueron en direcciones opuestas.","en":"They went in opposite directions.","words":[{"g":"oneself"},{"g":"to go","l":"ir"},{"g":"in / on"},{"g":"direction","l":"dirección"},null]}]}