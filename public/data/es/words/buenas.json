{"id":"buenas","lemma":"buenas","pos":"intj","rank":206,"glosses":["hello, good morning, good afternoon, good evening (greeting used irrespective of the time)"],"ipa":"/ˈbwenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Emanuelps27-buenas.wav","examples":[{"text":"Tengo buenas noticias para usted.","en":"I have good news for you.","audio":"https://tatoeba.org/en/audio/download/43860","words":[{"g":"to have","l":"tener"},null,{"g":"notice","l":"noticia"},{"g":"for"},{"g":"you (formal)"}]},{"text":"Mary y yo nos hicimos buenas amigas.","en":"Mary and I became good friends.","audio":"https://tatoeba.org/en/audio/download/354963","words":[null,{"g":"and"},{"g":"I"},{"g":"us"},{"g":"to do","l":"hacer"},null,{"g":"to cause to be friends","l":"amigar"}]},{"text":"Ten unas buenas vacaciones.","en":"Have a nice holiday.","audio":"https://tatoeba.org/en/audio/download/450208","words":[{"g":"to have","l":"tener"},{"g":"an","l":"un"},null,{"g":"vacation, holiday","l":"vacación"}]},{"text":"Si no hay noticias, son buenas noticias.","en":"No news is good news.","audio":"https://tatoeba.org/en/audio/download/453027","words":[null,null,{"g":"to have","l":"haber"},{"g":"notice","l":"noticia"},{"g":"to be","l":"ser"},null,{"g":"notice","l":"noticia"}],"phrases":[[0,2,"if not"]]},{"text":"¿Tú tienes buenas notas?","en":"Did you get good marks?","words":[{"g":"you"},{"g":"to have","l":"tener"},null,{"g":"show-off"}]}]}