{"id":"buenas","lemma":"buenas","pos":"intj","rank":206,"glosses":["hello, good morning, good afternoon, good evening (greeting used irrespective of the time)"],"ipa":"/ˈbwenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Emanuelps27-buenas.wav","examples":[{"text":"Tengo buenas noticias para ti.","en":"I've got good news for you.","audio":"https://tatoeba.org/en/audio/download/515259","words":[{"g":"to have","l":"tener"},null,{"g":"notice","l":"noticia"},{"g":"for"},{"g":"you","l":"tú"}]},{"text":"Ten unas buenas vacaciones.","en":"Have a nice holiday.","audio":"https://tatoeba.org/en/audio/download/450208","words":[{"g":"to have","l":"tener"},{"g":"an","l":"un"},null,{"g":"vacation, holiday","l":"vacación"}]},{"text":"Está en buenas manos.","en":"It's in good hands.","words":[{"g":"to be","l":"estar"},{"g":"in / on"},null,{"g":"hand","l":"mano"}]},{"text":"No tener noticias son buenas noticias.","en":"No news is good news.","audio":"https://tatoeba.org/en/audio/download/455102","words":[{"g":"no / not"},{"g":"to have"},{"g":"notice","l":"noticia"},{"g":"to be","l":"ser"},null,{"g":"notice","l":"noticia"}]},{"text":"Está orgulloso de sus buenas notas.","en":"He's proud of his good grades.","audio":"https://tatoeba.org/en/audio/download/641853","words":[{"g":"to be","l":"estar"},{"g":"proud"},{"g":"of / from"},{"g":"his, her, its, their"},null,{"g":"show-off"}]}]}