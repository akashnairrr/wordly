{"id":"buenas","lemma":"buenas","pos":"intj","rank":209,"glosses":["hello, good morning, good afternoon, good evening (greeting used irrespective of the time)"],"ipa":"/ˈbwenas/","audio":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-Emanuelps27-buenas.wav","examples":[{"text":"Tengo muy buenas noticias.","en":"I have great news.","audio":"https://tatoeba.org/en/audio/download/443320"},{"text":"Ten unas buenas vacaciones.","en":"Have a nice holiday.","audio":"https://tatoeba.org/en/audio/download/450208"},{"text":"Di buenas noches, Tom.","en":"Say good night, Tom.","audio":"https://tatoeba.org/en/audio/download/799316"},{"text":"Estas manzanas están buenas.","en":"These apples taste good.","audio":"https://tatoeba.org/en/audio/download/47455"},{"text":"Da las buenas noches, Tom.","en":"Say good night, Tom.","audio":"https://tatoeba.org/en/audio/download/799317"}]}