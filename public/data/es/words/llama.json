{"id":"llama","lemma":"llama","pos":"noun","rank":301,"glosses":["flame"],"ipa":"/ˈʝama/","gender":"f","forms":{"plural":"llamas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/3/3b/LL-Q1321_%28spa%29-MiguelAlanCS-llama.wav","examples":[{"text":"Llama a la Policía.","en":"Call the cops.","audio":"https://tatoeba.org/en/audio/download/440106"},{"text":"Saben cómo te llamas.","en":"They know your name.","audio":"https://tatoeba.org/en/audio/download/162866"},{"text":"¡Llama a la policía!","en":"Call the police!","audio":"https://tatoeba.org/en/audio/download/1526"},{"text":"Perdona, ¿cómo te llamas?","en":"Sorry, what's your name?","audio":"https://tatoeba.org/en/audio/download/525325"},{"text":"Llama a tu madre.","en":"Get your mother.","audio":"https://tatoeba.org/en/audio/download/424741"}]}