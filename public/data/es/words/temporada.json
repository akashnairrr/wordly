{"id":"temporada","lemma":"temporada","pos":"noun","rank":1310,"glosses":["season, period, span of time","season, series (group of episodes of a television broadcast)"],"ipa":"/tempoˈɾada/","gender":"f","forms":{"plural":"temporadas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/15/LL-Q1321_%28spa%29-AdrianAbdulBaha-temporada.wav","examples":[{"text":"Es temporada de venados.","en":"It's deer season.","audio":"https://tatoeba.org/en/audio/download/442823"},{"text":"Ya es temporada de tifones.","en":"It's already typhoon season.","audio":"https://tatoeba.org/en/audio/download/505260"},{"text":"Me encanta esta temporada del año.","en":"I love this time of year.","audio":"https://tatoeba.org/en/audio/download/522280"},{"text":"Las fresas ya están de temporada.","en":"Strawberries are in season now.","audio":"https://tatoeba.org/en/audio/download/582403"},{"text":"La temporada de béisbol ha empezado.","en":"The baseball season has opened.","audio":"https://tatoeba.org/en/audio/download/806216"}]}