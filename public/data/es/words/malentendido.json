{"id":"malentendido","lemma":"malentendido","pos":"noun","rank":2910,"glosses":["misunderstanding"],"ipa":"/malentenˈdido/","gender":"m","forms":{"plural":"malentendidos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ee/LL-Q1321_%28spa%29-Emanuelps27-malentendido.wav","examples":[{"text":"Puede haber habido un malentendido.","en":"There may have been a misunderstanding.","audio":"https://tatoeba.org/en/audio/download/615910","words":[{"g":"to be able to, can","l":"poder"},{"g":"to have"},{"g":"to have","l":"haber"},{"g":"a"},null]},{"text":"Parece que hay un malentendido.","en":"There seems to be a misunderstanding.","audio":"https://tatoeba.org/en/audio/download/707369","words":[{"g":"to seem, to see fit","l":"parecer"},{"g":"that"},{"g":"to have","l":"haber"},{"g":"a"},null]},{"text":"Todo esto es un gran malentendido.","en":"This is all a big misunderstanding.","words":[{"g":"all"},{"g":"this"},{"g":"to be","l":"ser"},{"g":"a"},null,null]},{"text":"Debe haber algún malentendido.","en":"There must be some misunderstanding.","audio":"https://tatoeba.org/en/audio/download/77165","words":[{"g":"to owe","l":"deber"},{"g":"to have"},null,null]},{"text":"Gracias por aclarar el malentendido.","en":"Thank you for clearing up the misunderstanding.","audio":"https://tatoeba.org/en/audio/download/581566","words":[{"g":"thank you, thanks"},{"g":"for / by"},{"g":"to clarify, clear"},{"g":"the"},null]}]}