{"id":"vecino","lemma":"vecino","pos":"noun","rank":1525,"glosses":["neighbour (a person living on adjacent or nearby land)","a resident or inhabitant of an area, especially of a neighborhood or a village","freeman, person of relatively high status associated with a place"],"ipa":"/beˈθino/","gender":"m","forms":{"plural":"vecinos","feminine":"vecina","femininePlural":"vecinas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c8/LL-Q1321_%28spa%29-AdrianAbdulBaha-vecino.wav","formAudio":{"vecina":"https://upload.wikimedia.org/wikipedia/commons/4/40/LL-Q1321_%28spa%29-Marreromarco-vecina.wav"},"examples":[{"text":"Tenemos nuevos vecinos.","en":"We have new neighbors.","audio":"https://tatoeba.org/en/audio/download/459080","words":[{"g":"to have","l":"tener"},{"g":"new","l":"nuevo"},null]},{"text":"Tengo un vecino raro.","en":"I have a weird neighbor.","audio":"https://tatoeba.org/en/audio/download/459018","words":[{"g":"to have","l":"tener"},{"g":"a"},null,{"g":"rare"}]},{"text":"Él es uno de mis vecinos.","en":"He is one of my neighbors.","audio":"https://tatoeba.org/en/audio/download/35370","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"one"},{"g":"of / from"},{"g":"my"},null]},{"text":"Soy tu vecino.","en":"I'm your neighbor.","audio":"https://tatoeba.org/en/audio/download/443631","words":[{"g":"to be","l":"ser"},{"g":"your"},null]},{"text":"Odio a mi vecina.","en":"I hate my neighbor.","words":[{"g":"hate"},{"g":"to"},{"g":"my"},null]}]}