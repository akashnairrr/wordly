{"id":"egoi_sta","lemma":"egoísta","pos":"adj","rank":2147,"glosses":["egotistic (believing oneself to be superior)","selfish"],"ipa":"/eɡoˈista/","forms":{"femininePlural":"egoístas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8f/LL-Q1321_%28spa%29-Marreromarco-ego%C3%ADsta.wav","examples":[{"text":"Ella es una mujer egoísta.","en":"She is a selfish woman.","audio":"https://tatoeba.org/en/audio/download/461376","words":[{"g":"she"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"woman"},null]},{"text":"Él es una persona muy egoísta.","en":"He's a very selfish person.","audio":"https://tatoeba.org/en/audio/download/38868","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"a"},{"g":"person (an individual"},null,null]},{"text":"No sean egoístas.","en":"Don't be selfish.","words":[{"g":"no / not"},{"g":"to be","l":"ser"},null]},{"text":"Eres egoísta.","en":"You're egotistical.","audio":"https://tatoeba.org/en/audio/download/412501","words":[{"g":"to be","l":"ser"},null]},{"text":"Somos egoístas.","en":"We're selfish.","audio":"https://tatoeba.org/en/audio/download/443212","words":[{"g":"to be","l":"ser"},null]}]}