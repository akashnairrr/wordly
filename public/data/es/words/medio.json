{"id":"medio","lemma":"medio","pos":"noun","rank":355,"glosses":["half (any fraction with a denominator of 2)","medio, half-celemin (a traditional unit of dry measure equivalent to about 2.3 L)","medio (the usual container used to measure medios)"],"ipa":"/ˈmedjo/","gender":"m","forms":{"plural":"medios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q1321_%28spa%29-AdrianAbdulBaha-medio.wav","formAudio":{"medios":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q1321_%28spa%29-Precision27-medios.wav"},"examples":[{"text":"El del medio es mío.","en":"The middle one is mine.","audio":"https://tatoeba.org/en/audio/download/819928","words":[{"g":"the"},{"g":"of the"},null,{"g":"to be","l":"ser"},{"g":"mine"}]},{"text":"Estaba medio lleno.","en":"It was half full.","audio":"https://tatoeba.org/en/audio/download/704154","words":[{"g":"to be","l":"estar"},null,{"g":"full"}]},{"text":"Él es mi medio hermano.","en":"He's my half-brother.","words":[{"g":"he"},{"g":"to be","l":"ser"},{"g":"my"},null,{"g":"brother"}]},{"text":"El trabajo está a medio hacer.","en":"The job is half done.","audio":"https://tatoeba.org/en/audio/download/43224","words":[{"g":"the"},{"g":"work, job"},{"g":"to be","l":"estar"},{"g":"to"},null,{"g":"to do"}]},{"text":"¿Tienes un trabajo de medio tiempo?","en":"Do you have a part-time job?","words":[{"g":"to have","l":"tener"},{"g":"a"},{"g":"work, job"},{"g":"of / from"},null,{"g":"time"}]}]}