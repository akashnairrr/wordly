{"id":"medio","lemma":"medio","pos":"noun","rank":355,"glosses":["half (any fraction with a denominator of 2)","medio, half-celemin (a traditional unit of dry measure equivalent to about 2.3 L)","medio (the usual container used to measure medios)"],"ipa":"/ˈmedjo/","gender":"m","forms":{"plural":"medios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q1321_%28spa%29-AdrianAbdulBaha-medio.wav","formAudio":{"medios":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q1321_%28spa%29-Precision27-medios.wav"},"examples":[{"text":"¿Quiere usted medio pollo?","en":"Would you like half a chicken?","audio":"https://tatoeba.org/en/audio/download/645635","words":[{"g":"to desire","l":"querer"},{"g":"you (formal)"},null,{"g":"chicken"}]},{"text":"Estaba medio lleno.","en":"It was half full.","audio":"https://tatoeba.org/en/audio/download/704154","words":[{"g":"to be","l":"estar"},null,{"g":"full"}]},{"text":"Estamos a medio camino.","en":"We're halfway there.","audio":"https://tatoeba.org/en/audio/download/119088","words":[{"g":"to be","l":"estar"},{"g":"to"},null,{"g":"way, route"}]},{"text":"El trabajo está a medio hacer.","en":"The job is half done.","audio":"https://tatoeba.org/en/audio/download/43224","words":[{"g":"the"},{"g":"work, job"},{"g":"to be","l":"estar"},{"g":"to"},null,{"g":"to do"}]},{"text":"Sé que estoy en medio.","en":"I know I'm in the way.","audio":"https://tatoeba.org/en/audio/download/454307","words":[{"g":"to know, to understand","l":"saber"},{"g":"that"},{"g":"to be","l":"estar"},{"g":"in / on"},null]}]}