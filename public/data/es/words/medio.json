{"id":"medio","lemma":"medio","pos":"noun","rank":358,"glosses":["half (any fraction with a denominator of 2)","medio, half-celemin (a traditional unit of dry measure equivalent to about 2.3 L)","medio (the usual container used to measure medios)"],"ipa":"/ˈmedjo/","gender":"m","forms":{"plural":"medios"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c5/LL-Q1321_%28spa%29-AdrianAbdulBaha-medio.wav","formAudio":{"medios":"https://upload.wikimedia.org/wikipedia/commons/b/b6/LL-Q1321_%28spa%29-Precision27-medios.wav"},"examples":[{"text":"Estamos a medio camino.","en":"We're halfway there.","audio":"https://tatoeba.org/en/audio/download/119088"},{"text":"El fin justifica los medios.","en":"The end justifies the means.","audio":"https://tatoeba.org/en/audio/download/527133"},{"text":"¿Cuánto cuesta medio kilo?","en":"How much for half a kilo?","audio":"https://tatoeba.org/en/audio/download/933813"},{"text":"Tres medios son seis cuartos.","en":"Three halves is six quarters.","audio":"https://tatoeba.org/en/audio/download/819895"},{"text":"¿Quiere usted medio pollo?","en":"Would you like half a chicken?","audio":"https://tatoeba.org/en/audio/download/645635"}]}