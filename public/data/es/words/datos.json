{"id":"datos","lemma":"datos","pos":"noun","rank":1083,"glosses":["data"],"ipa":"/ˈdatos/","gender":"m","audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q1321_%28spa%29-Precision27-datos.wav","examples":[{"text":"¿Son ciertos estos datos?","en":"Is this data accurate?","audio":"https://tatoeba.org/en/audio/download/300731"},{"text":"He analizado los datos.","en":"I've analyzed the data.","audio":"https://tatoeba.org/en/audio/download/460913"},{"text":"Voy a necesitar algunos datos.","en":"I'm going to need some data.","audio":"https://tatoeba.org/en/audio/download/730476"},{"text":"Los datos no han sido compilados aún.","en":"The data hasn't been compiled yet.","audio":"https://tatoeba.org/en/audio/download/599955"},{"text":"Estos datos están incorrectos.","en":"This data is incorrect."}]}