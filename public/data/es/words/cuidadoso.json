{"id":"cuidadoso","lemma":"cuidadoso","pos":"adj","rank":3572,"glosses":["careful","cautious"],"ipa":"/kwidaˈdoso/","forms":{"feminine":"cuidadosa","masculinePlural":"cuidadosos","femininePlural":"cuidadosas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/c/c9/LL-Q1321_%28spa%29-Marreromarco-cuidadoso.wav","examples":[{"text":"Seré muy cuidadoso.","en":"I'll be very careful.","audio":"https://tatoeba.org/en/audio/download/454506","words":[{"g":"to be","l":"ser"},null,null]},{"text":"Tenemos que ser muy cuidadosos.","en":"We have to be very careful.","audio":"https://tatoeba.org/en/audio/download/585833","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to be"},null,null]},{"text":"Nunca se es demasiado cuidadoso.","en":"You can never be too careful.","audio":"https://tatoeba.org/en/audio/download/642141","words":[{"g":"never"},{"g":"oneself"},{"g":"to be","l":"ser"},{"g":"too much"},null]},{"text":"Ellas siempre son cuidadosas.","en":"They're always careful.","audio":"https://tatoeba.org/en/audio/download/461607","words":[{"g":"they"},{"g":"always"},{"g":"to be","l":"ser"},null]},{"text":"Tengo que ser más cuidadosa.","en":"I need to be more careful.","words":[{"g":"to have","l":"tener"},{"g":"that"},{"g":"to be"},{"g":"more"},null]}]}