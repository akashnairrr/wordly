{"id":"conducta","lemma":"conducta","pos":"noun","rank":2454,"glosses":["behaviour, conduct"],"ipa":"/konˈduɡta/","gender":"f","forms":{"plural":"conductas"},"order":2466,"audio":"https://upload.wikimedia.org/wikipedia/commons/5/5c/LL-Q1321_%28spa%29-Marreromarco-conducta.wav","examples":[{"text":"¿Cómo puede justificar su conducta?","en":"How can you justify your behavior?","audio":"https://tatoeba.org/en/audio/download/684532","words":[{"g":"how"},{"g":"to be able to, can","l":"poder"},{"g":"to justify"},{"g":"his / her / your"},null]},{"text":"Su conducta nunca deja de sorprenderme.","en":"His behavior never ceases to surprise me.","audio":"https://tatoeba.org/en/audio/download/553662","words":[{"g":"his / her / your"},null,{"g":"never"},{"g":"rest"},{"g":"of / from"},{"g":"to surprise","l":"sorprender"}]},{"text":"Su conducta fue admirable.","en":"His conduct was admirable.","audio":"https://tatoeba.org/en/audio/download/639419","words":[{"g":"his / her / your"},null,{"g":"to be","l":"ser"},{"g":"admirable"}]}]}