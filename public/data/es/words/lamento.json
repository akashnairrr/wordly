{"id":"lamento","lemma":"lamento","pos":"noun","rank":510,"glosses":["lament","plaint","wail, wailing"],"ipa":"/laˈmento/","gender":"m","forms":{"plural":"lamentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1321_%28spa%29-Marreromarco-lamento.wav","examples":[{"text":"Lamento lo que hice.","en":"I regret my actions.","audio":"https://tatoeba.org/en/audio/download/519205"},{"text":"Estoy cansado de tus lamentos.","en":"I'm tired of your whining.","audio":"https://tatoeba.org/en/audio/download/803714"},{"text":"Lamento haberte hecho daño.","en":"I'm sorry I hurt you.","audio":"https://tatoeba.org/en/audio/download/82306"},{"text":"Estamos hasta las narices de tus lamentos.","en":"We're fed up with your complaining.","audio":"https://tatoeba.org/en/audio/download/611736"},{"text":"Lamento llegar tan tarde.","en":"I'm sorry I'm so late.","audio":"https://tatoeba.org/en/audio/download/453530"}]}