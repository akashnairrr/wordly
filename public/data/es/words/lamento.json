{"id":"lamento","lemma":"lamento","pos":"noun","rank":507,"glosses":["lament","plaint","wail, wailing"],"ipa":"/laˈmento/","gender":"m","forms":{"plural":"lamentos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1321_%28spa%29-Marreromarco-lamento.wav","examples":[{"text":"Lamento esa decisión.","en":"I regret that decision.","audio":"https://tatoeba.org/en/audio/download/460934","words":[null,{"g":"that","l":"ese"},{"g":"decision"}]},{"text":"Estoy cansado de tus lamentos.","en":"I'm tired of your whining.","audio":"https://tatoeba.org/en/audio/download/803714","words":[{"g":"to be","l":"estar"},{"g":"tired, weary, wearied"},{"g":"of / from"},{"g":"your"},null]},{"text":"Lamento llegar tan tarde.","en":"I'm sorry I'm so late.","audio":"https://tatoeba.org/en/audio/download/453530","words":[null,{"g":"to arrive, get"},{"g":"so, as"},{"g":"late"}]},{"text":"Lamento oír eso.","en":"I'm sorry to hear that.","audio":"https://tatoeba.org/en/audio/download/35300","words":[null,{"g":"to hear"},{"g":"that","l":"ése"}]},{"text":"Lamento no poder ayudarte.","en":"I regret that I can't help you.","audio":"https://tatoeba.org/en/audio/download/524878","words":[null,{"g":"no / not"},{"g":"to be able to, can"},{"g":"to help","l":"ayudar"}]}]}