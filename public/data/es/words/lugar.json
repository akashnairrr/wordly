{"id":"lugar","lemma":"lugar","pos":"noun","rank":136,"glosses":["place"],"ipa":"/luˈɡaɾ/","gender":"m","forms":{"plural":"lugares"},"audio":"https://upload.wikimedia.org/wikipedia/commons/a/aa/LL-Q1321_%28spa%29-Precision27-lugar.wav","formAudio":{"lugares":"https://upload.wikimedia.org/wikipedia/commons/4/4e/LL-Q1321_%28spa%29-Eavqwiki-lugares.wav"},"examples":[{"text":"Quedé en último lugar.","en":"I came last.","audio":"https://tatoeba.org/en/audio/download/524867"},{"text":"¿Qué lugares le gustaría visitar?","en":"What places would you like to visit?","audio":"https://tatoeba.org/en/audio/download/687972"},{"text":"Yo dirijo este lugar.","en":"I run this place.","audio":"https://tatoeba.org/en/audio/download/135898"},{"text":"Tengo miedo a los lugares cerrados.","en":"I have cabin fever.","audio":"https://tatoeba.org/en/audio/download/449604"},{"text":"Mi lugar está aquí.","en":"My place is here.","audio":"https://tatoeba.org/en/audio/download/91081"}]}