{"id":"esperanza","lemma":"esperanza","pos":"noun","rank":831,"glosses":["hope, hopefulness","expectation, expectancy"],"ipa":"/espeˈɾanθa/","gender":"f","forms":{"plural":"esperanzas"},"audio":"https://upload.wikimedia.org/wikipedia/commons/0/0e/LL-Q1321_%28spa%29-AdrianAbdulBaha-esperanza.wav","examples":[{"text":"No pierdas la esperanza.","en":"Don't give up hope.","audio":"https://tatoeba.org/en/audio/download/40559"},{"text":"Tom perdió las esperanzas.","en":"Tom gave up hope.","audio":"https://tatoeba.org/en/audio/download/800346"},{"text":"Nunca perdimos la esperanza.","en":"We never lost hope.","audio":"https://tatoeba.org/en/audio/download/915727"},{"text":"Nunca perdí las esperanzas.","en":"I never lost hope.","audio":"https://tatoeba.org/en/audio/download/611638"},{"text":"Nunca pierde la esperanza.","en":"He never loses hope.","audio":"https://tatoeba.org/en/audio/download/524837"}]}