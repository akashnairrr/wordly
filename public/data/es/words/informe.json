{"id":"informe","lemma":"informe","pos":"adj","rank":831,"glosses":["shapeless, formless","misshapen"],"ipa":"/inˈfoɾme/","forms":{"femininePlural":"informes"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q1321_%28spa%29-Marreromarco-informe.wav","examples":[{"text":"He leído tu informe.","en":"I read your report.","audio":"https://tatoeba.org/en/audio/download/821179","words":[{"g":"to have","l":"haber"},{"g":"well-read"},{"g":"your"},null]},{"text":"He vuelto a escribir mi informe.","en":"I rewrote my report.","audio":"https://tatoeba.org/en/audio/download/135895","words":[{"g":"to have","l":"haber"},{"g":"change"},{"g":"to"},{"g":"to write"},{"g":"my"},null]},{"text":"Me paso el día leyendo informes.","en":"I spend all day reading reports.","audio":"https://tatoeba.org/en/audio/download/425049","words":[{"g":"me"},{"g":"step, footstep"},{"g":"the"},{"g":"day"},{"g":"to read","l":"leer"},null]},{"text":"¿Eres el que escribió ese informe?","en":"Are you the one who wrote that report?","audio":"https://tatoeba.org/en/audio/download/514657","words":[{"g":"to be","l":"ser"},null,null,{"g":"to write","l":"escribir"},{"g":"that"},null],"phrases":[[1,3,"that"]]},{"text":"Los informes están previstos para el próximo lunes.","en":"Reports are due next Monday.","audio":"https://tatoeba.org/en/audio/download/302959","words":[{"g":"the / them"},null,{"g":"to be","l":"estar"},null,{"g":"for"},{"g":"the"},{"g":"near"},{"g":"Monday"}]}]}