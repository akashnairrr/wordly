{"id":"sen_al","lemma":"señal","pos":"noun","rank":686,"glosses":["sign","landmark","signal"],"ipa":"/seˈɲal/","gender":"f","forms":{"plural":"señales"},"audio":"https://upload.wikimedia.org/wikipedia/commons/8/8d/LL-Q1321_%28spa%29-Marreromarco-se%C3%B1al.wav","examples":[{"text":"No vi la señal.","en":"I didn't see the sign.","audio":"https://tatoeba.org/en/audio/download/636750","words":[{"g":"no / not"},{"g":"to see, to spot","l":"ver"},{"g":"the / her"},null]},{"text":"Es una señal de los tiempos.","en":"It's a sign of the times.","audio":"https://tatoeba.org/en/audio/download/77951","words":[{"g":"to be","l":"ser"},{"g":"a"},null,{"g":"of / from"},{"g":"the / them"},{"g":"time","l":"tiempo"}]},{"text":"No da señales de vida.","en":"He doesn't show any sign of life.","words":[{"g":"no / not"},{"g":"to give, to give out","l":"dar"},null,{"g":"of / from"},{"g":"life"}]},{"text":"No me señales con el dedo.","en":"Don't point your finger at me.","audio":"https://tatoeba.org/en/audio/download/519143","words":[{"g":"no / not"},{"g":"me"},null,{"g":"with"},{"g":"the"},{"g":"digit: finger or toe"}]},{"text":"Esta señal significa \"no caminar\".","en":"This signal means \"don't walk.\"","words":[{"g":"this","l":"este"},null,{"g":"to signify","l":"significar"},{"g":"no / not"},{"g":"to walk"}]}]}