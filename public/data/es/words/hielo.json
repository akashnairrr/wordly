{"id":"hielo","lemma":"hielo","pos":"noun","rank":1007,"glosses":["ice"],"ipa":"/ˈʝelo/","gender":"m","forms":{"plural":"hielos"},"audio":"https://upload.wikimedia.org/wikipedia/commons/1/10/LL-Q1321_%28spa%29-Rodrigo5260-hielo.wav","examples":[{"text":"El hielo es sólido.","en":"Ice is solid.","audio":"https://tatoeba.org/en/audio/download/636648"},{"text":"¿Puedes patinar sobre hielo?","en":"Can you skate?","audio":"https://tatoeba.org/en/audio/download/443492"},{"text":"El hielo se derritió.","en":"The ice melted.","audio":"https://tatoeba.org/en/audio/download/45397"},{"text":"Tráeme algo de hielo.","en":"Get me some ice.","audio":"https://tatoeba.org/en/audio/download/441604"},{"text":"Ve a comprar hielo.","en":"Go buy some ice.","audio":"https://tatoeba.org/en/audio/download/800290"}]}