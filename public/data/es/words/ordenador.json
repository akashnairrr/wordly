{"id":"ordenador","lemma":"ordenador","pos":"noun","rank":1879,"glosses":["computer","ordinator, one who performs an ordination ceremony."],"ipa":"/oɾdenaˈdoɾ/","gender":"m","forms":{"plural":"ordenadores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1321_%28spa%29-Eavqwiki-ordenador.wav","formAudio":{"ordenadores":"https://upload.wikimedia.org/wikipedia/commons/e/e8/LL-Q1321_%28spa%29-Eavqwiki-ordenadores.wav"},"examples":[{"text":"El ordenador es nuevo.","en":"The computer is new.","audio":"https://tatoeba.org/en/audio/download/35813"},{"text":"Los ordenadores personales son muy útiles.","en":"Personal computers are very useful.","audio":"https://tatoeba.org/en/audio/download/705003"},{"text":"Necesito un nuevo ordenador.","en":"I need a new computer.","audio":"https://tatoeba.org/en/audio/download/1562"},{"text":"¿Cuántos ordenadores has tenido hasta ahora?","en":"How many computers have you had so far?","audio":"https://tatoeba.org/en/audio/download/608986"},{"text":"No tengo un ordenador.","en":"I don't have a computer.","audio":"https://tatoeba.org/en/audio/download/459878"}]}