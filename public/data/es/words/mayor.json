{"id":"mayor","lemma":"mayor","pos":"adj","rank":342,"glosses":["of age; adult; grown-up","major; main","head; boss"],"ipa":"/maˈʝoɾ/","forms":{"femininePlural":"mayores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q1321_%28spa%29-AdrianAbdulBaha-mayor.wav","formAudio":{"mayores":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-GlyphEnjoyer-mayores.wav"},"examples":[{"text":"No soy tan mayor.","en":"I'm not so old.","audio":"https://tatoeba.org/en/audio/download/441059"},{"text":"Tom evitó males mayores.","en":"Tom escaped injury.","audio":"https://tatoeba.org/en/audio/download/800308"},{"text":"Se está haciendo mayor.","en":"He is getting old.","audio":"https://tatoeba.org/en/audio/download/636613"},{"text":"Respeta a tus mayores.","en":"Respect your elders.","audio":"https://tatoeba.org/en/audio/download/77040"},{"text":"Soy mayor que tú.","en":"I'm older than you.","audio":"https://tatoeba.org/en/audio/download/449155"}]}