{"id":"mayor","lemma":"mayor","pos":"adj","rank":339,"glosses":["of age; adult; grown-up","major; main","head; boss"],"ipa":"/maˈʝoɾ/","forms":{"femininePlural":"mayores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q1321_%28spa%29-AdrianAbdulBaha-mayor.wav","formAudio":{"mayores":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-GlyphEnjoyer-mayores.wav"},"examples":[{"text":"¿Conoces a su hermano mayor?","en":"Do you know his older brother?","audio":"https://tatoeba.org/en/audio/download/35422","words":[{"g":"to know","l":"conocer"},{"g":"to"},{"g":"his / her / your"},{"g":"brother"},null]},{"text":"El hombre mayor murió de cáncer.","en":"The old man died of cancer.","audio":"https://tatoeba.org/en/audio/download/764795","words":[{"g":"the"},{"g":"man"},null,{"g":"to die","l":"morir"},{"g":"of / from"},{"g":"cancer"}]},{"text":"Él tiene tres hermanas mayores.","en":"He has three older sisters.","audio":"https://tatoeba.org/en/audio/download/45003","words":[{"g":"he"},{"g":"to have","l":"tener"},{"g":"three"},{"g":"sister","l":"hermana"},null]},{"text":"Mi hermano mayor sabe conducir.","en":"My older brother knows how to drive.","audio":"https://tatoeba.org/en/audio/download/551754","words":[{"g":"my"},{"g":"brother"},null,{"g":"to know, to understand","l":"saber"},{"g":"to drive"}]},{"text":"Ella tiene cinco hermanos mayores.","en":"She has five older brothers.","audio":"https://tatoeba.org/en/audio/download/594210","words":[{"g":"she"},{"g":"to have","l":"tener"},{"g":"a five"},{"g":"brother","l":"hermano"},null]}]}