{"id":"mayor","lemma":"mayor","pos":"adj","rank":339,"glosses":["of age; adult; grown-up","major; main","head; boss"],"ipa":"/maˈʝoɾ/","forms":{"femininePlural":"mayores"},"audio":"https://upload.wikimedia.org/wikipedia/commons/5/53/LL-Q1321_%28spa%29-AdrianAbdulBaha-mayor.wav","formAudio":{"mayores":"https://upload.wikimedia.org/wikipedia/commons/c/c1/LL-Q1321_%28spa%29-GlyphEnjoyer-mayores.wav"},"examples":[{"text":"¿Qué edad tiene tu hijo mayor?","en":"How old is your oldest son?","audio":"https://tatoeba.org/en/audio/download/788381","words":[{"g":"what"},{"g":"age"},{"g":"to have","l":"tener"},{"g":"your"},{"g":"son"},null]},{"text":"Yo tengo dos hermanos mayores.","en":"I have two big brothers.","audio":"https://tatoeba.org/en/audio/download/458611","words":[{"g":"I"},{"g":"to have","l":"tener"},{"g":"dung, excrement"},{"g":"brother","l":"hermano"},null]},{"text":"¿Tu hermana es mayor que tú?","en":"Is your sister older than you?","audio":"https://tatoeba.org/en/audio/download/585947","words":[{"g":"your"},{"g":"sister"},{"g":"to be","l":"ser"},null,{"g":"that"},{"g":"you"}]},{"text":"Ahora sois lo suficientemente mayores.","en":"You're old enough now.","audio":"https://tatoeba.org/en/audio/download/557755","words":[{"g":"now"},{"g":"to be","l":"ser"},{"g":"it / him"},{"g":"sufficiently"},null]},{"text":"Mi padre se hizo mayor.","en":"My father grew old.","audio":"https://tatoeba.org/en/audio/download/636645","words":[{"g":"my"},{"g":"father, parent"},{"g":"oneself"},{"g":"to do","l":"hacer"},null]}]}